        // gives 100 ns ticks since 1601: subtract the 1601->1970 offset, then divide
        // by 10^7 for whole seconds, with the remainder scaled to nanoseconds. Only
        // CLOCK_REALTIME is ever asked for, and the wall clock is what it means, so
        // the clockid isn't looked at. It's in kernel32, so there's no new DLL.
        asmput("# clock_gettime(clockid=r12, ts=r13) -> ts = {sec, nsec} of the wall")
        asmput("# clock, rax = 0. GetSystemTimeAsFileTime, rebased 1601->1970.")
        asmput(".wsc_clock:")
        asmput("    lea rcx, [rsp+48]")
        asmput("    mov qword ptr [rsp+48], 0")
        asmput("    call qword ptr [rip+GetSystemTimeAsFileTime]")
        asmput("    mov rax, [rsp+48]")
        asmput("    movabs rcx, 116444736000000000")
        asmput("    sub rax, rcx")
        asmput("    movabs rcx, 10000000")
        asmput("    xor rdx, rdx")
        asmput("    div rcx")
        asmput("    mov [r13], rax")
        asmput("    imul rdx, rdx, 100")
        asmput("    mov [r13+8], rdx")
        asmput("    xor rax, rax")
        asmput("    jmp .wsc_ret")
