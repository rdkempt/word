    asmput("    mov r10, rdi")
    asmput("    test r10b, 1")
    asmput("    jz rt_intfault")
    asmput("    mov r10, rsi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    test qword ptr [rsi - 16], 1")
    asmput("    jz rt_bytesfault")
    asmput("    sar rdi, 1")
    asmput("    mov rdx, [rsi]")
    asmput("    add rsi, 8")
    if cg[12] == 1
