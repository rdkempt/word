        asmput("    lsl x9, x9, #1")
        asmput("    ldr x10, [x23]")
        asmput("    cmp x9, x10")
        asmput("    b.le .ms_fits")
        asmput("    ldr x0, [x23]")
        asmput("    lsl x0, x0, #1")
        asmput("    bl rt_ralloc")
