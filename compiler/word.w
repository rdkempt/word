// SHA-256 of img[off .. off+n-1], as a 32-byte region. It's plain FIPS 180-4,
// except that every value that can carry past bit 31 is masked back down,
// because a word integer is 63-bit and the register width doesn't truncate it.
mo_sha256(img, off, n, k)
    m32 = 4294967295
    h = text(8)
    h[0] = 1779033703
    h[1] = 3144134277
    h[2] = 1013904242
    h[3] = 2773480762
    h[4] = 1359893119
    h[5] = 2600822924
    h[6] = 528734635
    h[7] = 1541459225
    w = text(64)
    tail = bytes(128)
    full = idiv(n, 64)
    blocks = full + 1
    rest = n - full * 64
    if rest >= 56
        blocks = full + 2
    tn = (blocks - full) * 64
    i = 0
    loop i < rest
        tail[i] = img[off + full * 64 + i]
        i = i + 1
    tail[rest] = 128
    bits = n * 8
    i = 0
    loop i < 8
        tail[tn - 1 - i] = (bits >> (i * 8)) & 255
        i = i + 1
    b = 0
    loop b < blocks
        i = 0
        loop i < 16
            if b < full
                j = off + b * 64 + i * 4
                w[i] = ((img[j] << 24) | (img[j + 1] << 16) | (img[j + 2] << 8) | img[j + 3]) & m32
            else
                j = (b - full) * 64 + i * 4
                w[i] = ((tail[j] << 24) | (tail[j + 1] << 16) | (tail[j + 2] << 8) | tail[j + 3]) & m32
            i = i + 1
        i = 16
        loop i < 64
            x = w[i - 15]
            y = w[i - 2]
            s0 = (mo_rotr(x, 7) ^ mo_rotr(x, 18) ^ (x >> 3)) & m32
            s1 = (mo_rotr(y, 17) ^ mo_rotr(y, 19) ^ (y >> 10)) & m32
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & m32
            i = i + 1
        a = h[0]
        bb = h[1]
        c = h[2]
        d = h[3]
        e = h[4]
        f = h[5]
        g = h[6]
        hh = h[7]
        i = 0
        loop i < 64
            S1 = (mo_rotr(e, 6) ^ mo_rotr(e, 11) ^ mo_rotr(e, 25)) & m32
            ch = ((e & f) ^ ((e ^ m32) & g)) & m32
            t1 = (hh + S1 + ch + k[i] + w[i]) & m32
            S0 = (mo_rotr(a, 2) ^ mo_rotr(a, 13) ^ mo_rotr(a, 22)) & m32
            mj = ((a & bb) ^ (a & c) ^ (bb & c)) & m32
            t2 = (S0 + mj) & m32
            hh = g
            g = f
            f = e
            e = (d + t1) & m32
            d = c
            c = bb
            bb = a
            a = (t1 + t2) & m32
            i = i + 1
        h[0] = (h[0] + a) & m32
        h[1] = (h[1] + bb) & m32
        h[2] = (h[2] + c) & m32
        h[3] = (h[3] + d) & m32
        h[4] = (h[4] + e) & m32
        h[5] = (h[5] + f) & m32
        h[6] = (h[6] + g) & m32
        h[7] = (h[7] + hh) & m32
        b = b + 1
    dg = bytes(32)
    i = 0
    loop i < 8
        v = h[i]
        dg[i * 4] = (v >> 24) & 255
        dg[i * 4 + 1] = (v >> 16) & 255
        dg[i * 4 + 2] = (v >> 8) & 255
        dg[i * 4 + 3] = v & 255
        i = i + 1
    return dg

// One 72-byte LC_SEGMENT_64. `extra` is the size of the section headers
// that follow it: 80 for __TEXT's one section, 0 for the rest.
mo_seg(b, name, vmaddr, vmsize, fileoff, filesize, maxp, initp, nsects, extra)
    bputn(b, 25, 4)
    bputn(b, 72 + extra, 4)
    i = 0
    loop i < 16
        if i < len(name)
            bput(b, name[i])
        else
            bput(b, 0)
        i = i + 1
    bputn(b, vmaddr, 8)
    bputn(b, vmsize, 8)
    bputn(b, fileoff, 8)
    bputn(b, filesize, 8)
    bputn(b, maxp, 4)
    bputn(b, initp, 4)
    bputn(b, nsects, 4)
    bputn(b, 0, 4)

// The 80-byte section_64 for __TEXT,__text.
mo_text_sect(b, addr, size, offset)
    nm = "__text"
    sg = "__TEXT"
    i = 0
    loop i < 16
        if i < len(nm)
            bput(b, nm[i])
        else
            bput(b, 0)
        i = i + 1
    i = 0
    loop i < 16
        if i < len(sg)
            bput(b, sg[i])
        else
            bput(b, 0)
        i = i + 1
    bputn(b, addr, 8)
    bputn(b, size, 8)
    bputn(b, offset, 4)
    bputn(b, 4, 4)
    bputn(b, 0, 4)
    bputn(b, 0, 4)
    // S_REGULAR | S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    bputn(b, 2147484672, 4)
    bputn(b, 0, 4)
    bputn(b, 0, 4)
    bputn(b, 0, 4)

// LC_LOAD_DYLINKER. On a macos-14 runner a Mach-O without dyld was SIGKILLed
// on Apple Silicon, and so was Apple's own `ld -static` output, with a
// textbook layout and a signature Apple's codesign accepts. So dyld maps the
// image. There's no LC_LOAD_DYLIB, so dyld loads nothing else: no libc, no
// dylib, no outside initializer. Every instruction that runs is still word's
// own, and the syscalls are still raw `svc #0x80`.
mo_dylinker(b)
    nm = "/usr/lib/dyld"
    bputn(b, 14, 4)
    bputn(b, 32, 4)
    bputn(b, 12, 4)
    i = 0
    loop i < 20
        if i < len(nm)
            bput(b, nm[i])
        else
            bput(b, 0)
        i = i + 1

// LC_MAIN (0x28 | LC_REQ_DYLD). entryoff is a file offset, and dyld adds the
// slide itself. The code it lands in is position-independent already, because
// every arm64 relocation patch_a64 fills in is PC-relative (b, b.cond, cbz,
// adr, tbz, adrp) or a page offset (:lo12:), which a page-aligned slide
// doesn't move.
mo_main(b, entryoff)
    bputn(b, 2147483688, 4)
    bputn(b, 24, 4)
    bputn(b, entryoff, 8)
    bputn(b, 0, 8)

// An empty LC_SYMTAB and LC_DYSYMTAB, the way a linker leaves them. With no
// dylib loaded, dyld has nothing to bind and no symbol to look up.
mo_symtab(b, off)
    bputn(b, 2, 4)
    bputn(b, 24, 4)
    bputn(b, off, 4)
    bputn(b, 0, 4)
    bputn(b, off, 4)
    bputn(b, 0, 4)
    bputn(b, 11, 4)
    bputn(b, 80, 4)
    i = 0
    loop i < 18
        bputn(b, 0, 4)
        i = i + 1

link_macho(A)
    base = 4294967296
    page = 16384
    ncmds = 11
    lc_len = 72 + 152 + 72 + 72 + 72 + 24 + 32 + 24 + 24 + 80 + 16
    tlen = blen(A[0])
    rlen = blen(A[1])
    dlen = blen(A[2])
    tstart = alignup(32 + lc_len, page)
    rstart = alignup(tstart + tlen, page)
    dstart = alignup(rstart + rlen, page)
    // __DATA's vm extent covers bss, which has no file bytes, so __LINKEDIT
    // can't take the address that follows __DATA in the file. With no
    // initialized data that would map both segments at the same address, which
    // llvm-objdump reads happily and the kernel refuses. So the file offset and
    // the vm address are worked out separately, and __LINKEDIT starts after the
    // end of __DATA's vm extent.
    datavm = alignup(align16(dlen) + A[3], page)
    if datavm < page
        datavm = page
    lstart = alignup(dstart + dlen, page)
    if lstart <= dstart
        lstart = dstart + page
    lvaddr = base + dstart + datavm
    bvaddr = base + align16(dstart + dlen)
    entry = link_reloc(A, base, tstart, rstart, dstart, bvaddr)
    npages = idiv(lstart + 4095, 4096)
    ident = "word"
    idlen = len(ident) + 1
    // A CodeDirectory's header length is fixed by its declared version, and
    // version 0x20400 runs all the way to execSegFlags: 88 bytes. Declaring
    // 0x20400 over a shorter header makes codesign read the identifier out of
    // the middle of the header and report "code object is not signed at all",
    // and the kernel SIGKILLs the process. llvm-objdump doesn't notice.
    cdhdr = 88
    cd_len = cdhdr + idlen + npages * 32
    sig_len = 20 + cd_len
    sig_pad = alignup(sig_len, 16)
    out_buf = mkbuf(lstart + sig_pad + 64)
    // mach_header_64: MH_MAGIC_64, CPU_TYPE_ARM64, subtype ALL, MH_EXECUTE,
    // and the flags MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE. The image
    // lives up to each of them: dyld does map it, and PIE isn't optional on
    // arm64 anyway (Apple's ld answers `-no_pie` with "ignored for arm64*" and
    // makes a PIE image regardless).
    bputn(out_buf, 4277009103, 4)
    bputn(out_buf, 16777228, 4)
    bputn(out_buf, 0, 4)
    bputn(out_buf, 2, 4)
    bputn(out_buf, ncmds, 4)
    bputn(out_buf, lc_len, 4)
    bputn(out_buf, 2097285, 4)
    bputn(out_buf, 0, 4)
    mo_seg(out_buf, "__PAGEZERO", 0, base, 0, 0, 0, 0, 0, 0)
    mo_seg(out_buf, "__TEXT", base, alignup(tstart + tlen, page), 0, tstart + tlen, 5, 5, 1, 80)
    mo_text_sect(out_buf, base + tstart, tlen, tstart)
    mo_seg(out_buf, "__RODATA", base + rstart, alignup(rlen, page), rstart, rlen, 1, 1, 0, 0)
    mo_seg(out_buf, "__DATA", base + dstart, datavm, dstart, dlen, 3, 3, 0, 0)
    mo_seg(out_buf, "__LINKEDIT", lvaddr, alignup(sig_pad, page), lstart, sig_pad, 1, 1, 0, 0)
    // LC_BUILD_VERSION: platform 1 is macOS, and minos and sdk are 11.0.0
    // packed as xxxx.yy.zz. A current kernel wants the image to say what it was
    // built for, even with no library linked into it.
    bputn(out_buf, 50, 4)
    bputn(out_buf, 24, 4)
    bputn(out_buf, 1, 4)
    bputn(out_buf, 720896, 4)
    bputn(out_buf, 720896, 4)
    bputn(out_buf, 0, 4)
    mo_dylinker(out_buf)
    mo_main(out_buf, entry - base)
    mo_symtab(out_buf, lstart)
    // LC_CODE_SIGNATURE
    bputn(out_buf, 29, 4)
    bputn(out_buf, 16, 4)
    bputn(out_buf, lstart, 4)
    bputn(out_buf, sig_pad, 4)
    pad_to(out_buf, tstart)
    copy_bytes(out_buf, A[0], tlen)
    pad_to(out_buf, rstart)
    copy_bytes(out_buf, A[1], rlen)
    pad_to(out_buf, dstart)
    copy_bytes(out_buf, A[2], dlen)
    pad_to(out_buf, lstart)
    // Everything up to here is what the signature covers: codeLimit stops
    // where the signature starts, because it can't cover itself.
    img = btake(out_buf)
    bputbe(out_buf, 4208856256, 4)
    bputbe(out_buf, sig_len, 4)
    bputbe(out_buf, 1, 4)
    bputbe(out_buf, 0, 4)
    bputbe(out_buf, 20, 4)
    bputbe(out_buf, 4208856066, 4)
    bputbe(out_buf, cd_len, 4)
    bputbe(out_buf, 132096, 4)
    bputbe(out_buf, 131074, 4)
    bputbe(out_buf, cdhdr + idlen, 4)
    bputbe(out_buf, cdhdr, 4)
    bputbe(out_buf, 0, 4)
    bputbe(out_buf, npages, 4)
    bputbe(out_buf, lstart, 4)
    bput(out_buf, 32)
    bput(out_buf, 2)
    bput(out_buf, 0)
    bput(out_buf, 12)
    bputbe(out_buf, 0, 4)
    // scatterOffset, teamOffset, spare3 and codeLimit64, all zero, since the
    // 32-bit codeLimit above is the one in use
    bputbe(out_buf, 0, 4)
    bputbe(out_buf, 0, 4)
    bputbe(out_buf, 0, 4)
    bputbe(out_buf, 0, 8)
    // the executable segment is __TEXT, and flag 1 says this is the main binary
    bputbe(out_buf, 0, 8)
    bputbe(out_buf, tstart + tlen, 8)
    bputbe(out_buf, 1, 8)
    i = 0
    loop i < len(ident)
        bput(out_buf, ident[i])
        i = i + 1
    bput(out_buf, 0)
    k = mo_k()
    i = 0
    loop i < npages
        n = 4096
        if i * 4096 + n > lstart
            n = lstart - i * 4096
        dg = mo_sha256(img, i * 4096, n, k)
        j = 0
        loop j < 32
            bput(out_buf, dg[j])
            j = j + 1
        i = i + 1
    pad_to(out_buf, lstart + sig_pad)
    return out_buf

// ============================================================================
// AArch64 encoder. Every instruction is one little-endian 32-bit word, so
// there's no ModRM, no SIB, no prefix and no length to work out: emission is
// `emit4le(buf, w)`. The work is in packing fields instead. Each form is a
// constant template with register numbers and immediates put in fixed bit
// positions, and almost every form encodes its immediate differently (12 bits
// with an optional shift for add, scaled by the access width for loads,
// PC-relative and word-scaled for branches).
//
// dev/toolchain/test_a64_vs_llvm.sh checks the encodings against
// `llvm-mc -triple=aarch64`, over a64_corpus.txt and every logical immediate,
// the way test_encoder_vs_as.sh checks the x86-64 encoder against GNU `as`
// (docs/SECURITY.md §6).

// Emit the OS trap on AArch64. Linux takes the number in x8 and traps with
// `svc #0`. macOS takes it in x16, traps with `svc #0x80`, and reports failure
// by setting the carry flag instead of returning a negative number. The
// numbers, the register and the error convention all differ, and m_syscall
// (the macOS shim in the runtime) absorbs all three. Every call site writes a
// Linux number into x8, as the Windows port writes one into rax.
a64_svc(cg)
    if cg[45] == 1
        // The shim is reached with `bl`, which writes x30, and not every
        // syscall site is in a function that saved it. rt_now is a leaf
        // (`sub sp, sp, #16` ... `ret`, no stp of x29/x30), so after a bare
        // `bl`, rt_now's own `ret` would land back inside rt_now. Saving x30
        // across the call costs two instructions and makes every site safe
        // whatever its prologue does. The slot is below the site's own stack
        // buffer, so a syscall writing through a pointer it took from sp is
        // unaffected.
        asmput("    str x30, [sp, #-16]!")
        asmput("    bl m_syscall")
        asmput("    ldr x30, [sp], #16")
    else
        asmput("    svc #0")

// EAGAIN's number, which m_syscall and Linux both return negated: 11 on Linux
// and 35 on Darwin. EINTR (4) and EPIPE (32) are the same number on both.
a64_eagain(cg)
    if cg[45] == 1
        return 35
    return 11

// rt_sigaction(sig, new, old, 8) on arm64, the twin of emit_sigaction: the new
// action is read from [sp, #newoff] and the old one written at [sp, #oldoff],
// and an offset of -1 passes 0 instead. On macOS the shim translates it.
a64_sigaction(cg, sig, newoff, oldoff)
    asmput("    mov x0, #" . sig)
    if newoff < 0
        asmput("    mov x1, xzr")
    else if newoff == 0
        asmput("    mov x1, sp")
    else
        asmput("    add x1, sp, #" . newoff)
    if oldoff < 0
        asmput("    mov x2, xzr")
    else
        asmput("    add x2, sp, #" . oldoff)
    asmput("    mov x3, #8")
    asmput("    mov x8, #134")
    a64_svc(cg)

// A register operand: 0-30 for x0-x30 or w0-w30, and 31 for both the zero
// register and sp, which share a number because only the instruction says
// which one 31 means. -1 for anything that isn't a register.
a64_reg(s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    n = b - a
    if n < 2
        return 0 - 1
    c = s[a]
    if n == 2 && (c == 115 || c == 83) && (s[a + 1] == 112 || s[a + 1] == 80)
        return 31
    if c != 120 && c != 119 && c != 88 && c != 87
        return 0 - 1
    if n == 3 && (s[a + 1] == 122 || s[a + 1] == 90) && (s[a + 2] == 114 || s[a + 2] == 82)
        return 31
    v = 0
    i = a + 1
    loop i < b
        if !is_digit(s[i])
            return 0 - 1
        v = v * 10 + (s[i] - 48)
        i = i + 1
    if v > 30
        return 0 - 1
    return v

// a64_reg and a64_vreg for an operand the instruction needs to be a register.
// Anything else is refused, and reads as register 0 so the caller can finish
// the line without writing -1 into a field. (`mov rax, 60` used to assemble
// to the word 0xffffffff and die with SIGILL when it ran.)
a64_xr(A, s, o, m)
    r = a64_reg(s, o[0], o[1])
    if r < 0
        err("wasm: a64 not a register: " . sub(s, o[0], o[1]) . " (" . m . ")")
        A[16] = 1
        return 0
    return r

a64_dr(A, s, o, m)
    r = a64_vreg(s, o[0], o[1])
    if r < 0
        err("wasm: a64 not a d register: " . sub(s, o[0], o[1]) . " (" . m . ")")
        A[16] = 1
        return 0
    return r

// A floating-point register, `d0`..`d31`. word's floats are doubles, so the
// single-precision registers aren't spelled or accepted.
a64_vreg(s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    n = b - a
    if n < 2 || n > 3
        return 0 - 1
    if s[a] != 100 && s[a] != 68
        return 0 - 1
    v = 0
    i = a + 1
    loop i < b
        if !is_digit(s[i])
            return 0 - 1
        v = v * 10 + (s[i] - 48)
        i = i + 1
    if v > 31
        return 0 - 1
    return v

// 1 when the operand names a 32-bit register, which is what decides the sf
// bit (0 for a w register, 1 for an x register).
a64_is_w(s, a, b)
    a = skip_space(s, a, b)
    if a < b
        if s[a] == 119 || s[a] == 87
            return 1
    return 0

// #imm, with the '#' optional. llvm-mc takes it either way, and the runtime's
// assembly is written with it.
a64_imm(s, a, b)
    a = skip_space(s, a, b)
    if a < b
        if s[a] == 35
            a = a + 1
    return parse_num_r(s, a, b)

// The same immediate as [low32, high32], for the two places a 64-bit pattern
// has to survive intact: a logical mask and a wide move.
a64_imm64(s, a, b)
    a = skip_space(s, a, b)
    if a < b
        if s[a] == 35
            a = a + 1
    return parse_num64(s, a, b)

// `#:lo12:sym`, the low 12 bits of a symbol's address, which is the part an
// ADRP doesn't carry. Answers where the symbol name starts, or -1.
a64_lo12(s, a, b)
    a = skip_space(s, a, b)
    if a < b
        if s[a] == 35
            a = a + 1
    if a + 6 > b
        return 0 - 1
    if !range_eq(s, a, a + 6, ":lo12:")
        return 0 - 1
    return a + 6

a64_is_imm(s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    if b <= a
        return false
    if s[a] == 35
        return true
    if s[a] == 45
        return true
    return is_digit(s[a])

// A shift modifier (`lsl #3` and the rest) as an operand of its own, which is
// neither a register nor an immediate and so parses as neither. Answers the
// shift type in bits 6 and up and the amount below them, or -1 when the
// operand isn't a shift. The type numbering is the encoding's own.
a64_shift_op(s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    if b - a < 3
        return 0 - 1
    k = 0 - 1
    if range_eq(s, a, a + 3, "lsl")
        k = 0
    else if range_eq(s, a, a + 3, "lsr")
        k = 1
    else if range_eq(s, a, a + 3, "asr")
        k = 2
    else if range_eq(s, a, a + 3, "ror")
        k = 3
    if k < 0
        return 0 - 1
    return (k << 6) | (a64_imm(s, a + 3, b) & 63)

// Condition codes, in the order the encoding numbers them. Inverting a
// condition is `cond ^ 1`, which is why they come in pairs.
a64_cond(s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    if range_eq(s, a, b, "eq")
        return 0
    if range_eq(s, a, b, "ne")
        return 1
    if range_eq(s, a, b, "cs") || range_eq(s, a, b, "hs")
        return 2
    if range_eq(s, a, b, "cc") || range_eq(s, a, b, "lo")
        return 3
    if range_eq(s, a, b, "mi")
        return 4
    if range_eq(s, a, b, "pl")
        return 5
    if range_eq(s, a, b, "vs")
        return 6
    if range_eq(s, a, b, "vc")
        return 7
    if range_eq(s, a, b, "hi")
        return 8
    if range_eq(s, a, b, "ls")
        return 9
    if range_eq(s, a, b, "ge")
        return 10
    if range_eq(s, a, b, "lt")
        return 11
    if range_eq(s, a, b, "gt")
        return 12
    if range_eq(s, a, b, "le")
        return 13
    if range_eq(s, a, b, "al")
        return 14
    return 0 - 1

// Split the operand list on commas at bracket depth zero, so `[x0, #8]` stays
// one operand. A comma after a memory operand has closed doesn't split
// either, because all that can follow one is its own post-index offset:
// `[x29], #16` is one operand. Answers a list of [start, end] pairs into the
// line.
a64_split(A, s, a, b)
    ops = mklist(4)
    depth = 0
    closed = 0
    st = skip_space(s, a, b)
    i = st
    loop i < b
        c = s[i]
        if c == 91
            depth = depth + 1
        else if c == 93
            depth = depth - 1
            closed = 1
        else if c == 44 && depth == 0 && closed == 0
            e = text(2)
            e[0] = st
            e[1] = back_space(s, st, i)
            ops = ladd_grow(ops, e)
            st = skip_space(s, i + 1, b)
        i = i + 1
    if b > st
        e = text(2)
        e[0] = st
        e[1] = back_space(s, st, b)
        ops = ladd_grow(ops, e)
    return ops

// A memory operand: `[xn]`, `[xn, #off]`, `[xn, #off]!`, `[xn], #off`, an
// indexed `[xn, xm]` or `[xn, xm, lsl #k]`, or `[xn, #:lo12:sym]`. Answers a
// 6-cell record (base register, byte offset, index mode, offset register or
// -1, the index shift, and the lo12 symbol name or 0), or 0 when it isn't one.
// The index mode is 0 for a plain offset, 1 for pre-index with writeback and
// 2 for post-index.
a64_mem(s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    if a >= b
        return 0
    if s[a] != 91
        return 0
    m = text(6)
    m[2] = 0
    m[3] = 0 - 1
    m[4] = 0
    m[5] = 0
    cb = indexof_r(s, 93, a, b)
    if cb < 0
        return 0
    // `[xn], #off`: the offset comes after the bracket
    post = 0
    tail = skip_space(s, cb + 1, b)
    if tail < b
        if s[tail] == 44
            post = 1
        else if s[tail] == 33
            m[2] = 1
    inner_a = skip_space(s, a + 1, cb)
    inner_b = back_space(s, inner_a, cb)
    ci = indexof_r(s, 44, inner_a, inner_b)
    if ci < 0
        m[0] = a64_reg(s, inner_a, inner_b)
        m[1] = 0
    else
        m[0] = a64_reg(s, inner_a, back_space(s, inner_a, ci))
        ra = skip_space(s, ci + 1, inner_b)
        lz = a64_lo12(s, ra, inner_b)
        if lz >= 0
            m[5] = sub(s, lz, back_space(s, lz, inner_b))
            m[1] = 0
        else if a64_is_imm(s, ra, inner_b)
            m[1] = a64_imm(s, ra, inner_b)
        else
            ci2 = indexof_r(s, 44, ra, inner_b)
            if ci2 < 0
                m[3] = a64_reg(s, ra, inner_b)
            else
                m[3] = a64_reg(s, ra, back_space(s, ra, ci2))
                k = a64_shift_op(s, ci2 + 1, inner_b)
                if k < 0 || (k >> 6) != 0
                    return 0
                m[4] = k & 63
            if m[3] < 0
                return 0
    if post == 1
        m[2] = 2
        m[1] = a64_imm(s, skip_space(s, tail + 1, b), b)
    if m[0] < 0
        return 0
    return m

// Load and store. The offset is an unsigned scaled 12-bit field when it's a
// non-negative multiple of the access size, and the signed 9-bit form
// otherwise (LDUR/STUR, or the pre- and post-index forms), which is what lets
// `[x29, #-8]` assemble. `sz` is the log2 of the access width, `ld` picks load
// over store, and `uns` forces the unscaled form because the caller wrote LDUR
// or STUR by name. Answers 0 when the offset fits neither.
// a64_ldst_v is the d-register form: the integer encoding plus the SIMD bit.
a64_ldst_v(A, buf, m, rt, sz, ld, uns)
    return a64_ldst_b(A, buf, m, rt, sz, ld, uns, 67108864)

a64_ldst(A, buf, m, rt, sz, ld, uns)
    return a64_ldst_b(A, buf, m, rt, sz, ld, uns, 0)

a64_ldst_b(A, buf, m, rt, sz, ld, uns, vbit)
    base = 939524096 | (sz << 30) | vbit
    if ld == 1
        base = base | 4194304
    // `[xn, #:lo12:sym]`: the offset is a hole the linker fills. It's always in
    // range, since 12 bits is what an ADRP leaves over, and patch_a64 checks
    // it's aligned for the access width.
    if m[5] != 0
        add_reloc_k(A, m[5], blen(buf), 0, 7)
        emit4le(buf, base | 16777216 | (m[0] << 5) | rt)
        return 1
    // `[xn, xm]` and `[xn, xm, lsl #sz]`: the S bit is the whole scale field, so
    // the only shift the form can express is by the access width itself.
    if m[3] >= 0
        sc = 0
        if m[4] != 0
            if m[4] != sz
                return 0
            sc = 4096
        emit4le(buf, base | 2099200 | 24576 | sc | (m[3] << 16) | (m[0] << 5) | rt)
        return 1
    off = m[1]
    if uns == 0 && m[2] == 0 && off >= 0 && (off & ((1 << sz) - 1)) == 0 && (off >> sz) < 4096
        emit4le(buf, base | 16777216 | ((off >> sz) << 10) | (m[0] << 5) | rt)
        return 1
    if off >= 0 - 256 && off < 256
        pre = 0
        if m[2] == 1
            pre = 3072
        else if m[2] == 2
            pre = 1024
        emit4le(buf, base | ((off & 511) << 12) | pre | (m[0] << 5) | rt)
        return 1
    return 0

// The add/sub immediate form takes 12 bits, optionally shifted left by 12.
// Anything else has to be put in a register first, which is the caller's
// problem: this answers false and the caller reports an error.
a64_addsub_imm(A, buf, tmpl, imm, rn, rd)
    if imm >= 0 && imm < 4096
        emit4le(buf, tmpl | (imm << 10) | (rn << 5) | rd)
        return true
    if imm >= 0 && (imm & 4095) == 0 && (imm >> 12) < 4096
        emit4le(buf, tmpl | 4194304 | ((imm >> 12) << 10) | (rn << 5) | rd)
        return true
    return false

// The logical-immediate encoding: `and x0, x0, #7` doesn't carry 7 in the
// instruction but a description of the bit pattern. A value qualifies when
// it's a rotated run of ones repeated to fill the register, and the field is
// N:immr:imms, where N and the leading ones of imms say how wide the repeated
// element is. Answers (N << 12) | (immr << 6) | imms, or -1 when the value
// isn't of that shape. Most values aren't, and the caller then has to put the
// value in a register.
//
// The immediate arrives as [low32, high32] because word's own integers are 63
// bits (SPEC 3.1) and a mask is 64. `0x5555...5555` and `0xaaaa...aaaa` are
// both real masks, and neither survives being carried in one integer: the
// first reads back with bit 62 sign-extended into the top bit, and the second
// loses its top bit. Either way the encoder would describe a different mask
// from the one written, with no error, which is why the x86-64 side parses
// 64-bit immediates in halves too.
a64_logical_imm(p, w32)
    lo = p[0] & 4294967295
    hi = p[1] & 4294967295
    if w32 == 1
        return a64_logical_imm32(lo)
    // Both halves are the same, so the repeated element is 32 bits or less,
    // the whole analysis fits in one half, and N is 0.
    if lo == hi
        return a64_logical_imm32(lo)
    return a64_logical_imm64(lo, hi)

// The element is 32 bits or less, so `v` holds a whole number of elements and
// ordinary word arithmetic reaches every bit of it.
a64_logical_imm32(v)
    ew = 32
    if v == 0
        return 0 - 1
    if v == 4294967295
        return 0 - 1
    // the smallest element the value repeats in
    e = 2
    loop e <= ew
        if e == ew
            break
        m = (1 << e) - 1
        x = v & m
        ok = 1
        k = e
        loop k < ew
            if ((v >> k) & m) != x
                ok = 0
                k = ew
            k = k + e
        if ok == 1
            break
        e = e * 2
    mask = (1 << e) - 1
    x = v & mask
    cnt = 0
    i = 0
    loop i < e
        if ((x >> i) & 1) == 1
            cnt = cnt + 1
        i = i + 1
    if cnt == 0 || cnt == e
        return 0 - 1
    ones = (1 << cnt) - 1
    r = 0
    found = 0 - 1
    loop r < e
        // A rotation by zero is the pattern itself, so r = 0 skips the
        // shifts.
        rot = ones
        if r > 0
            rot = ((ones >> r) | (ones << (e - r))) & mask
        if rot == x
            found = r
            r = e
        r = r + 1
    if found < 0
        return 0 - 1
    k = 1
    kk = 0
    loop k < e
        k = k * 2
        kk = kk + 1
    return (found << 6) | (((127 << (kk + 1)) & 63) | (cnt - 1))

// The element is the whole register: the value is a rotated run of ones and
// nothing smaller repeats. Each rotation is built and compared instead of
// worked out, because 64 comparisons cost nothing at assembly time and working
// it out needs a case for every place the run can wrap.
a64_logical_imm64(lo, hi)
    cnt = a64_popcount(lo) + a64_popcount(hi)
    if cnt == 0 || cnt == 64
        return 0 - 1
    mlo = 4294967295
    mhi = 0
    if cnt < 32
        mlo = (1 << cnt) - 1
    else
        mhi = (1 << (cnt - 32)) - 1
    r = 0
    loop r < 64
        if a64_ror_eq(mlo, mhi, r, lo, hi)
            return 4096 | (r << 6) | (cnt - 1)
        r = r + 1
    return 0 - 1

a64_popcount(v)
    c = 0
    i = 0
    loop i < 32
        c = c + ((v >> i) & 1)
        i = i + 1
    return c

// Is [lo, hi] rotated right by r equal to [wlo, whi]? Each half stays a
// non-negative 32-bit value, so nothing here depends on a 64th bit.
a64_ror_eq(lo, hi, r, wlo, whi)
    if r >= 32
        t = lo
        lo = hi
        hi = t
        r = r - 32
    if r == 0
        if lo == wlo && hi == whi
            return true
        return false
    nlo = ((lo >> r) | (hi << (32 - r))) & 4294967295
    nhi = ((hi >> r) | (lo << (32 - r))) & 4294967295
    if nlo == wlo && nhi == whi
        return true
    return false

// A PC-relative branch (a 26, 19 or 14-bit field) or ADR's or ADRP's split
// 21-bit field. All of them are patched at link time, so the encoder emits
// the opcode with a zero displacement and records what kind of hole it left.
a64_branch(A, buf, tmpl, s, a, b, kind)
    return a64_branch_r(A, buf, tmpl, s, a, b, kind, 0)

// `inv` is the bit that inverts the branch: 1 for b.<cond>, where the
// condition is the low four bits, 0x01000000 for cbz/cbnz and tbz/tbnz, whose
// two forms differ by one opcode bit, and 0 for a form that can't be relaxed.
// A relaxed site becomes the inverted branch over a plain `b`, which reaches
// +/-128 MB:
//
//     b.eq far          ->      b.ne .+8
//                               b   far
a64_branch_r(A, buf, tmpl, s, a, b, kind, inv)
    nm = sub(s, skip_space(s, a, b), back_space(s, a, b))
    site = 0 - 1
    if inv != 0
        site = A[19]
        A[19] = site + 1
        rx = A[18]
        if site < len(rx)
            if rx[site] == 1
                // The inverted branch skips over the long one with a fixed
                // displacement. Only the `b` gets a relocation, and it isn't a
                // site, so it can't be relaxed again.
                emit4le(buf, (tmpl ^ inv) | (2 << 5))
                add_reloc_s(A, nm, blen(buf), 0, 1, 0 - 1)
                emit4le(buf, 335544320)
                return 0
    add_reloc_s(A, nm, blen(buf), 0, kind, site)
    emit4le(buf, tmpl)

// The dispatch, ordered roughly by how often each form appears in the
// runtime, so the common ones are compared first.
encode_a64(A, mn, s, oa, ob)
    m = mn[0]
    buf = cur_buf(A)
    ops = a64_split(A, s, oa, ob)
    n = lcount(ops)
    if n < mn[6]
        err("wasm: a64 missing operand: " . m . " " . sub(s, oa, ob))
        A[16] = 1
        return 0
    o0 = 0
    o1 = 0
    o2 = 0
    o3 = 0
    if n > 0
        o0 = lget(ops, 0)
    if n > 1
        o1 = lget(ops, 1)
    if n > 2
        o2 = lget(ops, 2)
    if n > 3
        o3 = lget(ops, 3)
    // --- no operands ---
    if m == "ret"
        // `ret` returns through x30, and `ret xn` through another register.
        rn = 30
        if n > 0
            rn = a64_xr(A, s, o0, m)
        emit4le(buf, 3596550144 | (rn << 5))
        return 0
    if m == "nop"
        emit4le(buf, 3573751839)
        return 0
    if m == "svc"
        v = 0
        if n > 0
            v = a64_imm(s, o0[0], o0[1])
        emit4le(buf, 3556769793 | ((v & 65535) << 5))
        return 0
    // --- branches ---
    if m == "b"
        a64_branch(A, buf, 335544320, s, o0[0], o0[1], 1)
        return 0
    if m == "bl"
        a64_branch(A, buf, 2483027968, s, o0[0], o0[1], 1)
        return 0
    if m == "br"
        emit4le(buf, 3592355840 | (a64_xr(A, s, o0, m) << 5))
        return 0
    if m == "blr"
        emit4le(buf, 3594452992 | (a64_xr(A, s, o0, m) << 5))
        return 0
    if m == "cbz" || m == "cbnz"
        rt = a64_xr(A, s, o0, m)
        t = 3019898880
        if m == "cbnz"
            t = 3036676096
        if a64_is_w(s, o0[0], o0[1]) == 1
            t = t - 2147483648
        a64_branch_r(A, buf, t | rt, s, o1[0], o1[1], 2, 16777216)
        return 0
    if len(m) > 2 && m[0] == 98 && m[1] == 46
        cc = a64_cond(m, 2, len(m))
        if cc < 0
            err("wasm: unknown condition in " . m)
            A[16] = 1
            return 0
        a64_branch_r(A, buf, 1409286144 | cc, s, o0[0], o0[1], 2, 1)
        return 0
    // --- pc-relative addresses ---
    if m == "adr" || m == "adrp"
        rd = a64_xr(A, s, o0, m)
        t = 268435456
        k = 3
        if m == "adrp"
            t = 2415919104
            k = 4
        a64_branch(A, buf, t | rd, s, o1[0], o1[1], k)
        return 0
    // --- moves ---
    if m == "movz" || m == "movk" || m == "movn"
        rd = a64_xr(A, s, o0, m)
        v = a64_imm(s, o1[0], o1[1])
        sh = 0
        if n > 2
            k = a64_shift_op(s, o2[0], o2[1])
            if k < 0 || (k >> 6) != 0 || (k & 15) != 0
                err("wasm: a64 wide move takes lsl #0/#16/#32/#48: " . m)
                A[16] = 1
                return 0
            sh = idiv(k & 63, 16)
        t = 3531603968
        if m == "movk"
            t = 4068474880
        else if m == "movn"
            t = 2457862144
        if a64_is_w(s, o0[0], o0[1]) == 1
            t = t - 2147483648
        emit4le(buf, t | (sh << 21) | ((v & 65535) << 5) | rd)
        return 0
    if m == "mov"
        rd = a64_xr(A, s, o0, m)
        w32 = a64_is_w(s, o0[0], o0[1])
        if a64_is_imm(s, o1[0], o1[1])
            return a64_mov_imm(A, buf, rd, a64_imm64(s, o1[0], o1[1]), w32)
        rm = a64_xr(A, s, o1, m)
        // mov to or from sp is ADD #0; everything else is ORR with xzr
        if rd == 31 || rm == 31
            if a64_sp_named(s, o0[0], o0[1]) == 1 || a64_sp_named(s, o1[0], o1[1]) == 1
                t = 2432696320
                if w32 == 1
                    t = t - 2147483648
                emit4le(buf, t | (rm << 5) | rd)
                return 0
        t = 2852126720
        if w32 == 1
            t = t - 2147483648
        emit4le(buf, t | (rm << 16) | (31 << 5) | rd)
        return 0
    // --- floating point ---
    // What word does with a double: arithmetic, conversions to and from an
    // integer, compare, select, rounding, and the bit-for-bit move between a d
    // register and an x one, which is how a float gets into its box.
    if m[0] == 102 || m == "scvtf" || m == "ucvtf"
        return encode_a64_fp(A, mn, s, ops, n, buf)
    return encode_a64_alu(A, mn, s, ops, n, buf)

// One operand shape per form, because every FP form here is double-precision:
// no size field to work out, no shift, and no immediate except fcmp's #0.0.
encode_a64_fp(A, mn, s, ops, n, buf)
    m = mn[0]
    o0 = lget(ops, 0)
    o1 = 0
    o2 = 0
    o3 = 0
    if n > 1
        o1 = lget(ops, 1)
    if n > 2
        o2 = lget(ops, 2)
    if n > 3
        o3 = lget(ops, 3)
    if m == "fmov"
        // The three directions: into a d register from an x one, out of a d
        // register into an x one, and d to d.
        if a64_vreg(s, o0[0], o0[1]) >= 0
            if a64_vreg(s, o1[0], o1[1]) >= 0
                emit4le(buf, 509624320 | (a64_dr(A, s, o1, m) << 5) | a64_dr(A, s, o0, m))
                return 0
            emit4le(buf, 2657550336 | (a64_xr(A, s, o1, m) << 5) | a64_dr(A, s, o0, m))
            return 0
        emit4le(buf, 2657484800 | (a64_dr(A, s, o1, m) << 5) | a64_xr(A, s, o0, m))
        return 0
    if m == "scvtf" || m == "ucvtf"
        t = 2657222656
        if m == "ucvtf"
            t = 2657288192
        emit4le(buf, t | (a64_xr(A, s, o1, m) << 5) | a64_dr(A, s, o0, m))
        return 0
    if m == "fcvtzs" || m == "fcvtzu"
        t = 2658664448
        if m == "fcvtzu"
            t = 2658729984
        emit4le(buf, t | (a64_dr(A, s, o1, m) << 5) | a64_xr(A, s, o0, m))
        return 0
    if m == "fcmp"
        rn = a64_dr(A, s, o0, m)
        // `fcmp d0, #0.0`, the only immediate the compare takes.
        if a64_vreg(s, o1[0], o1[1]) < 0 && a64_is_imm(s, o1[0], o1[1])
            emit4le(buf, 509616136 | (rn << 5))
            return 0
        emit4le(buf, 509616128 | (a64_dr(A, s, o1, m) << 16) | (rn << 5))
        return 0
    if m == "fcsel"
        cc = a64_cond(s, o3[0], o3[1])
        if cc < 0
            err("wasm: unknown condition: " . m)
            A[16] = 1
            return 0
        emit4le(buf, 509611008 | (a64_dr(A, s, o2, m) << 16) | (cc << 12) | (a64_dr(A, s, o1, m) << 5) | a64_dr(A, s, o0, m))
        return 0
    t = 0 - 1
    if m == "fneg"
        t = 509689856
    else if m == "fabs"
        t = 509657088
    else if m == "fsqrt"
        t = 509722624
    else if m == "frinta"
        t = 510017536
    else if m == "frintz"
        t = 509984768
    if t >= 0
        emit4le(buf, t | (a64_dr(A, s, o1, m) << 5) | a64_dr(A, s, o0, m))
        return 0
    if m == "fadd"
        t = 509618176
    else if m == "fsub"
        t = 509622272
    else if m == "fmul"
        t = 509609984
    else if m == "fdiv"
        t = 509614080
    else if m == "fmaxnm"
        t = 509634560
    else if m == "fminnm"
        t = 509638656
    if t >= 0
        emit4le(buf, t | (a64_dr(A, s, o2, m) << 16) | (a64_dr(A, s, o1, m) << 5) | a64_dr(A, s, o0, m))
        return 0
    err("wasm: a64 unhandled: " . m)
    A[16] = 1
    return 0

// Is this `sp` written out (and not xzr)? They share register number 31, and
// only the spelling tells them apart.
a64_sp_named(s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    if b - a != 2
        return 0
    if s[a] != 115 && s[a] != 83
        return 0
    if s[a + 1] != 112 && s[a + 1] != 80
        return 0
    return 1

// 16-bit chunk i (0 to 3, from the low end) of the value [lo, hi].
a64_chunk_at(lo, hi, i)
    if i < 2
        return (lo >> (i * 16)) & 65535
    return (hi >> ((i - 2) * 16)) & 65535

// The index of the one non-zero 16-bit chunk, or -1 when more than one is
// non-zero. An all-zero value answers chunk 0: `mov xd, #0` is `movz xd, #0`.
a64_one_chunk(lo, hi, nw)
    found = 0 - 1
    i = 0
    loop i < nw
        if a64_chunk_at(lo, hi, i) != 0
            if found >= 0
                return 0 - 1
            found = i
        i = i + 1
    if found < 0
        return 0
    return found

// `mov xd, #imm` isn't one instruction. A value that is one 16-bit chunk with
// zeros elsewhere is MOVZ, one whose complement is such a chunk is MOVN, a
// logical-immediate pattern is ORR with the zero register, and anything else
// is a MOVZ followed by a MOVK for each further non-zero chunk. The order is
// the one llvm-mc prefers, so the encoder can be compared with it byte for
// byte. The last case is a word extension llvm-mc rejects, so test_a64_run.sh
// checks those by running them.
//
// Emitting only the low chunk would truncate the value with no error, the same
// kind of bug as the x86-64 truncation docs/SECURITY.md §6 records (an
// immediate too wide for its field). So is reading a 64-bit immediate into a
// 63-bit integer, which is why this takes [low32, high32] like the x86-64
// side does.
a64_mov_imm(A, buf, rd, p, w32)
    lo = p[0] & 4294967295
    hi = p[1] & 4294967295
    nw = 4
    base = 3531603968
    mn = 2457862144
    orr = 2986344448
    if w32 == 1
        nw = 2
        hi = 0
        base = 1384120320
        mn = 310378496
        orr = 838860800
    // MOVZ: one chunk, zeros elsewhere
    c = a64_one_chunk(lo, hi, nw)
    if c >= 0
        emit4le(buf, base | (c << 21) | (a64_chunk_at(lo, hi, c) << 5) | rd)
        return 0
    // MOVN: the complement is one chunk
    ilo = lo ^ 4294967295
    ihi = hi ^ 4294967295
    if w32 == 1
        ihi = 0
    c = a64_one_chunk(ilo, ihi, nw)
    if c >= 0
        emit4le(buf, mn | (c << 21) | (a64_chunk_at(ilo, ihi, c) << 5) | rd)
        return 0
    q = text(2)
    q[0] = lo
    q[1] = hi
    if w32 == 1
        q[1] = lo
    li = a64_logical_imm(q, w32)
    if li >= 0
        emit4le(buf, orr | (li << 10) | (31 << 5) | rd)
        return 0
    first = 1
    i = 0
    loop i < nw
        ch = a64_chunk_at(lo, hi, i)
        if ch != 0
            if first == 1
                emit4le(buf, base | (i << 21) | (ch << 5) | rd)
                first = 0
            else
                t = 4068474880
                if w32 == 1
                    t = t - 2147483648
                emit4le(buf, t | (i << 21) | (ch << 5) | rd)
        i = i + 1
    if first == 1
        emit4le(buf, base | rd)
    return 0

// The optional trailing `, lsl #3` on a shifted-register form, already placed
// in the instruction word: shift type at bit 22, amount at bit 10. No shift
// is zero, the same encoding as `lsl #0`.
a64_op_shift(A, s, ops, n, at, mn)
    if n <= at
        return 0
    o = lget(ops, at)
    k = a64_shift_op(s, o[0], o[1])
    if k < 0
        err("wasm: a64 expected a shift: " . mn)
        A[16] = 1
        return 0
    return ((k >> 6) << 22) | ((k & 63) << 10)

// Compares, add, sub and the logical operations, and conditional select. The
// rest goes on to encode_a64_mem and encode_a64_bits. They're split out of
// encode_a64 only because one function this long is harder to read.
encode_a64_alu(A, mn, s, ops, n, buf)
    m = mn[0]
    o0 = lget(ops, 0)
    o1 = 0
    o2 = 0
    o3 = 0
    if n > 1
        o1 = lget(ops, 1)
    if n > 2
        o2 = lget(ops, 2)
    if n > 3
        o3 = lget(ops, 3)
    w32 = a64_is_w(s, o0[0], o0[1])
    sfd = 0
    if w32 == 1
        sfd = 2147483648
    // --- compare: the destination is the zero register ---
    if m == "cmp" || m == "cmn"
        rn = a64_xr(A, s, o0, m)
        ti = 4043309056
        tr = 3942645760
        if m == "cmn"
            ti = 2969567232
            tr = 2868903936
        if a64_is_imm(s, o1[0], o1[1])
            v = a64_imm(s, o1[0], o1[1])
            if !a64_addsub_imm(A, buf, (ti - sfd) | 31, v, rn, 0)
                err("wasm: a64 immediate out of range: " . m)
                A[16] = 1
            return 0
        emit4le(buf, (tr - sfd) | (a64_xr(A, s, o1, m) << 16) | a64_op_shift(A, s, ops, n, 2, m) | (rn << 5) | 31)
        return 0
    if m == "tst"
        rn = a64_xr(A, s, o0, m)
        if a64_is_imm(s, o1[0], o1[1])
            li = a64_logical_imm(a64_imm64(s, o1[0], o1[1]), w32)
            if li < 0
                err("wasm: not a logical immediate: " . m)
                A[16] = 1
                return 0
            emit4le(buf, (4060086272 - sfd) | (li << 10) | (rn << 5) | 31)
            return 0
        emit4le(buf, (3925868544 - sfd) | (a64_xr(A, s, o1, m) << 16) | a64_op_shift(A, s, ops, n, 2, m) | (rn << 5) | 31)
        return 0
    // --- two-operand aliases that are three-operand forms with xzr ---
    if m == "neg" || m == "mvn"
        rd = a64_xr(A, s, o0, m)
        rm = a64_xr(A, s, o1, m)
        t = 3405774848
        if m == "mvn"
            t = 2854223872
        emit4le(buf, (t - sfd) | (rm << 16) | a64_op_shift(A, s, ops, n, 2, m) | (31 << 5) | rd)
        return 0
    if m == "cset"
        rd = a64_xr(A, s, o0, m)
        cc = a64_cond(s, o1[0], o1[1])
        if cc < 0
            err("wasm: unknown condition for cset")
            A[16] = 1
            return 0
        emit4le(buf, (2592080896 - sfd) | (31 << 16) | ((cc ^ 1) << 12) | (31 << 5) | rd)
        return 0
    if m == "csel" || m == "csinc"
        rd = a64_xr(A, s, o0, m)
        rn = a64_xr(A, s, o1, m)
        rm = a64_xr(A, s, o2, m)
        cc = a64_cond(s, o3[0], o3[1])
        if cc < 0
            err("wasm: unknown condition: " . m)
            A[16] = 1
            return 0
        t = 2592079872
        if m == "csinc"
            t = 2592080896
        emit4le(buf, (t - sfd) | (rm << 16) | (cc << 12) | (rn << 5) | rd)
        return 0
    // --- add / sub / logic, three operands ---
    ti = 0 - 1
    tr = 0 - 1
    tl = 0 - 1
    if m == "add"
        ti = 2432696320
        tr = 2332033024
    else if m == "adds"
        ti = 2969567232
        tr = 2868903936
    else if m == "sub"
        ti = 3506438144
        tr = 3405774848
    else if m == "subs"
        ti = 4043309056
        tr = 3942645760
    else if m == "and"
        tl = 2449473536
        tr = 2315255808
    else if m == "orr"
        tl = 2986344448
        tr = 2852126720
    else if m == "eor"
        tl = 3523215360
        tr = 3388997632
    else if m == "ands"
        tl = 4060086272
        tr = 3925868544
    else if m == "bic"
        tr = 2317352960
    else if m == "orn"
        tr = 2854223872
    if tr >= 0
        rd = a64_xr(A, s, o0, m)
        rn = a64_xr(A, s, o1, m)
        lz = a64_lo12(s, o2[0], o2[1])
        if lz >= 0
            if ti < 0
                err("wasm: a64 :lo12: needs add or sub: " . m)
                A[16] = 1
                return 0
            add_reloc_k(A, sub(s, lz, back_space(s, lz, o2[1])), blen(buf), 0, 6)
            emit4le(buf, (ti - sfd) | (rn << 5) | rd)
            return 0
        if a64_is_imm(s, o2[0], o2[1])
            v = a64_imm(s, o2[0], o2[1])
            if ti >= 0
                if a64_addsub_imm(A, buf, ti - sfd, v, rn, rd)
                    return 0
                if v < 0
                    // `add xd, xn, #-k` is `sub xd, xn, #k`, which is how the
                    // negative frame offsets in the runtime are written.
                    alt = 3506438144
                    if ti == 3506438144
                        alt = 2432696320
                    else if ti == 2969567232
                        alt = 4043309056
                    else if ti == 4043309056
                        alt = 2969567232
                    if a64_addsub_imm(A, buf, alt - sfd, 0 - v, rn, rd)
                        return 0
                err("wasm: a64 immediate out of range: " . m)
                A[16] = 1
                return 0
            li = a64_logical_imm(a64_imm64(s, o2[0], o2[1]), w32)
            if li < 0
                err("wasm: not a logical immediate: " . m)
                A[16] = 1
                return 0
            emit4le(buf, (tl - sfd) | (li << 10) | (rn << 5) | rd)
            return 0
        rm = a64_xr(A, s, o2, m)
        // With sp as the destination or the first source, add and sub use the
        // extended-register form (uxtx, or uxtw for a w register), because in
        // the shifted-register form register 31 is xzr. (That's how
        // `sub sp, sp, x9` once left every arm64 frame of 4096 bytes or more,
        // which a64_spadd builds, unallocated.)
        if ti >= 0 && (a64_sp_named(s, o0[0], o0[1]) == 1 || a64_sp_named(s, o1[0], o1[1]) == 1)
            if n > 3
                err("wasm: a64 no shifted register with sp: " . m)
                A[16] = 1
                return 0
            ext = 3
            if w32 == 1
                ext = 2
            emit4le(buf, (tr + 2097152 - sfd) | (rm << 16) | (ext << 13) | (rn << 5) | rd)
            return 0
        emit4le(buf, (tr - sfd) | (rm << 16) | a64_op_shift(A, s, ops, n, 3, m) | (rn << 5) | rd)
        return 0
    return encode_a64_mem(A, mn, s, ops, n, buf, w32, sfd)

// Shifts, multiply/divide, and everything that touches memory.
encode_a64_mem(A, mn, s, ops, n, buf, w32, sfd)
    m = mn[0]
    o0 = lget(ops, 0)
    o1 = 0
    o2 = 0
    o3 = 0
    if n > 1
        o1 = lget(ops, 1)
    if n > 2
        o2 = lget(ops, 2)
    if n > 3
        o3 = lget(ops, 3)
    // --- shifts: the immediate forms are bitfield-move aliases ---
    if m == "lsl" || m == "lsr" || m == "asr"
        rd = a64_xr(A, s, o0, m)
        rn = a64_xr(A, s, o1, m)
        width = 64
        if w32 == 1
            width = 32
        if a64_is_imm(s, o2[0], o2[1])
            sh = a64_imm(s, o2[0], o2[1]) & (width - 1)
            t = 3544186880
            if m == "asr"
                t = 2470445056
            if w32 == 1
                t = (t - 2147483648) - 4194304
            if m == "lsl"
                immr = (width - sh) & (width - 1)
                imms = width - 1 - sh
            else
                immr = sh
                imms = width - 1
            emit4le(buf, t | (immr << 16) | (imms << 10) | (rn << 5) | rd)
            return 0
        rm = a64_xr(A, s, o2, m)
        t = 2596282368
        if m == "lsr"
            t = 2596283392
        else if m == "asr"
            t = 2596284416
        emit4le(buf, (t - sfd) | (rm << 16) | (rn << 5) | rd)
        return 0
    // --- multiply and divide ---
    if m == "mul" || m == "madd" || m == "msub" || m == "mneg"
        rd = a64_xr(A, s, o0, m)
        rn = a64_xr(A, s, o1, m)
        rm = a64_xr(A, s, o2, m)
        ra = 31
        if n > 3
            ra = a64_xr(A, s, o3, m)
        t = 2600468480
        if m == "msub" || m == "mneg"
            t = 2600501248
        emit4le(buf, (t - sfd) | (rm << 16) | (ra << 10) | (rn << 5) | rd)
        return 0
    if m == "sdiv" || m == "udiv"
        t = 2596277248
        if m == "udiv"
            t = 2596276224
        emit4le(buf, (t - sfd) | (a64_xr(A, s, o2, m) << 16) | (a64_xr(A, s, o1, m) << 5) | a64_xr(A, s, o0, m))
        return 0
    if m == "umulh" || m == "smulh"
        t = 2613083136
        if m == "smulh"
            t = 2604694528
        emit4le(buf, t | (a64_xr(A, s, o2, m) << 16) | (a64_xr(A, s, o1, m) << 5) | a64_xr(A, s, o0, m))
        return 0
    // --- pair load/store, which is how a frame is built and torn down ---
    if m == "stp" || m == "ldp"
        rt = a64_xr(A, s, o0, m)
        rt2 = a64_xr(A, s, o1, m)
        mem = a64_mem(s, o2[0], o2[1])
        if mem == 0
            err("wasm: a64 expected a memory operand: " . m)
            A[16] = 1
            return 0
        t = 2835349504
        if m == "ldp"
            t = 2839543808
        if mem[2] == 1
            t = t + 8388608
        else if mem[2] == 2
            t = t - 8388608
        if w32 == 1
            t = t - 2147483648
        sc = 3
        if w32 == 1
            sc = 2
        emit4le(buf, t | (((mem[1] >> sc) & 127) << 15) | (rt2 << 10) | (mem[0] << 5) | rt)
        return 0
    // --- single load/store ---
    sz = 0 - 1
    ld = 0
    uns = 0
    if m == "ldr" || m == "str"
        sz = 3
        if w32 == 1
            sz = 2
    else if m == "ldrb" || m == "strb"
        sz = 0
    else if m == "ldrh" || m == "strh"
        sz = 1
    else if m == "ldurb" || m == "sturb"
        sz = 0
        uns = 1
    else if m == "ldurh" || m == "sturh"
        sz = 1
        uns = 1
    else if m == "ldur" || m == "stur"
        sz = 3
        uns = 1
        if w32 == 1
            sz = 2
    if sz >= 0
        if m[0] == 108
            ld = 1
        // `ldr d0, [x1, #8]` is the same instruction with the SIMD bit set and
        // the register number read from the d file.
        rt = a64_vreg(s, o0[0], o0[1])
        if rt >= 0
            mem = a64_mem(s, o1[0], o1[1])
            if mem == 0
                err("wasm: a64 expected a memory operand: " . m)
                A[16] = 1
                return 0
            if a64_ldst_v(A, buf, mem, rt, 3, ld, uns) == 0
                err("wasm: a64 offset out of range: " . m)
                A[16] = 1
            return 0
        mem = a64_mem(s, o1[0], o1[1])
        if mem == 0
            err("wasm: a64 expected a memory operand: " . m)
            A[16] = 1
            return 0
        if a64_ldst(A, buf, mem, a64_xr(A, s, o0, m), sz, ld, uns) == 0
            err("wasm: a64 offset out of range: " . m)
            A[16] = 1
        return 0
    return encode_a64_bits(A, mn, s, ops, n, buf, w32, sfd)

// Rotates, bit tests, bitfield moves, the count and reverse family, and the
// conditional invert and negate forms. Split off for length, like the other
// two.
encode_a64_bits(A, mn, s, ops, n, buf, w32, sfd)
    m = mn[0]
    o0 = lget(ops, 0)
    o1 = 0
    o2 = 0
    o3 = 0
    if n > 1
        o1 = lget(ops, 1)
    if n > 2
        o2 = lget(ops, 2)
    if n > 3
        o3 = lget(ops, 3)
    // --- rotate: the immediate form is EXTR with one source twice ---
    if m == "ror" || m == "extr"
        rd = a64_xr(A, s, o0, m)
        rn = a64_xr(A, s, o1, m)
        width = 64
        if w32 == 1
            width = 32
        // EXTR has an N bit that has to match sf, so the 32-bit form clears
        // both.
        te = 2478833664
        if w32 == 1
            te = (te - 2147483648) - 4194304
        if m == "extr"
            emit4le(buf, te | (a64_xr(A, s, o2, m) << 16) | ((a64_imm(s, o3[0], o3[1]) & (width - 1)) << 10) | (rn << 5) | rd)
            return 0
        if a64_is_imm(s, o2[0], o2[1])
            emit4le(buf, te | (rn << 16) | ((a64_imm(s, o2[0], o2[1]) & (width - 1)) << 10) | (rn << 5) | rd)
            return 0
        emit4le(buf, (2596285440 - sfd) | (a64_xr(A, s, o2, m) << 16) | (rn << 5) | rd)
        return 0
    // --- test one bit and branch: what a tag check compiles to ---
    if m == "tbz" || m == "tbnz"
        rt = a64_xr(A, s, o0, m)
        bit = a64_imm(s, o1[0], o1[1]) & 63
        t = 905969664
        if m == "tbnz"
            t = 922746880
        if bit >= 32
            t = t + 2147483648
        a64_branch_r(A, buf, t | ((bit & 31) << 19) | rt, s, o2[0], o2[1], 5, 16777216)
        return 0
    // --- bitfield extract and the sign and zero extensions (all aliases of
    // the bitfield moves SBFM and UBFM) ---
    if m == "ubfx" || m == "sbfx"
        rd = a64_xr(A, s, o0, m)
        rn = a64_xr(A, s, o1, m)
        lsb = a64_imm(s, o2[0], o2[1])
        wd = a64_imm(s, o3[0], o3[1])
        t = 3544186880
        if m == "sbfx"
            t = 2470445056
        if w32 == 1
            t = (t - 2147483648) - 4194304
        emit4le(buf, t | (lsb << 16) | ((lsb + wd - 1) << 10) | (rn << 5) | rd)
        return 0
    imms = 0 - 1
    sx = 0
    if m == "sxtb"
        imms = 7
        sx = 1
    else if m == "sxth"
        imms = 15
        sx = 1
    else if m == "sxtw"
        imms = 31
        sx = 1
    else if m == "uxtb"
        imms = 7
    else if m == "uxth"
        imms = 15
    if imms >= 0
        // The source is always a w register and the destination decides the
        // width. A zero extension is the 32-bit instruction either way, since
        // writing a w register clears the top half.
        t = 1392508928
        if sx == 1
            t = 318767104
            if a64_is_w(s, o0[0], o0[1]) == 0
                t = 2470445056
        emit4le(buf, t | (imms << 10) | (a64_xr(A, s, o1, m) << 5) | a64_xr(A, s, o0, m))
        return 0
    // --- count and reverse ---
    t = 0 - 1
    if m == "rbit"
        t = 3670016000
    else if m == "rev16"
        t = 3670017024
    else if m == "rev32"
        t = 3670018048
    else if m == "rev"
        t = 3670019072
        if w32 == 1
            t = 3670018048
    else if m == "clz"
        t = 3670020096
    else if m == "cls"
        t = 3670021120
    if t >= 0
        emit4le(buf, (t - sfd) | (a64_xr(A, s, o1, m) << 5) | a64_xr(A, s, o0, m))
        return 0
    // --- conditional invert and negate ---
    if m == "csinv" || m == "csneg" || m == "cinc" || m == "csetm" || m == "cinv" || m == "cneg"
        rd = a64_xr(A, s, o0, m)
        t = 3665821696
        if m == "csneg" || m == "cneg"
            t = 3665822720
        else if m == "cinc"
            t = 2592080896
        if m == "csetm"
            cc = a64_cond(s, o1[0], o1[1])
            if cc < 0
                err("wasm: unknown condition for csetm")
                A[16] = 1
                return 0
            emit4le(buf, (t - sfd) | (31 << 16) | ((cc ^ 1) << 12) | (31 << 5) | rd)
            return 0
        rn = a64_xr(A, s, o1, m)
        if m == "cinc" || m == "cinv" || m == "cneg"
            cc = a64_cond(s, o2[0], o2[1])
            if cc < 0
                err("wasm: unknown condition: " . m)
                A[16] = 1
                return 0
            emit4le(buf, (t - sfd) | (rn << 16) | ((cc ^ 1) << 12) | (rn << 5) | rd)
            return 0
        cc = a64_cond(s, o3[0], o3[1])
        if cc < 0
            err("wasm: unknown condition: " . m)
            A[16] = 1
            return 0
        emit4le(buf, (t - sfd) | (a64_xr(A, s, o2, m) << 16) | (cc << 12) | (rn << 5) | rd)
        return 0
    err("wasm: a64 unhandled: " . m)
    A[16] = 1
    return 0

// ============================================================================
// Windows PE64 emission: the same assembler state A (text, rodata, data, bss
// and rip-relative rel32 relocations) linked into a PE instead of an ELF. The
// code for a program's own functions is the same on both (it calls rt_*
// helpers, and string literals are absolute REGION_BASE+offset addresses,
// copied into place at startup on both OSes), so what differs is the
// container and the runtime. Every relocation is rip-relative, so the image
// needs no fixups wherever it loads, and its .reloc is one empty block (see
// link_pe). A relocation to an undefined symbol that names a known Win32
// function (import_dll) becomes an import the loader binds; every other one
// resolves to an RVA.
// ============================================================================
// The PE's SizeOfStackReserve, in one place because two things have to agree
// on it: the header link_pe writes, and the stack limit the runtime works out
// from it. On Linux the runtime asks the kernel (getrlimit). The Windows shim
// has no such call and doesn't need one, since word writes this number into
// its own image and the runtime can use the same constant. 8 MB is the
// default Linux stack, so a program recurses about as deep on Windows as on
// Linux. (At 1 MB, the MSVC default, recursion that finished on Linux stopped
// with `stack exhausted` on Windows.) A reserve is address space: Windows
// commits the pages as the stack reaches them.
pe_stack_reserve()
    return 8388608

alignup(n, a)
    return idiv(n + a - 1, a) * a

// Append a string's characters (ASCII) to a buffer as bytes, with no
// terminator.
bputs(b, s)
    i = 0
    loop i < len(s)
        bput(b, s[i])
        i = i + 1

// The index of string s in a list, or -1.
lidx_str(lst, s)
    i = 0
    loop i < lcount(lst)
        if lget(lst, i) == s
            return i
        i = i + 1
    return 0 - 1

// The DLL a Win32 import comes from, or "" when the name isn't a known import.
// The runtime refers to these by their bare names (call qword ptr
// [rip+Name]), and link_pe imports only the ones a program refers to.
import_dll(name)
    if name == "ExitProcess"
        return "kernel32.dll"
    if name == "GetStdHandle"
        return "kernel32.dll"
    if name == "WriteFile"
        return "kernel32.dll"
    if name == "GetFileType"
        return "kernel32.dll"
    if name == "ReadFile"
        return "kernel32.dll"
    if name == "VirtualAlloc"
        return "kernel32.dll"
    if name == "CreateFileW"
        return "kernel32.dll"
    if name == "CreateFileA"
        return "kernel32.dll"
    if name == "GetCommandLineA"
        return "kernel32.dll"
    if name == "MoveFileExA"
        return "kernel32.dll"
    // rename() asks what old and new are before it moves anything, so that a
    // directory never replaces a file.
    if name == "GetFileAttributesA"
        return "kernel32.dll"
    if name == "CloseHandle"
        return "kernel32.dll"
    // write() opens a file without truncating it (a hidden file refuses
    // CREATE_ALWAYS) and then cuts it to nothing with this.
    if name == "SetEndOfFile"
        return "kernel32.dll"
    // Why a write to stdout or stderr failed: a broken pipe ends the program.
    if name == "GetLastError"
        return "kernel32.dll"
    if name == "GetFileSizeEx"
        return "kernel32.dll"
    if name == "GetCommandLineW"
        return "kernel32.dll"
    if name == "CreateProcessW"
        return "kernel32.dll"
    if name == "CreateProcessA"
        return "kernel32.dll"
    if name == "GetEnvironmentStringsA"
        return "kernel32.dll"
    if name == "WaitForSingleObject"
        return "kernel32.dll"
    if name == "GetExitCodeProcess"
        return "kernel32.dll"
    if name == "GetSystemTimeAsFileTime"
        return "kernel32.dll"
    // sys.image(): the path of the running executable, for `word version`.
    if name == "GetModuleFileNameW"
        return "kernel32.dll"
    // fs.dir: a directory is listed by a search instead of read through a
    // handle, with the wide-character calls so that no name is too long to
    // come back, and each name is turned into UTF-8 (image() uses
    // WideCharToMultiByte too).
    if name == "FindFirstFileW"
        return "kernel32.dll"
    if name == "FindNextFileW"
        return "kernel32.dll"
    if name == "FindClose"
        return "kernel32.dll"
    if name == "MultiByteToWideChar"
        return "kernel32.dll"
    if name == "WideCharToMultiByte"
        return "kernel32.dll"
    // ws2_32: Berkeley-style sockets for the net module (w_syscall maps the
    // Linux socket/connect/setsockopt numbers and socket read/write/close onto
    // these). ws2_32.dll exports them by their plain names.
    if name == "WSAStartup"
        return "ws2_32.dll"
    if name == "socket"
        return "ws2_32.dll"
    if name == "connect"
        return "ws2_32.dll"
    if name == "send"
        return "ws2_32.dll"
    if name == "recv"
        return "ws2_32.dll"
    if name == "closesocket"
        return "ws2_32.dll"
    if name == "setsockopt"
        return "ws2_32.dll"
    // crypt32: the ROOT system certificate store, where the TLS trust anchors
    // come from on Windows (rt_cacerts, behind sys.cacerts()).
    if name == "CertOpenSystemStoreW"
        return "crypt32.dll"
    if name == "CertEnumCertificatesInStore"
        return "crypt32.dll"
    if name == "CertCloseStore"
        return "crypt32.dll"
    // iphlpapi: the DNS resolvers the host uses (rt_nameservers, behind
    // sys.nameservers()). Windows keeps them behind this call, where the other
    // systems name them in /etc/resolv.conf, which the net library's dns
    // module reads.
    if name == "GetNetworkParams"
        return "iphlpapi.dll"
    // bcrypt: the system CSPRNG. w_syscall maps getrandom onto
    // BCryptGenRandom, which is where random() gets its bytes, and the net
    // library's TLS key shares and ClientHello random come from random().
    if name == "BCryptGenRandom"
        return "bcrypt.dll"
    return ""

// link_pe(A, prodname) -> the PE image buffer, or 0 on an undefined symbol.
//
// Five sections, each with only the permissions its contents need, the same
// W^X split the ELF has:
//
//   .text   RX  code
//   .rdata  R   literals, and the import descriptors and IAT the loader binds
//   .data   RW  initialized globals, with .bss as the zero-filled virtual tail
//   .rsrc   R   the version block and the manifest (build_rsrc)
//   .reloc  R   one empty block, so DYNAMIC_BASE below is honoured
//
// (It used to be one section that was readable, writable and executable.)
//
// `prodname` is the program's name, from its source file (see build_version).
// Nothing here depends on the name of the file the image is written to.
link_pe(A, prodname)
    FA = 512
    SA = 4096
    machine = 34404
    optsz = 240
    coffchars = 34
    optmagic = 523
    tlen = blen(A[0])
    rlen = blen(A[1])
    dlen = blen(A[2])
    ioff = alignup(rlen, 16)

    // ---- collect imports referenced by relocations ----
    dlls = mklist(16)
    dfuncs = mklist(16)
    ri = 0
    loop ri < lcount(A[5])
        r = lget(A[5], ri)
        nm = r[0]
        if find_label(A, nm) == 0
            dll = import_dll(nm)
            if len(dll) == 0
                err("word/pe: undefined symbol: " . nm)
                return 0
            di = lidx_str(dlls, dll)
            if di < 0
                ladd(dlls, dll)
                ladd(dfuncs, mklist(64))
                di = lcount(dlls) - 1
            fl = lget(dfuncs, di)
            if lidx_str(fl, nm) < 0
                ladd(fl, nm)
        ri = ri + 1
    ndll = lcount(dlls)

    // ---- import-blob offsets (relative to the blob start = ioff) ----
    p = (ndll + 1) * 20
    ilt_off = mklist(16)
    di = 0
    loop di < ndll
        ladd(ilt_off, p)
        p = p + (lcount(lget(dfuncs, di)) + 1) * 8
        di = di + 1
    iat_off = mklist(16)
    di = 0
    loop di < ndll
        ladd(iat_off, p)
        p = p + (lcount(lget(dfuncs, di)) + 1) * 8
        di = di + 1
    hn_off = mklist(64)
    di = 0
    loop di < ndll
        fl = lget(dfuncs, di)
        fi = 0
        loop fi < lcount(fl)
            ladd(hn_off, p)
            p = p + alignup(2 + len(lget(fl, fi)) + 1, 2)
            fi = fi + 1
        di = di + 1
    dname_off = mklist(16)
    di = 0
    loop di < ndll
        ladd(dname_off, p)
        p = p + len(lget(dlls, di)) + 1
        di = di + 1
    implen = p

    // ---- section geometry ----
    // Five sections, each aligned to SA in memory and FA in the file. .bss is
    // .data's virtual tail: it has an RVA and a size but no bytes on disk.
    nsec = 5
    hdrsz = alignup(88 + optsz + nsec * 40, FA)
    rdlen = ioff + implen
    bssoff = alignup(dlen, 16)
    dvsize = bssoff + A[3]
    rellen = 8
    txtrva = SA
    rrva = txtrva + alignup(tlen, SA)
    drva = rrva + alignup(rdlen, SA)
    rsrva = drva + alignup(dvsize, SA)
    // The resource blob carries RVAs of its own, so it's built once its
    // section's address is known, and its length then places everything after
    // it.
    rsrc = build_rsrc(rsrva, prodname)
    rslen = blen(rsrc)
    relrva = rsrva + alignup(rslen, SA)
    toff = hdrsz
    roff = toff + alignup(tlen, FA)
    doff = roff + alignup(rdlen, FA)
    rsoff = doff + alignup(dlen, FA)
    reloff = rsoff + alignup(rslen, FA)
    filesz = reloff + alignup(rellen, FA)

    // ---- function -> IAT rva, DLL by DLL as the blob is emitted ----
    iat_names = mklist(64)
    iat_rvas = mklist(64)
    di = 0
    loop di < ndll
        fl = lget(dfuncs, di)
        fi = 0
        loop fi < lcount(fl)
            ladd(iat_names, lget(fl, fi))
            ladd(iat_rvas, rrva + ioff + lget(iat_off, di) + fi * 8)
            fi = fi + 1
        di = di + 1

    // ---- build the import blob ----
    imp = mkbuf(implen + 64)
    di = 0
    loop di < ndll
        bputn(imp, rrva + ioff + lget(ilt_off, di), 4)
        bputn(imp, 0, 4)
        bputn(imp, 0, 4)
        bputn(imp, rrva + ioff + lget(dname_off, di), 4)
        bputn(imp, rrva + ioff + lget(iat_off, di), 4)
        di = di + 1
    zt = 0
    loop zt < 20
        bput(imp, 0)
        zt = zt + 1
    hk = 0
    di = 0
    loop di < ndll
        fl = lget(dfuncs, di)
        fi = 0
        loop fi < lcount(fl)
            bputn(imp, rrva + ioff + lget(hn_off, hk), 8)
            hk = hk + 1
            fi = fi + 1
        bputn(imp, 0, 8)
        di = di + 1
    hk = 0
    di = 0
    loop di < ndll
        fl = lget(dfuncs, di)
        fi = 0
        loop fi < lcount(fl)
            bputn(imp, rrva + ioff + lget(hn_off, hk), 8)
            hk = hk + 1
            fi = fi + 1
        bputn(imp, 0, 8)
        di = di + 1
    di = 0
    loop di < ndll
        fl = lget(dfuncs, di)
        fi = 0
        loop fi < lcount(fl)
            nm = lget(fl, fi)
            bputn(imp, 0, 2)
            bputs(imp, nm)
            bput(imp, 0)
            if ((2 + len(nm) + 1) & 1) != 0
                bput(imp, 0)
            fi = fi + 1
        di = di + 1
    di = 0
    loop di < ndll
        dn = lget(dlls, di)
        bputs(imp, dn)
        bput(imp, 0)
        di = di + 1

    // ---- resolve relocations into A[0] (all rip-relative rel32 in .text) ----
    ri = 0
    loop ri < lcount(A[5])
        r = lget(A[5], ri)
        nm = r[0]
        off = r[1]
        add = r[2]
        e = find_label(A, nm)
        trva = 0
        if e == 0
            trva = lget(iat_rvas, lidx_str(iat_names, nm))
        else
            sc = e[1]
            so = e[2]
            if sc == 0
                trva = txtrva + so
            else if sc == 1
                trva = rrva + so
            else if sc == 2
                trva = drva + so
            else
                trva = drva + bssoff + so
        site = txtrva + off
        patch32(A[0], off, (trva + add) - (site + 4))
        ri = ri + 1

    // ---- headers ----
    entry_e = find_label(A, A[7])
    entryrva = txtrva + entry_e[2]
    imgsz = alignup(relrva + rellen, SA)
    imp_dir_va = rrva + ioff
    imp_dir_sz = (ndll + 1) * 20
    iat_dir_va = rrva + ioff + lget(iat_off, 0)
    iat_dir_sz = 0
    di = 0
    loop di < ndll
        iat_dir_sz = iat_dir_sz + (lcount(lget(dfuncs, di)) + 1) * 8
        di = di + 1

    out_buf = mkbuf(filesz + 64)
    // DOS header (64 bytes), e_lfanew=64
    bput(out_buf, 77)
    bput(out_buf, 90)
    pad_to(out_buf, 60)
    bputn(out_buf, 64, 4)
    // PE signature + COFF header
    bput(out_buf, 80)
    bput(out_buf, 69)
    bput(out_buf, 0)
    bput(out_buf, 0)
    bputn(out_buf, machine, 2)
    bputn(out_buf, nsec, 2)
    bputn(out_buf, 0, 4)
    bputn(out_buf, 0, 4)
    bputn(out_buf, 0, 4)
    bputn(out_buf, optsz, 2)
    bputn(out_buf, coffchars, 2)
    // Optional header (PE32+, 240 bytes)
    bputn(out_buf, optmagic, 2)
    bput(out_buf, 14)
    bput(out_buf, 0)
    bputn(out_buf, alignup(tlen, FA), 4)
    bputn(out_buf, alignup(rdlen, FA) + alignup(dlen, FA) + alignup(rslen, FA), 4)
    bputn(out_buf, alignup(A[3], SA), 4)
    bputn(out_buf, entryrva, 4)
    bputn(out_buf, txtrva, 4)
    bputn(out_buf, 5368709120, 8)
    bputn(out_buf, SA, 4)
    bputn(out_buf, FA, 4)
    bputn(out_buf, 6, 2)
    bputn(out_buf, 0, 2)
    bputn(out_buf, 0, 2)
    bputn(out_buf, 0, 2)
    bputn(out_buf, 6, 2)
    bputn(out_buf, 0, 2)
    bputn(out_buf, 0, 4)
    bputn(out_buf, imgsz, 4)
    bputn(out_buf, hdrsz, 4)
    // CheckSum: zero here, computed over the finished file and patched in below.
    bputn(out_buf, 0, 4)
    bputn(out_buf, 3, 2)
    // DllCharacteristics: HIGH_ENTROPY_VA (0x20) | DYNAMIC_BASE (0x40) |
    // NX_COMPAT (0x100) | TERMINAL_SERVER_AWARE (0x8000) = 0x8160. The first two
    // are ASLR, which is only honoured because .reloc exists below. NX_COMPAT is
    // what makes the W^X section split hold at run time.
    bputn(out_buf, 33120, 2)
    bputn(out_buf, pe_stack_reserve(), 8)   // SizeOfStackReserve
    bputn(out_buf, 4096, 8)                 // SizeOfStackCommit
    bputn(out_buf, 1048576, 8)              // SizeOfHeapReserve
    bputn(out_buf, 4096, 8)                 // SizeOfHeapCommit
    bputn(out_buf, 0, 4)
    bputn(out_buf, 16, 4)
    // data directories: [1] Import, [2] Resource, [5] BaseReloc, [12] IAT, the
    // rest zero
    bputn(out_buf, 0, 8)
    bputn(out_buf, imp_dir_va, 4)
    bputn(out_buf, imp_dir_sz, 4)
    bputn(out_buf, rsrva, 4)
    bputn(out_buf, rslen, 4)
    di = 3
    loop di < 5
        bputn(out_buf, 0, 8)
        di = di + 1
    bputn(out_buf, relrva, 4)
    bputn(out_buf, rellen, 4)
    di = 6
    loop di < 12
        bputn(out_buf, 0, 8)
        di = di + 1
    bputn(out_buf, iat_dir_va, 4)
    bputn(out_buf, iat_dir_sz, 4)
    di = 13
    loop di < 16
        bputn(out_buf, 0, 8)
        di = di + 1
    // section headers: .text CODE|EXECUTE|READ, .rdata and .rsrc
    // INITIALIZED|READ, .data INITIALIZED|READ|WRITE, and .reloc
    // INITIALIZED|READ|DISCARDABLE
    put_sec(out_buf, ".text", tlen, txtrva, alignup(tlen, FA), toff, 1610612768)
    put_sec(out_buf, ".rdata", rdlen, rrva, alignup(rdlen, FA), roff, 1073741888)
    put_sec(out_buf, ".data", dvsize, drva, alignup(dlen, FA), doff, 3221225536)
    put_sec(out_buf, ".rsrc", rslen, rsrva, alignup(rslen, FA), rsoff, 1073741888)
    put_sec(out_buf, ".reloc", rellen, relrva, alignup(rellen, FA), reloff, 1107296320)
    // ---- section bytes ----
    pad_to(out_buf, toff)
    copy_bytes(out_buf, A[0], tlen)
    pad_to(out_buf, roff)
    copy_bytes(out_buf, A[1], rlen)
    pad_to(out_buf, roff + ioff)
    copy_bytes(out_buf, imp, implen)
    pad_to(out_buf, doff)
    copy_bytes(out_buf, A[2], dlen)
    pad_to(out_buf, rsoff)
    copy_bytes(out_buf, rsrc, rslen)
    // .reloc: one block for .text with no entries. Nothing in the image holds
    // an absolute address inside the image (every reference the code makes is
    // rip-relative and every import goes through the IAT), so there's nothing
    // to fix up. The block still has to be here, because without a relocation
    // directory the loader ignores DYNAMIC_BASE and loads the binary at its
    // preferred base every time.
    pad_to(out_buf, reloff)
    bputn(out_buf, txtrva, 4)
    bputn(out_buf, 8, 4)
    pad_to(out_buf, filesz)
    pe_checksum(out_buf, filesz)
    return out_buf

// ---------------------------------------------------------------------------
// .rsrc: the version block and the application manifest
//
// Other Windows toolchains emit both. Without the version block Explorer's
// Details tab is empty. Without a manifest there's no declared execution level
// (so Windows' installer detection can decide a program called update.exe
// wants elevation), no declared OS support (so compatibility shims apply), and
// no active code page. The code page matters because word calls the ANSI
// entry points (CreateFileA, GetCommandLineA and others), and without a
// manifest those use the legacy code page instead of UTF-8, which mangles
// every non-ASCII path and argument.

// UTF-16LE, NUL-terminated, the only string encoding a version block uses.
wstr(b, s)
    i = 0
    loop i < len(s)
        bputn(b, s[i], 2)
        i = i + 1
    bputn(b, 0, 2)

// Version structures align every member on a 4-byte boundary.
pad4(b)
    loop (blen(b) & 3) != 0
        bput(b, 0)

// Patch a 16-bit little-endian field already written at `off`.
bset16(b, off, v)
    bset(b, off, v & 255)
    bset(b, off + 1, (v >> 8) & 255)

// The three-word header every version node starts with: its own length (patched
// by the caller once the node is built), the length of its value, and 1 for a
// text value or 0 for binary.
vs_head(b, vallen, istext)
    bputn(b, 0, 2)
    bputn(b, vallen, 2)
    bputn(b, istext, 2)

// One "key" -> "value" pair. wValueLength counts characters, including the
// terminating NUL. It's the one field in here that isn't a count of bytes.
vs_string(key, val)
    b = mkbuf(128)
    vs_head(b, len(val) + 1, 1)
    wstr(b, key)
    pad4(b)
    wstr(b, val)
    n = blen(b)
    pad4(b)
    bset16(b, 0, n)
    return b

// The whole VS_VERSIONINFO tree for a program, which is what Explorer's
// Details tab reads. It holds the program's name, taken from its source file,
// and a version of 0.0.0.0, because a program declares no version (word's own
// is in word_version()). The version strings stay in because .NET's
// FileVersionInfo, which PowerShell uses, shows none of the strings when
// FileVersion is missing. There's no InternalName or OriginalFilename: those
// are the output file's name, and with them a build written to
// word-windows-x64.exe differed from the same build written to word.exe.
build_version(prodname)
    st = mkbuf(512)
    vs_head(st, 0, 1)
    wstr(st, "040904B0")
    pad4(st)
    e = vs_string("FileDescription", prodname)
    copy_bytes(st, e, blen(e))
    e = vs_string("FileVersion", "0.0.0.0")
    copy_bytes(st, e, blen(e))
    e = vs_string("ProductName", prodname)
    copy_bytes(st, e, blen(e))
    e = vs_string("ProductVersion", "0.0.0.0")
    copy_bytes(st, e, blen(e))
    bset16(st, 0, blen(st))

    sfi = mkbuf(768)
    vs_head(sfi, 0, 1)
    wstr(sfi, "StringFileInfo")
    pad4(sfi)
    copy_bytes(sfi, st, blen(st))
    bset16(sfi, 0, blen(sfi))

    var = mkbuf(128)
    vs_head(var, 4, 0)
    wstr(var, "Translation")
    pad4(var)
    bputn(var, 1033, 2)
    bputn(var, 1200, 2)
    bset16(var, 0, blen(var))

    vfi = mkbuf(256)
    vs_head(vfi, 0, 1)
    wstr(vfi, "VarFileInfo")
    pad4(vfi)
    copy_bytes(vfi, var, blen(var))
    bset16(vfi, 0, blen(vfi))

    v = mkbuf(1024)
    vs_head(v, 52, 0)
    wstr(v, "VS_VERSION_INFO")
    pad4(v)
    // VS_FIXEDFILEINFO: the signature, the struct version, and the file and
    // product versions as two DWORDs each (major<<16|minor, build<<16|revision),
    // then the flags mask, flags, OS (VOS_NT_WINDOWS32), type (VFT_APP),
    // subtype and date.
    bputn(v, 4277077181, 4)
    bputn(v, 65536, 4)
    bputn(v, 0, 4)
    bputn(v, 0, 4)
    bputn(v, 0, 4)
    bputn(v, 0, 4)
    bputn(v, 63, 4)
    bputn(v, 0, 4)
    bputn(v, 262148, 4)
    bputn(v, 1, 4)
    bputn(v, 0, 4)
    bputn(v, 0, 4)
    bputn(v, 0, 4)
    pad4(v)
    copy_bytes(v, sfi, blen(sfi))
    copy_bytes(v, vfi, blen(vfi))
    bset16(v, 0, blen(v))
    return v

// The application manifest. The XML attribute values are single-quoted so the
// document can be written as word string literals with no escapes.
build_manifest()
    m = mkbuf(2048)
    bputs(m, "<?xml version='1.0' encoding='UTF-8' standalone='yes'?>\n")
    bputs(m, "<assembly xmlns='urn:schemas-microsoft-com:asm.v1' manifestVersion='1.0'>\n")
    bputs(m, "  <trustInfo xmlns='urn:schemas-microsoft-com:asm.v3'>\n")
    bputs(m, "    <security><requestedPrivileges>\n")
    // asInvoker: never ask for elevation. Without it, Windows' installer
    // detection goes by the file name and prompts for a program called
    // setup.exe, update.exe or patch.exe.
    bputs(m, "      <requestedExecutionLevel level='asInvoker' uiAccess='false'/>\n")
    bputs(m, "    </requestedPrivileges></security>\n")
    bputs(m, "  </trustInfo>\n")
    bputs(m, "  <compatibility xmlns='urn:schemas-microsoft-com:compatibility.v1'>\n")
    bputs(m, "    <application>\n")
    bputs(m, "      <supportedOS Id='{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}'/>\n")
    bputs(m, "      <supportedOS Id='{1f676c76-80e1-4239-95bb-83d0f6d0da78}'/>\n")
    bputs(m, "      <supportedOS Id='{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}'/>\n")
    bputs(m, "      <supportedOS Id='{35138b9a-5d96-4fbd-8e2d-a2440225f93a}'/>\n")
    bputs(m, "    </application>\n")
    bputs(m, "  </compatibility>\n")
    bputs(m, "  <application xmlns='urn:schemas-microsoft-com:asm.v3'>\n")
    bputs(m, "    <windowsSettings>\n")
    // word's strings are UTF-8 and it calls the ANSI entry points. This makes
    // those entry points use UTF-8 instead of the legacy code page, so a path
    // or an argument with a non-ASCII character survives the round trip.
    bputs(m, "      <activeCodePage xmlns='http://schemas.microsoft.com/SMI/2019/WindowsSettings'>UTF-8</activeCodePage>\n")
    bputs(m, "      <longPathAware xmlns='http://schemas.microsoft.com/SMI/2016/WindowsSettings'>true</longPathAware>\n")
    bputs(m, "    </windowsSettings>\n")
    bputs(m, "  </application>\n")
    bputs(m, "</assembly>\n")
    return m

// One resource directory node: `nid` id-entries follow it.
rsrc_dir(b, nid)
    bputn(b, 0, 4)
    bputn(b, 0, 4)
    bputn(b, 0, 2)
    bputn(b, 0, 2)
    bputn(b, 0, 2)
    bputn(b, nid, 2)

// One id-keyed entry. `sub` is 1 when the offset points at another directory
// instead of a leaf, which the offset's high bit says.
rsrc_ent(b, id, off, sub)
    bputn(b, id, 4)
    if sub == 1
        bputn(b, off + 2147483648, 4)
    else
        bputn(b, off, 4)

// The .rsrc blob: a three-level tree (type, name, language) over two leaves,
// RT_VERSION (16) and RT_MANIFEST (24), both id 1 and language 1033. Data
// entries carry RVAs, so the section's own RVA has to be known before this
// runs.
build_rsrc(rva, prodname)
    ver = build_version(prodname)
    man = build_manifest()
    vlen = blen(ver)
    mlen = blen(man)
    // 32 root + 24 + 24 type dirs + 24 + 24 name dirs + 16 + 16 data entries
    veroff = alignup(160, 8)
    manoff = alignup(veroff + vlen, 8)
    b = mkbuf(vlen + mlen + 512)
    rsrc_dir(b, 2)
    rsrc_ent(b, 16, 32, 1)
    rsrc_ent(b, 24, 56, 1)
    rsrc_dir(b, 1)
    rsrc_ent(b, 1, 80, 1)
    rsrc_dir(b, 1)
    rsrc_ent(b, 1, 104, 1)
    rsrc_dir(b, 1)
    rsrc_ent(b, 1033, 128, 0)
    rsrc_dir(b, 1)
    rsrc_ent(b, 1033, 144, 0)
    bputn(b, rva + veroff, 4)
    bputn(b, vlen, 4)
    bputn(b, 0, 4)
    bputn(b, 0, 4)
    bputn(b, rva + manoff, 4)
    bputn(b, mlen, 4)
    bputn(b, 0, 4)
    bputn(b, 0, 4)
    pad_to(b, veroff)
    copy_bytes(b, ver, vlen)
    pad_to(b, manoff)
    copy_bytes(b, man, mlen)
    return b

// One 40-byte PE section header. `vsize` is what the section occupies in memory
// (for .data that includes .bss, which has no bytes on disk), `rawsz`/`rawoff`
// what it occupies in the file.
put_sec(b, name, vsize, rva, rawsz, rawoff, chars)
    i = 0
    loop i < 8
        if i < len(name)
            bput(b, name[i])
        else
            bput(b, 0)
        i = i + 1
    bputn(b, vsize, 4)
    bputn(b, rva, 4)
    bputn(b, rawsz, 4)
    // A section with no bytes on disk (.data when every global is .bss) gets a
    // raw offset of 0 instead of the next section's, as MSVC does, so nothing
    // reading the file pairs it with the next section's bytes.
    if rawsz == 0
        bputn(b, 0, 4)
    else
        bputn(b, rawoff, 4)
    bputn(b, 0, 4)
    bputn(b, 0, 4)
    bputn(b, 0, 2)
    bputn(b, 0, 2)
    bputn(b, chars, 4)

// The PE checksum: the 16-bit ones-complement sum of the whole file with the
// field itself read as zero, folded to 16 bits, plus the file size. Windows
// only checks it for drivers and for binaries loaded into a privileged
// process, but a zero checksum is an old sign of a packed binary, and some
// antivirus engines treat a wrong one as suspicious. It costs one pass over
// the file.
pe_checksum(b, n)
    sum = 0
    i = 0
    loop i < n
        w = bget(b, i)
        if i + 1 < n
            w = w + bget(b, i + 1) * 256
        // the four bytes of the CheckSum field itself count as zero
        if i >= 152 && i < 156
            w = 0
        sum = sum + w
        sum = (sum & 65535) + (sum >> 16)
        i = i + 2
    sum = (sum >> 16) + sum
    sum = sum & 65535
    sum = sum + n
    k = 0
    loop k < 4
        bset(b, 152 + k, (sum >> (k * 8)) & 255)
        k = k + 1

patch32(buf, off, val)
    k = 0
    loop k < 4
        bset(buf, off + k, (val >> (k * 8)) & 255)
        k = k + 1

// Read back the instruction word an AArch64 relocation is patching, so the
// displacement can be OR'd into the opcode the encoder already emitted.
peek32(buf, off)
    v = 0
    k = 3
    loop k >= 0
        v = (v << 8) | bget(buf, off + k)
        k = k - 1
    return v

// A branch that can't reach its target. The site is remembered and the whole
// file is assembled again with that branch expanded (see a64_branch_r). One
// instruction where it fits is worth the extra pass, and word.w's own text is
// well past the +/-1 MB a conditional branch reaches. A branch that isn't a
// site (-1) can't be expanded, and is an error.
a64_relax(A, site, name)
    if site < 0
        err("wasm: a64 branch to " . name . " is out of range and not relaxable")
        A[16] = 1
        return 0
    A[20] = ladd_grow(A[20], site)
    return 0

// Fill in one AArch64 relocation of the given kind (see add_reloc_k).
// Displacements are word-scaled and sit in the middle of the instruction, so
// this reads the word back and ORs the field in. A displacement that doesn't
// fit is never truncated, which would give a binary that jumps somewhere
// plausible: a conditional branch or tbz/tbnz is relaxed (a64_relax), and
// anything else is an error. `name` is the target, for the message.
patch_a64(A, off, at, rel, kind, rsite, name)
    w = peek32(A[0], off)
    if kind == 1
        d = rel >> 2
        if d >= 33554432 || d < 0 - 33554432
            err("wasm: a64 b/bl to " . name . " is out of range (+/-128 MB)")
            A[16] = 1
            return 0
        bset_a64(A[0], off, w | (d & 67108863))
        return 0
    if kind == 2
        d = rel >> 2
        if d >= 262144 || d < 0 - 262144
            return a64_relax(A, rsite, name)
        bset_a64(A[0], off, w | ((d & 524287) << 5))
        return 0
    if kind == 3
        if rel >= 1048576 || rel < 0 - 1048576
            err("wasm: a64 adr of " . name . " is out of range (+/-1 MB)")
            A[16] = 1
            return 0
        bset_a64(A[0], off, w | ((rel & 3) << 29) | (((rel >> 2) & 524287) << 5))
        return 0
    if kind == 5
        d = rel >> 2
        if d >= 8192 || d < 0 - 8192
            return a64_relax(A, rsite, name)
        bset_a64(A[0], off, w | ((d & 16383) << 5))
        return 0
    if kind == 6
        bset_a64(A[0], off, w | (((at + rel) & 4095) << 10))
        return 0
    if kind == 7
        sz = (w >> 30) & 3
        lo = (at + rel) & 4095
        if (lo & ((1 << sz) - 1)) != 0
            err("wasm: a64 :lo12: address of " . name . " is not aligned for the access width")
            A[16] = 1
            return 0
        bset_a64(A[0], off, w | ((lo >> sz) << 10))
        return 0
    // ADRP (kind 4): the target's page relative to the instruction's page. That
    // isn't the displacement shifted, because the instruction and the target
    // needn't sit at the same offset in their pages.
    d = ((at + rel) >> 12) - (at >> 12)
    if d >= 1048576 || d < 0 - 1048576
        err("wasm: a64 adrp of " . name . " is out of range (+/-4 GB)")
        A[16] = 1
        return 0
    bset_a64(A[0], off, w | ((d & 3) << 29) | (((d >> 2) & 524287) << 5))
    return 0

bset_a64(buf, off, w)
    k = 0
    loop k < 4
        bset(buf, off + k, (w >> (k * 8)) & 255)
        k = k + 1

pad_to(out_buf, target)
    loop blen(out_buf) < target
        bput(out_buf, 0)

copy_bytes(out_buf, src, n)
    i = 0
    loop i < n
        bput(out_buf, bget(src, i))
        i = i + 1

// ============================================================================
// The driver. compile_src runs the compiler, and the CLI below hands its
// assembly to the assembler and the ELF, PE or Mach-O writer.
// ============================================================================

// compile_src(src, target, name, map, bundle_ln) -> [asm_region, net_flag], or
// 0 on a compile error, which it has already reported. It runs tokenize ->
// parse -> analyze -> codegen and stops at the first stage that finds an
// error, so malformed input gets a located message instead of an internal
// fault. `name` is the source path: diagnostics start with it
// (`name:line:col: message`), and its last component is the file a run-time
// fault names. `map` is a folder program's line map (0 for a single file) and
// `bundle_ln` the first line of the bundled net library (0 when there's none).
// The generators emit through asmput() into the sys emit buffer, and asmtake()
// hands back the assembly as one region. net_flag is 1 when the program uses
// net or the socket verbs.
compile_src(src, target, name, map, bundle_ln)
    st = text(21)
    indents = text(256)
    st[0] = 0
    st[1] = 1
    st[2] = 1
    st[3] = 0
    indents[0] = 0
    st[4] = 1
    st[5] = 1
    st[6] = 0
    st[7] = src
    st[8] = indents
    st[9] = text(65536)
    st[10] = text(200000)
    st[11] = 0
    st[12] = 0
    st[13] = 0
    tokenize(st)
    if st[13] != 0
        err(srcloc(map, name, st[14]) . ":" . st[15] . ": " . st[16])
        return 0
    ps = text(11)
    ps[0] = 0
    ps[1] = st[10]
    ps[2] = st[11]
    ps[3] = 0
    ps[7] = name
    // ps[8]/ps[9]/ps[10]: how deep in expressions, in blocks, and in one chain
    // of operators the parser is right now (pnest_enter, pbnest_enter,
    // pcnest_enter).
    ps[8] = 0
    ps[9] = 0
    ps[10] = 0
    prog = pprogram(ps)
    if ps[3] != 0
        err(srcloc(map, name, ps[4]) . ":" . ps[5] . ": " . ps[6])
        return 0
    an = text(33)
    an[0] = 0
    an[1] = mklist(8192)
    an[2] = mklist(64)
    an[3] = mklist(4096)
    an[4] = mklist(4096)
    an[5] = name
    an[6] = 0
    an[7] = 0
    an[8] = 0
    an[9] = 0
    an[10] = 0
    an[11] = 0
    an[12] = mklist(4)
    // an[13]: the same function entries as an[1], keyed by name (func_lookup)
    an[13] = {}
    // an[14]: does the program call random()? On Windows that's a syscall the
    // OS layer has to map (BCryptGenRandom), and mapping it pulls in
    // bcrypt.dll, so like every other runtime gate it's emitted only for a
    // program that uses it.
    an[14] = 0
    // an[15]: does the program call now()? The same, for clock_gettime.
    an[15] = 0
    // an[16]: does the program use txt (char, decode, encode, split or pad)?
    // an[17]: does it call kind()? Both gate their runtime and their data.
    // an[18]/[19]/[20]: does it call args(), env(), or sys.exec? Each gates its
    // runtime and, on Windows, the kernel32 imports that runtime uses.
    an[16] = 0
    an[17] = 0
    an[18] = 0
    an[19] = 0
    an[20] = 0
    // an[21]: the folder line map, so aerr locates a diagnostic in the real file
    // (0 for a single-file build, where the entry name and line are used as-is).
    an[21] = map
    // an[22]: the first line of the bundled library source, or 0 when a
    // program carries none. The bundled modules define everything `net` might
    // need and a program calls a fraction of it, so the unused-function check
    // (SPEC 10.1) only looks at functions defined before this line, the code
    // the programmer wrote.
    an[22] = bundle_ln
    // an[23]: does the program call sys.cacerts()? Gates rt_cacerts and, on
    // Windows, the crypt32 imports it reaches the ROOT store through.
    an[23] = 0
    // an[24]: the definite-assignment set for the body being checked (0 outside
    // one), an[25]: that body's root scope, which indexes it. See da_new.
    an[24] = 0
    an[25] = 0
    // an[27]: does the program call fs.dir? (an[26] is the local-kind table.)
    an[27] = 0
    // an[28]: does the program call sys.nameservers()? Gates rt_nameservers
    // and, on Windows, the iphlpapi import it asks the resolvers through.
    an[28] = 0
    // an[29]: does the program call sys.writex()? Gates rt_writex, and with
    // fs it gates the path encoder, the file buffers and the open arm of the
    // Windows and macOS OS layers.
    an[29] = 0
    // an[30]: does the program call fs.write, fs.append or fs.rename? Gates
    // rt_writef and rt_rename, and on Windows the write arms of open,
    // MoveFileExA and GetFileAttributesA.
    an[30] = 0
    // an[31]: does the program call sys.image()? Gates rt_image and, on
    // Windows, the GetModuleFileNameW import it asks through.
    an[31] = 0
    // an[32]: the function-table entry of the function whose body is being
    // checked, or 0 at the top level and in a hook (check_call's caller).
    an[32] = 0
    an_analyze(an, prog)
    if an[0] != 0
        return 0
    items = prog[1]
    cg = text(65)
    // cg[63]: the float locals the function being emitted pinned to xmm8-xmm15
    // (pick_fpins), 0 outside one; cg[64]: the frame offset their callers'
    // values are saved at. The float twins of cg[39] and cg[40].
    cg[63] = 0
    cg[64] = 0
    // cg[22]: the source file's name, the last path component only, so a
    // run-time fault can name its file the way a compile error does without
    // shipping the build directory inside every binary. It's UTF-8, one
    // element per byte, because the fault header prints it with its length in
    // bytes.
    cg[22] = utf8_units(path_base(name))
    // cg[57]: a folder program's files, for a fault to name the one it is in
    // (fault_files); 0 for a single file.
    cg[57] = fault_files(map, bundle_ln)
    cg[0] = 0
    cg[1] = {}
    // cg[49]: the whole-program callee-retention table (infer_retention). 0
    // until that pass runs, and 0 means "assume every argument is kept", which
    // is what the pass itself needs while it is walking.
    cg[49] = 0
    // cg[50]: the whole-program one-line-accessor table (infer_inlines).
    cg[50] = 0
    // cg[51]: is_counting's answers for the function being generated, a map
    // from a name to whether it's a counting induction variable. It's built the
    // first time a loop asks, from cg[53] and cg[54], and is 0 until then.
    cg[51] = 0
    // cg[52]: the (region, index) pairs whose bounds check the enclosing loop
    // guard already made. Saved and restored around each loop body, so a nested
    // loop adds to it without outliving itself.
    cg[52] = 0
    // cg[53]/cg[54]: the current function's parameters and body, so cg[51] can
    // be built the first time a loop asks and not before.
    cg[53] = 0
    cg[54] = 0
    // cg[55]: the line a call in the statement being generated has to put back
    // into cur_line, or 0 when nothing after the call can fault.
    cg[55] = 0
    // cg[56]: the first line of the bundled net library, as an[22]; its
    // statements store no line (stmt_line_plan).
    cg[56] = an[22]
    cg[2] = 0
    cg[3] = 0
    cg[4] = mklist(65536)
    // cg[47]: parallel to cg[4], 1 where that literal is a byte blob.
    cg[47] = mklist(65536)
    cg[5] = 0
    cg[6] = 0
    cg[7] = 0
    cg[8] = 0
    cg[9] = mklist(4096)
    cg[10] = mklist(4096)
    cg[11] = an[7]
    // cg[12] is the Windows flag, cg[41] the instruction set. Target 2 (Linux
    // arm64) is a Linux target with a different encoder, so it sets the second
    // and leaves the first alone: every `if cg[12] == 1` in the generator
    // means Windows, and none of them means "not x86-64".
    cg[12] = 0
    cg[41] = 0
    cg[45] = 0
    if target == 1
        cg[12] = 1
    else if target == 2 || target == 3
        cg[41] = 1
        if target == 3
            cg[45] = 1
    cg[13] = 0
    cg[43] = 0
    // cg[44]: the per-function u32-local table (infer_u32_locals). 0 until the
    // first frame is built, exactly like the kind table cg[23].
    cg[44] = 0
    cg[14] = st[12]
    cg[15] = 0
    cg[16] = mklist(8)
    // cg[17]/[18]/[19]: does the program read stdin, use fs, use the sys emit
    // buffer (asmput/asmtake)? Each gates the matching block of emit_runtime and
    // its .bss buffers. cg[60] is sys.writex, cg[37] sys.exec and cg[11] the
    // sockets, the other three pieces of sys.
    cg[17] = an[8]
    cg[18] = an[9]
    cg[19] = an[10]
    cg[60] = an[29]
    // cg[61]: the program writes, appends or renames a file (an[30]).
    cg[61] = an[30]
    // cg[62]: sys.image() (an[31]).
    cg[62] = an[31]
    cg[20] = an[11]
    // cg[30]/[31]: does the program call random() / now()? Each gates the Windows
    // mapping for the syscall that builtin issues (getrandom / clock_gettime).
    cg[30] = an[14]
    cg[31] = an[15]
    // cg[32]/[33]: the text module, and kind(). Same gating as every other block:
    // a program that uses neither carries neither the routines nor the literals.
    cg[32] = an[16]
    cg[33] = an[17]
    // cg[35]/[36]/[37]: args(), env(), sys.exec. On Linux each drops a routine;
    // on Windows each also drops the kernel32 imports behind it, which is why a
    // hello world used to declare CreateProcessA.
    cg[35] = an[18]
    cg[36] = an[19]
    cg[37] = an[20]
    // cg[48]: sys.cacerts(). The same shape again: a routine on every target,
    // and on Windows the crypt32 imports underneath it.
    cg[48] = an[23]
    // cg[58]: fs.dir(), which on Windows is its own arm of the OS layer.
    cg[58] = an[27]
    // cg[59]: sys.nameservers(), the shape of cg[48]: a routine on every
    // target, and on Windows the iphlpapi import underneath it.
    cg[59] = an[28]
    // cg[23]: the inferred kind of every local of the function being emitted
    // (infer_local_kinds); 0 outside a frame.
    cg[23] = 0
    // cg[24]: the whole-program parameter-kind table (infer_param_kinds);
    // cg[25]: the row for the function being emitted, or 0 to assume nothing.
    cg[24] = 0
    cg[25] = 0
    cg[46] = 0
    // cg[26]: the parameter-kind worklist, live only during infer_param_kinds;
    // cg[27]: the row being visited by that pass, for recording reverse edges;
    // cg[28]: 1 while emitting a function whose result travels in xmm0 raw.
    cg[26] = 0
    cg[27] = 0
    cg[28] = 0
    // cg[29]: the distinct float literals of the program, one 8-byte slot each
    cg[29] = mklist(16)
    // cg[34]: the locals of the function being emitted whose old region is
    // rewound when it is overwritten (collect_reclaim); 0 outside such a frame,
    // which is what turns the rewind off inside a contract hook.
    cg[34] = 0
    if an[6] == 1
        cg[14] = 1
    fnames = cg[1]
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 2
            fnames[it[1]] = 1
        i = i + 1
    if cg[41] == 1
        a64_gen_program(cg, prog)
        if cg[43] != 0
            return 0
    else
        gen_program(cg, prog)
    r = text(2)
    r[0] = asmtake()
    r[1] = cg[11]
    return r

// Are two regions equal, element for element?
regions_equal(a, b)
    n = len(a)
    if n != len(b)
        return false
    i = 0
    loop i < n
        if a[i] != b[i]
            return false
        i = i + 1
    return true

// Assemble and link, relaxing AArch64 conditional branches until every one of
// them reaches. A conditional branch reaches +/-1 MB and word.w's own text is
// bigger than that, so some can't be one instruction, but which ones is only
// known once everything is laid out, and expanding one moves the rest. So
// this assembles optimistically, notes every branch that couldn't reach, and
// does it again with those expanded. It settles in two or three rounds,
// because each round only adds instructions. An x86-64 target is done in one
// round (rel32 reaches the whole image).
//
// `srcs` is the assembly as a region of texts, assembled in order into one
// image: a build's one text, or the files given to `word asm`. Both go
// through here, so `word asm -arm64` relaxes a branch the same way
// `word build -arm64` does. (It used to assemble once, and a branch that
// couldn't reach was left with a displacement of 0, a branch to itself.)
// Returns the image, or 0 after reporting why there's none.
assemble_link(srcs, net_flag, target, prodname)
    relax = text(1)
    rounds = 0
    loop true
        r = assemble_link_1(srcs, net_flag, target, prodname, relax)
        if r[0] == 0
            return 0
        if r[0] == 1
            return r[1]
        relax = a64_relax_set(r[1], relax)
        rounds = rounds + 1
        if rounds > 8
            err("word: AArch64 branch relaxation did not settle")
            return 0

// One text as the region of texts assemble_link takes.
asm_srcs(asm)
    srcs = text(1)
    srcs[0] = asm
    return srcs

// The sites of this round, merged with the ones already known.
a64_relax_set(sites, prev)
    n = len(prev)
    i = 0
    loop i < lcount(sites)
        v = lget(sites, i)
        if v + 1 > n
            n = v + 1
        i = i + 1
    rx = text(n)
    i = 0
    loop i < len(prev)
        rx[i] = prev[i]
        i = i + 1
    i = 0
    loop i < lcount(sites)
        rx[lget(sites, i)] = 1
        i = i + 1
    return rx

assemble_link_1(srcs, net_flag, target, prodname, relax)
    A = new_asm()
    A[18] = relax
    // Target 2 is Linux arm64: an ELF like target 0, so A[11] (the Windows
    // syscall redirection) stays 0, and A[17] switches the instruction set.
    // Target 3 is macOS arm64: the same instruction set again, written into a
    // Mach-O instead of an ELF.
    if target == 2 || target == 3
        A[17] = 1
    else
        A[11] = target
    i = 0
    loop i < len(srcs)
        assemble(A, srcs[i])
        i = i + 1
    // Nothing is added for a net program, so net_flag goes unused. `net` is
    // word (the NETLIB region), bundled into the program's own source by
    // with_netlib and compiled with it, so it's already in the assembly, and
    // it's the same code on every target, which is why the net library is
    // word instead of assembly for each target.
    // r[0] says which of three things happened (0 failed, 1 an image in r[1],
    // 2 branch sites to relax in r[1]), because a kind test can't tell an
    // image from a list of sites.
    r = text(2)
    r[0] = 0
    // Every writer looks the entry symbol up by name, and a file with no
    // `.global` leaves that name unset. Both cases are checked here, so a file
    // that forgot the directive gets a message about the input instead of a
    // fault inside the compiler.
    if A[7] == 0
        err("wasm: no entry symbol (the file needs a `.global <name>` and a label to match)")
        return r
    if find_label(A, A[7]) == 0
        err("wasm: entry symbol '" . A[7] . "' is declared .global but has no label")
        return r
    img = 0
    if target == 1
        img = link_pe(A, prodname)
        // link_pe has reported the symbol it couldn't resolve.
        if kind(img) == "number"
            A[16] = 1
    else if target == 3
        img = link_macho(A)
    else
        img = link(A)
    // An instruction that couldn't be encoded, or a symbol that couldn't be
    // resolved, has already been reported. Writing the image anyway would hand
    // back a binary with a hole in it. Relaxing a branch fixes neither, so this
    // is checked first and the errors are reported once.
    if A[16] == 1
        err("word: refusing to write the output, because of the errors above")
        return r
    // A branch that couldn't reach isn't an error. It's a request to assemble
    // the whole file again with that branch expanded.
    if lcount(A[20]) > 0
        r[0] = 2
        r[1] = A[20]
        return r
    r[0] = 1
    r[1] = btake(img)
    return r

// The last path component, with both / and \ as separators. It's the name a
// run-time fault reports. A compile error naming the whole path is useful at
// the terminal, but a built program carries the name in its data section,
// and the machine it was built on is nobody else's business. So the binary
// says `hello.w:12: index out of bounds`, without the build directory.
path_base(path)
    n = len(path)
    slash = 0 - 1
    i = 0
    loop i < n
        if path[i] == 47 || path[i] == 92
            slash = i
        i = i + 1
    return copy(path, slash + 1, n)

// The default output name for a source path: the last component without its
// extension, with .exe added for the Windows target (1). Both / and \ are
// separators, so examples\hello\hello.w gives hello.
default_out(path, target)
    n = len(path)
    slash = 0 - 1
    dot = 0 - 1
    i = 0
    loop i < n
        if path[i] == 47 || path[i] == 92
            slash = i
        if path[i] == 46
            dot = i
        i = i + 1
    start = slash + 1
    stop = n
    if dot > start
        stop = dot
    base = copy(path, start, stop)
    if target == 1
        base = base . ".exe"
    return base

// path_key(p) -> the spelling two paths are compared by when the question is
// whether writing one would replace the other. Both / and \ separate, empty
// and "." components are dropped, ASCII letters are folded to lower case, and
// trailing dots and spaces are cut from each component, as Windows does when
// it opens a file. ".." stays as it is, because resolving it needs the file
// system (a link can make a/../b a different file from b). Folding case on
// Linux can make two different names match, and all that costs is a refused
// build.
path_key(p)
    n = len(p)
    r = text(n + 1)
    k = 0
    if n > 0 && (p[0] == 47 || p[0] == 92)
        r[0] = 47
        k = 1
    i = 0
    loop i < n
        j = i
        loop j < n && p[j] != 47 && p[j] != 92
            j = j + 1
        e = j
        if e - i == 1 && p[i] == 46
            e = i
        else if e - i != 2 || p[i] != 46 || p[i + 1] != 46
            loop e > i && (p[e - 1] == 46 || p[e - 1] == 32)
                e = e - 1
        if e > i
            if k > 0 && r[k - 1] != 47
                r[k] = 47
                k = k + 1
            c = i
            loop c < e
                ch = p[c]
                if ch >= 65 && ch <= 90
                    ch = ch + 32
                r[k] = ch
                k = k + 1
                c = c + 1
        i = j + 1
    return copy(r, 0, k)

// writes_over(out, srcs) -> the path in the list `srcs` that writing `out`
// would replace, or 0 if none, by path_key first. The same file can also be
// reached by another spelling (an absolute path for a relative one, or a
// link), so when the last components match, or `out` is itself named like a
// source, the file at `out` is read and compared with that source. Only
// then, because reading whatever `out` names could block, on a FIFO or on
// -o /dev/stdout with stdout a pipe.
writes_over(out, srcs)
    ko = path_key(out)
    bo = path_key(path_base(out))
    i = 0
    loop i < lcount(srcs)
        sp = lget(srcs, i)
        if path_key(sp) == ko
            return sp
        if path_key(path_base(sp)) == bo || ends_w(bo)
            a = read(out)
            if kind(a) != "none"
                b = read(sp)
                if kind(b) != "none" && regions_equal(a, b)
                    return sp
        i = i + 1
    return 0

// The target `build` and `run` default to: the one this binary was built for.
// sys.os() and sys.arch() are both constants the backend writes into the
// binary, because a cross-built binary looks the same from the inside as a
// native one. (Going by the OS environment variable used to make a word.exe
// started without it build ELFs, and a Linux word with OS=Windows_NT build
// PEs.)
host_target()
    if os() == 1
        return 1
    if arch() == 1
        if os() == 2
            return 3
        return 2
    return 0

// target_flag(f) -> the target a command-line flag names (0 -linux, 1 -win,
// 2 -arm64, 3 -mac), or -1 when f isn't a target flag.
target_flag(f)
    if f == "-linux"
        return 0
    if f == "-win"
        return 1
    if f == "-arm64"
        return 2
    if f == "-mac"
        return 3
    return 0 - 1

// target_name(t) -> a target as the CLI's messages name it.
target_name(t)
    if t == 1
        return "windows x86-64"
    if t == 2
        return "linux arm64"
    if t == 3
        return "macos arm64"
    return "linux x86-64"

// is_flag(f) -> whether a command-line word is spelled like a flag: a dash and
// something after it. A lone "-" isn't one.
is_flag(f)
    return len(f) > 1 && f[0] == 45

// run_tmp_name() -> the base name `word run` gives its temporary binary:
// "word-run-" and 62 fresh random bits. It's a new name every time instead of
// a fixed path, so two runs can't overwrite each other, the path can't be
// guessed in a shared directory, and fs.protected_regular=1 (which stops one
// user opening another's file for writing in a sticky, world-writable
// directory) never gets in the way. The binary is left behind: exec doesn't
// return (execve replaces this process, and on Windows it exits with the
// child's status), so there's no "after" in which to remove it. A caller that
// minds can point TMPDIR (TEMP on Windows) at a directory it cleans up itself.
run_tmp_name()
    return "word-run-" . random()

// run_tmp_dir(v, fb) -> the temp directory named by environment variable v,
// with a trailing slash trimmed so joining a name can't produce "//", or fb
// when it's unset or empty.
run_tmp_dir(v, fb)
    d = env(v)
    // env() answers none for a variable that isn't set, which is a different
    // answer from one set to the empty string, and len() of none is a fault.
    // It's asked through kind() instead of `d == none` because the bootstrap
    // seed implements neither singleton (bootstrap/codegen.py) and this file
    // has to compile there too.
    if kind(d) == "none"
        return fb
    if len(d) == 0
        return fb
    if d[len(d) - 1] == 47
        d = copy(d, 0, len(d) - 1)
    if len(d) == 0
        return fb
    return d

// run_tmp_win() -> the path `word run` builds its temporary .exe to on
// Windows: the user temp directory (%TEMP%, then %TMP%), else the current
// directory. The Win32 file and process calls take forward slashes, even
// mixed with the directory's backslashes.
run_tmp_win()
    t = run_tmp_dir("TEMP", "")
    if len(t) == 0
        t = run_tmp_dir("TMP", "")
    if len(t) == 0
        return run_tmp_name() . ".exe"
    return t . "/" . run_tmp_name() . ".exe"

// run_tmp() -> the same on Linux and macOS: $TMPDIR, else /tmp.
run_tmp()
    return run_tmp_dir("TMPDIR", "/tmp") . "/" . run_tmp_name() . ".bin"

// fingerprint(b) -> a short hex FNV-1a of a region's bytes, for `word version`.
// It isn't a security hash and isn't used as one. It's there so two builds can
// be told apart by eye, on one line.
fingerprint(b)
    h = 2166136261
    i = 0
    loop i < len(b)
        h = (h ^ b[i]) * 16777619 % 4294967296
        i = i + 1
    d = "0123456789abcdef"
    r = text(8)
    j = 7
    loop j >= 0
        r[j] = d[h % 16]
        h = idiv(h, 16)
        j = j - 1
    return r

// arg(n) -> command-line argument n, or empty text when there's no such one.
// Indexing args() is bounds-checked like any other region, which is right for
// the language and wrong for a CLI parser that wants to ask "was there a
// fourth word?", so the check is here, once.
arg(n)
    a = args()
    if n < 0 || n >= len(a)
        return ""
    return a[n]

// selfbytes() -> this executable's own bytes, or 0 if they can't be read. It
// reads the running image, and argv[0] only where nothing better exists:
// argv[0] is what the caller typed, so a word.exe found through PATH and run
// from a folder holding another word.exe used to read that other file and
// judge it. Windows is asked for the image's path (sys.image()), and Linux
// reads /proc/self/exe. Neither is tried on the other: on Windows
// /proc/self/exe is \proc\self\exe at the root of the current drive, which
// any signed-in user may create. Where neither answers (macOS, or a Linux
// without /proc), argv[0] is used only when it holds a slash, since a name
// found through PATH arrives bare and read() would look for it in the current
// directory.
selfbytes()
    if os() == 1
        p = image()
        if kind(p) != "none"
            b = read(p)
            if kind(b) != "none"
                return b
        return 0
    if os() == 0
        b = read("/proc/self/exe")
        if kind(b) != "none"
            return b
    a0 = arg(0)
    i = 0
    loop i < len(a0)
        if a0[i] == 47
            b = read(a0)
            if kind(b) != "none"
                return b
            return 0
        i = i + 1
    return 0

// The released version, and the only place it's written down. release.yml
// checks that a tag is `v` followed by this before it publishes anything, so
// the two can't drift apart.
//
// It's a constant. A build date or a commit hash in the binary would make two
// builds of the same source differ, and `word verify` would stop holding. So a
// build from an untagged commit reports the version it was branched from.
word_version()
    return "1.0.0"


// do_version() -> what this binary is, and whether it's in step with the
// compiler/word.w next to it.
//
// A stale toolchain fails on the first program that uses newer syntax, and the
// parse error points at your file instead of the compiler. `word version`
// rebuilds for the host target and compares, so you can tell. (The host target
// is the one this binary builds by default, so a word.exe is compared with a
// PE and a Linux word with an ELF.)
do_version()
    tgt = host_target()
    out("word " . word_version() . " - one binary: compiler, x86-64 and AArch64 assemblers, ELF, PE and Mach-O linkers, runtime")
    if tgt == 1
        out("  host target      windows x86-64 (build/run emit a PE; -linux cross-compiles an ELF)")
    else if tgt == 2
        out("  host target      linux arm64 (build/run emit an arm64 ELF; -linux cross-compiles x86-64)")
    else if tgt == 3
        out("  host target      macos arm64 (build/run emit a Mach-O; -linux cross-compiles an ELF)")
    else
        out("  host target      linux x86-64 (build/run emit an ELF; -win/-arm64 cross-compile)")
    self = selfbytes()
    if kind(self) == "number"
        out("  this binary      cannot read it back to fingerprint it")
    else
        out("  this binary      " . len(self) . " bytes, fingerprint " . fingerprint(self))
    src = read("compiler/word.w")
    if kind(src) == "none"
        out("  compiler/word.w  not in this directory")
        out("  Run `word version` from a word checkout to check this binary is in step with it.")
        return 0
    out("  compiler/word.w  " . len(src) . " bytes, fingerprint " . fingerprint(src))
    // Without a verdict this fails (it used to end here with exit 0).
    if kind(self) == "number"
        err("  in step          unknown - this binary cannot read itself to compare")
        return 1
    // What gets compiled is this file with its NETLIB region lifted into
    // netlib_src, as bootstrap and verify do it.
    src = netlib_embed(src)
    if kind(src) == "number"
        return 1
    r = compile_src(src, tgt, "compiler/word.w", 0, 0)
    if kind(r) == "number"
        err("  OUT OF STEP: this binary cannot even compile ./compiler/word.w.")
        err("  Rebuild it from a binary that can, or reseed per docs/BOOTSTRAP.md.")
        return 1
    rebuilt = assemble_link(asm_srcs(r[0]), r[1], tgt, "word")
    if kind(rebuilt) == "number"
        out("  in step          unknown (this binary could not assemble and link the rebuild)")
        return 0
    if regions_equal(rebuilt, self)
        out("  in step          yes - rebuilding compiler/word.w with this binary reproduces it exactly")
        return 0
    err("  OUT OF STEP: this binary was NOT built from ./compiler/word.w.")
    err("  A program using syntax newer than this binary fails to parse, and the error")
    err("  names your file and line, so it looks like a bug in your program when it isn't.")
    if tgt == 1
        err("  Rebuild:  word.exe bootstrap -o word.new.exe   then replace this binary with it")
    else
        err("  Rebuild:  ./word bootstrap -o word.new   then replace this binary with it")
    return 1

// ---- the folder is the program (SPEC 11) ------------------------------------
// When the entry file is app.w, its directory is the program: every other .w
// file beside it is compiled in, and those hold definitions only, in any
// order. Any other entry file builds by itself. dir() lists the folder, the
// files are joined entry first with the siblings sorted so the build is
// reproducible, and a line map remembers which file each line of the joined
// text came from, so a diagnostic still points at the real file and line.

// The directory part of a path (before the last / or \), or "." if there's
// none.
path_dir(path)
    n = len(path)
    slash = 0 - 1
    i = 0
    loop i < n
        if path[i] == 47 || path[i] == 92
            slash = i
        i = i + 1
    if slash < 0
        return "."
    return copy(path, 0, slash)

// The number of newlines in a source region.
count_nl(s)
    n = 0
    i = 0
    loop i < len(s)
        if s[i] == 10
            n = n + 1
        i = i + 1
    return n

// A trailing newline, added only if absent, so the next file starts on its line.
ensure_nl(s)
    n = len(s)
    if n > 0 && s[n - 1] == 10
        return s
    return s . "\n"

// Does the name end in ".w"? (This also drops . and .. and any file that isn't
// source. A directory named like one is dropped later, in multifile_src.)
ends_w(nm)
    n = len(nm)
    if n < 3
        return false
    if nm[n - 2] == 46 && nm[n - 1] == 119
        return true
    return false

// Lexicographic byte order over two names.
name_lt(a, b)
    la = len(a)
    lb = len(b)
    n = la
    if lb < n
        n = lb
    i = 0
    loop i < n
        if a[i] != b[i]
            return a[i] < b[i]
        i = i + 1
    return la < lb

// The .w files in a directory listing (dir()'s newline-joined names) other
// than the entry file, sorted. An insertion sort, since a program is a few
// files.
w_siblings(listing, base)
    tmp = mklist(8)
    n = len(listing)
    start = 0
    i = 0
    loop i <= n
        cut = 0
        if i == n
            cut = 1
        else if listing[i] == 10
            cut = 1
        if cut == 1
            if i > start
                nm = copy(listing, start, i)
                if ends_w(nm) && nm != base
                    tmp = ladd_grow(tmp, nm)
            start = i + 1
        i = i + 1
    cnt = lcount(tmp)
    arr = text(cnt)
    i = 0
    loop i < cnt
        arr[i] = lget(tmp, i)
        i = i + 1
    i = 1
    loop i < cnt
        key = arr[i]
        j = i - 1
        loop j >= 0 && name_lt(key, arr[j])
            arr[j + 1] = arr[j]
            j = j - 1
        arr[j + 1] = key
        i = i + 1
    return arr

// The UTF-8 of text `s`, one element per byte: what the OS is handed for a
// path, and what a fault prints for a file name. The emit buffer keeps one
// byte per element, so text written there as code points would lose all but
// the low byte of each. A value that isn't a character (nothing the decoder
// produces) is kept as it is, so this always has an answer.
utf8_units(s)
    n = 0
    i = 0
    loop i < len(s)
        c = s[i]
        if c < 128 || c > 1114111
            n = n + 1
        else if c < 2048
            n = n + 2
        else if c < 65536
            n = n + 3
        else
            n = n + 4
        i = i + 1
    r = text(n)
    k = 0
    i = 0
    loop i < len(s)
        c = s[i]
        if c < 128 || c > 1114111
            r[k] = c
            k = k + 1
        else if c < 2048
            r[k] = 192 | (c >> 6)
            r[k + 1] = 128 | (c & 63)
            k = k + 2
        else if c < 65536
            r[k] = 224 | (c >> 12)
            r[k + 1] = 128 | ((c >> 6) & 63)
            r[k + 2] = 128 | (c & 63)
            k = k + 3
        else
            r[k] = 240 | (c >> 18)
            r[k + 1] = 128 | ((c >> 12) & 63)
            r[k + 2] = 128 | ((c >> 6) & 63)
            r[k + 3] = 128 | (c & 63)
            k = k + 4
        i = i + 1
    return r

// The bytes the OS knows a sibling by: the folder, which is text and so goes
// out as UTF-8 like any path, then the name as dir() listed it.
// `folder . "/" . name` would promote the listed bytes to one code point per
// byte, and a non-ASCII name would then be asked for under a spelling it
// doesn't have.
sibling_path(folder, name)
    enc = utf8_units(folder)
    k = len(enc)
    r = bytes(k + 1 + len(name))
    i = 0
    loop i < k
        r[i] = enc[i]
        i = i + 1
    r[k] = 47
    i = 0
    loop i < len(name)
        r[k + 1 + i] = name[i]
        i = i + 1
    return r

// The text a listed name reads as, for a diagnostic to show: the lexer's own
// UTF-8 decoder run over the name's bytes.
name_text(b)
    st = text(21)
    st[0] = 0
    st[1] = 1
    st[2] = 1
    st[7] = b
    r = text(len(b))
    n = 0
    loop st[0] < len(b)
        r[n] = lcodepoint(st)
        n = n + 1
    return copy(r, 0, n)

// ---- the bundled net library ------------------------------------------------
//
// `net` is written in word (carried in this file's NETLIB region), so a
// program that calls get, post, put, delete or head is compiled together with
// the library that implements it. There's no import to write: the modules are
// pulled in by use, the same way char() needs no `import txt`.
//
// The decision has to be made before the source is parsed, because the
// library has to be in the source that gets parsed. So it's a scan of the
// text for a net verb used as a call, instead of an answer from the analyzer.
// A false yes costs unused code, which the unused-function check already
// allows in bundled source. A false no can't happen, because a call is always
// the verb followed by `(`.

// Is `c` a byte that can appear inside an identifier?
ident_ch(c)
    if c >= 97 && c <= 122
        return true
    if c >= 65 && c <= 90
        return true
    if c >= 48 && c <= 57
        return true
    if c == 95
        return true
    return false

// Does `src` call `verb`: the whole identifier, then `(`, with only spaces or
// tabs between? A name with the verb inside it (`forget(`) doesn't count, and
// neither does one in a comment or a string: word.w mentions `get()` in its
// comments, and taking those for calls made the compiler try to bundle the
// net library into itself. `x.get(` does count, because `.` is the join
// operator and what follows it is a call.
calls_verb(src, verb)
    n = len(src)
    m = len(verb)
    i = 0
    loop i < n
        c = src[i]
        if c == 47 && i + 1 < n && src[i + 1] == 47
            // a line comment runs to the newline
            loop i < n && src[i] != 10
                i = i + 1
        else if c == 34
            i = i + 1
            loop i < n && src[i] != 34
                if src[i] == 92
                    i = i + 1
                i = i + 1
            i = i + 1
        else if c == 39
            i = i + 1
            loop i < n && src[i] != 39
                if src[i] == 92
                    i = i + 1
                i = i + 1
            i = i + 1
        else
            hit = 0
            if i + m <= n && c == verb[0]
                if copy(src, i, i + m) == verb
                    hit = 1
            if hit == 1 && i > 0
                if ident_ch(src[i - 1])
                    hit = 0
            if hit == 1
                j = i + m
                loop j < n && (src[j] == 32 || src[j] == 9)
                    j = j + 1
                if j < n && src[j] == 40
                    return true
            i = i + 1
    return false

// Does this program reach the network? A verb it defines itself doesn't
// count: its own `get` wins (SPEC 12), and it used to carry the whole library
// anyway, unused.
uses_net(src)
    vs = text(5)
    vs[0] = "get"
    vs[1] = "post"
    vs[2] = "put"
    vs[3] = "delete"
    vs[4] = "head"
    own = 0
    i = 0
    loop i < 5
        if calls_verb(src, vs[i])
            if kind(own) == "number"
                own = own_verbs(src)
            if !has(own, vs[i])
                return true
        i = i + 1
    return false

// The net verbs a program defines itself, read from its tokens: a name at
// column 1, its parameter list, and an indented block under it (SPEC 4.2).
// Tokens instead of text, so a comment, a string or a line inside brackets is
// never taken for a definition. A source that doesn't lex defines nothing
// here, and its build stops at the lexer anyway.
own_verbs(src)
    r = {}
    lx = lex_of(src)
    if lx[13] != 0
        return r
    toks = lx[10]
    n = lx[11]
    i = 0
    loop i < n
        t = toks[i]
        if t[0] == 4 && t[3] == 1 && is_net_func(t[1]) == 1
            j = i + 1
            if j < n && toks[j][0] == 35
                loop j < n && toks[j][0] != 36
                    j = j + 1
                if j + 2 < n && toks[j + 1][0] == 1 && toks[j + 2][0] == 2
                    r[t[1]] = 1
        i = i + 1
    return r

// The library's modules, in the order they're joined. The order doesn't
// affect resolution, since word analyzes the whole program, but a fixed order
// keeps a diagnostic's line number the same from build to build.
netlib_modules()
    m = text(19)
    m[0] = "sha256"
    m[1] = "sha512"
    m[2] = "hmac"
    m[3] = "bignum"
    m[4] = "rsa"
    m[5] = "ecdsa"
    m[6] = "der"
    m[7] = "x509"
    m[8] = "pem"
    m[9] = "chacha20"
    m[10] = "poly1305"
    m[11] = "aes"
    m[12] = "gcm"
    m[13] = "x25519"
    m[14] = "tls"
    m[15] = "dns"
    m[16] = "http"
    m[17] = "ecdh"
    m[18] = "net"
    return m

// Read src_path, and for an app.w every sibling .w file, into one source,
// entry first, then bundle the net library if the program uses it
// (with_netlib). Returns [source, line_map, first bundled line], where
// line_map is a list of [start_line, path] pairs and the third is 0 when
// nothing is bundled. Returns 0 when src_path can't be read, and 1 after
// reporting any other failure. An entry with no siblings and no net comes back
// unchanged, so a single-file build is byte for byte what it would be without
// the folder model. netlib_embed only changes a source that carries the NETLIB
// region, which is this file.
multifile_src(src_path)
    entry = read(src_path)
    if kind(entry) == "none"
        return 0
    // Compiling the compiler? Then the net library travels in as data.
    entry = netlib_embed(entry)
    if kind(entry) == "number"
        return 1
    map = mklist(8)
    p0 = text(2)
    p0[0] = 1
    p0[1] = src_path
    map = ladd_grow(map, p0)
    // [source, line map, first bundled line]. The third is 0 until a program
    // pulls in a bundled library; see compile_src's an[22].
    r = text(3)
    r[2] = 0
    // The folder is the program only for the entry file `app.w` (SPEC 11): its
    // directory's other .w files are compiled in. Any other file builds by
    // itself, so `word build one.w` in a directory of unrelated .w files (a
    // test harness, a scratch folder) pulls in nothing it didn't name.
    if path_base(src_path) != "app.w"
        r[0] = entry
        r[1] = map
        return with_netlib(r)
    listing = dir(path_dir(src_path))
    if kind(listing) == "none"
        r[0] = entry
        r[1] = map
        return with_netlib(r)
    sibs = w_siblings(listing, path_base(src_path))
    if len(sibs) == 0
        r[0] = entry
        r[1] = map
        return with_netlib(r)
    folder = path_dir(src_path)
    combined = ensure_nl(entry)
    total = count_nl(combined)
    i = 0
    loop i < len(sibs)
        // A sibling is named the way the entry was: `helper.w` beside a bare
        // `app.w`, and `f2/helper.w` beside `f2/app.w`. Joining "." gave
        // `./helper.w` next to `app.w` in the same build.
        fpath = name_text(sibs[i])
        if path_base(src_path) != src_path
            fpath = folder . "/" . fpath
        // The directory is flat (SPEC 11), so a subdirectory whose name ends
        // in .w isn't a source file. (Reading one failed on Windows, where the
        // build then blamed app.w, and read as an empty file on Linux.)
        sp = sibling_path(folder, sibs[i])
        if kind(dir(sp)) == "none"
            s = read(sp)
            if kind(s) == "none"
                err("cannot read " . fpath)
                return 1
            s = ensure_nl(s)
            pp = text(2)
            pp[0] = total + 1
            pp[1] = fpath
            map = ladd_grow(map, pp)
            combined = combined . s
            total = total + count_nl(s)
        i = i + 1
    r[0] = combined
    r[1] = map
    return with_netlib(r)

// A region of bytes as lowercase hex text, sized once and filled by index.
// This runs over the whole library, and `s = s . c` per character would be
// quadratic under a code generator that doesn't turn it into an append. The
// bootstrap seed's doesn't, and the seed's output is the first to run this.
netlib_hex(b)
    n = len(b)
    d = "0123456789abcdef"
    s = text(n * 2)
    i = 0
    loop i < n
        v = b[i]
        s[i * 2] = d[(v >> 4) & 15]
        s[i * 2 + 1] = d[v & 15]
        i = i + 1
    return s

// Where `needle` is in `hay`, or -1. It's written out instead of using
// find(), because the bootstrap seed doesn't implement that builtin and this
// file has to compile under it.
netlib_at(hay, needle)
    n = len(needle)
    if n == 0
        return 0 - 1
    i = 0
    loop i + n <= len(hay)
        j = 0
        loop j < n
            if hay[i + j] != needle[j]
                j = n + 1
            else
                j = j + 1
        if j == n
            return i
        i = i + 1
    return 0 - 1

// netlib_region_module(region, mod) -> the source text of `mod` from the
// NETLIB region, up to the next marker, or 0 when its marker isn't there. The
// marker literal is built by joining two pieces, so this code never contains
// the marker the region carries (the search only runs over `region` anyway).
netlib_region_module(region, mod)
    mk = "// >>> NET" . "LIB MODULE " . mod . " >>>"
    a = netlib_at(region, mk)
    if a < 0
        return 0
    st = a
    loop st < len(region) && region[st] != 10
        st = st + 1
    if st < len(region)
        st = st + 1
    rest = copy(region, st, len(region))
    nxt = netlib_at(rest, "// >>> NET" . "LIB")
    if nxt < 0
        return rest
    return copy(rest, 0, nxt)

// The net library is carried as text in the NETLIB region near the end of this
// file. Whenever word compiles this file (bootstrap, verify, version or a
// plain build, including by the first stage the Python seed builds), each
// module's source is lifted out of the region and written into netlib_src as
// a byte blob netlib_hex encodes, and the region is removed from the source,
// so its functions are never compiled as the compiler's own code. A source
// with no region (every program but this one) comes back untouched. No file
// on disk is read: the region is the one copy of the library.
//
// The BEGIN and END marker literals are split with `.`, so the whole marker
// exists only in the region and not in this scanner, the same as the stub
// marker. netlib_at would otherwise find this function first.
netlib_embed(src)
    rb = netlib_at(src, "// >>> NET" . "LIB BEGIN")
    if rb < 0
        return src
    re = netlib_at(src, "// <<< NET" . "LIB END <<<")
    if re < 0
        err("netlib: BEGIN marker without END")
        return 0
    reend = re
    loop reend < len(src) && src[reend] != 10
        reend = reend + 1
    if reend < len(src)
        reend = reend + 1
    region = copy(src, rb, re)
    stubmark = "    // WORD_NETLIB" . "_BLOBS"
    stub = netlib_at(src, stubmark)
    if stub < 0
        err("netlib: no blob stub to fill")
        return 0
    mods = netlib_modules()
    body = ""
    i = 0
    loop i < len(mods)
        mt = netlib_region_module(region, mods[i])
        if kind(mt) == "number"
            err("netlib: module missing from the region: " . mods[i])
            return 0
        body = body . "    if mod == \"" . mods[i] . "\"\n        return bytes(\"" . netlib_hex(mt) . "\")\n"
        i = i + 1
    without = copy(src, 0, rb) . copy(src, reend, len(src))
    stub2 = stub - (reend - rb)
    return copy(without, 0, stub2) . body . copy(without, stub2, len(without))

// Append the net library to a program that reaches the network, recording
// each module in the line map so a diagnostic inside one gives the module and
// its own line. r[2] becomes the first bundled line, which is where the
// unused-function check stops applying.
with_netlib(r)
    if !uses_net(r[0])
        return r
    mods = netlib_modules()
    combined = ensure_nl(r[0])
    total = count_nl(combined)
    map = r[1]
    r[2] = total + 1
    i = 0
    loop i < len(mods)
        // The line-map name gives a diagnostic in a bundled module a located
        // `<module>.w:line:col` (SPEC 10.1). The source is carried in the
        // binary (netlib_src), lifted from this file's NETLIB region when the
        // compiler was built.
        fpath = mods[i] . ".w"
        srctext = netlib_src(mods[i])
        if kind(srctext) == "number"
            err("net: the built-in " . mods[i] . " module is missing from this binary")
            return 1
        srctext = ensure_nl(srctext)
        pp = text(2)
        pp[0] = total + 1
        pp[1] = fpath
        map = ladd_grow(map, pp)
        combined = combined . srctext
        total = total + count_nl(srctext)
        i = i + 1
    r[0] = combined
    r[1] = map
    return r

// "file:line" for a line of the joined source, through the line map (0 for a
// single file, which gives the entry name and the line as they are).
srcloc(map, name, line)
    if map == 0
        return name . ":" . line
    best = 0
    i = 0
    loop i < lcount(map)
        e = lget(map, i)
        if e[0] <= line
            best = e
        i = i + 1
    if best == 0
        return name . ":" . line
    return best[1] . ":" . (line - best[0] + 1)

// The same map for a fault at run time (rt_failhdr): the program's own files
// as [first line, file name] pairs in line order, or 0 when there's only one,
// which leaves a single-file program's fault path as it was. The bundled net
// library is left out, because its statements store no line (SPEC 10.2), so a
// fault's line is never one of its. Names only, never the directory, as for
// the entry file (cg[22]).
fault_files(map, bundle_ln)
    if map == 0
        return 0
    files = mklist(8)
    i = 0
    loop i < lcount(map)
        e = lget(map, i)
        if bundle_ln == 0 || e[0] < bundle_ln
            f = text(2)
            f[0] = e[0]
            f[1] = utf8_units(path_base(e[1]))
            files = ladd_grow(files, f)
        i = i + 1
    if lcount(files) < 2
        return 0
    return files

// over_source(out_path, mf) -> 1 after reporting that writing out_path would
// replace a file of the program multifile_src read into mf, else 0. The
// output never replaces a source. A source with no extension to drop (noext,
// .hidden) gets its own name as the default output, and -o can name a source
// too, and either way the build used to succeed and leave an executable where
// the source was. The bundled library's entries in the line map (from mf[2]
// on) aren't files.
over_source(out_path, mf)
    srcs = mklist(8)
    i = 0
    loop i < lcount(mf[1])
        e = lget(mf[1], i)
        if mf[2] == 0 || e[0] < mf[2]
            srcs = ladd_grow(srcs, e[1])
        i = i + 1
    over = writes_over(out_path, srcs)
    if kind(over) == "number"
        return 0
    err("the output " . out_path . " would overwrite the source " . over . "; pass -o <another name>")
    return 1

// Build src_path into an executable at out_path. Returns 0 on success and 1
// on an error. `hint` is added to the message when out_path can't be written.
do_build(src_path, out_path, target, hint)
    mf = multifile_src(src_path)
    if kind(mf) == "number"
        // 0 is "couldn't read src_path", and 1 a failure already reported.
        if mf == 0
            err("cannot read " . src_path)
        return 1
    if over_source(out_path, mf) == 1
        return 1
    r = compile_src(mf[0], target, src_path, mf[1], mf[2])
    if kind(r) == "number"
        return 1
    img = assemble_link(asm_srcs(r[0]), r[1], target, default_out(src_path, 0))
    if kind(img) == "number"
        return 1
    ok = writex(out_path, img)
    if ok == 0
        err("cannot write " . out_path . hint)
        return 1
    return 0

// word build -asm: compile src and write the assembly to stdout, or to
// out_path when it isn't empty (-o), without assembling or linking. It's the
// `.s` a real build hands the assembler: the program, the runtime, and for a
// net program the bundled library too, since that's word source and compiles
// with the rest. So `word asm` turns the dump back into the same binary. The
// target flags work here as they do for a build, so the dump is whichever
// target's assembly that build would assemble. Returns 0 on success and 1 on
// an error (compile_src has already printed a located diagnostic).
dump_asm(src_path, target, out_path)
    mf = multifile_src(src_path)
    if kind(mf) == "number"
        if mf == 0
            err("cannot read " . src_path)
        return 1
    if len(out_path) > 0 && over_source(out_path, mf) == 1
        return 1
    r = compile_src(mf[0], target, src_path, mf[1], mf[2])
    if kind(r) == "number"
        return 1
    if len(out_path) == 0
        out(r[0])
        return 0
    if !write(out_path, r[0])
        err("cannot write " . out_path)
        return 1
    return 0

// ---- word format: one canonical indentation, no options ----
// Re-indent every line to four spaces per nesting level and strip trailing
// whitespace, keeping the line count and every other byte. Structure is read
// the way the lexer reads it (leading-space counts against an indent stack,
// with blank and comment-only lines carrying no indentation), so the output
// has the same block structure as the input, in the one layout. That's what
// makes an accidentally mis-indented line visible (SPEC 2.2). `src` is raw
// bytes (read()), and what comes out holds bytes too (see fmt_bytes), so
// non-ASCII text comes through unchanged.
//
// `lx` is the input's lexer state (lex_of), already known to lex. Its tokens
// say which lines start inside an unmatched bracket. Those continuation lines
// carry no indentation for the lexer, so they don't here either: each one
// moves by as much as the line that opened the bracket did, which keeps its
// alignment. Returns the formatted text, or 0 after reporting a line indented
// with a tab (SPEC 2.2) at `path`:line:col.
fmt_source(src, lx, path)
    n = len(src)
    cont = fmt_cont(src, lx[10], lx[11])
    out = ""
    stack = text(64)
    stack[0] = 0
    sp = 1
    // Comment-only and blank lines carry no structure. They're buffered and
    // written at the next code line's depth, so a comment lines up with the
    // code it precedes, even across a dedent. kind 1 is blank, 2 a comment. The
    // stack and these buffers grow as they fill, since the compiler takes any
    // depth and any number of blank lines.
    pk = text(64)
    pl = text(64)
    pe = text(64)
    pc = 0
    // How far the last code line moved: its new indentation less its old one.
    delta = 0
    line = 1
    i = 0
    loop i < n
        ls = i
        loop i < n
            if src[i] == 10
                break
            i = i + 1
        lead = ls
        loop lead < i
            if src[lead] != 32
                break
            lead = lead + 1
        te = i
        loop te > lead
            c = src[te - 1]
            if c != 32 && c != 13 && c != 9
                break
            te = te - 1
        // Blank or comment-only is decided past tabs and CRs too, the way
        // lline_start decides it.
        cs = lead
        loop cs < te
            c = src[cs]
            if c != 32 && c != 13 && c != 9
                break
            cs = cs + 1
        kind = 0
        if cs >= te
            kind = 1
        else if te - cs >= 2 && src[cs] == 47 && src[cs + 1] == 47
            kind = 2
        if cont[line] == 1
            if kind != 1
                k = 0
                loop k < (lead - ls) + delta
                    out = out . " "
                    k = k + 1
                out = out . copy(src, lead, te)
            out = out . "\n"
        else if kind != 0
            pk = fmt_grow(pk, pc)
            pl = fmt_grow(pl, pc)
            pe = fmt_grow(pe, pc)
            pk[pc] = kind
            pl[pc] = cs
            pe[pc] = te
            pc = pc + 1
        else
            if src[lead] == 9
                err(path . ":" . line . ":" . (lead - ls + 1) . ": indent with spaces, not tabs")
                return 0
            leadw = lead - ls
            top = stack[sp - 1]
            if leadw > top
                stack = fmt_grow(stack, sp)
                stack[sp] = leadw
                sp = sp + 1
            else if leadw < top
                loop sp > 1
                    if leadw >= stack[sp - 1]
                        break
                    sp = sp - 1
            d = sp - 1
            delta = d * 4 - leadw
            j = 0
            loop j < pc
                if pk[j] == 2
                    ki = 0
                    loop ki < d * 4
                        out = out . " "
                        ki = ki + 1
                    out = out . copy(src, pl[j], pe[j])
                out = out . "\n"
                j = j + 1
            pc = 0
            k = 0
            loop k < d * 4
                out = out . " "
                k = k + 1
            out = out . copy(src, lead, te)
            out = out . "\n"
        if i < n
            i = i + 1
        line = line + 1
    // blank and comment lines at the end of the file stay at the outer level
    j2 = 0
    loop j2 < pc
        if pk[j2] == 2
            out = out . copy(src, pl[j2], pe[j2])
        out = out . "\n"
        j2 = j2 + 1
    return out

// fmt_cont: cont[L] is 1 when line L (from 1) starts inside an unmatched (, [
// or {, read off the input's own tokens so the formatter agrees with the
// lexer about it. A token's line is t[2], and a string can't span lines.
fmt_cont(src, toks, ntok)
    nl = 1
    i = 0
    loop i < len(src)
        if src[i] == 10
            nl = nl + 1
        i = i + 1
    cont = text(nl + 2)
    dep = 0
    ln = 1
    i = 0
    loop i < ntok
        t = toks[i]
        loop ln <= t[2]
            if dep > 0
                cont[ln] = 1
            ln = ln + 1
        c = t[0]
        if c == 35 || c == 37 || c == 42
            dep = dep + 1
        else if c == 36 || c == 38 || c == 43
            // opemit keeps the lexer's depth from going below zero, and so does this.
            if dep > 0
                dep = dep - 1
        i = i + 1
    return cont

// fmt_bytes: what fmt_source built, as the bytes it holds. fmt_source joins
// pieces of the byte-backed source onto text, and a join promotes them one
// element per byte, so the result holds the file's bytes as numbers 0..255.
// write() writes text as UTF-8, which would encode every byte above 127 a
// second time, and writes a byte-backed region as it is.
fmt_bytes(s)
    b = bytes(len(s))
    i = 0
    loop i < len(s)
        b[i] = s[i]
        i = i + 1
    return b

// fmt_grow: `a`, or a copy twice its size when index `n` is past its end.
fmt_grow(a, n)
    if n < len(a)
        return a
    b = text(len(a) * 2)
    i = 0
    loop i < n
        b[i] = a[i]
        i = i + 1
    return b

// lex_of: tokenize a source region and return the lexer state. st[10] holds
// the tokens and st[11] how many. st[13] != 0 means it didn't lex, and st[14],
// st[15] and st[16] are then the line, column and message. It sets the lexer
// up the way compile_src does, for word format and own_verbs.
lex_of(src)
    st = text(21)
    indents = text(256)
    st[0] = 0
    st[1] = 1
    st[2] = 1
    st[3] = 0
    indents[0] = 0
    st[4] = 1
    st[5] = 1
    st[6] = 0
    st[7] = src
    st[8] = indents
    st[9] = text(65536)
    st[10] = text(200000)
    st[11] = 0
    st[12] = 0
    st[13] = 0
    tokenize(st)
    return st

// same_tokens: 1 when `b` lexes to the same token stream the input did (`la`,
// its lex_of state): kind and value, in order, positions ignored. This is the
// formatter's safety check. It only changes whitespace, so a correct format
// leaves the token stream as it was (indentation shows up only as INDENT and
// DEDENT tokens, which keeping the structure keeps). If they ever differ, the
// formatter refuses to write and the source is untouched.
same_tokens(la, b)
    lb = lex_of(b)
    if lb[13] != 0
        return 0
    if la[11] != lb[11]
        return 0
    ta = la[10]
    tb = lb[10]
    i = 0
    loop i < la[11]
        x = ta[i]
        y = tb[i]
        if x[0] != y[0]
            return 0
        if x[1] != y[1]
            return 0
        i = i + 1
    return 1

// cli_usage(cmd, why, use) -> 1, after reporting a usage error: what was
// wrong, when there's something to say, then the usage line.
cli_usage(cmd, why, use)
    if len(why) > 0
        err("word " . cmd . ": " . why)
    err(use)
    return 1

// parse_build_args(cmd, use, takes_src) -> [target, asm, source, out] from
// args(), or 1 after a usage error has been reported. Target flags, -o <out>
// and, for build, -asm and the one source can come in any order. Two
// different target flags, -o twice or with no name after it, an unknown flag,
// and a word that isn't wanted (a second source, or any file for bootstrap)
// are errors, never skipped. An empty argument names nothing and is passed
// over, so a -o after it still counts (it used to end the walk). An empty
// `out` means none was given.
parse_build_args(cmd, use, takes_src)
    r = text(4)
    r[0] = host_target()
    r[1] = 0
    r[2] = ""
    r[3] = ""
    tflag = ""
    got_out = false
    got_src = false
    n = len(args())
    ai = 2
    loop ai < n
        f = arg(ai)
        if len(f) > 0
            t = target_flag(f)
            if t >= 0
                if len(tflag) > 0 && tflag != f
                    return cli_usage(cmd, tflag . " and " . f . " name two targets", use)
                tflag = f
                r[0] = t
            else if f == "-asm" && takes_src
                r[1] = 1
            else if f == "-o"
                if got_out
                    return cli_usage(cmd, "-o given twice", use)
                if ai + 1 >= n || len(arg(ai + 1)) == 0
                    return cli_usage(cmd, "-o needs a file name", use)
                ai = ai + 1
                r[3] = arg(ai)
                got_out = true
            else if is_flag(f)
                return cli_usage(cmd, "unknown flag " . f, use)
            else if !takes_src
                return cli_usage(cmd, "it builds compiler/word.w and takes no file, but got " . f, use)
            else if got_src
                return cli_usage(cmd, "one source at a time, but got " . r[2] . " and " . f, use)
            else
                r[2] = f
                got_src = true
        ai = ai + 1
    if takes_src && !got_src
        return cli_usage(cmd, "", use)
    return r

// ---- CLI: word <build|run|asm|format|verify|bootstrap|version> ... ----
// verify and bootstrap read compiler/word.w from the current directory, and
// version compares against it when it's there, so they run from the root of a
// checkout. The net library is carried in the binary, so a net build reads
// nothing extra.
cmd = arg(1)

if len(cmd) == 0
    err("usage: word <build|run|asm|format|verify|bootstrap|version> ...")
    return 1

if cmd == "build"
    // word build [-win|-linux|-arm64|-mac] [-asm] <app.w> [-o out], the flags in
    // any order and on either side of the source. The target defaults to the
    // host (a Windows word.exe builds PEs, a Linux word ELFs), and the flags
    // cross-compile. -asm writes the assembly instead of an executable, to
    // stdout or to the -o file, and `word asm` turns it back into a binary.
    // Without -o the output is named after the source, with .exe added for the
    // Windows target. Anything parse_build_args refuses is a usage error. (A
    // target flag after the file name used to be dropped and the host built
    // instead, and an unknown flag was read as the source.)
    o = parse_build_args("build", "usage: word build [-win|-linux|-arm64|-mac] [-asm] <app.w> [-o out]", true)
    if kind(o) == "number"
        return 1
    if o[1] == 1
        return dump_asm(o[2], o[0], o[3])
    out_path = o[3]
    if len(out_path) == 0
        out_path = default_out(o[2], o[0])
    return do_build(o[2], out_path, o[0], "")

if cmd == "asm"
    // `word asm [-win|-linux|-arm64|-mac] <in.s> [more.s...] <out>`, with the
    // one flag, if any, first. With no flag it targets the host, as build and
    // run do, so `word build -asm app.w > app.s` then `word asm app.s out` gives
    // the binary `word build` does on every host (SPEC 14). -win writes a
    // Windows PE (link_pe) and -linux a Linux x86-64 ELF (link), with the same
    // x86-64 assembler. -arm64 keeps the ELF and switches the assembler to
    // AArch64, and -mac writes that as a Mach-O.
    tgt = host_target()
    argstart = 2
    if arg(2) == "-win"
        tgt = 1
        argstart = 3
    else if arg(2) == "-linux"
        tgt = 0
        argstart = 3
    else if arg(2) == "-arm64"
        tgt = 2
        argstart = 3
    else if arg(2) == "-mac"
        tgt = 3
        argstart = 3
    // Every argument after the flag is a file, however many there are.
    av = args()
    inputs = mklist(len(av))
    i = argstart
    loop i < len(av)
        ladd(inputs, av[i])
        i = i + 1
    n = lcount(inputs)
    if n < 2
        err("usage: word asm [-win|-linux|-arm64|-mac] <in.s> [more.s...] <out>")
        return 1
    srcs = text(n - 1)
    fi = 0
    loop fi < n - 1
        asrc = read(lget(inputs, fi))
        if kind(asrc) == "none"
            err("word asm: cannot read " . lget(inputs, fi))
            return 1
        srcs[fi] = asrc
        fi = fi + 1
    // The last name is the output, and it never replaces one of the inputs.
    ins = mklist(n)
    fi = 0
    loop fi < n - 1
        ladd(ins, lget(inputs, fi))
        fi = fi + 1
    over = writes_over(lget(inputs, n - 1), ins)
    if kind(over) != "number"
        err("word asm: the output " . lget(inputs, n - 1) . " would overwrite the input " . over)
        return 1
    // The same assemble-and-link a build does, relaxation included. The PE's
    // version block names the program after its source, as a build does:
    // app.s gives "app", the name `word build app.w` uses.
    img = assemble_link(srcs, 0, tgt, default_out(lget(inputs, 0), 0))
    if kind(img) == "number"
        return 1
    ok = writex(lget(inputs, n - 1), img)
    if ok == 0
        err("word asm: cannot write output")
        return 1
    return 0

if cmd == "run"
    // word run [-win|-linux|-arm64|-mac] <app.w> [args...]: build for this host
    // and run it. The flags come before the source, since everything after it
    // is the program's. A foreign binary can't run here, so a target flag is
    // only accepted when it names this host (anything else is for
    // `word build`). -linux is x86-64, as it is for build, so an arm64 host
    // refuses it and takes -arm64. On Windows the temporary binary is started
    // with CreateProcessA, and on Linux and macOS execve replaces this process.
    use = "usage: word run [-win|-linux|-arm64|-mac] <app.w> [args...]"
    tgt = host_target()
    ai = 2
    loop is_flag(arg(ai))
        t = target_flag(arg(ai))
        if t < 0
            return cli_usage("run", "unknown flag " . arg(ai), use)
        if t != tgt
            err("word run: " . arg(ai) . " builds for " . target_name(t) . ", and this host is " . target_name(tgt) . "; cross-compile with `word build " . arg(ai) . "`")
            return 1
        ai = ai + 1
    src = arg(ai)
    if len(src) == 0
        err(use)
        return 1
    tmp = run_tmp()
    if tgt == 1
        tmp = run_tmp_win()
    rc = do_build(src, tmp, tgt, "")
    if rc != 0
        return rc
    // Everything after the source is the program's, passed through as it came:
    // any number of arguments, and an empty one is still one.
    av = args()
    xargs = mklist(len(av))
    i = ai + 1
    loop i < len(av)
        ladd(xargs, av[i])
        i = i + 1
    exec(tmp, xargs)
    err("exec failed: " . src)
    return 1

if cmd == "verify"
    src = read("compiler/word.w")
    if kind(src) == "none"
        err("word verify: cannot read compiler/word.w")
        return 1
    // The same text bootstrap compiles, with the NETLIB region lifted into
    // netlib_src. Without it the rebuild would be a different program from the
    // committed binary and couldn't match it.
    src = netlib_embed(src)
    if kind(src) == "number"
        return 1
    r = compile_src(src, 0, "compiler/word.w", 0, 0)
    if kind(r) == "number"
        err("word verify: compile failed")
        return 1
    rebuilt = assemble_link(asm_srcs(r[0]), r[1], 0, "word")
    self = read("word")
    if kind(self) == "none"
        err("word verify: cannot read the committed ./word")
        return 1
    if regions_equal(rebuilt, self)
        out("word verify: OK - rebuilt word is byte-identical to the committed binary")
        return 0
    err("word verify: FAIL - rebuilding compiler/word.w with this binary does not")
    err("  reproduce the committed ./word. Either the source changed without ./word")
    err("  being rebuilt, or the binary running this command is stale.")
    err("  `word version` says which, and how to fix it.")
    return 1

if cmd == "version"
    return do_version()

if cmd == "bootstrap"
    // word bootstrap [-win|-linux|-arm64|-mac] [-o out], in any order: build
    // compiler/word.w. It defaults to the host target, as build and run do,
    // since rebuilding your own toolchain should give you a binary your
    // machine can run. Anything else is a usage error. (An unknown flag used to
    // be skipped along with the -o after it, and the host binary written to
    // ./word.)
    o = parse_build_args("bootstrap", "usage: word bootstrap [-win|-linux|-arm64|-mac] [-o out]", false)
    if kind(o) == "number"
        return 1
    out_path = o[3]
    hint = ""
    if len(out_path) == 0
        out_path = "word"
        if o[0] == 1
            out_path = "word.exe"
        // Without -o the output is where the running binary usually is, and
        // neither Linux nor Windows lets a running binary be written over, so a
        // failed write there says what to do instead.
        hint = " (if that is the binary running this, it cannot be replaced while it runs: build with -o <other path>, then move that into place)"
    return do_build("compiler/word.w", out_path, o[0], hint)

if cmd == "format"
    // word format <app.w>: rewrite the file in the one indentation layout. No
    // options, and one file at a time. It refuses, leaving the file as it was,
    // if the result wouldn't lex to the same tokens as the input.
    //
    // An input that doesn't lex, or that indents with a tab, gets the located
    // error the compiler would give it and is left as it was. "internal error"
    // is only for the formatter failing its own check.
    src_path = arg(2)
    if len(src_path) == 0
        err("usage: word format <app.w>")
        return 1
    src = read(src_path)
    if kind(src) == "none"
        err("word format: cannot read " . src_path)
        return 1
    lx = lex_of(src)
    if lx[13] != 0
        err(src_path . ":" . lx[14] . ":" . lx[15] . ": " . lx[16])
        return 1
    formatted = fmt_source(src, lx, src_path)
    if kind(formatted) == "number"
        return 1
    if same_tokens(lx, formatted) == 0
        err("word format: internal error, " . src_path . " left unchanged")
        return 1
    if !write(src_path, fmt_bytes(formatted))
        err("word format: cannot write " . src_path)
        return 1
    return 0

err("unknown command '" . cmd . "'")
err("usage: word <build|run|asm|format|verify|bootstrap|version> ...")
return 1

// netlib_src(mod) -> the bundled library's source for `mod`, as bytes.
//
// Its body, after the NETLIB region, is a stub the build fills in. `net` is
// word source that gets compiled into the calling program, so the compiler
// needs that source at build time. The one copy is the NETLIB region below.
// Whenever word compiles this file (bootstrap, verify, version or a plain
// build, including by the first stage the Python seed builds), netlib_embed()
// lifts each module out of the region and writes it into the stub as a byte
// blob.
//
// So there's no generated file to keep in step, no second copy to drift, and
// nothing on disk to find. The bytes come from this file every time, which is
// what lets `word verify` check them too.
// >>> NETLIB BEGIN -- the net library, carried as text (netlib_embed) >>>
// The text between these markers is the net library, and the compiler never
// compiles it as its own code. netlib_embed lifts each module out into the
// compiler binary and removes the region, and with_netlib appends the modules
// to any program that calls a net verb. This is the only copy, so edit the
// functions here. It was runtime/crypto/*.w before it moved in.
// >>> NETLIB MODULE sha256 >>>
// sha256.w: SHA-256 (FIPS 180-4), in word.
//
// The crypto library is written in word instead of per-target assembly, so
// there's one implementation for every target. Hand-written x86-64 would be
// faster and could use SHA-NI, but it would only run on x86-64, and the TLS
// stack would have to be written again for the next instruction set.
//
// Hashing 64 MiB takes about 0.6 s on x86-64 Linux. The handshake only hashes
// its transcript and runs HKDF, which takes microseconds either way.
//
// SHA-256 is a 32-bit algorithm and word's integers are 63-bit, so every
// operation that can carry past bit 31 is masked back down with one `and`.
//
// A function sees only its parameters and its own locals (SPEC 8.1), so the
// mask and the round constants are locals.

// The 64 round constants (FIPS 180-4 section 4.2.2), unpacked into a region
// once per hash.
sha256_k()
    // 256 bytes of .rodata. One assignment per constant would be about a
    // thousand instructions.
    b = bytes("")
    k = text(64)
    i = 0
    loop i < 64
        j = i * 4
        k[i] = (b[j] << 24) | (b[j + 1] << 16) | (b[j + 2] << 8) | b[j + 3]
        i = i + 1
    return k

// The message schedule and compression for the 64-byte block at `off`. The
// caller passes the schedule `w` in so it's allocated once per message: a
// 1 MiB message is 16384 blocks, and a fresh 64-cell region for each one is
// 8 MB of arena, which was more than half the running time.
sha256_block(h, m, off, k, w)
    M32 = 4294967295
    i = 0
    loop i < 16
        j = off + i * 4
        w[i] = ((m[j] << 24) | (m[j + 1] << 16) | (m[j + 2] << 8) | m[j + 3]) & M32
        i = i + 1
    i = 16
    loop i < 64
        // FIPS 180-4's four sigma functions (section 4.1.2) are written out
        // here and in the rounds. Each reads its argument five or six times,
        // and the compiler only inlines a one-line function that reads each
        // parameter once. No left shift here is more than 30 bits, so a 32-bit
        // value stays inside a word integer, and xor is bitwise, so one mask at
        // the end stands in for masking each term.
        //
        // A schedule word is already 32 bits, so masking x and y as they're
        // read changes nothing. It lets the compiler prove they fit, though,
        // and a rotation is one `rol` only when its operand is proved to fit
        // (the rotate idiom). Hashing takes about 15% longer without them.
        x = w[i - 15] & M32
        y = w[i - 2] & M32
        s0 = (((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3)) & M32
        s1 = (((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10)) & M32
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & M32
        i = i + 1
    // Masked on the way in for the same reason, which keeps all eight working
    // variables raw 32-bit locals for the whole block.
    a = h[0] & M32
    b = h[1] & M32
    c = h[2] & M32
    d = h[3] & M32
    e = h[4] & M32
    f = h[5] & M32
    g = h[6] & M32
    hh = h[7] & M32
    i = 0
    loop i < 64
        S1 = (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & M32
        ch = ((e & f) ^ ((~e) & g)) & M32
        // The two table words are masked for the same reason as x and y: a
        // sum is added in 32-bit registers only when every term is proved to
        // fit, since otherwise the add has to watch for an overflow.
        t1 = (hh + S1 + ch + (k[i] & M32) + (w[i] & M32)) & M32
        S0 = (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & M32
        mj = ((a & b) ^ (a & c) ^ (b & c)) & M32
        t2 = (S0 + mj) & M32
        hh = g
        g = f
        f = e
        e = (d + t1) & M32
        d = c
        c = b
        b = a
        a = (t1 + t2) & M32
        i = i + 1
    h[0] = (h[0] + a) & M32
    h[1] = (h[1] + b) & M32
    h[2] = (h[2] + c) & M32
    h[3] = (h[3] + d) & M32
    h[4] = (h[4] + e) & M32
    h[5] = (h[5] + f) & M32
    h[6] = (h[6] + g) & M32
    h[7] = (h[7] + hh) & M32
    return 0

// sha256(msg) -> the 32-byte digest of msg, a region of bytes.
//
// The whole blocks are read straight out of `msg`. Only the tail (the last
// partial block, the padding and the length) is copied, into a 128-byte
// buffer, so a hash never makes a second copy of the message.
sha256(msg)
    dg = bytes(32)
    // The state, the round constants, the schedule and the padded tail are
    // scratch, so the digest is allocated first and the arena is rewound over
    // the rest at the end (SPEC 12.5).
    mk = mark()
    n = len(msg)
    h = text(8)
    h[0] = 1779033703
    h[1] = 3144134277
    h[2] = 1013904242
    h[3] = 2773480762
    h[4] = 1359893119
    h[5] = 2600822924
    h[6] = 528734635
    h[7] = 1541459225
    k = sha256_k()
    w = text(64)
    full = (n >> 6)
    b = 0
    loop b < full
        sha256_block(h, msg, b * 64, k, w)
        b = b + 1
    rest = n - full * 64
    tail = bytes(128)
    i = 0
    loop i < rest
        tail[i] = msg[full * 64 + i]
        i = i + 1
    tail[rest] = 128
    // One block holds the tail, the 0x80 and the 8-byte length unless the
    // tail is 56 bytes or more.
    tn = 64
    if rest >= 56
        tn = 128
    bits = n * 8
    i = 0
    loop i < 8
        tail[tn - 1 - i] = (bits >> (i * 8)) & 255
        i = i + 1
    sha256_block(h, tail, 0, k, w)
    if tn == 128
        sha256_block(h, tail, 64, k, w)
    i = 0
    loop i < 8
        v = h[i]
        dg[i * 4] = (v >> 24) & 255
        dg[i * 4 + 1] = (v >> 16) & 255
        dg[i * 4 + 2] = (v >> 8) & 255
        dg[i * 4 + 3] = v & 255
        i = i + 1
    reset(mk)
    return dg

// >>> NETLIB MODULE sha512 >>>
// sha512.w: SHA-512 and SHA-384 (FIPS 180-4), in word.
//
// SHA-512 is a 64-bit algorithm, and a word integer holds -2^62 to 2^62 - 1,
// so a 64-bit value doesn't fit. Every value here is a pair of 32-bit cells,
// high half first, and the arithmetic is done in halves.
//
// Addition is one add per half plus a carry: a sum of five 32-bit values is
// under 2^35, so the carry is the bits above 32. Xor and and work per half and
// need no mask. A rotation masks off the bits it's about to move out of a half
// before it shifts them, so every result is already a 32-bit value.
//
// Rotating by n + 32 is rotating by n with the halves swapped, so a rotation
// past 32 is written that way. Four of SHA-512's ten rotations (34, 39, 41 and
// 61) are past 32.
//
// SHA-384 is SHA-512 with a different initial state and the digest cut to 48
// bytes. The block function is the same.
//
// Hashing 64 MiB takes about 1.4 s on x86-64 Linux, a bit over twice SHA-256's
// time. Halves cost less than they look because SHA-512 runs 80 rounds per
// 128-byte block, where SHA-256 runs 64 per 64-byte block.

// The four mixing functions of FIPS 180-4 section 4.1.3, each an xor of three
// rotations (or two rotations and a shift), written out in halves. The amounts
// are fixed, so each function is one call with its shifts written in, instead
// of three calls to a general rotate that branches on the amount. When that
// change was made it took 64 MiB from 6.5 s to 3.8 s.

// Sigma0: ROTR28 ^ ROTR34 ^ ROTR39. The last two are past 32, so each is a
// rotation of the swapped halves.
u64_bsig0(r, h, l)
    a0 = (h >> 28) | ((l & 268435455) << 4)
    b0 = (l >> 2) | ((h & 3) << 30)
    c0 = (l >> 7) | ((h & 127) << 25)
    a1 = (l >> 28) | ((h & 268435455) << 4)
    b1 = (h >> 2) | ((l & 3) << 30)
    c1 = (h >> 7) | ((l & 127) << 25)
    r[0] = a0 ^ b0 ^ c0
    r[1] = a1 ^ b1 ^ c1
    return 0

// Sigma1: ROTR14 ^ ROTR18 ^ ROTR41.
u64_bsig1(r, h, l)
    a0 = (h >> 14) | ((l & 16383) << 18)
    b0 = (h >> 18) | ((l & 262143) << 14)
    c0 = (l >> 9) | ((h & 511) << 23)
    a1 = (l >> 14) | ((h & 16383) << 18)
    b1 = (l >> 18) | ((h & 262143) << 14)
    c1 = (h >> 9) | ((l & 511) << 23)
    r[0] = a0 ^ b0 ^ c0
    r[1] = a1 ^ b1 ^ c1
    return 0

// sigma0: ROTR1 ^ ROTR8 ^ SHR7.
u64_ssig0(r, h, l)
    a0 = (h >> 1) | ((l & 1) << 31)
    b0 = (h >> 8) | ((l & 255) << 24)
    c0 = h >> 7
    a1 = (l >> 1) | ((h & 1) << 31)
    b1 = (l >> 8) | ((h & 255) << 24)
    c1 = (l >> 7) | ((h & 127) << 25)
    r[0] = a0 ^ b0 ^ c0
    r[1] = a1 ^ b1 ^ c1
    return 0

// sigma1: ROTR19 ^ ROTR61 ^ SHR6.
u64_ssig1(r, h, l)
    a0 = (h >> 19) | ((l & 524287) << 13)
    b0 = (l >> 29) | ((h & 536870911) << 3)
    c0 = h >> 6
    a1 = (l >> 19) | ((h & 524287) << 13)
    b1 = (h >> 29) | ((l & 536870911) << 3)
    c1 = (l >> 6) | ((h & 63) << 26)
    r[0] = a0 ^ b0 ^ c0
    r[1] = a1 ^ b1 ^ c1
    return 0

// The eighty round constants: the first 64 bits of the fractional parts of
// the cube roots of the first eighty primes (FIPS 180-4 section 4.2.3), as
// high/low pairs of 32-bit halves.
sha512_k()
    // 640 bytes of .rodata, unpacked into a region once per hash.
    b = bytes("")
    k = text(160)
    i = 0
    loop i < 160
        j = i * 4
        k[i] = (b[j] << 24) | (b[j + 1] << 16) | (b[j + 2] << 8) | b[j + 3]
        i = i + 1
    return k

// The initial states: the first 64 bits of the fractional parts of the square
// roots of the first eight primes for SHA-512 (FIPS 180-4 section 5.3.5), and
// of the ninth through sixteenth for SHA-384 (section 5.3.4).
sha512_iv()
    h = text(16)
    h[0] = 1779033703
    h[1] = 4089235720
    h[2] = 3144134277
    h[3] = 2227873595
    h[4] = 1013904242
    h[5] = 4271175723
    h[6] = 2773480762
    h[7] = 1595750129
    h[8] = 1359893119
    h[9] = 2917565137
    h[10] = 2600822924
    h[11] = 725511199
    h[12] = 528734635
    h[13] = 4215389547
    h[14] = 1541459225
    h[15] = 327033209
    return h

sha384_iv()
    h = text(16)
    h[0] = 3418070365
    h[1] = 3238371032
    h[2] = 1654270250
    h[3] = 914150663
    h[4] = 2438529370
    h[5] = 812702999
    h[6] = 355462360
    h[7] = 4144912697
    h[8] = 1731405415
    h[9] = 4290775857
    h[10] = 2394180231
    h[11] = 1750603025
    h[12] = 3675008525
    h[13] = 1694076839
    h[14] = 1203062813
    h[15] = 3204075428
    return h

// One 128-byte block into the state h (8 words as 16 half-cells). k is the
// round-constant table, w a 160-cell schedule and r a two-cell scratch for the
// rotations. The caller passes all three in, so a long message doesn't
// allocate them for every block.
sha512_block(h, m, off, k, w, r)
    i = 0
    loop i < 16
        j = off + i * 8
        w[i * 2] = (m[j] << 24) | (m[j + 1] << 16) | (m[j + 2] << 8) | m[j + 3]
        w[i * 2 + 1] = (m[j + 4] << 24) | (m[j + 5] << 16) | (m[j + 6] << 8) | m[j + 7]
        i = i + 1
    i = 16
    loop i < 80
        xh = w[(i - 15) * 2]
        xl = w[(i - 15) * 2 + 1]
        u64_ssig0(r, xh, xl)
        s0h = r[0]
        s0l = r[1]
        yh = w[(i - 2) * 2]
        yl = w[(i - 2) * 2 + 1]
        u64_ssig1(r, yh, yl)
        s1h = r[0]
        s1l = r[1]
        lo = w[(i - 16) * 2 + 1] + s0l + w[(i - 7) * 2 + 1] + s1l
        hi = w[(i - 16) * 2] + s0h + w[(i - 7) * 2] + s1h + (lo >> 32)
        w[i * 2] = hi & 4294967295
        w[i * 2 + 1] = lo & 4294967295
        i = i + 1
    ah = h[0]
    al = h[1]
    bh = h[2]
    bl = h[3]
    ch = h[4]
    cl = h[5]
    dh = h[6]
    dl = h[7]
    eh = h[8]
    el = h[9]
    fh = h[10]
    fl = h[11]
    gh = h[12]
    gl = h[13]
    hh = h[14]
    hl = h[15]
    i = 0
    loop i < 80
        u64_bsig1(r, eh, el)
        s1h = r[0]
        s1l = r[1]
        xh = (eh & fh) ^ ((eh ^ 4294967295) & gh)
        xl = (el & fl) ^ ((el ^ 4294967295) & gl)
        lo = hl + s1l + xl + k[i * 2 + 1] + w[i * 2 + 1]
        hi = hh + s1h + xh + k[i * 2] + w[i * 2] + (lo >> 32)
        t1h = hi & 4294967295
        t1l = lo & 4294967295
        u64_bsig0(r, ah, al)
        s0h = r[0]
        s0l = r[1]
        yh = (ah & bh) ^ (ah & ch) ^ (bh & ch)
        yl = (al & bl) ^ (al & cl) ^ (bl & cl)
        lo = s0l + yl
        hi = s0h + yh + (lo >> 32)
        t2h = hi & 4294967295
        t2l = lo & 4294967295
        hh = gh
        hl = gl
        gh = fh
        gl = fl
        fh = eh
        fl = el
        lo = dl + t1l
        hi = dh + t1h + (lo >> 32)
        eh = hi & 4294967295
        el = lo & 4294967295
        dh = ch
        dl = cl
        ch = bh
        cl = bl
        bh = ah
        bl = al
        lo = t1l + t2l
        hi = t1h + t2h + (lo >> 32)
        ah = hi & 4294967295
        al = lo & 4294967295
        i = i + 1
    lo = h[1] + al
    h[0] = (h[0] + ah + (lo >> 32)) & 4294967295
    h[1] = lo & 4294967295
    lo = h[3] + bl
    h[2] = (h[2] + bh + (lo >> 32)) & 4294967295
    h[3] = lo & 4294967295
    lo = h[5] + cl
    h[4] = (h[4] + ch + (lo >> 32)) & 4294967295
    h[5] = lo & 4294967295
    lo = h[7] + dl
    h[6] = (h[6] + dh + (lo >> 32)) & 4294967295
    h[7] = lo & 4294967295
    lo = h[9] + el
    h[8] = (h[8] + eh + (lo >> 32)) & 4294967295
    h[9] = lo & 4294967295
    lo = h[11] + fl
    h[10] = (h[10] + fh + (lo >> 32)) & 4294967295
    h[11] = lo & 4294967295
    lo = h[13] + gl
    h[12] = (h[12] + gh + (lo >> 32)) & 4294967295
    h[13] = lo & 4294967295
    lo = h[15] + hl
    h[14] = (h[14] + hh + (lo >> 32)) & 4294967295
    h[15] = lo & 4294967295
    return 0

// Runs the message through the block function and returns the first `outlen`
// bytes of the state. As in sha256.w, whole blocks are read from msg and only
// the tail is copied. SHA-512 pads to a 128-byte block with a 128-bit length
// field, whose top 64 bits are always zero for a message that fits in memory.
sha512_core(msg, h, outlen)
    dg = bytes(outlen)
    mk = mark()
    n = len(msg)
    k = sha512_k()
    w = text(160)
    r = text(2)
