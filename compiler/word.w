    // rt_jp_word: rdi = how many characters, rsi = the ASCII they must be.
    //
    // This used to step over rdi characters without looking at them, so
    // "nul", "tru", "fals" and "nulq" all parsed as JSON. Nobody could tell
    // while a bogus keyword and a failed parse both answered 0. Giving failure
    // its own value (SPEC 3.8) showed it up.
    asmput("# rt_jp_word: rdi = length of a bare literal, rsi = the ASCII it must be.")
    asmput("# Checks it, and anything else sets the bad latch.")
    asmput("rt_jp_word:")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    mov rbx, [rip+jp_src]")
    asmput("    mov r12, [rip+jp_pos]")
    asmput("    xor r9, r9")
    asmput(".jw_v:")
    asmput("    cmp r9, rdi")
    asmput("    jge .jw_ok")
    asmput("    mov r10, r12")
    asmput("    add r10, r9")
    asmput("    cmp r10, [rbx]")
    asmput("    jge .jw_bad")
    asmput("    mov rax, [rbx + r10*8 + 8]")
    asmput("    sar rax, 1")
    asmput("    movzx r11, byte ptr [rsi + r9]")
    asmput("    cmp rax, r11")
    asmput("    jne .jw_bad")
    asmput("    inc r9")
    asmput("    jmp .jw_v")
    asmput(".jw_bad:")
    asmput("    mov qword ptr [rip+jp_bad], 1")
    asmput(".jw_ok:")
    asmput("    add r12, rdi")
    asmput("    mov [rip+jp_pos], r12")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    asmput("# rt_json_parse: rdi = JSON text -> rax = the value, or none if the text")
    asmput("# is malformed or has anything but whitespace after the value.")
    asmput("rt_json_parse:")
    asmput("    # The document has to be a region. A number or a singleton would be")
    asmput("    # read as a pointer to text.")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    push rbx")
    // JSON text is UTF-8 (RFC 8259 8.1), and a byte-backed document is what
    // read() and get() hand back, so it's decoded the way decode() does it.
    // It used to be promoted one code point per byte, which garbled every
    // non-ASCII string and key in a file.
    asmput("    mov rax, rdi")
    asmput("    test qword ptr [rdi - 16], 1")
    asmput("    jz .jpp_text")
    asmput("    mov rsi, [rdi]")
    asmput("    add rdi, 8")
    asmput("    call rt_utf8_decode")
    asmput(".jpp_text:")
    asmput("    mov [rip+jp_src], rax")
    asmput("    mov qword ptr [rip+jp_pos], 0")
    asmput("    mov qword ptr [rip+jp_bad], 0")
    asmput("    mov qword ptr [rip+jp_depth], 0")
    asmput("    call rt_jp_value")
    asmput("    mov rbx, rax")
    asmput("    call rt_jp_ws")
    asmput("    mov r8, [rip+jp_src]")
    asmput("    mov rcx, [rip+jp_pos]")
    asmput("    cmp rcx, [r8]")
    asmput("    jl .jpp_bad")
    asmput("    cmp qword ptr [rip+jp_bad], 0")
    asmput("    jne .jpp_bad")
    asmput("    mov rax, rbx")
    asmput("    pop rbx")
    asmput("    ret")
    // Malformed input answers `none`. Parsing the text "0" gives 0, so a
    // failure that answered 0 couldn't be told from a document that said so.
    asmput(".jpp_bad:")
    asmput("    mov rax, 30")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")

// stdin: emitted only for a program that calls in() or ended() (cg[17]). A
// program that reads no input carries neither these four helpers nor the 128 KB
// of line/read buffers behind them.
emit_stdin(cg)
    asmput("# ----- stdin input -----")
    asmput("# refill inbuf from stdin if empty")
    asmput("rt_fill:")
    asmput("    mov rax, [rip+inbuf_pos]")
    asmput("    cmp rax, [rip+inbuf_len]")
    asmput("    jl .fill_done")
    asmput("    mov rax, [rip+in_eof]")
    asmput("    test rax, rax")
    asmput("    jnz .fill_done")
    asmput("    call rt_osync")
    asmput(".fill_read:")
    asmput("    xor rax, rax")
    asmput("    xor rdi, rdi")
    asmput("    lea rsi, [rip+inbuf]")
    asmput("    mov rdx, 65536")
    emit_syscall(cg)
    asmput("    cmp rax, 0")
    asmput("    jg .fill_got")
    if cg[12] == 0
        // Only a read of nothing, or a real error, is the end of input. EINTR
        // reads again, and EAGAIN (a stdin another process left non-blocking)
        // waits in poll for input first. EAGAIN used to count as the end for
        // good, so ended() said true before the first line had arrived.
        asmput("    cmp rax, -4")
        asmput("    je .fill_read")
        asmput("    cmp rax, -11")
        asmput("    jne .fill_eof")
        asmput("    sub rsp, 16")
        asmput("    mov qword ptr [rsp], 0")
        asmput("    mov byte ptr [rsp+4], 1")
        asmput("    mov rax, 7")
        asmput("    mov rdi, rsp")
        asmput("    mov rsi, 1")
        asmput("    mov rdx, -1")
        emit_syscall(cg)
        asmput("    add rsp, 16")
        asmput("    cmp rax, 0")
        asmput("    jge .fill_read")
        asmput("    cmp rax, -4")
        asmput("    je .fill_read")
        asmput(".fill_eof:")
    asmput("    mov qword ptr [rip+in_eof], 1")
    asmput("    mov qword ptr [rip+inbuf_len], 0")
    asmput("    mov qword ptr [rip+inbuf_pos], 0")
    asmput("    jmp .fill_done")
    asmput(".fill_got:")
    asmput("    mov [rip+inbuf_len], rax")
    asmput("    mov qword ptr [rip+inbuf_pos], 0")
    asmput(".fill_done:")
    asmput("    ret")
    asmput("")
    asmput("# next input byte in rax, or -1 at EOF")
    asmput("rt_getbyte:")
    asmput("    call rt_fill")
    asmput("    mov r10, [rip+inbuf_pos]")
    asmput("    cmp r10, [rip+inbuf_len]")
    asmput("    jl .gb_have")
    asmput("    mov rax, -1")
    asmput("    ret")
    asmput(".gb_have:")
    asmput("    lea rcx, [rip+inbuf]")
    asmput("    movzx rax, byte ptr [rcx + r10]")
    asmput("    inc r10")
    asmput("    mov [rip+inbuf_pos], r10")
    asmput("    ret")
    asmput("")
    asmput("# rt_eof: true when stdin is used up, else false. `ended()` asks a question,")
    asmput("# so it answers a boolean (SPEC 3.8).")
    asmput("rt_eof:")
    asmput("    call rt_fill")
    asmput("    mov rax, [rip+inbuf_pos]")
    asmput("    cmp rax, [rip+inbuf_len]")
    asmput("    jl .eof_no")
    asmput("    mov rax, [rip+in_eof]")
    asmput("    lea rax, [rax*8 + 14]")
    asmput("    ret")
    asmput(".eof_no:")
    asmput("    mov rax, 14")
    asmput("    ret")
    asmput("")
    asmput("# read a line: a number if it is an integer, else a text region")
    asmput("rt_readline:")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    // rbx is the buffer, r12 the bytes in it and r13 its size. A line longer
    // than linebuf moves to a buffer twice the size in the arena, as often as
    // it needs to, so a line of any length is one value. It used to stop at
    // 65,536 bytes and hand the rest back as the next line.
    asmput("    lea rbx, [rip+linebuf]")
    asmput("    xor r12, r12")
    asmput("    mov r13, 65536")
    asmput(".rl_read:")
    asmput("    # What inbuf already holds is scanned here, with the position in r10. Only")
    asmput("    # an empty inbuf goes through rt_getbyte and the read behind it.")
    asmput("    mov r10, [rip+inbuf_pos]")
    asmput("    mov r11, [rip+inbuf_len]")
    asmput("    lea rcx, [rip+inbuf]")
    asmput(".rl_scan:")
    asmput("    cmp r10, r11")
    asmput("    jge .rl_more")
    asmput("    movzx rax, byte ptr [rcx + r10]")
    asmput("    inc r10")
    asmput("    cmp rax, 10")
    asmput("    je .rl_scan_eol")
    asmput("    cmp r12, r13")
    asmput("    jae .rl_scan_full")
    asmput("    mov [rbx + r12], al")
    asmput("    inc r12")
    asmput("    jmp .rl_scan")
    asmput(".rl_scan_eol:")
    asmput("    mov [rip+inbuf_pos], r10")
    asmput("    jmp .rl_eol")
    asmput(".rl_scan_full:")
    asmput("    mov [rip+inbuf_pos], r10")
    asmput("    jmp .rl_grow")
    asmput(".rl_more:")
    asmput("    mov [rip+inbuf_pos], r10")
    asmput("    call rt_getbyte")
    asmput("    cmp rax, -1")
    asmput("    je .rl_eol")
    asmput("    cmp rax, 10")
    asmput("    je .rl_eol")
    asmput("    cmp r12, r13")
    asmput("    jb .rl_put")
    asmput(".rl_grow:")
    asmput("    push rax")
    asmput("    lea rdi, [r13 + r13]")
    asmput("    call rt_balloc")
    asmput("    lea rdi, [rax + 8]")
    asmput("    mov rsi, rbx")
    asmput("    mov rcx, r12")
    asmput("    rep movsb")
    asmput("    lea rbx, [rax + 8]")
    asmput("    add r13, r13")
    asmput("    pop rax")
    asmput(".rl_put:")
    asmput("    mov [rbx + r12], al")
    asmput("    inc r12")
    asmput("    jmp .rl_read")
    asmput(".rl_eol:")
    asmput("    # Strip a trailing CR, so a CRLF line (\"x\\r\\n\") comes back as \"x\" on")
    asmput("    # any system. A line that ends in LF alone has no CR to strip.")
    asmput("    test r12, r12")
    asmput("    jz .rl_nocr")
    asmput("    cmp byte ptr [rbx + r12 - 1], 13")
    asmput("    jne .rl_nocr")
    asmput("    dec r12")
    asmput(".rl_nocr:")
    asmput("    xor rcx, rcx")
    asmput("    xor r13, r13")
    asmput("    test r12, r12")
    asmput("    jz .rl_text")
    asmput("    movzx rax, byte ptr [rbx]")
    asmput("    cmp rax, 45")
    asmput("    jne .rl_chkdig")
    asmput("    mov r13, 1")
    asmput("    mov rcx, 1")
    asmput("    cmp r12, 1")
    asmput("    je .rl_text")
    asmput(".rl_chkdig:")
    asmput("    mov r10, rcx")
    asmput(".rl_dloop:")
    asmput("    cmp r10, r12")
    asmput("    jge .rl_isint")
    asmput("    movzx rax, byte ptr [rbx + r10]")
    asmput("    cmp rax, 48")
    asmput("    jl .rl_text")
    asmput("    cmp rax, 57")
    asmput("    jg .rl_text")
    asmput("    inc r10")
    asmput("    jmp .rl_dloop")
    asmput(".rl_isint:")
    asmput("    xor rax, rax")
    asmput("    mov r10, rcx")
    asmput(".rl_ploop:")
    asmput("    cmp r10, r12")
    asmput("    jge .rl_intdone")
    asmput("    movzx r11, byte ptr [rbx + r10]")
    asmput("    sub r11, 48")
    // A line whose value doesn't fit -2^62 .. 2^62 - 1 is text, found the way
    // number() finds it: the digit that would carry past the limit. A line
    // used to be text at 19 digits, so 1000000000000000000 was text here while
    // number() read the same digits as an integer.
    asmput("    movabs r9, 461168601842738790")
    asmput("    cmp rax, r9")
    asmput("    jg .rl_text")
    asmput("    jl .rl_pmul")
    asmput("    mov r9, 3")
    asmput("    add r9, r13")
    asmput("    cmp r11, r9")
    asmput("    jg .rl_text")
    asmput(".rl_pmul:")
    asmput("    imul rax, rax, 10")
    asmput("    add rax, r11")
    asmput("    inc r10")
    asmput("    jmp .rl_ploop")
    asmput(".rl_intdone:")
    asmput("    test r13, r13")
    asmput("    jz .rl_intret")
    asmput("    neg rax")
    asmput(".rl_intret:")
    asmput("    lea rax, [rax*2 + 1]")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput(".rl_text:")
    asmput("    mov rdi, rbx")
    asmput("    mov rsi, r12")
    asmput("    call rt_utf8_decode")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")

// rt_pathcstr is shared: fs needs it, and so does sys.writex. Emitted when
// the program calls either (cg[18] or cg[60]).
//
// A path reaches the OS as out() would write it: a text region as UTF-8, a
// byte-backed one (read, dir, bytes) as the bytes it holds. It used to keep
// the low byte of each element and stop at 4094, so the OS wasn't always
// handed the path the program named: U+012F arrived as '/', a NUL ended the
// name early, and a long one was cut short and still opened. Now a path the
// OS can't be given as written fails the way the OS refusing it would.
emit_pathcstr(cg)
    asmput("# ----- fs module: files via syscalls -----")
    asmput("# rt_pathcstr: rdi = path region -> pathbuf = its bytes, NUL-terminated, and")
    asmput("# rax = 0. Or rax = 1 when the OS can't be given that name (an embedded NUL,")
    asmput("# or more than 4095 bytes), and the caller answers as for any path the OS")
    asmput("# refuses. Text is encoded as UTF-8 and bytes are copied. An element that")
    asmput("# isn't a code point faults, as it does for out(). rt_pathenc is the body,")
    asmput("# with r8 the buffer. Clobbers rax, rcx, rdx, r8, r9, r10.")
    asmput("rt_pathcstr:")
    asmput("    lea r8, [rip+pathbuf]")
    asmput("rt_pathenc:")
    asmput("    # The path has to be a region. A number or a singleton would be read as")
    asmput("    # a pointer here (read, write, dir and rename all come through this).")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    push rbx")
    asmput("    mov rbx, rdi")
    asmput("    mov rcx, [rbx]")
    asmput("    xor rdx, rdx")
    asmput("    xor r9, r9")
    asmput("    test qword ptr [rbx - 16], 1")
    asmput("    jnz .pc_bytes")
    asmput(".pc_loop:")
    asmput("    cmp rdx, rcx")
    asmput("    jge .pc_done")
    asmput("    mov rax, [rbx + rdx*8 + 8]")
    asmput("    inc rdx")
    asmput("    test al, 1")
    asmput("    jz rt_pathchar")
    asmput("    sar rax, 1")
    asmput("    jz .pc_bad")
    asmput("    cmp rax, 0x110000")
    asmput("    jae rt_pathchar")
    asmput("    # a surrogate (U+D800..U+DFFF) has no UTF-8 either")
    asmput("    mov r10, rax")
    asmput("    shr r10, 11")
    asmput("    cmp r10, 27")
    asmput("    je rt_pathchar")
    asmput("    cmp rax, 0x80")
    asmput("    jb .pc_1")
    asmput("    cmp rax, 0x800")
    asmput("    jb .pc_2")
    asmput("    cmp rax, 0x10000")
    asmput("    jb .pc_3")
    asmput("    cmp r9, 4091")
    asmput("    ja .pc_bad")
    asmput("    mov r10, rax")
    asmput("    shr r10, 18")
    asmput("    or r10b, 0xF0")
    asmput("    mov [r8 + r9], r10b")
    asmput("    inc r9")
    asmput("    mov r10, rax")
    asmput("    shr r10, 12")
    asmput("    and r10b, 0x3F")
    asmput("    or r10b, 0x80")
    asmput("    mov [r8 + r9], r10b")
    asmput("    inc r9")
    asmput("    jmp .pc_tail2")
    asmput(".pc_3:")
    asmput("    cmp r9, 4092")
    asmput("    ja .pc_bad")
    asmput("    mov r10, rax")
    asmput("    shr r10, 12")
    asmput("    or r10b, 0xE0")
    asmput("    mov [r8 + r9], r10b")
    asmput("    inc r9")
    asmput("    jmp .pc_tail2")
    asmput(".pc_2:")
    asmput("    cmp r9, 4093")
    asmput("    ja .pc_bad")
    asmput("    mov r10, rax")
    asmput("    shr r10, 6")
    asmput("    or r10b, 0xC0")
    asmput("    mov [r8 + r9], r10b")
    asmput("    inc r9")
    asmput("    jmp .pc_tail1")
    asmput(".pc_tail2:")
    asmput("    mov r10, rax")
    asmput("    shr r10, 6")
    asmput("    and r10b, 0x3F")
    asmput("    or r10b, 0x80")
    asmput("    mov [r8 + r9], r10b")
    asmput("    inc r9")
    asmput(".pc_tail1:")
    asmput("    mov r10, rax")
    asmput("    and r10b, 0x3F")
    asmput("    or r10b, 0x80")
    asmput("    mov [r8 + r9], r10b")
    asmput("    inc r9")
    asmput("    jmp .pc_loop")
    asmput(".pc_1:")
    asmput("    cmp r9, 4094")
    asmput("    ja .pc_bad")
    asmput("    mov [r8 + r9], al")
    asmput("    inc r9")
    asmput("    jmp .pc_loop")
    asmput(".pc_bytes:")
    asmput("    cmp rcx, 4095")
    asmput("    ja .pc_bad")
    asmput(".pc_bl:")
    asmput("    cmp rdx, rcx")
    asmput("    jge .pc_bdone")
    asmput("    movzx rax, byte ptr [rbx + rdx + 8]")
    asmput("    test rax, rax")
    asmput("    jz .pc_bad")
    asmput("    mov [r8 + rdx], al")
    asmput("    inc rdx")
    asmput("    jmp .pc_bl")
    asmput(".pc_bdone:")
    asmput("    mov r9, rcx")
    asmput(".pc_done:")
    asmput("    mov byte ptr [r8 + r9], 0")
    asmput("    xor rax, rax")
    asmput("    pop rbx")
    asmput("    ret")
    asmput(".pc_bad:")
    asmput("    mov rax, 1")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("rt_pathchar:")
    asmput("    lea rdi, [rip+err_char]")
    asmput("    mov rsi, 15")
    asmput("    jmp rt_fail")
    asmput("")

emit_fs(cg)
    asmput("# rt_read: rdi = path region -> rax = a region of the file's bytes, or none.")
    asmput("# The size fstat reports only sizes the first buffer, and is never taken as")
    asmput("# the amount to read: a /proc or /sys entry reports zero and still has")
    asmput("# content, and a loop that stopped at the reported size returned an empty")
    asmput("# region for a file it had opened. So it reads until read(2) says zero,")
    asmput("# growing the buffer if the file outruns its own stat.")
    asmput("rt_read:")
    asmput("    call rt_osync")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    push r15")
    asmput("    call rt_pathcstr")
    asmput("    test rax, rax")
    asmput("    jnz .read_fail")
