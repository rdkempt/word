// emit_win_net: the part of the Windows OS layer only a program with sockets
// gets, the ws2_32 socket family. It's emitted inside w_syscall (from
// emit_win_os) only when the program uses net or a socket verb of sys (cg[11]),
// so any other PE imports nothing from ws2_32. The Linux numbers the socket
// primitives issue map here: 41 socket, 42 connect, 54 setsockopt, and read,
// write and close on a socket go to recv, send and closesocket through a small
// handle table (w_is_sock). udp is connect() on a datagram socket, so there's
// no sendto or recvfrom, and a PE doesn't import them.
//
// The trust store isn't here. Windows keeps its anchors in the Crypt32 ROOT
// store instead of a file, and reaching them is sys.cacerts() (emit_cacerts),
// a named primitive the net library calls and parses in word. The arguments are
// where w_syscall saved them: the first three in r12, r13 and r14 (rdi, rsi,
// rdx), and the next three at [rsp+112], [rsp+96] and [rsp+104] (r10, r8, r9).
// Everything w_syscall saved is restored at .wsc_ret.
emit_win_net(cg)
    asmput("")
    asmput("# ---- ws2_32 sockets (programs with sockets only) ----")
    asmput("# w_is_sock(rdi=handle) -> rax=1 if handle is a tracked socket, else 0.")
    asmput("# Empty slots hold 0 and are skipped, so fd 0 (stdin, never a stored socket)")
    asmput("# can't match one. The table has 64 slots. Clobbers only rax, r10 and r11.")
    asmput("w_is_sock:")
    asmput("    lea r10, [rip+wsock_tab]")
    asmput("    xor r11, r11")
    asmput(".wis_l:")
    asmput("    cmp r11, 64")
    asmput("    jge .wis_no")
    asmput("    mov rax, [r10+r11*8]")
    asmput("    test rax, rax")
    asmput("    jz .wis_skip")
    asmput("    cmp rax, rdi")
    asmput("    je .wis_yes")
    asmput(".wis_skip:")
    asmput("    inc r11")
    asmput("    jmp .wis_l")
    asmput(".wis_yes:")
    asmput("    mov rax, 1")
    asmput("    ret")
    asmput(".wis_no:")
    asmput("    xor rax, rax")
    asmput("    ret")
    asmput("# socket(domain=r12, type=r13, proto=r14): WSAStartup the first time, then")
    asmput("# ws2_32 socket(). A valid SOCKET is a small positive handle, and INVALID_SOCKET")
    asmput("# has bit 63 set and goes straight back (the runtime checks with js). A new")
    asmput("# handle goes in a free slot, so read, write and close reach recv, send, closesocket.")
    asmput("# With all 64 slots taken, the new socket is closed and the answer is -1, as for")
    asmput("# a failed socket(): an untracked socket would reach ReadFile and WriteFile.")
    asmput(".wsc_socket:")
    asmput("    mov rax, [rip+wsa_started]")
    asmput("    test rax, rax")
    asmput("    jnz .wsc_sk_go")
    asmput("    mov rcx, 0x202")
    asmput("    lea rdx, [rip+wsa_data]")
    asmput("    call qword ptr [rip+WSAStartup]")
    asmput("    mov qword ptr [rip+wsa_started], 1")
    asmput(".wsc_sk_go:")
    asmput("    mov rcx, r12")
    asmput("    mov rdx, r13")
    asmput("    mov r8, r14")
    asmput("    call qword ptr [rip+socket]")
    asmput("    test rax, rax")
    asmput("    js .wsc_ret")
    asmput("    mov r10, rax")
    asmput("    lea r11, [rip+wsock_tab]")
    asmput("    xor rcx, rcx")
    asmput(".wsc_sk_slot:")
    asmput("    cmp rcx, 64")
    asmput("    jge .wsc_sk_full")
    asmput("    mov rax, [r11+rcx*8]")
    asmput("    test rax, rax")
    asmput("    je .wsc_sk_put")
    asmput("    inc rcx")
    asmput("    jmp .wsc_sk_slot")
    asmput(".wsc_sk_put:")
    asmput("    mov [r11+rcx*8], r10")
    asmput("    mov rax, r10")
    asmput("    jmp .wsc_ret")
    asmput(".wsc_sk_full:")
    asmput("    mov rcx, r10")
    asmput("    call qword ptr [rip+closesocket]")
    asmput("    mov rax, -1")
    asmput("    jmp .wsc_ret")
    asmput("# connect(fd=r12, sockaddr=r13, len=r14): ws2_32 connect() (0 / -1).")
    asmput(".wsc_connect:")
    asmput("    mov rcx, r12")
    asmput("    mov rdx, r13")
    asmput("    mov r8, r14")
    asmput("    call qword ptr [rip+connect]")
    asmput("    cdqe")
    asmput("    jmp .wsc_ret")
    asmput("# setsockopt(fd=r12, level=r13, optname=r14, optval=[rsp+112],")
    asmput("#            optlen=[rsp+96]): ws2_32 setsockopt().")
    asmput("#")
    asmput("#  Two callers, and only one of them passes through unchanged.")
    asmput("#  rt_connect's handshake deadline sets TCP_MAXRT (IPPROTO_TCP, 6,")
    asmput("#  option 5, a DWORD of seconds), which ws2_32 takes as it comes.")
    asmput("#")
    asmput("#  rt_timeout sets SO_RCVTIMEO and SO_SNDTIMEO, where nothing matches:")
    asmput("#  SOL_SOCKET is 1 on Linux and 0xffff here, the option numbers are")
    asmput("#  20 and 21 there and 0x1006 and 0x1005 here, and Windows wants a")
    asmput("#  DWORD of milliseconds where Linux wants a struct timeval. Passed")
    asmput("#  through, each of those would be refused, and since rt_timeout")
    asmput("#  ignores the result, timeout() would do nothing on Windows and DNS")
    asmput("#  and a fetch would have no deadline. So they're translated here:")
    asmput("#  the timeval {sec, usec} becomes milliseconds in msbuf.")
    asmput(".wsc_setsockopt:")
    asmput("    mov rdx, r13")
    asmput("    mov r8, r14")
    asmput("    mov r9, [rsp+112]")
    asmput("    mov rax, [rsp+96]")
    asmput("    cmp rdx, 1")
    asmput("    jne .wsc_sso_call")
    asmput("    cmp r8, 20")
    asmput("    je .wsc_sso_rcv")
    asmput("    cmp r8, 21")
    asmput("    jne .wsc_sso_call")
    asmput("    mov r8, 4101")
    asmput("    jmp .wsc_sso_ms")
    asmput(".wsc_sso_rcv:")
    asmput("    mov r8, 4102")
    asmput(".wsc_sso_ms:")
    asmput("    mov r10, [r9]")
    asmput("    imul r10, r10, 1000")
    asmput("    mov rax, [r9+8]")
    asmput("    xor rdx, rdx")
    asmput("    mov rcx, 1000")
    asmput("    div rcx")
    asmput("    add rax, r10")
    asmput("    lea rcx, [rip+msbuf]")
    asmput("    mov [rcx], rax")
    asmput("    mov r9, rcx")
    asmput("    mov rdx, 65535")
    asmput("    mov rax, 4")
    asmput(".wsc_sso_call:")
    asmput("    mov rcx, r12")
    asmput("    mov [rsp+32], rax")
    asmput("    call qword ptr [rip+setsockopt]")
    asmput("    cdqe")
    asmput("    jmp .wsc_ret")
    asmput("# socket write -> send(fd, buf, len, 0); returns bytes sent (or -1).")
    asmput(".wsc_w_send:")
    asmput("    mov rcx, r12")
    asmput("    mov rdx, r13")
    asmput("    mov r8, r14")
    asmput("    xor r9, r9")
    asmput("    call qword ptr [rip+send]")
    asmput("    cdqe")
    asmput("    jmp .wsc_ret")
    asmput("# socket read -> recv(fd, buf, len, 0); returns bytes read (or -1).")
    asmput(".wsc_r_recv:")
    asmput("    mov rcx, r12")
    asmput("    mov rdx, r13")
    asmput("    mov r8, r14")
    asmput("    xor r9, r9")
    asmput("    call qword ptr [rip+recv]")
    asmput("    cdqe")
    asmput("    jmp .wsc_ret")
    asmput(".text")

a64_lbl(cg)
    cg[0] = cg[0] + 1
    return ".L" . cg[0]

// A guard: an expression, operator, builtin or statement the arm64 generator
// has no code for comes here, and the build fails (cg[43]) with the construct
// named, instead of producing a binary that runs and gives the wrong answer.
// Floats, maps, txt, net and every builtin are on arm64 now, so nothing a
// program can write should reach it.
a64_giveup(cg, what)
    err("word: " . what . " is not supported on the arm64 target yet")
    cg[43] = 1
    return 0

// A 64-bit immediate into a register. The assembler picks MOVZ, MOVN, ORR or a
// MOVZ+MOVK sequence; nothing here has to know which.
a64_movi(reg, v)
    asmput("    mov " . reg . ", #" . v)

// The address of a symbol, in two instructions: ADRP gives the 4K page, the
// low 12 bits ride the ADD. Both halves are holes the linker fills.
a64_adr(reg, sym)
    asmput("    adrp " . reg . ", " . sym)
    asmput("    add " . reg . ", " . reg . ", #:lo12:" . sym)

// Load or store a global by name: one ADRP plus a folded-offset access. The
// address goes through x16, the AAPCS64's intra-procedure scratch register,
// which generated code never keeps a value in, so two loads in a row can't
// tread on each other. (Through x9, `ldr x9, [pos]` followed by `adrp x9, len`
// would read the length into the register holding the position.)
a64_ldg(reg, sym)
    asmput("    adrp x16, " . sym)
    asmput("    ldr " . reg . ", [x16, #:lo12:" . sym . "]")

a64_stg(reg, sym)
    asmput("    adrp x16, " . sym)
    asmput("    str " . reg . ", [x16, #:lo12:" . sym . "]")

// A frame slot, always a non-negative multiple of 8 from x29. The scaled form
// reaches offset 32760 (slot 4095); past that the offset is built in x17
// instead of being truncated. Generated code uses x17 for nothing else, which
// matters: the frame setup stores x9 into every slot, so an offset built in x9
// would have been stored into each slot past 4095 instead of the word for 0.
a64_lds(reg, off)
    if off <= 32760
        asmput("    ldr " . reg . ", [x29, #" . off . "]")
    else
        a64_movi("x17", off)
        asmput("    ldr " . reg . ", [x29, x17]")

a64_sts(reg, off)
    if off <= 32760
        asmput("    str " . reg . ", [x29, #" . off . "]")
    else
        a64_movi("x17", off)
        asmput("    str " . reg . ", [x29, x17]")

// An outgoing argument slot, sp-relative, the same way: a call with more than
// 4096 arguments reaches past the scaled form.
a64_spstr(reg, off)
    if off <= 32760
        asmput("    str " . reg . ", [sp, #" . off . "]")
    else
        a64_movi("x17", off)
        asmput("    str " . reg . ", [sp, x17]")

// sp +/- n, for frames and outgoing argument areas. The immediate form takes 12
// bits; anything larger goes through x9.
a64_spadd(op, n)
    if n == 0
        return 0
    if n < 4096
        asmput("    " . op . " sp, sp, #" . n)
    else
        a64_movi("x9", n)
        asmput("    " . op . " sp, sp, x9")

// Take `frame` bytes of stack, after the `stp` that saves x29 and x30, and
// point x29 at the new sp. A frame under a page is checked against
// stack_limit once sp has moved, as it always was. A page or more is checked
// before (see a64_mkframe). `guard` is false for a contract wrapper, which has
// never checked a small frame.
a64_frame(cg, frame, guard)
    if frame >= 4096
        a64_movi("x9", frame)
        asmput("    mov x10, sp")
        asmput("    sub x10, x10, x9")
        a64_ldg("x11", "stack_limit")
        asmput("    cmp x10, x11")
        asmput("    b.lo rt_stack")
        asmput("    sub sp, sp, x9")
        asmput("    mov x29, sp")
        return 0
    a64_spadd("sub", frame)
    asmput("    mov x29, sp")
    if guard
        a64_ldg("x10", "stack_limit")
        asmput("    mov x9, sp")
        asmput("    cmp x9, x10")
        asmput("    b.lo rt_stack")
    return 0

// Every operator that can fault checks its operand's tag first. The tag is the
// low three bits: 000 a region, 010 a boxed float, 100 a map, 110 a singleton,
// and any word with bit 0 set is an integer. This is the AArch64 twin of
// numcheck: an integer or a float passes, and a region, a map or a singleton
// faults (rt_numfault, with the tag in x9). A float is a number too, so the
// operators that can't take one reject it separately (a64_floatreject).
a64_numcheck(cg, reg)
    lbl = a64_lbl(cg)
    asmput("    tbnz " . reg . ", #0, " . lbl)
    asmput("    and x9, " . reg . ", #7")
    asmput("    cmp x9, #2")
    asmput("    b.ne rt_numfault")
    asmput(lbl . ":")

// `reg` is x0 at every caller, and has to be: rt_regfault reads the offending
// word there, to tell the four singletons apart, which the tag in x9 can't.
a64_regcheck(reg)
    asmput("    and x9, " . reg . ", #7")
    asmput("    cbnz x9, rt_regfault")

// The condition code a comparison operator answers with, on a signed compare.
a64_cc_of(op)
    if op == "=="
        return "eq"
    if op == "!="
        return "ne"
    if op == "<"
        return "lt"
    if op == "<="
        return "le"
    if op == ">"
        return "gt"
    if op == ">="
        return "ge"
    return "eq"

a64_cc_not(cc)
    if cc == "eq"
        return "ne"
    if cc == "ne"
        return "eq"
    if cc == "lt"
        return "ge"
    if cc == "le"
        return "gt"
    if cc == "gt"
        return "le"
    if cc == "ge"
        return "lt"
    return "ne"

// ---- expressions -----------------------------------------------------------

// The frame slot of a name, as a byte offset from x29. a64_mkframe put the
// number there; the x86-64 generator stores an operand string in the same place,
// which is why the two never share an env.
a64_slot(cg, name)
    return env_lookup(cg, name)

a64_gen_expr(cg, e)
    k = e[0]
    if k == 11
        a64_movi("x0", (e[1] * 2) + 1)
    // See gen_expr: a singleton is an immediate word, not a pointer.
    else if k == 21
        a64_movi("x0", (e[1] * 8) + 6)
    else if k == 12
        a64_movi("x0", region_addr_str(lit_lookup(cg, e)))
    else if k == 19
        a64_gen_map_lit(cg, e)
    else if k == 18
        a64_gen_float_lit(cg, e)
    else if k == 13
        a64_lds("x0", a64_slot(cg, e[1]))
        // A raw u32 local is tagged on read, as on x86-64, so every ordinary
        // reader sees the tagged word. The value is below 2^32, so 2v+1 can't
        // overflow.
        if is_u32_local(cg, e[1]) == 1
            a64_tag("x0")
    else if k == 15
        a64_gen_unary(cg, e)
    else if k == 14
        a64_gen_binary(cg, e)
    else if k == 16
        a64_gen_index(cg, e)
    else if k == 17
        a64_gen_call(cg, e)
    else
        a64_giveup(cg, "this expression")

// A `{}` literal: build an empty map, then set each pair left to right, so a
// repeated key keeps its first position and its last value, as a later
// assignment would.
a64_gen_map_lit(cg, e)
    keys = e[1]
    vals = e[2]
    asmput("    bl rt_map_new")
    i = 0
    loop i < lcount(keys)
        asmput("    str x0, [sp, #-16]!")
        a64_gen_expr(cg, lget(keys, i))
        asmput("    str x0, [sp, #-16]!")
        a64_gen_expr(cg, lget(vals, i))
        asmput("    mov x2, x0")
        asmput("    ldr x1, [sp], #16")
        asmput("    ldr x0, [sp], #16")
        asmput("    str x0, [sp, #-16]!")
        asmput("    bl rt_map_set")
        asmput("    ldr x0, [sp], #16")
        i = i + 1

// A float literal's double is worked out at compile time (f64_hex, the nearest
// double to all of its digits). A literal in the pool (e[5] >= 0) is one load
// from its flit slot, which a64_float_pool_init fills at startup; any other
// gets its bits as an immediate. Either way the double is then boxed.
a64_gen_float_lit(cg, e)
    if e[5] >= 0
        a64_ldg("x0", "flit" . e[5])
    else
        a64_movi("x0", f64_hex(e[1], e[2]))
    asmput("    bl rt_box_float")

// Evaluate both operands, left into x0 and right into x1. The left one is
// parked on the stack, because any call inside the right operand could change
// every scratch register.
a64_gen_pair(cg, e)
    // A right operand that's a literal or a local loads straight into x1 once
    // the left is in x0: reading one can't fault, call or allocate, and nothing
    // the left does can change it, since assignment isn't an expression (SPEC
    // 4.2). The x86-64 generator's gen_two_operands does the same. It saves a
    // store, a load and a move on every such operator: `n < 2`, `n - 1`, `i + 1`.
    if a64_pair_leaf(e[3])
        a64_gen_expr(cg, e[2])
        a64_leaf_into(cg, e[3], "x1")
        return 0
    a64_gen_expr(cg, e[2])
    asmput("    str x0, [sp, #-16]!")
    a64_gen_expr(cg, e[3])
    asmput("    mov x1, x0")
    asmput("    ldr x0, [sp], #16")

// An integer, singleton or text literal, or a local: what a64_gen_expr turns
// into one move or one frame load (and, for a raw u32 local, the tag).
a64_pair_leaf(e)
    k = e[0]
    return k == 11 || k == 21 || k == 12 || k == 13

// a64_gen_expr's own code for such a leaf, into `reg` rather than x0.
a64_leaf_into(cg, e, reg)
    k = e[0]
    if k == 11
        a64_movi(reg, (e[1] * 2) + 1)
    else if k == 21
        a64_movi(reg, (e[1] * 8) + 6)
    else if k == 12
        a64_movi(reg, region_addr_str(lit_lookup(cg, e)))
    else
        a64_lds(reg, a64_slot(cg, e[1]))
        if is_u32_local(cg, e[1]) == 1
            a64_tag(reg)

a64_gen_unary(cg, e)
    op = e[1]
    if op == "-"
        a64_gen_expr(cg, e[2])
        // A float is a tagged pointer to its box, so negating the word would
        // negate the pointer. A float is negated by flipping its sign bit
        // (rt_fneg), which is also the only way to get -0.0 right.
        if cg[14] == 1 && cg_kind(cg, e[2]) != 0
            fl = a64_lbl(cg)
            dn = a64_lbl(cg)
            asmput("    and x9, x0, #7")
            asmput("    cmp x9, #2")
            asmput("    b.eq " . fl)
            a64_numcheck(cg, "x0")
            asmput("    mov x9, #2")
            asmput("    subs x0, x9, x0")
            asmput("    b.vs rt_overflow")
            asmput("    b " . dn)
            asmput(fl . ":")
            asmput("    bl rt_fneg")
            asmput(dn . ":")
            return 0
        a64_numcheck(cg, "x0")
        // -(2n+1) as a tagged word is 2(-n)+1, which is 2 - w.
        asmput("    mov x9, #2")
        asmput("    subs x0, x9, x0")
        asmput("    b.vs rt_overflow")
        return 0
    if op == "~"
        a64_gen_expr(cg, e[2])
        if cg_kind(cg, e[2]) != 0
            a64_numcheck(cg, "x0")
            // `~` is integer-only (SPEC 3.3), and a float passes numcheck
            // (it's a number), so reject it the way % does.
            if cg[14] == 1
                a64_floatreject("x0")
        // Complementing the tagged word clears the tag bit, so put it back:
        // ~(2n+1) is 2(~n), and the value wanted is 2(~n)+1.
        asmput("    mvn x0, x0")
        asmput("    orr x0, x0, #1")
        return 0
    if op == "!"
        a64_gen_expr(cg, e[2])
        // `!` takes true (22) or false (14) and answers the other; anything
        // else faults the way it does under `if` (SPEC 3.2).
        ntrue = a64_lbl(cg)
        nend = a64_lbl(cg)
        a64_truth_jump(cg, e[2], ntrue)
        asmput("    mov x0, #14")
        asmput("    b " . nend)
        asmput(ntrue . ":")
        asmput("    mov x0, #22")
        asmput(nend . ":")
        return 0
    a64_giveup(cg, "unary " . op)

// The tagged word 2n+1 for a raw integer n in `reg`.
a64_tag(reg)
    asmput("    add " . reg . ", " . reg . ", " . reg)
    asmput("    add " . reg . ", " . reg . ", #1")

// The AArch64 twin of emit_bool: a 0/1 in `reg` becomes false=14 or true=22.
a64_bool(reg)
    asmput("    lsl " . reg . ", " . reg . ", #3")
    asmput("    add " . reg . ", " . reg . ", #14")

// A comparison answers true or false. The tagged words of two integers order
// the way the integers do (n -> 2n+1 is monotonic), so two integers compare
// directly, and any other pair goes to rt_eq or rt_order. Both operands are
// integers when the AND of the two words has the tag bit set.
a64_gen_compare(cg, e)
    op = e[1]
    kn = kind_cmp_name(e)
    if kn != 0 && is_kind_name(kn)
        a64_gen_kind_test(cg, kind_cmp_arg(e), kn, op == "!=")
        return 0
    a64_gen_pair(cg, e)
    slow = a64_lbl(cg)
    done = a64_lbl(cg)
    asmput("    and x9, x0, x1")
    asmput("    tbz x9, #0, " . slow)
    asmput("    cmp x0, x1")
    asmput("    cset x0, " . a64_cc_of(op))
    asmput("    b " . done)
    asmput(slow . ":")
    if op == "=="
        asmput("    bl rt_eq")
    else if op == "!="
        asmput("    bl rt_eq")
        asmput("    eor x0, x0, #1")
    else
        // rt_order answers 2 for a nan, which must make all four false, so `>`
        // and `>=` ask what they ask on x86-64 (order_imm): equal to 1, and
        // unsigned below 2.
        asmput("    bl rt_order")
        asmput("    cmp x0, #" . order_imm(op))
        if op == ">"
            asmput("    cset x0, eq")
        else if op == ">="
            asmput("    cset x0, lo")
        else
            asmput("    cset x0, " . a64_cc_of(op))
    asmput(done . ":")
    a64_bool("x0")

// The arm64 half of the kind fold (gen_kind_test is the x86-64 one). The same
// tests in the same order, so the two backends answer the same, which
// test_a64_lang checks by building each program for both.
a64_gen_kind_test(cg, arg, nm, neg)
    a64_gen_expr(cg, arg)
    if nm == "number"
        asmput("    and x9, x0, #7")
        asmput("    cmp x9, #2")
        asmput("    cset x9, eq")
        asmput("    and x0, x0, #1")
        asmput("    orr x0, x0, x9")
    else if nm == "map"
        asmput("    and x0, x0, #7")
        asmput("    cmp x0, #4")
        asmput("    cset x0, eq")
    else if nm == "boolean"
        asmput("    cmp x0, #14")
        asmput("    cset x9, eq")
        asmput("    cmp x0, #22")
        asmput("    cset x0, eq")
        asmput("    orr x0, x0, x9")
    else if nm == "null"
        asmput("    cmp x0, #6")
        asmput("    cset x0, eq")
    else if nm == "none"
        asmput("    cmp x0, #30")
        asmput("    cset x0, eq")
    else
        no = a64_lbl(cg)
        done = a64_lbl(cg)
        asmput("    and x9, x0, #7")
        asmput("    cbnz x9, " . no)
        asmput("    ldur x9, [x0, #-16]")
        if nm == "array"
            asmput("    and x9, x9, #2")
            asmput("    cmp x9, #0")
            asmput("    cset x0, ne")
        else if nm == "bytes"
            asmput("    and x9, x9, #3")
            asmput("    cmp x9, #1")
            asmput("    cset x0, eq")
        else
            asmput("    and x9, x9, #3")
            asmput("    cmp x9, #0")
            asmput("    cset x0, eq")
        asmput("    b " . done)
        asmput(no . ":")
        asmput("    mov x0, xzr")
        asmput(done . ":")
    if neg
        asmput("    eor x0, x0, #1")
    a64_bool("x0")

// The AArch64 twin of gen_truth_jump: every place this target tests a value
// for truth comes here, so the rule is written once. It branches to falsel on
// false (14), falls through on true (22), and faults on anything else
// (rt_condfault, SPEC 3.2).
a64_truth_jump(cg, e, falsel)
    // See the x86-64 copy: true (22) or false (14), anything else faults.
    asmput("    cmp x0, #14")
    asmput("    b.eq " . falsel)
    asmput("    cmp x0, #22")
    asmput("    b.ne rt_condfault")
    return 0

// `&&` and `||` short-circuit. Both answer true or false (SPEC 3.2), which is
// what makes `a && b` usable as a value as well as a condition.
a64_gen_logic(cg, e)
    op = e[1]
    endl = a64_lbl(cg)
    falsel = a64_lbl(cg)
    if op == "&&"
        a64_gen_expr(cg, e[2])
        a64_truth_jump(cg, e[2], falsel)
        a64_gen_expr(cg, e[3])
        a64_truth_jump(cg, e[3], falsel)
        asmput("    mov x0, #22")
        asmput("    b " . endl)
        asmput(falsel . ":")
        asmput("    mov x0, #14")
    else
        nextl = a64_lbl(cg)
        a64_gen_expr(cg, e[2])
        a64_truth_jump(cg, e[2], nextl)
        asmput("    mov x0, #22")
        asmput("    b " . endl)
        asmput(nextl . ":")
        a64_gen_expr(cg, e[3])
        a64_truth_jump(cg, e[3], falsel)
        asmput("    mov x0, #22")
        asmput("    b " . endl)
        asmput(falsel . ":")
        asmput("    mov x0, #14")
    asmput(endl . ":")

// A rotate idiom's value mod 2^32 in w0 with the top half of x0 zeroed, the
// AArch64 twin of gen_rot32. AArch64 has only rotate-right, so a left-rotate
// by L is a ror by 32 - L, used when x is proven to fit in 32 bits. Otherwise
// `asr x1` brings bits R up to R + 31 of x down, and the shifted-register orr
// adds (x << L) mod 2^32. Both backends compute the same value, which
// test_a64_lang's cross-backend diff checks.
a64_gen_rot32(cg, x, lamt)
    if cg_u32(cg, x) == 1
        a64_gen_u32(cg, x)
        asmput("    ror w0, w0, #" . (32 - lamt))
        return 0
    a64_gen_expr(cg, x)
    if cg_kind(cg, x) != 0
        a64_numcheck(cg, "x0")
    asmput("    asr x0, x0, #1")
    asmput("    asr x1, x0, #" . (32 - lamt))
    asmput("    orr w0, w1, w0, lsl #" . lamt)
    return 0

// The 32-bit funnel shift (see funnel_parts), the AArch64 twin of gen_funnel:
// `extr Wd, B, A, #n` = (B << (32 - n)) | (A >> n), matching x86-64's shrd,
// when A is proven to fit in 32 bits. Otherwise A >> n on A's whole width, with
// B's low n bits or'd in above bit 31 - n.
a64_gen_funnel(cg, a, b, n)
    a64_gen_expr(cg, a)
    if cg_kind(cg, a) != 0
        a64_numcheck(cg, "x0")
    fits = cg_u32(cg, a) == 1
    if fits
        asmput("    asr x0, x0, #1")
    else
        asmput("    asr x0, x0, #" . (n + 1))
    asmput("    str x0, [sp, #-16]!")
    a64_gen_expr(cg, b)
    if cg_kind(cg, b) != 0
        a64_numcheck(cg, "x0")
    asmput("    asr x0, x0, #1")
    if fits
        asmput("    mov w1, w0")
        asmput("    ldr x0, [sp], #16")
        asmput("    extr w0, w1, w0, #" . n)
    else
        asmput("    and x1, x0, #" . ((1 << n) - 1))
        asmput("    ldr x0, [sp], #16")
        asmput("    orr x0, x0, x1, lsl #" . (32 - n))
    a64_tag("x0")

// ---- a64_gen_u32: the AArch64 twin of gen_u32 (see there) ------------------
//
// value(e) mod 2^32 in w0, with the top half of x0 zeroed: the raw form a u32
// local lives in. Every 32-bit `w` operation zero-extends into the `x` register
// for free, so `& 0xffffffff` and the overflow check both go away as they do on
// x86-64, and both backends compute the same value. The immediates AArch64
// can't carry in an ALU op (a general 32-bit constant, a bitmask it can't
// encode) go through a register via a64_movi; a shift count is always in range.

a64_gen_u32_binop(cg, e, mnem)
    if e[3][0] == 13 && is_u32_local(cg, e[3][1]) == 1
        a64_gen_u32(cg, e[2])
        a64_lds("w1", a64_slot(cg, e[3][1]))
        asmput("    " . mnem . " w0, w0, w1")
        return 0
    if e[3][0] == 11
        a64_gen_u32(cg, e[2])
        a64_movi("x1", e[3][1] & 4294967295)
        asmput("    " . mnem . " w0, w0, w1")
        return 0
    a64_gen_u32(cg, e[2])
    asmput("    str x0, [sp, #-16]!")
    a64_gen_u32(cg, e[3])
    asmput("    mov w1, w0")
    asmput("    ldr x0, [sp], #16")
    asmput("    " . mnem . " w0, w0, w1")
    return 0

a64_gen_u32(cg, e)
    k = e[0]
    if k == 11
        a64_movi("x0", e[1] & 4294967295)
        return 0
    if k == 13 && is_u32_local(cg, e[1]) == 1
        a64_lds("w0", a64_slot(cg, e[1]))
        return 0
    if k == 14
        op = e[1]
        lamt = rot_lamt(e)
        if lamt > 0
            return a64_gen_rot32(cg, e[2][2], lamt)
        if op == "&"
            if is_mask32(e[3])
                return a64_gen_u32(cg, e[2])
            if is_mask32(e[2])
                return a64_gen_u32(cg, e[3])
            return a64_gen_u32_binop(cg, e, "and")
        if op == "|"
            return a64_gen_u32_binop(cg, e, "orr")
        if op == "^"
            return a64_gen_u32_binop(cg, e, "eor")
        // Only a sum that can't overflow, as on x86-64 (u32_sum_ok).
        if op == "+" && u32_sum_ok(cg, e)
            return a64_gen_u32_binop(cg, e, "add")
        if op == "<<"
            if e[3][0] == 11 && e[3][1] >= 0 && e[3][1] <= 31
                a64_gen_u32(cg, e[2])
                asmput("    lsl w0, w0, #" . e[3][1])
                return 0
        if op == ">>"
            if cg_u32(cg, e[2]) == 1 && e[3][0] == 11 && e[3][1] >= 0 && e[3][1] <= 31
                a64_gen_u32(cg, e[2])
                asmput("    lsr w0, w0, #" . e[3][1])
                return 0
    if k == 15 && e[1] == "~"
        a64_gen_u32(cg, e[2])
        asmput("    mvn w0, w0")
        return 0
    // Otherwise: the ordinary tagged value, untagged, then narrowed to 32 bits
    // so the top half of x0 is clean (the `w` write zero-extends), which
    // matches every other arm and keeps a raw store and an identity mask right.
    // Its kind is checked first unless it's proved an integer, as on x86-64.
    a64_gen_expr(cg, e)
    if cg_kind(cg, e) != 0
        a64_numcheck(cg, "x0")
    asmput("    asr x0, x0, #1")
    asmput("    mov w0, w0")
    return 0

// Arithmetic on the tagged words. Where the tag can be folded into the
// operation there's no separate untag and retag: (2a+1) + (2b+1) - 1 is already
// 2(a+b)+1.
a64_gen_binary(cg, e)
    op = e[1]
    if op == "&&" || op == "||"
        return a64_gen_logic(cg, e)
    // A join chain join_chain_ok accepts is one rt_joinn call, as on x86-64:
    // the parts are evaluated left to right and pushed one per 16-byte slot, so
    // the first sits highest. Any other join goes pair by pair through rt_join.
    if op == "."
        parts = join_parts(e)
        if join_chain_ok(parts)
            i = 0
            loop i < lcount(parts)
                a64_gen_expr(cg, lget(parts, i))
                asmput("    str x0, [sp, #-16]!")
                i = i + 1
            asmput("    mov x0, sp")
            a64_movi("x1", lcount(parts))
            asmput("    bl rt_joinn")
            asmput("    add sp, sp, #" . (16 * lcount(parts)))
            return 0
        a64_gen_pair(cg, e)
        asmput("    bl rt_join")
        return 0
    if is_cmp_op(op)
        return a64_gen_compare(cg, e)
    // The funnel shift, as one `extr` when its A is proven to fit, matching the
    // x86-64 `shrd`. Only in a program without floats, where `|`'s operands
    // can't be floats. A rotate with no mask is ordinary arithmetic, as there.
    if cg[14] == 0 && op == "|"
        fp = funnel_parts(e)
        if fp != 0
            a64_gen_funnel(cg, fp[0], fp[1], fp[2])
            return 0
    // `(rotate) & 0xffffffff` -> the rotate alone: a64_gen_rot32 already leaves
    // a clean 32-bit value, so the mask (a movz/movk pair and an `and`) is dead.
    if cg[14] == 0 && op == "&"
        mlamt = mask32_rot(e)
        if mlamt > 0
            a64_gen_rot32(cg, rot_masked_arg(e)[2][2], mlamt)
            a64_tag("x0")
            return 0
    a64_gen_pair(cg, e)
    lk = cg_kind(cg, e[2])
    rk = cg_kind(cg, e[3])
    if lk != 0
        a64_numcheck(cg, "x0")
    if rk != 0
        a64_numcheck(cg, "x1")
    // In a program with floats, + - * / look at the tags unless both operands
    // are known to be integers. A float is tagged 010 and an integer always has
    // bit 0 set, so two floats are the only pair whose OR leaves 010: one test
    // for the common case inside a float loop. A region, a map or a singleton
    // can't be here, since the numchecks above have already refused them.
    if cg[14] == 1 && is_arith_op(op) && (lk != 0 || rk != 0)
        fl = a64_lbl(cg)
        dn = a64_lbl(cg)
        asmput("    orr x9, x0, x1")
        asmput("    and x9, x9, #7")
        asmput("    cmp x9, #2")
        asmput("    b.eq " . fl)
        asmput("    and x9, x0, #7")
        asmput("    cmp x9, #2")
        asmput("    b.eq " . fl)
        asmput("    and x9, x1, #7")
        asmput("    cmp x9, #2")
        asmput("    b.eq " . fl)
        a64_int_op(cg, op, rlit_val(e[3]))
        asmput("    b " . dn)
        asmput(fl . ":")
        asmput("    bl " . a64_float_helper(op))
        asmput(dn . ":")
        return 0
    // %, the bitwise operators and the shifts are integer-only: in a program
    // with floats, a float operand is refused instead of having its bits used.
    if cg[14] == 1
        if lk != 0
            a64_floatreject("x0")
        if rk != 0
            a64_floatreject("x1")
    return a64_int_op(cg, op, rlit_val(e[3]))

a64_float_helper(op)
    if op == "+"
        return "rt_fadd"
    if op == "-"
        return "rt_fsub"
    if op == "*"
        return "rt_fmul"
    return "rt_fdiv"

// numcheck lets a float through (it's a number), so an integer-only operator
// refuses one separately, with `operator needs whole numbers` (rt_needint).
a64_floatreject(reg)
    lbl = "rt_needint"
    asmput("    and x9, " . reg . ", #7")
    asmput("    cmp x9, #2")
    asmput("    b.eq " . lbl)

// An index must be a whole number: a float faults with "array index must be a
// whole number", and a singleton, region or map isn't a number and faults as
// one, instead of having its bits shifted into an index (s[false] would read
// s[7]). The twin of the x86-64 idxnumcheck.
a64_idxnumcheck(cg, reg)
    lbl = a64_lbl(cg)
    asmput("    tbnz " . reg . ", #0, " . lbl)
    asmput("    and x9, " . reg . ", #7")
    if cg[14] == 1
        asmput("    cmp x9, #2")
        asmput("    b.eq rt_idxfrac")
    asmput("    b rt_numfault")
    asmput(lbl . ":")

// A value stored into a byte-backed region has to be a whole number, because
// only its low byte is kept. a64_numcheck would let a float through, and its
// box pointer's low byte would be stored. The twin of the x86-64 bytecheck.
a64_bytecheck(cg, reg)
    lbl = a64_lbl(cg)
    asmput("    tbnz " . reg . ", #0, " . lbl)
    asmput("    and x9, " . reg . ", #7")
    if cg[14] == 1
        asmput("    cmp x9, #2")
        asmput("    b.eq rt_needint")
    asmput("    b rt_numfault")
    asmput(lbl . ":")

a64_int_op(cg, op, rv)
    if op == "+"
        asmput("    sub x0, x0, #1")
        asmput("    adds x0, x0, x1")
        asmput("    b.vs rt_overflow")
    else if op == "-"
        asmput("    subs x0, x0, x1")
        asmput("    b.vs rt_overflow")
        asmput("    add x0, x0, #1")
    else if op == "*"
        // One operand fully untagged (a), the other with its tag bit taken off
        // (2b), so the product is 2ab directly. AArch64's multiply sets no flags,
        // so the high half is computed alongside and checked against the sign
        // extension of the low half, which is what x86-64's OF says.
        asmput("    asr x9, x0, #1")
        asmput("    sub x10, x1, #1")
        asmput("    mul x11, x9, x10")
        asmput("    smulh x12, x9, x10")
        asmput("    cmp x12, x11, asr #63")
        asmput("    b.ne rt_overflow")
        asmput("    add x0, x11, #1")
    else if op == "/"
        // See the x86-64 copy: exact division, and the remainder decides (0
        // gives the integer quotient, anything else goes to rt_fdiv for a
        // float). AArch64 has no remainder instruction, so msub recovers it from
        // the quotient and the two operands sdiv already has.
        a64_divguard(cg, rv)
        fl = new_label(cg)
        dn = new_label(cg)
        asmput("    stp x0, x1, [sp, #-16]!")
        asmput("    asr x9, x0, #1")
        asmput("    asr x10, x1, #1")
        asmput("    sdiv x11, x9, x10")
        asmput("    msub x12, x11, x10, x9")
        asmput("    cbnz x12, " . fl)
        asmput("    add sp, sp, #16")
        asmput("    mov x0, x11")
        a64_tag("x0")
        asmput("    b " . dn)
        asmput(fl . ":")
        asmput("    ldp x0, x1, [sp], #16")
        asmput("    bl rt_fdiv")
        asmput(dn . ":")
    else if op == "%"
        a64_divguard(cg, rv)
        asmput("    asr x9, x0, #1")
        asmput("    asr x10, x1, #1")
        asmput("    sdiv x11, x9, x10")
        asmput("    msub x0, x11, x10, x9")
        a64_tag("x0")
    else if op == "&"
        asmput("    and x0, x0, x1")
    else if op == "|"
        asmput("    orr x0, x0, x1")
    else if op == "^"
        asmput("    eor x0, x0, x1")
        asmput("    orr x0, x0, #1")
    else if op == "<<"
        asmput("    asr x9, x1, #1")
        asmput("    cmp x9, #63")
        asmput("    b.hi rt_shift")
        asmput("    asr x0, x0, #1")
        asmput("    lsl x0, x0, x9")
        a64_tag("x0")
    else if op == ">>"
        asmput("    asr x9, x1, #1")
        asmput("    cmp x9, #63")
        asmput("    b.hi rt_shift")
        asmput("    asr x0, x0, #1")
        asmput("    asr x0, x0, x9")
        a64_tag("x0")
    else
        a64_giveup(cg, "operator " . op)
    return 0

// The two things that can go wrong in a division, on the tagged divisor in x1:
// a zero divisor, and MIN / -1, whose quotient is one past the range. % takes the
// same guards. rv is the divisor when it's a written integer literal (rlit_val),
// which is never negative (minus is unary), so a nonzero literal needs neither.
a64_divguard(cg, rv)
    if rv <= 0
        asmput("    cmp x1, #1")
        asmput("    b.eq rt_div0")
    if rv < 0
        lbl = a64_lbl(cg)
        asmput("    mov x9, #0x8000000000000001")
        asmput("    cmp x0, x9")
        asmput("    b.ne " . lbl)
        asmput("    cmn x1, #1")
        asmput("    b.eq rt_overflow")
        asmput(lbl . ":")

// ---- regions ---------------------------------------------------------------
//
// A region is a pointer to its length word; elements follow at +8, and the two
// header words below it are the flags (bit 0 byte-backed, bit 1 a JSON array,
// bit 2 a map key) at -16 and the capacity at -8.

a64_gen_index(cg, e)
    a64_gen_pair2(cg, e[1], e[2])
    tk = cg_kind(cg, e[1])
    // A map read is a different operation from an array read, and which one
    // this is may only be known at run time. Where the target is known to be a
    // region the check is skipped, so array loops keep the plain region code;
    // where it's known to be a map there's no array path at all.
    if tk == 4
        asmput("    bl rt_map_get")
        return 0
    if cg[20] == 1 && tk != 1
        notmap = a64_lbl(cg)
        mdone = a64_lbl(cg)
        asmput("    and x9, x0, #7")
        asmput("    cbnz x9, " . notmap)
        a64_gen_index_region(cg, e)
        asmput("    b " . mdone)
        asmput(notmap . ":")
        asmput("    cmp x9, #4")
        asmput("    b.ne rt_regfault")
        asmput("    bl rt_map_get")
        asmput(mdone . ":")
        return 0
    return a64_gen_index_region(cg, e)

a64_gen_index_region(cg, e)
    if cg_kind(cg, e[1]) != 1
        a64_regcheck("x0")
    // The same two facts the x86 path uses: a literal index into a written-down
    // length needs no bound, and a known subkind needs no dispatch.
    k = const_idx(cg, e[1], e[2])
    isub = cg_sub(cg, e[1])
    if k >= 0 && (isub == 1 || isub == 4)
        a64_offload(cg, "ldrb", "w0", k)
        a64_tag("x0")
        return 0
    if k >= 0 && (isub == 2 || isub == 3)
        a64_offload(cg, "ldr", "x0", k * 8)
        return 0
    if k >= 0
        asmput("    mov x1, #" . k)
    else
        if cg_kind(cg, e[2]) != 0
            a64_idxnumcheck(cg, "x1")
        asmput("    asr x1, x1, #1")
        // One unsigned compare covers both ends: a negative index read as
        // unsigned is at least 2^63, and no region is anywhere near that long
        // (a count of 2^40 or more is out of memory).
        asmput("    ldr x9, [x0]")
        asmput("    cmp x1, x9")
        asmput("    b.hs rt_boundsidx")
    if isub == 1 || isub == 4
        asmput("    add x9, x0, x1")
        asmput("    ldrb w0, [x9, #8]")
        a64_tag("x0")
        return 0
    if isub == 2 || isub == 3
        asmput("    add x9, x0, x1, lsl #3")
        asmput("    ldr x0, [x9, #8]")
        return 0
    bl = a64_lbl(cg)
    dl = a64_lbl(cg)
    asmput("    ldur x9, [x0, #-16]")
    asmput("    tbnz x9, #0, " . bl)
    asmput("    add x9, x0, x1, lsl #3")
    asmput("    ldr x0, [x9, #8]")
    asmput("    b " . dl)
    asmput(bl . ":")
    asmput("    add x9, x0, x1")
    asmput("    ldrb w0, [x9, #8]")
    a64_tag("x0")
    asmput(dl . ":")

// A load or store at a constant element offset from the region pointer. AArch64
// unsigned offsets reach 4095 for a byte access and 32760 for a doubleword; past
// that the offset goes through a register, which is still cheaper than the
// bound and the dispatch it replaces.
a64_offload(cg, op, reg, off)
    d = off + 8
    lim = 4095
    if op == "ldr" || op == "str"
        lim = 32760
    if d <= lim
        asmput("    " . op . " " . reg . ", [x0, #" . d . "]")
    else
        a64_movi("x9", d)
        asmput("    add x9, x0, x9")
        asmput("    " . op . " " . reg . ", [x9]")

// Two subexpressions, left in x0 and right in x1. Split out from a64_gen_pair
// because an index is a pair of two nodes that are not the operands of one
// binary node.
a64_gen_pair2(cg, l, r)
    a64_gen_expr(cg, l)
    asmput("    str x0, [sp, #-16]!")
    a64_gen_expr(cg, r)
    asmput("    mov x1, x0")
    asmput("    ldr x0, [sp], #16")

// `a[i] = v`. The region and the subscript are evaluated first and parked on
// the stack, then the value.
a64_gen_index_store(cg, target, valexpr)
    a64_gen_pair2(cg, target[1], target[2])
    asmput("    stp x0, x1, [sp, #-16]!")
    a64_gen_expr(cg, valexpr)
    asmput("    mov x2, x0")
    asmput("    ldp x0, x1, [sp], #16")
    tk = cg_kind(cg, target[1])
    if tk == 4
        asmput("    bl rt_map_set")
        return 0
    if cg[20] == 1 && tk != 1
        notmap = a64_lbl(cg)
        mdone = a64_lbl(cg)
        asmput("    and x9, x0, #7")
        asmput("    cbnz x9, " . notmap)
        a64_gen_index_store_region(cg, target, valexpr)
        asmput("    b " . mdone)
        asmput(notmap . ":")
        asmput("    cmp x9, #4")
        asmput("    b.ne rt_regfault")
        asmput("    bl rt_map_set")
        asmput(mdone . ":")
        return 0
    return a64_gen_index_store_region(cg, target, valexpr)

a64_gen_index_store_region(cg, target, valexpr)
    if cg_kind(cg, target[1]) != 1
        a64_regcheck("x0")
    k = const_idx(cg, target[1], target[2])
    tsub = cg_sub(cg, target[1])
    if k < 0
        if cg_kind(cg, target[2]) != 0
            a64_idxnumcheck(cg, "x1")
        asmput("    asr x1, x1, #1")
    // The two checks on the target (a literal, a map key) come before the
    // bounds check, in the order gen_index_store makes them on x86-64, so a
    // store that's wrong both ways, like `s[99] = 'x'` on a literal, reports the
    // same fault on both targets (test_kinds compares them byte for byte).
    //
    // A literal is read-only: it sits below litpool_top, in the pool rt_init set
    // up at startup, and writing to it would change that literal for the rest
    // of the run. A region the subkind pass proved was freshly allocated isn't
    // one, so it skips the check.
    if tsub != 1 && tsub != 2
        a64_ldg("x10", "litpool_top")
        asmput("    cmp x0, x10")
        asmput("    b.lo rt_wrlit")
    // A region used as a map key is read-only from then on (SPEC 3.7); see the
    // x86-64 store for why the subkind pass can't drop this check.
    if cg[20] == 1
        asmput("    ldur x9, [x0, #-16]")
        asmput("    and x9, x9, #4")
        asmput("    cbnz x9, rt_wrkey")
    if k >= 0
        asmput("    mov x1, #" . k)
    else
        asmput("    ldr x9, [x0]")
        asmput("    cmp x1, x9")
        asmput("    b.hs rt_boundsidx")
    // A value the compiler knows is an integer skips the byte check.
    bchk = cg_kind(cg, valexpr) != 0
    if tsub == 1 || tsub == 4
        if bchk
            a64_bytecheck(cg, "x2")
        asmput("    asr x2, x2, #1")
        if k >= 0
            a64_offload(cg, "strb", "w2", k)
        else
            asmput("    add x9, x0, x1")
            asmput("    strb w2, [x9, #8]")
        return 0
    if tsub == 2 || tsub == 3
        if k >= 0
            a64_offload(cg, "str", "x2", k * 8)
        else
            asmput("    add x9, x0, x1, lsl #3")
            asmput("    str x2, [x9, #8]")
        return 0
    bl = a64_lbl(cg)
    dl = a64_lbl(cg)
    asmput("    ldur x9, [x0, #-16]")
    asmput("    tbnz x9, #0, " . bl)
    asmput("    add x9, x0, x1, lsl #3")
    asmput("    str x2, [x9, #8]")
    asmput("    b " . dl)
    asmput(bl . ":")
    if bchk
        a64_bytecheck(cg, "x2")
    asmput("    asr x2, x2, #1")
    asmput("    add x9, x0, x1")
    asmput("    strb w2, [x9, #8]")
    asmput(dl . ":")

// ---- calls -----------------------------------------------------------------

// Arguments are evaluated last first, as on x86-64, and stored so argument 0
// ends up at the lowest address, where the callee reads it at
// [x29 + frame + 16]. sp is lowered for the area instead of reserving one in
// the frame, so a call inside an argument gets its own space instead of
// writing over its parent's.
a64_gen_args(cg, args, argc)
    n16 = 8 * argc
    if n16 % 16 != 0
        n16 = n16 + 8
    a64_spadd("sub", n16)
    i = argc - 1
    loop i >= 0
        a64_gen_expr(cg, lget(args, i))
        a64_spstr("x0", 8 * i)
        i = i - 1
    return n16

// The method code the bundled library's net_fetch takes for each verb, and
// whether that verb carries a request body.
net_mcode(name)
    if name == "post"
        return 1
    if name == "put"
        return 2
    if name == "delete"
        return 3
    if name == "head"
        return 4
    return 0

net_hasbody(name)
    if name == "post"
        return 1
    if name == "put"
        return 1
    return 0

// The arm64 half of cg_net: the same four arguments in the same order, written
// into the frame a64_gen_args would have built, and the same checks in the
// same order once they're all there. Each check is made on x0, because that's
// where rt_regfault reads the word it reports.
a64_cg_net(cg, args, mcode, hasbody)
    cg[11] = 1
    a64_spadd("sub", 32)
    insidx = hasbody + 1
    hasflag = lcount(args) > insidx
    if hasflag
        a64_gen_expr(cg, lget(args, insidx))
    else
        a64_movi("x0", 14)
    asmput("    str x0, [sp, #24]")
    if hasbody == 1
        a64_gen_expr(cg, lget(args, 1))
    else
        a64_movi("x0", 1)
    asmput("    str x0, [sp, #16]")
    url = lget(args, 0)
    a64_gen_expr(cg, url)
    if cg_kind(cg, url) != 1
        a64_regcheck("x0")
    asmput("    str x0, [sp, #8]")
    if hasbody == 1 && cg_kind(cg, lget(args, 1)) != 1
        asmput("    ldr x0, [sp, #16]")
        a64_regcheck("x0")
    if hasflag && !is_static_bool(lget(args, insidx))
        asmput("    ldr x0, [sp, #24]")
        flagok = a64_lbl(cg)
        a64_truth_jump(cg, 0, flagok)
        asmput(flagok . ":")
    a64_movi("x0", 2 * mcode + 1)
    asmput("    str x0, [sp]")
    asmput("    bl " . net_fetch_fn(cg))
    a64_line_restore(cg)
    a64_spadd("add", 32)

a64_gen_call(cg, e)
    name = e[1]
    args = e[2]
    argc = lcount(args)
    if fn_is_known(cg, name) == 1
        n16 = a64_gen_args(cg, args, argc)
        if cg[5] == 1
            asmput("    bl fn_" . name . ".body")
            a64_line_restore(cg)
        else
            asmput("    bl fn_" . name)
            a64_line_restore(cg)
        a64_spadd("add", n16)
        return 0
    if is_net_func(name) == 1
        a64_cg_net(cg, args, net_mcode(name), net_hasbody(name))
        return 0
    if name == "out"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_out")
        return 0
    if name == "err"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_err")
        return 0
    if name == "len"
        a64_gen_expr(cg, lget(args, 0))
        lk = cg_kind(cg, lget(args, 0))
        if lk == 4
            asmput("    bl rt_map_len")
            return 0
        if cg[20] == 1 && lk != 1
            lnot = a64_lbl(cg)
            ldone = a64_lbl(cg)
            asmput("    and x9, x0, #7")
            asmput("    cbnz x9, " . lnot)
            asmput("    ldr x0, [x0]")
            a64_tag("x0")
            asmput("    b " . ldone)
            asmput(lnot . ":")
            asmput("    cmp x9, #4")
            asmput("    b.ne rt_regfault")
            asmput("    bl rt_map_len")
            asmput(ldone . ":")
            return 0
        a64_regcheck("x0")
        asmput("    ldr x0, [x0]")
        a64_tag("x0")
        return 0
    if name == "has"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_map_has")
        return 0
    if name == "keys"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_map_keys")
        return 0
    if name == "kind"
        a0 = lget(args, 0)
        if cg_kind(cg, a0) == 1
            ks = cg_sub(cg, a0)
            if ks == 1 || ks == 4
                a64_gen_expr(cg, a0)
                a64_adr("x0", "kindlit_bytes")
                a64_ldg("x9", "litfix")
                asmput("    add x0, x0, x9")
                return 0
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_kind")
        return 0
    if name == "stringify"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_json_str")
        return 0
    if name == "parse"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_json_parse")
        return 0
    if name == "text" || name == "array"
        // text(n) and array(n) are the same region; array(n) also carries the
        // JSON-array mark, which is what makes out and `.` render it as [..].
        // Both are filled with the word for the number 0, and the fill is
        // needed: rt_ralloc hands back whatever the arena last held, and a raw 0
        // is a null region pointer, not the number zero, so an unwritten cell
        // would read as stale data or a pointer to address 0.
        a64_gen_expr(cg, lget(args, 0))
        a64_numcheck(cg, "x0")
        // a64_numcheck lets a float through (it's a number), but a count must be
        // a whole number, so a float is refused here instead of shifting its box
        // pointer into a count.
        if cg[14] == 1
            a64_floatreject("x0")
        asmput("    tbnz x0, #63, rt_bounds")
        asmput("    asr x0, x0, #1")
        asmput("    bl rt_ralloc")
        if name == "array"
            asmput("    ldur x9, [x0, #-16]")
            asmput("    orr x9, x9, #2")
            asmput("    stur x9, [x0, #-16]")
        afill = a64_lbl(cg)
        adone = a64_lbl(cg)
        asmput("    ldr x10, [x0]")
        asmput("    mov x11, xzr")
        asmput("    mov x12, #1")
        asmput(afill . ":")
        asmput("    cmp x11, x10")
        asmput("    b.hs " . adone)
        asmput("    add x9, x0, x11, lsl #3")
        asmput("    str x12, [x9, #8]")
        asmput("    add x11, x11, #1")
        asmput("    b " . afill)
        asmput(adone . ":")
        return 0

    if name == "bytes"
        if is_byte_blob(e)
            a64_movi("x0", region_addr_str(lget(args, 0)[4]))
            return 0
        // The same region with one packed byte per element. Zero-filled for the
        // same reason, though here a zero byte really is the integer 0.
        a64_gen_expr(cg, lget(args, 0))
        a64_numcheck(cg, "x0")
        // A float count is refused as not a whole number, not shifted (see the
        // text/array case above).
        if cg[14] == 1
            a64_floatreject("x0")
        asmput("    tbnz x0, #63, rt_bounds")
        asmput("    asr x0, x0, #1")
        asmput("    bl rt_balloc")
        bfill = a64_lbl(cg)
        bdone = a64_lbl(cg)
        asmput("    ldr x10, [x0]")
        asmput("    mov x11, xzr")
        asmput(bfill . ":")
        asmput("    cmp x11, x10")
        asmput("    b.hs " . bdone)
        asmput("    add x9, x0, x11")
        asmput("    strb wzr, [x9, #8]")
        asmput("    add x11, x11, #1")
        asmput("    b " . bfill)
        asmput(bdone . ":")
        return 0
    if name == "copy" && argc == 1
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_copyall")
        return 0
    if name == "copy" && argc == 2
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_copyfrom")
        return 0
    if name == "copy"
        // The third argument is an end index (SPEC 9), and rt_copy takes a
        // count, so rt_copyrange checks the end is a whole number and converts.
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    stp x0, x1, [sp, #-16]!")
        a64_gen_expr(cg, lget(args, 2))
        asmput("    mov x2, x0")
        asmput("    ldp x0, x1, [sp], #16")
        asmput("    bl rt_copyrange")
        return 0
    if name == "find"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_find")
        return 0
    if name == "sort"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_sort")
        return 0
    if name == "number"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_number")
        return 0
    if name == "mark"
        asmput("    bl rt_mark")
        return 0
    if name == "reset"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_reset")
        return 0
    if name == "asmput"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_asmput")
        return 0
    if name == "asmtake"
        asmput("    bl rt_asmtake")
        return 0
    if name == "arch"
        asmput("    mov x0, #3")
        return 0
    if name == "os"
        // 0 for Linux, 2 for macOS: the Mach-O target is the one that differs.
        if cg[45] == 1
            asmput("    mov x0, #5")
        else
            asmput("    mov x0, #1")
        return 0
    if name == "image"
        asmput("    bl rt_image")
        return 0
    if name == "cacerts"
        asmput("    bl rt_cacerts")
        return 0
    if name == "nameservers"
        asmput("    bl rt_nameservers")
        return 0
    if name == "writex"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_writex")
        return 0
    if name == "exec"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_exec")
        return 0
    if name == "connect"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_connect")
        return 0
    if name == "udp"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_udp")
        return 0
    if name == "timeout"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_timeout")
        return 0
    if name == "send"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_send")
        return 0
    if name == "recv"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_recv")
        return 0
    if name == "close"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_close")
        return 0
    if name == "read"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_read")
        return 0
    if name == "dir"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_dir")
        return 0
    if name == "write" || name == "append"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    mov x2, xzr")
        if name == "append"
            asmput("    mov x2, #1")
        asmput("    bl rt_writef")
        return 0
    if name == "rename"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_rename")
        return 0
    if name == "char"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_txchar")
        return 0
    if name == "decode"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_txdecode")
        return 0
    if name == "encode"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_txencode")
        return 0
    if name == "split"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    bl rt_txsplit")
        return 0
    if name == "pad"
        a64_gen_pair2(cg, lget(args, 0), lget(args, 1))
        asmput("    stp x0, x1, [sp, #-16]!")
        a64_gen_expr(cg, lget(args, 2))
        asmput("    mov x2, x0")
        asmput("    ldp x0, x1, [sp], #16")
        asmput("    bl rt_txpad")
        return 0
    if name == "args"
        asmput("    bl rt_args")
        return 0
    if name == "env"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_env")
        return 0
    if name == "in"
        asmput("    bl rt_readline")
        return 0
    if name == "ended"
        asmput("    bl rt_eof")
        return 0
    if name == "round"
        a64_gen_expr(cg, lget(args, 0))
        asmput("    bl rt_round")
        return 0
    if name == "now"
        asmput("    bl rt_now")
        return 0
    if name == "random"
        asmput("    bl rt_random")
        return 0
    a64_giveup(cg, name . "()")

// ---- control flow ----------------------------------------------------------

// Branch to `target` when the condition is false. `&&`, `||` and `!` branch on
// their parts, and a comparison of two operands the compiler knows are
// integers branches on the flags directly. Anything else is evaluated and goes
// through a64_truth_jump, which faults on anything but true or false.
a64_cond_jump(cg, cond, target)
    // `&&` and `||` branch on each side in turn, as gen_cond_jump does.
    if cond[0] == 14 && cond[1] == "&&"
        a64_cond_jump(cg, cond[2], target)
        a64_cond_jump(cg, cond[3], target)
        return 0
    if cond[0] == 14 && cond[1] == "||"
        rightl = a64_lbl(cg)
        truel = a64_lbl(cg)
        a64_cond_jump(cg, cond[2], rightl)
        asmput("    b " . truel)
        asmput(rightl . ":")
        a64_cond_jump(cg, cond[3], target)
        asmput(truel . ":")
        return 0
    if cond[0] == 15 && cond[1] == "!"
        inv = cmp_inverted(cg, cond[2])
        if inv != 0
            a64_cond_jump(cg, inv, target)
            return 0
        holdl = a64_lbl(cg)
        a64_cond_jump(cg, cond[2], holdl)
        asmput("    b " . target)
        asmput(holdl . ":")
        return 0
    if cond[0] == 14 && is_cmp_op(cond[1])
        op = cond[1]
        clk = cg_kind(cg, cond[2])
        crk = cg_kind(cg, cond[3])
        if clk == 0 && crk == 0
            a64_gen_pair(cg, cond)
            asmput("    cmp x0, x1")
            asmput("    b." . a64_cc_not(a64_cc_of(op)) . " " . target)
            return 0
    a64_gen_expr(cg, cond)
    a64_truth_jump(cg, cond, target)

a64_gen_if(cg, s)
    elsel = a64_lbl(cg)
    endl = a64_lbl(cg)
    a64_cond_jump(cg, s[1], elsel)
    thn = s[2]
    i = 0
    loop i < lcount(thn)
        a64_gen_stmt(cg, lget(thn, i))
        i = i + 1
    // No `else`: nothing to jump over (see gen_if).
    if s[3] != 0
        asmput("    b " . endl)
    asmput(elsel . ":")
    if s[3] != 0
        orl = s[3]
        j = 0
        loop j < lcount(orl)
            a64_gen_stmt(cg, lget(orl, j))
            j = j + 1
    asmput(endl . ":")

// The line is stored the way gen_loop stores it. There is no hoisted `len`
// here, so the test is the one loop_pass_line reads.
a64_gen_loop(cg, s, st)
    topl = a64_lbl(cg)
    endl = a64_lbl(cg)
    prevbreak = cg[7]
    cg[7] = endl
    pl = loop_pass_line(cg, s, "")
    if st == 1 && pl == 0
        a64_movi("x9", node_ln(s))
        a64_stg("x9", "cur_line")
    asmput("    .align 16")
    asmput(topl . ":")
    if pl > 0
        a64_movi("x9", pl)
        a64_stg("x9", "cur_line")
    if s[1] != 0
        a64_cond_jump(cg, s[1], endl)
    bdy = s[2]
    i = 0
    loop i < lcount(bdy)
        a64_gen_stmt(cg, lget(bdy, i))
        i = i + 1
    asmput("    b " . topl)
    asmput(endl . ":")
    cg[7] = prevbreak

// `loop x in y`: walk the elements of region y, binding each to x. The same
// index walk the desugaring compiles to, with the subject and the index in
// hidden frame slots, so a call in the body can change any register.
a64_gen_foreach(cg, s)
    a64_gen_expr(cg, s[2])
    if cg_kind(cg, s[2]) != 1
        a64_regcheck("x0")
    ps = a64_slot(cg, fe_hidden_p(s))
    is = a64_slot(cg, fe_hidden_i(s))
    a64_sts("x0", ps)
    asmput("    mov x9, xzr")
    a64_sts("x9", is)
    topl = a64_lbl(cg)
    endl = a64_lbl(cg)
    bl = a64_lbl(cg)
    dl = a64_lbl(cg)
    prevbreak = cg[7]
    cg[7] = endl
    asmput("    .align 16")
    asmput(topl . ":")
    a64_lds("x0", ps)
    a64_lds("x1", is)
    asmput("    ldr x9, [x0]")
    asmput("    cmp x1, x9")
    asmput("    b.hs " . endl)
    asmput("    ldur x9, [x0, #-16]")
    asmput("    tbnz x9, #0, " . bl)
    asmput("    add x9, x0, x1, lsl #3")
    asmput("    ldr x0, [x9, #8]")
    asmput("    b " . dl)
    asmput(bl . ":")
    asmput("    add x9, x0, x1")
    asmput("    ldrb w0, [x9, #8]")
    a64_tag("x0")
    asmput(dl . ":")
    a64_sts("x0", a64_slot(cg, s[1]))
    a64_lds("x1", is)
    asmput("    add x1, x1, #1")
    a64_sts("x1", is)
    bdy = s[3]
    i = 0
    loop i < lcount(bdy)
        a64_gen_stmt(cg, lget(bdy, i))
        i = i + 1
    asmput("    b " . topl)
    asmput(endl . ":")
    cg[7] = prevbreak

// ---- statements ------------------------------------------------------------

a64_gen_stmt(cg, s)
    ln = node_ln(s)
    st = 0
    if ln > 0
        st = stmt_line_plan(cg, s, ln)
        // A loop stores its line itself (a64_gen_loop), as gen_stmt says.
        if st == 1 && s[0] != 7
            a64_movi("x9", ln)
            a64_stg("x9", "cur_line")
    else
        cg[55] = 0
    k = s[0]
    if k == 4
        if is_u32_local(cg, s[1]) == 1
            a64_gen_u32(cg, s[2])
            a64_sts("x0", a64_slot(cg, s[1]))
        else
            a64_gen_expr(cg, s[2])
            a64_sts("x0", a64_slot(cg, s[1]))
    else if k == 5
        tgt = s[1]
        if tgt[0] == 13
            if is_u32_local(cg, tgt[1]) == 1
                a64_gen_u32(cg, s[2])
                a64_sts("x0", a64_slot(cg, tgt[1]))
            else if is_inplace_append(cg, tgt, s[2])
                a64_append_inplace(cg, tgt, s[2])
            else
                a64_gen_expr(cg, s[2])
                a64_sts("x0", a64_slot(cg, tgt[1]))
        else
            a64_gen_index_store(cg, tgt, s[2])
    else if k == 6
        a64_gen_if(cg, s)
    else if k == 7
        a64_gen_loop(cg, s, st)
    else if k == 8
        if cg[5] == 1
            // See the x86-64 copy: `true` passes, `false` is the violation, and
            // anything else faults as a condition does (SPEC 3.2).
            a64_gen_expr(cg, s[1])
            hfail = a64_lbl(cg)
            a64_truth_jump(cg, s[1], hfail)
            asmput("    b " . cg[8])
            asmput(hfail . ":")
            a64_adr("x0", "cn_" . cg[13])
            a64_movi("x1", len(cg[13]))
            asmput("    b rt_contract")
        else
            if s[1] != 0
                a64_gen_expr(cg, s[1])
            else
                // A bare `return` answers the integer 0, which is the word 1. A
                // raw 0 would read as a region pointer.
                asmput("    mov x0, #1")
            a64_epilogue(cg)
    else if k == 9
        asmput("    b " . cg[7])
    else if k == 10
        a64_gen_expr(cg, s[1])
    else if k == 20
        a64_gen_foreach(cg, s)
    else
        a64_giveup(cg, "this statement")

// `s = s . x` where s is a local nothing else can see: the region grows into
// its own spare capacity instead of a new one being allocated and the old one
// abandoned. Without it a loop that builds a string is quadratic in both time
// and memory. `s = s . a . b` is one rt_append per operand, left to right.
a64_append_inplace(cg, tgt, rhs)
    ops = mklist(4)
    cur = rhs
    loop cur[0] == 14 && cur[1] == "."
        ops = ladd_grow(ops, cur[3])
        cur = cur[2]
    i = lcount(ops) - 1
    loop i >= 0
        a64_gen_expr(cg, lget(ops, i))
        asmput("    mov x1, x0")
        a64_lds("x0", a64_slot(cg, tgt[1]))
        asmput("    bl rt_append")
        a64_sts("x0", a64_slot(cg, tgt[1]))
        i = i - 1

// ---- functions -------------------------------------------------------------

// Slots are byte offsets from x29, which points at the bottom of the frame:
// locals from 0 up, incoming arguments above the saved pair.
a64_mkframe(cg, params, body)
    locals = mklist(8)
    locals = collect_locals(body, locals)
    frame = 8 * lcount(locals)
    if frame % 16 != 0
        frame = frame + 8
    env = {}
    j = 0
    loop j < lcount(locals)
        env = add_env(env, lget(locals, j), 8 * j)
        j = j + 1
    i = 0
    loop i < lcount(params)
        env = add_env(env, lget(params, i), frame + 16 + 8 * i)
        i = i + 1
    cg[2] = env
    cg[15] = compute_escapes(cg, params, body)
    cg[23] = infer_local_kinds(cg, params, body, 1)
    // Same proven-32-bit locals as x86-64, stored raw and evaluated in `w`
    // registers (a64_gen_u32). Contract wrappers keep everything tagged (their
    // frames set cg[44] = 0 below), so their raw slot-0 return stays correct.
    cg[44] = infer_u32_locals(cg, params, body)
    // The arm64 loop doesn't hoist the length yet, so it removes no bounds
    // checks, but the slots are cleared so nothing here reads the other
    // backend's.
    cg[51] = 0
    cg[52] = 0
    cg[42] = frame
    asmput("    stp x29, x30, [sp, #-16]!")
    // The stack guard: go to rt_stack if the frame goes below the limit
    // rt_init worked out, so what would be a SIGSEGV is the located `stack
    // exhausted` fault (SPEC 10.2). A frame under a page is checked once it's
    // allocated, which the reserve below the limit covers. A bigger one is
    // checked before sp moves, as on x86-64 (emit_frame): rt_fail runs on the
    // stack it finds, and a frame bigger than the reserve would leave sp past
    // the end of the stack, where rt_fail's first store faults.
    a64_frame(cg, frame, true)
    // Every local starts as the word for 0, so reading one before it's written
    // (which the analyzer allows in a branch it can't prove is taken) gives a
    // number instead of a wild pointer.
    if lcount(locals) > 0
        asmput("    mov x9, #1")
        j = 0
        loop j < lcount(locals)
            a64_sts("x9", 8 * j)
            j = j + 1
    return frame

a64_epilogue(cg)
    a64_spadd("add", cg[42])
    asmput("    ldp x29, x30, [sp], #16")
    asmput("    ret")

a64_gen_function(cg, name, params, body)
    asmput("")
    cg[25] = pk_lookup(cg, name)
    cg[46] = pk_lookup_sub(cg, name)
    if in_before_or_after(cg, name)
        asmput("fn_" . name . ".body:")
    else
        asmput("fn_" . name . ":")
        asmput("fn_" . name . ".body:")
    frame = a64_mkframe(cg, params, body)
    i = 0
    loop i < lcount(body)
        a64_gen_stmt(cg, lget(body, i))
        i = i + 1
    // Falling off the end answers the integer 0, the same as a bare `return`.
    asmput("    mov x0, #1")
    a64_epilogue(cg)
    if in_before_or_after(cg, name)
        a64_emit_wrapper(cg, name, params)

// A guarded function is two functions: `fn_<name>.body` is what was written, and
// `fn_<name>`, which every caller reaches, runs the :before hook, calls the
// body, runs the :after hook with `result` bound, and answers what the body
// answered. A hook's `return false` stops the program with a contract violation
// that gives the function's name; `return true` or reaching the end passes, and
// anything else faults as a condition does (SPEC 8.2).
a64_emit_wrapper(cg, name, params)
    cg[13] = name
    before = lookup_hook(cg[9], name)
    after = lookup_hook(cg[10], name)
    before_locals = mklist(8)
    if before != 0
        before_locals = collect_locals(before[2], before_locals)
    after_locals = mklist(8)
    if after != 0
        after_locals = collect_locals(after[2], after_locals)
    bc = lcount(before_locals)
    ac = lcount(after_locals)
    // Slot 0 holds the body's result; the two hooks' locals follow it.
    frame = 8 * (1 + bc + ac)
    if frame % 16 != 0
        frame = frame + 8
    beforeenv = {}
    afterenv = {}
    i = 0
    loop i < lcount(params)
        slot = frame + 16 + 8 * i
        beforeenv = add_env(beforeenv, lget(params, i), slot)
        afterenv = add_env(afterenv, lget(params, i), slot)
        i = i + 1
    off = 8
    bi = 0
    loop bi < bc
        beforeenv = add_env(beforeenv, lget(before_locals, bi), off)
        off = off + 8
        bi = bi + 1
    afterenv = add_env(afterenv, "result", 0)
    ai = 0
    loop ai < ac
        afterenv = add_env(afterenv, lget(after_locals, ai), off)
        off = off + 8
        ai = ai + 1
    asmput("")
    asmput("fn_" . name . ":")
    asmput("    stp x29, x30, [sp, #-16]!")
    a64_frame(cg, frame, false)
    cg[42] = frame
    if before != 0
        cg[2] = beforeenv
        cg[15] = compute_escapes(cg, params, before[2])
        cg[25] = pk_lookup(cg, cg[13])
        cg[46] = pk_lookup_sub(cg, cg[13])
        cg[23] = infer_local_kinds(cg, params, before[2], 1)
        cg[44] = 0
        passl = a64_lbl(cg)
        cg[5] = 1
        cg[8] = passl
        bb = before[2]
        j = 0
        loop j < lcount(bb)
            a64_gen_stmt(cg, lget(bb, j))
            j = j + 1
        asmput(passl . ":")
        cg[5] = 0
    np = lcount(params)
    n16 = 8 * np
    if n16 % 16 != 0
        n16 = n16 + 8
    a64_spadd("sub", n16)
    pi = 0
    loop pi < np
        // x29 is fixed at the bottom of the frame, so lowering sp for the
        // outgoing arguments doesn't move the incoming ones.
        a64_lds("x0", frame + 16 + 8 * pi)
        a64_spstr("x0", 8 * pi)
        pi = pi + 1
    asmput("    bl fn_" . name . ".body")
    a64_spadd("add", n16)
    a64_sts("x0", 0)
    if after != 0
        cg[2] = afterenv
        aparams = mklist(lcount(params) + 1)
        ap = 0
        loop ap < lcount(params)
            ladd(aparams, lget(params, ap))
            ap = ap + 1
        ladd(aparams, "result")
        cg[15] = compute_escapes(cg, aparams, after[2])
        cg[25] = pk_lookup(cg, cg[13])
        cg[46] = pk_lookup_sub(cg, cg[13])
        cg[23] = infer_local_kinds(cg, aparams, after[2], 1)
        cg[44] = 0
        passm = a64_lbl(cg)
        cg[5] = 1
        cg[8] = passm
        ab = after[2]
        k = 0
        loop k < lcount(ab)
            a64_gen_stmt(cg, lget(ab, k))
            k = k + 1
        asmput(passm . ":")
        cg[5] = 0
    a64_lds("x0", 0)
    a64_epilogue(cg)

// ---- the program -----------------------------------------------------------

a64_gen_program(cg, prog)
    items = prog[1]
    tops = mklist(8192)
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 3
            targets = it[1]
            t0 = lget(targets, 0)
            kind0 = t0[1]
            j = 0
            loop j < lcount(targets)
                tg = lget(targets, j)
                ent = text(2)
                ent[0] = tg[0]
                ent[1] = it
                if kind0 == "before"
                    cg[9] = ladd_grow(cg[9], ent)
                else
                    cg[10] = ladd_grow(cg[10], ent)
                j = j + 1
            hb = it[2]
            m = 0
            loop m < lcount(hb)
                prepass_literals(cg, lget(hb, m))
                m = m + 1
        else
            prepass_literals(cg, it)
            if it[0] != 2
                tops = ladd_grow(tops, it)
        i = i + 1
    infer_inlines(cg, items)
    inline_program(cg, items, tops)
    infer_param_kinds(cg, items, tops)
    infer_retention(cg, items)
    asmput(".global _start")
    asmput(".text")
    asmput("_start:")
    if cg[45] == 1
        // dyld calls the entry the way it calls main, with argc in x0, argv in
        // x1 and envp in x2, so there's no &argc on the stack to read. Only
        // the stack top has to be captured, and it goes in x3 because the
        // other three already hold what rt_init wants.
        asmput("    mov x3, sp")
    else
        // The entry sp is &argc, and it is also the top of the stack the
        // overflow guard measures from. Both are read here, before anything
        // moves sp.
        asmput("    mov x0, sp")
    asmput("    bl rt_init")
    a64_float_pool_init(cg)
    asmput("    bl fn__toplevel")
    // What out() staged and has not yet written goes out before the exit.
    asmput("    str x0, [sp, #-16]!")
    asmput("    bl rt_obuf_flush")
    asmput("    ldr x0, [sp], #16")
    asmput("    asr x0, x0, #1")
