    asmput("    mov rax, [rsp + 64]")
    asmput("    cmp rax, [rsp + 72]")
    asmput("    jge .sort_blockdone")
    asmput("    mov r8, [rsp + 8]")
    asmput("    mov rcx, [rsp + 64]")
    asmput("    mov rax, [r8 + rcx*8 + 8]")
    asmput("    inc rcx")
    asmput("    mov [rsp + 64], rcx")
    asmput("    mov r9, [rsp + 16]")
    asmput("    mov rdx, [rsp + 80]")
    asmput("    mov [r9 + rdx*8 + 8], rax")
    asmput("    inc rdx")
    asmput("    mov [rsp + 80], rdx")
    asmput("    jmp .sort_drainr")
    asmput(".sort_blockdone:")
    asmput("    mov rax, [rsp + 40]")
    asmput("    mov rcx, [rsp + 32]")
    asmput("    add rcx, rcx")
    asmput("    add rax, rcx")
    asmput("    mov [rsp + 40], rax")
    asmput("    jmp .sort_block")
    asmput(".sort_endpass:")
    asmput("    mov rax, [rsp + 8]")
    asmput("    mov rcx, [rsp + 16]")
    asmput("    mov [rsp + 8], rcx")
    asmput("    mov [rsp + 16], rax")
    asmput("    mov rax, [rsp + 32]")
    asmput("    add rax, rax")
    asmput("    mov [rsp + 32], rax")
    asmput("    jmp .sort_pass")
    // LSD radix sort of an all-integer region, eight bits per pass. The key is
    // the word minus the smallest word, compared unsigned: that's the order of
    // the integers, it can't wrap (max - min < 2^64), and it puts a region whose
    // values sit close together, negatives included, in few passes. Each pass
    // counts its digit, turns the counts into starting offsets and scatters src
    // into dst in order, so it's stable and the passes compose. Then src and
    // dst swap, and whichever holds the data at the end is what comes back, as
    // with the merge. Nothing here calls out, so the state lives in registers,
    // and the 256 counters take 2 KiB of stack below the merge's slots, inside
    // the reserve rt_init keeps below stack_limit (128 KB on an ordinary stack).
    //   r14 src  r15 dst  rbx min  r12 max - min  r9 n  rcx the digit's shift
    asmput(".sort_radix:")
    asmput("    sub rsp, 2048")
    asmput("    mov r14, [rsp + 2056]")
    asmput("    mov r15, [rsp + 2064]")
    asmput("    mov r9, [rsp + 2072]")
    asmput(".rx_digit:")
    // x86 masks a shift count to six bits, so the top is tested by count first.
    asmput("    cmp rcx, 64")
    asmput("    jge .rx_done")
    asmput("    mov rax, r12")
    asmput("    shr rax, cl")
    asmput("    test rax, rax")
    asmput("    jz .rx_done")
    asmput("    xor rax, rax")
    asmput("    xor rdx, rdx")
    asmput(".rx_z:")
    asmput("    mov [rsp + rdx*8], rax")
    asmput("    inc rdx")
    asmput("    cmp rdx, 256")
    asmput("    jl .rx_z")
    asmput("    xor rdx, rdx")
    asmput(".rx_h:")
    asmput("    mov rax, [r14 + rdx*8 + 8]")
    asmput("    sub rax, rbx")
    asmput("    shr rax, cl")
    asmput("    and rax, 255")
    asmput("    inc qword ptr [rsp + rax*8]")
    asmput("    inc rdx")
    asmput("    cmp rdx, r9")
    asmput("    jl .rx_h")
    asmput("    xor rax, rax")
    asmput("    xor rdx, rdx")
    asmput(".rx_p:")
    asmput("    mov r10, [rsp + rdx*8]")
    asmput("    mov [rsp + rdx*8], rax")
    asmput("    add rax, r10")
    asmput("    inc rdx")
    asmput("    cmp rdx, 256")
    asmput("    jl .rx_p")
    asmput("    xor rdx, rdx")
    asmput(".rx_s:")
    asmput("    mov rax, [r14 + rdx*8 + 8]")
    asmput("    mov r10, rax")
    asmput("    sub r10, rbx")
    asmput("    shr r10, cl")
    asmput("    and r10, 255")
    asmput("    mov r8, [rsp + r10*8]")
    asmput("    mov [r15 + r8*8 + 8], rax")
    asmput("    inc r8")
    asmput("    mov [rsp + r10*8], r8")
    asmput("    inc rdx")
    asmput("    cmp rdx, r9")
    asmput("    jl .rx_s")
    asmput("    mov rax, r14")
    asmput("    mov r14, r15")
    asmput("    mov r15, rax")
    asmput("    add rcx, 8")
    asmput("    jmp .rx_digit")
    asmput(".rx_done:")
    asmput("    add rsp, 2048")
    asmput("    mov [rsp + 8], r14")
    asmput("    mov [rsp + 16], r15")
    asmput(".sort_ret:")
    asmput("    mov rax, [rsp + 8]")
    asmput("    mov rdx, [rsp + 88]")
    asmput("    mov r10, [rax - 16]")
    asmput("    or r10, rdx")
    asmput("    mov [rax - 16], r10")
    asmput("    add rsp, 96")
    asmput("    pop r15")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    // The runtime goes on in emit_runtime2. The split dates from a parser that
    // capped a block at 2,048 statements; pblock grows its list now, so it's
    // only history. asmput() appends in order, so the runtime comes out the same
    // as it would from one function.
    emit_runtime2(cg)

// rt_failhdr's first half for a program of several files (SPEC 11): the file
// name and its colon, leaving that file's own line in rdi.
//
// A statement stores its line in the files taken together (app.w first, then
// the others), and the file is worked out here, once something has already
// gone wrong. cg[57] holds each file's first line in order, and the file is the
// last one that starts at or before cur_line: the walk srcloc makes for a
// compile error, unrolled into one compare per file.
emit_failhdr_files(cg)
    files = cg[57]
    asmput("    mov rcx, [rip+cur_line]")
    i = lcount(files) - 1
    loop i >= 1
        f = lget(files, i)
        asmput("    cmp rcx, " . f[0])
        asmput("    jl .fh_" . i)
        asmput("    lea rsi, [rip+err_file" . i . "]")
        asmput("    mov rdx, " . len(f[1]))
        asmput("    mov r9, " . (f[0] - 1))
        asmput("    jmp .fh_go")
        asmput(".fh_" . i . ":")
        i = i - 1
    asmput("    lea rsi, [rip+err_file]")
    asmput("    mov rdx, " . len(cg[22]))
    asmput("    xor r9, r9")
    asmput(".fh_go:")
    // How far into the program the file starts, kept on the stack across the
    // two writes so it doesn't depend on what the kernel and the Windows shim
    // preserve.
    asmput("    push r9")
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    emit_syscall(cg)
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    asmput("    lea rsi, [rip+err_colon]")
    asmput("    mov rdx, 1")
    emit_syscall(cg)
    asmput("    pop r9")
    asmput("    mov rdi, [rip+cur_line]")
    asmput("    sub rdi, r9")

// The rest of the x86-64 runtime: the module parts, each emitted only for a
// program that calls into it (emit_sys gates its four pieces itself), the fault
// handlers, the float runtime for a program with floats, and the Windows OS
// layer for -win.
emit_runtime2(cg)
    if cg[18] == 1 || cg[60] == 1
        emit_pathcstr(cg)
    if cg[18] == 1
        emit_fs(cg)
    emit_sys(cg)
    if cg[20] == 1
        emit_map(cg)
    if cg[32] == 1
        emit_txt(cg)
    if cg[33] == 1
        emit_kind(cg)
    asmput("# ----- fault handlers: write message to stderr, exit 70 -----")
    // rt_failhdr writes `<file>:<line>: ` and returns; every fault path calls it
    // first and then prints its own text, so every fault has the same form.
    asmput("rt_failhdr:")
    // What finished out() calls staged is written before the message, so the
    // two arrive in the order they happened, and a partial line from an out()
    // that faulted is dropped (outblen goes back to outmark). If that write
    // fails, the bytes are dropped and this fault is still the one reported
    // (outquiet).
    asmput("    mov qword ptr [rip+outquiet], 1")
    asmput("    mov rax, [rip+outmark]")
    asmput("    mov [rip+outblen], rax")
    asmput("    call rt_obuf_flush")
    if cg[57] != 0
        emit_failhdr_files(cg)
    else
        asmput("    mov rax, 1")
        asmput("    mov rdi, 2")
        asmput("    lea rsi, [rip+err_file]")
        asmput("    mov rdx, " . len(cg[22]))
        emit_syscall(cg)
        asmput("    mov rax, 1")
        asmput("    mov rdi, 2")
        asmput("    lea rsi, [rip+err_colon]")
        asmput("    mov rdx, 1")
        emit_syscall(cg)
        asmput("    mov rdi, [rip+cur_line]")
    asmput("    mov rsi, 2")
    asmput("    call rt_putnum")
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    asmput("    lea rsi, [rip+err_colonsp]")
    asmput("    mov rdx, 2")
    emit_syscall(cg)
    asmput("    ret")
    asmput("rt_fail:")
    asmput("    push rsi")
    asmput("    push rdi")
    asmput("    call rt_failhdr")
    asmput("    pop rsi")
    asmput("    pop rdx")
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    emit_syscall(cg)
    asmput("rt_fail_tail:")
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    asmput("    lea rsi, [rip+nl_msg]")
    asmput("    mov rdx, 1")
    emit_syscall(cg)
    asmput("    mov rax, 60")
    asmput("    mov rdi, 70")
    emit_syscall(cg)
    // The index fault gives the two numbers that answer the question. At every
    // emitted bounds check rcx holds the untagged index and rax the region, so
    // "index 5 out of bounds for a region of length 3" costs nothing until
    // something has gone wrong: the length is read here, on the path that's
    // already failing, and the check itself can stay `cmp rcx, [rax]`.
    asmput("rt_boundsidx:")
    asmput("    mov r11, [rax]")
    asmput("    push r11")
    asmput("    push rcx")
    asmput("    call rt_failhdr")
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    asmput("    lea rsi, [rip+err_idxpre]")
    asmput("    mov rdx, 6")
    emit_syscall(cg)
    asmput("    mov rdi, [rsp]")
    asmput("    mov rsi, 2")
    asmput("    call rt_putnum")
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    asmput("    lea rsi, [rip+err_idxmid]")
    asmput("    mov rdx, 38")
    emit_syscall(cg)
    asmput("    mov rdi, [rsp + 8]")
    asmput("    mov rsi, 2")
    asmput("    call rt_putnum")
    asmput("    jmp rt_fail_tail")
    asmput("rt_div0:")
    asmput("    lea rdi, [rip+err_div]")
    asmput("    mov rsi, 14")
    asmput("    jmp rt_fail")
    asmput("rt_bounds:")
    asmput("    lea rdi, [rip+err_bounds]")
    asmput("    mov rsi, 19")
    asmput("    jmp rt_fail")
    asmput("rt_oom:")
    asmput("    lea rdi, [rip+err_oom]")
    asmput("    mov rsi, 13")
    asmput("    jmp rt_fail")
    if cg[11] == 1 || cg[30] == 1
        asmput("rt_randfault:")
        asmput("    lea rdi, [rip+err_rand]")
        asmput("    mov rsi, 49")
        asmput("    jmp rt_fail")
    asmput("rt_stack:")
    asmput("    lea rdi, [rip+err_stack]")
    asmput("    mov rsi, 15")
    asmput("    jmp rt_fail")
    asmput("rt_eqdeep:")
    asmput("    lea rdi, [rip+err_eqdeep]")
    asmput("    mov rsi, 38")
    asmput("    jmp rt_fail")
    asmput("rt_shift:")
    asmput("    lea rdi, [rip+err_shift]")
    asmput("    mov rsi, 18")
    asmput("    jmp rt_fail")
    asmput("rt_wrlit:")
    asmput("    lea rdi, [rip+err_wrlit]")
    asmput("    mov rsi, 18")
    asmput("    jmp rt_fail")
    if cg[20] == 1
        asmput("rt_wrkey:")
        asmput("    lea rdi, [rip+err_wrkey]")
        asmput("    mov rsi, 18")
        asmput("    jmp rt_fail")
    asmput("rt_ordfault:")
    asmput("    lea rdi, [rip+err_ordcmp]")
    asmput("    mov rsi, 38")
    asmput("    jmp rt_fail")
    asmput("rt_sigordfault:")
    asmput("    lea rdi, [rip+err_sigord]")
    asmput("    mov rsi, 57")
    asmput("    jmp rt_fail")
    asmput("rt_roundfault:")
    asmput("    lea rdi, [rip+err_round]")
    asmput("    mov rsi, 74")
    asmput("    jmp rt_fail")
    asmput("rt_condfault:")
    asmput("    lea rdi, [rip+err_condsig]")
    asmput("    mov rsi, 83")
    asmput("    jmp rt_fail")
    if cg[32] == 1
        asmput("rt_txneedint:")
        asmput("    lea rdi, [rip+err_txneedint]")
        asmput("    mov rsi, 29")
        asmput("    jmp rt_fail")
        asmput("rt_txcodept:")
        asmput("    lea rdi, [rip+err_txcodept]")
        asmput("    mov rsi, 40")
        asmput("    jmp rt_fail")
        asmput("rt_splitsep:")
        asmput("    lea rdi, [rip+err_splitsep]")
        asmput("    mov rsi, 51")
        asmput("    jmp rt_fail")
    if cg[20] == 1
        asmput("rt_jsondeep:")
        asmput("    lea rdi, [rip+err_jsondeep]")
        asmput("    mov rsi, 39")
        asmput("    jmp rt_fail")
        asmput("rt_mapargfault:")
        asmput("    lea rdi, [rip+err_maparg]")
        asmput("    mov rsi, 42")
        asmput("    jmp rt_fail")
        asmput("rt_notmapfault:")
        asmput("    lea rdi, [rip+err_notmap]")
        asmput("    mov rsi, 16")
        asmput("    jmp rt_fail")
    asmput("rt_mapfail:")
    asmput("    lea rdi, [rip+err_map]")
    asmput("    mov rsi, 26")
    asmput("    jmp rt_fail")
    asmput("rt_overflow:")
    asmput("    lea rdi, [rip+err_overflow]")
    asmput("    mov rsi, 16")
    asmput("    jmp rt_fail")
    if cg[20] == 1
        if cg[14] == 1
            asmput("rt_jsonfin:")
            asmput("    lea rdi, [rip+err_jsonfin]")
            asmput("    mov rsi, 55")
            asmput("    jmp rt_fail")
        asmput("rt_jsonnone:")
        asmput("    lea rdi, [rip+err_jsonnone]")
        asmput("    mov rsi, 54")
        asmput("    jmp rt_fail")
    // At rt_numfault the offending value's tag is in r10 (numcheck), so the
    // message can say what arrived: a map, a singleton, or otherwise a region.
    asmput("rt_numfault:")
    asmput("    cmp r10, 4")
    asmput("    je .nf_map")
    asmput("    cmp r10, 6")
    asmput("    je .nf_sig")
    asmput("    lea rdi, [rip+err_num]")
    asmput("    mov rsi, 29")
    asmput("    jmp rt_fail")
    asmput(".nf_map:")
    asmput("    lea rdi, [rip+err_nummap]")
    asmput("    mov rsi, 26")
    asmput("    jmp rt_fail")
    asmput(".nf_sig:")
    asmput("    lea rdi, [rip+err_numsig]")
    asmput("    mov rsi, 46")
    asmput("    jmp rt_fail")
    // The offending word arrives whole in r10: every site tests its low three
    // bits in place (regcheck) instead of masking them out. A singleton is told
    // apart by the word itself, since all four share the tag 110 and each is a
    // constant (SPEC 3.8), and anything else by its tag (SPEC 3.6): 100 is a
    // map, and what's left is an integer or a float, which the language calls
    // a number.
    asmput("rt_regfault:")
    asmput("    cmp r10, 6")
    asmput("    je .rf_null")
    asmput("    cmp r10, 30")
    asmput("    je .rf_none")
    asmput("    cmp r10, 14")
    asmput("    je .rf_bool")
    asmput("    cmp r10, 22")
    asmput("    je .rf_bool")
    if cg[20] == 1
        asmput("    and r10, 7")
        asmput("    cmp r10, 4")
        asmput("    je .rf_map")
    asmput("    lea rdi, [rip+err_region]")
    asmput("    mov rsi, 29")
    asmput("    jmp rt_fail")
    if cg[20] == 1
        asmput(".rf_map:")
        asmput("    lea rdi, [rip+err_regmap]")
        asmput("    mov rsi, 26")
        asmput("    jmp rt_fail")
    asmput(".rf_null:")
    asmput("    lea rdi, [rip+err_regnull]")
    asmput("    mov rsi, 25")
    asmput("    jmp rt_fail")
    asmput(".rf_none:")
    asmput("    lea rdi, [rip+err_regnone]")
    asmput("    mov rsi, 25")
    asmput("    jmp rt_fail")
    asmput(".rf_bool:")
    asmput("    lea rdi, [rip+err_regbool]")
    asmput("    mov rsi, 30")
    asmput("    jmp rt_fail")
    asmput("rt_contract:")
    asmput("    push rsi")
    asmput("    push rdi")
    asmput("    call rt_failhdr")
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    asmput("    lea rsi, [rip+err_contract]")
    asmput("    mov rdx, 22")
    emit_syscall(cg)
    asmput("    pop rsi")
    asmput("    pop rdx")
    asmput("    mov rax, 1")
    asmput("    mov rdi, 2")
    emit_syscall(cg)
    asmput("    jmp rt_fail_tail")
    asmput("")
    if cg[14] == 1
        emit_float_runtime(cg)
    if cg[12] == 1
        emit_win_os(cg)

// emit_float_runtime: the boxed-double float layer (tag 010). Emitted only for
// a program that uses floats, so a program without them carries none of it.
// Boxing puts an 8-byte IEEE-754 double in the arena and tags the pointer 010;
// arithmetic and comparison convert an integer operand to a double as they go.
emit_float_runtime(cg)
    asmput("")
    asmput("# ===== float runtime: tag 010 = pointer to an 8-byte double in the arena =====")
    // rt_box_float: rax = raw double bits -> rax = a new tagged float pointer
    asmput("rt_box_float:")
    asmput("    push rax")
    asmput("    mov rdi, 8")
    asmput("    call rt_alloc")
    asmput("    pop rsi")
    asmput("    mov [rax], rsi")
    asmput("    or rax, 2")
    asmput("    ret")
    // rt_fneg: rax = tagged float -> rax = a new tagged float with the sign bit
    // flipped. Flipping the bit (instead of subtracting from zero) is what makes
    // -0.0 and -nan come out right.
    asmput("rt_fneg:")
    asmput("    mov r10, rax")
    asmput("    and r10, -8")
    asmput("    mov rax, [r10]")
    asmput("    movabs r10, 0x8000000000000000")
    asmput("    xor rax, r10")
    asmput("    jmp rt_box_float")
    // rt_to_double: rdi = tagged integer or float -> xmm0 = double. Clobbers rax
    // and r10. Anything that isn't a float is read as a tagged integer, so a
    // region, a map or a singleton must never get here: every caller proves the
    // word is a number first (numcheck ahead of arithmetic, and the entries of
    // rt_eq_float and rt_order_float).
    asmput("rt_to_double:")
    asmput("    mov r10, rdi")
    asmput("    and r10, 7")
    asmput("    cmp r10, 2")
    asmput("    je .td_float")
    asmput("    mov rax, rdi")
    asmput("    sar rax, 1")
    asmput("    pxor xmm0, xmm0")
    asmput("    cvtsi2sd xmm0, rax")
    asmput("    ret")
    asmput(".td_float:")
    asmput("    mov rax, rdi")
    asmput("    and rax, -8")
    asmput("    mov rax, [rax]")
    asmput("    movq xmm0, rax")
    asmput("    ret")
    // rt_round: rdi = integer or float -> rax = tagged integer, the nearest whole
    // number (ties away from zero). An integer comes back unchanged; a float is
    // nudged toward its sign by the largest double below 0.5, then truncated
    // toward zero. Nudging by 0.5 itself would round the sum: 0.49999999999999994
    // would come back as 1, and 2^52 + 1 as 2^52 + 2. With the smaller nudge the
    // sum only reaches the next whole number when x is half way there or more,
    // which is what frinta does on arm64.
    asmput("rt_round:")
    asmput("    mov r10, rdi")
    asmput("    and r10, 7")
    asmput("    cmp r10, 2")
    asmput("    je .rnd_float")
    // An integer is already whole and comes back unchanged. A region, a map or
    // a singleton isn't a number and faults (r10 holds its tag) instead of
    // coming back as itself.
    asmput("    test rdi, 1")
    asmput("    jz rt_numfault")
    asmput("    mov rax, rdi")
    asmput("    ret")
    asmput(".rnd_float:")
    asmput("    mov rax, rdi")
    asmput("    and rax, -8")
    asmput("    mov rax, [rax]")
    // inf and nan have no nearest whole number, so they fault. cvttsd2si would
    // hand back the "integer indefinite" word 0x8000000000000000 for them, which
    // tags to 0. Float arithmetic can carry inf and nan along, but turning a
    // float into an integer is where they have to stop. An exponent of all ones
    // is inf or nan.
    asmput("    mov r10, rax")
    asmput("    movabs r11, 0x7FF0000000000000")
    asmput("    and r10, r11")
    asmput("    cmp r10, r11")
    asmput("    je rt_roundfault")
    asmput("    mov r10, rax")
    asmput("    shr r10, 63")
    asmput("    movq xmm0, rax")
    asmput("    movabs rax, 0x3FDFFFFFFFFFFFFF")
    asmput("    movq xmm1, rax")
    asmput("    test r10, r10")
    asmput("    jz .rnd_pos")
    asmput("    subsd xmm0, xmm1")
    asmput("    jmp .rnd_tr")
    asmput(".rnd_pos:")
    asmput("    addsd xmm0, xmm1")
    asmput(".rnd_tr:")
    asmput("    cvttsd2si rax, xmm0")
    // The answer has to fit the integer range, -2^62 .. 2^62 - 1, which is one
    // bit narrower than the word cvttsd2si fills (tagging 2^62 would wrap the
    // sign, so round(6e18) would come out negative). Doubling overflows when the
    // value is outside the range, and the indefinite word overflows too.
    asmput("    mov r10, rax")
    asmput("    add r10, rax")
    asmput("    jo rt_roundfault")
    asmput("    lea rax, [rax*2 + 1]")
    asmput("    ret")
    // rt_f10scale: rbx = signed mantissa, r13 = decimal exponent -> rax = the
    // boxed float nearest to mantissa * 10^r13. rdi, rsi, rdx and rcx describe
    // the digits the mantissa came from, for rt_f10exact. rbx and r13 come
    // back untouched.
    //
    // When the mantissa is below 2^53 and the exponent within 15, both it and
    // the power of ten (built as an integer, and 10^15 is under 2^53) are exact
    // doubles, and one IEEE multiply or divide of two exact operands is
    // correctly rounded. Anything else goes to rt_f10exact, which works from
