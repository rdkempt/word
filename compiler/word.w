    asmput(".ke_yes:")
    asmput("    mov rax, 1")
    asmput("    ret")
    asmput(".ke_no:")
    asmput("    xor rax, rax")
    asmput("    ret")
    asmput("    # One side is byte-backed (a key sliced out of a file). Promote both and")
