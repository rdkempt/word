// A byte-backed literal: the region header with the byte-backed flag, then the
// bytes themselves, padded to a word.
blob_line(b)
    n = len(b)
    head = "    .quad 1, " . n . ", " . n . "\n    .byte "
    pad = 0
    if n % 8 != 0
        pad = 8 - (n % 8)
    // Measure before allocating, and fill by index afterwards, the same way
    // lit_line does and for the same reason: `s = s . x` in a loop is an
    // amortized append only under a code generator that recognizes it, and
    // the Python bootstrap seed's doesn't. The net library is embedded as one
    // blob per module, the biggest tens of KB, so the difference is O(n)
    // against O(n^2).
    parts = mklist(8)
    total = len(head)
    i = 0
    loop i < n
        d = num_to_str(b[i])
        parts = ladd_grow(parts, d)
        total = total + len(d)
        if i > 0
            total = total + 1
        i = i + 1
    total = total + pad * 2
    line = text(total)
    k = 0
    loop k < len(head)
        line[k] = head[k]
        k = k + 1
    i = 0
    loop i < n
        if i > 0
            line[k] = 44
            k = k + 1
        d = lget(parts, i)
        m = 0
        loop m < len(d)
            line[k] = d[m]
            k = k + 1
            m = m + 1
        i = i + 1
    i = 0
    loop i < pad
        line[k] = 44
        line[k + 1] = 48
        k = k + 2
        i = i + 1
    return line

// One `.quad` line for a string literal: the header (flags 0, then the
// capacity), the length, then every element as a tagged integer. Capacity
// equals length, so the first `s = s . x` on a literal always reallocates
// instead of writing into the read-only pool.
//
// The line is assembled by index into one right-sized region. Built as
// `line = line . ", " . v` in a loop, it would copy the whole prefix twice per
// element under a code generator without the in-place append (the Python
// seed's), which is quadratic, and the literal pool is the longest text the
// compiler emits. That one loop used to dominate the compiler's peak memory.
lit_line(elems)
    n = len(elems)
    head = "    .quad 0, " . n . ", " . n
    sep = ", "
    parts = mklist(8)
    total = len(head)
    j = 0
    loop j < n
        d = num_to_str((elems[j] * 2) + 1)
        parts = ladd_grow(parts, d)
        total = total + len(sep) + len(d)
        j = j + 1
    line = text(total)
    k = 0
    loop k < len(head)
        line[k] = head[k]
        k = k + 1
    j = 0
    loop j < n
        line[k] = sep[0]
        line[k + 1] = sep[1]
        k = k + 2
        d = lget(parts, j)
        m = 0
        loop m < len(d)
            line[k] = d[m]
            k = k + 1
            m = m + 1
        j = j + 1
    return line

// One 8-byte .bss slot per distinct float literal, for both backends. Each
// value is worked out at compile time (f64_hex), emit_float_pool_init (or
// a64_float_pool_init on arm64) stores it at _start, and every use of the
// literal is one load from its slot.
gen_float_pool(cg)
    pool = cg[29]
    if lcount(pool) == 0
        return 0
    asmput(".section .bss")
    asmput("    .align 8")
    i = 0
    loop i < lcount(pool)
        asmput("flit" . i . ": .space 8")
        i = i + 1
    asmput(".text")

emit_float_pool_init(cg)
    pool = cg[29]
    i = 0
    loop i < lcount(pool)
        e = lget(pool, i)
        // The value is settled at compile time, so startup is a move and a
        // store for each literal instead of two conversions, a division and a
        // power-of-ten loop, and it's the correctly rounded double instead of
        // whatever that arithmetic drifted to.
        asmput("    movabs rax, " . f64_hex(e[0], e[1]))
        asmput("    mov [rip+flit" . i . "], rax")
        i = i + 1

gen_data(cg)
    gen_float_pool(cg)
    asmput("")
    asmput(".section .rodata")
    asmput("litpool:")
    lits = cg[4]
    flags = cg[47]
    i = 0
    loop i < lcount(lits)
