// word: the whole toolchain in one binary. The compiler (lexer, parser, analyzer,
// codegen), the x86-64 and AArch64 assemblers, the ELF, PE and Mach-O linkers and
// the command-line driver all live in this file. It started as two programs,
// compiler/wordc.w and dev/toolchain/wasm.w (the x86-64 assembler and ELF writer).
// Nothing outside word takes part in a normal build. `word build app.w -o app`
// compiles, assembles and links in one process, `word run app.w [args]` builds and
// runs, `word bootstrap` rebuilds word from this source, and `word verify` checks
// that the rebuild is byte-identical to the committed binary (the self-hosting
// fixed point).
//
// The runtime the compiler embeds in a program (emit_runtime) is written as
// asmput() strings. dev/toolchain/dump_runtime.sh prints it as plain assembly.
// ===== compiler (lexer + parser + analyzer + codegen) =====
is_digit(c)
    if c >= 48 && c <= 57
        return true
    return false

is_alpha(c)
    if c >= 97 && c <= 122
        return true
    if c >= 65 && c <= 90
        return true
    return false

is_id_start(c)
    if is_alpha(c)
        return true
    if c == 95
        return true
    return false

is_id_cont(c)
    if is_id_start(c)
        return true
    if is_digit(c)
        return true
    return false

// The character k places past the cursor, or -1 past the end of the source.
// The lexer calls this for every character it reads, so it stays small.
lpeek(st, k)
    src = st[7]
    j = st[0] + k
    if j < len(src)
        return src[j]
    return 0 - 1

ladv(st)
    src = st[7]
    c = src[st[0]]
    st[0] = st[0] + 1
    if c == 10
        // st[20]: the column of the newline just passed, so the end of the file
        // can be placed on the last line (lfinish) and not on the one after it.
        st[20] = st[2]
        st[1] = st[1] + 1
        st[2] = 1
    else
        st[2] = st[2] + 1
    return c

emit(st, code, val, ln, cl)
    t = text(4)
    t[0] = code
    t[1] = val
    t[2] = ln
    t[3] = cl
    toks = st[10]
    c = st[11]
    // The token array doubles when it fills, like the string buffer. A fixed
    // size would be a limit on program size that nothing states.
    if c >= len(toks)
        nt = text(len(toks) * 2)
        i = 0
        loop i < c
            nt[i] = toks[i]
            i = i + 1
        toks = nt
        st[10] = nt
    toks[c] = t
    st[11] = c + 1
    if code < 4
        st[6] = 0
    else
        st[6] = 1

read_escape(st)
    ln = st[1]
    cl = st[2]
    ladv(st)
    e = lpeek(st, 0)
    // A backslash with nothing after it would make ladv index past the end of
    // the source. A line ending after one is an error too, since a backslash
    // doesn't continue a line (SPEC 2.2).
    if e == 0 - 1 || e == 10 || e == 13
        lerr(st, ln, cl, "unterminated escape sequence")
        return 0
    ladv(st)
    if e == 110
        return 10
    if e == 116
        return 9
    if e == 114
        return 13
    if e == 48
        return 0
    if e == 92
        return 92
    if e == 39
        return 39
    if e == 34
        return 34
    lerr(st, ln, cl, "unknown escape sequence")
    return 0

lcomment(st)
    loop
        c = lpeek(st, 0)
        if c == 0 - 1
            break
        if c == 10
            break
        ladv(st)

lident(st)
    ln = st[1]
    cl = st[2]
    start = st[0]
    loop is_id_cont(lpeek(st, 0))
        ladv(st)
    src = st[7]
    n = st[0] - start
    text = copy(src, start, start + n)
    if text == "if"
        emit(st, 8, 0, ln, cl)
    else if text == "else"
        emit(st, 9, 0, ln, cl)
    else if text == "loop"
        emit(st, 10, 0, ln, cl)
    else if text == "return"
        emit(st, 11, 0, ln, cl)
    else if text == "break"
        emit(st, 12, 0, ln, cl)
    // The four singletons (SPEC 3.8). They're reserved words, so `true = 1` is a
    // parse error. The payload is 0 null, 1 false, 2 true, 3 none, the same
    // order as the tag payload codegen emits, so nothing has to translate.
    else if text == "null"
        emit(st, 51, 0, ln, cl)
    else if text == "false"
        emit(st, 51, 1, ln, cl)
    else if text == "true"
        emit(st, 51, 2, ln, cl)
    else if text == "none"
        emit(st, 51, 3, ln, cl)
    else
        emit(st, 4, text, ln, cl)

// lerr records the first lex error and its line and column in the lexer state.
// tokenize stops, and compile_src reports it as "file:line:col: message", the
// same way it reports a parse error (perr). A malformed literal gets an error at
// its place in the program instead of being mis-lexed or faulting the compiler.
lerr(st, ln, cl, msg)
    if st[13] != 0
        return 0
    st[13] = 1
    st[14] = ln
    st[15] = cl
    st[16] = msg

// idiv(a, b) -> the whole part of a / b, truncated toward zero.
//
// `/` is exact: it answers an integer when the division comes out even and a
// float when it doesn't (SPEC 3.3). The compiler wants the whole part in about
// thirty places (digit loops, page rounding, half-lengths), and this is how any
// program gets it, so the language has no builtin for it. `a % b` has the sign
// of `a`, so `a - a % b` is always a multiple of `b` and the division after it is
// exact. The answer is an integer for every sign of either operand.
idiv(a, b)
    return (a - a % b) / b

// numover: would appending decimal digit `dg` to `val` go past the largest
// integer literal, 2^61 - 1 (2305843009213693951)?
//
// That's half the value range (SPEC 2.6). An integer is 63 bits under the 1-bit
// tag (SPEC 3.6, docs/VALUE_MODEL.md), so a computed value spans -2^62 .. 2^62 - 1,
// but codegen writes a literal as the tagged word `value*2 + 1` (gen_expr,
// gen_leaf_into and their arm64 twins) and works that out in the compiler's own
// 63-bit integers. `(2^61 - 1)*2 + 1 = 2^62 - 1` is the largest that fits. A
// program reaches bigger values by arithmetic, which uses the full 63 bits and
// traps on overflow.
//
// The cap is written as `576460752303423487 * 4 + 3` (= 2^61 - 1) because the
// seed that first compiled it still capped literals at 2^59 - 1. It's checked
// before `val = val*10 + dg`, so the test itself can't overflow.
numover(val, dg)
    if val > idiv((576460752303423487 * 4 + 3) - dg, 10)
        return true
    return false

lnumber(st)
    ln = st[1]
    cl = st[2]
    d = ladv(st)
    val = d - 48
    // A digit that doesn't fit in val isn't an error yet, because this may still
    // turn out to be a float: 9000000000000000000.0 is an ordinary double, and
    // only its integer reading is out of range. So the overflow is recorded and
    // judged at the end, and the digits that didn't fit are counted in drop.
    // Each one is a factor of ten the value still has.
    over = 0
    drop = 0
    // A float literal is the nearest double to all of its digits, so the ones
    // that didn't fit are kept as well (tail, tn), and lost says one of them
    // wasn't zero. far says a non-zero digit came after the 800 lnum_tail keeps.
    tail = 0
    tn = 0
    lost = 0
    far = 0
    loop
        c = lpeek(st, 0)
        if is_digit(c)
            ladv(st)
            dg = c - 48
            if over == 1 || numover(val, dg)
                over = 1
                drop = drop + 1
                tail = lnum_tail(tail, tn, dg)
                tn = tn + 1
                if dg != 0
                    lost = 1
                    if tn > 800
                        far = 1
            else
                val = val * 10 + dg
        else if c == 95
            ladv(st)
            c2 = lpeek(st, 0)
            if !is_digit(c2)
                lerr(st, ln, cl, "'_' in a number must sit between two digits")
                return 0
            ladv(st)
            dg2 = c2 - 48
            if over == 1 || numover(val, dg2)
                over = 1
                drop = drop + 1
                tail = lnum_tail(tail, tn, dg2)
                tn = tn + 1
                if dg2 != 0
                    lost = 1
                    if tn > 800
                        far = 1
            else
                val = val * 10 + dg2
        else
            break
    // A '.' immediately followed by a digit makes this a float literal: the
    // digits keep going into the mantissa and each one lowers the decimal
    // exponent by one, so `3.14` is 314 * 10^-2. A bare '.' (not followed by a
    // digit) stays the join operator.
    isf = 0
    fdig = 0
    if lpeek(st, 0) == 46 && is_digit(lpeek(st, 1))
        isf = 1
        ladv(st)
        loop
            fc = lpeek(st, 0)
            if is_digit(fc)
                ladv(st)
                dgf = fc - 48
                // A fraction digit val can't hold goes to the tail and isn't
                // counted in fdig. Once one has, every later digit goes there
                // too: a smaller digit after it could still fit in val, and
                // would then be read one place too high.
                if tn == 0 && !numover(val, dgf)
                    val = val * 10 + dgf
                    fdig = fdig + 1
                else
                    tail = lnum_tail(tail, tn, dgf)
                    tn = tn + 1
                    if dgf != 0
                        lost = 1
                        if tn > 800
                            far = 1
            else if fc == 95
                // Separators sit between digits in every part of a number
                // (SPEC 2.6), the fraction and the exponent included.
                ladv(st)
                if !is_digit(lpeek(st, 0))
                    lerr(st, ln, cl, "'_' in a number must sit between two digits")
                    return 0
            else
                break
    // An exponent makes it a float whether or not a '.' appeared, so `1e6` is a
    // double. The `e` must be followed by an optional sign and at least one
    // digit. Otherwise it's a letter right after a number, and gets that error.
    extra = 0
    ec = lpeek(st, 0)
    if ec == 101 || ec == 69
        esign = 1
        eoff = 1
        sc = lpeek(st, 1)
        if sc == 45
            esign = 0 - 1
            eoff = 2
        else if sc == 43
            eoff = 2
        if is_digit(lpeek(st, eoff))
            isf = 1
            ladv(st)
            if eoff == 2
                ladv(st)
            eval = 0
            loop
                xc = lpeek(st, 0)
                if is_digit(xc)
                    ladv(st)
                    // It stops growing at 10^17, so a long exponent can't
                    // overflow the compiler's own integers, and no literal is
                    // long enough for its digits to bring one that big back
                    // into range. It used to stop at 100000, so a literal with
                    // a million zeros after the point and e1000001 came out
                    // 0.0 instead of 1.0.
                    if eval < 100000000000000000
                        eval = eval * 10 + (xc - 48)
                else if xc == 95
                    ladv(st)
                    if !is_digit(lpeek(st, 0))
                        lerr(st, ln, cl, "'_' in a number must sit between two digits")
                        return 0
                else
                    break
            extra = eval * esign
    if isf == 1
        // `val * 10^extra` is the literal up to the digits in the tail: every
        // integer digit the mantissa could not hold raised the exponent, every
        // fraction digit it did hold lowered it. dec_to_bits turns that pair
        // into the nearest double.
        extra = extra + drop - fdig
        if is_id_start(lpeek(st, 0))
            lerr(st, ln, cl, "a number cannot be immediately followed by a letter or '_'")
            return 0
        fv = text(2)
        fv[0] = val
        fv[1] = extra
        // When a dropped digit wasn't zero the pair isn't the literal, and
        // rounding it can pick the wrong neighbour: 9007199254740993.0000000000001
        // would read as 2^53 instead of 2^53 + 2. So the mantissa becomes every
        // digit, as a region, and each tail digit in it lowers the exponent by one.
        if lost == 1
            fv[0] = lnum_exact(val, tail, tn, far)
            kept = tn
            if kept > 800
                kept = 800
            fv[1] = extra - kept - far
        st[12] = 1
        emit(st, 50, fv, ln, cl)
        return 0
    if is_id_start(lpeek(st, 0))
        lerr(st, ln, cl, "a number cannot be immediately followed by a letter or '_'")
        return 0
    // Only now is it settled that this is an integer literal, and only an
    // integer literal has this limit.
    if over == 1
        lerr(st, ln, cl, "number literal is out of range (max 2305843009213693951)")
        return 0
    emit(st, 5, val, ln, cl)

// Keep one more digit that val couldn't hold. The list is made on the first
// one, so a literal that fits allocates nothing. Only 800 are kept: a halfway
// point between two doubles has at most 767 significant digits, so past that a
// digit can only matter by not being zero, which lnumber records in far.
lnum_tail(tail, tn, dg)
    if tn == 0
        tail = mklist(8)
    if tn < 800
        tail = ladd_grow(tail, dg)
    return tail

// The whole mantissa of a float literal as a region of digits, most
// significant first: val, then the kept tail, then a 1 when a non-zero digit
// fell past the 800 (it stands for all of them, and is enough to break a tie).
lnum_exact(val, tail, tn, far)
    vd = 0
    v = val
    loop v > 0
        v = idiv(v, 10)
        vd = vd + 1
    kept = tn
    if kept > 800
        kept = 800
    n = vd + kept + far
    r = text(n)
    v = val
    i = vd - 1
    loop i >= 0
        r[i] = v % 10
        v = idiv(v, 10)
        i = i - 1
    j = 0
    loop j < kept
        r[vd + j] = lget(tail, j)
        j = j + 1
    if far == 1
        r[n - 1] = 1
    return r

// One code point off the source, decoded from UTF-8. The compiler reads its
// input with read(), which gives bytes (SPEC 12.1), but inside a literal the
// unit is the code point (SPEC 2.1), so "é" has to become one element and not
// the two bytes that spell it. Only well-formed UTF-8 decodes, by the same rule
// as the runtime's decoder: the shortest form, no surrogate, nothing past
// U+10FFFF. A byte that starts no such sequence comes back as itself. Nothing
// after it is consumed until the whole sequence has been checked, so a byte
// that doesn't complete one is read again as a character of its own.
lcodepoint(st)
    b0 = ladv(st)
    if b0 < 128
        return b0
    need = 0
    v = 0
    lo = 0
    if b0 < 194
        return b0
    else if b0 < 224
        need = 1
        v = b0 - 192
        lo = 128
    else if b0 < 240
        need = 2
        v = b0 - 224
        lo = 2048
    else if b0 < 245
        need = 3
        v = b0 - 240
        lo = 65536
    else
        return b0
    i = 0
    loop i < need
        c = lpeek(st, i)
        if c < 128 || c > 191
            return b0
        v = (v << 6) | (c - 128)
        i = i + 1
    if v < lo || v > 1114111 || (v >= 55296 && v <= 57343)
        return b0
    i = 0
    loop i < need
        ladv(st)
        i = i + 1
    return v

lstring(st)
    ln = st[1]
    cl = st[2]
    ladv(st)
    buf = st[9]
    n = 0
    loop
        c = lpeek(st, 0)
        if c == 34
            ladv(st)
            break
        // End of input with the quote still open. At EOF lpeek answers -1, which
        // is below 128, so without this check the scanner would copy it and walk
        // off the end of the source, and the compiler would fault on a line of
        // its own (SPEC 10.1 says it never does). `out("` is an ordinary
        // half-typed line, so an editor asking for diagnostics meets this often.
        if c == 0 - 1
            lerr(st, ln, cl, "unterminated string literal")
            return 0
        // A line ending always ends a statement, even here. Write `\n` or `\r`
        // for one inside a string. Allowing a raw one would let one source line
        // hide inside another.
        if c == 10 || c == 13
            lerr(st, ln, cl, "newline in string literal")
            return 0
        // The buffer doubles when it fills. A fixed size would fault the
        // compiler on a long literal, and a `bytes("...")` table gets long: 32 KB
        // of data is 65,536 hex digits.
        if n >= len(buf)
            nb = text(len(buf) * 2)
            i = 0
            loop i < n
                nb[i] = buf[i]
                i = i + 1
            buf = nb
            st[9] = nb
        if c == 92
            buf[n] = read_escape(st)
        else if c < 128
            buf[n] = ladv(st)
        else
            buf[n] = lcodepoint(st)
        n = n + 1
    s = copy(buf, 0, n)
    emit(st, 6, s, ln, cl)

lchar(st)
    ln = st[1]
    cl = st[2]
    ladv(st)
    c = lpeek(st, 0)
    if c == 39
        lerr(st, ln, cl, "empty character literal")
        return 0
    if c == 0 - 1
        lerr(st, ln, cl, "unterminated character literal")
        return 0
    if c == 10 || c == 13
        lerr(st, ln, cl, "newline in character literal")
        return 0
    val = 0
    if c == 92
        val = read_escape(st)
    else
        val = lcodepoint(st)
    next = lpeek(st, 0)
    if next == 10 || next == 13
        lerr(st, ln, cl, "newline in character literal")
        return 0
    if next != 39
        lerr(st, ln, cl, "character literal must be a single code point, closed with '")
        return 0
    ladv(st)
    emit(st, 7, val, ln, cl)

opemit(st, ln, cl, adv, dd, code)
    // st[17..19]: the line, column and character of the outermost bracket still
    // open, for lfinish to report when the file ends inside it.
    if dd == 1 && st[3] == 0
        st[17] = ln
        st[18] = cl
        st[19] = lpeek(st, 0)
    i = 0
    loop i < adv
        ladv(st)
        i = i + 1
    st[3] = st[3] + dd
    if st[3] < 0
        st[3] = 0
    emit(st, code, 0, ln, cl)

loperator(st)
    ln = st[1]
    cl = st[2]
    c0 = lpeek(st, 0)
    c1 = lpeek(st, 1)
    if c0 == 60 && c1 == 60
        opemit(st, ln, cl, 2, 0, 18)
    else if c0 == 62 && c1 == 62
        opemit(st, ln, cl, 2, 0, 19)
    else if c0 == 61 && c1 == 61
        opemit(st, ln, cl, 2, 0, 28)
    else if c0 == 33 && c1 == 61
        opemit(st, ln, cl, 2, 0, 29)
    else if c0 == 60 && c1 == 61
        opemit(st, ln, cl, 2, 0, 26)
    else if c0 == 62 && c1 == 61
        opemit(st, ln, cl, 2, 0, 27)
    else if c0 == 38 && c1 == 38
        opemit(st, ln, cl, 2, 0, 30)
    else if c0 == 124 && c1 == 124
        opemit(st, ln, cl, 2, 0, 31)
    else if c0 == 58 && c1 == 61
        lerr(st, ln, cl, "':=' is not an operator: write '=', which declares a name the first time you assign to it and stores into it after that")
    else if c0 == 43
        opemit(st, ln, cl, 1, 0, 13)
    else if c0 == 45
        opemit(st, ln, cl, 1, 0, 14)
    else if c0 == 42
        opemit(st, ln, cl, 1, 0, 15)
    else if c0 == 47
        opemit(st, ln, cl, 1, 0, 16)
    else if c0 == 37
        opemit(st, ln, cl, 1, 0, 17)
    else if c0 == 60
        opemit(st, ln, cl, 1, 0, 24)
    else if c0 == 62
        opemit(st, ln, cl, 1, 0, 25)
    else if c0 == 33
        opemit(st, ln, cl, 1, 0, 32)
    else if c0 == 126
        opemit(st, ln, cl, 1, 0, 23)
    else if c0 == 38
        opemit(st, ln, cl, 1, 0, 20)
    else if c0 == 124
        opemit(st, ln, cl, 1, 0, 21)
    else if c0 == 94
        opemit(st, ln, cl, 1, 0, 22)
    else if c0 == 61
        opemit(st, ln, cl, 1, 0, 33)
    else if c0 == 40
        opemit(st, ln, cl, 1, 1, 35)
    else if c0 == 41
        opemit(st, ln, cl, 1, 0 - 1, 36)
    else if c0 == 91
        opemit(st, ln, cl, 1, 1, 37)
    else if c0 == 93
        opemit(st, ln, cl, 1, 0 - 1, 38)
    else if c0 == 44
        opemit(st, ln, cl, 1, 0, 39)
    else if c0 == 58
        opemit(st, ln, cl, 1, 0, 40)
    else if c0 == 46
        opemit(st, ln, cl, 1, 0, 41)
    else if c0 == 123
        opemit(st, ln, cl, 1, 1, 42)
    else if c0 == 125
        opemit(st, ln, cl, 1, 0 - 1, 43)
    else
        lbad(st, ln, cl, c0)

// A byte no token starts with is an error, and so is any non-ASCII byte outside
// a literal or a comment (SPEC 2.1). The common ones get a message that says
// what to do instead. Skipping them would let `café = 1` bind `caf` and let
// `x = 1;` compile.
lbad(st, ln, cl, c)
    if c == 59
        lerr(st, ln, cl, "there is no ';' in word, a newline ends a statement")
    else if c == 92
        lerr(st, ln, cl, "'\\' is not a line continuation, a line continues only inside unmatched brackets")
    else if c >= 128
        // Any line's column 1: a folder program is lexed as one joined source,
        // so a byte order mark at the top of any of its files gets this too.
        if cl == 1 && c == 239 && lpeek(st, 1) == 187 && lpeek(st, 2) == 191
            lerr(st, ln, cl, "this file starts with a UTF-8 byte order mark, save it as UTF-8 without one")
        else
            lerr(st, ln, cl, "a non-ASCII character is allowed only inside a string, a character literal or a comment")
    else if c > 32 && c < 127
        lerr(st, ln, cl, "unexpected character '" . copy(st[7], st[0], st[0] + 1) . "'")
    else
        lerr(st, ln, cl, "unexpected control character (byte " . c . ")")

lline_start(st)
    indent = 0
    sline = st[1]
    loop
        c = lpeek(st, 0)
        if c == 32
            ladv(st)
            indent = indent + 1
        else
            break
    // Look past any leftover whitespace (a stray tab, the CR of a CRLF line
    // ending, trailing spaces) to decide whether this line is blank or only a
    // comment. Such a line has no indentation and emits no indent or dedent
    // token, whatever an editor or git left on it. That's what keeps CRLF
    // endings, trailing whitespace and blank-but-not-empty lines from closing
    // the enclosing block.
    k = 0
    loop
        cw = lpeek(st, k)
        if cw == 32 || cw == 9 || cw == 13
            k = k + 1
        else
            break
    c2 = lpeek(st, k)
    p1 = lpeek(st, k + 1)
    if c2 == 0 - 1 || c2 == 10 || (c2 == 47 && p1 == 47)
        // Skip the whole physical line: the whitespace, an optional comment
        // (which runs to the newline anyway), and the newline itself.
        loop
            cc = lpeek(st, 0)
            if cc == 0 - 1 || cc == 10
                break
            ladv(st)
        if lpeek(st, 0) == 10
            ladv(st)
        return 0
    // Indentation is spaces only (SPEC 2.2). A tab here is an error, since
    // counting it as nothing would put a tab-indented line in whatever block
    // its spaces reach. Tabs later in the line are fine.
    if lpeek(st, 0) == 9
        lerr(st, sline, indent + 1, "indent with spaces, not tabs")
        return 0
    indents = st[8]
    top = indents[st[4] - 1]
    if indent > top
        // The indentation stack doubles when it fills, like the token array.
        if st[4] >= len(indents)
            ni = text(len(indents) * 2)
            i = 0
            loop i < st[4]
                ni[i] = indents[i]
                i = i + 1
            indents = ni
            st[8] = ni
        indents[st[4]] = indent
        st[4] = st[4] + 1
        // Located at the first character of the indented line, so an
        // "unexpected indent" from the parser points at the text, not column 1.
        emit(st, 2, 0, sline, indent + 1)
    else if indent < top
        loop indent < indents[st[4] - 1]
            st[4] = st[4] - 1
            emit(st, 3, 0, sline, 1)
        // A dedent has to land on a block that's still open. Without this, a
        // line at 6 spaces under blocks at 4 and 8 would join the block at 4
        // with no error.
        if indent != indents[st[4] - 1]
            lerr(st, sline, indent + 1, "inconsistent dedentation")
            return 0
    st[5] = 0

lnewline(st)
    ln = st[1]
    cl = st[2]
    ladv(st)
    if st[3] == 0
        if st[6] == 1
            emit(st, 1, 0, ln, cl)
        st[5] = 1

lfinish(st)
    // A bracket still open here has swallowed every line after it (newlines
    // inside brackets join lines), so it's reported where it was opened.
    // Otherwise the parser would trip over the end of the file instead.
    if st[3] > 0
        b = "("
        if st[19] == 91
            b = "["
        else if st[19] == 123
            b = "{"
        lerr(st, st[17], st[18], "this '" . b . "' is never closed")
    // The end of the file is placed at the end of its last line. After a final
    // newline the lexer is already on a line that doesn't exist, and an error
    // reported at the end would point there.
    ln = st[1]
    cl = st[2]
    if cl == 1 && ln > 1
        ln = ln - 1
        cl = st[20]
    if st[6] == 1
        emit(st, 1, 0, ln, cl)
    loop st[4] > 1
        st[4] = st[4] - 1
        emit(st, 3, 0, ln, cl)
    emit(st, 0, 0, ln, cl)

tokenize(st)
    src = st[7]
    loop st[0] < len(src)
        if st[13] != 0
            break
        if st[5] == 1 && st[3] == 0
            lline_start(st)
        else
            c = lpeek(st, 0)
            if c == 32 || c == 9 || c == 13
                ladv(st)
            else if c == 10
                lnewline(st)
            else if c == 47 && lpeek(st, 1) == 47
                lcomment(st)
            else if is_id_start(c)
                lident(st)
            else if is_digit(c)
                lnumber(st)
            else if c == 34
                lstring(st)
            else if c == 39
                lchar(st)
            else
                loperator(st)
    lfinish(st)

ppeek(ps, k)
    toks = ps[1]
    j = ps[0] + k
    if j >= ps[2]
        j = ps[2] - 1
    return toks[j]

pkind(ps, k)
    t = ppeek(ps, k)
    return t[0]

pcheck(ps, code)
    if pkind(ps, 0) == code
        return true
    return false

padv(ps)
    toks = ps[1]
    t = toks[ps[0]]
    ps[0] = ps[0] + 1
    return t

// perr records the first parse error, at the offending token's line and column,
// in ps. compile_src reports it and stops before the analyzer, so malformed input
// gets a "file:line:col: message" instead of an internal compiler fault.
perr(ps, tok, msg)
    if ps[3] != 0
        return 0
    ps[3] = 1
    ps[4] = tok[2]
    ps[5] = tok[3]
    ps[6] = msg

pexpect(ps, code)
    if pcheck(ps, code)
        return padv(ps)
    perr(ps, ppeek(ps, 0), "unexpected token here")
    return padv(ps)

// How deeply source may nest. The parser is recursive descent, so nesting in
// the source is depth on the compiler's own stack, and the analyzer and code
// generator walk the same tree the same way. With no limit, 10,000 nested
// parentheses ran the compiler off its stack, and it stopped with `stack
// exhausted` on a line of its own source (exit 70). test_fuzz_frontend.sh
// counts that as a bug: any input must either compile or be refused with a
// located diagnostic. The exact limit matters much less than having one.
//
// There are two limits, because the two kinds of nesting cost very different
// amounts of stack per level. An expression level is about eleven frames
// (pexpr through the seven pbinary levels, punary, ppostfix, pcall_or_primary,
// pprimary and back), and a block level is about two. On a 1 MB stack the
// compiler survives about 720 levels of the tightest expression shape (a
// nested map literal) and about 3,580 levels of nested blocks. One limit sized
// for the expensive shape would bring back the fixed indent ceiling the
// compiler dropped (test_lang.sh compiles 300 levels of nesting), so each has
// its own: 256 is about a third of the expression figure, and 512 about a
// seventh of the block one. Both at their deepest at once use about half of
// that 1 MB, and every target now starts the compiler with 8 MB.
//
// Real code is nowhere near either. In this repository the deepest bracket
// nesting is 8, the deepest indentation 8 levels, and the longest `else if`
// chain 31 arms.
pexpr_nest_max()
    return 256

pblock_nest_max()
    return 512

// A third limit, for a chain of operators at one precedence. `a . b . c . ...`
// leans left, so pbinary loops where it would otherwise recurse: the parser's
// own depth stays flat while the tree it builds grows a level per operator.
// The later passes walk that tree, so the depth is real. Ten thousand joins on
// one line used to exhaust the compiler's stack in check_expr.
//
// It gets its own number because a chained operator costs about one frame a
// level, where a level of nesting costs about eleven. On a 1 MB stack the
// compiler survives about 3,780 chained joins against about 720 levels of
// nested map literal. 1,024 is about a quarter of that, and about fifty times
// the longest chain in this repository, 20 in a test (the compiler's own
// longest is 11).
pchain_max()
    return 1024

// Enter one level of expression nesting: 0 to go on, 1 to refuse. On a refusal
// the counter isn't raised, and the caller has to return without recursing. The
// limit works by not making the call, because the frames it would push are the
// problem. Only the first perr is kept, so the error points at the innermost
// level the parser was willing to reach.
pnest_enter(ps)
    if ps[8] >= pexpr_nest_max()
        perr(ps, ppeek(ps, 0), "this expression nests too deeply (max " . pexpr_nest_max() . " levels)")
        return 1
    ps[8] = ps[8] + 1
    return 0

// The same for one level of block nesting: an indented body, or an `else if`
// arm, which nests in the tree without indenting in the source.
pbnest_enter(ps)
    if ps[9] >= pblock_nest_max()
        perr(ps, ppeek(ps, 0), "this block nests too deeply (max " . pblock_nest_max() . " levels)")
        return 1
    ps[9] = ps[9] + 1
    return 0

// ...and one more operator in a chain at one precedence level.
pcnest_enter(ps)
    if ps[10] >= pchain_max()
        perr(ps, ppeek(ps, 0), "this expression chains too many operators (max " . pchain_max() . ")")
        return 1
    ps[10] = ps[10] + 1
    return 0

// What a refused level hands back where an expression goes: the number 0 at the
// offending token, the same as pprimary's own fallback. Nothing reads it, since
// compile_src reports ps[3] and stops before the analyzer, but the parse has to
// finish unwinding with a tree in hand.
pnest_stub(ps)
    t = ppeek(ps, 0)
    ph = text(4)
    ph[0] = 11
    ph[1] = 0
    ph[2] = t[2]
    ph[3] = t[3]
    return ph

opsym(code)
    if code == 31
        return "||"
    if code == 30
        return "&&"
    if code == 28
        return "=="
    if code == 29
        return "!="
    if code == 24
        return "<"
    if code == 26
        return "<="
    if code == 25
        return ">"
    if code == 27
        return ">="
    if code == 41
        return "."
    if code == 13
        return "+"
    if code == 14
        return "-"
    if code == 21
        return "|"
    if code == 22
        return "^"
    if code == 15
        return "*"
    if code == 16
        return "/"
    if code == 17
        return "%"
    if code == 18
        return "<<"
    if code == 19
        return ">>"
    if code == 20
        return "&"
    if code == 32
        return "!"
    if code == 23
        return "~"
    return "?"

mklist(cap)
    lst = text(cap + 1)
    lst[0] = 0
    return lst

ladd(lst, x)
    c = lst[0]
    lst[c + 1] = x
    lst[0] = c + 1

// ladd for a list whose final size isn't known in advance. It doubles the list
// when it's full and returns it, possibly as a new list, so callers write
// `l = ladd_grow(l, x)`. A fixed generous capacity would charge every list for
// it: an 8192-entry list is 64 KB whether it ends up holding two entries or
// eight thousand, and the parser makes one per block and per function.
ladd_grow(lst, x)
    c = lst[0]
    if c + 1 >= len(lst)
        nl = mklist((len(lst) - 1) * 2)
        i = 0
        loop i < c
            ladd(nl, lget(lst, i))
            i = i + 1
        lst = nl
    ladd(lst, x)
    return lst

lcount(lst)
    return lst[0]

lget(lst, i)
    return lst[i + 1]

is_level_op(level, code)
    if level == 0
        if code == 31
            return true
        return false
    if level == 1
        if code == 30
            return true
        return false
    if level == 2
        if code == 28 || code == 29 || code == 24 || code == 26 || code == 25 || code == 27
            return true
        return false
    if level == 3
        if code == 41
            return true
        return false
    if level == 4
        if code == 13 || code == 14 || code == 21 || code == 22
            return true
        return false
    if level == 5
        if code == 15 || code == 16 || code == 17 || code == 18 || code == 19 || code == 20
            return true
        return false
    return false

// An operator over two integer literals is computed here, once, instead of
// emitting instructions that work out the same answer on every run. Unfolded,
// `60 * 60 * 24` is multiplies and overflow checks for a number the compiler
// already has. A chain associates left, so it folds all the way down to one
// literal.
//
// Folding is exact or it doesn't happen. Both operands must be within 2^30, so
// the sum, difference and product fit well inside the value range, and the
// compiler's own arithmetic can't overflow working them out. A division or
// modulo by zero is left alone so the program still stops where it should, and
// so is a shift count out of range. Anything bigger doesn't fold, which is
// slower but never wrong.
//
// `.`, `&&` and `||` aren't folded: `.` is a join, and the other two
// short-circuit, which is control flow.
fold_binary(node)
    l = node[2]
    r = node[3]
    if l[0] != 11 || r[0] != 11
        return node
    a = l[1]
    b = r[1]
    if a > 1073741824 || a < 0 - 1073741824
        return node
    if b > 1073741824 || b < 0 - 1073741824
        return node
    op = node[1]
    v = 0
    // A comparison folds to `true` or `false`, the answer the generated compare
    // would give. Folding it to 1 or 0 would give `1 == 1` a different kind
    // from `a == b`.
    isbool = 0
    if op == "+"
        v = a + b
    else if op == "-"
        v = a - b
    else if op == "*"
        v = a * b
    else if op == "/"
        if b == 0
            return node
        // Fold only a division that stays an integer. An inexact one answers a
        // float (SPEC 3.3), and the folder works in integers, so that one is
        // left for codegen.
        if a % b != 0
            return node
        v = idiv(a, b)
    else if op == "%"
        if b == 0
            return node
        v = a % b
    else if op == "&"
        v = a & b
    else if op == "|"
        v = a | b
    else if op == "^"
        v = a ^ b
    else if op == "<<"
        if b < 0 || b > 30
            return node
        v = a << b
    else if op == ">>"
        if b < 0 || b > 62
            return node
        v = a >> b
    else if op == "=="
        isbool = 1
        if a == b
            v = 1
    else if op == "!="
        isbool = 1
        if a != b
            v = 1
    else if op == "<"
        isbool = 1
        if a < b
            v = 1
    else if op == "<="
        isbool = 1
        if a <= b
            v = 1
    else if op == ">"
        isbool = 1
        if a > b
            v = 1
    else if op == ">="
        isbool = 1
        if a >= b
            v = 1
    else
        return node
    lit = text(4)
    lit[0] = 11
    lit[1] = v
    // A singleton node (kind 21) carries the payload index, and gen_expr turns
    // it into 8i+6, so 1 is `false` (14) and 2 is `true` (22).
    if isbool == 1
        lit[0] = 21
        lit[1] = v + 1
    lit[2] = node[4]
    lit[3] = node[5]
    return lit

// A chain at one precedence leans left, so this loops where it would otherwise
// recurse, and the parser's own depth stays flat. The tree still grows a level
// per operator and the later passes walk it, so the chain has its own budget
// (pchain_max), given back when the chain ends.
pbinary(ps, level)
    if level >= 6
        return punary(ps)
    left = pbinary(ps, level + 1)
    chain = 0
    loop is_level_op(level, pkind(ps, 0))
        if pcnest_enter(ps) != 0
            ps[10] = ps[10] - chain
            return pnest_stub(ps)
        chain = chain + 1
        op = padv(ps)
        right = pbinary(ps, level + 1)
        node = text(6)
        node[0] = 14
        node[1] = opsym(op[0])
        node[2] = left
        node[3] = right
        node[4] = op[2]
        node[5] = op[3]
        left = fold_binary(node)
    ps[10] = ps[10] - chain
    return left

punary(ps)
    t = ppeek(ps, 0)
    k = t[0]
    if k == 32 || k == 23 || k == 14
        // `!!!!x` and `- - - x` recurse here without going back through pexpr,
        // so this level is counted on its own.
        if pnest_enter(ps) != 0
            return pnest_stub(ps)
        op = padv(ps)
        operand = punary(ps)
        ps[8] = ps[8] - 1
        node = text(5)
        node[0] = 15
        node[1] = opsym(op[0])
        node[2] = operand
        node[3] = op[2]
        node[4] = op[3]
        return node
    return ppostfix(ps)

ppostfix(ps)
    node = pcall_or_primary(ps)
    loop pcheck(ps, 37)
        lb = padv(ps)
        idx = pexpr(ps)
        pexpect(ps, 38)
        nn = text(5)
        nn[0] = 16
        nn[1] = node
        nn[2] = idx
        nn[3] = lb[2]
        nn[4] = lb[3]
        node = nn
    return node

pcall_or_primary(ps)
    t = ppeek(ps, 0)
    t1 = ppeek(ps, 1)
    if t[0] == 4 && t1[0] == 35
        nm = padv(ps)
        padv(ps)
        // Small, and it doubles. A fixed 64 would cost 544 bytes at every call
        // site in the program, and almost every call has one or two arguments.
        args = mklist(4)
        if !pcheck(ps, 36)
            args = ladd_grow(args, pexpr(ps))
            loop pcheck(ps, 39)
                padv(ps)
                args = ladd_grow(args, pexpr(ps))
        pexpect(ps, 36)
        node = text(5)
        node[0] = 17
        node[1] = nm[1]
        node[2] = args
        node[3] = t[2]
        node[4] = t[3]
        return node
    return pprimary(ps)

// A `{}` map literal: { key: value, ... }. A key is a bare identifier or quoted
// text. Bare reads better for records, and quoted covers any JSON key
// (`{"content-type": ...}`). `{` and `}` count as brackets in the lexer, so a
// literal may span lines and its indentation doesn't matter. A trailing comma
// is allowed.
pmap(ps, t)
    padv(ps)
    keys = mklist(8)
    vals = mklist(8)
    loop true
        if pcheck(ps, 43)
            break
        kt = ppeek(ps, 0)
        if kt[0] == 6 || kt[0] == 4
            padv(ps)
        else
            perr(ps, kt, "expected a key (a name or quoted text) inside { }")
            break
        pexpect(ps, 40)
        kn = text(5)
        kn[0] = 12
        kn[1] = kt[1]
        kn[2] = kt[2]
        kn[3] = kt[3]
        keys = ladd_grow(keys, kn)
        vals = ladd_grow(vals, pexpr(ps))
        if pcheck(ps, 39)
            padv(ps)
        else
            break
    pexpect(ps, 43)
    node = text(5)
    node[0] = 19
    node[1] = keys
    node[2] = vals
    node[3] = t[2]
    node[4] = t[3]
    return node

pprimary(ps)
    t = ppeek(ps, 0)
    k = t[0]
    if k == 5
        padv(ps)
        node = text(4)
        node[0] = 11
        node[1] = t[1]
        node[2] = t[2]
        node[3] = t[3]
        return node
    if k == 50
        padv(ps)
        fv = t[1]
        node = text(6)
        node[0] = 18
        node[1] = fv[0]
        node[2] = fv[1]
        node[3] = t[2]
        node[4] = t[3]
        // node[1] is the mantissa (an integer, or a region of digits for a
        // long literal) and node[2] its decimal exponent. The literal is
        // node[1] * 10^node[2], and dec_to_bits makes the double. node[5] is
        // this literal's slot in the float pool, filled in by prepass_literals.
        // -1 means the prepass didn't reach it, and a reader then builds the
        // value inline.
        node[5] = 0 - 1
        return node
    if k == 7
        padv(ps)
        node = text(4)
        node[0] = 11
        node[1] = t[1]
        node[2] = t[2]
        node[3] = t[3]
        return node
    if k == 51
        padv(ps)
        node = text(4)
        node[0] = 21
        node[1] = t[1]
        node[2] = t[2]
        node[3] = t[3]
        return node
    if k == 6
        padv(ps)
        // Slot 4 is where prepass_literals records this literal's offset in the
        // pool (see lit_lookup).
        node = text(5)
        node[0] = 12
        node[1] = t[1]
        node[2] = t[2]
        node[3] = t[3]
        return node
    if k == 4
        padv(ps)
        node = text(4)
        node[0] = 13
        node[1] = t[1]
        node[2] = t[2]
        node[3] = t[3]
        return node
    if k == 35
        padv(ps)
        e = pexpr(ps)
        pexpect(ps, 36)
        return e
    if k == 42
        return pmap(ps, t)
    perr(ps, t, "expected a value (a number, text, name, '(' or '{') here")
    padv(ps)
    ph = text(4)
    ph[0] = 11
    ph[1] = 0
    ph[2] = t[2]
    ph[3] = t[3]
    return ph

pexpr(ps)
    if pnest_enter(ps) != 0
        return pnest_stub(ps)
    e = pbinary(ps, 0)
    ps[8] = ps[8] - 1
    return e

// pblock(ps, hdr, what): the indented body under a header. `hdr` is the
// header's first token and `what` names it, so a header with nothing indented
// under it (SPEC 2.2) is reported at the header. Reporting it at the next
// line's first token would blame a line that's fine.
pblock(ps, hdr, what)
    if pbnest_enter(ps) != 0
        return mklist(1)
    if !pcheck(ps, 2)
        perr(ps, hdr, "expected an indented block after this " . what)
    pexpect(ps, 2)
    // The statements of the body. The list starts small and grows, so a body
    // of any length fits.
    stmts = mklist(8)
    loop !pcheck(ps, 3)
        if pcheck(ps, 0)
            break
        if ps[3] != 0
            break
        stmts = ladd_grow(stmts, pstatement(ps, 0))
    padv(ps)
    ps[9] = ps[9] - 1
    return stmts

pif(ps)
    t = padv(ps)
    cond = pexpr(ps)
    pexpect(ps, 1)
    then = pblock(ps, t, "'if'")
    orelse = 0
    if pcheck(ps, 9)
        et = padv(ps)
        if pcheck(ps, 8)
            // `else if` nests in the tree without indenting in the source, and
            // parsing one is a recursive call here, so the chain counts against
            // the block limit too. Otherwise 10,000 arms would run check_stmt
            // off the stack in a file that never indents.
            if pbnest_enter(ps) == 0
                orelse = mklist(4)
                ladd(orelse, pif(ps))
                ps[9] = ps[9] - 1
        else
            pexpect(ps, 1)
            orelse = pblock(ps, et, "'else'")
    node = text(6)
    node[0] = 6
    node[1] = cond
    node[2] = then
    node[3] = orelse
    node[4] = t[2]
    node[5] = t[3]
    return node

ploop(ps)
    t = padv(ps)
    // The for-each form, `loop NAME in SUBJECT` (SPEC 7.2). NAME is a fresh
    // binding and SUBJECT a region whose elements it walks in order. It's
    // spotted by an identifier followed by the contextual word `in`. Anywhere
    // else `in` is the stdin builtin, always written `in(...)`, and `x in y`
    // isn't a legal expression, so this form takes no syntax from anything.
    t0 = ppeek(ps, 0)
    t1 = ppeek(ps, 1)
    if t0[0] == 4 && t1[0] == 4 && t1[1] == "in"
        nm = padv(ps)
        padv(ps)
        subj = pexpr(ps)
        pexpect(ps, 1)
        febody = pblock(ps, t, "'loop'")
        fe = text(6)
        fe[0] = 20
        fe[1] = nm[1]
        fe[2] = subj
        fe[3] = febody
        fe[4] = t[2]
        fe[5] = t[3]
        return fe
    cond = 0
    if !pcheck(ps, 1)
        cond = pexpr(ps)
    pexpect(ps, 1)
    body = pblock(ps, t, "'loop'")
    node = text(5)
    node[0] = 7
    node[1] = cond
    node[2] = body
    node[3] = t[2]
    node[4] = t[3]
    return node

preturn(ps)
    t = padv(ps)
    e = 0
    if !pcheck(ps, 1)
        e = pexpr(ps)
    pexpect(ps, 1)
    node = text(4)
    node[0] = 8
    node[1] = e
    node[2] = t[2]
    node[3] = t[3]
    return node

pfinish_function(ps, callnode, t)
    params = mklist(4)
    args = callnode[2]
    i = 0
    loop i < lcount(args)
        a = lget(args, i)
        // A definition's parameters are plain names (SPEC 8.1). Anything else
        // is a call followed by an indented block (`f(1)` with a body under
        // it). It has to be caught here to get a located error: `a[1]` of a
        // number literal is a number, and the later passes expect the
        // parameter list to hold names.
        if a[0] != 13
            perr(ps, t, "a parameter must be a name")
            params = ladd_grow(params, "")
        else
            params = ladd_grow(params, a[1])
        i = i + 1
    pexpect(ps, 1)
    body = pblock(ps, t, "definition")
    fn = text(6)
    fn[0] = 2
    fn[1] = callnode[1]
    fn[2] = params
    fn[3] = body
    fn[4] = t[2]
    fn[5] = t[3]
    return fn

pident_statement(ps, top)
    t = ppeek(ps, 0)
    // `import fs` anywhere but app.w's opening lines. Two names in a row are
    // never a statement, so this can only be a misplaced import.
    t1 = ppeek(ps, 1)
    if t[1] == "import" && t1[0] == 4
        perr(ps, t, "an import goes at the top of app.w, before any other line (SPEC 11.1)")
        return padv(ps)
    node = ppostfix(ps)
    n1 = ppeek(ps, 1)
    if pcheck(ps, 1) && n1[0] == 2
        // Only a top-level line opens a function body. Inside any block, a
        // call with a deeper line under it is either a nested function, which
        // the language doesn't have (SPEC 8.1), or an accidental indent, and
        // both backends get the same located error for it here.
        if top == 0
            perr(ps, n1, "unexpected indent (a function is defined at the top level only)")
            return padv(ps)
        // A definition header has the shape of a call, `f(a, b)`, and only the
        // indent after it tells the two apart. A bare name or a subscript with
        // a block under it is neither, and pfinish_function would read the
        // node's line number as its argument list, so say what a definition
        // looks like instead.
        if node[0] != 17
            perr(ps, t, "a definition needs a name and its parameters, as in 'f(a, b)'")
            return padv(ps)
        return pfinish_function(ps, node, t)
    if pcheck(ps, 33)
        // The target is a name or an element (SPEC 4). `f(1) = 3` has to stop
        // here, since codegen has no way to store into a call.
        if node[0] == 17
            perr(ps, t, "cannot assign to a call, only to a name or an element like p[i]")
            return padv(ps)
        padv(ps)
        e = pexpr(ps)
        pexpect(ps, 1)
        a = text(5)
        a[0] = 5
        a[1] = node
        a[2] = e
        a[3] = t[2]
        a[4] = t[3]
        return a
    if node[0] == 17 && pcheck(ps, 1)
        padv(ps)
        es = text(4)
        es[0] = 10
        es[1] = node
        es[2] = t[2]
        es[3] = t[3]
        return es
    // Anything else is an error (SPEC 4.2): something after a call on the same
    // line, or a bare expression. Returning the bare node would let the next
    // token start a statement of its own, and codegen has no case for a bare
    // node.
    if node[0] == 17
        perr(ps, ppeek(ps, 0), "expected the end of the line (one statement per line)")
    else
        perr(ps, t, "a bare expression is not a statement (only a call can stand alone on a line)")
    return padv(ps)

pstatement(ps, top)
    t = ppeek(ps, 0)
    k = t[0]
    if k == 8
        return pif(ps)
    if k == 10
        return ploop(ps)
    if k == 11
        return preturn(ps)
    if k == 12
        padv(ps)
        pexpect(ps, 1)
        br = text(3)
        br[0] = 9
        br[1] = t[2]
        br[2] = t[3]
        return br
    if k == 4
        return pident_statement(ps, top)
    // A deeper indent anywhere but under a header (SPEC 2.2).
    if k == 2
        perr(ps, t, "unexpected indent")
        return padv(ps)
    perr(ps, t, "expected a statement (an assignment, call, if, loop, return, or break)")
    return padv(ps)

// Every list the parser fills from the source grows: a hook may name any number
// of functions, and a program may hold any number of imports and top-level
// items. A fixed capacity would be a limit the language never states, reached
// by faulting inside the compiler.
phook(ps)
    t = ppeek(ps, 0)
    targets = mklist(4)
    loop
        nm = pexpect(ps, 4)
        pexpect(ps, 40)
        kd = pexpect(ps, 4)
        // Only "before" and "after". The analyzer treats any kind but "after"
        // as a before-hook and codegen treats any kind but "before" as an
        // after-hook, so `f:befor` would be checked as one and run as the other.
        if kd[0] == 4 && kd[1] != "before" && kd[1] != "after"
            perr(ps, kd, "a contract hook is ':before' or ':after', not ':" . kd[1] . "'")
        tgt = text(2)
        tgt[0] = nm[1]
        tgt[1] = kd[1]
        targets = ladd_grow(targets, tgt)
        if pcheck(ps, 39)
            padv(ps)
        else
            break
    pexpect(ps, 1)
    body = pblock(ps, t, "hook")
    hk = text(5)
    hk[0] = 3
    hk[1] = targets
    hk[2] = body
    hk[3] = t[2]
    hk[4] = t[3]
    return hk

ptop_item(ps)
    t = ppeek(ps, 0)
    k = t[0]
    if k == 8 || k == 10 || k == 11 || k == 12
        return pstatement(ps, 1)
    if k == 4
        t1 = ppeek(ps, 1)
        if t1[0] == 40
            return phook(ps)
        return pident_statement(ps, 1)
    if k == 2
        perr(ps, t, "unexpected indent")
        return padv(ps)
    perr(ps, t, "expected a definition or statement at the top level")
    return padv(ps)

pprogram(ps)
    imps = mklist(4)
    loop
        t = ppeek(ps, 0)
        t1 = ppeek(ps, 1)
        if t[0] == 4 && t[1] == "import" && t1[0] == 4
            padv(ps)
            nm = padv(ps)
            pexpect(ps, 1)
            imp = text(4)
            imp[0] = 1
            imp[1] = nm[1]
            imp[2] = t[2]
            imp[3] = t[3]
            imps = ladd_grow(imps, imp)
        else
            break
    items = mklist(8192)
    loop !pcheck(ps, 0)
        if ps[3] != 0
            break
        items = ladd_grow(items, ptop_item(ps))
    prog = text(2)
    prog[0] = imps
    prog[1] = items
    return prog

// Count the digits, then write them straight into the result. Codegen calls
// this hundreds of thousands of times (every frame offset, immediate and label
// number), and a scratch buffer on every call made it the biggest allocator in
// the compiler, about 72 MB of a 237 MB compile.
num_to_str(n)
    if n == 0
        return "0"
    cnt = 0
    m = n
    loop m > 0
        cnt = cnt + 1
        m = idiv(m, 10)
    res = text(cnt)
    m = n
    i = cnt - 1
    loop i >= 0
        res[i] = 48 + (m % 10)
        m = idiv(m, 10)
        i = i - 1
    return res

str_repr(elems)
    res = "\""
    i = 0
    loop i < len(elems)
        c = elems[i]
        if c >= 32 && c < 127
            ch = text(1)
            ch[0] = c
            res = res . ch
        else
            res = res . "\\" . c
        i = i + 1
    res = res . "\""
    return res

// s[0] = parent, s[1] = count, s[2] = the names, grown on demand. A scope is made
// per function and per block, so a fixed reservation here would be paid
// thousands of times over. A scope holds any number of names.
mkscope(parent)
    s = text(6)
    s[0] = parent
    s[1] = 0
    s[2] = mklist(8)
    // s[3]: whether each name was ever read. s[4]: the node that bound it, so
    // an unused local is reported where it was written.
    s[3] = mklist(8)
    s[4] = mklist(8)
    // s[5]: each name's position in s[2], so finding one is a hash. Walking the
    // list made a function with 20,000 locals quadratic to check.
    s[5] = {}
    return s

// Declare `name` in scope `s`. Returns 1.
scope_declare(an, node, s, name)
    return scope_declare_r(an, node, s, name, 0)

// `used` pre-marks a name as read, and check_hook declares a hook's parameters
// and `result` that way. Parameters and the for-each variable may go unread in
// any case, since scope_check_unused only looks at names bound by an
// assignment: a function that ignores an argument and a loop that only wants
// the iteration are both ordinary.
scope_declare_r(an, node, s, name, used)
    c = s[1]
    s[2] = ladd_grow(s[2], name)
    s[3] = ladd_grow(s[3], used)
    s[4] = ladd_grow(s[4], node)
    s[1] = c + 1
    // A name declared twice in one scope is found at its first position, as a
    // walk of the list would find it.
    ix = s[5]
    if !has(ix, name)
        ix[name] = c
    return 1

// Mark `name` read in whichever scope holds it.
scope_mark_read(s, name)
    cur = s
    loop cur != 0
        if has(cur[5], name)
            cur[3][cur[5][name] + 1] = 1
            return 0
        cur = cur[0]
    return 0

// ---- definite assignment (SPEC 5.1) ----
//
// A local is bound by its first assignment anywhere in the function, but it may
// only be read where every path reaching the read has assigned it. Without this
// rule, `x = 1` inside an `if` and then `out(x)` would read whatever the stack
// slot held. That's worse than a wrong number: the static kind (SPEC 3.6)
// trusts the assignment it can see, so the run-time tag test is skipped, and a
// stale integer would be dereferenced as a region. Ruling out an unchecked
// memory access from ordinary source is what this language is for, so the read
// is a compile error.
//
// The set is a flat region indexed by position in the function's root scope,
// because every local lives there: check_stmt declares a new name in
// scope_root, and the only name bound anywhere else is a for-each variable,
// which the loop always assigns. So a name that isn't in the root scope is
// always assigned, which is the answer da_index (-1) and da_ready give it. The
// set starts at 256 slots and da_mark grows it. A slot past a set's end reads
// as unassigned, so a copy taken before the growth still joins correctly.
da_new()
    return text(256)

da_copy(d)
    return copy(d, 0, len(d))

// Keep only what both arms assign: the join after an if/else. It changes and
// returns `a`, since the caller is done with it either way.
da_join(a, b)
    i = 0
    loop i < len(a)
        if i >= len(b) || b[i] == 0
            a[i] = 0
        i = i + 1
    return a

da_index(root, name)
    if !has(root[5], name)
        return 0 - 1
    return root[5][name]

da_mark(an, name)
    if an[24] == 0
        return 0
    ix = da_index(an[25], name)
    if ix >= 0
        d = an[24]
        if ix >= len(d)
            n = len(d) * 2
            if n <= ix
                n = ix + 1
            g = text(n)
            i = 0
            loop i < len(d)
                g[i] = d[i]
                i = i + 1
            d = g
            an[24] = d
        d[ix] = 1
    return 0

// Is this name readable here? Names outside the root scope (for-each variables)
// and everything checked outside a body are assigned by construction.
da_ready(an, name)
    if an[24] == 0
        return true
    ix = da_index(an[25], name)
    if ix < 0
        return true
    d = an[24]
    if ix < len(d) && d[ix] == 1
        return true
    return false

// A local that's assigned and never read is a mistake, and it's the one a
// single assignment operator can't catch at the write: `totl = 0` for
// `total = 0` binds a name nothing looks at. It's reported at the binding,
// where the typo is (SPEC 5).
//
// Only when the value is call-free, though. `junk = text(1000)` is there for
// the allocation and not the name, and a call is the only expression with a
// side effect (SPEC 4.2), so throwing away a call's result is a choice and
// throwing away a literal or arithmetic is a mistake. That's why this can be an
// error without a `_name` convention to get around it.
scope_check_unused(an, s)
    if an[0] != 0
        return 0
    names = s[2]
    flags = s[3]
    nodes = s[4]
    c = s[1]
    i = 0
    loop i < c
        if lget(flags, i) == 0
            nd = lget(nodes, i)
            if nd[0] == 4 && expr_has_call(nd[2]) == 0
                aerr(an, nd, "'" . lget(names, i) . "' is assigned but never read")
                return 0
        i = i + 1
    return 0

// The kind of node that bound `name` in the nearest scope holding it, or 0. A
// hook's parameters and `result` are bound by the hook node itself (kind 3).
scope_binder(s, name)
    cur = s
    loop cur != 0
        if has(cur[5], name)
            return lget(cur[4], cur[5][name])[0]
        cur = cur[0]
    return 0

scope_has_local(s, name)
    return has(s[5], name)

// The function's own scope: the outermost one, since check_function and
// check_hook start a fresh mkscope(0) and blocks nest under it.
scope_root(s)
    cur = s
    loop cur[0] != 0
        cur = cur[0]
    return cur

scope_resolve(s, name)
    cur = s
    loop cur != 0
        if scope_has_local(cur, name)
            return true
        cur = cur[0]
    return false

node_cl(n)
    k = n[0]
    if k == 20
        return n[5]
    if k == 14 || k == 6 || k == 2
        return n[5]
    if k == 15 || k == 16 || k == 17 || k == 4 || k == 5 || k == 7 || k == 3 || k == 18 || k == 19
        return n[4]
    if k == 11 || k == 12 || k == 13 || k == 8 || k == 10 || k == 1 || k == 21
        return n[3]
    if k == 9
        return n[2]
    return 0

aerr(an, n, msg)
    if an[0] != 0
        return 0
    an[0] = 1
    err(srcloc(an[21], an[5], node_ln(n)) . ":" . node_cl(n) . ": " . msg)

// A condition must be true or false (SPEC 3.2). Where the analyzer can prove the
// value is a number, a region, a map or what find() answers, that's a compile
// error that says which comparison to make, as `loop ... in` does for a number.
// Anything else that isn't a boolean faults at run time in rt_condfault: what
// the analyzer can't prove (a parameter, what one of the program's functions
// returns), and null and none even when written out, because SPEC 3.8 and 8.2
// have them fault there.
cond_req(an, e)
    if an[0] != 0
        return 0
    ck = kind_of(an, e)
    if ck == 0
        aerr(an, e, "a condition must be true or false, not a number; compare it, as in 'x != 0'")
        return 0
    t = nonbool_tail(an, e, ck)
    if len(t) > 0
        aerr(an, e, "a condition must be true or false" . t)
    return 0

// What a contract hook answers is a condition as well (SPEC 8.2): `true` passes
// and `false` fails. Where the analyzer can prove the answer is something else,
// as cond_req can, it says what to write. Most often that's a hook written
// before #204, when 0 failed a contract and 1 passed it. The rest (a parameter,
// a call to one of the program's functions, null, none) faults at run time
// through the same test `if` uses.
hook_req(an, e)
    if an[0] != 0
        return 0
    ck = kind_of(an, e)
    if ck == 0
        aerr(an, e, "a contract hook answers true or false, not a number: 'return false' fails the contract, and 'return true' passes it")
        return 0
    t = nonbool_tail(an, e, ck)
    if len(t) > 0
        aerr(an, e, "a contract hook answers true or false" . t)
    return 0

// The rest of the message for a condition or a hook answer that the analyzer
// can see isn't true or false: what it is, and what to write instead. "" when
// it can't tell. A number is left to the two callers, which word the message
// for where it was written.
//
// kind_of's 3 is a map (a float is 0, a number). Its 1 is any region, and
// fine_of says which are text, since kind() calls array(n) an `array` and
// bytes(n) `bytes`. find answers a number or none (SPEC 9) and neither is a
// condition, so a call to it is enough to know.
nonbool_tail(an, e, ck)
    if fine_of(an, e) == 41
        return ", not text; test it, as in 'len(x) != 0'"
    if ck == 1
        return ", not a region; test it, as in 'len(x) != 0'"
    if ck == 3
        return ", not a map; test it, as in 'has(x, k)' or 'len(x) != 0'"
    if e[0] == 17 && e[1] == "find" && func_lookup(an, "find") == 0
        return ", and find() answers a number or none; compare it, as in 'find(s, c) != none'"
    return ""

// an[1] keeps the functions in definition order (the unused-function report
// walks it), and an[13] holds the same entries keyed by name. This is called
// once per call site and once per definition, and a linear scan would make the
// analyzer quadratic in the number of functions. Callers test the result
// against 0, so a miss becomes 0 here.
func_lookup(an, name)
    fidx = an[13]
    if fidx == 0
        return 0
    if !has(fidx, name)
        return 0
    return fidx[name]

mf_lookup(an, name)
    mf = an[2]
    i = 0
    loop i < lcount(mf)
        e = lget(mf, i)
        if e[0] == name
            return e
        i = i + 1
    return 0

call_kind(name)
    // The two OS-store primitives answer a region where the OS keeps the store
    // behind an API and `none` where it keeps it in a file (SPEC 12.5), so
    // the compiler can't call either a region.
    if name == "cacerts" || name == "nameservers"
        return 2
    if name == "keys"
        return 1
    // A predicate answers a boolean (SPEC 3.8), which is a singleton, 4 in this
    // lattice. Calling it a number would let a diagnostic accept arithmetic on
    // it.
    if name == "has"
        return 4
    if name == "len"
        return 0
    if name == "bytes"
        return 1
    if name == "array"
        return 1
    if name == "text"
        return 1
    if name == "copy"
        return 1
    if name == "ended"
        return 4
    if name == "write"
        return 4
    if name == "append"
        return 4
    if name == "rename"
        return 4
    if name == "args"
        return 1
    if name == "kind"
        return 1
    if name == "char"
        return 1
    if name == "decode"
        return 1
    if name == "encode"
        return 1
    if name == "split"
        return 1
    if name == "pad"
        return 1
    if name == "round"
        return 0
    if name == "now"
        return 0
    if name == "random"
        return 0
    if name == "env"
        return 2
    // `number`, `find` and `env` each answer a value or `none` (SPEC 9), so the
    // compiler can't count on the kind any of them usually gives (cg_call_kind
    // says what claiming otherwise cost). `find` was an integer while a miss was
    // -1. A miss is `none` now, so its answer is unknown and pays for a tag test.
    if name == "find"
        return 2
    if name == "sort"
        return 1
    return 2

kind_name(k)
    if k == 0
        return "number"
    if k == 1
        return "region"
    if k == 3
        return "map"
    if k == 4
        return "true/false/null/none value"
    return "value"

// The kind a local can be counted on to hold. kind_of below reads an expression's
// own shape, so `len(3)` is a compile error, and this table makes `x = 3`
// followed by `len(x)` one too.
//
// The rule is the simplest one that can't be wrong: a local's kind is known when
// every assignment to it in the function agrees, and unknown otherwise. That
// needs no joins at branches and no fixpoint around a loop. One walk of the body
// collects every assignment, and a name whose assignments disagree is unknown.
// Definite assignment (SPEC 5.1) makes it sound: a read is only accepted where
// the name has been assigned, so every value a read can see came from an
// assignment this walk saw.
//
// Some names are struck out. A parameter holds whatever the caller passed, so in
// `f(a)` a later `a = 3` mustn't make `a` a number at a read above that line.
// Parameters are struck out after the walk, and so is `result` in an :after
// hook, for the same reason. A for-each variable is an element of a region, so
// kt_scan strikes it out too.
// The table maps a name to what its assignments say, so a lookup is a hash.
kt_new()
    return {}

// 9 means "the assignments disagree", which is unknown and stays unknown. The
// table holds fine_of's answers, and two that differ but share a kind_of answer
// (text and an array, say) still agree on that.
kt_note(kt, name, k)
    if !has(kt, name)
        kt[name] = k
        return kt
    old = kt[name]
    if old != k
        if kt_base(old) == kt_base(k)
            kt[name] = kt_base(k)
        else
            kt[name] = 9
    return kt

// Strike a name out: it holds something no assignment in this body decided.
kt_strike(kt, name)
    kt[name] = 9
    return kt

kt_get(kt, name)
    if kt == 0
        return 2
    if !has(kt, name)
        return 2
    k = kt[name]
    if k == 9
        return 2
    return kt_base(k)

// The same lookup, keeping fine_of's answer.
kt_fine(kt, name)
    if kt == 0
        return 2
    if !has(kt, name)
        return 2
    k = kt[name]
    if k == 9
        return 2
    return k

// kind_of's answer, split a little finer where a condition's message can use
// it (nonbool_tail): 41 is text, which kind_of calls 1 with every other region.
// kt_base takes it back to what kind_of says.
fine_of(an, e)
    k = e[0]
    if k == 12 || (k == 14 && e[1] == ".")
        return 41
    if k == 17 && e[1] == "text" && func_lookup(an, "text") == 0
        return 41
    if k == 13
        return kt_fine(an[26], e[1])
    return kind_of(an, e)

kt_base(k)
    if k == 41
        return 1
    return k

// Every assignment in a body, including the ones inside branches and loops.
// Statement kinds as lp_scan reads them: 4 a declaration and 5 an assignment
// (both carry the value in s[2]), 6 if/else, 7 loop, 20 loop-in.
kt_scan(an, kt, stmts)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 4
            kt = kt_note(kt, s[1], fine_of(an, s[2]))
        else if k == 5
            t = s[1]
            if t[0] == 13
                kt = kt_note(kt, t[1], fine_of(an, s[2]))
        else if k == 6
            kt = kt_scan(an, kt, s[2])
            if s[3] != 0
                kt = kt_scan(an, kt, s[3])
        else if k == 7
            kt = kt_scan(an, kt, s[2])
        else if k == 20
            // The binding holds whatever element it's handed, so it's struck
            // out. Leaving it out of the table would let a local of the same
            // name after the loop (SPEC 7.2 allows one) lend the binding its
            // kind: a later `k = 0` would stop `m[k]` inside
            // `loop k in keys(m)` from building.
            kt = kt_strike(kt, s[1])
            kt = kt_scan(an, kt, s[3])
        i = i + 1
    return kt

// Build the table for one body. an[26] is left 0 for the duration, so the walk
// reads expression shapes only and cannot depend on its own half-built answers.
kt_build(an, stmts, params, hasresult)
    an[26] = 0
    kt = kt_scan(an, kt_new(), stmts)
    i = 0
    loop i < lcount(params)
        kt = kt_strike(kt, lget(params, i))
        i = i + 1
    if hasresult == 1
        kt = kt_strike(kt, "result")
    an[26] = kt
    return 0

// Source text on its way into a diagnostic, made safe to print (SPEC 9.1).
//
// `out` prints a word-backed region as text when every element is a visible
// character, and as a list of numbers when one is a control character, since
// [0, 0, 0] tells you more than three invisible NULs. That's right for data and
// wrong for a message: a diagnostic quoting a string literal with a NUL in it
// would print the whole line, file and line number included, as a list of code
// points. So a control character other than tab, newline and carriage return
// becomes `?`. The quotation shows which name was written, and a name with a
// control character in it is where the reader most needs the rest of the
// sentence.
safe_quote(s)
    n = len(s)
    r = text(n)
    i = 0
    loop i < n
        c = s[i]
        if c < 32 && c != 9 && c != 10 && c != 13
            r[i] = 63
        else
            r[i] = c
        i = i + 1
    return r

kind_of(an, e)
    k = e[0]
    if k == 13
        return kt_get(an[26], e[1])
    if k == 21
        return 4
    if k == 19
        return 3
    if k == 11
        return 0
    if k == 18
        return 0
    if k == 12
        return 1
    if k == 15
        // `!` answers a boolean whatever it was handed. `-` and `~` answer a
        // number, and a region operand under either is caught where they're
        // checked.
        if e[1] == "!"
            return 4
        return 0
    if k == 14
        if e[1] == "."
            return 1
        // The binary operators are the join, the numeric ones, the comparisons
        // and && and ||, so whatever is left answers a boolean. Calling it a
        // number would let `out(1 + (a == b))` compile and fault at run time,
        // while `1 + true` is a located compile error. This is the analyzer's
        // copy of cg_arith_kind.
        if is_numeric_op(e[1])
            return 0
        return 4
    if k == 17
        nm = e[1]
        if nm == "copy" && lcount(e[2]) > 0
            return kind_of(an, lget(e[2], 0))
        if func_lookup(an, nm) != 0
            return 2
        return call_kind(nm)
    return 2

is_numeric_op(op)
    if op == "+"
        return true
    if op == "-"
        return true
    if op == "*"
        return true
    if op == "/"
        return true
    if op == "%"
        return true
    if op == "&"
        return true
    if op == "|"
        return true
    if op == "^"
        return true
    if op == "<<"
        return true
    if op == ">>"
        return true
    return false

is_order_op(op)
    if op == "<"
        return true
    if op == "<="
        return true
    if op == ">"
        return true
    if op == ">="
        return true
    return false

builtin_arity(name)
    if name == "keys"
        return 1
    if name == "has"
        return 2
    if name == "out"
        return 1
    if name == "err"
        return 1
    if name == "in"
        return 0
    if name == "ended"
        return 0
    if name == "len"
        return 1
    if name == "bytes"
        return 1
    if name == "array"
        return 1
    if name == "text"
        return 1
    if name == "copy"
        return 1
    if name == "args"
        return 0
    // kind(x) names one of the eight observable kinds. A comparison against a
    // literal is the only spelling of a kind test, and gen_kind_test folds it
    // into the tag arithmetic it describes.
    if name == "kind"
        return 1
    if name == "round"
        return 1
    if name == "now"
        return 0
    if name == "random"
        return 0
    if name == "env"
        return 1
    if name == "number"
        return 1
    if name == "find"
        return 2
    if name == "sort"
        return 1
    return 0 - 1

is_module_func(name)
    if name == "char"
        return true
    if name == "decode"
        return true
    if name == "encode"
        return true
    if name == "split"
        return true
    if name == "pad"
        return true
    if name == "parse"
        return true
    if name == "stringify"
        return true
    if name == "read"
        return true
    if name == "write"
        return true
    if name == "append"
        return true
    if name == "rename"
        return true
    if name == "dir"
        return true
    if name == "get"
        return true
    if name == "post"
        return true
    if name == "put"
        return true
    if name == "delete"
        return true
    if name == "head"
        return true
    if name == "asmput"
        return true
    if name == "asmtake"
        return true
    if name == "writex"
        return true
    if name == "exec"
        return true
    if name == "mark"
        return true
    if name == "reset"
        return true
    if name == "arch"
        return true
    if name == "os"
        return true
    if name == "image"
        return true
    if name == "cacerts"
        return true
    if name == "nameservers"
        return true
    if name == "connect"
        return true
    if name == "udp"
        return true
    if name == "timeout"
        return true
    if name == "send"
        return true
    if name == "recv"
        return true
    if name == "close"
        return true
    return false

// Which module a module function belongs to. check_call uses it to bring the
// module in on first use (SPEC 12). Anything not listed here is sys's.
module_of(name)
    if name == "parse" || name == "stringify"
        return "json"
    if name == "read" || name == "write" || name == "append" || name == "rename" || name == "dir"
        return "fs"
    if name == "get" || name == "post" || name == "put" || name == "delete" || name == "head"
        return "net"
    if name == "char" || name == "decode" || name == "encode" || name == "split" || name == "pad"
        return "txt"
    return "sys"

is_net_func(name)
    if name == "get"
        return 1
    if name == "post"
        return 1
    if name == "put"
        return 1
    if name == "delete"
        return 1
    if name == "head"
        return 1
    return 0

is_fs_func(name)
    if name == "read"
        return true
    if name == "write"
        return true
    if name == "append"
        return true
    if name == "rename"
        return true
    if name == "dir"
        return true
    return false

is_text_func(name)
    if name == "char"
        return true
    if name == "decode"
        return true
    if name == "encode"
        return true
    if name == "split"
        return true
    if name == "pad"
        return true
    return false

is_json_func(name)
    if name == "parse"
        return true
    if name == "stringify"
        return true
    return false

// The six socket verbs of sys: the transport the net library is written on.
is_sock_func(name)
    if name == "connect" || name == "udp" || name == "timeout"
        return true
    return name == "send" || name == "recv" || name == "close"

params_equal(p1, p2)
    if lcount(p1) != lcount(p2)
        return false
    i = 0
    loop i < lcount(p1)
        if lget(p1, i) != lget(p2, i)
            return false
        i = i + 1
    return true

// A module's functions are added once, however many times the module is
// imported or reached, and the table grows.
mf_add(an, name, arity)
    if mf_lookup(an, name) != 0
        return 0
    e = text(2)
    e[0] = name
    e[1] = arity
    an[2] = ladd_grow(an[2], e)

// The closed list of built-in module names (SPEC 11.1). Importing a directory
// isn't part of the language (SPEC 15 has it as a possible future direction),
// so any other name is a mistake, and a compile error at the `import` line.
// Ignoring it would let a typo like `import ent` compile.
is_module_name(modname)
    if modname == "fs"
        return true
    if modname == "net"
        return true
    if modname == "json"
        return true
    if modname == "sys"
        return true
    if modname == "txt"
        return true
    return false

add_module_funcs(an, modname)
    if modname == "fs"
        mf_add(an, "read", 1)
        mf_add(an, "write", 2)
        mf_add(an, "append", 2)
        mf_add(an, "rename", 2)
        mf_add(an, "dir", 1)
    else if modname == "net"
        mf_add(an, "get", 1)
        mf_add(an, "post", 2)
        mf_add(an, "put", 2)
        mf_add(an, "delete", 1)
        mf_add(an, "head", 1)
    else if modname == "json"
        mf_add(an, "parse", 1)
        mf_add(an, "stringify", 1)
    else if modname == "txt"
        // txt's five functions (SPEC 12.4). They're in a module so the list of
        // builtins you have to know to read any program stays at 20 names,
        // under the ceiling of 25 (SPEC 12).
        mf_add(an, "char", 1)
        mf_add(an, "decode", 1)
        mf_add(an, "encode", 1)
        mf_add(an, "split", 2)
        mf_add(an, "pad", 3)
    else if modname == "sys"
        mf_add(an, "asmput", 1)
        mf_add(an, "asmtake", 0)
        mf_add(an, "writex", 2)
        mf_add(an, "exec", 2)
        mf_add(an, "mark", 0)
        mf_add(an, "reset", 1)
        mf_add(an, "arch", 0)
        mf_add(an, "os", 0)
        mf_add(an, "image", 0)
        mf_add(an, "cacerts", 0)
        mf_add(an, "nameservers", 0)
        mf_add(an, "connect", 2)
        mf_add(an, "udp", 2)
        mf_add(an, "timeout", 2)
        mf_add(an, "send", 2)
        mf_add(an, "recv", 2)
        mf_add(an, "close", 1)

arity_chk(an, call, expected)
    args = call[2]
    if lcount(args) != expected
        aerr(an, call, "'" . call[1] . "' expects " . expected . " argument(s), but got " . lcount(args))

check_call(an, call, scope)
    if an[0] != 0
        return 0
    args = call[2]
    i = 0
    loop i < lcount(args)
        check_expr(an, lget(args, i), scope)
        i = i + 1
    if an[0] != 0
        return 0
    name = call[1]
    argc = lcount(args)
    ent = func_lookup(an, name)
    if ent != 0
        // A call from the top level or a hook body uses the function. A call
        // from a function's body is an edge that counts only if that function
        // is reachable itself, so a function that only calls itself, or two
        // that only call each other, are still unused.
        caller = an[32]
        if caller == 0
            ent[2] = 1
        else
            caller[4] = ladd_grow(caller[4], ent)
            if caller[0] != name
                ent[5] = 1
        arity_chk(an, call, lcount(ent[1]))
        return 0
    ba = builtin_arity(name)
    if ba != 0 - 1
        // `copy` is the one builtin with more than one shape: copy(p) for a
        // whole region or map, and copy(p, start) or copy(p, start, end) for
        // part of a region. Every other builtin has one arity, and the general
        // check runs for it.
        if name == "copy"
            if argc < 1 || argc > 3
                aerr(an, call, "'copy' takes a region or map, a region and a start, or a region with a start and an end")
                return 0
        else
            arity_chk(an, call, ba)
        if an[0] != 0
            return 0
        // round() needs the float runtime (it unboxes a float), so the program
        // is marked as using floats and that runtime is emitted. number() needs
        // it from the other direction: `1.5` and `1e3` are numbers it has to be
        // able to answer with, and it builds them with rt_f10scale.
        //
        // Always, so number("1.5") gives the same answer whether or not the
        // rest of the program uses a float.
        if name == "round" || name == "number"
            an[6] = 1
        // in()/ended() are the only readers of stdin, so a program that calls
        // neither gets no input buffers and no refill path.
        if name == "in" || name == "ended"
            an[8] = 1
        // random() is a system call on every target, and the Windows OS layer
        // maps getrandom only for a program that needs it (net, or this).
        if name == "random"
            an[14] = 1
        if name == "now"
            an[15] = 1
        // args() hands back an array, and an array only renders as ["a","b"]
        // when the map/JSON runtime is there, which is why split sets this too.
        // an[18] gates the argument runtime itself: on Windows that's
        // GetCommandLineA and the tokenizer over it, which a program that never
        // asks for its arguments shouldn't import.
        if name == "args"
            an[11] = 1
            an[18] = 1
        // env() walks envp. Windows has no envp, so the entry code builds one
        // from GetEnvironmentStringsA, gated on the same call.
        if name == "env"
            an[19] = 1
        // kind() answers with one of eight literals, so it costs their small
        // regions in .rodata as well as its routine, and it's gated the same way.
        if name == "kind"
            an[17] = 1
        // array, keys and has reach the map runtime, and so does any {} literal.
        if name == "array" || name == "keys" || name == "has"
            an[11] = 1
        if (name == "len" || name == "find" || name == "sort") && argc > 0
            a0 = lget(args, 0)
            if kind_of(an, a0) == 0
                aerr(an, a0, "'" . name . "' needs a region (an array or text), but got a number")
        // bytes("...") is a hex string decoded at compile time (SPEC 9), so a
        // string literal that isn't an even number of hex digits is a malformed
        // blob. Without this it would fall through to bytes(n) and fault at run
        // time with "number expected, got a region", which names the wrong
        // problem.
        if name == "bytes" && argc == 1
            hx = lget(args, 0)
            // Zero hex digits is an even number of them, and the region it
            // decodes to is the empty one bytes(0) already makes, so the
            // literal is rewritten to that count before anything reads it.
            if hx[0] == 12 && len(hx[1]) == 0
                hx[0] = 11
                hx[1] = 0
            if hx[0] == 12 && is_byte_blob(call) == false
                aerr(an, hx, "a bytes(\"...\") literal must be an even number of hex digits (it is decoded at compile time)")
        // copy takes a region or a map, so only a number is ruled out here.
        if name == "copy" && argc > 0
            a0 = lget(args, 0)
            if kind_of(an, a0) == 0
                aerr(an, a0, "'copy' needs a region (an array or text) or a map, but got a number")
        if (name == "keys" || name == "has") && argc > 0
            a0 = lget(args, 0)
            k0 = kind_of(an, a0)
            if k0 == 0 || k0 == 1
                aerr(an, a0, "'" . name . "' needs a map, but got a " . kind_name(k0))
        return 0
    me = mf_lookup(an, name)
    // A module function that hasn't been imported imports itself (SPEC 12).
    // The compiler knows which module each of these names comes from
    // (module_of), so there's no reason to make the program say it.
    //
    // Three things stay as they were. A name the program defines still wins:
    // func_lookup runs before this and returns first, so a `split` in your own
    // file is your `split`. A module is still emitted only where it's reached,
    // because the flags below are set by the call and never by the import
    // line. And `import` is still legal, as a note at the top of app.w about
    // what the program touches (SPEC 11.1).
    if me == 0 && is_module_func(name)
        add_module_funcs(an, module_of(name))
        me = mf_lookup(an, name)
    if me != 0
        // Record which module runtimes this program reaches, so only those are
        // emitted. A program's text, .bss and strings then hold only what it
        // uses: a program that never calls net has no HTTP request template in
        // it.
        if is_fs_func(name)
            an[9] = 1
            // an[27]: fs.dir on its own. On Windows a directory isn't listed
            // through a file handle at all (FindFirstFileW), so that arm of the
            // OS layer and the five kernel32 imports behind it go only into a
            // program that calls dir().
            if name == "dir"
                an[27] = 1
            // an[30]: a verb that changes the filesystem. The code that opens a
            // file for writing, and rename behind it, is emitted only for a
            // program that calls one. A program that only reads, as every net
            // program does, carries none of it.
            if name == "write" || name == "append" || name == "rename"
                an[30] = 1
        // an[16]: the program uses txt.
        if is_text_func(name)
            an[16] = 1
            // split() hands back an array, and an array only renders as
            // ["a","b"] when the map/JSON runtime is there. Without it, out() of
            // the result would print a region of pointers as characters.
            if name == "split"
                an[11] = 1
        // json.parse builds maps and can produce floats, and stringify renders
        // them, so either one brings in the map runtime and the float runtime.
        if is_json_func(name)
            an[11] = 1
            an[6] = 1
        // The sys runtime comes in pieces, and each is emitted only for a
        // program that calls it: the emit buffer (asmput, asmtake), the
        // executable writer (writex), exec, and the sockets (an[7] below). A
        // program that only opens a socket, and every net program, carries no
        // execve and no file-writing code. mark and reset need nothing extra.
        if name == "asmput" || name == "asmtake"
            an[10] = 1
        if name == "writex"
            an[29] = 1
        // sys.exec is the only caller of execve, and on Windows execve is
        // CreateProcessA, WaitForSingleObject and GetExitCodeProcess plus the
        // command-line builder. A program that never starts a process shouldn't
        // import those.
        if name == "exec"
            an[20] = 1
        // sys.cacerts is the OS trust store, and only Windows keeps it behind an
        // API instead of in a file. On that target the routine is three crypt32
        // imports, and a program that never asks for a trust anchor shouldn't
        // name crypt32.dll.
        if name == "cacerts"
            an[23] = 1
        // sys.nameservers is the same shape for the DNS resolvers: on Windows
        // the routine is an iphlpapi import, named only by a program that
        // resolves a name.
        if name == "nameservers"
            an[28] = 1
        // sys.image is the same again: on Windows the routine asks
        // GetModuleFileNameW, and only a program that calls it imports that.
        if name == "image"
            an[31] = 1
        // A socket verb needs the socket support as much as a net verb does,
        // and a program can call one without the other (a test that builds
        // dns.w on its own does). Keying this on the net verbs alone would
        // leave such a program with no sockets on Windows.
        if is_sock_func(name)
            an[7] = 1
        if is_net_func(name) == 1
            // Mark the program as using net so the flag is known before
            // codegen: the Windows OS layer, emitted partway through codegen,
            // has to decide up front whether to include the ws2_32 sockets.
            an[7] = 1
            if argc == me[1] || argc == me[1] + 1
                return 0
            aerr(an, call, "'" . name . "' called with the wrong number of arguments")
            return 0
        arity_chk(an, call, me[1])
        return 0
    if is_module_func(name)
        aerr(an, call, "'" . name . "' is defined by module '" . module_of(name) . "'; add 'import " . module_of(name) . "' to app.w")
        return 0
    aerr(an, call, "call to undefined function '" . name . "'")

check_expr(an, e, scope)
    if an[0] != 0
        return 0
    k = e[0]
    if k == 11 || k == 12 || k == 18 || k == 21
        return 0
    if k == 13
        if !scope_resolve(scope, e[1])
            aerr(an, e, "undefined variable '" . e[1] . "'")
        else if !da_ready(an, e[1])
            aerr(an, e, "'" . e[1] . "' is read here but is not assigned on every path that reaches it; assign it before the branch, or in every branch (a loop body may run zero times)")
        else
            scope_mark_read(scope, e[1])
        return 0
    if k == 15
        check_expr(an, e[2], scope)
        if an[0] != 0
            return 0
        uk = kind_of(an, e[2])
        if e[1] == "!"
            cond_req(an, e[2])
        else if uk == 1
            aerr(an, e[2], "unary '" . e[1] . "' needs a number, but got a region")
        else if uk == 3
            aerr(an, e[2], "unary '" . e[1] . "' needs a number, but got a map")
        return 0
    if k == 14
        check_expr(an, e[2], scope)
        check_expr(an, e[3], scope)
        if an[0] != 0
            return 0
        // `kind(x) == "..."` is the language's only kind test, so a misspelled
        // name is a test that can never be true, and without this it would
        // compile with no error. "list" is the likeliest one to be typed, since
        // it's what an array answered before.
        kn = kind_cmp_name(e)
        if kn != 0 && !is_kind_name(kn)
            aerr(an, e, "kind() never answers '" . safe_quote(kn) . "'; it answers number, text, bytes, array, map, boolean, null or none")
            return 0
        op = e[1]
        lk = kind_of(an, e[2])
        rk = kind_of(an, e[3])
        // `/` answers a float when the division isn't exact (SPEC 3.3), so a
        // program that divides at all needs the float runtime (boxing, promotion
        // and rendering), whether or not it writes a float literal anywhere. A
        // division that comes out exact still answers an integer without it.
        if op == "/"
            an[6] = 1
        if is_numeric_op(op)
            if lk == 1 || lk == 3 || lk == 4
                aerr(an, e[2], "left operand of '" . op . "' must be a number, but got a " . kind_name(lk))
                return 0
            if rk == 1 || rk == 3 || rk == 4
                aerr(an, e[3], "right operand of '" . op . "' must be a number, but got a " . kind_name(rk))
                return 0
        else if is_order_op(op)
            if (lk == 0 && rk == 1) || (lk == 1 && rk == 0)
                aerr(an, e, "'" . op . "' cannot compare a number with a region")
            // There's no order among true, false, null and none, so asking which
            // is smaller is an error. Equality is fine, and it's how they're
            // meant to be tested.
            else if lk == 4 || rk == 4
                aerr(an, e, "'" . op . "' has no meaning for true, false, null or none; compare them with '==' instead")
        else if op == "&&" || op == "||"
            cond_req(an, e[2])
            cond_req(an, e[3])
        return 0
    if k == 16
        check_expr(an, e[1], scope)
        check_expr(an, e[2], scope)
        if an[0] != 0
            return 0
        tk = kind_of(an, e[1])
        if tk == 0
            aerr(an, e[1], "cannot index a number (need an array, text, or map)")
            return 0
        // A map is keyed by text, and everything else by a number. Where the
        // target's kind isn't known (a parameter, a call result), neither can
        // be ruled out here, and the runtime decides.
        if tk == 3
            if kind_of(an, e[2]) == 0
                aerr(an, e[2], "a map key must be text, but got a number")
        else if tk == 1
            if kind_of(an, e[2]) == 1
                aerr(an, e[2], "index must be a number, but got a region")
        else if kind_of(an, e[2]) == 1
            // The target's kind isn't known here, so this is either a map read
            // or a mistake. Park it: if the finished program turns out to have
            // no way to build a map (an[11]), it was a mistake, and an_analyze
            // reports it then.
            an[12] = ladd_grow(an[12], e[2])
        return 0
    if k == 19
        an[11] = 1
        vals = e[2]
        i = 0
        loop i < lcount(vals)
            check_expr(an, lget(vals, i), scope)
            i = i + 1
        return 0
    if k == 17
        check_call(an, e, scope)
        return 0

// ---- "this loop cannot end" ------------------------------------------------
// The classic forgotten `i = i + 1`. It fails as a hang, with no output, no
// diagnostic and no location to go on, and it's one of the first mistakes a
// beginner makes. It can be caught at compile time because word has no
// references and no closures: a callee can't rebind a caller's local, so if the
// body never assigns the names the condition reads, the condition can't change.
// The exception is a condition that reads inside a region or a map, which a
// callee or a second name can write into (lp_check). SPEC 10.1 has the rule.

lp_name_in(names, n)
    i = 0
    loop i < lcount(names)
        if lget(names, i) == n
            return 1
        i = i + 1
    return 0

// The identifiers a condition reads. flags[0] is set for anything that makes the
// condition unpredictable: a call may answer differently each time, so a
// condition holding one (or a map literal) is never provably constant, and the
// check stays out of it.
lp_idents(e, names, flags)
    if e == 0
        return names
    k = e[0]
    if k == 13
        if lp_name_in(names, e[1]) == 0
            names = ladd_grow(names, e[1])
    else if k == 14
        names = lp_idents(e[2], names, flags)
        names = lp_idents(e[3], names, flags)
    else if k == 15
        names = lp_idents(e[2], names, flags)
    else if k == 16
        names = lp_idents(e[1], names, flags)
        names = lp_idents(e[2], names, flags)
    else if k == 17
        flags[0] = 1
    else if k == 19
        flags[0] = 1
    return names

// Does an expression mention any of `names`? It's asked of an assignment
// target, so `a[i] = x` counts as touching `a`, since the condition may read
// a[i].
lp_touches(e, names)
    if e == 0
        return 0
    k = e[0]
    if k == 13
        return lp_name_in(names, e[1])
    if k == 14
        if lp_touches(e[2], names) == 1
            return 1
        return lp_touches(e[3], names)
    if k == 15
        return lp_touches(e[2], names)
    if k == 16
        if lp_touches(e[1], names) == 1
            return 1
        return lp_touches(e[2], names)
    return 0

// Walk a body for anything that could end this loop: an assignment to a name the
// condition reads, a `return` at any depth, or a `break` at this loop's level.
// A break inside a nested loop leaves that loop, which is why `nested` is
// passed down.
lp_scan(stmts, names, res, nested)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 4
            if lp_name_in(names, s[1]) == 1
                res[0] = 1
        else if k == 5
            if lp_touches(s[1], names) == 1
                res[0] = 1
        else if k == 6
            lp_scan(s[2], names, res, nested)
            if s[3] != 0
                lp_scan(s[3], names, res, nested)
        else if k == 7
            lp_scan(s[2], names, res, 1)
        else if k == 20
            if lp_name_in(names, s[1]) == 1
                res[0] = 1
            lp_scan(s[3], names, res, 1)
        else if k == 8
            res[0] = 1
        else if k == 9
            if nested == 0
                res[0] = 1
        i = i + 1
    return 0

// Can `stmts` write into a region or a map that another name also holds? An
// index store can, because the value it stores into may be held under any
// name, and so can a call to a function the program defines, which is handed
// the same region or map its caller has (SPEC 5.1). `fns` holds the names of
// the functions that count, or is 0: the program's own, or the builtins that
// write into an argument (arg_writers). A node this doesn't know answers 1,
// the safe answer: the loop check stays quiet and a length isn't hoisted.
stmts_write_shared(stmts, fns)
    i = 0
    loop i < lcount(stmts)
        if stmt_writes_shared(lget(stmts, i), fns) == 1
            return 1
        i = i + 1
    return 0

stmt_writes_shared(s, fns)
    k = s[0]
    if k == 9
        return 0
    if k == 4
        return expr_calls_fn(s[2], fns)
    if k == 8 || k == 10
        return expr_calls_fn(s[1], fns)
    if k == 5
        if s[1][0] != 13
            return 1
        return expr_calls_fn(s[2], fns)
    if k == 6
        if expr_calls_fn(s[1], fns) == 1
            return 1
        if stmts_write_shared(s[2], fns) == 1
            return 1
        if s[3] != 0
            return stmts_write_shared(s[3], fns)
        return 0
    if k == 7
        if expr_calls_fn(s[1], fns) == 1
            return 1
        return stmts_write_shared(s[2], fns)
    if k == 20
        if expr_calls_fn(s[2], fns) == 1
            return 1
        return stmts_write_shared(s[3], fns)
    return 1

// Does `e` call a function the program defines?
expr_calls_fn(e, fns)
    if e == 0
        return 0
    k = e[0]
    if k == 11 || k == 12 || k == 13 || k == 18 || k == 21
        return 0
    if k == 14
        if expr_calls_fn(e[2], fns) == 1
            return 1
        return expr_calls_fn(e[3], fns)
    if k == 15
        return expr_calls_fn(e[2], fns)
    if k == 16
        if expr_calls_fn(e[1], fns) == 1
            return 1
        return expr_calls_fn(e[2], fns)
    if k == 17 || k == 19
        if k == 17 && fns != 0
            if has(fns, e[1])
                return 1
        args = e[2]
        i = 0
        loop i < lcount(args)
            if expr_calls_fn(lget(args, i), fns) == 1
                return 1
            i = i + 1
        return 0
    return 1

// `loop true` is the intended forever-loop and reads no names, so it's left
// alone, and so is any condition the check can't reason about. It fires only
// when the loop provably can't end.
lp_check(an, s)
    c = s[1]
    if c[0] == 11 || c[0] == 12 || c[0] == 18
        return 0
    flags = text(1)
    names = lp_idents(c, mklist(8), flags)
    if flags[0] == 1
        return 0
    if lcount(names) == 0
        return 0
    res = text(1)
    lp_scan(s[2], names, res, 0)
    if res[0] == 1
        return 0
    // A callee can't rebind a caller's local, but it can write into a region or
    // a map it's handed, and an index store can write into one through another
    // name. So can a builtin that writes into its argument, such as recv into
    // its buffer. So a condition that reads what's inside one can change after
    // all.
    if lp_reads_contents(an, c) == 1
        if stmts_write_shared(s[2], an[13]) == 1 || stmts_write_shared(s[2], arg_writers()) == 1
            return 0
    aerr(an, s, "this loop cannot end: its body never changes '" . lget(names, 0) . "', and there is no 'break' or 'return'")
    return 0

// The builtins that write into a region they're handed. Only sys.recv does:
// it reads bytes into its buffer argument. The rest of SPEC 9 and 12 either
// allocate what they answer, read their arguments, or write a file. The length
// hoist doesn't ask about these, since writing into a region can't change its
// length.
arg_writers()
    w = {}
    w["recv"] = 1
    return w

// Does the condition read what's inside a region or a map? An index does, and
// so does a name that may hold one, because `==`, `<` and `.` compare and join
// by content.
lp_reads_contents(an, e)
    k = e[0]
    if k == 16
        return 1
    if k == 13
        kd = kind_of(an, e)
        if kd == 0 || kd == 4
            return 0
        return 1
    if k == 14
        if lp_reads_contents(an, e[2]) == 1
            return 1
        return lp_reads_contents(an, e[3])
    if k == 15
        return lp_reads_contents(an, e[2])
    return 0

check_stmt(an, s, scope, loopd, ctx)
    if an[0] != 0
        return 0
    k = s[0]
    if k == 5
        check_expr(an, s[2], scope)
        // `x = expr` on a name nothing has bound yet is the binding (SPEC 5).
        // scope_resolve already says which of the two it is, so the programmer
        // doesn't have to. The node is rewritten into a declaration (kind 4) in
        // place, before any pass that reads one, so codegen only ever sees a
        // declaration.
        //
        // The new name goes into the function's scope, not the block's. Every
        // local gets one slot per function anyway (collect_locals flattens the
        // body), and `total = total + 1` inside an `if` reaching an outer
        // `total` is what anyone would expect. The right-hand side is checked
        // first, so `total = total + 1` with nothing bound is still "undefined
        // variable 'total'", pointing at the read.
        if an[0] != 0
            return 0
        t = s[1]
        if t[0] == 13
            if !scope_resolve(scope, t[1])
                s[0] = 4
                s[1] = t[1]
                if scope_declare(an, s, scope_root(scope), t[1]) == 0
                    return 0
                da_mark(an, t[1])
                return 0
            // A hook is an observer (SPEC 8.2). Its parameters and `result`
            // share the function's own slots, so writing one would change the
            // arguments the body runs with or the value the caller gets back.
            if ctx == 2 && scope_binder(scope, t[1]) == 3
                aerr(an, s, "a hook only observes, so it cannot assign to '" . t[1] . "' (SPEC 8.2)")
                return 0
            // Assigning a name that's already bound is a write, so it carries no
            // definite-assignment obligation of its own: `x = 2` after a branch
            // that may not have run is how a program fixes the problem. It
            // still counts as a read for the unused check, since a name
            // assigned in more than one place isn't checked (SPEC 5).
            scope_mark_read(scope, t[1])
            da_mark(an, t[1])
            return 0
        check_expr(an, s[1], scope)
    else if k == 6
        check_expr(an, s[1], scope)
        if an[0] != 0
            return 0
        cond_req(an, s[1])
        base = an[24]
        if base != 0
            an[24] = da_copy(base)
        sc1 = mkscope(scope)
        ta = check_block(an, s[2], sc1, loopd, ctx)
        da_then = an[24]
        if s[3] == 0
            // No else, so the path where the condition was false assigned
            // nothing, and what's definitely assigned after is what was before.
            an[24] = base
            return 0
        if base != 0
            an[24] = da_copy(base)
        sc2 = mkscope(scope)
        tb = check_block(an, s[3], sc2, loopd, ctx)
        da_else = an[24]
        an[24] = base
        if ta == 1 && tb == 1
            return 1
        if base == 0
            return 0
        // A branch that always returns or breaks adds nothing to the join,
        // since control never leaves it for the code below.
        if ta == 1
            an[24] = da_else
            return 0
        if tb == 1
            an[24] = da_then
            return 0
        an[24] = da_join(da_then, da_else)
        return 0
    else if k == 7
        if s[1] != 0
            check_expr(an, s[1], scope)
            if an[0] == 0
                lp_check(an, s)
            if an[0] == 0
                cond_req(an, s[1])
        base = an[24]
        if base != 0
            an[24] = da_copy(base)
        sc = mkscope(scope)
        check_block(an, s[2], sc, loopd + 1, ctx)
        // A loop body may run zero times, so nothing it assigns is guaranteed
        // afterwards. Proving otherwise isn't worth the pass it would take.
        an[24] = base
        return 0
    else if k == 20
        check_expr(an, s[2], scope)
        if an[0] == 0
            sjk = kind_of(an, s[2])
            if sjk == 0
                aerr(an, s[2], "'loop ... in' needs a region to iterate (an array or text), but got a number")
            else if sjk == 3
                aerr(an, s[2], "'loop ... in' cannot iterate a map directly; loop over keys(m)")
            else if scope_resolve(scope, s[1])
                // Locals are one slot per name (collect_locals), so the loop
                // variable has to be a fresh name (SPEC 7.2). Otherwise it would
                // overwrite the slot of the name that's already there.
                aerr(an, s, "'" . s[1] . "' is already defined in this scope")
            else
                fesc = mkscope(scope)
                if scope_declare(an, s, fesc, s[1]) == 1
                    base = an[24]
                    if base != 0
                        an[24] = da_copy(base)
                    check_block(an, s[3], fesc, loopd + 1, ctx)
                    an[24] = base
        return 0
    else if k == 8
        if ctx == 2 && s[1] == 0
            aerr(an, s, "a contract hook must 'return' a value (bare 'return' is not allowed in a hook)")
            return 0
        if s[1] != 0
            check_expr(an, s[1], scope)
            if ctx == 2
                hook_req(an, s[1])
            if ctx == 0 && an[0] == 0
                top_return(an, s)
        return 1
    else if k == 9
        if loopd == 0
            aerr(an, s, "'break' is only allowed inside a loop")
            return 0
        return 1
    else if k == 10
        check_call(an, s[1], scope)
    return 0

// A top-level `return n` ends the program with status `n & 255` (SPEC 8.1). A
// value the analyzer can see isn't a whole number is a compile error here.
// Otherwise the value is rewritten to `n & 255` itself, so the operator's own
// checks fault on anything that isn't a whole number, the same way on every
// target. Taking the low byte of the raw word would give text, true or a float
// an exit status made of its bits.
top_return(an, s)
    e = s[1]
    rk = kind_of(an, e)
    if rk == 1 || rk == 3 || rk == 4
        aerr(an, e, "a top-level 'return' sets the exit status, so it needs a whole number, but got a " . kind_name(rk))
        return 0
    if e[0] == 18
        aerr(an, e, "a top-level 'return' sets the exit status, so it needs a whole number, but got a float")
        return 0
    mask = text(4)
    mask[0] = 11
    mask[1] = 255
    mask[2] = node_ln(e)
    mask[3] = node_cl(e)
    amp = text(6)
    amp[0] = 14
    amp[1] = "&"
    amp[2] = e
    amp[3] = mask
    amp[4] = node_ln(e)
    amp[5] = node_cl(e)
    s[1] = amp
    return 0

// Returns 1 when every path through the block leaves it with `return` or
// `break`, so an if/else whose arms both do adds nothing to the join below it.
check_block(an, stmts, scope, loopd, ctx)
    term = 0
    i = 0
    loop i < lcount(stmts)
        if an[0] != 0
            return term
        if check_stmt(an, lget(stmts, i), scope, loopd, ctx) == 1
            term = 1
        i = i + 1
    return term

check_function(an, fn)
    if an[0] != 0
        return 0
    params = fn[2]
    scope = mkscope(0)
    i = 0
    loop i < lcount(params)
        p = lget(params, i)
        if scope_has_local(scope, p)
            aerr(an, fn, "duplicate parameter '" . p . "' in function '" . fn[1] . "'")
            return 0
        if scope_declare(an, fn, scope, p) == 0
            return 0
        i = i + 1
    if name_in_list(an[4], fn[1])
        if name_in_list(params, "result")
            aerr(an, fn, "'" . fn[1] . "' has an :after hook, so it cannot have a parameter named 'result'")
            return 0
    an[25] = scope
    an[24] = da_new()
    // Saved and restored because an_analyze checks functions from inside the
    // top level's own walk, and the top level has a table of its own.
    savekt = an[26]
    savefn = an[32]
    an[32] = func_lookup(an, fn[1])
    kt_build(an, fn[3], params, 0)
    j = 0
    loop j < lcount(params)
        scope_mark_read(scope, lget(params, j))
        da_mark(an, lget(params, j))
        j = j + 1
    check_block(an, fn[3], scope, 0, 1)
    an[24] = 0
    an[25] = 0
    an[26] = savekt
    an[32] = savefn
    scope_check_unused(an, scope)

check_hook(an, hook)
    if an[0] != 0
        return 0
    targets = hook[1]
    t0 = lget(targets, 0)
    kind0 = t0[1]
    fname = t0[0]
    ent = func_lookup(an, fname)
    params = ent[1]
    scope = mkscope(0)
    i = 0
    loop i < lcount(params)
        if scope_declare_r(an, hook, scope, lget(params, i), 1) == 0
            return 0
        i = i + 1
    if kind0 == "after"
        if scope_declare_r(an, hook, scope, "result", 1) == 0
            return 0
    an[25] = scope
    an[24] = da_new()
    savekt = an[26]
    hasres = 0
    if kind0 == "after"
        hasres = 1
    kt_build(an, hook[2], params, hasres)
    h = 0
    loop h < lcount(params)
        da_mark(an, lget(params, h))
        h = h + 1
    if kind0 == "after"
        da_mark(an, "result")
    check_block(an, hook[2], scope, 0, 2)
    an[24] = 0
    an[25] = 0
    an[26] = savekt
    scope_check_unused(an, scope)

check_contract(an, hook)
    if an[0] != 0
        return 0
    targets = hook[1]
    t0 = lget(targets, 0)
    kind0 = t0[1]
    i = 0
    loop i < lcount(targets)
        tg = lget(targets, i)
        if tg[1] != kind0
            aerr(an, hook, "a shared hook must be all ':before' or all ':after', not a mix")
            return 0
        i = i + 1
    firstparams = 0
    j = 0
    loop j < lcount(targets)
        tg = lget(targets, j)
        fname = tg[0]
        ent = func_lookup(an, fname)
        if ent == 0
            aerr(an, hook, "contract hook names undefined function '" . fname . "'")
            return 0
        // A function with a contract hook is part of the program's design, so
        // it counts as used even if nothing calls it. The unused-function check
        // is for accidental definitions (SPEC 10.1 and 15), which never carry a
        // hook.
        ent[2] = 1
        slot = 3
        if kind0 == "after"
            slot = 4
        if name_in_list(an[slot], fname)
            aerr(an, hook, "'" . fname . "' already has a ':" . kind0 . "' hook")
            return 0
        an[slot] = ladd_grow(an[slot], fname)
        if j == 0
            firstparams = ent[1]
        else
            if !params_equal(firstparams, ent[1])
                aerr(an, hook, "functions sharing a hook must have identical parameters, and " . sig_str(lget(targets, 0)[0], firstparams) . " and " . sig_str(fname, ent[1]) . " differ")
                return 0
        j = j + 1

// `name(a, b)`, quoted, for a diagnostic that has to show a parameter list.
sig_str(name, params)
    s = "'" . name . "("
    i = 0
    loop i < lcount(params)
        if i > 0
            s = s . ", "
        s = s . lget(params, i)
        i = i + 1
    return s . ")'"

// Is line `ln` of the combined source in the entry file? The line map lists
// the entry first, and each later file starts where the one before it ends.
in_entry(an, ln)
    map = an[21]
    if map == 0 || lcount(map) < 2
        return true
    return ln < lget(map, 1)[0]

// A program that calls a net verb is compiled together with the net library,
// and names are global, so a function of the program's own with the same name
// as one of the library's (sha256, x25519, ...) would be a duplicate
// definition, reported in a file the programmer doesn't have. The program's
// definition wins (SPEC 12): the library's function is renamed, and so is every
// call to it from inside the library. The new name ends in ".net", which no
// identifier can spell, so it can't collide with anything the program defines.
net_rename(an, items)
    mine = {}
    lib = {}
    n = 0
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 2
            if node_ln(it) < an[22]
                mine[it[1]] = 1
            else if has(mine, it[1])
                lib[it[1]] = it[1] . ".net"
                n = n + 1
        i = i + 1
    if n == 0
        return 0
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 2 && node_ln(it) >= an[22]
            if has(lib, it[1])
                it[1] = lib[it[1]]
            nr_block(lib, it[3])
        i = i + 1
    return 0

nr_block(lib, stmts)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 5
            nr_expr(lib, s[1])
            nr_expr(lib, s[2])
        else if k == 6
            nr_expr(lib, s[1])
            nr_block(lib, s[2])
            if s[3] != 0
                nr_block(lib, s[3])
        else if k == 7
            if s[1] != 0
                nr_expr(lib, s[1])
            nr_block(lib, s[2])
        else if k == 8
            if s[1] != 0
                nr_expr(lib, s[1])
        else if k == 10
            nr_expr(lib, s[1])
        else if k == 20
            nr_expr(lib, s[2])
            nr_block(lib, s[3])
        i = i + 1
    return 0

nr_expr(lib, e)
    k = e[0]
    if k == 17
        if has(lib, e[1])
            e[1] = lib[e[1]]
        args = e[2]
        i = 0
        loop i < lcount(args)
            nr_expr(lib, lget(args, i))
            i = i + 1
    else if k == 14
        nr_expr(lib, e[2])
        nr_expr(lib, e[3])
    else if k == 15
        nr_expr(lib, e[2])
    else if k == 16
        nr_expr(lib, e[1])
        nr_expr(lib, e[2])
    else if k == 19
        vals = e[2]
        i = 0
        loop i < lcount(vals)
            nr_expr(lib, lget(vals, i))
            i = i + 1
    return 0

collect(an, prog)
    imps = prog[0]
    i = 0
    loop i < lcount(imps)
        imp = lget(imps, i)
        if !is_module_name(imp[1])
            aerr(an, imp, "unknown module '" . imp[1] . "': the built-in modules are fs, net, json, txt and sys, and none of them needs importing (SPEC 11.1). A directory beside app.w is not a module: a program that outgrows one file becomes one folder, and every .w file in it is already part of it (SPEC 11)")
            return 0
        // The parser takes imports from the opening lines of the combined
        // source, so when app.w holds nothing but imports, a sibling's import
        // would land there too.
        if !in_entry(an, node_ln(imp))
            aerr(an, imp, "an import goes at the top of app.w, before any other line (SPEC 11.1)")
            return 0
        add_module_funcs(an, imp[1])
        i = i + 1
    items = prog[1]
    // Only app.w runs statements (SPEC 8.1). The other files are appended to
    // it, so a statement in one would otherwise run after app.w's own.
    s = 0
    loop s < lcount(items)
        it = lget(items, s)
        if it[0] != 2 && it[0] != 3 && !in_entry(an, node_ln(it))
            aerr(an, it, "only app.w may hold top-level statements, so move this into a function or into app.w (SPEC 8.1)")
            return 0
        s = s + 1
    if an[22] != 0
        net_rename(an, items)
    j = 0
    loop j < lcount(items)
        it = lget(items, j)
        if it[0] == 2
            // The top-level statements are compiled as a function called
            // _toplevel, so a program's own function by that name would take
            // its label and the build would fail in the assembler with no line.
            if it[1] == "_toplevel"
                aerr(an, it, "'_toplevel' is the name the compiler uses for the top-level statements, so pick another name")
                return 0
            prev = func_lookup(an, it[1])
            if prev != 0
                pn = prev[3]
                aerr(an, it, "'" . it[1] . "' is already defined at " . srcloc(an[21], an[5], node_ln(pn)) . ":" . node_cl(pn) . ", and there are no namespaces, so rename one of them")
                return 0
            // [name, params, used, node, the functions its body calls, whether a
            // function other than itself calls it]. `used` is set by a call from
            // the top level or a hook body, or by a contract hook, and an_analyze
            // works out the rest by reachability.
            ent = text(6)
            ent[0] = it[1]
            ent[1] = it[2]
            ent[2] = 0
            ent[3] = it
            ent[4] = mklist(4)
            ent[5] = 0
            an[1] = ladd_grow(an[1], ent)
            fidx = an[13]
            fidx[it[1]] = ent
        j = j + 1
    k = 0
    loop k < lcount(items)
        if an[0] != 0
            return 0
        it = lget(items, k)
        if it[0] == 3
            check_contract(an, it)
        k = k + 1

an_analyze(an, prog)
    collect(an, prog)
    if an[0] != 0
        return 0
    items = prog[1]
    top = mkscope(0)
    an[25] = top
    an[24] = da_new()
    kt_build(an, items, mklist(1), 0)
    i = 0
    loop i < lcount(items)
        if an[0] != 0
            return 0
        it = lget(items, i)
        if it[0] == 2
            check_function(an, it)
        else if it[0] == 3
            check_hook(an, it)
        else
            check_stmt(an, it, top, 0, 0)
        i = i + 1
    an[24] = 0
    an[25] = 0
    an[26] = 0
    scope_check_unused(an, top)
    // Unused-function check (SPEC 10.1 and 15). A bare `name(args)` line with an
    // indented block under it is a function definition, not a call (SPEC 4.2),
    // so if that name is then called nowhere, the accident is a function nobody
    // runs. The top level, the hook bodies and the hooked functions are the
    // roots (check_call, check_contract), and a function is used when a root
    // reaches it through the calls check_call recorded. So a function that only
    // calls itself, or a pair that only call each other, is still unused. The
    // report goes in definition order, a function with no caller first: in a
    // dead chain that's its head, and the plain message is true for it.
    if an[0] == 0
        fs = an[1]
        work = mklist(64)
        u = 0
        loop u < lcount(fs)
            e = lget(fs, u)
            if e[2] == 1
                work = ladd_grow(work, e)
            u = u + 1
        w = 0
        loop w < lcount(work)
            cs = lget(work, w)[4]
            q = 0
            loop q < lcount(cs)
                c = lget(cs, q)
                if c[2] == 0
                    c[2] = 1
                    work = ladd_grow(work, c)
                q = q + 1
            w = w + 1
        dead = 0
        u = 0
        loop u < lcount(fs) && kind(dead) == "number"
            e = lget(fs, u)
            if e[2] == 0 && e[5] == 0 && (an[22] == 0 || node_ln(e[3]) < an[22])
                dead = e
            u = u + 1
        if kind(dead) == "number"
            u = 0
            loop u < lcount(fs) && kind(dead) == "number"
                e = lget(fs, u)
                if e[2] == 0 && (an[22] == 0 || node_ln(e[3]) < an[22])
                    dead = e
                u = u + 1
        if kind(dead) != "number"
            if dead[5] == 0
                aerr(an, dead[3], "function '" . dead[0] . "' is defined but never used")
            else
                aerr(an, dead[3], "function '" . dead[0] . "' is defined but never used: the only calls to it are in functions that are never used either")
            return 0
    // A parked text-index site (check_expr) is an error once the whole
    // program is in and an[11] is still 0: with no {} literal and no json.parse
    // anywhere, nothing here is a map.
    if an[0] == 0 && an[11] == 0
        pend = an[12]
        if lcount(pend) > 0
            aerr(an, lget(pend, 0), "index must be a number, but got a region")

str_add(a, b)
    la = len(a)
    lb = len(b)
    n = la
    if lb > n
        n = lb
    res = text(n + 1)
    carry = 0
    i = 0
    loop i < n
        da = 0
        if i < la
            da = a[la - 1 - i] - 48
        db = 0
        if i < lb
            db = b[lb - 1 - i] - 48
        s = da + db + carry
        res[i] = 48 + (s % 10)
        carry = idiv(s, 10)
        i = i + 1
    total = n
    if carry > 0
        res[n] = 48 + carry
        total = n + 1
    outp = text(total)
    j = 0
    loop j < total
        outp[j] = res[total - 1 - j]
        j = j + 1
    return outp

region_addr_str(offset)
    base = "105553116266496"
    off = num_to_str(offset)
    return str_add(base, off)

new_label(cg)
    cg[0] = cg[0] + 1
    return ".L" . cg[0]

// cg[1] is the set of names the program defines, as a map. It's asked once per
// call expression, and a scan would make codegen quadratic.
fn_is_known(cg, name)
    fns = cg[1]
    if fns == 0
        return 0
    // A miss would read as `none`, and every caller here asks `== 1`, so a
    // miss becomes 0.
    if !has(fns, name)
        return 0
    return fns[name]

// A frame's env maps each name to its home (add_env), so finding one is a hash
// and not a walk. A walk made a function with 20,000 locals quadratic to
// compile.
env_lookup(cg, name)
    env = cg[2]
    if !has(env, name)
        return "?"
    return env[name]

// The 32-bit name for a local's home, so a u32 local (gen_u32) is read and
// written through a 32-bit register, which masks and zero-extends for free. A
// memory slot (`[rbp - N]`) carries no size of its own and passes through, and
// the five pin registers map to their 32-bit halves (ebx, r12d to r15d).
reg32(s)
    if s[0] == 91
        return s
    if s == "rbx"
        return "ebx"
    if s == "r12"
        return "r12d"
    if s == "r13"
        return "r13d"
    if s == "r14"
        return "r14d"
    if s == "r15"
        return "r15d"
    return s

// `bytes("...")` with a hex string literal is a blob: 256 bytes of table in
// .rodata instead of 256 stores in the instruction stream. The AES S-box used
// to be 4,383 lines of code for 256 bytes of data.
//
// is_byte_blob is worked out again at each use instead of being recorded, so
// prepass_literals and the call site can't disagree about which literals went
// into the pool as bytes. The pool's offsets depend on them agreeing.
hex_val(c)
    if c >= 48 && c <= 57
        return c - 48
    if c >= 97 && c <= 102
        return c - 87
    if c >= 65 && c <= 70
        return c - 55
    return 0 - 1

is_byte_blob(e)
    if e[0] != 17
        return false
    if e[1] != "bytes"
        return false
    args = e[2]
    if lcount(args) != 1
        return false
    a = lget(args, 0)
    if a[0] != 12
        return false
    t = a[1]
    n = len(t)
    if n == 0
        return false
    if n % 2 != 0
        return false
    i = 0
    loop i < n
        if hex_val(t[i]) < 0
            return false
        i = i + 1
    return true

// The blob's bytes, decoded from the literal's hex.
blob_bytes(e)
    t = lget(e[2], 0)[1]
    n = idiv(len(t), 2)
    b = bytes(n)
    i = 0
    loop i < n
        b[i] = hex_val(t[i * 2]) * 16 + hex_val(t[i * 2 + 1])
        i = i + 1
    return b

// Where this literal sits in the pool. prepass_literals wrote it into the node
// itself, so this is one load instead of a scan of every literal in the program.
lit_lookup(cg, node)
    return node[4]

cg_call_kind(name)
    if name == "keys"
        return 1
    // A predicate answers a boolean (SPEC 3.8), which is a singleton (5).
    // Calling it an integer would let codegen's integer fast paths skip the tag
    // tests a boolean has to meet. It once made `if !has(m, k)` read `false`
    // as true.
    if name == "has"
        return 5
    if name == "len"
        return 0
    if name == "bytes"
        return 1
    if name == "array"
        return 1
    if name == "text"
        return 1
    if name == "copy"
        return 1
    if name == "ended"
        return 5
    if name == "write"
        return 5
    if name == "append"
        return 5
    if name == "rename"
        return 5
    if name == "args"
        return 1
    if name == "kind"
        return 1
    if name == "char"
        return 1
    if name == "decode"
        return 1
    if name == "encode"
        return 1
    if name == "split"
        return 1
    if name == "pad"
        return 1
    if name == "round"
        return 0
    if name == "now"
        return 0
    if name == "random"
        return 0
    if name == "env"
        return 2
    // `number` isn't listed, so its answer is unknown (2). It answers `none`
    // when the text isn't a number (SPEC 9), and `none` is the word 30, whose
    // low bit is 0. Calling it an integer would skip the tag test (SPEC 3.6),
    // so
    //
    //     s = in()
    //     n = number(s)
    //     out(n + 1)
    //
    // with anything non-numeric on stdin would do arithmetic on the word 30,
    // read the result as a region pointer and dereference it: an ordinary
    // program with no `sys` in it dying on SIGSEGV. `find` is unknown for the
    // same reason, since a miss is `none`. Unknown costs only the tag test
    // every other unknown pays.
    if name == "find"
        return 2
    if name == "sort"
        return 1
    return 2

// codegen's static kind: 0 integer, 1 region, 2 unknown until run time, 3 float,
// 4 map, 5 one of the four singletons, and -1 for a local whose kind the
// inference hasn't settled yet (infer_local_kinds). A float only comes up in a
// program that uses floats (cg[14]).
cg_kind(cg, e)
    k = e[0]
    // 5 is one of the four singletons. It's kept apart from unknown so the
    // arithmetic and ordering paths can refuse it outright, instead of emitting
    // a numeric check that would read its payload as a value.
    if k == 21
        return 5
    if k == 19
        return 4
    if k == 11
        return 0
    if k == 18
        return 3
    if k == 12
        return 1
    if k == 13
        return local_kind(cg, e[1])
    if k == 15
        // `!` answers a boolean whatever it was given. `-` and `~` carry their
        // operand's kind through, which is how a region operand keeps its check.
        if e[1] == "!"
            return 5
        return cg_kind(cg, e[2])
    if k == 14
        if e[1] == "."
            return 1
        return cg_arith_kind(cg, e)
    if k == 17
        nm = e[1]
        if fn_is_known(cg, nm) == 1
            return pk_ret_kind(cg, nm)
        // `copy` hands back what it was given: a copied map is a map, and
        // saying "region" here would cost the map arm of the index dispatch.
        if nm == "copy" && lcount(e[2]) > 0
            return cg_kind(cg, lget(e[2], 0))
        return cg_call_kind(nm)
    return 2

// The kind of a binary operator's answer. `%` and the bitwise and shift
// operators answer an integer. `+ - *` answer an integer when both operands are
// integers, a float when one is a float and neither is unknown, and unknown
// otherwise. `/` of two integers is unknown (below), and a comparison, `&&` or
// `||` answers a singleton.
cg_arith_kind(cg, e)
    op = e[1]
    if op == "+" || op == "-" || op == "*" || op == "/"
        lk = cg_kind(cg, e[2])
        rk = cg_kind(cg, e[3])
        // -1 is the inference's "not known yet" (infer_local_kinds). It
        // propagates, so a local read before its kind settles can't be taken
        // for a decided one.
        if lk == 0 - 1 || rk == 0 - 1
            return 0 - 1
        if lk == 0 && rk == 0
            // Two integers make an integer under + - and *, and under `/` only
            // when the division comes out exact, which depends on the values.
            // So `/` answers 2, unknown until run time: a number, but which sort
            // only the division knows. Saying 0 would let a later index or shift
            // skip its own check on a word that turned out to be a float box,
            // and saying 3 would send `9 / 3` down the float path to answer 3.0.
            if op == "/"
                return 2
            return 0
        if lk == 2 || rk == 2
            return 2
        // A region operand is an error the analyzer already reports for a
        // literal, but a local holding a region can reach here, and answering 2
        // keeps the numcheck that faults with "number expected, got a region"
        // instead of reading the region header as a double. A map (4) or a
        // singleton (5) is the same: a parameter every caller passes a map to
        // reaches here as a map, and answering 3 for it would make `v + 1` a
        // float, give the function a raw-double return, and leave a float-free
        // program unable to link for want of rt_to_double. Only two numbers
        // make a float.
        if lk != 0 && lk != 3
            return 2
        if rk != 0 && rk != 3
            return 2
        return 3
    // A comparison and a logical operator answer `true` or `false` (SPEC 3.8),
    // which is a singleton. Calling it an integer (0) would let codegen's
    // integer fast paths skip the tag tests a boolean has to meet. That once
    // made `a || b` read a comparison's `false` as true.
    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" || op == "&&" || op == "||"
        return 5
    // % and the bitwise and shift operators are integer.
    return 0

// Fault unless the word in `reg` is a number: an integer (any odd word) or a
// float (tag 010). A region (000), a map (100) and a singleton (110) all fault.
//
// Testing for a region alone isn't enough, because `none` is the word 30:
//
//     s = in()
//     n = number(s)        // "wat" -> none, the word 30
//     out(n + 1)           // 30 & 7 = 6, not 0
//
// The add would make the word 32, whose low three bits are 000, and `out`
// would dereference address 32 as a region, where SPEC 10.2 promises a located
// fault. This path only runs when the kind isn't known at compile time.
numcheck(cg, reg)
    lbl = new_label(cg)
    // An integer is any odd word, and that's the common case, so it costs one
    // `test` and a branch that isn't taken. Everything else asks the full
    // question (a float, tag 010, passes, and a region, a map or a singleton
    // faults) and leaves the tag in r10, which rt_numfault reads to say what
    // arrived.
    asmput("    test " . reg . ", 1")
    asmput("    jnz " . lbl)
    asmput("    mov r10, " . reg)
    asmput("    and r10, 7")
    asmput("    cmp r10, 2")
    asmput("    jne rt_numfault")
    asmput(lbl . ":")

// The low three bits are tested in place, not masked out, so r10 still holds
// the whole word when rt_regfault reads it to say what arrived. The tag alone
// can't tell the four singletons apart (all four are 110). `test r10b, 7` is
// four bytes, the same as `and r10, 7`.
regcheck(reg)
    asmput("    mov r10, " . reg)
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")

// The two things that can go wrong in a division, guarded on the tagged
// divisor in rcx: a zero divisor, and MIN / -1, whose quotient is one past the
// range. `rv` is the divisor when it's a non-negative literal, and negative
// otherwise (a folded negative constant included, which gets both tests). A
// written literal is never negative, since a minus sign is unary (SPEC 4.1),
// so a literal divisor can be zero but never -1, and both tests are settled at
// compile time. `% 251` and `/ 2` are seven instructions lighter for it, and a
// constant divisor is the common case.
divguard(cg, rv)
    if rv <= 0
        asmput("    cmp rcx, 1")
        asmput("    je rt_div0")
    if rv < 0
        lbl = new_label(cg)
        asmput("    movabs r11, 0x8000000000000001")
        asmput("    cmp rax, r11")
        asmput("    jne " . lbl)
        asmput("    cmp rcx, -1")
        asmput("    je rt_overflow")
        asmput(lbl . ":")

// The right operand's value when it's an integer literal, or -1 when it's
// anything else. What divguard reads.
rlit_val(e)
    if e[0] != 11
        return 0 - 1
    return e[1]

// ---- the 32-bit rotate idiom -----------------------------------------------
//
// `((x << L) | (x >> (32 - L))) & mask` is how 32-bit ARX code spells a
// rotation, since word has no rotate operator: ChaCha20's quarter round rotates
// by 16, 12, 8 and 7, and SHA-256's sigma functions xor three terms, most of
// them rotations. The value model would turn each one into a dozen or so
// instructions (untag, shift and retag on each side, then the or and the mask)
// where the CPU has `rol`/`ror`. This recognizes the pair and emits the rotate.
// Both backends emit the same 32-bit rotation (x86 `rol eax, L`, AArch64
// `ror w0, 32 - L`), and test_crypto_w runs the ciphers built on it on both.
//
// The rotation is the idiom's value only when two things hold. The result has
// to be cut back to 32 bits, because `x << L` carries bits past bit 31. And x
// has to fit in 32 bits, because `x >> (32 - L)` shifts any bits above bit 31
// down into the result. So the rotate is used only where the low 32 bits are
// all that's kept: an `& 4294967295` on the idiom itself, or gen_u32 under a
// u32 local's assignment (SHA's sigma functions mask the xor of the terms
// once). Even there, `rol` needs x proven to fit (cg_u32), and otherwise the
// two shifts run on x's whole value and are or'd, which is right mod 2^32
// whatever x is. With no mask the idiom is plain arithmetic, in every program:
// with x = 0xFF000000, `(x << 8) | (x >> 24)` is 1095216660735. (It used to
// answer 255 in a program with no float in it, because only there did
// gen_binary take the rotate, mask or no mask.)

// Is `e` an `x << n` or `x >> n` with the count a literal in 1..31, one arm of
// a rotate?
is_shift_lit(e)
    if e[0] != 14
        return false
    if e[1] != "<<" && e[1] != ">>"
        return false
    if e[3][0] != 11
        return false
    amt = e[3][1]
    if amt < 1
        return false
    if amt > 31
        return false
    return true

// If `e` is the rotate idiom `(x << L) | (x >> R)` or `(x >> R) | (x << L)` with
// L + R == 32 and the same leaf `x` on both arms (a name or an integer literal,
// same_leaf), return the left-rotate amount L (1..31), and otherwise 0. The
// operand is e[2][2] (== e[3][2]).
rot_lamt(e)
    if e[0] != 14
        return 0
    if e[1] != "|"
        return 0
    a = e[2]
    b = e[3]
    if !is_shift_lit(a)
        return 0
    if !is_shift_lit(b)
        return 0
    // one arm shifts left and the other right
    if a[1] == b[1]
        return 0
    if !same_leaf(a[2], b[2])
        return 0
    if a[3][1] + b[3][1] != 32
        return 0
    if a[1] == "<<"
        return a[3][1]
    return b[3][1]

// The 32-bit funnel shift: `(A >> n) | ((B & (2^n - 1)) << (32 - n))` puts the
// top (32 - n) bits of A, shifted down, and the low n bits of B above them into
// one 32-bit word: a rotation of the 64-bit value carried in two halves. It's
// `shrd A, B, n` on x86-64 and `extr Wd, B, A, #n` on AArch64, one instruction
// where the value model emits a dozen. SHA-512's four sigma functions are built
// from it (its 64-bit rotations, split across the h/l halves), and it's the
// two-register form of the rotate rot_lamt recognizes. The mask `& (2^n - 1)`
// in the source keeps the `<<` inside 32 bits, which shrd and extr do anyway.
// Unlike the rotate it needs no mask around it, because both arms already fit
// in 32 bits when A does. So shrd and extr are used only when A is proven to
// fit (cg_u32). With A = 2^40 and n = 4 they'd answer 0 where the arithmetic
// gives 2^36, so any other A gets the shift and the or on its whole value.
// Returns [A, B, n] or 0.
funnel_leaf(e)
    if e[0] == 13
        return true
    if e[0] == 11
        return true
    return false

// `sh` is `A >> n` and `mk` is `(B & (2^n - 1)) << (32 - n)`. Returns [A, B, n]
// or 0.
funnel_arm(sh, mk)
    if sh[0] != 14 || sh[1] != ">>"
        return 0
    if sh[3][0] != 11
        return 0
    n = sh[3][1]
    if n < 1 || n > 31
        return 0
    if mk[0] != 14 || mk[1] != "<<"
        return 0
    if mk[3][0] != 11 || mk[3][1] != 32 - n
        return 0
    an = mk[2]
    if an[0] != 14 || an[1] != "&"
        return 0
    want = (1 << n) - 1
    b = 0
    if an[3][0] == 11 && an[3][1] == want
        b = an[2]
    else if an[2][0] == 11 && an[2][1] == want
        b = an[3]
    else
        return 0
    if !funnel_leaf(sh[2]) || !funnel_leaf(b)
        return 0
    r = text(3)
    r[0] = sh[2]
    r[1] = b
    r[2] = n
    return r

funnel_parts(e)
    if e[0] != 14 || e[1] != "|"
        return 0
    r = funnel_arm(e[2], e[3])
    if r != 0
        return r
    return funnel_arm(e[3], e[2])

// The other operand of an `&` node whose one operand is the literal 2^32 - 1.
// rot_masked_arg returns the non-mask side, and mask32_rot returns its rotate
// amount (rot_lamt) when that side is the rotate idiom, and otherwise 0. So
// `(rotate) & M32` collapses to the rotate, whose 32-bit result the mask can't
// change.
is_mask32(e)
    if e[0] != 11
        return false
    if e[1] == 4294967295
        return true
    return false

rot_masked_arg(e)
    if is_mask32(e[3])
        return e[2]
    return e[3]

mask32_rot(e)
    if e[0] != 14
        return 0
    if e[1] != "&"
        return 0
    if is_mask32(e[3])
        return rot_lamt(e[2])
    if is_mask32(e[2])
        return rot_lamt(e[3])
    return 0

// Is `e` true or false whatever it evaluates to? The two literals, and the
// operators that answer nothing else: a comparison, `!`, `&&` and `||`. Its kind
// alone doesn't say, since null and none are singletons too.
is_static_bool(e)
    k = e[0]
    if k == 21
        return e[1] == 1 || e[1] == 2
    if k == 15
        return e[1] == "!"
    if k == 14
        return is_cmp_op(e[1]) || e[1] == "&&" || e[1] == "||"
    return false

is_cmp_op(op)
    if op == "=="
        return true
    if op == "!="
        return true
    if op == "<"
        return true
    if op == "<="
        return true
    if op == ">"
        return true
    if op == ">="
        return true
    return false

// ---- exact decimal -> IEEE-754 double (SPEC 2.6) ----
//
// A float literal is `m * 10^e`, and the double it becomes has to be the
// nearest one (SPEC 2.6). Folding the power of ten into one division only
// works while both halves fit a 63-bit integer, and applying the rest by
// repeated multiplication rounds at every step: 1e-300 came out 13 units in
// the last place off that way.
//
// So the value is held exactly, as decimal digits, and doubled or halved (both
// exact in base ten) until its integer part is a 53-bit significand. Whatever
// is left below the point decides the rounding. There's no division and no
// floating point, so no error can build up.
//
// The digits live in one region: index i holds the digit worth 10^(i - 1700).
// 1700 leaves room below the point for a mantissa of up to 820 digits (see
// lnum_exact) plus the ~1000 digits halving can add underneath it, and 900
// above for the ~320 integer digits a literal can start with. A bignum here
// is [digits, lo, hi): every index in [lo, hi) is a digit, and both ends move.
//
// m is an integer, or for a literal too long for one, a region of its digits,
// most significant first.
fd_make(m, e)
    d = text(2600)
    b = text(3)
    b[0] = d
    base = 1700 + e
    n = 0
    if kind(m) == "number"
        v = m
        loop v > 0
            d[base + n] = v % 10
            v = idiv(v, 10)
            n = n + 1
    else
        n = len(m)
        i = 0
        loop i < n
            d[base + i] = m[n - 1 - i]
            i = i + 1
    lo = base
    hi = base + n
    if lo > 1700
        lo = 1700
    if hi < 1700
        hi = 1700
    b[1] = lo
    b[2] = hi
    return b

// Drop leading and trailing zeros, but never past the decimal point: the window
// always contains index 1700, so the integer part and the fraction each stay
// addressable even when one of them is empty.
fd_trim(b)
    d = b[0]
    h = b[2]
    loop h > 1700
        if d[h - 1] != 0
            break
        h = h - 1
    b[2] = h
    l = b[1]
    loop l < 1700
        if d[l] != 0
            break
        l = l + 1
    b[1] = l
    return 0

fd_double(b)
    d = b[0]
    i = b[1]
    c = 0
    loop i < b[2]
        v = d[i] * 2 + c
        c = 0
        if v >= 10
            v = v - 10
            c = 1
        d[i] = v
        i = i + 1
    if c == 1
        d[b[2]] = 1
        b[2] = b[2] + 1
    return 0

// Halving is where a new digit appears at the bottom, which is why the window
// grows downward and there's room reserved under 1700.
fd_halve(b)
    d = b[0]
    i = b[2] - 1
    c = 0
    loop i >= b[1]
        v = c * 10 + d[i]
        d[i] = idiv(v, 2)
        c = v % 2
        i = i - 1
    if c == 1
        b[1] = b[1] - 1
        d[b[1]] = 5
    return 0

// How many digits the integer part has, ignoring leading zeros.
fd_intdigits(b)
    d = b[0]
    i = b[2] - 1
    loop i >= 1700
        if d[i] != 0
            return i - 1700 + 1
        i = i - 1
    return 0

// The integer part as a word integer. It's only called where fd_intdigits has
// already said it has 16 or fewer digits, so it can't overflow.
fd_intval(b)
    d = b[0]
    v = 0
    i = b[2] - 1
    loop i >= 1700
        v = v * 10 + d[i]
        i = i - 1
    return v

fd_ge53(b)
    nd = fd_intdigits(b)
    if nd > 16
        return true
    if nd < 16
        return false
    if fd_intval(b) >= 9007199254740992
        return true
    return false

fd_lt52(b)
    nd = fd_intdigits(b)
    if nd > 16
        return false
    if nd < 16
        return true
    if fd_intval(b) < 4503599627370496
        return true
    return false

// dec_to_bits(m, e) -> [high 32 bits, low 32 bits] of the double nearest to
// m * 10^e. The sign bit is always clear, because a literal has no sign (unary
// minus is an operator, SPEC 4.1), but the other 63 bits still don't fit in a
// word integer, which tops out at 2^62 - 1. So it comes back in two halves.
dec_to_bits(m, e)
    r = text(2)
    r[0] = 0
    r[1] = 0
    nd = 0
    if kind(m) == "number"
        if m == 0
            return r
        v = m
        loop v > 0
            v = idiv(v, 10)
            nd = nd + 1
    else
        // Every digit of a long literal (lnum_exact), and the first isn't zero.
        nd = len(m)
    // Settle the far cases on the decimal magnitude alone, before building any
    // digits. It keeps the array bounded, and past these bounds IEEE's answer
    // is inf or zero anyway.
    mag = e + nd - 1
    if mag > 309
        r[0] = 2146435072
        return r
    if mag < 0 - 340
        return r
    b = fd_make(m, e)
    fd_trim(b)
    q = 0
    loop fd_ge53(b)
        fd_halve(b)
        fd_trim(b)
        q = q + 1
    loop fd_lt52(b)
        fd_double(b)
        fd_trim(b)
        q = q - 1
    // Below 2^-1074 there are no more bits to keep: the significand shrinks
    // instead of the exponent falling, which is what a subnormal is.
    loop q < 0 - 1074
        fd_halve(b)
        fd_trim(b)
        q = q + 1
    s = fd_intval(b)
    // Round to nearest, ties to even, from the digits below the point. This is
    // why the value was kept exact this far.
    d = b[0]
    f1 = 0
    if b[1] < 1700
        f1 = d[1699]
    up = 0
    if f1 > 5
        up = 1
    else if f1 == 5
        rest = 0
        i = b[1]
        loop i < 1699
            if d[i] != 0
                rest = 1
            i = i + 1
        if rest == 1
            up = 1
        else if s % 2 == 1
            up = 1
    if up == 1
        s = s + 1
        if s >= 9007199254740992
            s = idiv(s, 2)
            q = q + 1
    biased = q + 1075
    if s < 4503599627370496
        biased = 0
    if biased >= 2047
        r[0] = 2146435072
        r[1] = 0
        return r
    if biased < 0
        return r
    frac = s
    if biased > 0
        frac = s - 4503599627370496
    r[0] = biased * 1048576 + idiv(frac, 4294967296)
    r[1] = frac % 4294967296
    return r

// Eight lowercase hex digits of a value below 2^32.
hex8(v)
    s = text(8)
    i = 7
    n = v
    loop i >= 0
        dg = n % 16
        c = 48 + dg
        if dg > 9
            c = 87 + dg
        s[i] = c
        n = idiv(n, 16)
        i = i - 1
    return s

// The literal a `movabs`/`mov` needs for this double, as one hex constant.
f64_hex(m, e)
    r = dec_to_bits(m, e)
    return "0x" . hex8(r[0]) . hex8(r[1])

// Each distinct float literal gets one 8-byte slot in the float pool, stored
// with its bits at startup and read with a plain mov, so a literal in a loop
// costs a load. The value itself is worked out at compile time (dec_to_bits).
// Identical literals share a slot, and the list is short enough that a scan is
// the right lookup.
flit_index(cg, m, ex)
    pool = cg[29]
    i = 0
    loop i < lcount(pool)
        e = lget(pool, i)
        if e[0] == m && e[1] == ex
            return i
        i = i + 1
    e = text(2)
    e[0] = m
    e[1] = ex
    cg[29] = ladd_grow(pool, e)
    return lcount(cg[29]) - 1

prepass_literals(cg, node)
    k = node[0]
    if k == 19
        ks = node[1]
        vs = node[2]
        i = 0
        loop i < lcount(ks)
            prepass_literals(cg, lget(ks, i))
            prepass_literals(cg, lget(vs, i))
            i = i + 1
        return 0
    if k == 18
        node[5] = flit_index(cg, node[1], node[2])
        return 0
    if k == 12
        // Each literal carries the same 16-byte header in front of its length
        // that a heap region does: [off]=flags, [off+8]=capacity,
        // [off+16]=length, then the elements. The address baked into the code
        // points at the length word (off+16), so codegen and every region read
        // treat it like a heap region. Only in-place append reads the capacity
        // behind the pointer.
        off = cg[6]
        node[4] = off + 16
        elems = node[1]
        cg[4] = ladd_grow(cg[4], elems)
        cg[47] = ladd_grow(cg[47], 0)
        cg[6] = cg[6] + (len(elems) + 3) * 8
    else if k == 14
        prepass_literals(cg, node[2])
        prepass_literals(cg, node[3])
    else if k == 15
        prepass_literals(cg, node[2])
    else if k == 16
        prepass_literals(cg, node[1])
        prepass_literals(cg, node[2])
    else if k == 17
        if is_byte_blob(node)
            // The blob occupies its three header words and its bytes, rounded
            // up to a word so the next literal still starts aligned.
            b = blob_bytes(node)
            off = cg[6]
            lget(node[2], 0)[4] = off + 16
            cg[4] = ladd_grow(cg[4], b)
            cg[47] = ladd_grow(cg[47], 1)
            pad = len(b)
            if pad % 8 != 0
                pad = pad + (8 - (pad % 8))
            cg[6] = cg[6] + 24 + pad
            return 0
        args = node[2]
        i = 0
        loop i < lcount(args)
            prepass_literals(cg, lget(args, i))
            i = i + 1
    else if k == 4
        prepass_literals(cg, node[2])
    else if k == 5
        prepass_literals(cg, node[1])
        prepass_literals(cg, node[2])
    else if k == 6
        prepass_literals(cg, node[1])
        thn = node[2]
        ti = 0
        loop ti < lcount(thn)
            prepass_literals(cg, lget(thn, ti))
            ti = ti + 1
        if node[3] != 0
            orl = node[3]
            oi = 0
            loop oi < lcount(orl)
                prepass_literals(cg, lget(orl, oi))
                oi = oi + 1
    else if k == 7
        if node[1] != 0
            prepass_literals(cg, node[1])
        bdy = node[2]
        bi = 0
        loop bi < lcount(bdy)
            prepass_literals(cg, lget(bdy, bi))
            bi = bi + 1
    else if k == 20
        prepass_literals(cg, node[2])
        feb = node[3]
        fbi = 0
        loop fbi < lcount(feb)
            prepass_literals(cg, lget(feb, fbi))
            fbi = fbi + 1
    else if k == 8
        if node[1] != 0
            prepass_literals(cg, node[1])
    else if k == 10
        prepass_literals(cg, node[1])
    else if k == 2
        fb = node[3]
        fi = 0
        loop fi < lcount(fb)
            prepass_literals(cg, lget(fb, fi))
            fi = fi + 1

gen_unary(cg, e)
    op = e[1]
    // A float is a tagged pointer to its box, so negating the word would negate
    // the pointer. A float is negated by flipping its sign bit, which is also the
    // only way to get -0.0 right. When the operand's kind isn't known at compile
    // time, dispatch on the tag the way arithmetic does.
    if cg[14] == 1 && op == "-" && cg_kind(cg, e[2]) == 3
        gen_float_expr(cg, e)
        asmput("    movq rax, xmm0")
        asmput("    call rt_box_float")
        return 0
    gen_expr(cg, e[2])
    if op == "-"
        if cg[14] == 1 && cg_kind(cg, e[2]) != 0
            fl = new_label(cg)
            dn = new_label(cg)
            asmput("    mov r10, rax")
            asmput("    and r10, 7")
            asmput("    cmp r10, 2")
            asmput("    je " . fl)
            if cg_kind(cg, e[2]) != 0
                numcheck(cg, "rax")
            asmput("    neg rax")
            asmput("    add rax, 2")
            asmput("    jo rt_overflow")
            asmput("    jmp " . dn)
            asmput(fl . ":")
            asmput("    call rt_fneg")
            asmput(dn . ":")
            return 0
        if cg_kind(cg, e[2]) != 0
            numcheck(cg, "rax")
        asmput("    neg rax")
        asmput("    add rax, 2")
        asmput("    jo rt_overflow")
    else if op == "~"
        if cg_kind(cg, e[2]) != 0
            numcheck(cg, "rax")
        // `~` is integer-only (SPEC 3.3), and numcheck lets a float (tag 010)
        // through, so reject one the way `%` does.
        if cg[14] == 1 && cg_kind(cg, e[2]) != 0
            floatreject("rax")
        asmput("    not rax")
        asmput("    or rax, 1")
    else if op == "!"
        // Through the same truth test as `if` and `&&`, so `!false` is true and
        // `!null` faults.
        ntrue = new_label(cg)
        nend = new_label(cg)
        gen_truth_jump(cg, e[2], ntrue)
        asmput("    mov rax, 14")
        asmput("    jmp " . nend)
        asmput(ntrue . ":")
        asmput("    mov rax, 22")
        asmput(nend . ":")

// A leaf operand loads into any register with one instruction and clobbers
// nothing else: an integer literal, a string literal or a local. The binary
// paths below use this to skip the push/pop spill of the left operand. If the
// right side is a leaf it can't disturb the left, so both go straight into
// their destination registers.
is_leaf_operand(cg, e)
    k = e[0]
    if k == 11
        return true
    if k == 12
        return true
    if k == 13
        // An unboxed float local isn't a leaf: its slot holds a raw double, and
        // reading it as a value means boxing it.
        if is_float_local(cg, e[1])
            return false
        // A raw u32 local is the same: its slot holds an untagged value, and an
        // ordinary read has to tag it.
        if is_u32_local(cg, e[1]) == 1
            return false
        return true
    return false

// Emit a leaf operand directly into `reg` (see is_leaf_operand).
gen_leaf_into(cg, e, reg)
    k = e[0]
    if k == 11
        asmput("    movabs " . reg . ", " . (e[1] * 2) + 1)
    else if k == 12
        off = lit_lookup(cg, e)
        asmput("    movabs " . reg . ", " . region_addr_str(off))
    else
        asmput("    mov " . reg . ", " . env_lookup(cg, e[1]))

// Evaluate a binary node's two operands into `lreg` and `rreg`. The spill is
// skipped when the right operand is a leaf (the common `a op b` shape).
gen_two_operands(cg, e, lreg, rreg)
    if is_leaf_operand(cg, e[3])
        // A leaf on the left too (`a < b`, `n - 1`, `s == "x"`) loads straight
        // into its register instead of going through rax. rax isn't even the
        // destination on the compare paths, which is where two leaves mostly
        // turn up.
        if is_leaf_operand(cg, e[2]) && lreg != "rax"
            gen_leaf_into(cg, e[2], lreg)
            gen_leaf_into(cg, e[3], rreg)
            return 0
        gen_expr(cg, e[2])
        if lreg != "rax"
            asmput("    mov " . lreg . ", rax")
        gen_leaf_into(cg, e[3], rreg)
        return 0
    // A leaf on the left and something bigger on the right (`sum + s[j]`,
    // `n * f(x)`, `pre . build(x)`) doesn't need the spill either: evaluate the
    // right operand first, then load the leaf straight into its register. The
    // reorder is safe because a leaf is a literal or a local's slot: reading it
    // can't fault or print, and nothing the right operand does can change it,
    // since assignment isn't an expression (SPEC 4.2) and a call can't reach a
    // caller's locals (SPEC 5.1). It saves two instructions per site, on the
    // shape a fold loop is written in.
    if is_leaf_operand(cg, e[2])
        gen_expr(cg, e[3])
        asmput("    mov " . rreg . ", rax")
        gen_leaf_into(cg, e[2], lreg)
        return 0
    gen_expr(cg, e[2])
    asmput("    push rax")
    gen_expr(cg, e[3])
    asmput("    mov " . rreg . ", rax")
    asmput("    pop " . lreg)

// ---- kind(x) == "name": the kind test, folded ------------------------------
//
// `kind(x) == "number"` is how the language spells a kind test, and it's the
// only way (SPEC 9). Written out, it's expensive for what it asks: a call to
// rt_kind, which walks the tag to pick a literal, and then a region compare of
// that literal against another one. The question underneath is a few
// instructions of tag arithmetic.
//
// So the comparison is recognized whole (`kind(<expr>)` against a string
// literal, either way round, under `==` or `!=`) and emitted as the test it
// describes, with no call and no name built. `kind(x) == "number"` is the same
// seven instructions the retired is_number() builtin emitted.
//
// The answers have to match rt_kind's, including its order: there, a region
// carrying both the JSON-array mark and the byte-backed flag answers "array",
// because the array test comes first. So it does here.
//
// Only a literal folds. `kind(x) == k` where k is a name is an ordinary compare
// against whatever rt_kind returned.

// The kind name a comparison is testing for, or 0 if this is not that shape.
kind_cmp_name(e)
    if e[1] != "==" && e[1] != "!="
        return 0
    l = e[2]
    r = e[3]
    if is_kind_call(l) && r[0] == 12
        return r[1]
    if is_kind_call(r) && l[0] == 12
        return l[1]
    return 0

is_kind_call(e)
    if e[0] != 17
        return false
    if e[1] != "kind"
        return false
    if lcount(e[2]) != 1
        return false
    return true

// The value whose kind is being tested, given a node kind_cmp_name matched.
kind_cmp_arg(e)
    l = e[2]
    if is_kind_call(l)
        return lget(l[2], 0)
    r = e[3]
    return lget(r[2], 0)

// The eight names kind() can answer. Any other is a typo that could never
// match, and check_expr reports it: `kind(x) == "list"`, the name an array had
// before, is the likely one.
is_kind_name(nm)
    if nm == "boolean"
        return true
    if nm == "null"
        return true
    if nm == "none"
        return true
    if nm == "number"
        return true
    if nm == "text"
        return true
    if nm == "bytes"
        return true
    if nm == "array"
        return true
    if nm == "map"
        return true
    return false

gen_compare(cg, e)
    op = e[1]
    kn = kind_cmp_name(e)
    if kn != 0 && is_kind_name(kn)
        gen_kind_test(cg, kind_cmp_arg(e), kn, op == "!=")
        return 0
    if cg[14] == 1 && is_float_cmp(cg, e)
        gen_float_cmp(cg, e)
        return 0
    ilk = cg_kind(cg, e[2])
    irk = cg_kind(cg, e[3])
    // The tagged words order the same way as the untagged values, so a literal
    // right-hand side is just an immediate, and `i < n` against a constant
    // needs no second register.
    if ilk == 0 && irk == 0
        k = int_imm(e[3], 1)
        if len(k) > 0
            gen_expr(cg, e[2])
            asmput("    cmp rax, " . k)
            emit_setcc(op)
            asmput("    movzx rax, al")
            emit_bool()
            return 0
    gen_two_operands(cg, e, "rdi", "rsi")
    // Both operands are known integers, and the tagged words order the same way
    // as the untagged values, so the test that both are integers, and the
    // helper path it guards, would be dead code.
    if ilk == 0 && irk == 0
        asmput("    cmp rdi, rsi")
        emit_setcc(op)
        asmput("    movzx rax, al")
        emit_bool()
        return 0
    // Fast path: two tagged integers compare directly, because the tag
    // (n -> 2n+1) keeps their order, so `cmp` on the tagged words orders them
    // like the values. Both are integers when the AND of the two has the low
    // bit set, which is one test. Anything else (a region, a float) goes to the
    // general helper, where lexicographic and float ordering live.
    slow = new_label(cg)
    done = new_label(cg)
    asmput("    mov r10, rdi")
    asmput("    and r10, rsi")
    asmput("    test r10, 1")
    asmput("    jz " . slow)
    // An inline both-floats compare (ucomisd and a branch in place of
    // rt_order's call) was tried here and measured slower: 61 ms against 56 ms
    // over six million float comparisons, and no change on mandelbrot. Three
    // branches cost more than one well-predicted call, and the ~25 extra
    // instructions per site crowd the I-cache. Inlining float arithmetic
    // removed three calls per operation and was a big win, but inlining the
    // compare removes one and isn't worth the size.
    asmput("    cmp rdi, rsi")
    emit_setcc(op)
    asmput("    movzx rax, al")
    asmput("    jmp " . done)
    asmput(slow . ":")
    if op == "=="
        asmput("    call rt_eq")
    else if op == "!="
        asmput("    call rt_eq")
        asmput("    xor rax, 1")
    else
        asmput("    call rt_order")
        asmput("    cmp rax, " . order_imm(op))
        if op == ">"
            asmput("    sete al")
        else if op == ">="
            asmput("    setb al")
        else
            emit_setcc(op)
        asmput("    movzx rax, al")
    asmput(done . ":")
    emit_bool()

// rt_order answers -1, 0 or 1, and 2 for a pair with no order, which only a NaN
// makes (rt_order_float). `<` and `<=` test against 0, and 2 is neither
// negative nor zero, so they come out false for it. No test against 0 can make
// `>` and `>=` false for 2 as well, so those two ask something else: `>` is
// exactly 1, and `>=` is 0 or 1, which as an unsigned word is below 2 (-1 is
// the largest). This is the compare's immediate. gen_compare and
// a64_gen_compare pick the condition to match, and order_jfalse picks the jump
// for the branch form.
order_imm(op)
    if op == ">"
        return "1"
    if op == ">="
        return "2"
    return "0"

// The jump taken when an ordering is false, after `cmp rax, order_imm(op)`.
order_jfalse(op)
    if op == ">"
        return "jne"
    if op == ">="
        return "jae"
    return jcc_false(op)

// The folded test itself. It evaluates the value into rax and answers `true` or
// `false` (emit_bool). `neg` is true for `!=`, the same test with the answer
// flipped.
gen_kind_test(cg, arg, nm, neg)
    gen_expr(cg, arg)
    if nm == "number"
        // An integer or a float, which is what kind() calls a number. "Not a
        // region" would be wrong, since a map isn't a region either.
        asmput("    mov r10, rax")
        asmput("    and r10, 7")
        asmput("    cmp r10, 2")
        asmput("    sete cl")
        asmput("    and rax, 1")
        asmput("    or al, cl")
        asmput("    movzx rax, al")
    else if nm == "map"
        asmput("    and rax, 7")
        asmput("    cmp rax, 4")
        asmput("    sete al")
        asmput("    movzx rax, al")
    else if nm == "boolean"
        // Boolean is the pair of singleton words true=22 and false=14. Testing
        // their shared tag isn't enough, since null and none share it too. The
        // original word is kept in r10 because sete writes AL, part of rax.
        asmput("    mov r10, rax")
        asmput("    cmp rax, 14")
        asmput("    sete al")
        asmput("    cmp r10, 22")
        asmput("    sete cl")
        asmput("    or al, cl")
        asmput("    movzx rax, al")
    else if nm == "null"
        asmput("    cmp rax, 6")
        asmput("    sete al")
        asmput("    movzx rax, al")
    else if nm == "none"
        asmput("    cmp rax, 30")
        asmput("    sete al")
        asmput("    movzx rax, al")
    else
        // The three region kinds differ only in the flags word at [p-16], so
        // they share one shape: prove it's a region, then read two bits.
        no = new_label(cg)
        done = new_label(cg)
        asmput("    mov r10, rax")
        asmput("    and r10, 7")
        asmput("    jnz " . no)
        asmput("    mov r10, [rax - 16]")
        if nm == "array"
            asmput("    and r10, 2")
            asmput("    setne al")
        else if nm == "bytes"
            asmput("    and r10, 3")
            asmput("    cmp r10, 1")
            asmput("    sete al")
        else
            asmput("    and r10, 3")
            asmput("    sete al")
        asmput("    movzx rax, al")
        asmput("    jmp " . done)
        asmput(no . ":")
        asmput("    xor rax, rax")
        asmput(done . ":")
    // `neg` is the boolean `op == "!="`, so it's tested for truth and not
    // against 1: a comparison answers `true` (SPEC 3.8).
    if neg
        asmput("    xor rax, 1")
    emit_bool()

// Turn the 0 or 1 in rax into the word `false` (14) or `true` (22) (SPEC 3.8).
// The singletons are payload-above-tag immediates, so it's 14 + 8v, one `lea`,
// the same cost as the 2v+1 integer tag. Every comparison and kind test that
// computes its answer as a 0 or 1 ends here. gen_logic, unary `!` and the
// runtime write `true` and `false` as immediates.
//
// Comparisons used to answer the numbers 1 and 0, so `if ready == true` took
// the wrong branch with no fault. That's why a comparison's answer goes
// through here.
emit_bool()
    asmput("    lea rax, [rax*8 + 14]")

// The setcc for a comparison operator, shared by the inline integer fast path
// (flags from `cmp` on the tagged words) and the rt_order slow path's `<` and
// `<=` (flags from `cmp rax, 0` on the helper's answer), which want the same
// condition. rt_order's `>` and `>=` ask differently (order_imm).
emit_setcc(op)
    if op == "=="
        asmput("    sete al")
    else if op == "!="
        asmput("    setne al")
    else if op == "<"
        asmput("    setl al")
    else if op == "<="
        asmput("    setle al")
    else if op == ">"
        asmput("    setg al")
    else if op == ">="
        asmput("    setge al")

// Jump to `falsel` when the word in rax is `false` (14), and fault in
// rt_condfault when it isn't `true` (22) either (SPEC 3.2). Only those two words
// answer a condition: the integer 0 (the word 1), `null` and `none` all fault.
//
// On x86-64, a value that has to be tested for truth comes here: the general
// path of gen_cond_jump, gen_logic, unary `!` and a hook's answer. The rule
// used to be written out at each site, and the ones that compared against 1
// alone read `false`, a nonzero word, as true. a64_truth_jump is the arm64
// twin.
//
// `e` is the expression that produced the word, or 0 where the caller has none.
// Nothing reads it now: every operand gets both compares.
gen_truth_jump(cg, e, falsel)
    // A condition is true (22) or false (14). Anything else (a number, a
    // region, a float box, null (6), none (30)) isn't a condition and faults.
    // The analyzer rejects the cases it can prove (cond_req), and this is the
    // backstop for the ones it can't, such as a call whose result turns out not
    // to be a boolean.
    asmput("    cmp rax, 14")
    asmput("    je " . falsel)
    asmput("    cmp rax, 22")
    asmput("    jne rt_condfault")
    return 0

gen_logic(cg, e)
    op = e[1]
    endl = new_label(cg)
    falsel = new_label(cg)
    if op == "&&"
        gen_expr(cg, e[2])
        gen_truth_jump(cg, e[2], falsel)
        gen_expr(cg, e[3])
        gen_truth_jump(cg, e[3], falsel)
        asmput("    mov rax, 22")
        asmput("    jmp " . endl)
        asmput(falsel . ":")
        asmput("    mov rax, 14")
    else
        nextl = new_label(cg)
        gen_expr(cg, e[2])
        gen_truth_jump(cg, e[2], nextl)
        asmput("    mov rax, 22")
        asmput("    jmp " . endl)
        asmput(nextl . ":")
        gen_expr(cg, e[3])
        gen_truth_jump(cg, e[3], falsel)
        asmput("    mov rax, 22")
        asmput("    jmp " . endl)
        asmput(falsel . ":")
        asmput("    mov rax, 14")
    asmput(endl . ":")

// ---- unboxed float locals --------------------------------------------------
//
// A float is normally a pointer to an 8-byte double in the arena (SPEC 3.6,
// tag 010), because a 64-bit double can't share a 64-bit word with a 3-bit
// tag. A box is allocated per value, so a float loop pays for every
// intermediate it computes: mandelbrot allocated about 8 boxes per inner
// iteration and peaked at over 200 MB of doubles it had finished with.
//
// A local whose every assignment is known to be a float doesn't need the box:
// its home can hold the raw double. infer_local_kinds below decides which
// locals those are. It's an optimistic fixpoint that gives every local a kind,
// because deciding "is this a float" for one local means knowing it for the
// locals its assignments read.
//
// Two representations for one kind mean a site that reads or writes the wrong
// one corrupts the value with no fault, so the design keeps that risk to the
// side that can be listed. A home is written by a declaration, by `=` on a bare
// name, by a for-each header, and for a parameter by its callers. A for-each
// variable is never a float local (fl_bound), and a parameter is one only when
// every caller passes a float, which gen_call then pushes raw. The read side is
// open-ended (arguments, joins, index stores, returns, sort, map keys, and
// whatever is added next), so it isn't listed at all: the ordinary read path
// (gen_expr, kind 13) boxes, and only the paths that want a raw double
// (gen_float_expr and its leaves, the assignment store, a raw float argument)
// read a home directly. A read site nobody thought about is slow, never wrong.
//
// It took mandelbrot from 332 ms to 77 ms and from 216 MB to 260 KB, with no
// call and no allocation left in the inner loop. A float-free program is
// untouched: no local can be a float there, and the float paths are gated on
// cg[14] like the rest of the float layer.

// The kind the fixpoint proved for a local of the function being emitted, in
// cg_kind's terms (0 integer, 1 region, 3 float, 2 nothing known, and so on).
// A name is the one leaf cg_kind can't read off the syntax, and leaving them
// all at 2 would make a mixed expression like `px * 3.5` a run-time dispatch
// instead of inline code. The table maps a name to its entry
// (infer_local_kinds).
local_kind(cg, name)
    fl = cg[23]
    if fl == 0
        return 2
    if !has(fl, name)
        return 2
    return fl[name][1]

is_float_local(cg, name)
    if local_kind(cg, name) == 3
        return true
    return false

// ---- u32 locals: proven-32-bit integers, kept raw -------------------------
//
// A local whose every assignment lands in [0, 2^32) is kept in its home
// untagged, and arithmetic on it runs in 32-bit registers, where the hardware
// truncates to 32 bits and zero-extends for free. So `x = (x + y) & 4294967295`
// is an `add eax, ...` with no untag, no retag, no overflow check and no mask,
// and a rotate is one `rol eax`. The ARX crypto is built from these: every
// ChaCha20 state word and every SHA-256 working variable is masked to 32 bits
// on each write. It works like the unboxed float locals: a raw home, a
// non-leaf so every ordinary read goes through gen_expr, and a boundary step
// there (a tag, where a float gets a box) so a call, a store into a region, a
// compare or `out` still sees the tagged word it expects.

// 1 when `name` is a u32 local of the function being emitted. cg[44] maps each
// candidate to 1, or to 0 once the pass has demoted it (infer_u32_locals).
is_u32_local(cg, name)
    tbl = cg[44]
    if tbl == 0
        return 0
    if !has(tbl, name)
        return 0
    return tbl[name]

// Is the value of `e` provably in [0, 2^32) on every execution? That's the
// range that makes raw storage sound: such a value equals its own low 32 bits,
// so a 32-bit load rebuilds it and a tag (`2v+1 < 2^33`) never overflows. A
// shape not listed answers 0. An unmasked rotate isn't listed: its `x << L`
// arm runs past bit 31 (see the rotate idiom). gen_u32 computes the value mod
// 2^32 for more shapes than this, which is a looser promise, and it's only
// safe because gen_u32 is reached only under a mask that keeps the low 32
// bits.
cg_u32(cg, e)
    k = e[0]
    if k == 11
        if e[1] >= 0 && e[1] <= 4294967295
            return 1
        return 0
    if k == 13
        return is_u32_local(cg, e[1])
    if k == 14
        b = cg_bits(cg, e)
        if b >= 0 && b <= 32
            return 1
        op = e[1]
        // `a & b` is bounded by either operand, so one u32 side is enough. The
        // mask `& 4294967295` is the common one, and it makes the whole
        // expression u32 whatever the other side is.
        if op == "&"
            if cg_u32(cg, e[2]) == 1
                return 1
            return cg_u32(cg, e[3])
        // A bitwise combine of two u32s is u32, and a right shift of a u32
        // only shrinks it.
        if op == "|" || op == "^"
            if cg_u32(cg, e[2]) == 1 && cg_u32(cg, e[3]) == 1
                return 1
            return 0
        if op == ">>"
            if cg_u32(cg, e[2]) == 1 && e[3][0] == 11 && e[3][1] >= 0
                return 1
            return 0
        return 0
    if k == 16
        b = cg_bits(cg, e)
        if b >= 0 && b <= 32
            return 1
        return 0
    return 0

// How many bits a value provably fits in, or -1 when nothing is known. It's
// narrow: it exists for one idiom, the little-endian load the ARX crypto starts
// every block with,
//
//     x = k[0] | (k[1] << 8) | (k[2] << 16) | (k[3] << 24)
//
// where each element of a byte-backed region is 8 bits, a shift adds its
// distance, and an `or` takes the wider side. Without it the expression can't
// be proved to fit, and the state word falls off the 32-bit path, taking the
// rest of the round with it. Anything not listed answers -1, and cg_u32 only
// trusts an answer of 32 or fewer.
cg_bits(cg, e)
    k = e[0]
    if k == 11
        v = e[1]
        if v < 0
            return 0 - 1
        n = 0
        loop v > 0
            v = idiv(v, 2)
            n = n + 1
        return n
    if k == 16
        // an element of a byte-backed region is one byte
        sb = cg_sub(cg, e[1])
        if sb == 1 || sb == 4
            return 8
        return 0 - 1
    if k == 14
        op = e[1]
        if op == "<<"
            if e[3][0] != 11
                return 0 - 1
            d = e[3][1]
            if d < 0 || d > 32
                return 0 - 1
            lb = cg_bits(cg, e[2])
            if lb < 0
                return 0 - 1
            return lb + d
        if op == "|" || op == "^"
            lb = cg_bits(cg, e[2])
            rb = cg_bits(cg, e[3])
            if lb < 0 || rb < 0
                return 0 - 1
            if lb > rb
                return lb
            return rb
        if op == "&"
            lb = cg_bits(cg, e[2])
            rb = cg_bits(cg, e[3])
            if lb >= 0 && rb >= 0
                if lb < rb
                    return lb
                return rb
            if lb >= 0
                return lb
            return rb
        if op == ">>"
            if e[3][0] != 11
                return 0 - 1
            d = e[3][1]
            if d < 0
                return 0 - 1
            lb = cg_bits(cg, e[2])
            if lb < 0
                return 0 - 1
            if d >= lb
                return 0
            return lb - d
        return 0 - 1
    return 0 - 1

// Names bound by a for-each header, at any depth: their slot receives a tagged
// element word from the subject region, so nothing about them is known here.
// `acc` is a map, and each name is a key in it.
fl_bound(stmts, acc)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 6
            acc = fl_bound(s[2], acc)
            if s[3] != 0
                acc = fl_bound(s[3], acc)
        else if k == 7
            acc = fl_bound(s[2], acc)
        else if k == 20
            acc[s[1]] = 1
            acc = fl_bound(s[3], acc)
        i = i + 1
    return acc

// Join a newly seen assignment kind into a local's entry, and report whether
// that moved it. The lattice is one level deep: not-yet (-1) rises to a single
// kind, and two different kinds rise to 2. A value only ever climbs, so the
// iteration below always ends.
fl_join(fl, name, k)
    if !has(fl, name)
        return 0
    e = fl[name]
    old = e[1]
    if old == 2
        return 0
    if k == 0 - 1
        return 0
    if old == 0 - 1
        e[1] = k
        return 1
    if old == k
        return 0
    e[1] = 2
    return 1

// The same join for a local's region subkind, which says whether an indexed
// access needs its run-time dispatch:
//
//   0  nothing known: the access keeps every check
//   1  byte-backed, and freshly allocated (so not a literal)
//   2  word-backed, and freshly allocated
//   3  word-backed, but possibly a literal (a string literal, or what decode
//      or pad may hand back)
//   4  byte-backed, but a literal: a bytes("...") blob, which reads as bytes
//      and must still fault if written to
//
// 2 and 3 join to 3, not 0, because a read only needs the element width and
// doesn't care whether the region is writable.
fl_join_sub(fl, name, k)
    if !has(fl, name)
        return 0
    e = fl[name]
    old = e[2]
    if old == 0
        return 0
    if k == 0 - 1
        return 0
    if old == 0 - 1
        e[2] = k
        return 1
    if old == k
        return 0
    if (old == 2 && k == 3) || (old == 3 && k == 2)
        if old == 3
            return 0
        e[2] = 3
        return 1
    e[2] = 0
    return 1

// The same join for a local's known length. -1 is "not yet", -2 is "unknown",
// and anything else is the element count the allocation asked for.
fl_join_len(fl, name, k)
    if !has(fl, name)
        return 0
    e = fl[name]
    old = e[3]
    if old == 0 - 2
        return 0
    if k == 0 - 1
        return 0
    if old == 0 - 1
        e[3] = k
        return 1
    if old == k
        return 0
    e[3] = 0 - 2
    return 1

// The constant element index this access uses, or -1 when it isn't a literal
// the bound can be checked against here. A literal index into a region whose
// length is known is in range or it isn't, and the compiler can tell which. In
// range, the check is dropped. Past the end, it answers -1 and the access keeps
// its check, which faults when the line runs.
const_idx(cg, rgn, idx)
    if idx[0] != 11
        return 0 - 1
    v = idx[1]
    if v < 0
        return 0 - 1
    L = cg_len(cg, rgn)
    if L < 0
        return 0 - 1
    if v >= L
        return 0 - 1
    // x86-64 folds the index into a signed 32-bit displacement, (v + 1) * 8 for
    // a word element. From 2^28 - 1 up that would wrap negative and the access
    // would land about 2 GB below the region, so an index that large goes
    // through a register and keeps its bounds check.
    if v > 268435454
        return 0 - 1
    return v

// A local's known length, or -2.
local_len(cg, name)
    fl = cg[23]
    if fl == 0
        return 0 - 2
    if !has(fl, name)
        return 0 - 2
    e = fl[name]
    if e[3] == 0 - 1
        return 0 - 2
    return e[3]

// The element count an expression allocates, when it's known: the three
// constructors given a literal size, or a bytes("...") blob. That's what makes
// `r = text(3)` followed by `r[0] = ...` a store with no bounds check, since
// the index and the bound are both constants the compiler can compare.
cg_len(cg, e)
    k = e[0]
    if k == 13
        return local_len(cg, e[1])
    if k == 17
        nm = e[1]
        if fn_is_known(cg, nm) == 1
            return 0 - 2
        if nm == "bytes"
            if is_byte_blob(e)
                return idiv(len(lget(e[2], 0)[1]), 2)
        if nm == "bytes" || nm == "text" || nm == "array"
            if lcount(e[2]) > 0
                a = lget(e[2], 0)
                if a[0] == 11
                    if a[1] >= 0
                        return a[1]
            return 0 - 2
        return 0 - 2
    return 0 - 2

// A local's region subkind, or 0 when nothing is known.
local_sub(cg, name)
    fl = cg[23]
    if fl == 0
        return 0
    if !has(fl, name)
        return 0
    e = fl[name]
    if e[2] == 0 - 1
        return 0
    return e[2]

// The region subkind an expression produces, or 0. bytes(n), read, asmtake and
// encode give bytes, and text, array, keys, split, args, env, in and char give
// word-backed elements. copy carries its operand's shape, sort always answers
// word-backed, and a join is byte-backed only when both sides are (SPEC 3.4).
// A text literal is word-backed but lives in the literal pool, so it's 3 and
// not 2, and so is what decode or pad may hand back. A function the program
// defines answers what pk_ret_sub proved.
cg_sub(cg, e)
    k = e[0]
    if k == 12
        return 3
    if k == 13
        return local_sub(cg, e[1])
    if k == 14
        if e[1] == "."
            ls = cg_sub(cg, e[2])
            rs = cg_sub(cg, e[3])
            // Both sides byte-backed, so the result is too. Subkind 4 (a
            // bytes("...") blob) is byte-backed as well and has to count here:
            // leaving it out would call the result word-backed, and the use
            // site would read a byte-backed region eight bytes at a time.
            // Whether an operand is a literal says nothing about the answer's
            // backing, or about whether the answer is fresh, since a join
            // always allocates.
            if (ls == 1 || ls == 4) && (rs == 1 || rs == 4)
                return 1
            // A word-backed left operand makes a word-backed result whatever
            // the right one is, since a mixed pair promotes, so an unknown
            // right operand doesn't make the answer unknown. That matters for
            // `s = s . "<" . i . ">"`, where the number in the middle would
            // otherwise make the whole chain unknown.
            if ls == 2 || ls == 3
                return 2
            if ls > 0 && rs > 0
                return 2
            return 0
        return 0
    if k == 17
        nm = e[1]
        if fn_is_known(cg, nm) == 1
            return pk_ret_sub(cg, nm)
        if nm == "bytes"
            if is_byte_blob(e)
                return 4
            return 1
        if nm == "read" || nm == "asmtake"
            return 1
        if nm == "text" || nm == "array"
            return 2
        if nm == "keys" || nm == "split"
            return 2
        if nm == "args" || nm == "env"
            return 2
        if nm == "in" || nm == "char"
            return 2
        // sort promotes a byte-backed operand to word-backed (SPEC 3.4), so it
        // doesn't carry the shape: it always answers word-backed. Getting this
        // wrong would read the low byte of a tagged word and tag it again.
        if nm == "sort"
            return 2
        // decode and pad may hand back their argument untouched (decode when
        // it's already code points, pad when it's already wide enough), so the
        // result can be the caller's literal: word-backed, maybe not writable.
        if nm == "decode" || nm == "pad"
            return 3
        // encode always allocates, and what it allocates is byte-backed, so
        // len() of it counts bytes.
        if nm == "encode"
            return 1
        // copy allocates and carries the operand's shape (SPEC 9): a copy of a
        // byte-backed buffer is byte-backed, and a copy of a literal is
        // word-backed and writable.
        if nm == "copy"
            if lcount(e[2]) > 0
                a = cg_sub(cg, lget(e[2], 0))
                if a == 3
                    return 2
                if a == 4
                    return 1
                return a
            return 0
        return 0
    return 0

// One sweep: every assignment in the body joins its right-hand side's kind into
// the target local. Returns 1 if anything moved.
fl_pass(cg, fl, stmts)
    ch = 0
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 4
            ch = ch + fl_join(fl, s[1], cg_kind(cg, s[2]))
            ch = ch + fl_join_sub(fl, s[1], cg_sub(cg, s[2]))
            ch = ch + fl_join_len(fl, s[1], cg_len(cg, s[2]))
        else if k == 5
            tgt = s[1]
            if tgt[0] == 13
                ch = ch + fl_join(fl, tgt[1], cg_kind(cg, s[2]))
                ch = ch + fl_join_sub(fl, tgt[1], cg_sub(cg, s[2]))
                ch = ch + fl_join_len(fl, tgt[1], cg_len(cg, s[2]))
        else if k == 6
            ch = ch + fl_pass(cg, fl, s[2])
            if s[3] != 0
                ch = ch + fl_pass(cg, fl, s[3])
        else if k == 7
            ch = ch + fl_pass(cg, fl, s[2])
        else if k == 20
            ch = ch + fl_pass(cg, fl, s[3])
        i = i + 1
    if ch > 0
        return 1
    return 0

// Locals the compiler makes for itself, which the inference below can't see
// assigned because codegen writes them and no statement does: `@n` is a
// hoisted length (SPEC 7.2), the tagged result of `len`, and `@i` a for-each
// index, a count gen_foreach keeps untagged and only reads itself. Both hold
// whole numbers by construction. Saying so keeps `loop i < len(a)` at a
// two-instruction test after the length moves out of the loop. Without it the
// hoisted name reads as unknown, and the test pays for a tag dispatch. -2
// means "not one of mine". `@p`, the region a for-each walks, isn't claimed:
// the subject expression can turn out to be a number, and the checks that
// catch that are the ones a stated kind would remove.
hidden_kind(nm)
    if len(nm) < 2
        return 0 - 2
    if nm[0] != 64
        return 0 - 2
    c = nm[1]
    if c == 105 || c == 110
        return 0
    return 0 - 2

// Infer a kind for every local of one function, optimistically: start each at
// "nothing known yet" and sweep until nothing moves. Reading a local that isn't
// known yet answers -1, which propagates through arithmetic and is ignored by
// the join, so a value used before its defining sweep never invents a kind. It
// waits for the next pass. What a local ends at is the join of every
// assignment to it, which is what its kind claims.
infer_local_kinds(cg, params, body, settle)
    cg[23] = 0
    locals = collect_locals(body, mklist(8))
    bound = fl_bound(body, {})
    // The table maps each name to its entry [name, kind, subkind, length], so
    // a lookup is a hash. Walking a list made a function with 20,000 locals
    // quadratic to compile.
    fl = {}
    // Parameters come first, as they do in the frame's env, so a body local
    // with a parameter's name never gets a second entry. Each starts at what
    // the whole-program pass proved every caller passes (2 when there's no
    // table, which is what a contract wrapper's frame and the pass's own first
    // sweep both want), and the join below can still raise it if the body
    // assigns something else to it.
    pi = 0
    loop pi < lcount(params)
        pent = text(4)
        pent[0] = lget(params, pi)
        pent[1] = param_kind_at(cg, pi)
        pent[2] = param_sub_at(cg, pi)
        // A parameter's length is whatever the caller allocated. It can't be
        // known here, and it isn't worth an interprocedural pass: the shapes
        // this pays off on (a table, a record) are allocated where they're used.
        pent[3] = 0 - 2
        if !has(fl, pent[0])
            fl[pent[0]] = pent
        pi = pi + 1
    i = 0
    loop i < lcount(locals)
        nm = lget(locals, i)
        if !has(fl, nm)
            ent = text(4)
            ent[0] = nm
            ent[1] = 0 - 1
            ent[2] = 0 - 1
            ent[3] = 0 - 1
            // A for-each binding is written by the loop header, not by an
            // assignment, so nothing here can reason about it. It's pinned at
            // "nothing known", where the join leaves it.
            if has(bound, nm)
                ent[1] = 2
                ent[2] = 0
                ent[3] = 0 - 2
            hk = hidden_kind(nm)
            if hk != 0 - 2
                ent[1] = hk
                ent[2] = 0
                ent[3] = 0 - 2
            fl[nm] = ent
        i = i + 1
    cg[23] = fl
    ch = 1
    loop ch == 1
        ch = fl_pass(cg, fl, body)
    if settle == 1
        fl_settle(fl, params)
        fl_settle(fl, locals)
    return fl

// What the sweep never decided becomes "nothing known", for every name in
// `names` (the table holds exactly the parameters and the locals).
fl_settle(fl, names)
    j = 0
    loop j < lcount(names)
        e = fl[lget(names, j)]
        if e[1] == 0 - 1
            e[1] = 2
        if e[2] == 0 - 1
            e[2] = 0
        if e[3] == 0 - 1
            e[3] = 0 - 2
        j = j + 1
    return 0

// Demote `name` to non-u32 in the working table, and report whether that moved
// it.
u32_demote(tbl, name)
    if !has(tbl, name)
        return 0
    if tbl[name] == 1
        tbl[name] = 0
        return 1
    return 0

// Is `name` still a u32 candidate (present in the working table)?
u32_cand(tbl, name)
    return has(tbl, name)

// One sweep: an assignment whose right-hand side isn't provably u32, under the
// current optimistic assumptions, demotes its target. It only ever demotes, so
// the fixpoint below ends. It's the mirror of fl_pass, which only ever raises.
u32_pass(cg, tbl, stmts)
    ch = 0
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 4
            if u32_cand(tbl, s[1]) && cg_u32(cg, s[2]) == 0
                ch = ch + u32_demote(tbl, s[1])
        else if k == 5
            tgt = s[1]
            if tgt[0] == 13
                if u32_cand(tbl, tgt[1]) && cg_u32(cg, s[2]) == 0
                    ch = ch + u32_demote(tbl, tgt[1])
        else if k == 6
            ch = ch + u32_pass(cg, tbl, s[2])
            if s[3] != 0
                ch = ch + u32_pass(cg, tbl, s[3])
        else if k == 7
            ch = ch + u32_pass(cg, tbl, s[2])
        else if k == 20
            ch = ch + u32_pass(cg, tbl, s[3])
        i = i + 1
    if ch > 0
        return 1
    return 0

// Which of a function's integer locals hold a 32-bit value on every write, and
// so can live raw (is_u32_local). Candidates are the body's own kind-0 locals,
// never a parameter (its home arrives tagged from the caller), a for-each
// binding (a tagged element) or a hidden local the compiler made. Every
// candidate starts at u32, and a sweep to a fixpoint demotes any whose
// assignments aren't all provably u32. It has to run after cg[23] is built, so
// local_kind is decided.
infer_u32_locals(cg, params, body)
    cg[44] = 0
    // Only in a float-free program. With floats in play, an integer local can
    // still be pulled into float arithmetic, and the integer-to-double
    // conversion (gen_float_leaf) reads the home as a tagged word. Keeping u32
    // locals out of float programs is simpler than teaching every float path
    // about raw homes, and the crypto that wants them is float-free.
    if cg[14] == 1
        return 0
    locals = collect_locals(body, mklist(8))
    pset = name_set(params)
    bound = fl_bound(body, {})
    // The table maps each candidate to 1, and to 0 once it's demoted.
    tbl = {}
    i = 0
    loop i < lcount(locals)
        nm = lget(locals, i)
        // Never a hidden local the compiler made (`@n` a hoisted length, `@p`
        // and `@i` a for-each subject and index). collect_locals lists them so
        // they get a slot, but no source statement assigns them, so u32_pass
        // would never demote them from the optimistic start. gen_loop stores
        // `@n` tagged and reads it through gen_expr, so marking it u32 would
        // tag it twice, and `@p` and `@i` are gen_foreach's own. `@` isn't a
        // legal identifier character, so the test excludes only those.
        // Parameters (their home arrives tagged) and for-each bindings (a
        // tagged element) are excluded too.
        if nm[0] != 64 && !has(pset, nm) && !has(bound, nm) && local_kind(cg, nm) == 0
            tbl[nm] = 1
        i = i + 1
    cg[44] = tbl
    ch = 1
    loop ch == 1
        ch = u32_pass(cg, tbl, body)
    return tbl

// The kind proved for parameter `pi` of the function being emitted. cg[25] is
// its row in the whole-program table, or 0 when there's none (a contract
// wrapper's frame, or the inference's own first sweep), and then a parameter
// assumes nothing.
param_kind_at(cg, pi)
    ks = cg[25]
    if ks == 0
        return 2
    if pi >= len(ks)
        return 2
    return ks[pi]

// The row for `name` in the whole-program table, or 0. infer_param_kinds builds
// the rows: [name, parameter kinds, queued, params, body, return kind, callers,
// first visit done, parameter subkinds, return subkind]. Only a function whose
// row moved goes back on the worklist, since one whose parameter kinds didn't
// move reports the same argument kinds at its call sites as last time. cg[24]
// maps each name to its row, because this is asked once per call site on every
// visit of a whole-program fixpoint.
pk_lookup_ent(cg, name)
    tbl = cg[24]
    if tbl == 0
        return 0
    if !has(tbl, name)
        return 0
    return tbl[name]

// The kind a call to `nm` answers with, from the whole-program table. It's -1
// while the fixpoint hasn't decided, which propagates as "ask me again" the way
// an undecided local does, and 2 once settled means assume nothing.
pk_ret_kind(cg, nm)
    ent = pk_lookup_ent(cg, nm)
    if ent == 0
        return 2
    rk = ent[5]
    return rk[0]

pk_ret_sub(cg, nm)
    ent = pk_lookup_ent(cg, nm)
    if ent == 0
        return 0
    rsk = ent[9]
    if rsk[0] == 0 - 1
        return 0
    return rsk[0]

pk_lookup_sub(cg, name)
    ent = pk_lookup_ent(cg, name)
    if ent == 0
        return 0
    return ent[8]

pk_lookup(cg, name)
    e = pk_lookup_ent(cg, name)
    if e == 0
        return 0
    return e[1]

// Join a call site's argument kind into a parameter, on the same one-level
// lattice the local inference uses, and report whether it moved.
pk_join(ks, i, k)
    old = ks[i]
    if old == 2
        return 0
    if k == 0 - 1
        return 0
    if old == 0 - 1
        ks[i] = k
        return 1
    if old == k
        return 0
    ks[i] = 2
    return 1

// The subkind join for a parameter: the lattice of fl_join_sub, over the
// whole-program table.
pk_join_sub(ks, i, k)
    old = ks[i]
    if old == 0
        return 0
    if k == 0 - 1
        return 0
    if old == 0 - 1
        ks[i] = k
        return 1
    if old == k
        return 0
    if (old == 2 && k == 3) || (old == 3 && k == 2)
        if old == 3
            return 0
        ks[i] = 3
        return 1
    ks[i] = 0
    return 1

// A parameter's inferred region subkind, or 0 when nothing is known.
param_sub_at(cg, pi)
    ks = cg[46]
    if ks == 0
        return 0
    if pi >= len(ks)
        return 0
    if ks[pi] == 0 - 1
        return 0
    return ks[pi]

// Find every call in an expression and join its arguments into the callee's
// parameters. word has no function values and no indirect calls, so every call
// names its target and this walk sees the whole call graph.
pk_expr(cg, e)
    k = e[0]
    ch = 0
    if k == 14
        ch = ch + pk_expr(cg, e[2])
        ch = ch + pk_expr(cg, e[3])
    else if k == 15
        ch = ch + pk_expr(cg, e[2])
    else if k == 16
        ch = ch + pk_expr(cg, e[1])
        ch = ch + pk_expr(cg, e[2])
    else if k == 17
        args = e[2]
        i = 0
        loop i < lcount(args)
            ch = ch + pk_expr(cg, lget(args, i))
            i = i + 1
        ent = pk_lookup_ent(cg, e[1])
        if ent != 0
            // Record the reverse edge, once. Parameter kinds travel from caller
            // to callee, so the worklist re-queues the callee. Return kinds
            // travel the other way, and re-visiting the functions a callee's
            // answer affects means knowing who they are. The call graph is
            // static, so recording during each caller's first visit catches all
            // of it: cur[7] stays 0 until that visit ends.
            cur = cg[27]
            if cur != 0
                if cur[7] == 0
                    ent[6] = ladd_grow(ent[6], cur)
            ks = ent[1]
            sks = ent[8]
            j = 0
            loop j < lcount(args)
                if j < len(ks)
                    moved = pk_join(ks, j, cg_kind(cg, lget(args, j)))
                    moved = moved + pk_join_sub(sks, j, cg_sub(cg, lget(args, j)))
                    if moved > 0
                        pk_queue(cg, ent)
                        ch = ch + 1
                j = j + 1
    else if k == 19
        kl = e[1]
        vl = e[2]
        i = 0
        loop i < lcount(kl)
            ch = ch + pk_expr(cg, lget(kl, i))
            ch = ch + pk_expr(cg, lget(vl, i))
            i = i + 1
    return ch

pk_stmts(cg, stmts)
    ch = 0
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 4
            ch = ch + pk_expr(cg, s[2])
        else if k == 5
            ch = ch + pk_expr(cg, s[1])
            ch = ch + pk_expr(cg, s[2])
        else if k == 6
            ch = ch + pk_expr(cg, s[1])
            ch = ch + pk_stmts(cg, s[2])
            if s[3] != 0
                ch = ch + pk_stmts(cg, s[3])
        else if k == 7
            // a bare `loop` has no condition node (0)
            if s[1] != 0
                ch = ch + pk_expr(cg, s[1])
            ch = ch + pk_stmts(cg, s[2])
        else if k == 8
            if s[1] != 0
                ch = ch + pk_expr(cg, s[1])
        else if k == 10
            ch = ch + pk_expr(cg, s[1])
        else if k == 20
            ch = ch + pk_expr(cg, s[2])
            ch = ch + pk_stmts(cg, s[3])
        i = i + 1
    return ch

// Join the kind of every `return` in this statement list into `rk`. A bare
// `return` hands back the integer 0, and so does falling off the end, which
// body_always_returns is asked about.
pk_ret_scan(cg, stmts, rk)
    ch = 0
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 8
            if s[1] != 0
                ch = ch + pk_join(rk, 0, cg_kind(cg, s[1]))
            else
                ch = ch + pk_join(rk, 0, 0)
        else if k == 6
            ch = ch + pk_ret_scan(cg, s[2], rk)
            if s[3] != 0
                ch = ch + pk_ret_scan(cg, s[3], rk)
        else if k == 7
            ch = ch + pk_ret_scan(cg, s[2], rk)
        else if k == 20
            ch = ch + pk_ret_scan(cg, s[3], rk)
        i = i + 1
    return ch

// The same walk for the return subkind. A bare `return` answers the number 0,
// which isn't a region at all, so it joins 0 (nothing known), as falling off
// the end does in pk_visit.
pk_ret_sub_scan(cg, stmts, rk)
    ch = 0
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 8
            if s[1] != 0
                ch = ch + pk_join_sub(rk, 0, cg_sub(cg, s[1]))
            else
                ch = ch + pk_join_sub(rk, 0, 0)
        else if k == 6
            ch = ch + pk_ret_sub_scan(cg, s[2], rk)
            if s[3] != 0
                ch = ch + pk_ret_sub_scan(cg, s[3], rk)
        else if k == 7
            ch = ch + pk_ret_sub_scan(cg, s[2], rk)
        else if k == 20
            ch = ch + pk_ret_sub_scan(cg, s[3], rk)
        i = i + 1
    return ch

// Does this body always leave through a `return`? Only a trailing `return`
// counts, which is conservative. Anything else might fall off the end, which
// hands back the integer 0, and a function that can do that can't carry its
// result in xmm0.
body_always_returns(stmts)
    c = lcount(stmts)
    if c == 0
        return false
    s = lget(stmts, c - 1)
    if s[0] == 8
        return true
    return false

// Everything that calls `ent` has to look at its return kind again.
pk_requeue_callers(cg, ent)
    cs = ent[6]
    i = 0
    loop i < lcount(cs)
        pk_queue(cg, lget(cs, i))
        i = i + 1

// Put a function back on the worklist, unless it's already on it. ent[2] is
// that flag: "queued", cleared the moment the function is taken off.
pk_queue(cg, ent)
    if ent[2] == 1
        return 0
    ent[2] = 1
    cg[26] = ladd_grow(cg[26], ent)

// One visit to one function: settle its locals against the row its callers have
// filled in, join what the body does to its own parameters back into that row,
// then let its calls push what it knows into its callees.
//
// Joining the body back in makes the row the settled kind and not just what
// call sites pass. Both sides of a call read this row to decide a float
// parameter's representation, so if a parameter every caller hands a float is
// assigned a region inside, both sides go back to the boxed form together.
pk_visit(cg, ent)
    cg[25] = ent[1]
    cg[46] = ent[8]
    cg[27] = ent
    cg[23] = infer_local_kinds(cg, ent[3], ent[4], 0)
    ks = ent[1]
    sks = ent[8]
    pi = 0
    loop pi < lcount(ent[3])
        moved = pk_join(ks, pi, local_kind(cg, lget(ent[3], pi)))
        moved = moved + pk_join_sub(sks, pi, local_sub(cg, lget(ent[3], pi)))
        if moved > 0
            pk_queue(cg, ent)
        pi = pi + 1
    rk = ent[5]
    moved = 0
    if !body_always_returns(ent[4])
        moved = moved + pk_join(rk, 0, 0)
    moved = moved + pk_ret_scan(cg, ent[4], rk)
    rsk = ent[9]
    if !body_always_returns(ent[4])
        moved = moved + pk_join_sub(rsk, 0, 0)
    moved = moved + pk_ret_sub_scan(cg, ent[4], rsk)
    if moved > 0
        pk_requeue_callers(cg, ent)
    pk_stmts(cg, ent[4])
    ent[7] = 1
    cg[27] = 0

infer_param_kinds(cg, items, tops)
    tbl = {}
    ents = mklist(64)
    cg[26] = mklist(64)
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 2
            ps = it[2]
            ks = text(lcount(ps))
            j = 0
            loop j < lcount(ps)
                ks[j] = 0 - 1
                j = j + 1
            ent = text(10)
            ent[0] = it[1]
            ent[1] = ks
            ent[2] = 1
            ent[3] = ps
            ent[4] = it[3]
            // ent[5]: the return kind, in a one-slot array so pk_join serves it
            // too. A contract-guarded function is pinned to "assume nothing"
            // before anything is inferred: its wrapper carries the body's answer
            // through a general register and hands it to an `:after` hook as a
            // tagged value, so it can't be the one shape that travels in xmm0.
            rk = text(1)
            rk[0] = 0 - 1
            if in_before_or_after(cg, it[1])
                rk[0] = 2
            ent[5] = rk
            ent[6] = mklist(4)
            ent[7] = 0
            // ent[8]: the parameters' region subkinds, inferred the same way
            // and on the same worklist. This is what lets an indexed access
            // inside sha256(msg) know that msg is byte-backed, which the
            // per-function pass can't see because a parameter comes from
            // outside it.
            sks = text(lcount(ps))
            j = 0
            loop j < lcount(ps)
                sks[j] = 0 - 1
                j = j + 1
            ent[8] = sks
            // ent[9]: the return subkind, in a one-slot array so pk_join_sub
            // serves it too. Without it the chain of shapes would break at
            // every function boundary: a bytes() built inside
            // hkdf_expand_label and handed back is what the record layer then
            // indexes.
            rsk = text(1)
            rsk[0] = 0 - 1
            if in_before_or_after(cg, it[1])
                rsk[0] = 0
            ent[9] = rsk
            tbl[it[1]] = ent
            ents = ladd_grow(ents, ent)
            cg[26] = ladd_grow(cg[26], ent)
        i = i + 1
    cg[24] = tbl
    // The two shapes walked only once. A contract hook body lives in the
    // wrapper's frame, where the guarded function's parameters are in scope
    // under names this pass can't resolve, so it assumes nothing and only
    // collects its calls. The top level has no parameters for anyone to fill
    // in. Neither can change between visits: they only ever seed their callees.
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 3
            cg[25] = 0
            cg[46] = 0
            cg[23] = infer_local_kinds(cg, mklist(1), it[2], 0)
            pk_stmts(cg, it[2])
        i = i + 1
    cg[25] = 0
    cg[46] = 0
    cg[23] = infer_local_kinds(cg, mklist(1), tops, 0)
    pk_stmts(cg, tops)
    // Then run the worklist down. Every parameter's kind only climbs a
    // three-step lattice (nothing known yet, one kind, assume nothing), so the
    // number of visits is bounded by the program's size whatever shape the call
    // graph has. Re-scanning every function on each pass cost a whole pass per
    // link of a call chain: 4,000 chained functions once took 406 seconds.
    loop lcount(cg[26]) > 0
        w = cg[26]
        c = lcount(w)
        ent = lget(w, c - 1)
        w[0] = c - 1
        // Cleared before the walk, so a function that re-queues itself (any
        // recursion) is queued again by its own visit.
        ent[2] = 0
        pk_visit(cg, ent)
    // A function nobody calls keeps its parameters at "nothing known yet".
    // Settle those to "assume nothing" before codegen reads them.
    i = 0
    loop i < lcount(ents)
        e = lget(ents, i)
        ks = e[1]
        j = 0
        loop j < len(ks)
            if ks[j] == 0 - 1
                ks[j] = 2
            j = j + 1
        sks = e[8]
        j = 0
        loop j < len(sks)
            if sks[j] == 0 - 1
                sks[j] = 0
            j = j + 1
        rsk = e[9]
        if rsk[0] == 0 - 1
            rsk[0] = 0
        rk = e[5]
        if rk[0] == 0 - 1
            rk[0] = 2
        i = i + 1
    cg[25] = 0
    cg[46] = 0
    cg[23] = 0
    cg[26] = 0
    cg[27] = 0

// A leaf that loads straight into an xmm register with no call and no
// allocation: an unboxed float local, an integer local, an integer literal, or
// a float literal.
is_float_leaf(cg, e)
    k = e[0]
    if k == 11
        return true
    if k == 18
        return true
    if k == 13
        // A float local loads its raw double, and an integer local converts
        // without a call. Anything else needs the call at the end of
        // gen_float_expr.
        lk = local_kind(cg, e[1])
        if lk == 3 || lk == 0
            return true
        return false
    return false

// Load such a leaf into `x`. It clobbers rax, and xmm3 for a float literal
// that missed the pool. xmm3 is reserved as scratch and never holds a live
// value.
gen_float_leaf(cg, e, x)
    k = e[0]
    if k == 13
        // An unboxed local already holds a raw double, so one move loads it
        // (movsd from a slot, movapd from a pinned register), with no trip
        // through rax.
        if is_float_local(cg, e[1])
            h = env_lookup(cg, e[1])
            asmput("    " . fmov_from(h) . " " . x . ", " . h)
        else
            asmput("    mov rax, " . env_lookup(cg, e[1]))
            asmput("    sar rax, 1")
            asmput("    pxor " . x . ", " . x)
            asmput("    cvtsi2sd " . x . ", rax")
    else if k == 11
        asmput("    movabs rax, " . e[1])
        asmput("    pxor " . x . ", " . x)
        asmput("    cvtsi2sd " . x . ", rax")
    else
        if e[5] >= 0
            asmput("    movsd " . x . ", [rip+flit" . e[5] . "]")
        else
            // A float literal the prepass didn't reach. prepass_literals walks
            // every expression and gives each float literal a slot, so this
            // shouldn't run. If it did, it would be wrong: it divides node[1]
            // by node[2], from when a literal was a numerator and a
            // denominator, and node[2] is a decimal exponent now
            // (gen_float_lit uses f64_hex instead).
            asmput("    movabs rax, " . e[1])
            asmput("    pxor " . x . ", " . x)
            asmput("    cvtsi2sd " . x . ", rax")
            asmput("    movabs rax, " . e[2])
            asmput("    pxor xmm3, xmm3")
            asmput("    cvtsi2sd xmm3, rax")
            asmput("    divsd " . x . ", xmm3")

// A pooled float literal can be the memory operand of an SSE arithmetic or
// compare instruction, so it needs no load into a register:
// `mulsd xmm0, [rip+flit0]`. Only as the second operand, which is where the
// right-hand side of `a * 0.5` and of `x > 1000000.0` already sits. "" means
// "not one of those".
flit_operand(e)
    if e[0] != 18
        return ""
    if e[5] < 0
        return ""
    return "[rip+flit" . e[5] . "]"

// The same trick for an unboxed local: its home already holds the raw double,
// so `mulsd xmm0, [rbp-8]` (or `mulsd xmm0, xmm8` when it's pinned) reads it in
// place instead of loading it into xmm1 first. A slot is rbp-relative, so a
// push inside the left operand's evaluation can't move it, and nothing between
// the two can write the local, since word has no way for a callee to assign a
// caller's local.
//
// Only as the second operand, which is where `x * x`, `a + rate` and
// `d > limit` already put it.
sse_operand(cg, e)
    m = flit_operand(e)
    if len(m) > 0
        return m
    if e[0] != 13
        return ""
    if !is_float_local(cg, e[1])
        return ""
    return env_lookup(cg, e[1])

// Evaluate `e` into xmm0 as a raw double. The shapes it knows allocate nothing,
// and any shape it doesn't know falls back to the ordinary boxed evaluation
// plus rt_to_double, so a node kind added later is slower here, never wrong. It
// clobbers rax, r10, xmm1 and xmm3, and whatever a call inside it clobbers.
gen_float_expr(cg, e)
    k = e[0]
    if is_float_leaf(cg, e)
        gen_float_leaf(cg, e, "xmm0")
        return 0
    if k == 15
        if e[1] == "-" && cg_kind(cg, e[2]) == 3
            gen_float_expr(cg, e[2])
            asmput("    movq rax, xmm0")
            asmput("    movabs r10, 0x8000000000000000")
            asmput("    xor rax, r10")
            asmput("    movq xmm0, rax")
            return 0
    if k == 14
        if is_arith_op(e[1]) && cg_kind(cg, e) == 3
            m = sse_operand(cg, e[3])
            if len(m) > 0
                gen_float_expr(cg, e[2])
                asmput("    " . sse_op(e[1]) . " xmm0, " . m)
                return 0
            gen_float_pair(cg, e)
            asmput("    " . sse_op(e[1]) . " xmm0, xmm1")
            return 0
    if k == 17
        // A call to a function proved to return a float has already left it in
        // xmm0: no box was made and none has to be opened.
        if fn_is_known(cg, e[1]) == 1
            if pk_ret_kind(cg, e[1]) == 3
                gen_call(cg, e)
                return 0
    gen_expr(cg, e)
    // rt_to_double reads a non-float word as a tagged integer, so anything not
    // known to be one of the two number kinds is checked first. A region
    // reaching here has to fault, not be read as a double.
    fk = cg_kind(cg, e)
    if fk != 0 && fk != 3
        numcheck(cg, "rax")
    asmput("    mov rdi, rax")
    asmput("    call rt_to_double")

// Worth comparing as raw doubles when one side is known to be a float and
// neither is unknown until run time. An inline compare of boxed floats was
// tried and was slower (gen_compare), but with unboxed operands there's nothing
// to unbox and nothing to allocate.
is_float_cmp(cg, e)
    lk = cg_kind(cg, e[2])
    rk = cg_kind(cg, e[3])
    if lk != 0 && lk != 3
        return false
    if rk != 0 && rk != 3
        return false
    if lk != 3 && rk != 3
        return false
    return true

// A float expression gen_float_to can build in any register: a float leaf, or an
// arithmetic chain whose left spine ends in a leaf and whose every right operand
// is a pooled literal or a raw float local (sse_operand), like `i * 0.5` or
// `xx - yy + x0`. Nothing in one can fault or call, and building one touches
// only its target register, rax and xmm3.
float_chain(cg, e)
    if is_float_leaf(cg, e)
        return true
    if e[0] == 14
        if is_arith_op(e[1]) && cg_kind(cg, e) == 3
            if len(sse_operand(cg, e[3])) > 0
                return float_chain(cg, e[2])
    return false

// Build a float_chain in `x` directly.
gen_float_to(cg, e, x)
    if is_float_leaf(cg, e)
        gen_float_leaf(cg, e, x)
        return 0
    gen_float_to(cg, e[2], x)
    asmput("    " . sse_op(e[1]) . " " . x . ", " . sse_operand(cg, e[3]))

// `x = <float>` where x is unboxed: evaluate in xmm and store the raw double.
// This is what makes a float loop allocation-free: no box is made for the
// result or for any intermediate.
gen_float_store(cg, name, rhs)
    // A local pinned to an xmm register takes a chain straight into that
    // register (`x = xx - yy + x0` is movapd, subsd, addsd on xmm8) instead of
    // building it in xmm0 and copying it over. Only when the right-hand side
    // doesn't mention the local, since its register is overwritten from the
    // first instruction.
    h = env_lookup(cg, name)
    if is_xmm_home(h) && float_chain(cg, rhs) && !expr_mentions(rhs, name)
        gen_float_to(cg, rhs, h)
        return 0
    gen_float_expr(cg, rhs)
    // One move, and the store stays in the SSE domain. Storing through rax and
    // reading the slot back with movsd is a general-register store feeding a
    // vector load at the same address, which doesn't forward: the load waits
    // for the store to reach L1 instead of taking the value from the store
    // buffer. In mandelbrot's inner loop that stall cost 28% of the wall-clock
    // time even with 38% fewer instructions, so the value is stored the way
    // it's read.
    asmput("    " . fmov_from(h) . " " . h . ", xmm0")

// The move between a raw double's home and an xmm register. A home is a frame
// slot or, for a pinned float local (pick_fpins), an xmm register of its own.
// Between two registers it's movapd, never movsd: the register form of movsd
// writes only the low half, so it waits for whatever last wrote its destination,
// and every float instruction of a loop then queues behind the one before it.
// Pinning mandelbrot's floats with movsd copies measured no faster than leaving
// them in the frame, and with movapd the same loop ran in under half the time.
// movapd writes the whole register, and the renamer performs the copy.
fmov_from(h)
    if is_xmm_home(h)
        return "movapd"
    return "movsd"

is_xmm_home(h)
    if len(h) < 4
        return false
    return h[0] == 120

// A float local's raw bits into rax: a load from its slot, or a movq out of the
// xmm register it's pinned to.
float_home_to_rax(cg, name)
    h = env_lookup(cg, name)
    if is_xmm_home(h)
        asmput("    movq rax, " . h)
    else
        asmput("    mov rax, " . h)

arith_root_is_float(cg, e)
    if !is_arith_op(e[1])
        return false
    if cg_kind(cg, e) != 3
        return false
    return true

// Does this tree contain a call? The scratch xmm registers are caller-saved, so
// a float held across a call has to be held in memory, and anything else may
// stay in a register. A node shape this doesn't know answers 1, which costs a
// spill and never a wrong answer. scope_check_unused asks it too.
expr_has_call(e)
    k = e[0]
    if k == 11 || k == 12 || k == 13 || k == 18 || k == 21
        return 0
    if k == 17
        return 1
    if k == 14
        if expr_has_call(e[2]) == 1
            return 1
        return expr_has_call(e[3])
    if k == 15
        return expr_has_call(e[2])
    if k == 16
        if expr_has_call(e[1]) == 1
            return 1
        return expr_has_call(e[2])
    return 1

// A free xmm to park one live float in, chosen by how deep the nesting is so
// two levels of the same expression can't pick the same one. Generated code
// uses xmm0, xmm1 and xmm3 (the literal scratch), and xmm8-xmm15 are the homes
// of pinned float locals (pick_fpins). xmm2 and xmm4-xmm7 belong to nobody.
// Past five levels of nested float arithmetic the answer is "", and the stack
// takes over.
float_scratch(cg)
    d = cg[38]
    if d == 0
        return "xmm2"
    if d < 5
        return "xmm" . (d + 3)
    return ""

// A binary node's two operands as raw doubles in xmm0 and xmm1. The common
// `<expr> op <leaf>` shape loads the right straight into xmm1, and the left
// only has to be parked when the right needs evaluating.
gen_float_pair(cg, e)
    if is_float_leaf(cg, e[3])
        gen_float_expr(cg, e[2])
        gen_float_leaf(cg, e[3], "xmm1")
        return 0
    // A right operand that is a chain (float_chain) is built straight in xmm1
    // once the left is in xmm0: a chain touches nothing but its target, rax and
    // xmm3, so the left needs no parking. `a * a + b * b` takes five
    // instructions this way, where parking it in xmm2 took eight.
    if float_chain(cg, e[3])
        gen_float_expr(cg, e[2])
        gen_float_to(cg, e[3], "xmm1")
        return 0
    // A leaf on the left needs no saving either: evaluate the right operand
    // first and load the leaf afterwards. A float leaf is a literal or a local,
    // so reading it can't fault or print, and nothing the right side does can
    // change it (SPEC 4.2, 5.1).
    if is_float_leaf(cg, e[2])
        gen_float_expr(cg, e[3])
        asmput("    movapd xmm1, xmm0")
        gen_float_leaf(cg, e[2], "xmm0")
        return 0
    // Otherwise the left operand has to survive the right one's evaluation,
    // and a free xmm register holds it (`x * x + y * y` is what float
    // arithmetic mostly looks like). When the right side contains a call, the
    // callee may clobber any scratch xmm, so memory is the only safe place,
    // and the value goes straight there without passing through rax.
    gen_float_expr(cg, e[2])
    r = ""
    if expr_has_call(e[3]) == 0
        r = float_scratch(cg)
    // Register to register is movapd (see fmov_from): movsd would merge into the
    // destination's old upper half and wait on whatever wrote it last.
    if len(r) > 0
        asmput("    movapd " . r . ", xmm0")
        cg[38] = cg[38] + 1
        gen_float_expr(cg, e[3])
        cg[38] = cg[38] - 1
        asmput("    movapd xmm1, xmm0")
        asmput("    movapd xmm0, " . r)
        return 0
    asmput("    sub rsp, 16")
    asmput("    movsd [rsp], xmm0")
    gen_float_expr(cg, e[3])
    asmput("    movapd xmm1, xmm0")
    asmput("    movsd xmm0, [rsp]")
    asmput("    add rsp, 16")

// Put the left side in xmm0 and answer with the second operand to compare it
// against: xmm1 normally, or a pooled literal's slot or an unboxed local's home
// when sse_operand allows it. `<` and `<=` are asked as a reversed `>` or `>=`
// so a NaN answers false, which puts xmm0 second, so those two always need the
// pair.
gen_float_cmp_operands(cg, e)
    op = e[1]
    if op != "<" && op != "<="
        m = sse_operand(cg, e[3])
        if len(m) > 0
            gen_float_expr(cg, e[2])
            return m
    gen_float_pair(cg, e)
    return "xmm1"

gen_float_cmp(cg, e)
    op = e[1]
    y = gen_float_cmp_operands(cg, e)
    // ucomisd sets ZF, PF and CF on an unordered pair, so `<` and `<=` are
    // asked as the reversed `>` and `>=`, and every ordering operator answers
    // false when either side is NaN. Equality folds in the parity flag, and
    // `!=` is the negation of that answer.
    if op == "<"
        asmput("    ucomisd xmm1, xmm0")
        asmput("    seta al")
    else if op == "<="
        asmput("    ucomisd xmm1, xmm0")
        asmput("    setae al")
    else if op == ">"
        asmput("    ucomisd xmm0, " . y)
        asmput("    seta al")
    else if op == ">="
        asmput("    ucomisd xmm0, " . y)
        asmput("    setae al")
    else
        asmput("    ucomisd xmm0, " . y)
        asmput("    sete al")
        asmput("    setnp cl")
        asmput("    and al, cl")
    asmput("    movzx rax, al")
    if op == "!="
        asmput("    xor rax, 1")
    emit_bool()

// An integer literal small enough to be the immediate of an ALU instruction,
// already scaled for the tagged form the caller wants. With `scale` 0 it's 2b,
// for `+` and `-` (adding 2b to 2a+1 lands on 2(a+-b)+1 with the tag intact),
// and with `scale` 1 it's the tagged word 2b+1 itself, for a compare. "" means
// the literal is too wide for a sign-extended imm32 and has to go through a
// register.
//
// This is the shape almost every loop is made of (`i = i + 1`, `i < n`,
// `x - 1`), and each one would otherwise pay a 10-byte `movabs` into a scratch
// register for a constant the instruction can carry itself.
int_imm(e, scale)
    if e[0] != 11
        return ""
    v = e[1] * 2
    if scale == 1
        v = v + 1
    if v > 2147483647
        return ""
    if v < 0 - 2147483648
        return ""
    return num_to_str(v)

// The value of a recognized rotate idiom (see rot_lamt) mod 2^32, raw in eax
// with the top half of rax zeroed, for a caller that keeps only the low 32
// bits. x is evaluated once. When it's proven to fit in 32 bits, that's one
// `rol` of it. Otherwise its bits above 31 count, so both shifts run on the
// whole untagged value and the or keeps their low 32 bits: `shl eax` gives
// (x << L) mod 2^32, and `sar rcx` brings bits R up to R + 31 of x down.
gen_rot32(cg, x, lamt)
    if cg_u32(cg, x) == 1
        gen_u32(cg, x)
        asmput("    rol eax, " . lamt)
        return 0
    gen_expr(cg, x)
    // A non-integer operand faults here as the `<<` path it replaces would (this
    // only runs in a float-free program), and a proven integer needs no check.
    if cg_kind(cg, x) != 0
        numcheck(cg, "rax")
    asmput("    sar rax, 1")
    asmput("    mov rcx, rax")
    asmput("    sar rcx, " . (32 - lamt))
    asmput("    shl eax, " . lamt)
    asmput("    or eax, ecx")
    return 0

// Emit the 32-bit funnel shift (see funnel_parts), tagged. When A is proven to
// fit in 32 bits: raw B in ecx, raw A in eax, `shrd eax, ecx, n` = (A >> n) |
// (B << (32 - n)), which clears the upper 32 bits of rax, then re-tag.
// Otherwise the same value on A's whole width: B's low n bits moved to the top
// of 32 bits in ecx, or'd into A >> n (one `sar` untags A and shifts it). Both
// arms fit in 63 bits, so the tag can't overflow. A and B are leaves, so
// loading A can't clobber ecx.
gen_funnel(cg, a, b, n)
    gen_expr(cg, b)
    if cg_kind(cg, b) != 0
        numcheck(cg, "rax")
    asmput("    sar rax, 1")
    if cg_u32(cg, a) == 1
        asmput("    mov ecx, eax")
        gen_expr(cg, a)
        asmput("    sar rax, 1")
        asmput("    shrd eax, ecx, " . n)
    else
        asmput("    and eax, " . ((1 << n) - 1))
        asmput("    shl eax, " . (32 - n))
        asmput("    mov ecx, eax")
        gen_expr(cg, a)
        if cg_kind(cg, a) != 0
            numcheck(cg, "rax")
        asmput("    sar rax, " . (n + 1))
        asmput("    or rax, rcx")
    asmput("    lea rax, [rax*2 + 1]")

// ---- gen_u32: evaluate an integer expression to its low 32 bits ------------
//
// Leaves value(e) mod 2^32 in eax with the top half of rax zeroed, the raw form
// a u32 local lives in. The promise is "mod 2^32", not the exact value: it's
// reached only for the right-hand side of a u32-local assignment (which cg_u32
// proved is already below 2^32, so the two agree) and, recursively, its
// sub-expressions. For every operator handled inline (+ & | ^ << and ~) the low
// 32 bits of the result depend only on the low 32 bits of the operands, so a
// 32-bit register computes them exactly and the mask `& M` costs nothing. >>
// moves higher bits down, so it stays inline only when its operand is itself
// provably u32. The rotate idiom is gen_rot32, which handles the same problem
// for its `>>` arm. + is the one of them that can fault: a sum past 2^62 - 1
// is an overflow even when a mask would cut it down afterwards, and a 32-bit
// add can't see that. So it's inline only when every term is provably u32
// (u32_sum_ok). Every other shape falls back to the ordinary tagged
// evaluation, untagged with one `sar`, whose low 32 bits are the answer.

// A value gen_u32 can drop straight into a 32-bit operand with no spill: an
// integer literal, or a raw u32 local (a slot or a pinned register).
is_u32_leaf(cg, e)
    if e[0] == 11
        return true
    if e[0] == 13 && is_u32_local(cg, e[1]) == 1
        return true
    return false

u32_leaf_op(cg, e)
    if e[0] == 11
        return num_to_str(e[1] & 4294967295)
    return reg32(env_lookup(cg, e[1]))

u32_commutes(mnem)
    if mnem == "add" || mnem == "and"
        return true
    if mnem == "or" || mnem == "xor"
        return true
    return false

// Can 32-bit adds compute the sum `e` without missing an overflow? Yes when
// every term is provably below 2^32 (cg_u32): n such terms add to under
// n * 2^32, which can't reach 2^62 for n up to 2^30. Any other sum goes the
// tagged way, which checks each add.
u32_sum_ok(cg, e)
    n = u32_terms(cg, e)
    return n > 0 && n <= 1073741824

// The number of terms in the sum `e`, when each is provably below 2^32, and -1
// when one isn't.
u32_terms(cg, e)
    if cg_u32(cg, e) == 1
        return 1
    if e[0] != 14 || e[1] != "+"
        return 0 - 1
    a = u32_terms(cg, e[2])
    if a < 0
        return a
    b = u32_terms(cg, e[3])
    if b < 0
        return b
    return a + b

// `left <mnem> right` in 32-bit eax. A leaf operand becomes an immediate or a
// direct slot or register reference. Otherwise the left is parked on the stack
// across the right, as gen_two_operands does on the tagged path.
gen_u32_binop(cg, e, mnem)
    if is_u32_leaf(cg, e[3])
        gen_u32(cg, e[2])
        asmput("    " . mnem . " eax, " . u32_leaf_op(cg, e[3]))
        return 0
    if u32_commutes(mnem) && is_u32_leaf(cg, e[2])
        gen_u32(cg, e[3])
        asmput("    " . mnem . " eax, " . u32_leaf_op(cg, e[2]))
        return 0
    gen_u32(cg, e[2])
    asmput("    push rax")
    gen_u32(cg, e[3])
    asmput("    mov ecx, eax")
    asmput("    pop rax")
    asmput("    " . mnem . " eax, ecx")
    return 0

gen_u32(cg, e)
    k = e[0]
    if k == 11
        asmput("    mov eax, " . num_to_str(e[1] & 4294967295))
        return 0
    if k == 13 && is_u32_local(cg, e[1]) == 1
        asmput("    mov eax, " . reg32(env_lookup(cg, e[1])))
        return 0
    if k == 14
        op = e[1]
        lamt = rot_lamt(e)
        if lamt > 0
            return gen_rot32(cg, e[2][2], lamt)
        if op == "&"
            // `& 0xffffffff` is the identity in 32 bits, so drop it on either
            // side.
            if e[3][0] == 11 && e[3][1] == 4294967295
                return gen_u32(cg, e[2])
            if e[2][0] == 11 && e[2][1] == 4294967295
                return gen_u32(cg, e[3])
            return gen_u32_binop(cg, e, "and")
        if op == "|"
            return gen_u32_binop(cg, e, "or")
        if op == "^"
            return gen_u32_binop(cg, e, "xor")
        if op == "+" && u32_sum_ok(cg, e)
            return gen_u32_binop(cg, e, "add")
        if op == "<<"
            if e[3][0] == 11 && e[3][1] >= 0 && e[3][1] <= 31
                gen_u32(cg, e[2])
                asmput("    shl eax, " . e[3][1])
                return 0
        if op == ">>"
            if cg_u32(cg, e[2]) == 1 && e[3][0] == 11 && e[3][1] >= 0 && e[3][1] <= 31
                gen_u32(cg, e[2])
                asmput("    shr eax, " . e[3][1])
                return 0
    if k == 15 && e[1] == "~"
        gen_u32(cg, e[2])
        asmput("    not eax")
        return 0
    // Fallback: the ordinary tagged value, untagged. Its low 32 bits are the
    // answer, but `sar` is a 64-bit shift that leaves the untagged value's high
    // bits in place, and gen_u32 promises a clean 32-bit result with the top
    // half of rax zeroed: a raw store writes all 8 bytes, and a dropped
    // `& 0xffffffff` trusts those high bits to be gone. The 32-bit `mov` clears
    // them. Every other arm ends in a 32-bit instruction, which zero-extends for
    // free.
    //
    // The value's kind is checked first, unless it's proved to be an integer.
    // The tagged operator this stands in for would check it, so `k & 4294967295`
    // with k a text has to fault here too, where it used to print the pointer's
    // bits.
    gen_expr(cg, e)
    if cg_kind(cg, e) != 0
        u32_intcheck(cg)
    asmput("    sar rax, 1")
    asmput("    mov eax, eax")
    return 0

// Fault unless rax holds an integer, for gen_u32's fallback. There are no
// floats in a program that reaches gen_u32, so a word that isn't an integer
// isn't a number at all, and rt_numfault says which kind it is from the tag in
// r10, as it does for numcheck. The fault path is out of line, so an integer
// falls straight through. This runs on every table lookup in the ciphers' 32-bit
// code, and numcheck's taken branch there cost AES-GCM 9%.
u32_intcheck(cg)
    bad = new_label(cg)
    asmput("    test al, 1")
    asmput("    jz " . bad)
    emlater(cg, bad . ":")
    emlater(cg, "    mov r10, rax")
    emlater(cg, "    and r10, 7")
    emlater(cg, "    jmp rt_numfault")

// The parts of a left-nested join chain, first to last: `a . b . c` is
// ((a . b) . c), so the walk goes down the left spine. A parenthesized join
// on the right is one part (it's its own chain).
join_parts(e)
    rev = mklist(4)
    cur = e
    loop cur[0] == 14 && cur[1] == "."
        rev = ladd_grow(rev, cur[3])
        cur = cur[2]
    rev = ladd_grow(rev, cur)
    parts = mklist(lcount(rev))
    i = lcount(rev) - 1
    loop i >= 0
        parts = ladd_grow(parts, lget(rev, i))
        i = i - 1
    return parts

// Can this chain be joined in one go, after all its parts are evaluated?
// Pairwise, (a . b) is built before c is evaluated, so a call in c that
// changes a region a or b names changes nothing already joined. Joined at the
// end, it would. So nothing from the third part on may call (SPEC 4.1). The
// first two are read after both are evaluated either way. 200 parts bounds the
// operand block the call leaves on the stack.
join_chain_ok(parts)
    n = lcount(parts)
    if n < 3 || n > 200
        return false
    i = 2
    loop i < n
        if expr_has_call(lget(parts, i)) == 1
            return false
        i = i + 1
    return true

gen_binary(cg, e)
    op = e[1]
    // cg[21] is set by gen_stmt for one node only: the root of an assignment
    // whose left operand is the target itself (`x = x + ...`). Take it and
    // clear it before any recursion, so a nested operator can't pick it up.
    tgtreuse = cg[21]
    cg[21] = 0
    if op == "&&" || op == "||"
        gen_logic(cg, e)
        return 0
    if op == "."
        parts = join_parts(e)
        if join_chain_ok(parts)
            i = 0
            loop i < lcount(parts)
                gen_expr(cg, lget(parts, i))
                asmput("    push rax")
                i = i + 1
            asmput("    mov rdi, rsp")
            asmput("    mov rsi, " . lcount(parts))
            asmput("    call rt_joinn")
            asmput("    add rsp, " . (8 * lcount(parts)))
            return 0
        gen_two_operands(cg, e, "rdi", "rsi")
        asmput("    call rt_join")
        return 0
    if is_cmp_op(op)
        gen_compare(cg, e)
        return 0
    // The funnel shift, as one `shrd` when its A is proven to fit in 32 bits.
    // Only in a float-free program, where `|`'s operands can't be floats. A
    // rotate with no mask around it isn't taken here: its value runs past 32
    // bits, so it's ordinary arithmetic (see the rotate idiom).
    if cg[14] == 0 && op == "|"
        fp = funnel_parts(e)
        if fp != 0
            gen_funnel(cg, fp[0], fp[1], fp[2])
            return 0
    // `((x<<L)|(x>>R)) & 0xffffffff`: ChaCha20 masks every rotate. gen_rot32
    // leaves the low 32 bits in eax with the top half clear, which is what the
    // mask would leave, so emit that and drop the `movabs` and `and`.
    if cg[14] == 0 && op == "&"
        mlamt = mask32_rot(e)
        if mlamt > 0
            gen_rot32(cg, rot_masked_arg(e)[2][2], mlamt)
            asmput("    lea rax, [rax*2 + 1]")
            return 0
    // A whole arithmetic tree known to be float evaluates in xmm registers and
    // boxes once, at the root, instead of making a box at every node on the way
    // up. With unboxed locals at the leaves, that's the whole remaining cost of
    // float arithmetic outside an assignment, and inside one the store path
    // (gen_float_store) drops even this box.
    if cg[14] == 1 && arith_root_is_float(cg, e)
        gen_float_expr(cg, e)
        asmput("    movq rax, xmm0")
        asmput("    call rt_box_float")
        return 0
    lk = cg_kind(cg, e[2])
    rk = cg_kind(cg, e[3])
    // Both sides known integers and the right one a literal the instruction can
    // carry: `i + 1` is one `add` on the tagged word, with no movabs into rcx
    // and no tag stripped and put back. The tag arithmetic disappears into the
    // constant (adding 2b to 2a+1 is 2(a+b)+1 already), so the fold is exact,
    // and `jo` fires on the same sum the register form would compute.
    if lk == 0 && rk == 0 && (e[1] == "+" || e[1] == "-")
        k = int_imm(e[3], 0)
        if len(k) > 0
            gen_expr(cg, e[2])
            if e[1] == "+"
                asmput("    add rax, " . k)
            else
                asmput("    sub rax, " . k)
            asmput("    jo rt_overflow")
            return 0
    // `i * 48271` the same way. The register form loads the tagged constant and
    // decrements it back to 2b, which is the immediate the three-operand imul
    // wants, so folding the decrement into the constant drops both instructions
    // and leaves rcx alone. `jo` fires on the same product the register form
    // computes, since imul's OF depends on the multiply and not on where the
    // multiplier came from.
    if lk == 0 && rk == 0 && e[1] == "*"
        k = int_imm(e[3], 0)
        if len(k) > 0
            gen_expr(cg, e[2])
            asmput("    sar rax, 1")
            asmput("    imul rax, rax, " . k)
            asmput("    jo rt_overflow")
            asmput("    inc rax")
            return 0
    // A literal shift count is in range or it isn't, and that doesn't change at
    // run time: `x << 3` needs no untag of the count, no `cmp/ja` that rejects
    // 64 and above, and no cl.
    //
    // Only a count the language accepts (0 to 63) may skip the check. A
    // negative one has to reach the checked path and fault (SPEC 3.1), because
    // the instruction would mask it to six bits: `1 << (0 - 1)` would answer 0
    // and `1 << (0 - 64)` would answer 1.
    if lk == 0 && rk == 0 && (e[1] == "<<" || e[1] == ">>")
        if e[3][0] == 11 && e[3][1] >= 0 && e[3][1] <= 63
            gen_expr(cg, e[2])
            asmput("    sar rax, 1")
            if e[1] == "<<"
                asmput("    sal rax, " . e[3][1])
            else
                asmput("    sar rax, " . e[3][1])
            asmput("    lea rax, [rax*2 + 1]")
            return 0
    gen_two_operands(cg, e, "rax", "rcx")
    // Skip the check only for a kind this operation accepts, an integer or a
    // float. Checking only an unknown (2) isn't enough, since a local can carry
    // an inferred region kind (1), and `s + 1` would then read the region
    // header as a number instead of faulting.
    if lk != 0 && lk != 3
        numcheck(cg, "rax")
    if rk != 0 && rk != 3
        numcheck(cg, "rcx")
    arith = is_arith_op(op)
    // A program that uses floats dispatches + - * / at run time unless both
    // operands are known integers: if either carries the float tag (010), the
    // operation runs as float arithmetic, and otherwise the inline integer path
    // runs. A float-free program never takes this branch.
    if cg[14] == 1 && arith && (lk != 0 || rk != 0)
        fl = new_label(cg)
        dn = new_label(cg)
        // Each operand is tested for the whole 3-bit float tag. Under the 1-bit
        // integer tag, bit 1 of an integer is a value bit, so no single-bit
        // test can tell a float from an integer.
        //
        // Three ways out, cheapest first. Each float helper makes two nested
        // calls to rt_to_double, so going through one costs three calls, which
        // is more of what makes float code slow than the boxing is. When both
        // operands already carry the float tag, the usual case inside a float
        // loop, the operation is a dozen inline instructions and no call.
        //
        // The both-floats test is one OR: a float is tagged 010 and an integer
        // always has bit 0 set, so the OR of two floats is the only pair that
        // leaves 010 in the low three bits. A region can't be here, since the
        // numcheck above has already rejected one.
        ff = new_label(cg)
        asmput("    mov r10, rax")
        asmput("    or r10, rcx")
        asmput("    and r10, 7")
        asmput("    cmp r10, 2")
        asmput("    je " . ff)
        asmput("    mov r10, rax")
        asmput("    and r10, 7")
        asmput("    cmp r10, 2")
        asmput("    je " . fl)
        asmput("    mov r10, rcx")
        asmput("    and r10, 7")
        asmput("    cmp r10, 2")
        asmput("    je " . fl)
        emit_int_op(cg, op, rlit_val(e[3]))
        asmput("    jmp " . dn)
        // Both floats: unbox, operate, then either write into a box this
        // expression owns (is_float_temp, or cg[21] from is_float_acc) or box
        // the result.
        asmput(ff . ":")
        asmput("    mov r10, rax")
        asmput("    and r10, -8")
        asmput("    mov r10, [r10]")
        asmput("    movq xmm0, r10")
        asmput("    mov r11, rcx")
        asmput("    and r11, -8")
        asmput("    mov r11, [r11]")
        asmput("    movq xmm1, r11")
        asmput("    " . sse_op(op) . " xmm0, xmm1")
        asmput("    movq r10, xmm0")
        if is_float_temp(e[2]) || tgtreuse == 1
            asmput("    and rax, -8")
            asmput("    mov [rax], r10")
            asmput("    or rax, 2")
        else
            asmput("    mov rax, r10")
            asmput("    call rt_box_float")
        asmput("    jmp " . dn)
        // Mixed int/float: the helper promotes whichever operand needs it.
        asmput(fl . ":")
        asmput("    mov rdi, rax")
        asmput("    mov rsi, rcx")
        if is_float_temp(e[2]) || tgtreuse == 1
            asmput("    call " . float_helper(op) . "_r")
        else
            asmput("    call " . float_helper(op))
        asmput(dn . ":")
        return 0
    // % and the bitwise and shift operators are integer-only, so in a program
    // that uses floats, a float operand faults instead of having its bits used.
    if cg[14] == 1 && !arith
        if lk != 0
            floatreject("rax")
        if rk != 0
            floatreject("rcx")
    emit_int_op(cg, op, rlit_val(e[3]))

is_arith_op(op)
    if op == "+" || op == "-" || op == "*" || op == "/"
        return true
    return false

sse_op(op)
    if op == "+"
        return "addsd"
    if op == "-"
        return "subsd"
    if op == "*"
        return "mulsd"
    return "divsd"

float_helper(op)
    if op == "+"
        return "rt_fadd"
    if op == "-"
        return "rt_fsub"
    if op == "*"
        return "rt_fmul"
    return "rt_fdiv"

// Is `e` an expression whose float result is a box this expression alone owns?
// An arithmetic operator's box was made one level down and handed straight
// here, so writing the next result into it can't be seen by anything else. A
// variable, an index load or a call result may be held elsewhere, and is never
// reused.
is_float_temp(e)
    // A float literal's bits come from the float pool, but gen_float_lit boxes
    // them fresh every time the literal is evaluated, so its box is as private
    // as an operator's: `2.0 * x` can write the product straight into the box
    // the 2.0 just made.
    if e[0] == 18
        return true
    if e[0] != 14
        return false
    return is_arith_op(e[1])

floatreject(reg)
    asmput("    mov r10, " . reg)
    asmput("    and r10, 7")
    asmput("    cmp r10, 2")
    asmput("    je rt_needint")

// An index must be a whole number. A float faults with "array index must be a
// whole number" (rt_idxfrac) instead of a misleading bounds error, and a
// singleton, region or map isn't a number at all and faults as one
// (rt_numfault). Shifting its tag bits into an index would make s[false] read
// s[7].
idxnumcheck(cg, reg)
    okl = new_label(cg)
    asmput("    test " . reg . ", 1")
    asmput("    jnz " . okl)
    asmput("    mov r10, " . reg)
    asmput("    and r10, 7")
    if cg[14] == 1
        asmput("    cmp r10, 2")
        asmput("    je rt_idxfrac")
    asmput("    jmp rt_numfault")
    asmput(okl . ":")

// A count argument for array(n), text(n) or bytes(n): rax has to be a whole
// number, or pointer or singleton bits would be shifted into a length
// (array(true) would allocate 11 elements, 22 >> 1). An integer proceeds, a
// float faults with rt_needint, and anything else faults in rt_numfault, which
// reads the tag in r10 to say what arrived.
emit_numcheck(cg)
    okl = new_label(cg)
    asmput("    test rax, 1")
    asmput("    jnz " . okl)
    asmput("    mov r10, rax")
    asmput("    and r10, 7")
    // A float is a number but not a whole one, so a count faults on it
    // ("operator needs whole numbers"). A map or singleton isn't a number at
    // all.
    if cg[14] == 1
        asmput("    cmp r10, 2")
        asmput("    je rt_needint")
    asmput("    jmp rt_numfault")
    asmput(okl . ":")

// A value stored into a byte-backed region has to be a whole number, because
// only its low byte is kept (SPEC 3.4). Without this check the store would keep
// the low byte of a pointer or a singleton's tag word, and `b[0] = "hi"` would
// read back as a number. A float faults the way a count does (round() turns a
// float into a whole number), and a region, map or singleton faults as not a
// number. a64_bytecheck is the arm64 twin.
bytecheck(cg, reg)
    okl = new_label(cg)
    asmput("    test " . reg . ", 1")
    asmput("    jnz " . okl)
    asmput("    mov r10, " . reg)
    asmput("    and r10, 7")
    if cg[14] == 1
        asmput("    cmp r10, 2")
        asmput("    je rt_needint")
    asmput("    jmp rt_numfault")
    asmput(okl . ":")

// The inline integer path for one binary operator, on tagged operands in
// rax (left) and rcx (right), result tagged in rax.
emit_int_op(cg, op, rv)
    if op == "+"
        // Take the tag off the left first, so the sum is the final tagged word
        // (2a + 2b+1). Adding the two tagged words directly would make
        // 2(a+b)+2, which overflows a 64-bit signed add one step early, a false
        // trap at the largest valid a+b. This way `jo` fires on true overflow
        // only.
        asmput("    dec rax")
        asmput("    add rax, rcx")
        asmput("    jo rt_overflow")
    else if op == "-"
        asmput("    sub rax, rcx")
        asmput("    jo rt_overflow")
        asmput("    inc rax")
    else if op == "*"
        // One operand fully untagged (a) and the other reduced to 2b, so imul
        // gives 2ab directly and its OF flags a 63-bit overflow. inc re-tags it
        // as 2ab+1.
        asmput("    sar rax, 1")
        asmput("    dec rcx")
        asmput("    imul rax, rcx")
        asmput("    jo rt_overflow")
        asmput("    inc rax")
    else if op == "/"
        // Exact division (SPEC 3.3). The integer divide happens either way, and
        // its remainder decides: zero means the quotient is the answer, and
        // anything else means the answer isn't an integer, so the operands go to
        // the float helper, which promotes and boxes. `1 / 2` is 0.5 and `6 / 3`
        // is 2, and an exact division allocates nothing and costs one extra
        // `test`.
        divguard(cg, rv)
        fl = new_label(cg)
        dn = new_label(cg)
        asmput("    push rax")
        asmput("    push rcx")
        asmput("    sar rax, 1")
        asmput("    sar rcx, 1")
        asmput("    cqo")
        asmput("    idiv rcx")
        asmput("    test rdx, rdx")
        asmput("    jnz " . fl)
        asmput("    add rsp, 16")
        asmput("    lea rax, [rax*2 + 1]")
        asmput("    jmp " . dn)
        asmput(fl . ":")
        asmput("    pop rsi")
        asmput("    pop rdi")
        asmput("    call rt_fdiv")
        asmput(dn . ":")
    else if op == "%"
        divguard(cg, rv)
        asmput("    sar rax, 1")
        asmput("    sar rcx, 1")
        asmput("    cqo")
        asmput("    idiv rcx")
        asmput("    lea rax, [rdx*2 + 1]")
    else if op == "&"
        asmput("    and rax, rcx")
    else if op == "|"
        asmput("    or rax, rcx")
    else if op == "^"
        asmput("    xor rax, rcx")
        asmput("    or rax, 1")
    else if op == "<<"
        asmput("    sar rcx, 1")
        asmput("    cmp rcx, 63")
        asmput("    ja rt_shift")
        asmput("    sar rax, 1")
        asmput("    sal rax, cl")
        asmput("    lea rax, [rax*2 + 1]")
    else if op == ">>"
        asmput("    sar rcx, 1")
        asmput("    cmp rcx, 63")
        asmput("    ja rt_shift")
        asmput("    sar rax, 1")
        asmput("    sar rax, cl")
        asmput("    lea rax, [rax*2 + 1]")

// The load for a subscript the compiler resolved: the region is in rax, the
// element is at a constant displacement, and the only thing left to decide is
// the element width. A map would still need its dispatch, and this only runs
// where const_idx found a known length, which only a region has.
gen_index_load_const(cg, e, k)
    if cg_kind(cg, e[1]) != 1
        regcheck("rax")
    isub = cg_sub(cg, e[1])
    if isub == 1 || isub == 4
        asmput("    movzx rax, byte ptr [rax + " . (k + 8) . "]")
        asmput("    lea rax, [rax*2 + 1]")
        return 0
    if isub == 2 || isub == 3
        asmput("    mov rax, [rax + " . (k * 8 + 8) . "]")
        return 0
    bl2 = new_label(cg)
    dl2 = new_label(cg)
    asmput("    test qword ptr [rax - 16], 1")
    asmput("    jnz " . bl2)
    asmput("    mov rax, [rax + " . (k * 8 + 8) . "]")
    emlater(cg, bl2 . ":")
    emlater(cg, "    movzx rax, byte ptr [rax + " . (k + 8) . "]")
    emlater(cg, "    lea rax, [rax*2 + 1]")
    emlater(cg, "    jmp " . dl2)
    asmput(dl2 . ":")
    return 0

gen_index_load(cg, e)
    gen_expr(cg, e[1])
    // A literal subscript into a region whose length is known folds into the
    // displacement, so it's neither loaded into a register nor checked.
    lfold = const_idx(cg, e[1], e[2])
    if lfold >= 0
        return gen_index_load_const(cg, e, lfold)
    // A leaf subscript (a name or a literal, which is nearly every subscript
    // there is) loads straight into rcx. Spilling the region through the stack
    // to make room would cost `push`, `movabs`, `mov`, `pop` where one `movabs`
    // does, on the most-run operation there is.
    if is_leaf_operand(cg, e[2])
        gen_leaf_into(cg, e[2], "rcx")
    else
        asmput("    push rax")
        gen_expr(cg, e[2])
        asmput("    mov rcx, rax")
        asmput("    pop rax")
    // A map read is a different operation from an array read, and which one this
    // is may only be known at run time (a parameter, a call result). Where the
    // target is known to be a region the map check is left out, so an array
    // loop pays nothing for maps.
    tk = cg_kind(cg, e[1])
    mdone = 0
    if tk == 4
        asmput("    mov rdi, rax")
        asmput("    mov rsi, rcx")
        if is_owned_temp(cg, e[2]) == 1
            emit_call_and_pop("rt_map_get", "rsi")
        else
            asmput("    call rt_map_get")
        return 0
    if cg[20] == 1 && tk != 1
        notmap = new_label(cg)
        mdone = new_label(cg)
        // Region first, map out of line, since nearly every case is a region.
        // One test answers the first question (zero means a region) and leaves
        // r10 the whole word, as regcheck does. Out of line, the map tag 100 is
        // the only nonzero tag with both low bits clear, so a second test asks
        // the other.
        asmput("    mov r10, rax")
        asmput("    test r10b, 7")
        asmput("    jnz " . notmap)
        emlater(cg, notmap . ":")
        emlater(cg, "    test r10b, 3")
        emlater(cg, "    jnz rt_regfault")
        emlater(cg, "    mov rdi, rax")
        emlater(cg, "    mov rsi, rcx")
        if is_owned_temp(cg, e[2]) == 1
            emlater(cg, "    push rsi")
            emlater(cg, "    call rt_map_get")
            emlater(cg, "    pop rdi")
            emlater(cg, "    push rax")
            emlater(cg, "    call rt_popregion")
            emlater(cg, "    pop rax")
        else
            emlater(cg, "    call rt_map_get")
        emlater(cg, "    jmp " . mdone)
    else
        if cg_kind(cg, e[1]) != 1
            regcheck("rax")
    if cg_kind(cg, e[2]) != 0
        idxnumcheck(cg, "rcx")
    asmput("    sar rcx, 1")
    // One unsigned compare covers both ends of the bound. A negative index read
    // as unsigned is larger than any possible length (no region can be long
    // enough to reach 2^63), so `jae` fires for `i < 0` and `i >= len` alike.
    // That's two instructions fewer than the signed pair, on the operation the
    // language runs most. The length is the compare's memory operand, so it
    // never lands in a register.
    if !index_elidable(cg, e[1], e[2])
        asmput("    cmp rcx, [rax]")
        asmput("    jae rt_boundsidx")
    // Subkind: a byte-backed region (flags bit 0 at [rax-16], what fs.read
    // returns) packs one byte per element at [rax+8+i], which is read
    // zero-extended and tagged as an integer (2b+1). Word-backed stays the
    // single mov. When the subkind pass knows which shape the region is, the
    // load is the one instruction that applies, and a read doesn't care whether
    // the region is a literal, so 3 is as good as 2 here. When it doesn't know,
    // the flag decides at run time with the byte path out of line. A given
    // loop indexes one kind of region, so the branch predicts well.
    isub = cg_sub(cg, e[1])
    if isub == 1 || isub == 4
        asmput("    movzx rax, byte ptr [rax + rcx + 8]")
        asmput("    lea rax, [rax*2 + 1]")
    else if isub == 2 || isub == 3
        asmput("    mov rax, [rax + rcx*8 + 8]")
    else
        bl = new_label(cg)
        dl = new_label(cg)
        asmput("    test qword ptr [rax - 16], 1")
        asmput("    jnz " . bl)
        asmput("    mov rax, [rax + rcx*8 + 8]")
        emlater(cg, bl . ":")
        emlater(cg, "    movzx rax, byte ptr [rax + rcx + 8]")
        emlater(cg, "    lea rax, [rax*2 + 1]")
        emlater(cg, "    jmp " . dl)
        asmput(dl . ":")
    if mdone != 0
        asmput(mdone . ":")

// The label of the library's net_fetch, which net_rename moves aside when the
// program defines a net_fetch of its own.
net_fetch_fn(cg)
    if fn_is_known(cg, "net_fetch.net") == 1
        return "fn_net_fetch.net"
    return "fn_net_fetch"

// A net verb is a call into the bundled word library (the net module in the
// NETLIB region), which the source already carries because uses_net found the
// verb. The arguments go on the stack in the ordinary word calling convention,
// pushed last first so arg0 ends at [rsp], and the method is a tagged small
// integer instead of a literal region, which keeps the call site at four
// pushes.
//
// The arguments' kinds are checked here, before the call: the url and the body
// are regions, and the flag is true or false. The library finds a wrong kind
// too, but only when it gets to it (a body once the connection is up, a flag
// once a TLS handshake is done and never over http://, and a number body never,
// since the library reads a number as "no body" and sends the request without
// one), and its fault names a line of the library, past the end of the
// caller's file (SPEC 10.2). A kind the compiler already knows costs nothing.
cg_net(cg, args, mcode, hasbody)
    cg[11] = 1
    insidx = hasbody + 1
    hasflag = lcount(args) > insidx
    // arg3: insecure, a boolean. Absent means `false` (the word 14), so
    // verification is on. The library tests it with `!insecure`, and a
    // condition has to be true or false (SPEC 3.2), so the default and any
    // value a caller passes are booleans.
    if hasflag
        gen_expr(cg, lget(args, insidx))
        asmput("    push rax")
    else
        asmput("    mov rax, 14")
        asmput("    push rax")
    // arg2: the request body, or the number 0.
    if hasbody == 1
        gen_expr(cg, lget(args, 1))
        asmput("    push rax")
    else
        asmput("    mov rax, 1")
        asmput("    push rax")
    // arg1: the url, checked as it arrives. The body and the flag were evaluated
    // before it, so they are checked after it, from their slots: the first
    // argument written is the first one refused.
    url = lget(args, 0)
    gen_expr(cg, url)
    if cg_kind(cg, url) != 1
        regcheck("rax")
    asmput("    push rax")
    if hasbody == 1 && cg_kind(cg, lget(args, 1)) != 1
        asmput("    mov rax, [rsp + 8]")
        regcheck("rax")
    if hasflag && !is_static_bool(lget(args, insidx))
        asmput("    mov rax, [rsp + 16]")
        flagok = new_label(cg)
        gen_truth_jump(cg, 0, flagok)
        asmput(flagok . ":")
    // arg0: the method code, tagged (2v+1).
    asmput("    mov rax, " . (2 * mcode + 1))
    asmput("    push rax")
    asmput("    call " . net_fetch_fn(cg))
    emit_line_restore(cg)
    asmput("    add rsp, 32")

// Is `e` an expression whose region result this expression alone owns?
//
// Two shapes qualify, and the bar for both is the same: the operation has no
// shortcut return, so it hands back a region nothing else has ever seen. A `.`
// join is one (rt_join and rt_joinn always allocate). The other is a call to
// one of the builtins below, each of which was read to confirm it always
// allocates its result: copy, sort and keys through rt_ralloc, and the ones
// that decode text through rt_utf8_decode, which does the same. Some can answer
// none (or copy a map), and rt_popregion leaves anything that isn't a region
// alone. A function the program defines with the same name is excluded,
// because nothing is known about what it returns.
//
// Never add a variable, an index load, or anything that can return a value it
// was handed. Popping one of those hands the same bytes out twice, and nothing
// faults when it does.
is_owned_join(e)
    if e[0] == 14
        return e[1] == "."
    return false

is_fresh_region_call(cg, e)
    if e[0] != 17
        return 0
    nm = e[1]
    if fn_is_known(cg, nm) == 1
        return 0
    if nm == "copy" || nm == "sort" || nm == "keys"
        return 1
    if nm == "args" || nm == "env" || nm == "in"
        return 1
    if nm == "read"
        return 1
    return is_net_func(nm)

is_owned_temp(cg, e)
    if is_owned_join(e)
        return 1
    return is_fresh_region_call(cg, e)

// Two expression nodes that name the same thing, for the rewrites that need it
// (the rotate idiom and slice_width). Only leaves count: a name or an integer
// literal is the same value read twice, with no evaluation and no side effect
// in between.
same_leaf(a, b)
    if a[0] != b[0]
        return false
    if a[0] == 13
        return a[1] == b[1]
    if a[0] == 11
        return a[1] == b[1]
    return false

// `copy(s, start, start + w)`, the fixed-width window. Answers the node for `w`
// when the end is the start plus something, and 0 when it isn't, so the caller
// falls back to computing end - start.
slice_width(st, en)
    if en[0] != 14
        return 0
    if en[1] != "+"
        return 0
    if same_leaf(st, en[2])
        return en[3]
    if same_leaf(st, en[3])
        return en[2]
    return 0

// `call <fn>` where the region in `reg` is a temporary the expression owns and
// the call doesn't keep: reclaim it afterwards, keeping the call's result. It
// costs a push before the call and four instructions after it, and it's only
// used where is_owned_temp said the temporary is ours.
emit_call_and_pop(fn, reg)
    asmput("    push " . reg)
    asmput("    call " . fn)
    asmput("    pop rdi")
    asmput("    push rax")
    asmput("    call rt_popregion")
    asmput("    pop rax")

gen_call(cg, e)
    name = e[1]
    args = e[2]
    argc = lcount(args)
    if fn_is_known(cg, name) == 1
        // A parameter the whole-program pass proved every caller passes a float
        // to is passed as the raw double. Both sides read the same row of the
        // same table, computed once before any code is emitted, so they can't
        // disagree, and a parameter it couldn't prove is passed boxed. That's
        // what makes a float call allocation-free: the box was only there to
        // carry the value across the call.
        ks = pk_lookup(cg, name)
        i = argc - 1
        loop i >= 0
            praw = 0
            if ks != 0
                if i < len(ks)
                    if ks[i] == 3
                        praw = 1
            if praw == 1
                // A float local already holds the raw double in its home, so
                // the general path's round trip through xmm0 would be two
                // instructions for nothing. This is the common shape at a float
                // call site, so it gets the special case.
                a = lget(args, i)
                if a[0] == 13 && is_float_local(cg, a[1])
                    float_home_to_rax(cg, a[1])
                else
                    gen_float_expr(cg, a)
                    asmput("    movq rax, xmm0")
            else
                gen_expr(cg, lget(args, i))
            asmput("    push rax")
            i = i - 1
