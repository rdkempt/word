// P-256 is the curve RFC 8446 makes mandatory and the one most ECDSA
// certificates use. P-384 shows up in certificate chains often enough to matter, and P-521
// rarely. All three are y^2 = x^3 - 3x + b over a prime field, so one module
// covers them: the group law is the same, and what differs is a table.
//
// x25519.w has its own field arithmetic, with limbs sized for 2^255 - 19. Here
// the field is bignum.w's general Montgomery arithmetic for all three curves
// (nine 30-bit limbs for P-256, thirteen for P-384, eighteen for P-521), and so
// is the arithmetic modulo the group order. The NIST primes have fast
// special-form reductions too, but using them would take a separate field for
// each curve. Points are in Jacobian coordinates, (X, Y, Z) standing for
// (X/Z^2, Y/Z^3), so the group law has no inversion in it. The one inversion
// mod p is at the end, turning the result back into an x-coordinate.
//
// Verification is all public: the key, the signature and the message came over
// the wire. So this module isn't constant time, and the scalar multiplication
// uses Shamir's trick: one doubling per bit for both scalars at once, instead
// of a full multiplication for each. ecdh.w uses the same ec_mul2 with a secret
// scalar (see the note at the top of bignum.w).
//
// Measured on x86-64 Linux, against OpenSSL 3.5 on the same machine:
//
//   P-256    4.2 ms     40 us   105x
//   P-384     11 ms    240 us    45x
//   P-521     26 ms    270 us    96x
//
// Most of it is the interleaved ladder: one doubling per bit of the order and
// an addition for about three bits in four, at 8 and 16 Montgomery multiplies
// each. P-384 costs about 2.6 times P-256 and P-521 about 6, for the longer
// ladder and the wider limbs together.
//
// A verification allocates about ten thousand small regions, one for each
// field element of each point operation, and without a rewind they'd stay in
// the arena, nearly a megabyte per signature. So each point operation rewinds
// over its own scratch once it has copied its result out, and ecdsa_verify
// rewinds over the whole verification. That's SPEC 12.5's mark/reset, which
// nothing checks, so the rule here is that a result is either copied into
// storage the caller already owns or allocated before the mark.

// Hex to bytes, for writing the domain parameters as the standards print them.
ec_unhex(s)
    b = bytes((len(s) >> 1))
    i = 0
    loop i < len(b)
        hi = s[i * 2]
        lo = s[i * 2 + 1]
        if hi > 57
            hi = hi - 87
        else
            hi = hi - 48
        if lo > 57
            lo = lo - 87
        else
            lo = lo - 48
        b[i] = hi * 16 + lo
        i = i + 1
    return b

// ---- field arithmetic, on top of bignum.w -----------------------------------

// o = a + b with no reduction. Returns the carry out of the top limb.
fp_addraw(o, a, b)
    c = 0
    i = 0
    loop i < len(o)
        t = a[i] + b[i] + c
        o[i] = t & 1073741823
        c = t >> 30
        i = i + 1
    return c

// o = (a + b) mod m, for a and b below m.
fp_add(o, a, b, m)
    if fp_addraw(o, a, b) == 1
        bn_sub(o, o, m)
        return 0
    if bn_cmp(o, m) >= 0
        bn_sub(o, o, m)
    return 0

// o = (a - b) mod m, for a and b below m. When the subtraction borrows, adding
// m back carries out of the top limb, and the two cancel.
fp_sub(o, a, b, m)
    if bn_sub(o, a, b) == 1
        fp_addraw(o, o, m)
    return 0

fp_zero(a)
    i = 0
    loop i < len(a)
        a[i] = 0
        i = i + 1
    return 0

fp_copy(d, s)
    i = 0
    loop i < len(d)
        d[i] = s[i]
        i = i + 1
    return 0

fp_iszero(a)
    i = 0
    loop i < len(a)
        if a[i] != 0
            return 0
        i = i + 1
    return 1

// (a * b) mod m in the plain domain: one Montgomery multiply takes a factor of
// R out, and a second against R^2 puts it back.
ec_mulmod(o, a, b, m, n0, rr)
    mk = mark()
    t = text(len(m))
    bn_mont_mul(t, a, b, m, n0)
    bn_mont_mul(o, t, rr, m, n0)
    reset(mk)
    return 0

// ---- the group --------------------------------------------------------------

// A point is three field elements, X, Y and Z. Z = 0 is the point at infinity.
ec_new(l)
    q = text(3)
    q[0] = text(l)
    q[1] = text(l)
    q[2] = text(l)
    return q

ec_copy(d, s)
    fp_copy(d[0], s[0])
    fp_copy(d[1], s[1])
    fp_copy(d[2], s[2])
    return 0

// q = 2p, the a = -3 doubling of Bernstein and Lange's dbl-2001-b: three
// multiplies and five squarings. Doubling the point at infinity gives
// Z3 = (Y + 0)^2 - Y^2 - 0 = 0, so it stays there without a special case.
ec_dbl(q, p, m, n0)
    mk = mark()
    l = len(m)
    dl = text(l)
    ga = text(l)
    be = text(l)
    al = text(l)
    t1 = text(l)
    t2 = text(l)
    x3 = text(l)
    y3 = text(l)
    z3 = text(l)
    bn_mont_mul(dl, p[2], p[2], m, n0)
    bn_mont_mul(ga, p[1], p[1], m, n0)
    bn_mont_mul(be, p[0], ga, m, n0)
    fp_sub(t1, p[0], dl, m)
    fp_add(t2, p[0], dl, m)
    bn_mont_mul(al, t1, t2, m, n0)
    fp_add(t1, al, al, m)
    fp_add(al, t1, al, m)
    bn_mont_mul(x3, al, al, m, n0)
    fp_add(t1, be, be, m)
    fp_add(t2, t1, t1, m)
    fp_add(t1, t2, t2, m)
    fp_sub(x3, x3, t1, m)
    fp_add(z3, p[1], p[2], m)
    bn_mont_mul(z3, z3, z3, m, n0)
    fp_sub(z3, z3, ga, m)
    fp_sub(z3, z3, dl, m)
    fp_sub(t1, t2, x3, m)
    bn_mont_mul(y3, al, t1, m, n0)
    bn_mont_mul(t1, ga, ga, m, n0)
    fp_add(t2, t1, t1, m)
    fp_add(t1, t2, t2, m)
    fp_add(t2, t1, t1, m)
    fp_sub(y3, y3, t2, m)
    fp_copy(q[0], x3)
    fp_copy(q[1], y3)
    fp_copy(q[2], z3)
    reset(mk)
    return 0

// r = p + q, Bernstein and Lange's add-2007-bl. The Jacobian formula doesn't
// cover either input being at infinity or the two being the same point.
// Infinity is checked first. Then H = 0 means the x-coordinates agree, and the
// answer is a doubling if the y-coordinates agree too, and infinity if they
// don't.
ec_add(r, p, q, m, n0)
    if fp_iszero(p[2]) == 1
        ec_copy(r, q)
        return 0
    if fp_iszero(q[2]) == 1
        ec_copy(r, p)
        return 0
    mk = mark()
    l = len(m)
    z1z1 = text(l)
    z2z2 = text(l)
    u1 = text(l)
    u2 = text(l)
    s1 = text(l)
    s2 = text(l)
    h = text(l)
    ii = text(l)
    j = text(l)
    rr = text(l)
    v = text(l)
    t1 = text(l)
    x3 = text(l)
    y3 = text(l)
    z3 = text(l)
    bn_mont_mul(z1z1, p[2], p[2], m, n0)
    bn_mont_mul(z2z2, q[2], q[2], m, n0)
    bn_mont_mul(u1, p[0], z2z2, m, n0)
    bn_mont_mul(u2, q[0], z1z1, m, n0)
    bn_mont_mul(s1, p[1], q[2], m, n0)
    bn_mont_mul(s1, s1, z2z2, m, n0)
    bn_mont_mul(s2, q[1], p[2], m, n0)
    bn_mont_mul(s2, s2, z1z1, m, n0)
    fp_sub(h, u2, u1, m)
    fp_sub(rr, s2, s1, m)
    if fp_iszero(h) == 1
        if fp_iszero(rr) == 1
            reset(mk)
            ec_dbl(r, p, m, n0)
            return 0
        fp_zero(r[0])
        fp_zero(r[1])
        fp_zero(r[2])
        reset(mk)
        return 0
    fp_add(rr, rr, rr, m)
    fp_add(t1, h, h, m)
    bn_mont_mul(ii, t1, t1, m, n0)
    bn_mont_mul(j, h, ii, m, n0)
    bn_mont_mul(v, u1, ii, m, n0)
    bn_mont_mul(x3, rr, rr, m, n0)
    fp_sub(x3, x3, j, m)
    fp_add(t1, v, v, m)
    fp_sub(x3, x3, t1, m)
    fp_sub(t1, v, x3, m)
    bn_mont_mul(y3, rr, t1, m, n0)
    bn_mont_mul(t1, s1, j, m, n0)
    fp_add(t1, t1, t1, m)
    fp_sub(y3, y3, t1, m)
    fp_add(z3, p[2], q[2], m)
    bn_mont_mul(z3, z3, z3, m, n0)
    fp_sub(z3, z3, z1z1, m)
    fp_sub(z3, z3, z2z2, m)
    bn_mont_mul(z3, z3, h, m, n0)
    fp_copy(r[0], x3)
    fp_copy(r[1], y3)
    fp_copy(r[2], z3)
    reset(mk)
    return 0

// res = k1*p1 + k2*p2, with both scalars big-endian bytes of the same length
// (the field width). Shamir's trick: one doubling per bit serves both scalars,
// and the pair of bits picks which of p1, p2 or p1+p2 to add. It isn't
// constant time, which is fine because everything it touches is public.
ec_mul2(res, k1, p1, k2, p2, m, n0)
    nbits = len(k1) * 8
    both = ec_new(len(m))
    ec_add(both, p1, p2, m, n0)
    fp_zero(res[0])
    fp_zero(res[1])
    fp_zero(res[2])
    i = 0
    loop i < nbits
        ec_dbl(res, res, m, n0)
        sh = 7 - (i & 7)
        b1 = (k1[(i >> 3)] >> sh) & 1
        b2 = (k2[(i >> 3)] >> sh) & 1
        if b1 == 1 && b2 == 1
            ec_add(res, res, both, m, n0)
        else
            if b1 == 1
                ec_add(res, res, p1, m, n0)
            if b2 == 1
                ec_add(res, res, p2, m, n0)
        i = i + 1
    return 0

// ---- domain parameters -------------------------------------------------------

// The field width in bytes: 1 is P-256, 2 is P-384, 3 is P-521. A public key
// point is 1 + 2 * this, and r and s are this wide each.
ec_bytes(cid)
    if cid == 1
        return 32
    if cid == 2
        return 48
    return 66

// The bit length of the group order, which is what a digest is truncated to.
// For P-256 and P-384 it's eight times the byte width. For P-521 it's 521,
// seven bits short of the 66 bytes the order is written in.
ec_orderbits(cid)
    if cid == 1
        return 256
    if cid == 2
        return 384
    return 521

// p - 2 and n - 2, the exponents that invert (Fermat). Every p and n here ends
// in a byte of 9 or more, so subtracting 2 from the last byte never borrows,
// and nothing else in this module needs a general subtract on bytes.
ec_minus2(b)
    r = bytes(len(b))
    i = 0
    loop i < len(b)
        r[i] = b[i]
        i = i + 1
    r[len(b) - 1] = r[len(b) - 1] - 2
    return r

// A curve's parameters and the Montgomery constants for its field and its
// group order:
//   0 p    1 -p^-1 mod 2^30    2 R^2 mod p    3 n    4 -n^-1 mod 2^30
//   5 R^2 mod n    6 b, in the Montgomery domain    7 G, likewise
//   8 p-2    9 n-2    10 the field width in bytes
ec_build(nb, ph, nh, bh, gxh, gyh)
    ctx = text(11)
    l = bn_limbs_for(nb)
    pb = ec_unhex(ph)
    p = bn_from_bytes(pb, l)
    n0p = bn_n0inv(p)
    rrp = bn_rr(p, n0p)
    ctx[0] = p
    ctx[1] = n0p
    ctx[2] = rrp
    nn = ec_unhex(nh)
    n = bn_from_bytes(nn, l)
    n0n = bn_n0inv(n)
    ctx[3] = n
    ctx[4] = n0n
    ctx[5] = bn_rr(n, n0n)
    b = bn_from_bytes(ec_unhex(bh), l)
    bm = text(l)
    bn_mont_mul(bm, b, rrp, p, n0p)
    ctx[6] = bm
    one = text(l)
    one[0] = 1
    g = ec_new(l)
    bn_mont_mul(g[0], bn_from_bytes(ec_unhex(gxh), l), rrp, p, n0p)
    bn_mont_mul(g[1], bn_from_bytes(ec_unhex(gyh), l), rrp, p, n0p)
    bn_mont_mul(g[2], one, rrp, p, n0p)
    ctx[7] = g
    ctx[8] = ec_minus2(pb)
    ctx[9] = ec_minus2(nn)
    ctx[10] = nb
    return ctx

// P-256, P-384 and P-521 from FIPS 186-4 D.1.2.3, D.1.2.4 and D.1.2.5. For
// each curve, G is on the curve and G times the order is the point at
// infinity.
ec_params(cid)
    if cid == 1
        return ec_build(32, "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff", "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551", "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b", "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296", "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")
    if cid == 2
        return ec_build(48, "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff", "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973", "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef", "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7", "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f")
    return ec_build(66, "01ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff", "01fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffa51868783bf2f966b7fcc0148f709a5d03bb5c9b8899c47aebb6fb71e91386409", "0051953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef109e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b503f00", "00c6858e06b70404e9cd9e3ecb662395b4429c648139053fb521f828af606b4d3dbaa14b5e77efe75928fe1dc127a2ffa8de3348b3c1856a429bf97e7e31c2e5bd66", "011839296a789a3bc0045c8a5fb42c7d1bd998f54449579b446817afbd17273e662c97ee72995ef42640c550b9013fad0761353c7086a272c24088be94769fd16650")

// ---- verification ------------------------------------------------------------

// The digest as the integer e of SEC 1 section 4.1.4: its leftmost
// min(8 * len(hash), bitlen(n)) bits. For every pairing that occurs (P-256 or
// P-384 with any SHA-2, P-521 with SHA-512) the cut falls on a byte boundary or
// takes the whole digest. P-521's order is 521 bits, so the seven-bit shift for
// a longer digest is written anyway, instead of assuming which hashes exist.
ecdsa_e(hash, cid)
    nbits = ec_orderbits(cid)
    hl = len(hash)
    if hl * 8 > nbits
        hl = ((nbits + 7) >> 3)
    hb = bytes(hl)
    i = 0
    loop i < hl
        hb[i] = hash[i]
        i = i + 1
    ex = hl * 8 - nbits
    if ex > 0 && len(hash) * 8 > nbits
        i = hl - 1
        loop i > 0
            hb[i] = ((hb[i] >> ex) | (hb[i - 1] << (8 - ex))) & 255
            i = i - 1
        hb[0] = hb[0] >> ex
    return hb

// ECDSA verification (SEC 1 section 4.1.4): with w = s^-1 mod n, the point
// (e*w)G + (r*w)Q must have x-coordinate r, taken mod n.
//
// pub is the uncompressed public key, 04 || X || Y. r and s are the field width
// each: the caller unwraps the DER SEQUENCE and pads.
//
// The checks before the arithmetic matter. A public key off the curve, or an r
// or s outside 1..n-1, is how a verifier gets talked into accepting a
// signature nobody made.
ecdsa_verify(cid, pub, hash, r, s)
    mk = mark()
    ok = ecdsa_check(cid, pub, hash, r, s)
    reset(mk)
    return ok

// The verification itself. Everything it allocates (the parameters, the
// points, the scalars) is dead once it answers, and its answer is a number, so
// the wrapper above rewinds the arena over all of it.
ecdsa_check(cid, pub, hash, r, s)
    nb = ec_bytes(cid)
    if len(pub) != 1 + 2 * nb
        return 0
    if pub[0] != 4
        return 0
    if len(r) != nb || len(s) != nb
        return 0
    ctx = ec_params(cid)
    p = ctx[0]
    n0p = ctx[1]
    rrp = ctx[2]
    n = ctx[3]
    n0n = ctx[4]
    rrn = ctx[5]
    l = len(p)
    one = text(l)
    one[0] = 1
    xb = bytes(nb)
    yb = bytes(nb)
    i = 0
    loop i < nb
        xb[i] = pub[1 + i]
        yb[i] = pub[1 + nb + i]
        i = i + 1
    qx = bn_from_bytes(xb, l)
    qy = bn_from_bytes(yb, l)
    if bn_cmp(qx, p) >= 0 || bn_cmp(qy, p) >= 0
        return 0
    q = ec_new(l)
    bn_mont_mul(q[0], qx, rrp, p, n0p)
    bn_mont_mul(q[1], qy, rrp, p, n0p)
    bn_mont_mul(q[2], one, rrp, p, n0p)
    t1 = text(l)
    t2 = text(l)
    t3 = text(l)
    bn_mont_mul(t1, q[1], q[1], p, n0p)
    bn_mont_mul(t2, q[0], q[0], p, n0p)
    bn_mont_mul(t2, t2, q[0], p, n0p)
    fp_add(t3, q[0], q[0], p)
    fp_add(t3, t3, q[0], p)
    fp_sub(t2, t2, t3, p)
    fp_add(t2, t2, ctx[6], p)
    if bn_cmp(t1, t2) != 0
        return 0
    rn = bn_from_bytes(r, l)
    sn = bn_from_bytes(s, l)
    if fp_iszero(rn) == 1 || fp_iszero(sn) == 1
        return 0
    if bn_cmp(rn, n) >= 0 || bn_cmp(sn, n) >= 0
        return 0
    en = bn_from_bytes(ecdsa_e(hash, cid), l)
    if bn_cmp(en, n) >= 0
        bn_sub(en, en, n)
    w = bn_modexp(sn, ctx[9], n)
    u1 = text(l)
    u2 = text(l)
    ec_mulmod(u1, en, w, n, n0n, rrn)
    ec_mulmod(u2, rn, w, n, n0n, rrn)
    res = ec_new(l)
    ec_mul2(res, bn_to_bytes(u1, nb), ctx[7], bn_to_bytes(u2, nb), q, p, n0p)
    if fp_iszero(res[2]) == 1
        return 0
    zp = text(l)
    bn_mont_mul(zp, res[2], one, p, n0p)
    zi = bn_modexp(zp, ctx[8], p)
    zi2 = text(l)
    ec_mulmod(zi2, zi, zi, p, n0p, rrp)
    xp = text(l)
    bn_mont_mul(xp, res[0], one, p, n0p)
    xa = text(l)
    ec_mulmod(xa, xp, zi2, p, n0p, rrp)
    if bn_cmp(xa, n) >= 0
        bn_sub(xa, xa, n)
    if bn_cmp(xa, rn) == 0
        return 1
    return 0
// >>> NETLIB MODULE der >>>
// der.w: a DER reader, in word.
//
// X.509 certificates, the SubjectPublicKeyInfo inside them and the ECDSA
// signatures beside them are all DER, a tree of tag-length-value triples. A
// certificate is attacker-controlled input, and a parser that accepts more than
// DER allows can be made to disagree with the one that issued the certificate,
// so this reader is strict.
//
// It rejects what DER rejects: the indefinite length form, a long form used for
// a length that fits in the short one, a length with a leading zero byte, a
// length whose bytes run past the end of the enclosing value, and any tag
// number that needs more than one byte (nothing in a certificate uses one).
//
// der_read copies nothing. A parsed value is its tag and the offset and length
// of its content inside the buffer it came from, so a caller can hand the exact
// bytes of a tbsCertificate to a signature check without rebuilding them. Only
// der_slice copies, for the few values that outlive the parse.

// The TLV at `off`, bounded by `end`: a three-cell region holding the tag, the
// offset of the content and its length. The number 0 if it isn't well-formed
// DER, so `if v == 0` is the exact test (SPEC 3.3).
der_read(b, off, end)
    if off + 2 > end
        return 0
    tag = b[off]
    // A tag number of 31 means the number continues into further bytes. No
    // certificate field uses one, so it's refused.
    if (tag & 31) == 31
        return 0
    p = off + 1
    l = b[p]
    p = p + 1
    if l >= 128
        nl = l - 128
        // 0x80 is the indefinite form, which DER doesn't have. More than four
        // length bytes is longer than anything this is handed.
        if nl == 0 || nl > 4
            return 0
        if p + nl > end
            return 0
        // A minimal length has no leading zero, and never uses the long form
        // for a value the short form could hold.
        if b[p] == 0
            return 0
        l = 0
        i = 0
        loop i < nl
            l = l * 256 + b[p + i]
            i = i + 1
        p = p + nl
        if l < 128
            return 0
    if p + l > end
        return 0
    v = text(3)
    v[0] = tag
    v[1] = p
    v[2] = l
    return v

// One past the last byte of a value: where its sibling starts.
der_end(v)
    return v[1] + v[2]

// der_read, but the tag has to be the one expected.
der_expect(b, off, end, tag)
    v = der_read(b, off, end)
    if v == 0
        return 0
    if v[0] != tag
        return 0
    return v

// A copy of n bytes of b from off, for a value that has to outlive the buffer
// or be handed to something that wants a region of its own.
der_slice(b, off, n)
    r = bytes(n)
    i = 0
    loop i < n
        r[i] = b[off + i]
        i = i + 1
    return r

// The content of an INTEGER as an unsigned big-endian byte region, with its
// leading zero bytes dropped. DER writes integers signed, so a value whose top
// bit is set carries a zero byte in front, and that byte isn't part of the
// number. A negative integer (top bit set, no zero in front) has no business in
// a certificate and comes back as 0.
der_uint(b, v)
    off = v[1]
    n = v[2]
    if n == 0
        return 0
    if b[off] >= 128
        return 0
    loop n > 1 && b[off] == 0
        off = off + 1
        n = n - 1
    return der_slice(b, off, n)

// The content of a BIT STRING, minus the leading octet that says how many bits
// of the last byte are unused. This is only used for a public key and a
// signature, which are whole bytes, so that octet has to be zero. (keyUsage has
// unused bits, and x509.w reads it directly.)
der_bits(b, v)
    if v[2] < 1
        return 0
    if b[v[1]] != 0
        return 0
    return der_slice(b, v[1] + 1, v[2] - 1)

// Whether the content of v is the given bytes. It's how an OID is
// compared with a known one. (Names are matched with x509_bytes_eq.)
der_content_is(b, v, want)
    if v[2] != len(want)
        return 0
    i = 0
    loop i < v[2]
        if b[v[1] + i] != want[i]
            return 0
        i = i + 1
    return 1
// >>> NETLIB MODULE x509 >>>
// x509.w: X.509 certificate parsing and chain verification, in word.
// Needs der.w for the reader, sha256.w and sha512.w for the digests, and
// bignum.w, rsa.w and ecdsa.w for the signatures.
//
// This is what stands between a TLS client and anyone who can answer a TCP
// connection. The handshake proves the peer holds a private key, and this
// decides whether that key belongs to the host that was asked for. Everything
// it reads is chosen by the peer.
//
// A parsed certificate is a region of twenty-two slots. The only bytes copied
// are the values that outlive the parse (the signature, the key, and the SAN
// names and addresses). The tbsCertificate has to reach a signature check
// exactly as it arrived, so it's never rebuilt, only pointed at:
//
//    0 the certificate's own bytes
//    1 tbsCertificate offset      2 its length, header included
//    3 signature scheme: 1 RSA PKCS#1 v1.5, 2 ECDSA, 3 RSA-PSS, 4 Ed25519,
//      5 an algorithm nothing here verifies (see x509_sigalg)
//    4 signature hash: 0 SHA-256, 1 SHA-384, 2 SHA-512
//    5 signature bytes
//    6 issuer offset              7 its length, header included
//    8 subject offset             9 its length, header included
//   10 notBefore, Unix seconds   11 notAfter
//   12 key type: 0 RSA, 1 P-256, 2 P-384, 3 P-521, 4 Ed25519
//   13 key: RSA modulus, EC point, or Ed25519 key
//   14 RSA public exponent, else 0
//   15 1 if basicConstraints says CA
//   16 pathLenConstraint, or -1
//   17 the subjectAltName dNSNames, or 0
//   18 the subjectAltName iPAddresses (4 or 16 raw bytes each), or 0
//   19 the keyUsage bits of the first byte, or -1 when the extension is absent
//   20 1 if extendedKeyUsage is absent or permits TLS server authentication,
//      else 0
//   21 1 if the certificate carries a critical extension this can't process,
//      or a name or policy constraint (critical or not)
//
// Slots 19 to 21 are recorded here and acted on in the chain walk: parsing says
// what the bytes are, and x509_verify_chain decides what that means for a
// path.
//
// Not here: revocation (no CRL, no OCSP), name constraints, policy
// constraints, and any signature algorithm older than SHA-256. None of those
// fails open. An unprocessed critical extension, or any name or policy
// constraint, is a refusal (slot 21), so a name-constrained CA is refused
// instead of trusted past a constraint nothing here enforces. Ed25519
// certificates parse and then fail to verify, because there's no Ed25519
// verifier yet.
//
// A hash this doesn't have fails closed the same way. A certificate signed
// with SHA-1 parses, and the chain walk refuses the link (x509_check_sig has no
// case for it). Refusing to parse it would throw away the certificates whose
// own signature is never checked (a trust anchor, and anything the peer sent
// past the anchor), and a lost anchor fails every site that needs it with no
// message saying why.

// x509.w's own long division and hex decoder (x509_unhex, for writing OIDs the
// way the standards print them). der.w can't hold them: its known-answer test
// builds der.w on its own, and a function nothing calls is a compile error.
x509_idiv(a, b)
    // Long division, one bit at a time, instead of `/`, for the same reason as
    // bignum_idiv: `/` may answer a float. It's only used by the calendar
    // arithmetic in x509_days.
    n = 0
    if a < 0
        a = 0 - a
        n = 1
    if b < 0
        b = 0 - b
        n = 1 - n
    q = 0
    r = 0
    i = 61
    loop i >= 0
        r = r * 2 + ((a >> i) & 1)
        if r >= b
            r = r - b
            q = q + (1 << i)
        i = i - 1
    if n == 1
        return 0 - q
    return q

x509_unhex(s)
    b = bytes((len(s) >> 1))
    i = 0
    loop i < len(b)
        hi = s[i * 2]
        lo = s[i * 2 + 1]
        if hi > 57
            hi = hi - 87
        else
            hi = hi - 48
        if lo > 57
            lo = lo - 87
        else
            lo = lo - 48
        b[i] = hi * 16 + lo
        i = i + 1
    return b

// ---- time -------------------------------------------------------------------

// Days from 1970-01-01 to y-m-d in the proleptic Gregorian calendar, by the
// usual days-from-civil arithmetic: shift the year to start in March so the
// leap day falls at the end, then count 400-year eras of 146097 days each. A
// date before 1970 comes out negative. Checked day by day against a counter
// for every date a certificate can hold, 0000-01-01 to 9999-12-31.
x509_days(y, m, d)
    yy = y
    if m <= 2
        yy = yy - 1
    era = x509_idiv(yy, 400)
    yoe = yy - era * 400
    mp = (m + 9) % 12
    doy = x509_idiv(153 * mp + 2, 5) + d - 1
    doe = yoe * 365 + (yoe >> 2) - x509_idiv(yoe, 100) + doy
    return era * 146097 + doe - 719468

x509_2d(b, off)
    return (b[off] - 48) * 10 + (b[off + 1] - 48)

// A UTCTime (YYMMDDHHMMSSZ) or a GeneralizedTime (YYYYMMDDHHMMSSZ) as Unix
// seconds, or none. RFC 5280 (section 4.1.2.5) pins UTCTime's two-digit year:
// 00-49 is 20xx and 50-99 is 19xx. Only the Z form is accepted, which is the
// only form RFC 5280 allows in a certificate. Times before 1970 come out
// negative, which is why a bad time answers none. It used to answer -1, and the
// parser took any negative time for that, so a certificate dated before 1970
// didn't parse.
x509_time(b, v)
    off = v[1]
    n = v[2]
    if v[0] == 23
        if n != 13
            return none
        yy = x509_2d(b, off)
        y = 2000 + yy
        if yy >= 50
            y = 1900 + yy
        off = off + 2
    else if v[0] == 24
        if n != 15
            return none
        y = x509_2d(b, off) * 100 + x509_2d(b, off + 2)
        off = off + 4
    else
        return none
    if b[v[1] + n - 1] != 90
        return none
    mo = x509_2d(b, off)
    dd = x509_2d(b, off + 2)
    hh = x509_2d(b, off + 4)
    mi = x509_2d(b, off + 6)
    ss = x509_2d(b, off + 8)
    if mo < 1 || mo > 12 || dd < 1 || dd > 31
        return none
    if hh > 23 || mi > 59 || ss > 60
        return none
    return x509_days(y, mo, dd) * 86400 + hh * 3600 + mi * 60 + ss

// ---- algorithm identifiers ---------------------------------------------------

// 0 SHA-256, 1 SHA-384, 2 SHA-512, and -1 for anything else, SHA-1 included.
x509_hashid(b, oid)
    if der_content_is(b, oid, x509_unhex("608648016503040201")) == 1
        return 0
    if der_content_is(b, oid, x509_unhex("608648016503040202")) == 1
        return 1
    if der_content_is(b, oid, x509_unhex("608648016503040203")) == 1
        return 2
    return -1

// An AlgorithmIdentifier as [scheme, hash, oid offset, oid length], or 0 for
// one that isn't an AlgorithmIdentifier at all. RSA-PSS carries its hash in its
// parameters instead of its OID, so that one is read out. RFC 4055 (section
// 3.1) says the parameters of a signature's PSS AlgorithmIdentifier must be
// there and must be RSASSA-PSS-params, so absent parameters, or anything else
// in their place, are malformed and answer 0. Parameters that leave the hash
// out mean its default, SHA-1, which this doesn't have, so that's scheme 5.
//
// An algorithm this can't verify is scheme 5, and slots 2 and 3 of the answer
// then hold its OID's offset and length. Scheme 5 isn't "verified with
// something weak": x509_check_sig has no case for it, so every signature made
// with it fails, and SPEC 12.2 rule 3 still refuses a leaf or an issuer signed
// with SHA-1. What scheme 5 does is let the certificate parse, for the two
// kinds of certificate whose own signature is never checked:
//
//   a trust anchor, whose self-signature is an input to path validation and
//   not a link in it (RFC 5280 section 6.1.1). 19 of the 53 ROOT anchors on
//   the Windows machine this was measured on were self-signed with SHA-1, MD5
//   or MD2, GlobalSign Root CA and three DigiCert roots among them, and
//   refusing them at the parse dropped a third of the store.
//
//   a certificate the peer sent past the anchor, which rule 8 gives no say.
x509_sigalg(b, sa)
    oid = der_expect(b, sa[1], der_end(sa), 6)
    if oid == 0
        return 0
    r = text(4)
    r[1] = -1
    r[2] = 0
    r[3] = 0
    if der_content_is(b, oid, x509_unhex("2a864886f70d01010b")) == 1
        r[0] = 1
        r[1] = 0
        return r
    if der_content_is(b, oid, x509_unhex("2a864886f70d01010c")) == 1
        r[0] = 1
        r[1] = 1
        return r
    if der_content_is(b, oid, x509_unhex("2a864886f70d01010d")) == 1
        r[0] = 1
        r[1] = 2
        return r
    if der_content_is(b, oid, x509_unhex("2a8648ce3d040302")) == 1
        r[0] = 2
        r[1] = 0
        return r
    if der_content_is(b, oid, x509_unhex("2a8648ce3d040303")) == 1
        r[0] = 2
        r[1] = 1
        return r
    if der_content_is(b, oid, x509_unhex("2a8648ce3d040304")) == 1
        r[0] = 2
        r[1] = 2
        return r
    if der_content_is(b, oid, x509_unhex("2b6570")) == 1
        r[0] = 4
        return r
    if der_content_is(b, oid, x509_unhex("2a864886f70d01010a")) == 1
        pv = der_expect(b, der_end(oid), der_end(sa), 48)
        if pv == 0
            return 0
        // RSASSA-PSS-params is a SEQUENCE of four fields tagged [0] to [3],
        // each with a default. The hash is [0]. With no [0] (an empty
        // SEQUENCE, or one whose first field is [1], [2] or [3]) the hash is
        // SHA-1, and r[1] stays -1.
        if pv[2] > 0
            h0 = der_read(b, pv[1], der_end(pv))
            if h0 == 0 || h0[0] < 160 || h0[0] > 163
                return 0
            if h0[0] == 160
                ha = der_expect(b, h0[1], der_end(h0), 48)
                if ha == 0
                    return 0
                hoid = der_expect(b, ha[1], der_end(ha), 6)
                if hoid == 0
                    return 0
                r[1] = x509_hashid(b, hoid)
        r[0] = 3
        // A well-formed PSS AlgorithmIdentifier whose hash this doesn't have,
        // the SHA-1 default included, is treated like an OID it doesn't know:
        // scheme 5, not a malformed certificate. The returns above are for
        // parameters that are absent or aren't the structure PSS defines, and
        // they stay 0.
        if r[1] < 0
            r[0] = 5
            r[1] = -1
            r[2] = oid[1]
            r[3] = oid[2]
        return r
    r[0] = 5
    r[2] = oid[1]
    r[3] = oid[2]
    return r

// ---- the certificate ---------------------------------------------------------

// SubjectPublicKeyInfo into slots 12, 13 and 14.
x509_key(b, spki, c)
    alg = der_expect(b, spki[1], der_end(spki), 48)
    if alg == 0
        return 0
    oid = der_expect(b, alg[1], der_end(alg), 6)
    if oid == 0
        return 0
    bs = der_expect(b, der_end(alg), der_end(spki), 3)
    if bs == 0
        return 0
    key = der_bits(b, bs)
    if key == 0
        return 0
    c[14] = 0
    if der_content_is(b, oid, x509_unhex("2a864886f70d010101")) == 1
        sq = der_expect(key, 0, len(key), 48)
        if sq == 0
            return 0
        mi = der_expect(key, sq[1], der_end(sq), 2)
        if mi == 0
            return 0
        ei = der_expect(key, der_end(mi), der_end(sq), 2)
        if ei == 0
            return 0
        c[12] = 0
        c[13] = der_uint(key, mi)
        c[14] = der_uint(key, ei)
        if c[13] == 0 || c[14] == 0
            return 0
        return 1
    if der_content_is(b, oid, x509_unhex("2a8648ce3d0201")) == 1
        crv = der_expect(b, der_end(oid), der_end(alg), 6)
        if crv == 0
            return 0
        if der_content_is(b, crv, x509_unhex("2a8648ce3d030107")) == 1
            c[12] = 1
        else if der_content_is(b, crv, x509_unhex("2b81040022")) == 1
            c[12] = 2
        else if der_content_is(b, crv, x509_unhex("2b81040023")) == 1
            c[12] = 3
        else
            return 0
        c[13] = key
        return 1
    if der_content_is(b, oid, x509_unhex("2b6570")) == 1
        c[12] = 4
        c[13] = key
        return 1
    return 0

// basicConstraints into slots 15 and 16. Both fields are optional and both have
// defaults, so an empty SEQUENCE is a valid "not a CA".
x509_bc(b, val, c)
    sq = der_expect(b, val[1], der_end(val), 48)
    if sq == 0
        return 0
    e = der_end(sq)
    p = sq[1]
    if p < e
        v = der_read(b, p, e)
        if v == 0
            return 0
        if v[0] == 1
            if v[2] != 1
                return 0
            if b[v[1]] != 0
                c[15] = 1
            p = der_end(v)
    if p < e
        v = der_expect(b, p, e, 2)
        if v == 0
            return 0
        // pathLen is a count, so an empty or negative INTEGER is malformed.
        if v[2] == 0 || b[v[1]] > 127
            return 0
        // Anything past 2^31 is more intermediates than a chain can hold, so
        // it's as good as no limit. The value stops growing there, because
        // an 8-byte pathLen would overflow the arithmetic and a server could
        // stop the client with one certificate.
        pl = 0
        i = 0
        loop i < v[2]
            if pl < 2147483648
                pl = pl * 256 + b[v[1] + i]
            i = i + 1
        if pl > 2147483648
            pl = 2147483648
        c[16] = pl
    return 1

// The dNSNames of a subjectAltName (tag [2], 0x82), as a region of byte
// regions, or 0 when there are none. They're counted first and filled second,
// since there's no growable list here, and two passes over a few dozen bytes
// isn't worth writing one for.
x509_san(b, val)
    sq = der_expect(b, val[1], der_end(val), 48)
    if sq == 0
        return 0
    e = der_end(sq)
    n = 0
    p = sq[1]
    loop p < e
        v = der_read(b, p, e)
        if v == 0
            return 0
        if v[0] == 130
            n = n + 1
        p = der_end(v)
    if n == 0
        return 0
    r = text(n)
    n = 0
    p = sq[1]
    loop p < e
        v = der_read(b, p, e)
        if v[0] == 130
            r[n] = der_slice(b, v[1], v[2])
            n = n + 1
        p = der_end(v)
    return r

// The iPAddresses of a subjectAltName (tag [7], 0x87), as a region of byte
// regions of 4 (IPv4) or 16 (IPv6) raw bytes, or 0 when there are none. An
// entry of any other length is skipped. A certificate issued for a literal
// address carries these and no dNSName at all, so a client that reads only
// dNSNames rejects it however correct the chain is.
x509_san_ip(b, val)
    sq = der_expect(b, val[1], der_end(val), 48)
    if sq == 0
        return 0
    e = der_end(sq)
    n = 0
    p = sq[1]
    loop p < e
        v = der_read(b, p, e)
        if v == 0
            return 0
        if v[0] == 135
            if v[2] == 4 || v[2] == 16
                n = n + 1
        p = der_end(v)
    if n == 0
        return 0
    r = text(n)
    n = 0
    p = sq[1]
    loop p < e
        v = der_read(b, p, e)
        if v[0] == 135
            if v[2] == 4 || v[2] == 16
                r[n] = der_slice(b, v[1], v[2])
                n = n + 1
        p = der_end(v)
    return r

// keyUsage (RFC 5280 section 4.2.1.3) is a BIT STRING whose first content byte
// counts the unused trailing bits. Only the first byte of bits matters here:
// digitalSignature is bit 0 (0x80) and keyCertSign is bit 5 (0x04), with the
// bits laid out most significant first. Returns that byte, or 0 - 1 if the
// extension is malformed or holds no bits at all. Malformed isn't the same as
// absent (slot 19's -1): x509_exts refuses the certificate for it, where an
// absent keyUsage is unrestricted.
x509_keyusage(b, val)
    bs = der_expect(b, val[1], der_end(val), 3)
    if bs == 0
        return 0 - 1
    if bs[2] < 2
        return 0 - 1
    // bs[1] is the offset of the unused-bit count, and the bits follow it.
    return b[bs[1] + 1]

// extendedKeyUsage (RFC 5280 section 4.2.1.12) is a SEQUENCE of purpose OIDs.
// It answers a different question from keyUsage: what the certificate may be
// presented as, where keyUsage says what the key may do. A certificate issued
// only for client authentication must not answer for a server, and a verifier
// that only checks the signatures would accept it anyway, which turns a
// legitimately issued certificate into a server impersonation.
//
// 1 if the sequence names id-kp-serverAuth, 0 if it names only other purposes,
// and 0 - 1 if the extension is malformed. An absent extension is unrestricted
// and never gets here: the caller's default is 1.
//
// anyExtendedKeyUsage (2.5.29.37.0) isn't accepted in its place. It's forbidden
// in a publicly trusted server certificate, openssl's `-purpose sslserver`
// refuses it at every depth, and reading it as "yes to everything" would turn
// the one extension that narrows a certificate's use into one that widens it.
x509_eku(b, val)
    sq = der_expect(b, val[1], der_end(val), 48)
    if sq == 0
        return 0 - 1
    e = der_end(sq)
    p = sq[1]
    found = 0
    loop p < e
        oid = der_expect(b, p, e, 6)
        if oid == 0
            return 0 - 1
        if der_content_is(b, oid, x509_unhex("2b06010505070301")) == 1
            found = 1
        p = der_end(oid)
    return found

// The extensions, which arrive wrapped in an explicit [3].
//
// Every extension carries a criticality flag, and RFC 5280 section 4.2 says a
// certificate-using system must reject a certificate with a critical extension
// it doesn't recognize or can't process. So the scan tracks which extensions it
// acts on, and records any other critical one in slot 21. Reading past the
// flag would let an issuer mark, say, the name constraints that make a sub-CA
// safe to delegate to as critical, and have the certificate trusted as if they
// weren't there.
x509_exts(b, w, c)
    sq = der_expect(b, w[1], der_end(w), 48)
    if sq == 0
        return 0
    e = der_end(sq)
    p = sq[1]
    loop p < e
        x = der_expect(b, p, e, 48)
        if x == 0
            return 0
        xe = der_end(x)
        oid = der_expect(b, x[1], xe, 6)
        if oid == 0
            return 0
        q = der_end(oid)
        // The criticality BOOLEAN is optional and defaults to FALSE. DER spells
        // TRUE as a single 0xFF byte, and any non-zero byte is read as TRUE,
        // the same way basicConstraints reads its cA flag.
        crit = 0
        v = der_read(b, q, xe)
        if v == 0
            return 0
        if v[0] == 1
            if v[2] != 1
                return 0
            if b[v[1]] != 0
                crit = 1
            q = der_end(v)
        val = der_expect(b, q, xe, 4)
        if val == 0
            return 0
        known = 0
        if der_content_is(b, oid, x509_unhex("551d13")) == 1
            known = 1
            if x509_bc(b, val, c) == 0
                return 0
        if der_content_is(b, oid, x509_unhex("551d11")) == 1
            known = 1
            c[17] = x509_san(b, val)
            c[18] = x509_san_ip(b, val)
        if der_content_is(b, oid, x509_unhex("551d0f")) == 1
            known = 1
            ku = x509_keyusage(b, val)
            if ku < 0
                return 0
            c[19] = ku
        if der_content_is(b, oid, x509_unhex("551d25")) == 1
            known = 1
            ek = x509_eku(b, val)
            if ek < 0
                return 0
            c[20] = ek
        // Not one of the four this code processes, and the issuer said it had
        // to be. It's recorded here and refused in x509_path, where every
        // other path decision is made.
        if crit == 1 && known == 0
            c[21] = 1
        // Name and policy constraints aren't implemented, so a certificate that
        // carries one is refused whether it's marked critical or not. RFC 5280
        // says a CA must mark nameConstraints critical, but some constrained
        // sub-CAs don't, and ignoring the constraint would let one issue for a
        // name it was never allowed to. (nameConstraints 2.5.29.30,
        // policyConstraints 2.5.29.36, inhibitAnyPolicy 2.5.29.54)
        if der_content_is(b, oid, x509_unhex("551d1e")) == 1 || der_content_is(b, oid, x509_unhex("551d24")) == 1 || der_content_is(b, oid, x509_unhex("551d36")) == 1
            c[21] = 1
        p = xe
    return 1

// A DER certificate into the twenty-two slots, or 0 if it's malformed or its
// own key isn't RSA, P-256, P-384, P-521 or Ed25519.
x509_parse(der)
    n = len(der)
    top = der_expect(der, 0, n, 48)
    if top == 0
        return 0
    e = der_end(top)
    tbs = der_expect(der, top[1], e, 48)
    if tbs == 0
        return 0
    c = text(22)
    c[0] = der
    c[1] = top[1]
    c[2] = der_end(tbs) - top[1]
    c[15] = 0
    c[16] = -1
    c[17] = 0
    c[18] = 0
    c[19] = 0 - 1
    // An absent extendedKeyUsage places no restriction, so the default is the
    // permissive one. An absent extension is the only way slot 20 stays 1
    // without x509_eku having said so.
    c[20] = 1
    c[21] = 0
    sa = der_expect(der, der_end(tbs), e, 48)
    if sa == 0
        return 0
    al = x509_sigalg(der, sa)
    if al == 0
        return 0
    c[3] = al[0]
    c[4] = al[1]
    sv = der_expect(der, der_end(sa), e, 3)
    if sv == 0
        return 0
    c[5] = der_bits(der, sv)
    if c[5] == 0
        return 0
    te = der_end(tbs)
    p = tbs[1]
    v = der_read(der, p, te)
    if v == 0
        return 0
