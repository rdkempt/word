    // into its register, instead of being computed first and carried across
    // the region and the subscript on the stack. The same reasoning as
    // gen_two_operands: a leaf is a literal or a local, so reading it can't
    // fault or print, and nothing the other two operands do can change it.
    vleaf = is_leaf_operand(cg, valexpr)
    if !vleaf
        gen_expr(cg, valexpr)
        asmput("    push rax")
    gen_expr(cg, target[1])
    // A literal subscript into a region of known length needs no register at
    // all: the displacement is a constant, so the index is never loaded and
    // never checked.
    kfold = const_idx(cg, target[1], target[2])
    if kfold < 0
        // Same as the load: a leaf subscript needs no spill of the region.
        if is_leaf_operand(cg, target[2])
            gen_leaf_into(cg, target[2], "rcx")
        else
            asmput("    push rax")
            gen_expr(cg, target[2])
            asmput("    mov rcx, rax")
            asmput("    pop rax")
    if vleaf
        gen_leaf_into(cg, valexpr, "rdx")
    else
        asmput("    pop rdx")
    stk = cg_kind(cg, target[1])
    sdone = 0
    if stk == 4
        asmput("    mov rdi, rax")
        asmput("    mov rsi, rcx")
        asmput("    call rt_map_set")
        return 0
    if cg[20] == 1 && stk != 1
        snotmap = new_label(cg)
        sdone = new_label(cg)
        asmput("    mov r11, rax")
        asmput("    and r11, 7")
        asmput("    cmp r11, 4")
        asmput("    jne " . snotmap)
        asmput("    mov rdi, rax")
        asmput("    mov rsi, rcx")
        asmput("    call rt_map_set")
        asmput("    jmp " . sdone)
        asmput(snotmap . ":")
    if cg_kind(cg, target[1]) != 1
        regcheck("rax")
    if kfold < 0 && cg_kind(cg, target[2]) != 0
        idxnumcheck(cg, "rcx")
    // A target the subkind pass proved is freshly allocated can't be in the
    // literal pool, so the write guard would check a fact already known.
    tsub = cg_sub(cg, target[1])
    if tsub != 1 && tsub != 2
        asmput("    cmp rax, [rip+litpool_top]")
        asmput("    jb rt_wrlit")
    // A region that has been used as a map key is read-only from then on
    // (SPEC 3.7), because the map keeps it and indexed it by its contents. The
    // mark is a flags bit, so the guard is a test and a branch, and it's
    // emitted only for a program that has a map in it at all, since nothing
    // else can set the bit. The subkind pass can't drop this one the way it
    // drops the literal check above: `k = "" . "abc"` is freshly allocated and
    // can become a key on the next line.
    if cg[20] == 1
        asmput("    test qword ptr [rax - 16], 4")
        asmput("    jnz rt_wrkey")
    if kfold < 0
        asmput("    sar rcx, 1")
    // One unsigned compare covers both ends of the bound. A negative index read
    // as unsigned is larger than any possible length (no region can be long
    // enough to reach 2^63), so `jae` fires for `i < 0` and `i >= len` alike.
    // That's two instructions fewer than the signed pair, on the operation the
    // language runs most. The length is the compare's memory operand, so it
    // never lands in a register.
    if kfold < 0 && !index_elidable(cg, target[1], target[2])
        asmput("    cmp rcx, [rax]")
        asmput("    jae rt_boundsidx")
    // Subkind: a byte-backed target (flags bit 0) holds one packed byte per
    // element, so the value's low byte goes to [rax+8+i], and a word-backed
    // one stores the whole tagged word. A whole number above 255 keeps its low
    // byte (SPEC 3.4). When the subkind is known, so is the store: emit the one
    // that applies instead of testing the flag and branching over the other. A
    // value the compiler knows is an integer skips the byte check.
    bchk = cg_kind(cg, valexpr) != 0
    if tsub == 1 || tsub == 4
        if bchk
            bytecheck(cg, "rdx")
        asmput("    sar rdx, 1")
        if kfold >= 0
            asmput("    mov [rax + " . (kfold + 8) . "], dl")
        else
            asmput("    mov [rax + rcx + 8], dl")
    else if tsub == 2 || tsub == 3
        if kfold >= 0
            asmput("    mov [rax + " . (kfold * 8 + 8) . "], rdx")
        else
            asmput("    mov [rax + rcx*8 + 8], rdx")
    else if kfold >= 0
        bs2 = new_label(cg)
        ds2 = new_label(cg)
        asmput("    test qword ptr [rax - 16], 1")
        asmput("    jnz " . bs2)
        asmput("    mov [rax + " . (kfold * 8 + 8) . "], rdx")
        asmput("    jmp " . ds2)
        asmput(bs2 . ":")
        if bchk
            bytecheck(cg, "rdx")
        asmput("    sar rdx, 1")
        asmput("    mov [rax + " . (kfold + 8) . "], dl")
        asmput(ds2 . ":")
    else
        bs = new_label(cg)
        ds = new_label(cg)
        asmput("    test qword ptr [rax - 16], 1")
        asmput("    jnz " . bs)
        asmput("    mov [rax + rcx*8 + 8], rdx")
        asmput("    jmp " . ds)
        asmput(bs . ":")
        if bchk
            bytecheck(cg, "rdx")
        asmput("    sar rdx, 1")
        asmput("    mov [rax + rcx + 8], dl")
        asmput(ds . ":")
    if sdone != 0
        asmput(sdone . ":")

// Queue a line of code to be emitted out of line, after the current function's
// `ret`. It's for cold paths (a comparison's helper call, the map arm of an
// index or `len`, a byte-backed load the subkind pass couldn't rule out), so
// the hot path falls straight through. flush_later emits the queue at the end
// of every function.
emlater(cg, line)
    cg[16] = ladd_grow(cg[16], line)

// The deferred lines (the out-of-line cold paths) for the function just
// emitted. It doesn't reset cg[16]: gen_function does that after rewinding the
// arena, because a list allocated here would be inside the rewound window.
flush_later(cg)
    lst = cg[16]
    i = 0
    loop i < lcount(lst)
        asmput(lget(lst, i))
        i = i + 1

// The jump taken when a comparison is false. gen_cond_jump uses it for the
// inline integer path (flags from `cmp` on the tagged words), for rt_eq's path
// (`cmp rax, 1` on its 0 or 1) and, through order_jfalse, for rt_order's `<`
// and `<=` (`cmp rax, 0` on its answer).
jcc_false(op)
    if op == "=="
        return "jne"
    if op == "!="
        return "je"
    if op == "<"
        return "jge"
    if op == "<="
        return "jg"
    if op == ">"
        return "jle"
    return "jl"

// A home that is one of the pinned general registers (rbx, r12-r15), not a
// frame slot and not an xmm register.
is_gpr_home(h)
    if len(h) < 3
        return false
    return h[0] == 114

// The left operand of a proved-integer compare. A pinned local is compared in
// its own register (`cmp rbx, r12` for `i < n`, with no `mov rax, rbx`
// first), and anything else is evaluated into rax. A raw u32 local isn't a
// candidate, since its register holds the untagged value.
cmp_left(cg, e)
    if e[0] == 13
        if !is_float_local(cg, e[1]) && is_u32_local(cg, e[1]) == 0
            h = env_lookup(cg, e[1])
            if is_gpr_home(h)
                return h
    gen_expr(cg, e)
    return "rax"

// Emit "jump to `target` if this condition is false", the shape both `if` and
// `loop` want. When the condition is a comparison, branch on the flags directly
// instead of building a tagged boolean and then testing it, which would cost a
// setcc, a movzx, a lea to re-tag, a cmp and a je on top of the compare. The
// integer fast path falls through to the body, with any helper call out of
// line (emlater), so the hot path takes one predicted branch. `&&`, `||` and
// `!` branch on their parts, and any other condition (a call, a variable)
// takes the general path through gen_truth_jump.
gen_cond_jump(cg, cond, target)
    // `A && B` and `A || B` as a condition branch on each side in turn, the way
    // a lone comparison does, instead of building true or false in rax (a
    // setcc, a re-tag and two truth compares per side) and then testing that.
    // Each side is still evaluated only when the other didn't already decide,
    // and still faults when it isn't a condition: a side that isn't a
    // comparison goes through the general path's truth test below, the same
    // one gen_logic applies to it.
    if cond[0] == 14 && cond[1] == "&&"
        gen_cond_jump(cg, cond[2], target)
        gen_cond_jump(cg, cond[3], target)
        return 0
    if cond[0] == 14 && cond[1] == "||"
        rightl = new_label(cg)
        truel = new_label(cg)
        gen_cond_jump(cg, cond[2], rightl)
        asmput("    jmp " . truel)
        asmput(rightl . ":")
        gen_cond_jump(cg, cond[3], target)
        asmput(truel . ":")
        return 0
    // `!A`: a compare of two proved integers becomes the opposite compare
    // (there's no NaN among integers). Anything else branches on A itself and
    // jumps over, which tests once where building `!A` as a boolean would test
    // twice.
    if cond[0] == 15 && cond[1] == "!"
        inv = cmp_inverted(cg, cond[2])
        if inv != 0
            gen_cond_jump(cg, inv, target)
            return 0
        holdl = new_label(cg)
        gen_cond_jump(cg, cond[2], holdl)
        asmput("    jmp " . target)
        asmput(holdl . ":")
        return 0
    if cond[0] == 14 && is_cmp_op(cond[1])
        op = cond[1]
        // `if kind(x) == "bytes"` folds here too. Without this the branch form,
        // which is where a kind test is nearly always written, would take the
        // general compare path and pay for the rt_kind call the fold removes.
        // (arm64 needs no such case: a64_cond_jump falls through to
        // a64_gen_compare, which already folds.)
        kn = kind_cmp_name(cond)
        if kn != 0 && is_kind_name(kn)
            gen_kind_test(cg, kind_cmp_arg(cond), kn, op == "!=")
            // gen_kind_test answers `true` (22) or `false` (14) (emit_bool), so
            // the branch tests for 22.
            asmput("    cmp rax, 22")
            asmput("    jne " . target)
            return 0
        // A comparison known to be float branches on ucomisd's flags directly.
        // This is the site that matters: `if xx + yy > 4.0` is the condition of
        // a float loop, and the tagged path would box both sides on every
        // iteration, two arena allocations per pass that no unboxing elsewhere
        // could remove.
        if cg[14] == 1 && is_float_cmp(cg, cond)
            gen_float_cond_jump(cg, cond, target)
            return 0
        clk = cg_kind(cg, cond[2])
        crk = cg_kind(cg, cond[3])
        // A literal right-hand side is the compare's immediate. On the integer
        // path that leaves the whole loop test at one load and one cmp, with no
        // 10-byte movabs to stage the constant in rsi first, and `i < n`
        // against a constant is most of the loop tests there are.
        if clk == 0 && crk == 0
            k = int_imm(cond[3], 1)
            if len(k) > 0
                lr = cmp_left(cg, cond[2])
                asmput("    cmp " . lr . ", " . k)
                asmput("    " . jcc_false(op) . " " . target)
                return 0
            // A local on the right is the compare's memory operand, so the
            // bound needs no register of its own. This is the test of nearly
            // every counted loop whose limit is a variable. A raw u32 local is
            // excluded, like a float: its home holds an untagged value, and
            // comparing it against the tagged left operand would compare 2v+1
            // against v, so it has to go through gen_expr to be tagged first.
            if cond[3][0] == 13 && !is_float_local(cg, cond[3][1]) && is_u32_local(cg, cond[3][1]) == 0
                lr = cmp_left(cg, cond[2])
                asmput("    cmp " . lr . ", " . env_lookup(cg, cond[3][1]))
                asmput("    " . jcc_false(op) . " " . target)
                return 0
            // A raw u32 local on the right (a loop bound such as `n = 1000000`)
            // is tagged into rax and compared against a local on the left in
            // its home, `cmp rbx, rax`, with no copies into rdi and rsi. The
            // right is read first, and since two plain local reads can't fault
            // or change anything, the order can't be seen.
            if cond[3][0] == 13 && is_u32_local(cg, cond[3][1]) == 1 && cond[2][0] == 13 && is_leaf_operand(cg, cond[2])
                gen_expr(cg, cond[3])
                asmput("    cmp " . env_lookup(cg, cond[2][1]) . ", rax")
                asmput("    " . jcc_false(op) . " " . target)
                return 0
        gen_two_operands(cg, cond, "rdi", "rsi")
        // As in gen_compare, known-integer operands need neither the guard nor
        // the deferred helper path, so a counted loop's test is a cmp and a
        // jump.
        if clk == 0 && crk == 0
            asmput("    cmp rdi, rsi")
            asmput("    " . jcc_false(op) . " " . target)
            return 0
        fastl = new_label(cg)
        donel = new_label(cg)
        // "Both operands are integers" is (rdi & rsi) & 1. An integer literal on
        // the right always has that bit set, so only the left is in question,
        // and one `test` does instead of a mov and an and.
        if cond[3][0] == 11
            asmput("    test rdi, 1")
        else
            asmput("    mov r10, rdi")
            asmput("    and r10, rsi")
            asmput("    test r10, 1")
        asmput("    jz " . fastl)
        asmput("    cmp rdi, rsi")
        asmput("    " . jcc_false(op) . " " . target)
        asmput(donel . ":")
        // The region and float path is emitted out of line, past this
        // function's `ret` (flush_later), and jumps back. So the integer path
        // falls straight through, and none of the helper call's instructions
        // sit in the loop's decode stream.
        emlater(cg, fastl . ":")
        if op == "==" || op == "!="
            emlater(cg, "    call rt_eq")
            emlater(cg, "    cmp rax, 1")
            emlater(cg, "    " . jcc_false(op) . " " . target)
        else
            emlater(cg, "    call rt_order")
            emlater(cg, "    cmp rax, " . order_imm(op))
            emlater(cg, "    " . order_jfalse(op) . " " . target)
        emlater(cg, "    jmp " . donel)
        return 0
    gen_expr(cg, cond)
    gen_truth_jump(cg, cond, target)

// Turn `a op b` on two proved integers into the comparison that holds when it
// doesn't (`a >= b` for `a < b`), with the same operands in the same order, or
// answer 0 when `e` is anything else. A float comparison is never inverted:
// with a NaN on either side, `x < y` and `x >= y` are both false.
cmp_inverted(cg, e)
    if e[0] != 14 || !is_cmp_op(e[1])
        return 0
    if cg_kind(cg, e[2]) != 0 || cg_kind(cg, e[3]) != 0
        return 0
    op = e[1]
    n = copy(e)
    if op == "<"
        n[1] = ">="
    else if op == "<="
        n[1] = ">"
    else if op == ">"
        n[1] = "<="
    else if op == ">="
        n[1] = "<"
    else if op == "=="
        n[1] = "!="
    else
        n[1] = "=="
    return n

// "Jump to `target` if this float comparison is false." ucomisd sets ZF, PF and
// CF together on an unordered pair, so asking `<` and `<=` as a reversed `>`
// or `>=` makes every ordering operator take the false branch on a NaN with no
// extra test. == and != test the parity flag themselves.
gen_float_cond_jump(cg, cond, target)
    op = cond[1]
    y = gen_float_cmp_operands(cg, cond)
    if op == "<"
        asmput("    ucomisd xmm1, xmm0")
        asmput("    jbe " . target)
    else if op == "<="
        asmput("    ucomisd xmm1, xmm0")
        asmput("    jb " . target)
    else if op == ">"
        asmput("    ucomisd xmm0, " . y)
        asmput("    jbe " . target)
    else if op == ">="
        asmput("    ucomisd xmm0, " . y)
        asmput("    jb " . target)
    else if op == "=="
        asmput("    ucomisd xmm0, " . y)
        asmput("    jp " . target)
        asmput("    jne " . target)
    else
        skip = new_label(cg)
        asmput("    ucomisd xmm0, xmm1")
        asmput("    jp " . skip)
        asmput("    je " . target)
        asmput(skip . ":")

gen_if(cg, s)
    elsel = new_label(cg)
    endl = new_label(cg)
    gen_cond_jump(cg, s[1], elsel)
    thn = s[2]
    i = 0
    loop i < lcount(thn)
        gen_stmt(cg, lget(thn, i))
        i = i + 1
    // An `if` with no `else` ends where its false branch lands, so a jump over
    // the else arm would be a taken jump to the very next instruction, on every
    // pass through the body of the most common statement there is.
    if s[3] != 0
        asmput("    jmp " . endl)
    asmput(elsel . ":")
    if s[3] != 0
        orl = s[3]
        j = 0
        loop j < lcount(orl)
            gen_stmt(cg, lget(orl, j))
            j = j + 1
    asmput(endl . ":")

// `loop x in y`: walk the elements of region y, binding each to x (SPEC 7.2).
// It's the same index walk `loop i < len(y)` with `x = y[i]` compiles to, with
// no new runtime. y is evaluated once into a hidden slot, and anything that
// isn't a region faults through rt_regfault instead of being walked. The
// element read uses the byte or word load by the region's flag (a byte-backed
// fs.read buffer gives each byte as an integer, anything else the stored word).
// The index and the held pointer live in hidden frame slots and are reloaded
// each pass, so a call in the body may clobber any register.
gen_foreach(cg, s)
    gen_expr(cg, s[2])
    if cg_kind(cg, s[2]) != 1
        regcheck("rax")
    pslot = env_lookup(cg, fe_hidden_p(s))
    islot = env_lookup(cg, fe_hidden_i(s))
    vslot = env_lookup(cg, s[1])
    asmput("    mov " . pslot . ", rax")
    asmput("    mov qword ptr " . islot . ", 0")
    topl = new_label(cg)
    endl = new_label(cg)
    prevbreak = cg[7]
    cg[7] = endl
    asmput(topl . ":")
    asmput("    mov rcx, " . islot)
    asmput("    mov rax, " . pslot)
    asmput("    cmp rcx, [rax]")
    asmput("    jge " . endl)
    febl = new_label(cg)
    fedl = new_label(cg)
    asmput("    test qword ptr [rax - 16], 1")
    asmput("    jnz " . febl)
    asmput("    mov rax, [rax + rcx*8 + 8]")
    asmput("    jmp " . fedl)
    asmput(febl . ":")
    asmput("    movzx rax, byte ptr [rax + rcx + 8]")
    asmput("    lea rax, [rax*2 + 1]")
    asmput(fedl . ":")
    asmput("    mov " . vslot . ", rax")
    feb = s[3]
    fi = 0
    loop fi < lcount(feb)
        gen_stmt(cg, lget(feb, fi))
        fi = fi + 1
    asmput("    mov rcx, " . islot)
    asmput("    inc rcx")
    asmput("    mov " . islot . ", rcx")
    asmput("    jmp " . topl)
    asmput(endl . ":")
    cg[7] = prevbreak

// ---- loop-invariant `len` ------------------------------------------------
//
// `loop i < len(a)` works out len(a) on every pass, and when the compiler
// can't tell whether `a` is a region or a map (a parameter, usually) that's a
// kind check as well as a load. Moving it out of the loop is safe when nothing
// in the loop can change the answer. LLVM gets that for Rust from `&mut` being
// unique. Here it's simpler: a region's length only changes when its name is
// assigned, and the compiler can look for that.
//
// So the length is hoisted when the loop's test compares against
// `len(<name>)` and the body never assigns `<name>`, either with `=` or by
// binding it as a for-each variable. An index store (`a[i] = v`) can't change
// a region's length, but it can add a key to a map (see loop_hoist_safe).
// Anything else, including `len` of an expression, is left alone.
//
// The hidden local is named from the loop's line and column, the same way the
// for-each hidden pair is, so it can't collide with a user name (which can't
// contain `@`) or with another loop.
loop_len_hidden(s)
    return "@n" . s[3] . "_" . s[4]

// The name whose `len` this loop tests against, or "" if the shape does not fit.
loop_len_name(s)
    c = s[1]
    if c == 0
        return ""
    if c[0] != 14
        return ""
    if !is_cmp_op(c[1])
        return ""
    r = c[3]
    if r[0] != 17
        return ""
    if r[1] != "len"
        return ""
    a = r[2]
    if lcount(a) != 1
        return ""
    a0 = lget(a, 0)
    if a0[0] != 13
        return ""
    return a0[1]

// Is `name` assigned anywhere in this statement, at any nesting depth?
stmt_assigns(st, name)
    k = st[0]
    if k == 4
        if st[1] == name
            return true
    else if k == 5
        t = st[1]
        if t[0] == 13
            if t[1] == name
                return true
    else if k == 6
        if stmts_assign(st[2], name)
            return true
        if st[3] != 0
            if stmts_assign(st[3], name)
                return true
    else if k == 7
        if stmts_assign(st[2], name)
            return true
    else if k == 20
        if st[1] == name
            return true
        if stmts_assign(st[3], name)
            return true
    return false

// Is `name` assigned anywhere in these statements?
stmts_assign(stmts, name)
    i = 0
    loop i < lcount(stmts)
        if stmt_assigns(lget(stmts, i), name)
            return true
        i = i + 1
    return false

// The index of the first statement that assigns `name`, or the count if none.
// Everything before it still sees the value the loop's test checked.
first_assign_at(stmts, name)
    i = 0
    loop i < lcount(stmts)
        if stmt_assigns(lget(stmts, i), name)
            return i
        i = i + 1
    return lcount(stmts)

// A counting local is one that's only ever set to a non-negative integer
// literal or advanced by a positive one, so `i >= 0` always holds. Dropping a
// bounds check needs that: the check is one unsigned compare, and its `jae` is
// what catches a negative index (unsigned, it's enormous). A parameter is never
// counting, since nothing is known about what a caller passes, and neither is
// a `loop x in y` variable, which is bound to an element.
counting_rhs(name, e)
    if e[0] == 11
        if e[1] >= 0
            return true
        return false
    if e[0] != 14
        return false
    if e[1] != "+"
        return false
    l = e[2]
    r = e[3]
    if l[0] != 13
        return false
    if l[1] != name
        return false
    if r[0] != 11
        return false
    if r[1] > 0
        return true
    return false

// Does every write to `name` in these statements keep it counting? This is
// asked for one name at a time, because only the loop variable of a
// `loop i < len(a)` ever needs the answer, and a function has one or two of
// those among hundreds of locals. A table of every local cost 0.13% more on a
// self-build, more than the elision saved there, and nearly all of it was map
// inserts for names nobody asked about.
counting_walk(stmts, name)
    i = 0
    loop i < lcount(stmts)
        st = lget(stmts, i)
        k = st[0]
        if k == 4
            if st[1] == name
                if !counting_rhs(name, st[2])
                    return 0
        else if k == 5
            t = st[1]
            if t[0] == 13
                if t[1] == name
                    if !counting_rhs(name, st[2])
                        return 0
        else if k == 6
            if counting_walk(st[2], name) == 0
                return 0
            if st[3] != 0
                if counting_walk(st[3], name) == 0
                    return 0
        else if k == 7
            if counting_walk(st[2], name) == 0
                return 0
        else if k == 20
            if st[1] == name
                return 0
            if counting_walk(st[3], name) == 0
                return 0
        i = i + 1
    return 1

is_param_name(params, name)
    i = 0
    loop i < lcount(params)
        if lget(params, i) == name
            return true
        i = i + 1
    return false

// Worked out once per name per function and kept in cg[51], because a nested
// loop over the same variable asks again.
is_counting(cg, name)
    tbl = cg[51]
    if tbl == 0
        tbl = {}
        cg[51] = tbl
    if has(tbl, name)
        return tbl[name]
    r = 0
    if !is_param_name(cg[53], name)
        r = counting_walk(cg[54], name)
    tbl[name] = r
    return r

// The loop variable of a `loop i < ...`, or "" for any other shape. gen_loop
// only asks when loop_hoist has found `len(a)` on the right. Only `<` will do:
// `i <= len(a)` says nothing useful about `a[i]`.
loop_iv_name(s)
    c = s[1]
    if c == 0
        return ""
    if c[0] != 14
        return ""
    if c[1] != "<"
        return ""
    l = c[2]
    if l[0] != 13
        return ""
    return l[1]

// The key an elidable (region, index) pair is filed under. "|" can't occur in
// a name, so no two pairs collide.
elide_key(rname, iname)
    return rname . "|" . iname

// Is this subscript one the enclosing loop's test already checked? It answers
// true or false, so callers test it as a condition. `index_elidable(...) == 0`
// is never true (false isn't 0), and would drop the bounds check on every
// subscript the test doesn't cover.
index_elidable(cg, base, idx)
    if cg[52] == 0
        return false
    if base[0] != 13
        return false
    if idx[0] != 13
        return false
    return has(cg[52], elide_key(base[1], idx[1]))

// "" when this loop doesn't qualify, else the hidden local to hold the length.
loop_hoist(s)
    n = loop_len_name(s)
    if len(n) == 0
        return ""
    if stmts_assign(s[2], n)
        return ""
    return loop_len_hidden(s)

// loop_hoist looks at the statement alone, because collect_locals asks it for
// a slot before any kind is known, so the slot can go unused. A region's length
// only changes when its name is assigned, but a map grows with every new key,
// stored through any name that holds it or by any function it's passed to. So
// the length of a name that isn't proved to be a region stays in the loop when
// the body has an index store or a user call, or the test's left side has a
// user call.
loop_hoist_safe(cg, s)
    if cg_kind(cg, lget(s[1][3][2], 0)) == 1
        return 1
    if expr_calls_fn(s[1][2], cg[1]) == 1
        return 0
    if stmts_write_shared(s[2], cg[1]) == 1
        return 0
    return 1

// `st` is 1 when the statement stores its line (stmt_line_plan). The store goes
// before the loop when only the first pass needs it, and at the top of the loop
// when every pass does (loop_pass_line). Whether the length is hoisted is
// decided first, because a length left in the loop is read on every pass.
gen_loop(cg, s, st)
    topl = new_label(cg)
    endl = new_label(cg)
    prevbreak = cg[7]
    cg[7] = endl
    hl = loop_hoist(s)
    hn = hl
    if len(hn) > 0 && loop_hoist_safe(cg, s) == 0
        hn = ""
    pl = loop_pass_line(cg, s, hn)
    if st == 1 && (pl == 0 || len(hn) > 0)
        asmput("    mov qword ptr [rip+cur_line], " . node_ln(s))
    cond = s[1]
    if len(hn) > 0
        gen_expr(cg, s[1][3])
        asmput("    mov " . env_lookup(cg, hn) . ", rax")
        // the same comparison, against the hoisted length instead of the call
        hv = array(4)
        hv[0] = 13
        hv[1] = hn
        hv[2] = s[3]
        hv[3] = s[4]
        nc = array(6)
        nc[0] = 14
        nc[1] = s[1][1]
        nc[2] = s[1][2]
        nc[3] = hv
        nc[4] = s[3]
        nc[5] = s[4]
        cond = nc
    // Align the loop head to 16 bytes. Without it, timings moved with where a
    // hot loop happened to land: sieve moved 5% either way when a few dead
    // statements shifted it past a fetch boundary, and one change measured 6%
    // slower at one offset and faster at the other three. The padding is at
    // most 15 bytes of nops, run once on the way into the loop.
    asmput("    .align 16")
    asmput(topl . ":")
    if pl > 0
        asmput("    mov qword ptr [rip+cur_line], " . pl)
    if s[1] != 0
        gen_cond_jump(cg, cond, endl)
    bdy = s[2]
    // The test has just checked `i < len(a)`, and `i >= 0` holds all through
    // the function when `i` is counting, so `a[i]` in the body needs no bounds
    // check of its own. That only lasts until the first statement that writes
    // `i`: after `i = i + 1` the test was about the old value, and `a[i]` can
    // be off the end.
    //
    // `a` can't be reassigned in the body (loop_hoist refuses the loop
    // otherwise), and a region's length never shrinks (an in-place append
    // raises it and nothing lowers it), so the length the test read is still a
    // bound. The hoisted length relies on the same thing, and it holds too when
    // loop_hoist_safe keeps the length in the loop.
    prevel = cg[52]
    stop = lcount(bdy)
    if len(hl) > 0
        ivn = loop_iv_name(s)
        if len(ivn) > 0 && is_counting(cg, ivn) == 1
            stop = first_assign_at(bdy, ivn)
            nel = {}
            if prevel != 0
                nel = copy(prevel)
            nel[elide_key(loop_len_name(s), ivn)] = 1
            cg[52] = nel
    i = 0
    loop i < lcount(bdy)
        if i == stop
            cg[52] = prevel
        gen_stmt(cg, lget(bdy, i))
        i = i + 1
    cg[52] = prevel
    asmput("    jmp " . topl)
    asmput(endl . ":")
    cg[7] = prevbreak

// ---- static uniqueness pass (the in-place append, SPEC 3.4) ----
// A local is unique when nothing else can reach its region, so `s = s . x` can
// append into the old buffer instead of allocating a new one. The dead-store
// rewind (is_reclaim_store) and the in-place float accumulate (is_float_acc)
// use the same answer. A name escapes (becomes shared) as soon as its word is
// copied somewhere that can outlive the change: assigned to or from another
// variable, read out of a region (an index load), stored into a region or a
// map (as a value or a key), or passed to a user function that can keep it
// (fn_retains). Join operands, indices, comparisons and builtin arguments are
// plain reads and don't alias, since no builtin keeps what it's handed.
// `return` isn't an escape: it ends the function, so no later append in it can
// change what was returned. Anything the pass can't prove is shared, and gets
// the allocate-and-copy path.
is_user_call(cg, e)
    if e[0] != 17
        return 0
    return fn_is_known(cg, e[1])

// A builtin that can hand back one of its arguments unchanged (the same word,
// so the same region or the same float box) answers that argument's position,
// and every other builtin answers -1. No builtin keeps what it's handed, but
// these three can return it: decode when it's already code points, pad when
// it's already wide enough, and number when it's already a number (a float box
// included, which the in-place float accumulate writes into). So
// `u = decode(t)` can be `u = t`. Treating it as a new region let the in-place
// append grow t under u, and the dead-store rewind hand t's bytes to the next
// allocation.
//
// A new builtin that can return an argument has to be listed here. The
// uniqueness pass takes any other builtin's result to be a new region.
builtin_aliases_arg(name)
    if name == "decode" || name == "pad" || name == "number"
        return 0
    return 0 - 1

// What `e` may evaluate to, with every builtin that can return its argument
// peeled off: `pad(decode(t), 8, 32)` may be t itself, and so may `t`.
alias_core(cg, e)
    loop e[0] == 17
        if fn_is_known(cg, e[1]) == 1
            return e
        ai = builtin_aliases_arg(e[1])
        if ai < 0 || ai >= lcount(e[2])
            return e
        e = lget(e[2], ai)
    return e

// Does any statement in `stmts`, at any depth, assign `name`?
assigns_name(stmts, name)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 4
            if s[1] == name
                return true
        else if k == 5
            if s[1][0] == 13 && s[1][1] == name
                return true
        else if k == 6
            if assigns_name(s[2], name)
                return true
            if s[3] != 0
                if assigns_name(s[3], name)
                    return true
        else if k == 7
            if assigns_name(s[2], name)
                return true
        else if k == 20
            if s[1] == name
                return true
            if assigns_name(s[3], name)
                return true
        i = i + 1
    return false

// The shared set is a map, so it has no size limit and a lookup is one probe.
// It used to be a fixed 64-entry list: a function with more escaping names than
// that crashed the compiler, and the linear scans made the pass quadratic in
// the size of the function.
mark_escape(shared, name)
    shared[name] = 1

// A container keeps the words it's handed. rt_map_set stores the key word and
// the value word as they are, and an index store writes the value word into
// the region, with no copy either way. So a bare name in one of those
// positions can still be reached through the container afterwards, and
// neither the in-place append nor the dead-store rewind may touch its region.
//
// Keys count too. When only values were marked, `m[k] = v` with a unique k let
// the next `k = k . x` append into the key the map held, and `m["abc"]` could
// no longer find the pair `out(m)` printed as "abcx". What decides it is the
// position: `m[k]` only reads with k, while `m[k] = v` keeps it, and both are
// the same kind of node.
mark_if_name(cg, shared, e)
    e = alias_core(cg, e)
    if e[0] == 13
        mark_escape(shared, e[1])

// Every subscript along an assignment target's chain of indexes, so a nested
// store (`m[a][b] = v`) marks both.
mark_target_keys(cg, shared, tgt)
    cur = tgt
    loop cur[0] == 16
        mark_if_name(cg, shared, cur[2])
        cur = cur[1]

// `name = rhs`: mark `name` shared when `rhs` can be an aliased region. That's
// a bare variable (both names escape), an index load (a region a container
// holds), or a user call (it may return a region something kept). A join, a
// literal, text() or another builtin call gives a new region, so `name` stays
// unique. A builtin that can return its argument (builtin_aliases_arg) is
// judged by that argument instead.
mark_from_rhs(cg, shared, name, rhs)
    rhs = alias_core(cg, rhs)
    rk = rhs[0]
    if rk == 13
        mark_escape(shared, name)
        mark_escape(shared, rhs[1])
    else if rk == 16
        mark_escape(shared, name)
    else if is_user_call(cg, rhs) == 1
        mark_escape(shared, name)

expr_escapes(cg, shared, e)
    k = e[0]
    if k == 19
        // A `{}` literal is a run of rt_map_set calls, so it keeps its keys and
        // values the way `m[k] = v` does. Without this, `{k: t}` held t's
        // buffer while t stayed unique, and the next append to t changed the
        // map's value. Keys are always literal text (SPEC 3.7), so marking them
        // only matters if that changes.
        ks = e[1]
        vals = e[2]
        i = 0
        loop i < lcount(vals)
            kn = lget(ks, i)
            vn = lget(vals, i)
            mark_if_name(cg, shared, kn)
            mark_if_name(cg, shared, vn)
            expr_escapes(cg, shared, kn)
            expr_escapes(cg, shared, vn)
            i = i + 1
    else if k == 14
        expr_escapes(cg, shared, e[2])
        expr_escapes(cg, shared, e[3])
    else if k == 15
        expr_escapes(cg, shared, e[2])
    else if k == 16
        expr_escapes(cg, shared, e[1])
        expr_escapes(cg, shared, e[2])
    else if k == 17
        usr = fn_is_known(cg, e[1])
        args = e[2]
        i = 0
        loop i < lcount(args)
            a = lget(args, i)
            if usr == 1
                ac = alias_core(cg, a)
                if ac[0] == 13
                    if fn_retains(cg, e[1], i) == 1
                        mark_escape(shared, ac[1])
            expr_escapes(cg, shared, a)
            i = i + 1

stmt_escapes(cg, shared, s)
    k = s[0]
    if k == 4
        mark_from_rhs(cg, shared, s[1], s[2])
        expr_escapes(cg, shared, s[2])
    else if k == 5
        tgt = s[1]
        if tgt[0] == 13
            mark_from_rhs(cg, shared, tgt[1], s[2])
        else
            mark_target_keys(cg, shared, tgt)
            expr_escapes(cg, shared, tgt)
            mark_if_name(cg, shared, s[2])
        expr_escapes(cg, shared, s[2])
    else if k == 6
        if s[1] != 0
            expr_escapes(cg, shared, s[1])
        walk_escapes(cg, shared, s[2])
        if s[3] != 0
            walk_escapes(cg, shared, s[3])
    else if k == 7
        // a bare `loop` has no condition (s[1] == 0), like gen_loop guards
        if s[1] != 0
            expr_escapes(cg, shared, s[1])
        walk_escapes(cg, shared, s[2])
    else if k == 20
        // The loop variable holds elements read out of the subject region, so
        // it's shared, the same as the target of an index load.
        mark_escape(shared, s[1])
        // The subject is evaluated once and held in a hidden slot for the whole
        // loop, so it's a second reference to the region while the body runs.
        // If the body reassigns the name it came from, the in-place append
        // would grow the region being walked (and the loop would walk what it
        // appended), and the dead-store rewind would hand it to the next
        // allocation. The subject is only marked in that case. Marking every
        // subject would take the in-place append away from every function
        // that builds a string and then loops over it.
        sc = alias_core(cg, s[2])
        if sc[0] == 13
            if assigns_name(s[3], sc[1])
                mark_escape(shared, sc[1])
        expr_escapes(cg, shared, s[2])
        walk_escapes(cg, shared, s[3])
    else if k == 8
        if s[1] != 0
            expr_escapes(cg, shared, s[1])
    else if k == 10
        expr_escapes(cg, shared, s[1])

walk_escapes(cg, shared, stmts)
    i = 0
    loop i < lcount(stmts)
        stmt_escapes(cg, shared, lget(stmts, i))
        i = i + 1

// Parameters alias the caller's values, so they're always shared. Returns the
// set of shared (not unique) names for one function's body and parameters.
compute_escapes(cg, params, body)
    shared = {}
    i = 0
    loop i < lcount(params)
        shared[lget(params, i)] = 1
        i = i + 1
    walk_escapes(cg, shared, body)
    return shared

// ---- does a callee keep the region it's handed? ----
//
// Without this, the pass above would have to mark a name shared as soon as
// it's passed to a user function, since the caller can't see what the callee
// does with it. That would stop the dead-store rewind at `f(t)`, and a loop
// that slices a window and hands it to a helper would keep every window. On
// 100,000 64-byte slices that measured 228 KB when the slice was used inline
// and 8.4 MB through a one-line helper.
//
// So this answers the question once per function, before codegen, with the
// same walk_escapes the uniqueness pass uses. The difference is that
// parameters aren't seeded as shared, because the question is what the body
// does with them, not where they came from. A parameter is kept when the body
// stores it in a region or a map, assigns it to or from another name, or hands
// it to another user function, and walk_escapes marks all of those.
//
// walk_escapes doesn't count a return, since in the uniqueness pass returning
// ends the function. Here a returned parameter is something the caller
// keeps, so returns_bare asks about it separately.
//
// Anything unproven is kept: a function this pass never saw, a parameter index
// past the end, a call made before the table exists. Passing a parameter on to
// another user function counts as keeping it, without looking into that
// function, so there's no fixed point to reach and recursion can't loop.
//
// rt_popregion is what makes this safe: it only rewinds a region that's still
// the last thing the arena handed out. A callee that kept the region and then
// allocated anything has moved it off the tail, and the rewind does nothing.
// So the analysis only has to catch a callee that keeps the region and
// allocates nothing after it, which means storing it into something that
// already existed.
returns_bare(cg, stmts, name)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 8
            if s[1] != 0
                // `return decode(p)` can hand p back just as `return p` does.
                rv = alias_core(cg, s[1])
                if rv[0] == 13 && rv[1] == name
                    return true
        else if k == 6
            if returns_bare(cg, s[2], name)
                return true
            if s[3] != 0
                if returns_bare(cg, s[3], name)
                    return true
        else if k == 7
            if returns_bare(cg, s[2], name)
                return true
        else if k == 20
            if returns_bare(cg, s[3], name)
                return true
        i = i + 1
    return false

infer_retention(cg, items)
    tbl = {}
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 2
            ps = it[2]
            body = it[3]
            sh = {}
            walk_escapes(cg, sh, body)
            // A contract hook runs in the same call, over the same parameter
            // words, so what a hook stores is kept just like what the body
            // stores. Asking only the body let `f:before` keep its argument in
            // a box while the caller rewound it.
            hk = lookup_hook(cg[9], it[1])
            if hk != 0
                walk_escapes(cg, sh, hk[2])
            hk = lookup_hook(cg[10], it[1])
            if hk != 0
                walk_escapes(cg, sh, hk[2])
            fl = text(lcount(ps))
            j = 0
            loop j < lcount(ps)
                pn = lget(ps, j)
                r = 1
                if !has(sh, pn)
                    if !returns_bare(cg, body, pn)
                        r = 0
                fl[j] = r
                j = j + 1
            tbl[it[1]] = fl
        i = i + 1
    cg[49] = tbl
    return 0

// Argument `idx` of a call to `fname`: 1 if the callee can leave it reachable
// after the call, 0 when infer_retention proved it can't. Anything unknown
// answers 1.
fn_retains(cg, fname, idx)
    tbl = cg[49]
    if tbl == 0
        return 1
    if !has(tbl, fname)
        return 1
    fl = tbl[fname]
    if idx >= len(fl)
        return 1
    return fl[idx]

// ---- inlining a one-line accessor ----
//
// `lcount(lst)` is `lst[0]` and `lget(lst, i)` is `lst[i + 1]`: about thirty
// instructions of call, prologue, stack guard, bounds check and epilogue to do
// one load. When I inlined every call to those two in this compiler by hand
// (638 sites), a self-build went from 7.348G instructions to 7.065G, 3.85%
// fewer.
//
// So a call is replaced by the callee's expression, under conditions narrow
// enough that the result is what a programmer would have written by hand:
//
//   - the callee's body is one statement, `return <expr>`;
//   - no argument is evaluated twice. A parameter the expression reads more
//     than once is only substituted when its argument is a name or an integer,
//     text or singleton literal (inl_dupsafe), which reads the same value at
//     every place, costs nothing and can't fail, and the expression indexes
//     nothing (inl_has_index). `dist(a, b)` for `return x * x + y * y` becomes
//     `a * a + b * b`, and `dist(a[i], b)` stays a call, since substituting
//     would index twice;
//   - a parameter the expression never reads is only allowed when its
//     argument can't fail, because substituting drops that argument:
//     `ignore(a[99])` would stop reporting the index it's supposed to fault
//     on. A name or a literal can be dropped. An index, a divide or arithmetic
//     that can overflow can't;
//   - every argument is a name, a literal, or arithmetic or an index built
//     from those (inl_simple), so it has no side effect to move;
//   - the callee has no contract hook, since a hook has to see a real call;
//   - the callee's expression has no call in it.
//
// The last one keeps the code from growing. Without it, a chain of one-liners
// that each call the next grows down the chain: f1's body goes into f2, then
// that whole expression into f3, so the tree doubles at each step. That's
// quadratic compile time (test_compile_scaling caught a doubled chain at 422%
// against the ~200% a linear pass costs). With it, a substituted expression
// has no call left to substitute, so each call site gets one copy of one
// callee's expression and nothing compounds.
//
// Anything else stays a call. This isn't a general inliner: it won't touch a
// body with two statements, a loop or a branch, and there's no size heuristic
// or threshold to tune.
//
// Two things change besides speed. A fault inside the substituted expression
// reports the caller's line, because there's no callee frame to store its own
// (SPEC 10.2). For `lget(lst, i)` out of range, that's the more useful line
// anyway. And each argument is evaluated where the expression reads it, where
// a call evaluates its arguments right to left (on both backends). That only
// shows when two arguments would both fault, and then the other one's fault
// is the one reported.

// An argument that's safe to move into the callee's expression: it computes a
// value and has no other effect (it can still fault). Names, literals,
// arithmetic and indexing qualify. A call doesn't, because substituting it
// could move or reorder its effects. A join doesn't either, because it
// allocates, and the rewind rules (SPEC 3.5) depend on which allocation is
// most recent.
inl_simple(e)
    k = e[0]
    if k == 11 || k == 12 || k == 18 || k == 21
        return 1
    if k == 13
        return 1
    if k == 15
        return inl_simple(e[2])
    if k == 14
        if e[1] == "."
            return 0
        if inl_simple(e[2]) == 0
            return 0
        return inl_simple(e[3])
    if k == 16
        if inl_simple(e[1]) == 0
            return 0
        return inl_simple(e[2])
    return 0

// Can this expression be thrown away without changing what the program does?
// Only a name and a literal: reading a name can't fail, and a literal is
// already a value. Anything else (an index, a divide, anything that can
// overflow) can stop the program, and dropping it would drop the fault too.
inl_droppable(e)
    k = e[0]
    if k == 11 || k == 12 || k == 18 || k == 21
        return true
    if k == 13
        return true
    return false

// Does `e` call anything? A body that does isn't substituted, because
// substituting it into a caller that's itself a one-liner is how the tree
// grows. A map literal and any node shape this doesn't know answer 1, so a
// new shape is turned down until someone looks at it.
inl_hascall(e)
    k = e[0]
    if k == 11 || k == 12 || k == 18 || k == 21 || k == 13
        return 0
    if k == 15
        return inl_hascall(e[2])
    if k == 14
        if inl_hascall(e[2]) == 1
            return 1
        return inl_hascall(e[3])
    if k == 16
        if inl_hascall(e[1]) == 1
            return 1
        return inl_hascall(e[2])
    return 1

// How many times `name` is read in `e`. A shape this doesn't know answers 2,
// "more than once", the stricter case. inl_hascall has already turned down
// every shape this doesn't know, so that doesn't come up.
inl_count(e, name)
    k = e[0]
    if k == 11 || k == 12 || k == 18 || k == 21
        return 0
    if k == 13
        if e[1] == name
            return 1
        return 0
    if k == 15
        return inl_count(e[2], name)
    if k == 14
        return inl_count(e[2], name) + inl_count(e[3], name)
    if k == 16
        return inl_count(e[1], name) + inl_count(e[2], name)
    if k == 17 || k == 19
        subs = e[2]
        n = 0
        i = 0
        loop i < lcount(subs)
            n = n + inl_count(lget(subs, i), name)
            i = i + 1
        return n
    return 2

// A copy of `e` with every parameter read replaced by the argument the caller
// wrote. The clone keeps the callee's line and column on the nodes it copies.
inl_subst(e, params, args)
    k = e[0]
    if k == 13
        i = 0
        loop i < lcount(params)
            if lget(params, i) == e[1]
                a = lget(args, i)
                // A leaf argument can land at several places (inl_dupsafe), and
                // each place gets its own node, so a later pass that writes
                // into a node never sees one node at two positions. A leaf has
                // no children, so a shallow copy is all it needs.
                if inl_dupsafe(a)
                    return copy(a)
                return a
            i = i + 1
        return e
    if k == 15
        n = copy(e)
        n[2] = inl_subst(e[2], params, args)
        return n
    if k == 14
        n = copy(e)
        n[2] = inl_subst(e[2], params, args)
        n[3] = inl_subst(e[3], params, args)
        return n
    if k == 16
        n = copy(e)
        n[1] = inl_subst(e[1], params, args)
        n[2] = inl_subst(e[2], params, args)
        return n
    if k == 17 || k == 19
        n = copy(e)
        subs = e[2]
        ns = mklist(lcount(subs))
        i = 0
        loop i < lcount(subs)
            ladd(ns, inl_subst(lget(subs, i), params, args))
            i = i + 1
        n[2] = ns
        return n
    return e

infer_inlines(cg, items)
    tbl = {}
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 2
            body = it[3]
            if lcount(body) == 1
                st = lget(body, 0)
                if st[0] == 8
                    if st[1] != 0
                        if !in_before_or_after(cg, it[1]) && inl_hascall(st[1]) == 0
                            ps = it[2]
                            ok = 1
                            uses = text(lcount(ps))
                            j = 0
                            loop j < lcount(ps)
                                // A parameter read more than once is recorded
                                // here and judged at each call site, which only
                                // substitutes when the argument reads the same
                                // at every place (inl_dupsafe) and the body
                                // indexes nothing. Then each read is one leaf
                                // for one leaf, and the expression is no bigger
                                // than the body. The count is exact, because
                                // inl_hascall has turned down every shape
                                // inl_count doesn't know.
                                u = inl_count(st[1], lget(ps, j))
                                uses[j] = u
                                j = j + 1
                            if ok == 1
                                ent = text(3)
                                ent[0] = ps
                                ent[1] = st[1]
                                // ent[2]: how many times each parameter is
                                // read, so the call site can tell a dropped or
                                // repeated argument from one used once.
                                ent[2] = uses
                                tbl[it[1]] = ent
        i = i + 1
    cg[50] = tbl
    return 0

// This rewrites the tree, before the parameter-kind pass, the subkind lattice
// and the loop analyses run. They all read the tree, and a call is opaque to
// them where `lst[i + 1]` isn't. Substituting at the call site during codegen
// was simpler, but those passes never saw the result, and it got a quarter of
// the gain: 0.95% of a self-build against the 3.85% of inlining the same calls
// by hand.
//
// A substituted body has no call in it, so nothing it produces can be
// substituted again and the walk ends on its own. The depth cap is only there
// in case a later change lets a substituted body keep a call.
inl_expr(cg, e, d)
    if d > 8
        return e
    k = e[0]
    if k == 15
        e[2] = inl_expr(cg, e[2], d)
        return e
    if k == 14
        e[2] = inl_expr(cg, e[2], d)
        e[3] = inl_expr(cg, e[3], d)
        return e
    if k == 16
        e[1] = inl_expr(cg, e[1], d)
        e[2] = inl_expr(cg, e[2], d)
        return e
    if k == 17 || k == 19
        subs = e[2]
        i = 0
        loop i < lcount(subs)
            subs[i + 1] = inl_expr(cg, lget(subs, i), d)
            i = i + 1
        if k == 17
            r = inl_body(cg, e)
            if r != 0
                return inl_expr(cg, r, d + 1)
    return e

inl_stmts(cg, stmts)
    i = 0
    loop i < lcount(stmts)
        st = lget(stmts, i)
        k = st[0]
        if k == 4
            st[2] = inl_expr(cg, st[2], 0)
        else if k == 5
            st[1] = inl_expr(cg, st[1], 0)
            st[2] = inl_expr(cg, st[2], 0)
        else if k == 6
            if st[1] != 0
                st[1] = inl_expr(cg, st[1], 0)
            inl_stmts(cg, st[2])
            if st[3] != 0
                inl_stmts(cg, st[3])
        else if k == 7
            if st[1] != 0
                st[1] = inl_expr(cg, st[1], 0)
            inl_stmts(cg, st[2])
        else if k == 20
            st[2] = inl_expr(cg, st[2], 0)
            inl_stmts(cg, st[3])
        else if k == 8
            if st[1] != 0
                st[1] = inl_expr(cg, st[1], 0)
        else if k == 10
            st[1] = inl_expr(cg, st[1], 0)
        i = i + 1
    return 0

// `tops` is the program's top-level statements, the same nodes `items` holds.
// They're walked too, because most small programs have their hot loop at the
// top level.
inline_program(cg, items, tops)
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 2
            inl_stmts(cg, it[3])
        else if it[0] == 3
            inl_stmts(cg, it[2])
        i = i + 1
    inl_stmts(cg, tops)
    return 0

// The expression a call to `name` becomes, or 0 if it stays a call.
inl_body(cg, e)
    tbl = cg[50]
    if tbl == 0
        return 0
    name = e[1]
    if !has(tbl, name)
        return 0
    ent = tbl[name]
    ps = ent[0]
    uses = ent[2]
    args = e[2]
    if lcount(args) != lcount(ps)
        return 0
    i = 0
    loop i < lcount(args)
        a = lget(args, i)
        if inl_simple(a) == 0
            return 0
        // An argument the body never reads isn't evaluated at all once the
        // call is gone, so it can only be dropped if evaluating it couldn't
        // have done anything. A bare name and a literal qualify. An index can
        // fault, and arithmetic can overflow.
        if uses[i] == 0
            if !inl_droppable(a)
                return 0
        // An argument the body reads more than once is evaluated that many
        // times once the call is gone, so it has to be one whose evaluation
        // does nothing and gives the same value every time. And the body
        // mustn't index anything: an index is a bounds- and kind-checked load,
        // a dozen instructions and a fault path at every place it lands.
        // Substituting `der_end(v)`, which is `return v[1] + v[2]` and has 67
        // call sites in the net library, made an HTTPS client 20 KB bigger.
        if uses[i] > 1
            if !inl_dupsafe(a) || inl_has_index(ent[1])
                return 0
        i = i + 1
    return inl_subst(ent[1], ps, args)

// Does a substitutable body index anything? Its shapes are the ones
// inl_hascall lets through, and anything else answers yes.
inl_has_index(e)
    k = e[0]
    if k == 11 || k == 12 || k == 18 || k == 21 || k == 13
        return false
    if k == 15
        return inl_has_index(e[2])
    if k == 14
        return inl_has_index(e[2]) || inl_has_index(e[3])
    return true

// An argument that can be substituted at more than one place. A name reads the
// same binding every time, since the body has no call and assigns nothing. An
// integer, text or singleton literal is its own value (a text literal is an
// address in the literal pool, not an allocation). A float literal is left
// out: in the tagged path each copy would be boxed, an allocation per place.
inl_dupsafe(e)
    k = e[0]
    if k == 11 || k == 12 || k == 13 || k == 21
        return true
    return false

// Unique when cg[15] is a computed shared set that doesn't contain the name.
is_local_unique(cg, name)
    sh = cg[15]
    if sh == 0
        return false
    if has(sh, name)
        return false
    return true

// Does expression `e` mention the identifier `name` anywhere? A node shape it
// doesn't know answers true, so a caller that needs "definitely not" gets the
// safe answer for anything new.
expr_mentions(e, name)
    k = e[0]
    if k == 11 || k == 12 || k == 18 || k == 21
        return false
    if k == 13
        return e[1] == name
    if k == 15
        return expr_mentions(e[2], name)
    if k == 14
        if expr_mentions(e[2], name)
            return true
        return expr_mentions(e[3], name)
    if k == 16
        if expr_mentions(e[1], name)
            return true
        return expr_mentions(e[2], name)
    if k == 17 || k == 19
        subs = e[2]
        i = 0
        loop i < lcount(subs)
            if expr_mentions(lget(subs, i), name)
                return true
            i = i + 1
        return false
    return true

// `s = s . x` where the target and the join's left operand are the same unique
// local: the old buffer is dead, so it can be grown in place with rt_append.
//
// A join chain associates left, so `s = s . a . b` is `s = (s . a) . b` and the
// outer left operand is a temporary, not `s`. Walking down the left side finds
// `s` at the leftmost leaf, and the chain becomes one append per operand.
// Without that, every pass copied the whole string, which is O(n^2) in time,
// and in memory too since the arena never frees: 16k iterations of
// `s = s . "a" . "b"` reached 3.8 GB.
//
// The operands mustn't mention the target: `s = s . x . s` would append an `s`
// the first append had already grown, a different answer from the chain's.
// Those take the allocate-and-copy path.
is_inplace_append(cg, tgt, rhs)
    if rhs[0] != 14
        return false
    if rhs[1] != "."
        return false
    if !is_local_unique(cg, tgt[1])
        return false
    left = rhs
    loop left[0] == 14 && left[1] == "."
        if expr_mentions(left[3], tgt[1])
            return false
        left = left[2]
    if left[0] != 13
        return false
    return left[1] == tgt[1]

// `x = x <op> ...` where x is a unique local: the box x holds is dead as soon
// as the new value is stored, so the arithmetic can write into it instead of
// making another. This is the float version of the in-place append above, and
// it's what keeps an accumulator loop (`total = total + rate`) from
// allocating a box on every pass.
//
// Only a later assignment qualifies. The first `=` to a name is a declaration
// (the analyzer turns it into kind 4), and its slot doesn't hold a value this
// function owns yet: a leftover word that happened to carry the float tag
// would send the store somewhere arbitrary. Operand order is safe, because the
// helper converts both operands to doubles before it writes, so `x = x + x`
// and `x = x + (x * 2.0)` still read the old value.
is_float_acc(cg, tgt, rhs)
    if rhs[0] != 14
        return false
    if !is_arith_op(rhs[1])
        return false
    left = rhs[2]
    if left[0] != 13
        return false
    if left[1] != tgt[1]
        return false
    return is_local_unique(cg, tgt[1])

// Does `e` always make a region nothing else has ever seen? is_owned_temp
// already answers that for the argument-position pop, so this is that list
// plus the three allocators, array, bytes and text. A user function of the
// same name is left out there and here.
is_fresh_alloc(cg, e)
    if is_owned_temp(cg, e) == 1
        return true
    if e[0] != 17
        return false
    nm = e[1]
    if fn_is_known(cg, nm) == 1
        return false
    if nm == "array"
        return true
    if nm == "bytes"
        return true
    if nm == "text"
        return true
    return false

// `t = copy(s, i, i + n)` inside a loop: the region the previous pass left in
// the slot can't be reached once the new one is stored, but a bump allocator
// can't know that unless it's told, so the run kept every slice it had
// finished with. 800k short-lived 64-element slices peaked at 419 MB and spent
// 97% of their time in the kernel faulting in pages.
//
// The proof is the one the in-place append uses: the name is unique (never
// copied to another variable, read out of a region, stored into one, or passed
// to a user function that can keep it), so this slot is the only thing that
// can reach the old region. Two more conditions:
//
//   - the right-hand side mustn't mention the name. `t = copy(t, 1, 5)` would
//     read a region the rewind had already handed back, and rt_copy would copy
//     from a buffer it's overwriting.
//   - the right-hand side must always allocate, so there's something to take
//     back and the two instructions aren't wasted.
//
// rt_popregion does the rest at run time: it only rewinds if the old region is
// still the most recent allocation, and does nothing for a number, a literal,
// or the zero the prologue leaves in the slot.
is_reclaim_store(cg, name, rhs)
    if !is_local_unique(cg, name)
        return false
    if is_float_local(cg, name)
        return false
    if expr_mentions(rhs, name)
        return false
    return is_fresh_alloc(cg, rhs)

// The names is_reclaim_store says yes to anywhere in this body. mkframe zeroes
// these slots and gen_stmt pops these names, both from this one set, so a
// slot is never popped before it's been written. Otherwise a stale word left
// by a deeper call could be mistaken for a region this frame owns. The set is
// a pair (reclaim_new): the names in the order they're first seen, which is the
// order the prologue zeroes them in, and a map from each name, for asking.
collect_reclaim(cg, stmts, acc)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 4
            if is_reclaim_store(cg, s[1], s[2])
                reclaim_add(acc, s[1])
        else if k == 5
            tgt = s[1]
            if tgt[0] == 13
                if is_reclaim_store(cg, tgt[1], s[2])
                    reclaim_add(acc, tgt[1])
        else if k == 6
            acc = collect_reclaim(cg, s[2], acc)
            if s[3] != 0
                acc = collect_reclaim(cg, s[3], acc)
        else if k == 7
            acc = collect_reclaim(cg, s[2], acc)
        else if k == 20
            acc = collect_reclaim(cg, s[3], acc)
        i = i + 1
    return acc

reclaim_new()
    r = text(2)
    r[0] = mklist(4)
    r[1] = {}
    return r

reclaim_add(r, name)
    m = r[1]
    if !has(m, name)
        m[name] = 1
        r[0] = ladd_grow(r[0], name)
    return 0

// Two instructions before the store, for a name mkframe agreed to zero.
emit_reclaim(cg, name, rhs)
    rs = cg[34]
    if rs == 0
        return 0
    if !has(rs[1], name)
        return 0
    if !is_reclaim_store(cg, name, rhs)
        return 0
    asmput("    mov rdi, " . env_lookup(cg, name))
    asmput("    call rt_popregion")
    return 0

// `s = s . "lit"` where the subkind pass has proved `s` word-backed: the whole
// append becomes a length load, a capacity compare, one store per character
// and a length update. A two-character literal, the common case when building
// a string, takes 9 instructions here and about 67 through rt_append.
//
// The call spends those on five pushes and five pops, checking that the
// target is a plain region (not a JSON array or a map key), checking the
// operand the same way, comparing the two subkinds, checking the target isn't
// a literal, and a call to rt_wmove for the copy. The subkind and the
// uniqueness pass answer all of that in advance, and the operand is a literal,
// so its characters are already known and there's no second region to read.
//
// Only the spare-capacity case is inline. Growing is rare, goes out of line,
// and stays rt_append's job, so the doubling and the arena-tail bump live in
// one place.
append_lit_fast(cg, tgt, op)
    if op[0] != 12
        return false
    sub = local_sub(cg, tgt[1])
    // 2 is word-backed and newly allocated. 3 is word-backed but maybe still
    // the literal it started as, which is what `s = ""` gives, and that's the
    // usual way to start a string, so leaving 3 out would make this rare.
    //
    // Taking 3 needs no extra check, because a literal has no spare capacity:
    // lit_line emits `.quad 0, n, n`, so capacity equals length and the test
    // below sends it out of line. test_lang.sh checks that header, because
    // without it this would write into the literal pool.
    if sub != 2 && sub != 3
        return false
    lit = op[1]
    n = len(lit)
    // A limit on unrolling only. Past 8 characters the stores cost more code
    // than the call they replace.
    if n < 1 || n > 8
        return false
    slot = env_lookup(cg, tgt[1])
    slow = new_label(cg)
    done = new_label(cg)
    asmput("    mov rcx, " . slot)
    asmput("    mov rax, [rcx]")
    asmput("    lea r10, [rax + " . n . "]")
    asmput("    cmp r10, [rcx - 8]")
    asmput("    jg " . slow)
    i = 0
    loop i < n
        asmput("    mov qword ptr [rcx + rax*8 + " . (8 + i * 8) . "], " . (lit[i] * 2 + 1))
        i = i + 1
    asmput("    mov [rcx], r10")
    asmput("    jmp " . done)
    asmput(slow . ":")
    gen_expr(cg, op)
    asmput("    mov rsi, rax")
    asmput("    mov rdi, " . slot)
    asmput("    call rt_append")
    asmput("    mov " . slot . ", rax")
    asmput(done . ":")
    return true

// One append per chain operand, left to right. Walking the chain from the
// outside in collects the operands right to left, so they're replayed in
// reverse, which is the order the join would have put them in.
gen_append_inplace(cg, tgt, rhs)
    ops = mklist(4)
    cur = rhs
    loop cur[0] == 14 && cur[1] == "."
        ops = ladd_grow(ops, cur[3])
        cur = cur[2]
    i = lcount(ops) - 1
    loop i >= 0
        op = lget(ops, i)
        if !append_lit_fast(cg, tgt, op)
            gen_expr(cg, op)
            asmput("    mov rsi, rax")
            asmput("    mov rdi, " . env_lookup(cg, tgt[1]))
            asmput("    call rt_append")
            asmput("    mov " . env_lookup(cg, tgt[1]) . ", rax")
        i = i - 1

// Two questions about one statement, answered in one walk: can anything in it
// fault at all, and can anything fault after a call has returned?
//
// The first decides whether the statement stores its line in `cur_line`
// (SPEC 10.2). A statement that can't fault can't produce a located message,
// so the store would be wasted. The second decides whether the line has to be
// stored again after a call. Every function stores its own lines, so after a
// return `cur_line` holds the callee's last line, and a fault later in the
// same statement would report a line inside a function that had already
// returned: `return a + big() + a`, overflowing on the second `+`, blamed the
// `return` inside `big`. Putting the line back after every call costs 3.3% of
// a compiler build, so it's only done where something after the call can
// fault.
//
// Only a leaf can't fault: an integer literal, a text literal (an address in
// the literal pool, not an allocation) and a plain local read. A float local
// isn't a leaf, because reading one boxes it and an allocation can run out of
// memory. Everything else can fault: an index is bounds-checked, arithmetic
// overflows, a join and a float literal allocate, and a call can exhaust the
// stack in the callee's prologue, before the callee has stored a line.
fault_leaf(cg, e, acc)
    k = e[0]
    if k == 11 || k == 12
        return 1
    // A float literal and a float local allocate in the ordinary value path
    // (both end in rt_box_float), but not inside an operation the compiler
    // evaluates in xmm registers, where the literal is a pool read and the
    // local is its own slot. acc[3] counts how deep in that context we are.
    if k == 18
        return acc[3]
    if k == 13
        if is_float_local(cg, e[1])
            return acc[3]
        return 1
    return 0

// acc[0]: a call has been evaluated. acc[1]: something after it can fault.
// acc[2]: anything at all in this statement can fault. acc[3]: how many
// operations evaluated in xmm registers enclose this one (fault_leaf).
// acc[4], acc[5] and acc[6] are for a loop's test on its later passes
// (loop_pass_line), and acc[6] is 0 for every other statement.
// acc[4]: a call to one of the program's functions has been evaluated.
// acc[5]: something other than such a call can fault before one, on a pass
// after the first. acc[6]: the body of that loop.
fault_scan(cg, e, acc)
    if e == 0
        return 0
    if fault_leaf(cg, e, acc) == 1
        return 0
    k = e[0]
    if k == 14
        // A comparison of operands the compiler has already classified can't
        // fault: two proved integers are a `cmp` and two proved floats are a
        // `ucomisd`, with no fault path and no boxing. That matters because
        // `if f(x) > k` in a loop would otherwise pay a line store on every
        // pass for a fault that can't happen (2% of vecmath), and so would the
        // `if n < 2` that fib opens with.
        if is_cmp_op(e[1])
            if cg_kind(cg, e[2]) == 0 && cg_kind(cg, e[3]) == 0
                fault_scan(cg, e[2], acc)
                fault_scan(cg, e[3], acc)
                return 0
            if cg[14] == 1 && is_float_cmp(cg, e)
                acc[3] = acc[3] + 1
                fault_scan(cg, e[2], acc)
                fault_scan(cg, e[3], acc)
                acc[3] = acc[3] - 1
                return 0
        // `&&` and `||` can't fault themselves, but they check that each side
        // is a condition, in the order the sides run. A side that's a
        // comparison, `!`, `&&`, `||`, `true` or `false` always is one, and
        // cond_fault knows that. So `if i > 5 && c >= 0` on proved integers
        // stores no line, just like `if i > 5`.
        if e[1] == "&&" || e[1] == "||"
            fault_scan(cg, e[2], acc)
            cond_fault(cg, e[2], acc)
            fault_scan(cg, e[3], acc)
            cond_fault(cg, e[3], acc)
            return 0
        fault_scan(cg, e[2], acc)
        fault_scan(cg, e[3], acc)
    else if k == 15
        fault_scan(cg, e[2], acc)
    else if k == 16
        fault_scan(cg, e[1], acc)
        fault_scan(cg, e[2], acc)
    else if k == 19
        ks = e[1]
        vs = e[2]
        i = 0
        loop i < lcount(ks)
            fault_scan(cg, lget(ks, i), acc)
            fault_scan(cg, lget(vs, i), acc)
            i = i + 1
    else if k == 17
        // A float argument is boxed like any other value, whatever context the
        // call sits in, so the xmm exemption stops at the parenthesis. One a
        // callee takes raw isn't boxed, and counting it anyway only costs a
        // line store.
        as = e[2]
        fc = acc[3]
        acc[3] = 0
        i = 0
        loop i < lcount(as)
            fault_scan(cg, lget(as, i), acc)
            i = i + 1
        acc[3] = fc
    acc[2] = 1
    if acc[0] == 1
        acc[1] = 1
    if k == 17
        acc[0] = 1
        if fn_is_known(cg, e[1]) == 1
            acc[4] = 1
            return 0
    if acc[4] == 0 && acc[6] != 0
        if pass_fault(cg, e, acc[6])
            acc[5] = 1
    return 0

// The truth test after a condition (gen_truth_jump, a64_truth_jump) is a fault
// site of its own: a value that isn't true or false faults there, after
// everything in the condition has run. `if x` on a local holding null has
// nothing else in it that can fault, so without this the statement stored no
// line and the fault reported whichever line was stored last. A comparison,
// `&&`, `||`, `!`, `true` and `false` always give a boolean, so the test after
// them can't fault.
cond_fault(cg, e, acc)
    if e == 0 || is_static_bool(e)
        return 0
    acc[2] = 1
    if acc[0] == 1
        acc[1] = 1
    if acc[4] == 0 && acc[6] != 0
        if !pass_same(cg, e, acc[6], true)
            acc[5] = 1
    return 0

// Can this fault site, which didn't fault on a loop's first pass, fault on a
// later one? Only if something it reads can be different by then (pass_same),
// or if it can allocate, since memory can run out on any pass. A comparison,
// `!`, `&&` and `||` fault on the kinds they're given. An index and integer
// arithmetic fault on values: a bound, an overflow.
pass_fault(cg, e, bdy)
    k = e[0]
    if k == 21
        return false
    if k == 16
        return !pass_same(cg, e[1], bdy, false) || !pass_same(cg, e[2], bdy, false)
    if k == 15
        if e[1] == "!"
            return !pass_same(cg, e[2], bdy, true)
        if cg_kind(cg, e) == 0
            return !pass_same(cg, e[2], bdy, false)
        return true
    if k == 14
        op = e[1]
        if is_cmp_op(op) || op == "&&" || op == "||"
            return !pass_same(cg, e[2], bdy, true) || !pass_same(cg, e[3], bdy, true)
        if is_numeric_op(op) && cg_kind(cg, e) == 0
            return !pass_same(cg, e[2], bdy, false) || !pass_same(cg, e[3], bdy, false)
    // len() faults on the kind it's given. arm64 has no hoisted len, so this is
    // what keeps its `loop i < len(xs)` free of a store per pass.
    if k == 17 && e[1] == "len" && fn_is_known(cg, "len") == 0 && lcount(e[2]) == 1
        return !pass_same(cg, lget(e[2], 0), bdy, true)
    return true

// Is `e` the same on every pass of a loop whose body is `bdy`? Its value, or
// with kindonly set just its kind. A local the body never assigns is the same,
// and so is a local the analysis proved is always a number or always a region,
// as far as its kind goes. Every operator answers one kind whatever it's given.
// An index or a len() of things that are the same is taken to read what it
// read on the first pass. That's the case this misses: a body that stores a
// different kind into an element its own test reads faults on the body's line.
pass_same(cg, e, bdy, kindonly)
    k = e[0]
    if k == 11 || k == 12 || k == 18 || k == 21
        return true
    if k == 13
        if !stmts_assign(bdy, e[1])
            return true
        if kindonly
            lk = cg_kind(cg, e)
            return lk == 0 || lk == 1 || lk == 3
        return false
    if k == 16
        return pass_same(cg, e[1], bdy, false) && pass_same(cg, e[2], bdy, false)
    if k == 14
        if kindonly
            return true
        return pass_same(cg, e[2], bdy, false) && pass_same(cg, e[3], bdy, false)
    if k == 15
        if kindonly
            return true
        return pass_same(cg, e[2], bdy, false)
    if k == 17 && e[1] == "len" && fn_is_known(cg, "len") == 0 && lcount(e[2]) == 1
        if kindonly
            return true
        return pass_same(cg, lget(e[2], 0), bdy, false)
    return false

// The same walk over a statement. Only the expressions this statement itself
// evaluates: an `if` or a `loop` body is made of statements that carry their
// own line. A shape not listed keeps both stores, the safe answer.
stmt_fault_scan(cg, s, acc)
    k = s[0]
    if k == 4
        fault_scan(cg, s[2], acc)
    else if k == 5
        t = s[1]
        if t[0] == 16
            fault_scan(cg, t[1], acc)
            fault_scan(cg, t[2], acc)
            fault_scan(cg, s[2], acc)
            acc[2] = 1
            if acc[0] == 1
                acc[1] = 1
        else
            fault_scan(cg, s[2], acc)
    else if k == 6
        fault_scan(cg, s[1], acc)
        cond_fault(cg, s[1], acc)
    else if k == 7
        fault_scan(cg, s[1], acc)
        cond_fault(cg, s[1], acc)
    else if k == 8
        fault_scan(cg, s[1], acc)
        // In a hook the answer is tested after it's computed, and the test can
        // fail the contract or find something that isn't a boolean (SPEC 3.2),
        // whatever the expression was. Either one is reported on this line,
        // the guard that said no. Without this, `return a` reported the
        // caller's line.
        if cg[5] == 1
            acc[2] = 1
            if acc[0] == 1
                acc[1] = 1
    else if k == 10
        fault_scan(cg, s[1], acc)
    else if k == 20
        fault_scan(cg, s[2], acc)
        acc[2] = 1
        if acc[0] == 1
            acc[1] = 1
    else
        acc[1] = 1
        acc[2] = 1
    return 0

// A call left the callee's line in cur_line. Put the caller's back, but only
// where this statement can still fault. cg[55] is 0 everywhere else, which is
// most call sites: a statement whose call is the last thing it does has
// nothing left to misreport.
emit_line_restore(cg)
    if cg[55] > 0
        asmput("    mov qword ptr [rip+cur_line], " . cg[55])
    return 0

a64_line_restore(cg)
    if cg[55] > 0
        a64_movi("x9", cg[55])
        a64_stg("x9", "cur_line")
    return 0

// Sets cg[55] to the line a call in this statement has to put back, or 0.
// Answers whether this statement needs its line stored at all.
//
// Never, in the bundled net library: cg[56] is its first line, or 0 when the
// program carries none. The library isn't a file the program has, so its line
// numbers point past the end of the caller's file (`p.w:5841` in a five-line
// p.w) and no editor can jump there. With none of its statements storing a
// line, a fault inside it reports the program's own statement that called the
// verb, which is still in cur_line (SPEC 10.2).
stmt_line_plan(cg, s, ln)
    cg[55] = 0
    if cg[56] > 0 && ln >= cg[56]
        return 0
    acc = text(7)
    acc[0] = 0
    acc[1] = 0
    acc[2] = 0
    acc[3] = 0
    acc[4] = 0
    acc[5] = 0
    acc[6] = 0
    stmt_fault_scan(cg, s, acc)
    if acc[1] == 1
        cg[55] = ln
    return acc[2]

// The line a loop stores at the top of every pass, or 0. The statement's own
// store runs once, before the first pass, and from the second pass on cur_line
// holds the last line the body stored. So a test that can fault on a later pass
// has to put the loop's line back each time round, or `loop x` with x set to
// null in the body reports the body's last line.
//
// Most tests can't. Whatever didn't fault on the first pass can only fault on
// a later one if the body changed what it reads (pass_fault), and a counted
// loop's test reads a number it compares with a local the body leaves alone:
// `loop i < n`, or `loop i < lcount(xs)` once lcount is inlined to xs[0]. A
// call to one of the program's functions doesn't count either. Every pass
// reaches its prologue at the same stack depth, and anything after it that can
// fault is covered by the line put back after the call. A hoisted `len` runs
// once, before the loop, and what is left compares against its answer.
loop_pass_line(cg, s, hn)
    ln = node_ln(s)
    c = s[1]
    if ln <= 0 || c == 0
        return 0
    if cg[56] > 0 && ln >= cg[56]
        return 0
    acc = text(7)
    acc[6] = s[2]
    if len(hn) > 0
        fault_scan(cg, c[2], acc)
        if cg_kind(cg, c[2]) != 0 && !pass_same(cg, c[2], s[2], true)
            acc[5] = 1
    else
        fault_scan(cg, c, acc)
        cond_fault(cg, c, acc)
    if acc[5] == 1
        return ln
    return 0

// `i = i + 1` on a pinned integer local: one `add` on its register and the
// overflow check, instead of a copy into rax, the add, the check and a copy
// back. That's the step of nearly every counted loop. The register only holds
// the wrapped sum on the way to rt_overflow, which ends the program, so
// nothing can read it. Proved integers and an imm32 literal only, as in
// gen_binary's own immediate form. Answers 1 if it emitted the step.
gen_pinned_step(cg, name, rhs)
    if rhs[0] != 14
        return 0
    op = rhs[1]
    if op != "+" && op != "-"
        return 0
    l = rhs[2]
    if l[0] != 13
        return 0
    if l[1] != name
        return 0
    h = env_lookup(cg, name)
    if !is_gpr_home(h)
        return 0
    if cg_kind(cg, l) != 0 || cg_kind(cg, rhs[3]) != 0
        return 0
    k = int_imm(rhs[3], 0)
    if len(k) == 0
        return 0
    if op == "+"
        asmput("    add " . h . ", " . k)
    else
        asmput("    sub " . h . ", " . k)
    asmput("    jo rt_overflow")
    return 1

gen_stmt(cg, s)
    ln = node_ln(s)
    st = 0
    if ln > 0
        st = stmt_line_plan(cg, s, ln)
        // A loop stores its line itself (gen_loop), at the top of each pass
        // when its test needs it there.
        if st == 1 && s[0] != 7
            asmput("    mov qword ptr [rip+cur_line], " . ln)
    else
        cg[55] = 0
    k = s[0]
    if k == 4
        if is_float_local(cg, s[1])
            gen_float_store(cg, s[1], s[2])
        else if is_u32_local(cg, s[1]) == 1
            // A u32 local is stored raw: gen_u32 leaves the 32-bit value in eax
            // and cg_u32 already proved the right-hand side is < 2^32.
            gen_u32(cg, s[2])
            asmput("    mov " . env_lookup(cg, s[1]) . ", rax")
        else
            emit_reclaim(cg, s[1], s[2])
            gen_expr(cg, s[2])
            asmput("    mov " . env_lookup(cg, s[1]) . ", rax")
    else if k == 5
        tgt = s[1]
        if tgt[0] == 13
            if is_float_local(cg, tgt[1])
                gen_float_store(cg, tgt[1], s[2])
            else if is_u32_local(cg, tgt[1]) == 1
                gen_u32(cg, s[2])
                asmput("    mov " . env_lookup(cg, tgt[1]) . ", rax")
            else if gen_pinned_step(cg, tgt[1], s[2]) == 1
                cg[21] = 0
            else if is_inplace_append(cg, tgt, s[2])
                gen_append_inplace(cg, tgt, s[2])
            else
                if cg[14] == 1 && is_float_acc(cg, tgt, s[2])
                    cg[21] = 1
                emit_reclaim(cg, tgt[1], s[2])
                gen_expr(cg, s[2])
                cg[21] = 0
                asmput("    mov " . env_lookup(cg, tgt[1]) . ", rax")
        else
            gen_index_store(cg, tgt, s[2])
    else if k == 6
        gen_if(cg, s)
    else if k == 7
        gen_loop(cg, s, st)
    else if k == 8
        if cg[5] == 1
            // A hook answers a condition (SPEC 3.2): `true` passes, `false` is
            // the violation, and anything else isn't an answer and faults the
            // way `if` would. This used to compare the word with 1 (the
            // integer 0), from before #204 made a condition a boolean, so
            // `return false` passed, and so did null and none.
            gen_expr(cg, s[1])
            hfail = new_label(cg)
            gen_truth_jump(cg, s[1], hfail)
            asmput("    jmp " . cg[8])
            asmput(hfail . ":")
            asmput("    lea rdi, [rip+cn_" . cg[13] . "]")
            asmput("    mov rsi, " . len(cg[13]))
            asmput("    jmp rt_contract")
        else
            if s[1] != 0
                // cg[28]: this function was proved to return a float on every
                // path, so its result travels raw in xmm0 and no box is made
                // for it. Caller and callee read the same row of the same
                // table, computed before any code is emitted, so they can't
                // disagree. A raw float parameter is safe for the same reason.
                if cg[28] == 1
                    gen_float_expr(cg, s[1])
                else
                    gen_expr(cg, s[1])
            else
                // A bare `return` answers the integer 0, which is the word 1.
                // A raw 0 has a region's tag bits, so it would be a null
                // region, and out() of one segfaulted. The fall-off-the-end
                // epilogue in mkframe does the same.
                asmput("    mov rax, 1")
            emit_unpin(cg)
            asmput("    mov rsp, rbp")
            asmput("    pop rbp")
            asmput("    ret")
    else if k == 9
        asmput("    jmp " . cg[7])
    else if k == 10
        gen_expr(cg, s[1])
    else if k == 20
        gen_foreach(cg, s)

// ---- a leading guard that needs no frame ----
//
// `if n < 2 / return n` at the top of a recursive function is taken on about
// half its calls (every leaf of fib's call tree), and it needs nothing a frame
// provides: it reads a parameter the caller pushed, compares it with a
// constant and hands it back. It used to run after the whole prologue (push
// rbp, the stack guard) and leave through the epilogue. Now a guard of that
// shape is emitted before the prologue, where the parameters are still at
// [rsp + 8 + 8i] (the return address is at [rsp]), and answers with a bare
// ret.
//
// The shape is kept narrow, so that what runs is what the framed code would
// have run, minus the frame:
//   - `if A op B` with no else, op a comparison, and a body of one `return E`;
//   - A is a parameter proved an integer, and B is one too or an integer
//     literal that fits an imm32. gen_cond_jump turns those into one cmp with
//     no kind check and no fault path;
//   - E is a parameter (not a raw float, which would need a box), an integer or
//     singleton literal, or an integer parameter plus or minus an imm32
//     literal. That last is the `add/sub; jo` gen_binary emits, after the line
//     store gen_stmt would have made, so an overflow still reports the return;
//   - not a raw-double function (its answer travels in xmm0) and not a hook.
// Nothing here pushes, calls or touches a local, so there's nothing for the
// frame, the pins, the rewind's zeroing or the stack guard to do. A path that
// grows no stack can't exhaust it, and every path that does still meets the
// guard in the prologue. Several such guards in a row all go before the
// prologue.
fg_slot(params, name)
    i = 0
    loop i < lcount(params)
        if lget(params, i) == name
            return "[rsp + " . 8 + 8 * i . "]"
        i = i + 1
    return ""

// A parameter whose slot holds the word the caller pushed, unchanged.
fg_word_param(cg, params, e)
    if e[0] != 13
        return ""
    if is_float_local(cg, e[1])
        return ""
    if is_u32_local(cg, e[1]) != 0
        return ""
    return fg_slot(params, e[1])

// ...and one proved an integer, so a compare or an add needs no kind check.
fg_int_param(cg, params, e)
    if e[0] != 13
        return ""
    if cg_kind(cg, e) != 0
        return ""
    return fg_word_param(cg, params, e)

// Emits the guard `s` frameless if it has the shape above and answers 1.
// Otherwise it emits nothing and answers 0.
fg_guard(cg, params, s)
    if s[0] != 6
        return 0
    if s[3] != 0
        return 0
    c = s[1]
    if c == 0
        return 0
    if c[0] != 14
        return 0
    if !is_cmp_op(c[1])
        return 0
    thn = s[2]
    if lcount(thn) != 1
        return 0
    r = lget(thn, 0)
    if r[0] != 8
        return 0
    e = r[1]
    if e == 0
        return 0
    la = fg_int_param(cg, params, c[2])
    if len(la) == 0
        return 0
    rb = int_imm(c[3], 1)
    if len(rb) == 0
        rb = fg_int_param(cg, params, c[3])
        if len(rb) == 0
            return 0
    // The answer, checked before anything is emitted.
    ek = e[0]
    eslot = ""
    eimm = ""
    eop = ""
    if ek == 11 || ek == 21
        eimm = "lit"
    else if ek == 13
        eslot = fg_word_param(cg, params, e)
        if len(eslot) == 0
            return 0
    else if ek == 14 && (e[1] == "+" || e[1] == "-")
        eslot = fg_int_param(cg, params, e[2])
        if len(eslot) == 0
            return 0
        if cg_kind(cg, e[3]) != 0
            return 0
        eimm = int_imm(e[3], 0)
        if len(eimm) == 0
            return 0
        eop = e[1]
    else
        return 0
    // The line stores gen_stmt would make for the `if` and for the `return`. A
    // compare of two proved integers can't fault, so the first never happens.
    // It's asked anyway, so the two paths can't disagree.
    ln = node_ln(s)
    if ln > 0
        if stmt_line_plan(cg, s, ln) == 1
            asmput("    mov qword ptr [rip+cur_line], " . ln)
    skip = new_label(cg)
    asmput("    mov rax, " . la)
    asmput("    cmp rax, " . rb)
    asmput("    " . jcc_false(c[1]) . " " . skip)
    rln = node_ln(r)
    if rln > 0
        if stmt_line_plan(cg, r, rln) == 1
            asmput("    mov qword ptr [rip+cur_line], " . rln)
    if len(eop) > 0
        if eslot != la
            asmput("    mov rax, " . eslot)
        if eop == "+"
            asmput("    add rax, " . eimm)
        else
            asmput("    sub rax, " . eimm)
        asmput("    jo rt_overflow")
    else if len(eimm) > 0
        gen_expr(cg, e)
    else if eslot != la
        asmput("    mov rax, " . eslot)
    asmput("    ret")
    asmput(skip . ":")
    return 1

// Take `frame` bytes of stack below rbp, which is rsp here. A frame under a
// page gets what every prologue always has: rsp checked against stack_limit,
// then moved. The check is on where the frame will end for a page or more,
// because a frame bigger than the reserve rt_init keeps below stack_limit
// (128 KB, or a quarter of a small stack) can start above the limit and end
// past the end of the stack. rt_stack then runs with rsp where it was.
//
// On Windows a frame of a page or more is also touched a page at a time from
// the top before it's used. Windows commits a thread's stack one guard page at
// a time as it grows (SizeOfStackCommit is 4096), so a first access more than
// a page below what's committed skips the guard page and dies as an access
// violation. The first store into a 96 KB frame did that. MSVC's __chkstk
// does the same walk. A read is enough to move the guard page, and since
// every page down to the limit belongs to the stack's reservation, nothing
// else can be there. A frame under a page needs no touch: nothing in it is
// more than a page below the `push rbp` that just wrote the page above.
//
// `guard` is false for a contract wrapper, which has never checked a small
// frame (its body function checks its own).
emit_frame(cg, frame, guard)
    if frame >= 4096
        asmput("    lea r11, [rbp - " . frame . "]")
        asmput("    cmp r11, [rip+stack_limit]")
        asmput("    jb rt_stack")
        if cg[12] == 1
            off = 4096
            loop off <= frame
                asmput("    test qword ptr [rbp - " . off . "], rax")
                off = off + 4096
        asmput("    sub rsp, " . frame)
        return 0
    if guard
        asmput("    cmp rsp, [rip+stack_limit]")
        asmput("    jb rt_stack")
    if frame > 0
        asmput("    sub rsp, " . frame)
    return 0

mkframe(cg, params, body)
    env = {}
    i = 0
    loop i < lcount(params)
        slot = "[rbp + " . 16 + 8 * i . "]"
        env = add_env(env, lget(params, i), slot)
        i = i + 1
    locals = mklist(8)
    locals = collect_locals(body, locals)
    j = 0
    loop j < lcount(locals)
        slot = "[rbp - " . 8 * (j + 1) . "]"
        env = add_env(env, lget(locals, j), slot)
        j = j + 1
    frame = 8 * lcount(locals)
    cg[2] = env
    cg[15] = compute_escapes(cg, params, body)
    cg[23] = infer_local_kinds(cg, params, body, 1)
    // Which kind-0 locals stay in [0, 2^32) and can live raw. The arm64
    // backend works these out the same way.
    cg[44] = infer_u32_locals(cg, params, body)
    // What the bounds-check elision in gen_loop reads. cg[51], which locals
    // are counting, starts empty and is filled one name at a time by
    // is_counting, since only a `loop i < len(a)` ever asks. cg[52] is the set
    // of subscripts the enclosing loop's test covers, and cg[53] and cg[54]
    // are the parameters and body is_counting walks.
    cg[51] = 0
    cg[52] = 0
    cg[53] = params
    cg[54] = body
    // The slots the dead-store rewind will read. They're worked out here,
    // before any instruction is emitted, so the prologue and gen_stmt can't
    // disagree about which ones are zeroed.
    cg[34] = collect_reclaim(cg, body, reclaim_new())
    // The hottest few integers move into callee-saved registers for the whole
    // body. env_lookup answers with the register from here on, so every read,
    // write and compare in the generator is unchanged: `mov rax, [rbp - 8]`
    // just becomes `mov rax, rbx`. Their frame slots stay allocated and unused,
    // since taking them back would renumber every other local for nothing.
    cg[39] = pick_pins(cg, params, body, locals)
    pn = lcount(cg[39])
    cg[40] = frame + 8
    frame = frame + 8 * pn
    // The hottest raw-double locals do the same in xmm8-xmm15 (pick_fpins),
    // saved below the integer pins. A function with no float local takes none
    // and its frame doesn't change, so a float-free program's code is the same
    // as it was before float pins existed.
    cg[63] = pick_fpins(cg, params, body, locals)
    fpn = lcount(cg[63])
    cg[64] = frame + 8
    frame = frame + 8 * fpn
    if frame % 16 != 0
        frame = frame + 8
    // The env is rebuilt instead of appended to: add_env appends and
    // env_lookup answers with the first match, so a register added after a
    // slot would never be seen.
    if pn > 0 || fpn > 0
        env = {}
        i = 0
        loop i < lcount(params)
            env = add_env(env, lget(params, i), pin_slot_for(cg, lget(params, i), "[rbp + " . 16 + 8 * i . "]"))
            i = i + 1
        j = 0
        loop j < lcount(locals)
            env = add_env(env, lget(locals, j), pin_slot_for(cg, lget(locals, j), "[rbp - " . 8 * (j + 1) . "]"))
            j = j + 1
    cg[2] = env
    // Leading guards that need no frame run before it exists (fg_guard). A
    // raw-double function answers in xmm0 and a hook body answers to its
    // wrapper, so neither takes this path.
    nguard = 0
    if cg[28] == 0 && cg[5] == 0
        going = 1
        loop going == 1 && nguard < lcount(body)
            if fg_guard(cg, params, lget(body, nguard)) == 1
                nguard = nguard + 1
            else
                going = 0
    asmput("    push rbp")
    asmput("    mov rbp, rsp")
    // Stack-overflow guard: jump to rt_stack if the stack is already past the
    // soft limit rt_init worked out, so running out of stack is the `stack
    // exhausted` fault (SPEC 10.2) instead of a SIGSEGV (or an access
    // violation on Windows). The branch is almost never taken, so it costs
    // next to nothing. cur_line still holds the caller's line, the call that
    // recursed. Emitted for Linux and Windows alike, so the same program
    // doesn't fault cleanly on one and crash on the other. emit_frame checks
    // and takes the frame.
    emit_frame(cg, frame, true)
    // Save the registers this function is about to take, and load the
    // parameters among them from the slots the caller pushed. This is the one
    // place those slots are still wanted, which is why they're found through
    // `params` and not env_lookup, which now answers with the register.
    ps = cg[39]
    pi = 0
    loop pi < lcount(ps)
        asmput("    mov [rbp - " . cg[40] + 8 * pi . "], " . pin_regs(pi))
        pi = pi + 1
    pi = 0
    loop pi < lcount(ps)
        nm = lget(ps, pi)
        px = 0
        loop px < lcount(params)
            if lget(params, px) == nm
                asmput("    mov " . pin_regs(pi) . ", [rbp + " . 16 + 8 * px . "]")
            px = px + 1
        pi = pi + 1
    // The float pins the same way. A float parameter's slot already holds the
    // raw double (gen_call pushed it raw), so it loads straight into its home.
    fps = cg[63]
    pi = 0
    loop pi < lcount(fps)
        asmput("    movsd [rbp - " . cg[64] + 8 * pi . "], " . fpin_regs(pi))
        pi = pi + 1
    pi = 0
    loop pi < lcount(fps)
        nm = lget(fps, pi)
        px = 0
        loop px < lcount(params)
            if lget(params, px) == nm
                asmput("    movsd " . fpin_regs(pi) . ", [rbp + " . 16 + 8 * px . "]")
            px = px + 1
        pi = pi + 1
    // `sub rsp` leaves whatever a deeper call left on the stack, and a stale
    // word there can look just like a live region this frame never owned. Only
    // the slots the rewind reads are zeroed (usually one or two, never the
    // whole frame), so the first `t = copy(...)` inside a loop finds no old
    // region instead of a pointer some caller is still using.
    rz = cg[34][0]
    ri = 0
    loop ri < lcount(rz)
        asmput("    mov qword ptr " . env_lookup(cg, lget(rz, ri)) . ", 0")
        ri = ri + 1
    // A parameter every caller passes a float to needs no unboxing here: it
    // arrives as the raw double, because gen_call pushed it raw, and behaves
    // like an unboxed float local for the whole body. The wrapper for a
    // function with a contract pushes its own slots again as they are, so the
    // raw word gets through it unchanged. A parameter the pass couldn't prove
    // is passed boxed.
    k = nguard
    loop k < lcount(body)
        gen_stmt(cg, lget(body, k))
        k = k + 1
    // Falling off the end answers the integer 0, the tagged word 1. A raw 0 is
    // all zero bits, and the low three spell "region", so it would be a null
    // region: `out(f())` on a function with no return segfaulted, and so did
    // `f() + 0`. The analyzer already takes this path to return an integer
    // (when body_always_returns says no, pk_visit joins integer into the
    // return kind), so the value emitted here has to agree.
    if cg[28] == 1
        // Unreachable in a raw-double function, which only gets that
        // representation when its body ends in a `return`. But leaving xmm0
        // holding whatever the body last computed would give a plausible
        // number instead of a fault, so it's zeroed.
        asmput("    xor rax, rax")
        asmput("    movq xmm0, rax")
    else
        asmput("    mov rax, 1")
    emit_unpin(cg)
    asmput("    mov rsp, rbp")
    asmput("    pop rbp")
    asmput("    ret")

lookup_hook(lst, name)
    i = 0
    loop i < lcount(lst)
        e = lget(lst, i)
        if e[0] == name
            return e[1]
        i = i + 1
    return 0

in_before_or_after(cg, name)
    if lookup_hook(cg[9], name) != 0
        return true
    if lookup_hook(cg[10], name) != 0
        return true
    return false

emit_wrapper(cg, name, params)
    cg[13] = name
    // A hook is a frame of its own, with its own env. The guarded body's
    // reclaim set names the body's locals, so leaving it in place would pop a
    // hook slot that only shares a name (the per-hook infer_local_kinds below
    // is there for the same reason). The wrapper doesn't zero any slot, so it
    // gets no rewind at all.
    cg[34] = 0
    // A hook frame pins nothing: the pins mkframe just installed belong to the
    // body function, which restores them itself.
    cg[39] = 0
    cg[63] = 0
    before = lookup_hook(cg[9], name)
    after = lookup_hook(cg[10], name)
    before_locals = mklist(8)
    if before != 0
        before_locals = collect_locals(before[2], before_locals)
    after_locals = mklist(8)
    if after != 0
        after_locals = collect_locals(after[2], after_locals)
    bc = lcount(before_locals)
    ac = lcount(after_locals)
    frame = 8 * (1 + bc + ac)
    if frame % 16 != 0
        frame = frame + 8
    beforeenv = {}
    afterenv = {}
    i = 0
    loop i < lcount(params)
        slot = "[rbp + " . 16 + 8 * i . "]"
        beforeenv = add_env(beforeenv, lget(params, i), slot)
        afterenv = add_env(afterenv, lget(params, i), slot)
        i = i + 1
    off = 16
    bi = 0
    loop bi < bc
        bslot = "[rbp - " . off . "]"
        beforeenv = add_env(beforeenv, lget(before_locals, bi), bslot)
        off = off + 8
        bi = bi + 1
    afterenv = add_env(afterenv, "result", "[rbp - 8]")
    ai = 0
    loop ai < ac
        aslot = "[rbp - " . off . "]"
        afterenv = add_env(afterenv, lget(after_locals, ai), aslot)
        off = off + 8
        ai = ai + 1
    asmput("fn_" . name . ":")
    asmput("    push rbp")
    asmput("    mov rbp, rsp")
    emit_frame(cg, frame, false)
    if before != 0
        cg[2] = beforeenv
        cg[15] = compute_escapes(cg, params, before[2])
        // The wrapper's own parameter slots hold whatever the caller pushed
        // (raw for a proved-float parameter), so the hook has to read them the
        // way the body does. Its locals still start with nothing known.
        cg[25] = pk_lookup(cg, cg[13])
        cg[46] = pk_lookup_sub(cg, cg[13])
        // A contract body is a frame of its own, with its own locals in its own
        // slots, so it gets its own inference. Leaving the guarded function's
        // set in place would judge a hook local by a body local that only
        // shares its name, and a raw-double store into a slot that holds
        // something else corrupts it without a fault.
        cg[23] = infer_local_kinds(cg, params, before[2], 1)
        cg[44] = infer_u32_locals(cg, params, before[2])
        cg[51] = 0
        cg[53] = params
        cg[54] = before[2]
        passl = new_label(cg)
        cg[5] = 1
        cg[8] = passl
        bb = before[2]
        j = 0
        loop j < lcount(bb)
            gen_stmt(cg, lget(bb, j))
            j = j + 1
        asmput(passl . ":")
        cg[5] = 0
    pi = lcount(params) - 1
    loop pi >= 0
        asmput("    mov rax, [rbp + " . 16 + 8 * pi . "]")
        asmput("    push rax")
        pi = pi - 1
    asmput("    call fn_" . name . ".body")
    if lcount(params) > 0
        asmput("    add rsp, " . 8 * lcount(params))
    asmput("    mov [rbp - 8], rax")
    if after != 0
        cg[2] = afterenv
        aparams = mklist(lcount(params) + 1)
        ap = 0
        loop ap < lcount(params)
            ladd(aparams, lget(params, ap))
            ap = ap + 1
        ladd(aparams, "result")
        cg[15] = compute_escapes(cg, aparams, after[2])
        cg[25] = pk_lookup(cg, cg[13])
        cg[46] = pk_lookup_sub(cg, cg[13])
        // `result` is in aparams, so the inference treats it like a parameter:
        // its slot holds the tagged value the body returned, whatever a hook
        // local of the same name would have been inferred as.
        cg[23] = infer_local_kinds(cg, aparams, after[2], 1)
        cg[44] = infer_u32_locals(cg, aparams, after[2])
        cg[51] = 0
        cg[53] = aparams
        cg[54] = after[2]
        passm = new_label(cg)
        cg[5] = 1
        cg[8] = passm
        ab = after[2]
        k = 0
        loop k < lcount(ab)
            gen_stmt(cg, lget(ab, k))
            k = k + 1
        asmput(passm . ":")
        cg[5] = 0
    asmput("    mov rax, [rbp - 8]")
    asmput("    mov rsp, rbp")
    asmput("    pop rbp")
    asmput("    ret")

// ---- pinning a function's hottest integers to registers ----
//
// A local lives in a frame slot, so `i = i + 1` in a loop is a load, an add and
// a store, and the next pass's load waits on that store. Store-to-load
// forwarding makes that fast but not free. On a bare counting loop I measured
// 67.7 ms with the values in slots and 36.4 ms with the same three in
// registers, 29% fewer instructions and 46% less time, because the round trip
// through memory is part of the dependency from one pass to the next. (An
// earlier measurement found almost no difference, 108.8 ms against 106.5, and
// didn't reproduce. These numbers do.)
//
// Generated code uses rax, rcx, rdx, rdi, rsi, r10 and r11 and never touches
// rbx or r12-r15, and the runtime preserves all five. So they're free, and
// since they're callee-saved a pinned value survives a call at no cost, which
// is what makes this worth doing in a function whose loop calls something.
// The function saves the ones it uses in its own frame and restores them at
// every exit, so the ABI doesn't change and a pinning callee can't disturb a
// pinning caller.
pin_regs(k)
    if k == 0
        return "rbx"
    if k == 1
        return "r12"
    if k == 2
        return "r13"
    if k == 3
        return "r14"
    return "r15"

// Score the candidates in one walk, into a list of counts parallel to the
// candidate list. I measured two other ways and dropped them: asking per
// candidate walks the body once per name and cost 9.4% of a compile of the
// compiler, and counting into a `{}` hashes a name at every identifier and
// still cost 4.4%. A linear scan over ten-odd names is cheaper than either.
// The walk only goes into loops, because a name used nowhere inside one can't
// reach the threshold below, so counting it couldn't change the answer.
//
// A use inside a loop is worth ten, and ten times more for each further level
// of nesting. That's the whole cost model, and it's enough, since the only
// question is which five of a handful of names to take.
//
// Ten per level is 10^depth, and 10^19 is past the integer range (SPEC 2.6),
// so nineteen nested loops made the multiply overflow and the compiler stop
// with `word.w: integer overflow`, exit 70 against its own source.
// test_fuzz_frontend.sh counts that as a bug. Nobody writes nineteen nested
// loops, but they can, and the language allows far more (SPEC 10.1: 512
// levels of block).
//
// So the weight stops growing at 10^18 (pin_w10), and the total at pin_ceil().
// The counts only rank the names, so capping them can only change which names
// a function nested that deep pins.

// The ceiling the running total saturates at: the largest integer literal,
// 2^61 - 1, well inside the value range.
pin_ceil()
    return 2305843009213693951

pin_w10(w)
    if w >= 1000000000000000000
        return w
    return w * 10

// The total saturates for the same reason the weight does. With only the
// weight capped, twenty-five nested loops still overflowed on `cnt[i] + w`.
// `cand` maps each candidate's name to its place in `cnt`.
pin_bump(cand, cnt, name, w)
    if !has(cand, name)
        return 0
    i = cand[name]
    t = cnt[i]
    if t > pin_ceil() - w
        cnt[i] = pin_ceil()
    else
        cnt[i] = t + w
    return 0

pin_scan_expr(cand, cnt, e, w)
    k = e[0]
    if k == 13
        pin_bump(cand, cnt, e[1], w)
    else if k == 14
        pin_scan_expr(cand, cnt, e[2], w)
        pin_scan_expr(cand, cnt, e[3], w)
    else if k == 15
        pin_scan_expr(cand, cnt, e[2], w)
    else if k == 16
        pin_scan_expr(cand, cnt, e[1], w)
        pin_scan_expr(cand, cnt, e[2], w)
    else if k == 17 || k == 19
        subs = e[2]
        i = 0
        loop i < lcount(subs)
            pin_scan_expr(cand, cnt, lget(subs, i), w)
            i = i + 1
    return 0

// Inside a loop: every identifier counts.
pin_scan_body(cand, cnt, stmts, w)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 4
            pin_bump(cand, cnt, s[1], w)
            pin_scan_expr(cand, cnt, s[2], w)
        else if k == 5
            t = s[1]
            if t[0] == 13
                pin_bump(cand, cnt, t[1], w)
            else
                pin_scan_expr(cand, cnt, t, w)
            pin_scan_expr(cand, cnt, s[2], w)
        else if k == 6
            if s[1] != 0
                pin_scan_expr(cand, cnt, s[1], w)
            pin_scan_body(cand, cnt, s[2], w)
            if s[3] != 0
                pin_scan_body(cand, cnt, s[3], w)
        else if k == 7
            if s[1] != 0
                pin_scan_expr(cand, cnt, s[1], pin_w10(w))
            pin_scan_body(cand, cnt, s[2], pin_w10(w))
        else if k == 20
            pin_scan_expr(cand, cnt, s[2], w)
            pin_bump(cand, cnt, s[1], pin_w10(w))
            pin_scan_body(cand, cnt, s[3], pin_w10(w))
        else if k == 8
            if s[1] != 0
                pin_scan_expr(cand, cnt, s[1], w)
        else if k == 10
            pin_scan_expr(cand, cnt, s[1], w)
        i = i + 1
    return 0

// Outside every loop: look for loops and nothing else.
pin_scan(cand, cnt, stmts)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 7
            if s[1] != 0
                pin_scan_expr(cand, cnt, s[1], 10)
            pin_scan_body(cand, cnt, s[2], 10)
        else if k == 20
            pin_bump(cand, cnt, s[1], 10)
            pin_scan_body(cand, cnt, s[3], 10)
        else if k == 6
            pin_scan(cand, cnt, s[2])
            if s[3] != 0
                pin_scan(cand, cnt, s[3])
        i = i + 1
    return 0

// Does this function have a loop at all? Nothing else pays back the save and
// the restore, and most functions don't have one.
has_loop(stmts)
    i = 0
    loop i < lcount(stmts)
        s = lget(stmts, i)
        k = s[0]
        if k == 7 || k == 20
            return true
        if k == 6
            if has_loop(s[2])
                return true
            if s[3] != 0
                if has_loop(s[3])
                    return true
        i = i + 1
    return false

// Which names can be pinned at all. A float local holds a raw double, which
// goes in an xmm register instead (pick_fpins). The slots the dead-store
// rewind zeroes and the hidden locals (named with `@`) stay in the frame. The
// rewind's slots and the for-each index are written with
// `mov qword ptr <slot>, 0`, which has no register form.
pin_eligible(cg, name)
    if is_float_local(cg, name)
        return false
    if len(name) > 0
        if name[0] == 64
            return false
    rz = cg[34]
    if rz != 0
        if has(rz[1], name)
            return false
    return true

// Rank by that count and take the best five of those scoring at least twenty,
// which means used at least twice inside a loop, or once inside two. I picked
// twenty by trying several. The save and restore are paid on every call and
// only paid back per pass of a loop, so a function called a million times to
// run a three-pass loop loses. Compiling the compiler (thousands of small
// functions with shallow loops, called constantly) shows it: +4.2%
// instructions at a threshold of ten, +1.4% at twenty and +0.2% at a hundred,
// where sieve gets -23.5%, -23.5% and -13.2%. Twenty keeps all of sieve's
// gain for a small part of the cost.
pick_pins(cg, params, body, locals)
    return pick_pins_of(cg, params, body, locals, 0, 5)

// The same choice among the raw-double locals, for xmm8-xmm15. A float local's
// frame slot costs the same round trip the integer comment above measured: in
// mandelbrot's inner loop `x` and `y` are each stored at the bottom of one pass
// and loaded at the top of the next, so store-to-load forwarding is in the
// chain from one pass to the next twice. In registers that loop takes under
// half the time (9.3 ms against 21.9, with C at 8.7).
//
// No other code uses xmm8-xmm15: the runtime names only xmm0-xmm3 and
// float_scratch stops at xmm7. Linux preserves every xmm register across a
// syscall, and the Win64 ABI makes xmm6-xmm15 callee-saved, so a Win32 call
// preserves them too. So they're free, and a pinning function saves the ones
// it takes and restores them at every exit, the same as rbx and r12-r15, so a
// pinning callee can't disturb a pinning caller.
fpin_regs(k)
    return "xmm" . (8 + k)

// The float version of pin_eligible: a raw-double local, and not a hidden
// slot or one the rewind zeroes.
fpin_eligible(cg, name)
    if !is_float_local(cg, name)
        return false
    if len(name) > 0
        if name[0] == 64
            return false
    rz = cg[34]
    if rz == 0
        return true
    return !has(rz[1], name)

pick_fpins(cg, params, body, locals)
    // A program without a float in it has no float local to pin, and skips the
    // walk.
    if cg[14] != 1
        return mklist(1)
    return pick_pins_of(cg, params, body, locals, 1, 8)

pin_eligible_of(cg, name, fl)
    if fl == 1
        return fpin_eligible(cg, name)
    return pin_eligible(cg, name)

pick_pins_of(cg, params, body, locals, fl, maxn)
    picks = mklist(8)
    if !has_loop(body)
        return picks
    cand = mklist(8)
    i = 0
    loop i < lcount(params)
        if pin_eligible_of(cg, lget(params, i), fl)
            cand = ladd_grow(cand, lget(params, i))
        i = i + 1
    i = 0
    loop i < lcount(locals)
        if pin_eligible_of(cg, lget(locals, i), fl)
            cand = ladd_grow(cand, lget(locals, i))
        i = i + 1
    nc = lcount(cand)
    if nc == 0
        return picks
    cnt = text(nc)
    cidx = {}
    i = 0
    loop i < nc
        if !has(cidx, lget(cand, i))
            cidx[lget(cand, i)] = i
        i = i + 1
    pin_scan(cidx, cnt, body)
    taken = mklist(8)
    n = 0
    loop n < maxn
        bi = 0 - 1
        bestn = 19
        i = 0
        loop i < nc
            if cnt[i] > bestn && !name_in_list(taken, lget(cand, i))
                bestn = cnt[i]
                bi = i
            i = i + 1
        if bi < 0
            return picks
        taken = ladd_grow(taken, lget(cand, bi))
        picks = ladd_grow(picks, lget(cand, bi))
        n = n + 1
    return picks

// The operand a name is reached by: its register when this function pinned it,
// otherwise the frame slot it was given.
pin_slot_for(cg, name, slot)
    ps = cg[39]
    i = 0
    loop i < lcount(ps)
        if lget(ps, i) == name
            return pin_regs(i)
        i = i + 1
    fps = cg[63]
    if fps != 0
        i = 0
        loop i < lcount(fps)
            if lget(fps, i) == name
                return fpin_regs(i)
            i = i + 1
    return slot

// Restore the pinned registers. Emitted at every exit from a pinning function,
// right before the frame comes down. A raw-double answer is already in xmm0
// and an ordinary one in rax, and neither is among these.
emit_unpin(cg)
    fps = cg[63]
    if fps != 0
        fb = cg[64]
        i = 0
        loop i < lcount(fps)
            asmput("    movsd " . fpin_regs(i) . ", [rbp - " . fb + 8 * i . "]")
            i = i + 1
    ps = cg[39]
    if ps == 0
        return 0
    base = cg[40]
    i = 0
    loop i < lcount(ps)
        asmput("    mov " . pin_regs(i) . ", [rbp - " . base + 8 * i . "]")
        i = i + 1

gen_function(cg, name, params, body)
    // Everything emitting one function allocates (its env, its locals, their
    // inferred kinds, its escape set, its labels, its deferred lines, and every
    // line of assembly built by joining) is dead once its last instruction is
    // emitted, because the emit buffer holds copies of the bytes. So the arena
    // is rewound to where it stood. At 4,000 functions that's 15 MB of a 41 MB
    // compile. The one thing above the mark that has to survive is the emit
    // buffer itself, if it grew in this window, and rt_reset checks for that
    // and skips the rewind.
    m = mark()
    // The row this function's parameters were proved to hold, for mkframe and
    // for every cg_kind that reads a parameter inside the body.
    cg[25] = pk_lookup(cg, name)
    cg[46] = pk_lookup_sub(cg, name)
    cg[28] = 0
    if pk_ret_kind(cg, name) == 3
        cg[28] = 1
    // The body label is `fn_<name>.body`, with a dot, which a word identifier
    // can't contain, so it can't collide with a user function's label. It
    // used to be `_body`, and since word.w has both `pin_scan` and
    // `pin_scan_body`, `fn_pin_scan_body` was defined twice and every call to
    // pin_scan_body ran pin_scan.
    if in_before_or_after(cg, name)
        asmput("fn_" . name . ".body:")
        mkframe(cg, params, body)
        emit_wrapper(cg, name, params)
    else
        asmput("fn_" . name . ":")
        asmput("fn_" . name . ".body:")
        mkframe(cg, params, body)
    // The out-of-line paths this function deferred with emlater (slow
    // compares, map arms, byte-backed loads), placed after its final `ret` so
    // nothing can fall into them.
    flush_later(cg)
    reset(m)
    // Everything below pointed into the rewound window. Nothing reads them
    // between functions (each is set again on the way in), but a dangling
    // pointer left in `cg` would be hard to track down, so they're cleared.
    cg[2] = 0
    cg[15] = 0
    cg[16] = mklist(8)
    cg[23] = 0
    cg[25] = 0
    cg[46] = 0
    cg[34] = 0
    cg[39] = 0
    cg[63] = 0

// `s` as the quoted operand of an .ascii line. A file name can hold a quote,
// and the assembler reads a backslash as the start of an escape, so both are
// escaped. Every other byte goes through as it is.
asm_quote(s)
    q = "\""
    i = 0
    loop i < len(s)
        if s[i] == 34 || s[i] == 92
            q = q . "\\"
        q = q . copy(s, i, i + 1)
        i = i + 1
    return q . "\""

// emit_contract_names emits one `cn_<fn>: .ascii "<fn>"` string per hooked
// function (deduped across before/after hooks) so a failing contract can name
// the function it guards. Identifiers are ASCII, so str_repr never escapes.
emit_contract_names(cg)
    seen = mklist(256)
    src = cg[9]
    pass = 0
    loop pass < 2
        gi = 0
        loop gi < lcount(src)
            e = lget(src, gi)
            nm = e[0]
            if !name_in_list(seen, nm)
                seen = ladd_grow(seen, nm)
                asmput("cn_" . nm . ": .ascii " . str_repr(nm))
            gi = gi + 1
        src = cg[10]
        pass = pass + 1

// ---- maps ({}) -------------------------------------------------------------
// A map is the boxed extension kind in docs/VALUE_MODEL.md: the value word is a
// cell pointer with tag 100, so `m - 4` is the cell.
//
//   [cell+0]  subkind, 0 = map
//   [cell+8]  count: how many pairs it holds
//   [cell+16] pairs: one region, key,val,key,val... in insertion order
//   [cell+24] idx: an open-addressing hash index. A slot is 0 (empty) or
//                  (hash << 33) | (1 + pair position)
//
// Keys and values share one region so growing it is one reallocation, and
// insertion order is kept so json.stringify writes fields back in order. The
// index keeps lookup O(1) and is rebuilt at twice the size when half full.
