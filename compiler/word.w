    asmput("    rep movsb")
    asmput("    mov rbx, rax")
    asmput("    pop rcx")
    asmput("    jmp .ls_fit")
    asmput(".ls_room:")
    asmput("    lea rsi, [rip+dirbuf]")
    asmput("    add rsi, r15")
    asmput("    add rsi, 19")
    asmput("    add r15, rcx")
    asmput("    lea rdi, [rbx + 8]")
