    asmput(".cn_ok:")
    asmput("    lea rax, [rbx+rbx+1]")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput(".cn_closefail:")
    asmput("    mov rax, 3")
    asmput("    mov rdi, rbx")
    emit_syscall(cg)
    asmput(".cn_fail:")
    asmput("    mov rax, 1")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    asmput("# rt_send: rdi = fd (tagged), rsi = bytes -> rax = tagged count, or 0")
    asmput("rt_send:")
