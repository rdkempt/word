        asmput("kindlit_num:")
        asmput(lit_line("number"))
        asmput("kindlit_text:")
        asmput(lit_line("text"))
        asmput("kindlit_list:")
        asmput(lit_line("array"))
        asmput("kindlit_bytes:")
        asmput(lit_line("bytes"))
        asmput("kindlit_map:")
        asmput(lit_line("map"))
        asmput("kindlit_bool:")
        asmput(lit_line("boolean"))
        asmput("kindlit_null:")
        asmput(lit_line("null"))
        asmput("kindlit_none:")
        asmput(lit_line("none"))
    // The four singletons' names are always emitted: any program can receive
    // one without writing one (json.parse, number()), and gating these on a
    // literal in the source would print a value the program legitimately holds
    // as garbage. It's about 230 bytes, once.
    asmput("siglit_null:")
    asmput(lit_line("null"))
    asmput("siglit_false:")
    asmput(lit_line("false"))
    asmput("siglit_true:")
    asmput(lit_line("true"))
    asmput("siglit_none:")
    asmput(lit_line("none"))
    asmput("litpool_end:")
    asmput("jwlit_true: .ascii \"true\"")
    asmput("jwlit_false: .ascii \"false\"")
    asmput("jwlit_null: .ascii \"null\"")
    asmput("err_div: .ascii \"divide by zero\"")
    asmput("err_bounds: .ascii \"index out of bounds\"")
    asmput("err_oom: .ascii \"out of memory\"")
