            if s[3] != 0
                acc = collect_locals_r(s[3], acc, seen)
        else if k == 7
            hl = loop_hoist(s)
            if len(hl) > 0
                acc = cl_add(acc, seen, hl)
            acc = collect_locals_r(s[2], acc, seen)
        else if k == 20
            acc = cl_add(acc, seen, s[1])
            acc = cl_add(acc, seen, fe_hidden_p(s))
            acc = cl_add(acc, seen, fe_hidden_i(s))
            acc = collect_locals_r(s[3], acc, seen)
        i = i + 1
    return acc

cl_add(acc, seen, name)
    if has(seen, name)
        return acc
    seen[name] = 1
    return ladd_grow(acc, name)

