    asmput("    mov rdx, [rsi]")
    asmput("    add rsi, 8")
    asmput("    mov rax, 0")
    emit_syscall(cg)
    asmput("    test rax, rax")
    asmput("    js .rc_fail")
    asmput("    lea rax, [rax+rax+1]")
    asmput("    ret")
    asmput(".rc_fail:")
    asmput("    mov rax, 1")
    asmput("    ret")
    asmput("")
    asmput("# rt_close: rdi = fd (tagged) -> rax = 0")
    asmput("rt_close:")
    asmput("    call rt_osync")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 1")
    asmput("    jz rt_intfault")
    asmput("    sar rdi, 1")
