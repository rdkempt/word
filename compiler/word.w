    asmput("    mov rcx, [rip+jp_pos]")
    asmput("    inc rcx")
    asmput("    mov [rip+jp_pos], rcx")
    asmput("    call rt_jp_ws")
    asmput("    call rt_jp_at")
    asmput("    cmp rax, 93")
    asmput("    jne .ja_l")
    asmput("    mov rcx, [rip+jp_pos]")
    asmput("    inc rcx")
    asmput("    mov [rip+jp_pos], rcx")
    asmput("    jmp .ja_fin")
    asmput(".ja_l:")
    asmput("    call rt_jp_value")
    asmput("    mov r13, rax")
    asmput("    cmp r12, [rbx]")
    asmput("    jl .ja_fits")
    asmput("    mov rdi, [rbx]")
    asmput("    shl rdi, 1")
    asmput("    call rt_ralloc")
    asmput("    mov r10, rax")
    asmput("    xor rdx, rdx")
    asmput(".ja_cp:")
    asmput("    cmp rdx, r12")
    asmput("    jge .ja_cpd")
    asmput("    mov rax, [rbx + rdx*8 + 8]")
    asmput("    mov [r10 + rdx*8 + 8], rax")
    asmput("    inc rdx")
    asmput("    jmp .ja_cp")
    asmput(".ja_cpd:")
    asmput("    mov rbx, r10")
    asmput(".ja_fits:")
    asmput("    mov [rbx + r12*8 + 8], r13")
    asmput("    inc r12")
    asmput("    call rt_jp_ws")
    asmput("    call rt_jp_at")
    asmput("    cmp rax, 44")
    asmput("    jne .ja_e")
    asmput("    mov rcx, [rip+jp_pos]")
    asmput("    inc rcx")
    asmput("    mov [rip+jp_pos], rcx")
    asmput("    jmp .ja_l")
    asmput(".ja_e:")
    asmput("    cmp rax, 93")
    asmput("    jne .jv_bad")
    asmput("    mov rcx, [rip+jp_pos]")
    asmput("    inc rcx")
    asmput("    mov [rip+jp_pos], rcx")
    asmput(".ja_fin:")
    asmput("    mov rdi, r12")
    asmput("    call rt_ralloc")
    asmput("    mov r10, rax")
    asmput("    xor rdx, rdx")
    asmput(".ja_tl:")
    asmput("    cmp rdx, r12")
