// How long connect() waits for a peer to answer the handshake, in seconds.
//
// Without one a blocking connect runs to the kernel's own timeout: about two
// minutes on Linux (tcp_syn_retries 6) and 21 seconds on Windows. Nothing above
// connect() can set a shorter one, because the socket it would be set on
// doesn't exist until connect() has made it (timeout() comes too late), so
// rt_connect sets it between the two syscalls. Ten seconds lets a lossy link
// retransmit its SYN three times (Linux sends at 0, 1, 3 and 7 s).
connect_secs()
    return 10

// Put the handshake deadline on the stream socket in rbx for the connect that
// follows (`tv` = conn_tv), or take it off again once connected (`tv` =
// conn_tv0). On Linux that's SO_SNDTIMEO, which a blocking connect honours
// and then fails with EINPROGRESS. Windows ignores SO_SNDTIMEO there, and its
// connect deadline is TCP_MAXRT: IPPROTO_TCP option 5, a DWORD of seconds,
// where 0 is the system default. Both read the same two words, whose first
// four bytes are the DWORD. w_syscall hands an IPPROTO_TCP option to ws2_32
// unchanged.
emit_conn_deadline(cg, tv)
    asmput("    mov rax, 54")
    asmput("    mov rdi, rbx")
    if cg[12] == 1
        asmput("    mov rsi, 6")
        asmput("    mov rdx, 5")
        asmput("    lea r10, [rip+" . tv . "]")
        asmput("    mov r8, 4")
    else
        asmput("    mov rsi, 1")
        asmput("    mov rdx, 21")
        asmput("    lea r10, [rip+" . tv . "]")
        asmput("    mov r8, 16")
    emit_syscall(cg)

// The four socket primitives (connect, send, recv and close, with rt_udp as
// connect's datagram form): the narrow, typed transport under DNS, TLS and
// HTTP, which are written in word. They're raw Linux syscalls (socket,
// connect, setsockopt for the handshake deadline, sendto, read and close) and
// nothing else. On Windows w_syscall maps them onto ws2_32, and send goes to
// it as a write. connect takes the four IPv4 octets as a byte region (name
// resolution is DNS's job, above this) and a port number. A TCP connect gives
// up after connect_secs(), and a UDP one has no handshake to wait for.
//
// Every argument is checked before a socket syscall is made. An fd, a port and
// a timeout are whole numbers, and an address or a buffer is bytes (a
// byte-backed region), so recv never writes raw bytes over a region's tagged
// words and send never writes those words out. A wrong kind is the usual
// located fault. An address that isn't four bytes, or a port past 65535,
// names nothing to connect to, and connect answers 0 for it as it does for a
// peer that doesn't answer.
emit_sockets(cg)
    asmput("# rt_bytesfault: r10 = a word-backed region where bytes were needed. It's")
    asmput("# named the way kind() names it: an array carries the JSON-array mark.")
    asmput("rt_bytesfault:")
    asmput("    test qword ptr [r10 - 16], 2")
    asmput("    jnz .bf_arr")
    asmput("    lea rdi, [rip+err_bytestext]")
    asmput("    mov rsi, 24")
    asmput("    jmp rt_fail")
    asmput(".bf_arr:")
    asmput("    lea rdi, [rip+err_bytesarr]")
    asmput("    mov rsi, 28")
    asmput("    jmp rt_fail")
    asmput("# rt_udp: the same as rt_connect but SOCK_DGRAM. connect() on a datagram")
    asmput("# socket makes no handshake (it only fixes the default peer), so it returns")
    asmput("# at once and send and recv work on the result unchanged. That's why UDP")
    asmput("# costs one new primitive here and not a sendto/recvfrom pair.")
    asmput("rt_udp:")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    mov r14, 2")
    asmput("    jmp .cn_check")
    asmput("# rt_connect: rdi = the IPv4 address as 4 bytes, rsi = port (tagged)")
    asmput("# -> rax = tagged fd, or 0. r14 is the socket type throughout: 1 stream,")
    asmput("# 2 datagram.")
