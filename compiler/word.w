        // one-shot WSAStartup guard, and the table of live SOCKET handles that
        // lets read/write/close tell a socket from a file handle (64 slots).
        asmput("wsa_data: .space 512")
        asmput("wsa_started: .space 8")
        asmput("wsock_tab: .space 512")
        if cg[58] == 1
