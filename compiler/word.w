        // file, and the file is gone, where rename(2) refuses (ENOTDIR). So
        // when both exist and just one of them is a directory, nothing moves
        // and the answer is -1, as Linux answers a file over a directory too
        // (EISDIR). A link to a directory has the directory attribute (16), so
        // it counts as one. GetFileAttributesA answers -1 for a path that isn't
        // there, and then MoveFileExA decides.
        asmput("    mov rcx, r12")
        asmput("    call qword ptr [rip+GetFileAttributesA]")
        asmput("    mov ebx, eax")
        asmput("    mov rcx, r13")
        asmput("    call qword ptr [rip+GetFileAttributesA]")
        asmput("    cmp eax, -1")
        asmput("    je .wsc_rn_go")
        asmput("    cmp ebx, -1")
        asmput("    je .wsc_rn_go")
        asmput("    xor eax, ebx")
        asmput("    test eax, 16")
        asmput("    jnz .wsc_rn_fail")
        asmput(".wsc_rn_go:")
        asmput("    mov rcx, r12")
        asmput("    mov rdx, r13")
        asmput("    mov r8d, 1")
        asmput("    call qword ptr [rip+MoveFileExA]")
        asmput("    test eax, eax")
        asmput("    jz .wsc_rn_fail")
        asmput("    xor rax, rax")
        asmput("    jmp .wsc_ret")
        asmput(".wsc_rn_fail:")
        asmput("    mov rax, -1")
        asmput("    jmp .wsc_ret")
    if cg[30] == 1
        // getrandom(buf=r12, len=r13, flags) -> BCryptGenRandom(NULL, buf, len,
        // BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2), answering len as getrandom does.
        // It serves random(), and through it the TLS handshake, and predictable
        // bits would break TLS outright, so it's the system generator and never
        // a stub. bcrypt.dll is imported only because this block refers to it
        // (link_pe collects imports from relocations), so a PE that needs no
        // randomness doesn't import it.
        asmput("# getrandom(buf=r12, len=r13, flags): the system CSPRNG, behind both the")
        asmput("# TLS handshake's keys and nonces and random(). BCryptGenRandom with")
        asmput("# BCRYPT_USE_SYSTEM_PREFERRED_RNG (2). Answers len, as getrandom does, but")
        asmput("# only when the NTSTATUS says the buffer was filled. Otherwise -1, which the")
        asmput("# caller refuses, so an untouched buffer is never passed off as random.")
        asmput(".wsc_getrandom:")
        asmput("    xor rcx, rcx")
        asmput("    mov rdx, r12")
        asmput("    mov r8, r13")
        asmput("    mov r9d, 2")
        asmput("    call qword ptr [rip+BCryptGenRandom]")
        asmput("    test eax, eax")
        asmput("    jnz .wsc_gr_fail")
        asmput("    mov rax, r13")
        asmput("    jmp .wsc_ret")
        asmput(".wsc_gr_fail:")
        asmput("    mov rax, -1")
        asmput("    jmp .wsc_ret")
