    asmput("    inc rdx")
    asmput("    jmp .ja_tl")
    asmput(".ja_td:")
    asmput("    or qword ptr [r10 - 16], 2")
    asmput("    mov rax, r10")
    asmput("    jmp .jv_ret")
    asmput(".jv_bad:")
