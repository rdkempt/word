    // by then, so this is the out of memory it would have hit anyway, reported
    // before any of the map is touched instead of as a slot whose position
    // ran into its hash.
    asmput("    mov rax, [rbx + 8]")
    asmput("    inc rax")
    asmput("    shr rax, 33")
    asmput("    jnz rt_oom")
