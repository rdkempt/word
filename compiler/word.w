        // that isn't a region faults here, the one place get, set and has all go
        // through, before rt_bytepromote could give a map the ordering message
        // (as on x86-64).
        asmput("")
        asmput("rt_map_hash:")
        asmput("    and x9, x0, #7")
        asmput("    cbnz x9, rt_regfault")
        asmput("    ldur x9, [x0, #-16]")
        asmput("    tbnz x9, #0, .mh_promote")
        asmput("    b .mh_go")
        asmput(".mh_promote:")
