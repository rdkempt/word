// emit_fbinop: one float arithmetic helper. rdi=left, rsi=right (each an int or
// a float); promote both to double, apply `sseop`, box the result.
emit_fbinop(cg, name, sseop)
    asmput(name . ":")
    asmput("    push rsi")
    asmput("    call rt_to_double")
    asmput("    movq r11, xmm0")
    asmput("    pop rdi")
    asmput("    call rt_to_double")
    asmput("    movq xmm1, r11")
    asmput("    " . sseop . " xmm1, xmm0")
    asmput("    movq rax, xmm1")
    asmput("    call rt_box_float")
    asmput("    ret")

// The same operation, writing the result into the left operand's box when that
// box is a temporary nothing else holds. A float value is a boxed double (SPEC
// 3.6) and the arena never frees, so a box per operator adds up: `a*b + c*d + e`
// in a loop would allocate one for every operator on every pass.
//
// Codegen calls this variant where the left operand's box can't be held
// anywhere else: the result of float arithmetic or a float literal
// (is_float_temp), or a unique local updated in place, `x = x + ...`
// (is_float_acc). The tag is still checked here, because the same site also
// runs when that operand came out an integer (the float path is chosen per
// operand at run time), and then rdi is a tagged number with no box to write
// into.
emit_fbinop_reuse(cg, name, sseop)
    asmput(name . "_r:")
    asmput("    push rdi")
    asmput("    push rsi")
    asmput("    call rt_to_double")
    asmput("    movq r11, xmm0")
    asmput("    pop rdi")
    asmput("    call rt_to_double")
    asmput("    movq xmm1, r11")
    asmput("    " . sseop . " xmm1, xmm0")
    asmput("    movq rax, xmm1")
    asmput("    pop rdi")
    asmput("    mov r10, rdi")
    asmput("    and r10, 7")
    asmput("    cmp r10, 2")
    asmput("    jne " . name . "_r_new")
    asmput("    and rdi, -8")
    asmput("    mov [rdi], rax")
    asmput("    mov rax, rdi")
    asmput("    or rax, 2")
    asmput("    ret")
    asmput(name . "_r_new:")
    asmput("    call rt_box_float")
    asmput("    ret")

