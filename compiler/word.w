        a64_fault("rt_idxfrac", "err_idxfrac", 34)

// The arm64 half of emit_failhdr_files, for a folder program: the name of the
// file cur_line falls in and its colon, leaving that file's own line in x0. How
// far into the program the file starts is kept in x19, saved here and put back
// on rt_failhdr's way out.
a64_failhdr_files(cg)
    files = cg[57]
    asmput("    stp x19, x20, [sp, #-16]!")
    a64_ldg("x9", "cur_line")
    i = lcount(files) - 1
    loop i >= 1
        f = lget(files, i)
        a64_movi("x10", f[0])
        asmput("    cmp x9, x10")
        asmput("    b.lt .fh_" . i)
        a64_adr("x1", "err_file" . i)
        a64_movi("x2", len(f[1]))
        a64_movi("x19", f[0] - 1)
        asmput("    b .fh_go")
        asmput(".fh_" . i . ":")
        i = i - 1
    a64_adr("x1", "err_file")
    a64_movi("x2", len(cg[22]))
    asmput("    mov x19, xzr")
    asmput(".fh_go:")
    asmput("    mov x0, #2")
    asmput("    mov x8, #64")
    a64_svc(cg)
    asmput("    mov x0, #2")
    a64_adr("x1", "err_colon")
    asmput("    mov x2, #1")
    asmput("    mov x8, #64")
    a64_svc(cg)
    a64_ldg("x0", "cur_line")
    asmput("    sub x0, x0, x19")

// One float operation: x0 op x1, each made a double by rt_to_double (an integer
// converted, a float unboxed), then the result boxed once.
a64_fbinop(name, op)
    asmput("")
    asmput(name . ":")
    asmput("    stp x29, x30, [sp, #-16]!")
    asmput("    mov x29, sp")
    asmput("    stp x19, x20, [sp, #-16]!")
    asmput("    mov x19, x1")
    asmput("    bl rt_to_double")
    asmput("    fmov x20, d0")
    asmput("    mov x0, x19")
    asmput("    bl rt_to_double")
    asmput("    fmov d1, x20")
    asmput("    " . op . " d0, d1, d0")
    asmput("    fmov x0, d0")
    asmput("    ldp x19, x20, [sp], #16")
    asmput("    ldp x29, x30, [sp], #16")
    asmput("    b rt_box_float")

// "region expected, got ...". The offending word arrives whole in x0, where
// every region check on this target already has it (an argument or an
// expression result). The routines whose checked value is their second
// argument (find's needle, split's separator, the data of write and writex,
// exec's argument list, and the buffer of send and recv) enter at
// rt_regfault1, which moves it across. x9, the tag the site computed, isn't
// read: it can't tell the four singletons apart, since all of them are 110.
// The dispatch is the x86-64 one: a singleton is named from the word itself
// (SPEC 3.8), and anything else from its tag (SPEC 3.6). 100 is a map, and
// what's left is an integer or a float, which the language calls a number.
a64_regfault(cg)
    asmput("rt_regfault1:")
    asmput("    mov x0, x1")
    asmput("rt_regfault:")
    asmput("    cmp x0, #6")
    asmput("    b.eq .rf_null")
    asmput("    cmp x0, #30")
    asmput("    b.eq .rf_none")
    asmput("    cmp x0, #14")
    asmput("    b.eq .rf_bool")
    asmput("    cmp x0, #22")
    asmput("    b.eq .rf_bool")
    if cg[20] == 1
        asmput("    and x9, x0, #7")
        asmput("    cmp x9, #4")
        asmput("    b.eq .rf_map")
    a64_faultbody("err_region", 29)
    if cg[20] == 1
        asmput(".rf_map:")
        a64_faultbody("err_regmap", 26)
    asmput(".rf_null:")
    a64_faultbody("err_regnull", 25)
    asmput(".rf_none:")
    a64_faultbody("err_regnone", 25)
    asmput(".rf_bool:")
    a64_faultbody("err_regbool", 30)
    return 0

// One fault: name the message and jump into the reporter. `n` is the whole
// message's length, as on x86-64. test_kinds.sh and test_a64_lang.sh compare
// the two targets' faults byte for byte, which catches a wrong length.
a64_fault(label, msg, n)
    asmput(label . ":")
    a64_faultbody(msg, n)

// The body without the label, for a fault that dispatches on the offending
// value and so needs several of them under one entry point.
a64_faultbody(msg, n)
    a64_adr("x0", msg)
    asmput("    mov x1, #" . n)
    asmput("    b rt_fail")

// ==========================================================================
// The assembler and the static ELF64 writer. This was dev/toolchain/wasm.w,
// which is why the assembler's messages start with "wasm:".
// ==========================================================================

// A growable byte buffer. b[0] is the length in bytes and b[1] is the store, a
// byte-backed region, so a section buffer costs one byte per byte instead of
// eight. The store doubles when it's full, so there's no fixed capacity to run
// out of. `cap` is only the starting size, to save a few doublings when the
// size is known.
mkbuf(cap)
    if cap < 64
        cap = 64
    b = text(2)
    b[0] = 0
    b[1] = bytes(cap)
    return b

blen(b)
    return b[0]

// Ensure the store holds at least `need` bytes, doubling until it does.
bgrow(b, need)
    d = b[1]
    c = len(d)
    if need <= c
        return 0
    loop c < need
        c = c * 2
    // A join of two byte-backed regions is byte-backed and is one block copy
    // in the runtime (`rep movsb` on x86-64), where a loop here would check
    // bounds on every byte. bput only calls this when `d` is full, so every
    // byte copied is in use and the zeros after them are the new capacity.
    b[1] = d . bytes(c - len(d))

bput(b, v)
    n = b[0]
    d = b[1]
    if n >= len(d)
        bgrow(b, n + 1)
        d = b[1]
    d[n] = v & 255
    b[0] = n + 1

bget(b, i)
    d = b[1]
    return d[i]

bset(b, i, v)
    d = b[1]
    d[i] = v & 255

// The buffer's bytes as a region of blen(b) elements, which is what gets
// written to disk. The store itself is usually longer (its capacity).
btake(b)
    d = b[1]
    return copy(d, 0, b[0])

bputn(b, val, n)
    k = 0
    loop k < n
        bput(b, (val >> (k * 8)) & 255)
        k = k + 1

emit4le(b, v)
    bput(b, v & 255)
    bput(b, (v >> 8) & 255)
    bput(b, (v >> 16) & 255)
    bput(b, (v >> 24) & 255)

// A 64-bit literal as [low32, high32]. word's own integers are 63-bit, so a
// full-width constant can't be carried in one. The AArch64 encoder reads its
// wide moves and logical masks through this. The x86 encoder and the
// directives use num_parse, which also refuses anything that isn't a number.
parse_num64(s, a, e)
    a = skip_space(s, a, e)
    e = back_space(s, a, e)
    neg = 0
    i = a
    if i < e && s[i] == 45
        neg = 1
        i = i + 1
    base = 10
    if e >= i + 2 && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)
        base = 16
        i = i + 2
    lo = 0
    hi = 0
    loop i < e
        d = 0
        if base == 16
            d = hexval(s[i])
            if d < 0
                break
        else
            if !is_digit(s[i])
                break
            d = s[i] - 48
        nlo = lo * base + d
        carry = nlo >> 32
        lo = nlo & 4294967295
        hi = (hi * base + carry) & 4294967295
        i = i + 1
    if neg != 0
        lo = (lo ^ 4294967295) + 1
        hi = hi ^ 4294967295
        if lo > 4294967295
            lo = lo & 4294967295
            hi = (hi + 1) & 4294967295
    p = text(2)
    p[0] = lo
    p[1] = hi
    return p

is_space(c)
    if c == 32
        return true
    if c == 9
        return true
    return false

// A substring, for the names the assembler keeps (labels, .global, .equ,
// directive names) and for its messages. An empty range gives a new empty
// region and a range covering the whole region gives the region itself, with
// no copy. Nothing in the assembler writes through a sub result, so sharing
// is safe.
sub(s, a, b)
    if b <= a
        return text(0)
    if a == 0 && b == len(s)
        return s
    return copy(s, a, b)

// ---- Parsing by bounds -------------------------------------------------------
// The assembler runs the operand path once per operand of every line it
// assembles, and word.w's x86-64 assembly is about 400,000 lines. Slicing each
// piece out costs a fresh region (8 bytes per code point plus a 24-byte
// header) that's dead as soon as the operand is encoded, and that garbage was
// most of the assembler's peak memory. These read s[a..b) in place instead.

indexof_r(s, c, from, b)
    i = from
    loop i < b
        if s[i] == c
            return i
        i = i + 1
    return 0 - 1

// Is s[a..b) equal to lit, element for element?
range_eq(s, a, b, lit)
    if b - a != len(lit)
        return false
    i = 0
    loop i < len(lit)
        if s[a + i] != lit[i]
            return false
        i = i + 1
    return true

range_starts(s, a, b, pfx)
    if b - a < len(pfx)
        return false
    i = 0
    loop i < len(pfx)
        if s[a + i] != pfx[i]
            return false
        i = i + 1
    return true

// The two halves of a trim, as bounds: the first non-space at or after a, and
// one past the last non-space before b.
skip_space(s, a, b)
    loop a < b && is_space(s[a])
        a = a + 1
    return a

back_space(s, a, b)
    loop b > a && is_space(s[b - 1])
        b = b - 1
    return b

hexval(c)
    if c >= 48 && c <= 57
        return c - 48
    if c >= 97 && c <= 102
        return c - 87
    if c >= 65 && c <= 70
        return c - 55
    return 0 - 1

// A number at the start of s[a..b), read the way the AArch64 encoder reads its
// immediates (through a64_imm): it stops at the first character that isn't a
// digit, so `#12abc` is 12 (docs/SECURITY.md §6 says so too). The digits build
// the two 32-bit halves of a 64-bit pattern, which no length of number can
// overflow. Multiplying by ten in word's checked arithmetic used to fault
// inside the assembler on a decimal immediate of 2^62 or more. The answer is
// the pattern's low 63 bits, as one of word's integers. The x86 encoder and
// the directives read numbers through num_parse instead, which keeps all 64
// bits and says when a number doesn't fit.
parse_num_r(s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    neg = 0
    i = a
    if i < b && s[i] == 45
        neg = 1
        i = i + 1
    hex = 0
    if b >= i + 2 && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)
        hex = 1
        i = i + 2
    lo = 0
    hi = 0
    loop i < b
        if hex == 1
            d = hexval(s[i])
            if d < 0
                break
            hi = ((hi << 4) | (lo >> 28)) & 4294967295
            lo = ((lo << 4) | d) & 4294967295
        else
            if !is_digit(s[i])
                break
            nlo = lo * 10 + (s[i] - 48)
            hi = (hi * 10 + (nlo >> 32)) & 4294967295
            lo = nlo & 4294967295
        i = i + 1
    if neg != 0
        // Two's complement on the halves, so negating -2^62 cannot overflow.
        lo = (lo ^ 4294967295) + 1
        hi = (hi ^ 4294967295) + (lo >> 32)
        lo = lo & 4294967295
        hi = hi & 4294967295
    return (hi << 32) | lo

// A number and nothing else: an optional '-', then decimal digits or 0x and hex
// digits. Answers 1 and fills the immediate operand `o` (o[1] the value as one
// of word's integers, exact when it fits in 63 bits, o[2] and o[3] the low and
// high halves of its 64-bit pattern), 0 when the text isn't a number, and 2
// when it is one but needs more than 64 bits, signed or unsigned. The x86
// encoder used to read operands with parse_num_r, which stops at the first
// stray character, so `mov rax, 0 - 1` assembled as `mov rax, 0`.
num_parse(s, a, b, o)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    neg = 0
    i = a
    if i < b && s[i] == 45
        neg = 1
        i = i + 1
    hex = 0
    if b >= i + 2 && s[i] == 48 && (s[i + 1] == 120 || s[i + 1] == 88)
        hex = 1
        i = i + 2
    if i >= b
        return 0
    lo = 0
    hi = 0
    over = 0
    loop i < b
        if hex == 1
            d = hexval(s[i])
            if d < 0
                return 0
            // The top digit of `hi` is about to be shifted out.
            if hi >= 268435456
                over = 1
            hi = ((hi << 4) | (lo >> 28)) & 4294967295
            lo = ((lo << 4) | d) & 4294967295
        else
            if !is_digit(s[i])
                return 0
            nlo = lo * 10 + (s[i] - 48)
            nhi = hi * 10 + (nlo >> 32)
            if nhi > 4294967295
                over = 1
            hi = nhi & 4294967295
            lo = nlo & 4294967295
        i = i + 1
    if over == 1
        return 2
    if neg != 0
        // -2^63 is the most negative 64-bit value.
        if hi > 2147483648 || (hi == 2147483648 && lo != 0)
            return 2
        lo = (lo ^ 4294967295) + 1
        hi = (hi ^ 4294967295) + (lo >> 32)
        lo = lo & 4294967295
        hi = hi & 4294967295
    o[1] = (hi << 32) | lo
    o[2] = lo
    o[3] = hi
    return 1

// Does the immediate operand `o` fit a field this many bytes wide? It takes a
// value the way `as` does, signed or unsigned: 1 is -128..255, 2 is
// -32768..65535, 4 is -2^31..2^32-1, and 8 is any 64-bit value. 5 is a 32-bit
// field the CPU sign-extends to 64 bits, -2^31..2^31-1, which is what every
// 64-bit instruction but mov r64, imm64 carries.
imm_fits(o, field)
    lo = o[2]
    hi = o[3]
    if field == 8
        return true
    if field == 5
        return (hi == 0 && lo < 2147483648) || (hi == 4294967295 && lo >= 2147483648)
    if field == 4
        return hi == 0 || (hi == 4294967295 && lo >= 2147483648)
    if field == 2
        return (hi == 0 && lo < 65536) || (hi == 4294967295 && lo >= 4294934528)
    return (hi == 0 && lo < 256) || (hi == 4294967295 && lo >= 4294967168)

// djb2 over a range of the source line, so the assembler never has to cut an
// operand out of the line to ask whether it's a register. Like lhash, it's
// masked every step so it can't overflow, and (h << 5) + h is h * 33 without
// a multiply. 1024 slots for 80 registers is a load factor of 0.08, which is
// what keeps the probe counts below so low.
reg_hash_r(s, a, b)
    h = 5381
    i = a
    loop i < b
        h = ((h << 5) + h + s[i]) & 65535
        i = i + 1
    return h & 1023

add_reg(tbl, name, num, size)
    e = text(3)
    e[0] = name
    e[1] = num
    e[2] = size
    h = reg_hash_r(name, 0, len(name))
    loop tbl[h] != 0
        h = (h + 1) & 1023
    tbl[h] = e

build_regs()
    t = text(1024)
    add_reg(t, "rax", 0, 8)
    add_reg(t, "rcx", 1, 8)
    add_reg(t, "rdx", 2, 8)
    add_reg(t, "rbx", 3, 8)
    add_reg(t, "rsp", 4, 8)
    add_reg(t, "rbp", 5, 8)
    add_reg(t, "rsi", 6, 8)
    add_reg(t, "rdi", 7, 8)
    add_reg(t, "r8", 8, 8)
    add_reg(t, "r9", 9, 8)
    add_reg(t, "r10", 10, 8)
    add_reg(t, "r11", 11, 8)
    add_reg(t, "r12", 12, 8)
    add_reg(t, "r13", 13, 8)
    add_reg(t, "r14", 14, 8)
    add_reg(t, "r15", 15, 8)
    add_reg(t, "al", 0, 1)
    add_reg(t, "cl", 1, 1)
    add_reg(t, "dl", 2, 1)
    add_reg(t, "bl", 3, 1)
    add_reg(t, "spl", 4, 1)
    add_reg(t, "bpl", 5, 1)
    add_reg(t, "sil", 6, 1)
    add_reg(t, "dil", 7, 1)
    add_reg(t, "r8b", 8, 1)
    add_reg(t, "r9b", 9, 1)
    add_reg(t, "r10b", 10, 1)
    add_reg(t, "r11b", 11, 1)
    add_reg(t, "r12b", 12, 1)
    add_reg(t, "r13b", 13, 1)
    add_reg(t, "r14b", 14, 1)
    add_reg(t, "r15b", 15, 1)
    add_reg(t, "eax", 0, 4)
    add_reg(t, "ecx", 1, 4)
    add_reg(t, "edx", 2, 4)
    add_reg(t, "ebx", 3, 4)
    add_reg(t, "esp", 4, 4)
    add_reg(t, "ebp", 5, 4)
    add_reg(t, "esi", 6, 4)
    add_reg(t, "edi", 7, 4)
    add_reg(t, "r8d", 8, 4)
    add_reg(t, "r9d", 9, 4)
    add_reg(t, "r10d", 10, 4)
    add_reg(t, "r11d", 11, 4)
    add_reg(t, "r12d", 12, 4)
    add_reg(t, "r13d", 13, 4)
    add_reg(t, "r14d", 14, 4)
    add_reg(t, "r15d", 15, 4)
    add_reg(t, "ax", 0, 2)
    add_reg(t, "cx", 1, 2)
    add_reg(t, "dx", 2, 2)
    add_reg(t, "bx", 3, 2)
    add_reg(t, "sp", 4, 2)
    add_reg(t, "bp", 5, 2)
    add_reg(t, "si", 6, 2)
    add_reg(t, "di", 7, 2)
    add_reg(t, "r8w", 8, 2)
    add_reg(t, "r9w", 9, 2)
    add_reg(t, "r10w", 10, 2)
    add_reg(t, "r11w", 11, 2)
    add_reg(t, "r12w", 12, 2)
    add_reg(t, "r13w", 13, 2)
    add_reg(t, "r14w", 14, 2)
    add_reg(t, "r15w", 15, 2)
    // The SSE registers, marked with size 16 so encode() can tell an xmm
    // operand from a general register (nothing else uses size 16). The float
    // code and the runtime's word copies (rt_wmove) use them.
    add_reg(t, "xmm0", 0, 16)
    add_reg(t, "xmm1", 1, 16)
    add_reg(t, "xmm2", 2, 16)
    add_reg(t, "xmm3", 3, 16)
    add_reg(t, "xmm4", 4, 16)
    add_reg(t, "xmm5", 5, 16)
    add_reg(t, "xmm6", 6, 16)
    add_reg(t, "xmm7", 7, 16)
    add_reg(t, "xmm8", 8, 16)
    add_reg(t, "xmm9", 9, 16)
    add_reg(t, "xmm10", 10, 16)
    add_reg(t, "xmm11", 11, 16)
    add_reg(t, "xmm12", 12, 16)
    add_reg(t, "xmm13", 13, 16)
    add_reg(t, "xmm14", 14, 16)
    add_reg(t, "xmm15", 15, 16)
    return t

// "Is this operand a register?" is asked of every x86 operand outside
// brackets and of the terms inside them other than numbers and rip, so
// immediates and labels come through here too. A walk of all 80 entries used
// to make this and range_eq a sixth of a build. With open addressing a
// register is found in about 1.02 probes, and on word.w's own assembly the
// rest miss in about 1.1.
reg_find_r(A, s, a, b)
    t = A[9]
    h = reg_hash_r(s, a, b)
    loop t[h] != 0
        e = t[h]
        if range_eq(s, a, b, e[0])
            return e
        h = (h + 1) & 1023
    return 0

// djb2 over the label's characters, masked to 31 bits every step so it can't
// overflow. The caller folds it into the label table with that table's mask.
lhash(name)
    h = 5381
    i = 0
    loop i < len(name)
        h = ((h << 5) + h + name[i]) & 2147483647
        i = i + 1
    return h

new_asm()
    // A[16] is set when a line can't be assembled or a symbol can't be
    // resolved, and assemble_link_1 then writes no output. (A typo or an
    // unsupported form used to leave the instruction out and exit 0.)
    // A[18] is the relaxation set, 1 at each conditional-branch site that has
    // to use the long form, A[19] counts the sites, and A[20] lists the sites
    // this pass found out of range, which the next pass relaxes. AArch64
    // conditional branches reach +/-1 MB and word.w's own text is bigger than
    // that, so some of them can't be one instruction (see a64_branch).
    A = text(21)
    // The section buffers for .text, .rodata and .data. They start at 64 KB
    // and double as they fill. .bss has no bytes, so A[3] is only its size.
    A[0] = mkbuf(65536)
    A[1] = mkbuf(65536)
    A[2] = mkbuf(65536)
    A[3] = 0
    // The label (A[4]) and relocation (A[5]) lists start small and double
    // (ladd_grow). Pre-reserving them used to cost 3.8 MB of zeros on every
    // assemble. word.w's own x86-64 build has about 39,000 labels and 122,000
    // relocations. A[6] is the current section (0 .text, 1 .rodata, 2 .data,
    // 3 .bss), A[7] the entry symbol (the first .global), A[8] the .equ
    // constants and A[9] the register table.
    A[4] = mklist(8)
    A[5] = mklist(8)
    A[6] = 0
    A[7] = 0
    A[8] = mklist(8)
    A[9] = build_regs()
    // A[12] and A[13]: the operand pool and its next free index. An operand
    // lives only while its instruction is encoded, so it comes from the pool
    // and do_line sets the index back to 0 at every line. Allocating operands
    // from the arena used to cost 22 MB of a 78 MB compile. A[14] is the
    // operand list, reused the same way (only encode calls split_ops, once per
    // instruction). A[15] interns mnemonics.
    A[12] = mklist(8)
    A[13] = 0
    A[14] = mklist(4)
    A[15] = {}
    A[16] = 0
    // A[10]: the label hash, an open-addressing table from a label's name to
    // its entry. It starts at 65,536 slots and def_label doubles it before
    // it's 70% full. (At a fixed size it used to hang `word build` once it
    // filled, on a program of about 16,600 functions.)
    A[10] = text(65536)
    // A[11]: 1 when the output is a Windows PE, 0 otherwise (assemble_link_1
    // sets it). A `syscall` then assembles to `call w_syscall`, the Windows OS
    // shim. The compiler's runtime already calls the shim (emit_syscall), so
    // this only changes hand-written assembly.
    A[11] = 0
    // A[17]: the instruction set (0 = x86-64, 1 = AArch64). The parser, the
    // label and relocation tables and the section buffers are shared. What
    // changes is the encoder, the comment marker (# or //), the padding
    // .align puts in code, how a relocation is patched, and e_machine in the
    // ELF header.
    A[17] = 0
    A[18] = text(1)
    A[19] = 0
    A[20] = mklist(8)
    return A

cur_buf(A)
    s = A[6]
    if s == 0
        return A[0]
    if s == 1
        return A[1]
    return A[2]

cur_off(A)
    if A[6] == 3
        return A[3]
    return blen(cur_buf(A))

def_label(A, name)
    // A label defined twice is an error. find_label stops at the first match,
    // so every reference would go to the first definition, which in the
    // runtime's assembly is a jump into some unrelated routine. Refusing it
    // costs one hash probe per label.
    if find_label(A, name) != 0
        err("wasm: label defined twice: " . name)
        A[16] = 1
        return 0
    e = text(3)
    e[0] = name
    e[1] = A[6]
    e[2] = cur_off(A)
    A[4] = ladd_grow(A[4], e)
    ht = A[10]
    if lcount(A[4]) * 10 > len(ht) * 7
        // Every label so far, this one included, into a table twice the size.
        ht = text(len(ht) * 2)
        i = 0
        loop i < lcount(A[4])
            label_put(ht, lget(A[4], i))
            i = i + 1
        A[10] = ht
        return 0
    label_put(ht, e)

// Insert into a table with at least one free slot, which def_label's 70%
// bound guarantees. The size is a power of two, so a mask folds the hash.
label_put(ht, e)
    mask = len(ht) - 1
    slot = lhash(e[0]) & mask
    loop ht[slot] != 0
        slot = (slot + 1) & mask
    ht[slot] = e

find_label(A, name)
    ht = A[10]
    mask = len(ht) - 1
    slot = lhash(name) & mask
    tries = 0
    loop tries < len(ht)
        e = ht[slot]
        if e == 0
            return 0
        if e[0] == name
            return e
        slot = (slot + 1) & mask
        tries = tries + 1
    return 0

add_reloc(A, name, textoff, addend)
    add_reloc_k(A, name, textoff, addend, 0)

// Kind 0 is x86-64's rel32. AArch64 needs seven more, because the displacement
// lives in a different field in each form (patch_a64 fills them in): 1 is
// b/bl's 26-bit word offset, 2 the 19-bit one of b.<cond> and cbz/cbnz, 3 and
// 4 ADR's and ADRP's 21 bits split across two fields, 5 tbz/tbnz's 14 bits,
// and 6 and 7 a `:lo12:` offset in an add or in a load or store.
add_reloc_k(A, name, textoff, addend, kind)
    return add_reloc_s(A, name, textoff, addend, kind, 0 - 1)

// The same, plus the branch-relaxation site this relocation belongs to (-1 for
// a form that can't be relaxed).
add_reloc_s(A, name, textoff, addend, kind, site)
    r = text(5)
    r[4] = site
    r[0] = name
    r[1] = textoff
    r[2] = addend
    r[3] = kind
    A[5] = ladd_grow(A[5], r)

find_equ_r(A, s, a, b)
    es = A[8]
    i = 0
    loop i < lcount(es)
        e = lget(es, i)
        if range_eq(s, a, b, e[0])
            return e
        i = i + 1
    return 0

emit_rex(buf, w, r, x, b)
    emit_rex_f(buf, w, r, x, b, false)

emit_rex_f(buf, w, r, x, b, force)
    val = 64 | (w * 8) | (r * 4) | (x * 2) | b
    if val != 64 || force
        bput(buf, val)

modrm(md, reg, rm)
    return (md * 64) | ((reg & 7) * 8) | (rm & 7)

scale_ss(sc)
    if sc == 2
        return 1
    if sc == 4
        return 2
    if sc == 8
        return 3
    return 0

sib_byte(sc, idx, base)
    return (scale_ss(sc) * 64) | ((idx & 7) * 8) | (base & 7)

ext(n)
    if n >= 8
        return 1
    return 0

sign8(v)
    if v >= 0 - 128 && v <= 127
        return true
    return false

mem_rexx(m)
    if m[3] >= 8
        return 1
    return 0

mem_rexb(m)
    if m[2] >= 8
        return 1
    return 0

byte_force(o)
    if o[0] == 0 && o[2] == 1 && o[1] >= 4 && o[1] <= 7
        return true
    return false

emit_mem(A, buf, regf, m)
    emit_mem_t(A, buf, regf, m, 0)

emit_mem_t(A, buf, regf, m, trailing)
    if m[1] == 1
        bput(buf, modrm(0, regf, 5))
        // `[rip + 8]` with no label is the displacement as written.
        if m[6] == 0
            bputn(buf, m[5], 4)
            return 0
        add_reloc(A, m[6], blen(buf), m[5] - trailing)
        bputn(buf, 0, 4)
        return 0
    base = m[2]
    index = m[3]
    scale = m[4]
    disp = m[5]
    hb = 0
    if base >= 0
        hb = 1
    hi = 0
    if index >= 0
        hi = 1
    need_sib = 0
    if hi != 0
        need_sib = 1
    if hb != 0 && (base & 7) == 4
        need_sib = 1
    if hb == 0
        need_sib = 1
    modb = 0
    dsz = 0
    if hb == 0
        modb = 0
        dsz = 4
    else if disp == 0 && (base & 7) != 5
        modb = 0
        dsz = 0
    else if sign8(disp)
        modb = 1
        dsz = 1
    else
        modb = 2
        dsz = 4
    if need_sib != 0
        idx = 4
        if hi != 0
            idx = index
        bb = 5
        if hb != 0
            bb = base & 7
        bput(buf, modrm(modb, regf, 4))
        bput(buf, sib_byte(scale, idx, bb))
    else
        bput(buf, modrm(modb, regf, base & 7))
    if dsz > 0
        bputn(buf, disp, dsz)
    return 0

// One operand slot from the pool, which do_line empties at each line. Every
// reader dispatches on o[0] and only touches the fields that kind defines, so a
// reused slot never shows a field from the operand before it.
op_slot(A)
    i = A[13]
    pool = A[12]
    if i >= lcount(pool)
        pool = ladd_grow(pool, text(8))
        A[12] = pool
    A[13] = i + 1
    return lget(pool, i)

mk_reg(A, num, size)
    o = op_slot(A)
    o[0] = 0
    o[1] = num
    o[2] = size
    return o

mk_label(A, name)
    o = op_slot(A)
    o[0] = 3
    o[1] = name
    return o

// An operand that couldn't be read, and why. encode refuses the whole line
// with that reason. (Whatever the parser couldn't read used to become a label
// or a zero, and the line assembled as some other instruction.)
mk_bad(A, why)
    o = op_slot(A)
    o[0] = 4
    o[1] = why
    return o

// Turn an operand already taken from the pool into a refusal.
op_bad(o, why)
    o[0] = 4
    o[1] = why
    return o

// A general register that can address memory: 64 bits, so not eax (which
// needs an address-size prefix) or an xmm register.
addr_reg(r)
    return r != 0 && r[2] == 8

// A memory operand: `[base + index*scale + disp]` or any part of it, or
// `[rip + label + disp]`. Every term is checked: an index takes a scale of 1,
// 2, 4 or 8 and is never rsp, a register can't be subtracted, a label needs
// rip, and the displacement has to fit in 32 bits. Each of these used to
// assemble as something else (`[rbx+rcx*3]` as `[rbx+rcx]`, `[eax]` as
// `[rax]`, `[rbx+label]` as `[rbx]`).
parse_mem(A, s, a, b, size)
    o = op_slot(A)
    o[0] = 2
    o[1] = 0
    o[2] = 0 - 1
    o[3] = 0 - 1
    o[4] = 1
    o[5] = 0
    o[6] = 0
    o[7] = size
    // parse_operand has trimmed the operand, and s[a] is the '['.
    if s[b - 1] != 93 || b - a < 2
        return op_bad(o, "a memory operand is [ ... ] and nothing after it")
    ia = skip_space(s, a + 1, b - 1)
    ib = back_space(s, ia, b - 1)
    if ib <= ia
        return op_bad(o, "empty memory operand")
    // split on '+' and '-', keeping the sign for the term after it
    i = ia
    tokstart = ia
    sign = 1
    first = 1
    loop i <= ib
        c = 0 - 1
        if i < ib
            c = s[i]
        if i == ib || c == 43 || c == 45
            ta = skip_space(s, tokstart, i)
            tb = back_space(s, ta, i)
            if tb > ta
                mem_token(A, o, s, ta, tb, sign)
                if o[0] == 4
                    return o
            else if first == 0 || i == ib
                // `[rax+]`, `[rax+-8]`: a sign with no term after it
                return op_bad(o, "a memory operand has an empty term")
            first = 0
            if c == 45
                sign = 0 - 1
            else
                sign = 1
            tokstart = i + 1
        i = i + 1
    if o[1] == 1 && (o[2] >= 0 || o[3] >= 0)
        return op_bad(o, "rip cannot be used with another register")
    if o[6] != 0 && o[1] == 0
        return op_bad(o, "a label in a memory operand needs rip: [rip+label]")
    if o[5] < 0 - 2147483648 || o[5] > 2147483647
        return op_bad(o, "the displacement does not fit in 32 bits")
    return o

mem_token(A, o, s, a, b, sign)
    if range_eq(s, a, b, "rip")
        if o[1] == 1 || sign < 0
            return op_bad(o, "rip can appear once, added")
        o[1] = 1
        return 0
    // index*scale, or scale*index
    star = indexof_r(s, 42, a, b)
    if star >= 0
        la = a
        lb = back_space(s, a, star)
        ra = skip_space(s, star + 1, b)
        rb = b
        ir = reg_find_r(A, s, la, lb)
        sa = ra
        sb = rb
        if ir == 0
            ir = reg_find_r(A, s, ra, rb)
            sa = la
            sb = lb
        if ir == 0
            return op_bad(o, "a scaled term is register*scale")
        if !addr_reg(ir) || ir[1] == 4
            return op_bad(o, "an index is a 64-bit register other than rsp")
        if o[3] >= 0 || sign < 0
            return op_bad(o, "a memory operand takes one index, added")
        k = mk_bad(A, "")
        if num_parse(s, sa, sb, k) != 1 || (k[1] != 1 && k[1] != 2 && k[1] != 4 && k[1] != 8)
            return op_bad(o, "the scale is 1, 2, 4 or 8")
        o[3] = ir[1]
        o[4] = k[1]
        return 0
    // number -> displacement
    if s[a] == 45 || is_digit(s[a])
        k = mk_bad(A, "")
        if num_parse(s, a, b, k) != 1 || !imm_fits(k, 5)
            return op_bad(o, "the displacement does not fit in 32 bits")
        o[5] = o[5] + sign * k[1]
        return 0
    // register: the first is the base, a second the index with scale 1
    r = reg_find_r(A, s, a, b)
    if r != 0
        if !addr_reg(r)
            return op_bad(o, "a memory operand's registers are 64-bit")
        if sign < 0
            return op_bad(o, "a register cannot be subtracted")
        if o[2] < 0
            o[2] = r[1]
        else if o[3] < 0 && r[1] != 4
            o[3] = r[1]
        else
            return op_bad(o, "a memory operand takes a base and one index")
        return 0
    // an .equ constant, or a label
    eq = find_equ_r(A, s, a, b)
    if eq != 0
        if !imm_fits(eq, 5)
            return op_bad(o, "the displacement does not fit in 32 bits")
        o[5] = o[5] + sign * eq[1]
        return 0
    if !is_label_r(s, a, b)
        return op_bad(o, "not a register, number or label in a memory operand")
    if o[6] != 0 || sign < 0
        return op_bad(o, "a memory operand takes one label, added")
    o[6] = sub(s, a, b)
    return 0

parse_operand(A, s, a, b)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    if b <= a
        return mk_bad(A, "empty operand")
    size = 0
    if range_starts(s, a, b, "byte ptr")
        size = 1
        a = skip_space(s, a + 8, b)
    else if range_starts(s, a, b, "word ptr")
        size = 2
        a = skip_space(s, a + 8, b)
    else if range_starts(s, a, b, "dword ptr")
        size = 4
        a = skip_space(s, a + 9, b)
    else if range_starts(s, a, b, "qword ptr")
        size = 8
        a = skip_space(s, a + 9, b)
    if b > a && s[a] == 91
        return parse_mem(A, s, a, b, size)
    if size != 0
        return mk_bad(A, "a size (byte, word, dword or qword ptr) goes on a memory operand")
    r = reg_find_r(A, s, a, b)
    if r != 0
        return mk_reg(A, r[1], r[2])
    // An immediate. num_parse takes the whole operand as a number or refuses
    // it.
    if s[a] == 45 || is_digit(s[a])
        o = op_slot(A)
        o[0] = 1
        k = num_parse(s, a, b, o)
        if k == 1
            return o
        if k == 2
            return op_bad(o, "the number does not fit in 64 bits")
        return op_bad(o, "not a number")
    // .equ name used as immediate
    eq = find_equ_r(A, s, a, b)
    if eq != 0
        o = op_slot(A)
        o[0] = 1
        o[1] = eq[1]
        o[2] = eq[2]
        o[3] = eq[3]
        return o
    if !is_label_r(s, a, b)
        return mk_bad(A, "not a register, number or label")
    // A label's name outlives the line (a relocation keeps it), so it's copied
    // out of the line. The operand itself is still a pooled slot.
    return mk_label(A, sub(s, a, b))

split_ops(A, s, a, b)
    // The one operand list, reused: only encode calls this, once per
    // instruction, and the operands are dead by the time encode returns.
    lst = A[14]
    lst[0] = 0
    if skip_space(s, a, b) == b
        return lst
    start = a
    i = a
    loop i <= b
        if i == b || s[i] == 44
            lst = ladd_grow(lst, parse_operand(A, s, start, i))
            A[14] = lst
            start = i + 1
        i = i + 1
    return lst

op_kind(o)
    return o[0]

reg_w(o)
    if o[2] == 8
        return 1
    return 0

w_of(sz)
    if sz == 8
        return 1
    return 0

pair(a, b)
    p = text(2)
    p[0] = a
    p[1] = b
    return p

alu_code(mn)
    if mn == "add"
        return pair(1, 0)
    if mn == "or"
        return pair(9, 1)
    if mn == "adc"
        return pair(17, 2)
    if mn == "sbb"
        return pair(25, 3)
    if mn == "and"
        return pair(33, 4)
    if mn == "sub"
        return pair(41, 5)
    if mn == "xor"
        return pair(49, 6)
    if mn == "cmp"
        return pair(57, 7)
    return 0

unary_code(mn)
    if mn == "inc"
        return pair(255, 0)
    if mn == "dec"
        return pair(255, 1)
    if mn == "not"
        return pair(247, 2)
    if mn == "neg"
        return pair(247, 3)
    if mn == "mul"
        return pair(247, 4)
    if mn == "div"
        return pair(247, 6)
    if mn == "idiv"
        return pair(247, 7)
    return 0

jcc_code(mn)
    if mn == "jo"
        return 128
    if mn == "jno"
        return 129
    if mn == "jb" || mn == "jc"
        return 130
    if mn == "jae" || mn == "jnc"
        return 131
    if mn == "je" || mn == "jz"
        return 132
    if mn == "jne" || mn == "jnz"
        return 133
    if mn == "jbe"
        return 134
    if mn == "ja"
        return 135
    if mn == "js"
        return 136
    if mn == "jns"
        return 137
    // The parity pair, which only float code needs: ucomisd sets PF on an
    // unordered (NaN) compare, and float equality has to branch on it.
    if mn == "jp" || mn == "jpe"
        return 138
    if mn == "jnp" || mn == "jpo"
        return 139
    if mn == "jl"
        return 140
    if mn == "jge"
        return 141
    if mn == "jle"
        return 142
    if mn == "jg"
        return 143
    return 0 - 1

setcc_code(mn)
    if mn == "seto"
        return 144
    if mn == "setb" || mn == "setc"
        return 146
    if mn == "setae" || mn == "setnc"
        return 147
    if mn == "sete"
        return 148
    if mn == "setne"
        return 149
    if mn == "seta"
        return 151
    if mn == "sets"
        return 152
    if mn == "setp" || mn == "setpe"
        return 154
    if mn == "setnp" || mn == "setpo"
        return 155
    if mn == "setl"
        return 156
    if mn == "setge"
        return 157
    if mn == "setle"
        return 158
    if mn == "setg"
        return 159
    return 0 - 1

shift_code(mn)
    if mn == "rol"
        return 0
    if mn == "ror"
        return 1
    if mn == "shl"
        return 4
    if mn == "sal"
        return 4
    if mn == "shr"
        return 5
    if mn == "sar"
        return 7
    return 0 - 1

enc_unary(A, buf, opc, dig, o)
    if op_kind(o) == 0
        if o[2] == 1
            emit_rex_f(buf, 0, 0, 0, ext(o[1]), byte_force(o))
            bput(buf, opc - 1)
            bput(buf, modrm(3, dig, o[1] & 7))
            return 0
        pfx16w(buf, o[2])
        emit_rex(buf, w_of(o[2]), 0, 0, ext(o[1]))
        bput(buf, opc)
        bput(buf, modrm(3, dig, o[1] & 7))
        return 0
    sz = o[7]
    if sz == 0
        sz = 8
    if sz == 1
        emit_rex(buf, 0, 0, mem_rexx(o), mem_rexb(o))
        bput(buf, opc - 1)
        emit_mem(A, buf, dig, o)
        return 0
    pfx16w(buf, sz)
    emit_rex(buf, w_of(sz), 0, mem_rexx(o), mem_rexb(o))
    bput(buf, opc)
    emit_mem(A, buf, dig, o)
    return 0

// Emit one SSE2 instruction of the form  [prefix] [REX] 0F <opc> /r, where the
// modrm.reg field is `regnum` and `rmop` is the r/m operand (an xmm/gpr register
// or a memory operand). prefix is 0 for none, else the mandatory prefix byte
// (0x66 / 0xF2 / 0xF3); w is REX.W. The prefix precedes REX, which precedes 0F.
sse_rr(A, buf, prefix, opc, regnum, rmop, w)
    if prefix != 0
        bput(buf, prefix)
    if op_kind(rmop) == 2
        emit_rex(buf, w, ext(regnum), mem_rexx(rmop), mem_rexb(rmop))
        bput(buf, 15)
        bput(buf, opc)
        emit_mem(A, buf, regnum, rmop)
    else
        emit_rex(buf, w, ext(regnum), 0, ext(rmop[1]))
        bput(buf, 15)
        bput(buf, opc)
        bput(buf, modrm(3, regnum, rmop[1] & 7))
    return 0

// Three-byte-opcode SSE: `prefix 0F esc opc /r`, optionally with an imm8. This
// is the shape of AES-NI (0F 38 DC/DD, 0F 3A DF), PCLMULQDQ (0F 3A 44) and
// pshufb (0F 38 00), which the two-byte sse_rr above can't reach.
sse_rr3(A, buf, prefix, esc, opc, regnum, rmop, imm, has_imm)
    if prefix != 0
        bput(buf, prefix)
    if op_kind(rmop) == 2
        emit_rex(buf, 0, ext(regnum), mem_rexx(rmop), mem_rexb(rmop))
        bput(buf, 15)
        bput(buf, esc)
        bput(buf, opc)
        if has_imm == 1
            emit_mem_t(A, buf, regnum, rmop, 1)
            bput(buf, imm & 255)
            return 0
        emit_mem(A, buf, regnum, rmop)
        return 0
    emit_rex(buf, 0, ext(regnum), 0, ext(rmop[1]))
    bput(buf, 15)
    bput(buf, esc)
    bput(buf, opc)
    bput(buf, modrm(3, regnum, rmop[1] & 7))
    if has_imm == 1
        bput(buf, imm & 255)
    return 0

// The shift-by-immediate group (66 0F 72/73 /digit ib): the xmm goes in
// modrm.rm and the opcode extension in modrm.reg.
sse_shift_imm(buf, opc, dig, xreg, imm)
    bput(buf, 102)
    emit_rex(buf, 0, 0, 0, ext(xreg))
    bput(buf, 15)
    bput(buf, opc)
    bput(buf, modrm(3, dig, xreg & 7))
    bput(buf, imm & 255)
    return 0

// Refuse the line: say why, quote it, and make sure no output is written.
enc_refuse(A, why, mn, lin, oa, ob)
    err("wasm: " . why . ": " . mn . " " . sub(lin, oa, ob))
    A[16] = 1
    return 0 - 1

// The operands are ones this instruction takes, but not in a combination the
// encoder has a form for. Everything that falls through a handler ends here
// instead of in an encoding of something else.
enc_form(A, mn, lin, oa, ob)
    return enc_refuse(A, "unsupported operand form", mn, lin, oa, ob)

// Two general registers, or a register and a memory operand, have to agree
// on size (`mov eax, rbx` used to assemble as `mov eax, ebx`). If either is
// an xmm register, the line is refused as an unsupported form instead.
enc_sizes(A, a, b, mn, lin, oa, ob)
    if a[2] == 16 || b[2] == 16
        return enc_form(A, mn, lin, oa, ob)
    return enc_refuse(A, "operand sizes differ", mn, lin, oa, ob)

enc_wide(A, mn, lin, oa, ob)
    return enc_refuse(A, "the immediate does not fit", mn, lin, oa, ob)

enc_ambiguous(A, mn, lin, oa, ob)
    return enc_refuse(A, "the operand size is ambiguous (say byte, word, dword or qword ptr)", mn, lin, oa, ob)

// A memory operand whose stated size, if any, is `sz`.
mem_of(o, sz)
    return o[0] == 2 && (o[7] == 0 || o[7] == sz)

is_xmm(o)
    return o[0] == 0 && o[2] == 16

is_r64(o)
    return o[0] == 0 && o[2] == 8

// The immediate field an operation on `sz` bytes takes: the same width,
// except that a 64-bit operation takes a sign-extended 32-bit field
// (imm_fits's 5).
imm_field(sz)
    if sz == 8
        return 5
    return sz

// The SSE2 the float code and the runtime emit, plus AES-NI, PCLMULQDQ and
// pshufb. Nothing the compiler emits uses those three any more: the TLS record
// layer is word source and can't reach them (docs/SECURITY.md §5), so only
// test_encoder_vs_as's corpus exercises them. The first operand goes in
// modrm.reg, except in the store forms of movsd, movdqu, movdqa and movq,
// which pick their opcode by which side is the xmm. Answers 1 for an SSE
// mnemonic, encoded or refused, and 0 for any other. The operands are checked
// first: these handlers read a register number out of whatever operand
// they're given, so `addsd xmm0, rax` used to assemble as `addsd xmm0, xmm0`.
encode_sse(A, buf, mnr, ops, lin, oa, ob)
    mn = mnr[0]
    a = lget(ops, 0)
    b = lget(ops, 1)
    if mn == "addsd" || mn == "subsd" || mn == "mulsd" || mn == "divsd" || mn == "sqrtsd" || mn == "ucomisd"
        if !is_xmm(a) || !(is_xmm(b) || mem_of(b, 8))
            enc_form(A, mn, lin, oa, ob)
            return 1
        if mn == "addsd"
            sse_rr(A, buf, 242, 88, a[1], b, 0)
        else if mn == "subsd"
            sse_rr(A, buf, 242, 92, a[1], b, 0)
        else if mn == "mulsd"
            sse_rr(A, buf, 242, 89, a[1], b, 0)
        else if mn == "divsd"
            sse_rr(A, buf, 242, 94, a[1], b, 0)
        else if mn == "sqrtsd"
            sse_rr(A, buf, 242, 81, a[1], b, 0)
        else
            sse_rr(A, buf, 102, 46, a[1], b, 0)
        return 1
    // movsd xmm, m64 (F2 0F 10 /r), the load half of MOVSD. A raw double in a
    // stack slot or the literal pool goes straight into an xmm register with it,
    // instead of through rax as a `mov` and a `movq`.
    if mn == "movsd"
        if is_xmm(a) && (is_xmm(b) || mem_of(b, 8))
            // movsd xmm, xmm/m64 (F2 0F 10 /r): the xmm is modrm.reg
            sse_rr(A, buf, 242, 16, a[1], b, 0)
            return 1
        if mem_of(a, 8) && is_xmm(b)
            // movsd m64, xmm (F2 0F 11 /r), the store half: the xmm is still
            // modrm.reg, and the memory operand is the rm.
            sse_rr(A, buf, 242, 17, b[1], a, 0)
            return 1
        enc_form(A, mn, lin, oa, ob)
        return 1
    // movapd xmm, xmm (66 0F 28 /r): the register-to-register copy of a raw
    // double. Unlike movsd's register form it writes the whole register, so it
    // does not wait on the destination's last writer (see fmov_from). Only the
    // register form: the memory form wants 16-byte alignment no frame slot has.
    if mn == "movapd"
        if is_xmm(a) && is_xmm(b)
            sse_rr(A, buf, 102, 40, a[1], b, 0)
            return 1
        enc_form(A, mn, lin, oa, ob)
        return 1
    if mn == "cvtsi2sd"
        if !is_xmm(a) || !(is_r64(b) || mem_of(b, 8))
            enc_form(A, mn, lin, oa, ob)
            return 1
        sse_rr(A, buf, 242, 42, a[1], b, 1)
        return 1
    // pxor (66 0F EF /r) is only emitted as `pxor x, x`, the zeroing idiom
    // that comes before every cvtsi2sd (see gen_float_leaf). These and the
    // AES-NI forms take a 16-byte memory operand, which is never written with a
    // size.
    if mn == "pxor" || mn == "pand" || mn == "por" || mn == "punpcklqdq" || mn == "aesenc" || mn == "aesenclast" || mn == "pshufb"
        if !is_xmm(a) || !(is_xmm(b) || mem_of(b, 0))
            enc_form(A, mn, lin, oa, ob)
            return 1
        if mn == "pxor"
            sse_rr(A, buf, 102, 239, a[1], b, 0)
        else if mn == "pand"
            sse_rr(A, buf, 102, 219, a[1], b, 0)
        else if mn == "por"
            sse_rr(A, buf, 102, 235, a[1], b, 0)
        else if mn == "punpcklqdq"
            sse_rr(A, buf, 102, 108, a[1], b, 0)
        // ---- AES-NI (66 0F 38 DC/DD) and pshufb (66 0F 38 00) ----
        else if mn == "aesenc"
            sse_rr3(A, buf, 102, 56, 220, a[1], b, 0, 0)
        else if mn == "aesenclast"
            sse_rr3(A, buf, 102, 56, 221, a[1], b, 0, 0)
        else
            sse_rr3(A, buf, 102, 56, 0, a[1], b, 0, 0)
        return 1
    // movdqu and movdqa: the opcode says which side is the memory operand, as
    // it does for movsd above.
    if mn == "movdqu" || mn == "movdqa"
        p = 243
        if mn == "movdqa"
            p = 102
        if is_xmm(a) && (is_xmm(b) || mem_of(b, 0))
            sse_rr(A, buf, p, 111, a[1], b, 0)
            return 1
        if mem_of(a, 0) && is_xmm(b)
            sse_rr(A, buf, p, 127, b[1], a, 0)
            return 1
        enc_form(A, mn, lin, oa, ob)
        return 1
    return encode_sse_imm(A, buf, mnr, ops, lin, oa, ob)

// The SSE forms that carry an imm8, and the two that move between an xmm and
// a general register (cvttsd2si and movq). Split out so encode_sse stays a
// flat chain of two-operand cases.
encode_sse_imm(A, buf, mnr, ops, lin, oa, ob)
    mn = mnr[0]
    a = lget(ops, 0)
    b = lget(ops, 1)
    if mn == "aeskeygenassist" || mn == "pclmulqdq"
        c = lget(ops, 2)
        if !is_xmm(a) || !(is_xmm(b) || mem_of(b, 0)) || c[0] != 1
            enc_form(A, mn, lin, oa, ob)
            return 1
        if !imm_fits(c, 1)
            enc_wide(A, mn, lin, oa, ob)
            return 1
        if mn == "aeskeygenassist"
            sse_rr3(A, buf, 102, 58, 223, a[1], b, c[1], 1)
        else
            sse_rr3(A, buf, 102, 58, 68, a[1], b, c[1], 1)
        return 1
    if mn == "pshufd"
        c = lget(ops, 2)
        if !is_xmm(a) || !is_xmm(b) || c[0] != 1
            enc_form(A, mn, lin, oa, ob)
            return 1
        if !imm_fits(c, 1)
            enc_wide(A, mn, lin, oa, ob)
            return 1
        bput(buf, 102)
        emit_rex(buf, 0, ext(a[1]), 0, ext(b[1]))
        bput(buf, 15)
        bput(buf, 112)
        bput(buf, modrm(3, a[1], b[1] & 7))
        bput(buf, c[1] & 255)
        return 1
    op = 0 - 1
    dig = 0
    if mn == "pslldq"
        op = 115
        dig = 7
    else if mn == "psrldq"
        op = 115
        dig = 3
    else if mn == "psllq"
        op = 115
        dig = 6
    else if mn == "psrlq"
        op = 115
        dig = 2
    else if mn == "pslld"
        op = 114
        dig = 6
    else if mn == "psrld"
        op = 114
        dig = 2
    if op >= 0
        if !is_xmm(a) || b[0] != 1
            enc_form(A, mn, lin, oa, ob)
            return 1
        if !imm_fits(b, 1)
            enc_wide(A, mn, lin, oa, ob)
            return 1
        sse_shift_imm(buf, op, dig, a[1], b[1])
        return 1
    if mn == "cvttsd2si"
        if !is_r64(a) || !(is_xmm(b) || mem_of(b, 8))
            enc_form(A, mn, lin, oa, ob)
            return 1
        sse_rr(A, buf, 242, 44, a[1], b, 1)
        return 1
    if mn == "movq"
        if is_xmm(a) && is_xmm(b)
            // movq xmm, xmm  (F3 0F 7E /r): reg = dest, rm = source
            sse_rr(A, buf, 243, 126, a[1], b, 0)
        else if is_xmm(a) && (is_r64(b) || mem_of(b, 8))
            // movq xmm, r/m64  (66 REX.W 0F 6E /r): xmm is reg, the other is rm
            sse_rr(A, buf, 102, 110, a[1], b, 1)
        else if (is_r64(a) || mem_of(a, 8)) && is_xmm(b)
            // movq r/m64, xmm  (66 REX.W 0F 7E /r): xmm is reg, the other is rm
            sse_rr(A, buf, 102, 126, b[1], a, 1)
        else
            enc_form(A, mn, lin, oa, ob)
        return 1
    return 0

// Is there a 16-bit register operand anywhere in the list? x86 has no REX bit
// for 16-bit operands: the 0x66 operand-size prefix is all that tells
// `mov [rdi], ax` from `mov [rdi], eax`. Leaving it out still assembles, as
// the 32-bit form, which moves four bytes where two were asked for.
reg16_in(ops)
    i = 0
    loop i < lcount(ops)
        o = lget(ops, i)
        if op_kind(o) == 0 && o[2] == 2
            return true
        i = i + 1
    return false

pfx16(buf, ops)
    if reg16_in(ops)
        bput(buf, 102)
    return 0

// The same prefix, from a width instead of a scan of the operand list. A
// memory operand keeps its width in o[7], which reg16_in doesn't look at (it
// only checks registers), and the destination's width is the one that decides
// the encoding.
pfx16w(buf, sz)
    if sz == 2
        bput(buf, 102)
    return 0

// Encode one x86-64 instruction. `mnr` is the interned mnemonic record and the
// operand text is lin[oa..ob), a range into the line. Every form below checks
// its operands before it emits a byte: kinds, sizes, and that an immediate fits
// its field. A form the encoder has no encoding for is refused (enc_form)
// instead of encoded as the nearest one it has.
encode(A, mnr, lin, oa, ob)
    mn = mnr[0]
    buf = A[0]
    ops = split_ops(A, lin, oa, ob)
    n = lcount(ops)
    if n < mnr[6]
        err("wasm: missing operand: " . mn . " " . sub(lin, oa, ob))
        A[16] = 1
        return 0 - 1
    // A mnemonic no handler takes (max_ops says 99) is reported as that before
    // anything is said about its operands.
    if mnr[7] == 99
        return enc_refuse(A, "unhandled", mn, lin, oa, ob)
    // More operands than the instruction takes is an error (`add rax, rbx, rcx`
    // used to assemble as `add rax, rbx`).
    if n > mnr[7]
        return enc_refuse(A, "too many operands", mn, lin, oa, ob)
    // An operand the parser couldn't read says why here.
    i = 0
    loop i < n
        o = lget(ops, i)
        if o[0] == 4
            return enc_refuse(A, o[1], mn, lin, oa, ob)
        i = i + 1
    if n >= 2 && mnr[8] == 1 && encode_sse(A, buf, mnr, ops, lin, oa, ob) == 1
        if A[16] == 1
            return 0 - 1
        return 0
    // A handler that doesn't emit the 0x66 prefix would encode a 16-bit
    // operand as its 32-bit form, which is worse than refusing. So a 16-bit
    // register is only taken by the handlers that do emit it: mov and test
    // below, the ALU family (mnr[5]), the shifts (mnr[4]), the unary group
    // (mnr[3], through enc_unary), imul, and push and pop.
    if reg16_in(ops)
        if mn != "mov" && mn != "test" && mn != "imul" && mn != "push" && mn != "pop"
            if mnr[5] == 0 && mnr[4] < 0 && mnr[3] == 0
                err("wasm: 16-bit operand not supported for: " . mn . " " . sub(lin, oa, ob))
                A[16] = 1
                return 0 - 1
    // The branches below are ordered by how often each mnemonic appears instead
    // of by family, because this chain is walked once per instruction and each
    // miss is a text compare. In word.w's own x86-64 build (about 340,000
    // instructions) mov is a third of them, then come call, movabs, cmp, jmp,
    // test and push, and the conditional jumps are 12% between them. That makes
    // the walk about 3.3 compares per instruction. (An instruction with two or
    // more operands has already been through encode_sse's compares, almost 30
    // of them for a mnemonic that isn't SSE.) The families (jcc, setcc, unary,
    // shift, alu) are single field reads off the interned record, so where they
    // sit costs only the compare that skips them. An integer opcode class on
    // the record would save little here and would be one more table to keep in
    // step with every branch.
    //
    // Each branch keys on an exact mnemonic and returns, so the order only
    // changes the cost: no mnemonic is claimed by two branches, and one that
    // none claims falls through to the error at the bottom.

    // mov
    if mn == "mov"
        a = lget(ops, 0)
        b = lget(ops, 1)
        if op_kind(a) == 0 && op_kind(b) == 0
            if a[2] != b[2] || a[2] == 16
                return enc_sizes(A, a, b, mn, lin, oa, ob)
            if a[2] == 1
                emit_rex_f(buf, 0, ext(b[1]), 0, ext(a[1]), byte_force(a) || byte_force(b))
                bput(buf, 136)
                bput(buf, modrm(3, b[1], a[1] & 7))
                return 0
            pfx16(buf, ops)
            emit_rex(buf, reg_w(a), ext(b[1]), 0, ext(a[1]))
            bput(buf, 137)
            bput(buf, modrm(3, b[1], a[1] & 7))
            return 0
        if op_kind(a) == 0 && op_kind(b) == 1
            if a[2] == 16
                return enc_form(A, mn, lin, oa, ob)
            if !imm_fits(b, a[2])
                return enc_wide(A, mn, lin, oa, ob)
            if a[2] == 1
                emit_rex_f(buf, 0, 0, 0, ext(a[1]), byte_force(a))
                bput(buf, 176 + (a[1] & 7))
                bput(buf, b[1] & 255)
                return 0
            if a[2] == 2
                bput(buf, 102)
                emit_rex(buf, 0, 0, 0, ext(a[1]))
                bput(buf, 184 + (a[1] & 7))
                bputn(buf, b[1], 2)
                return 0
            if a[2] == 8
                // An immediate outside the sign-extended imm32 range needs the
                // movabs encoding (REX.W B8+r imm64), because the C7 /0 form
                // below keeps only the low four bytes. It's written from the
                // operand's two halves, since the value can be wider than one
                // of word's own integers.
                if !imm_fits(b, 5)
                    emit_rex(buf, 1, 0, 0, ext(a[1]))
                    bput(buf, 184 + (a[1] & 7))
                    emit4le(buf, b[2])
                    emit4le(buf, b[3])
                    return 0
            emit_rex(buf, reg_w(a), 0, 0, ext(a[1]))
            bput(buf, 199)
            bput(buf, modrm(3, 0, a[1] & 7))
            bputn(buf, b[1], 4)
            return 0
        if op_kind(a) == 0 && op_kind(b) == 2
            if a[2] == 16 || !mem_of(b, a[2])
                return enc_sizes(A, a, a, mn, lin, oa, ob)
            op = 139
            if a[2] == 1
                op = 138
            pfx16(buf, ops)
            emit_rex_f(buf, reg_w(a), ext(a[1]), mem_rexx(b), mem_rexb(b), byte_force(a))
            bput(buf, op)
            emit_mem(A, buf, a[1], b)
            return 0
        if op_kind(a) == 2 && op_kind(b) == 0
            if b[2] == 16 || !mem_of(a, b[2])
                return enc_sizes(A, b, b, mn, lin, oa, ob)
            op = 137
            if b[2] == 1
                op = 136
            pfx16(buf, ops)
            emit_rex_f(buf, reg_w(b), ext(b[1]), mem_rexx(a), mem_rexb(a), byte_force(b))
            bput(buf, op)
            emit_mem(A, buf, b[1], a)
            return 0
        if op_kind(a) == 2 && op_kind(b) == 1
            sz = a[7]
            if sz == 0
                return enc_ambiguous(A, mn, lin, oa, ob)
            if !imm_fits(b, imm_field(sz))
                return enc_wide(A, mn, lin, oa, ob)
            imm = b[1]
            if sz == 1
                emit_rex(buf, 0, 0, mem_rexx(a), mem_rexb(a))
                bput(buf, 198)
                emit_mem_t(A, buf, 0, a, 1)
                bput(buf, imm & 255)
                return 0
            if sz == 2
                bput(buf, 102)
                emit_rex(buf, 0, 0, mem_rexx(a), mem_rexb(a))
                bput(buf, 199)
                emit_mem_t(A, buf, 0, a, 2)
                bputn(buf, imm, 2)
                return 0
            emit_rex(buf, w_of(sz), 0, mem_rexx(a), mem_rexb(a))
            bput(buf, 199)
            emit_mem_t(A, buf, 0, a, 4)
            bputn(buf, imm, 4)
            return 0
        return enc_form(A, mn, lin, oa, ob)

    // ALU family
    al = mnr[5]
    if al != 0
        opc = al[0]
        dig = al[1]
        a = lget(ops, 0)
        b = lget(ops, 1)
        if op_kind(a) == 0 && op_kind(b) == 0
            if a[2] != b[2] || a[2] == 16
                return enc_sizes(A, a, b, mn, lin, oa, ob)
            if a[2] == 1
                emit_rex_f(buf, 0, ext(b[1]), 0, ext(a[1]), byte_force(a) || byte_force(b))
                bput(buf, opc - 1)
                bput(buf, modrm(3, b[1], a[1] & 7))
                return 0
            pfx16(buf, ops)
            emit_rex(buf, reg_w(a), ext(b[1]), 0, ext(a[1]))
            bput(buf, opc)
            bput(buf, modrm(3, b[1], a[1] & 7))
            return 0
        if op_kind(a) == 0 && op_kind(b) == 1
            sz = a[2]
            if sz == 16
                return enc_form(A, mn, lin, oa, ob)
            // A 64-bit operation sign-extends its 32-bit immediate, so
            // `and rax, 0x80000000` doesn't fit and is refused (it would be an
            // AND with 0xffffffff80000000).
            if !imm_fits(b, imm_field(sz))
                return enc_wide(A, mn, lin, oa, ob)
            imm = b[1]
            r = a[1]
            if sz == 1
                if r == 0
                    bput(buf, opc + 3)
                    bput(buf, imm & 255)
                    return 0
                emit_rex_f(buf, 0, 0, 0, ext(r), byte_force(a))
                bput(buf, 128)
                bput(buf, modrm(3, dig, r & 7))
                bput(buf, imm & 255)
                return 0
            iw = 4
            if sz == 2
                iw = 2
            if sign8(imm)
                pfx16(buf, ops)
                emit_rex(buf, reg_w(a), 0, 0, ext(r))
                bput(buf, 131)
                bput(buf, modrm(3, dig, r & 7))
                bput(buf, imm & 255)
                return 0
            if r == 0
                pfx16(buf, ops)
                emit_rex(buf, reg_w(a), 0, 0, 0)
                bput(buf, opc + 4)
                bputn(buf, imm, iw)
                return 0
            pfx16(buf, ops)
            emit_rex(buf, reg_w(a), 0, 0, ext(r))
            bput(buf, 129)
            bput(buf, modrm(3, dig, r & 7))
            bputn(buf, imm, iw)
            return 0
        if op_kind(a) == 0 && op_kind(b) == 2
            if a[2] == 16 || !mem_of(b, a[2])
                return enc_sizes(A, a, a, mn, lin, oa, ob)
            op = opc + 2
            if a[2] == 1
                op = opc + 1
            pfx16(buf, ops)
            emit_rex_f(buf, reg_w(a), ext(a[1]), mem_rexx(b), mem_rexb(b), byte_force(a))
            bput(buf, op)
            emit_mem(A, buf, a[1], b)
            return 0
        if op_kind(a) == 2 && op_kind(b) == 0
            if b[2] == 16 || !mem_of(a, b[2])
                return enc_sizes(A, b, b, mn, lin, oa, ob)
            op = opc
            if b[2] == 1
                op = opc - 1
            pfx16(buf, ops)
            emit_rex_f(buf, reg_w(b), ext(b[1]), mem_rexx(a), mem_rexb(a), byte_force(b))
            bput(buf, op)
            emit_mem(A, buf, b[1], a)
            return 0
        if op_kind(a) == 2 && op_kind(b) == 1
            sz = a[7]
            if sz == 0
                return enc_ambiguous(A, mn, lin, oa, ob)
            if !imm_fits(b, imm_field(sz))
                return enc_wide(A, mn, lin, oa, ob)
            imm = b[1]
            if sz == 1
                emit_rex(buf, 0, 0, mem_rexx(a), mem_rexb(a))
                bput(buf, 128)
                emit_mem_t(A, buf, dig, a, 1)
                bput(buf, imm & 255)
                return 0
            // The width is the memory operand's: 0x66 and an imm16 for word,
            // REX.W for qword. (It used to write REX.W every time, so
            // `add dword ptr [rax], 1` was a qword add.)
            iw = 4
            if sz == 2
                iw = 2
            pfx16w(buf, sz)
            emit_rex(buf, w_of(sz), 0, mem_rexx(a), mem_rexb(a))
            if sign8(imm)
                bput(buf, 131)
                emit_mem_t(A, buf, dig, a, 1)
                bput(buf, imm & 255)
                return 0
            bput(buf, 129)
            emit_mem_t(A, buf, dig, a, iw)
            bputn(buf, imm, iw)
            return 0
        return enc_form(A, mn, lin, oa, ob)

    // call / jmp: a label (rel32), a 64-bit register, or a qword in memory
    if mn == "call" || mn == "jmp"
        o = lget(ops, 0)
        if op_kind(o) == 3
            opc = 233
            if mn == "call"
                opc = 232
            bput(buf, opc)
            add_reloc(A, o[1], blen(buf), 0)
            bputn(buf, 0, 4)
            return 0
        if is_r64(o)
            dig = 4
            if mn == "call"
                dig = 2
            emit_rex(buf, 0, 0, 0, ext(o[1]))
            bput(buf, 255)
            bput(buf, modrm(3, dig, o[1] & 7))
            return 0
        if mem_of(o, 8)
            digm = 4
            if mn == "call"
                digm = 2
            emit_rex(buf, 0, 0, mem_rexx(o), mem_rexb(o))
            bput(buf, 255)
            emit_mem(A, buf, digm, o)
            return 0
        return enc_form(A, mn, lin, oa, ob)

    // movabs r64, imm64, from the operand's two halves, since the value may be
    // wider than one of word's integers
    if mn == "movabs"
        d = lget(ops, 0)
        v = lget(ops, 1)
        if !is_r64(d) || op_kind(v) != 1
            return enc_form(A, mn, lin, oa, ob)
        emit_rex(buf, 1, 0, 0, ext(d[1]))
        bput(buf, 184 + (d[1] & 7))
        emit4le(buf, v[2])
        emit4le(buf, v[3])
        return 0

    // jcc: to a label
    cc = mnr[1]
    if cc >= 0
        t = lget(ops, 0)
        if op_kind(t) != 3
            return enc_form(A, mn, lin, oa, ob)
        bput(buf, 15)
        bput(buf, cc)
        add_reloc(A, t[1], blen(buf), 0)
        bputn(buf, 0, 4)
        return 0

    // push and pop take a 64-bit or 16-bit register. There's no 32-bit form in
    // 64-bit mode, so `push eax` is refused (it used to assemble as `push rax`).
    if mn == "push" || mn == "pop"
        r = lget(ops, 0)
        if op_kind(r) != 0 || (r[2] != 8 && r[2] != 2)
            return enc_form(A, mn, lin, oa, ob)
        pfx16w(buf, r[2])
        emit_rex(buf, 0, 0, 0, ext(r[1]))
        if mn == "push"
            bput(buf, 80 + (r[1] & 7))
        else
            bput(buf, 88 + (r[1] & 7))
        return 0

    // shifts, of a register or memory, by cl, 1 or an imm8
    sd = mnr[4]
    if sd >= 0
        d = lget(ops, 0)
        s = lget(ops, 1)
        // The count is cl or an imm8. Any other register is refused (it used to
        // be written into the imm8 as its register number).
        if op_kind(s) == 0
            if s[1] != 1 || s[2] != 1
                return enc_refuse(A, "a shift count is cl or a number", mn, lin, oa, ob)
        else if op_kind(s) == 1
            if !imm_fits(s, 1)
                return enc_wide(A, mn, lin, oa, ob)
        else
            return enc_refuse(A, "a shift count is cl or a number", mn, lin, oa, ob)
        // D1 shifts by one, D3 by cl and C1 by an imm8, and each byte form is
        // the opcode one below. The destination's width decides which of the
        // pair to use. (Reading it off the wrong operand once made
        // `shl byte ptr [rax], 1` assemble as `shl eax, 1`.)
        opc = 193
        if op_kind(s) == 0
            opc = 211
        else if s[1] == 1
            opc = 209
        if op_kind(d) == 0
            if d[2] == 16
                return enc_form(A, mn, lin, oa, ob)
            r = d[1]
            if d[2] == 1
                // byte_force is what makes `rol dil, 1` legal: spl/bpl/sil/dil
                // need a REX byte to name them at all.
                emit_rex_f(buf, 0, 0, 0, ext(r), byte_force(d))
                bput(buf, opc - 1)
            else
                pfx16w(buf, d[2])
                emit_rex(buf, reg_w(d), 0, 0, ext(r))
                bput(buf, opc)
            bput(buf, modrm(3, sd, r & 7))
            if opc == 193
                bput(buf, s[1] & 255)
            return 0
        if op_kind(d) != 2
            return enc_form(A, mn, lin, oa, ob)
        sz = d[7]
        if sz == 0
            return enc_ambiguous(A, mn, lin, oa, ob)
        pfx16w(buf, sz)
        if sz == 1
            emit_rex(buf, 0, 0, mem_rexx(d), mem_rexb(d))
            bput(buf, opc - 1)
        else
            emit_rex(buf, w_of(sz), 0, mem_rexx(d), mem_rexb(d))
            bput(buf, opc)
        if opc == 193
            emit_mem_t(A, buf, sd, d, 1)
            bput(buf, s[1] & 255)
            return 0
        emit_mem(A, buf, sd, d)
        return 0

    // test
    if mn == "test"
        a = lget(ops, 0)
        b = lget(ops, 1)
        if op_kind(a) == 0 && op_kind(b) == 0
            if a[2] != b[2] || a[2] == 16
                return enc_sizes(A, a, b, mn, lin, oa, ob)
            if a[2] == 1
                emit_rex_f(buf, 0, ext(b[1]), 0, ext(a[1]), byte_force(a) || byte_force(b))
                bput(buf, 132)
                bput(buf, modrm(3, b[1], a[1] & 7))
                return 0
            pfx16(buf, ops)
            emit_rex(buf, reg_w(a), ext(b[1]), 0, ext(a[1]))
            bput(buf, 133)
            bput(buf, modrm(3, b[1], a[1] & 7))
            return 0
        if op_kind(a) == 0 && op_kind(b) == 1
            if a[2] == 16
                return enc_form(A, mn, lin, oa, ob)
            if !imm_fits(b, imm_field(a[2]))
                return enc_wide(A, mn, lin, oa, ob)
            r = a[1]
            imm = b[1]
            if a[2] == 1
                if r == 0
                    bput(buf, 168)
                    bput(buf, imm & 255)
                    return 0
                emit_rex_f(buf, 0, 0, 0, ext(r), byte_force(a))
                bput(buf, 246)
                bput(buf, modrm(3, 0, r & 7))
                bput(buf, imm & 255)
                return 0
            tw = 4
            if a[2] == 2
                tw = 2
            if r == 0
                pfx16(buf, ops)
                emit_rex(buf, reg_w(a), 0, 0, 0)
                bput(buf, 169)
                bputn(buf, imm, tw)
                return 0
            pfx16(buf, ops)
            emit_rex(buf, reg_w(a), 0, 0, ext(r))
            bput(buf, 247)
            bput(buf, modrm(3, 0, r & 7))
            bputn(buf, imm, tw)
            return 0
        // test m, r: 84 /r for a byte, 85 /r otherwise. The flags don't depend
        // on the order, so there's one encoding, but only this spelling is
        // taken: `test r, m` is refused as an unsupported form.
        if op_kind(a) == 2 && op_kind(b) == 0
            if b[2] == 16 || !mem_of(a, b[2])
                return enc_sizes(A, b, b, mn, lin, oa, ob)
            op = 133
            if b[2] == 1
                op = 132
            pfx16(buf, ops)
            emit_rex_f(buf, reg_w(b), ext(b[1]), mem_rexx(a), mem_rexb(a), byte_force(b))
            bput(buf, op)
            emit_mem(A, buf, b[1], a)
            return 0
        // test m, imm: F6 /0 ib, or F7 /0 iw/id. Unlike the ALU group, `test`
        // has no sign-extended imm8 form like 0x83, so a small immediate against
        // a 64-bit operand still takes four bytes. It's still one instruction
        // where a load and a register test would be two, and the runtime's
        // flag checks (`test qword ptr [r12 - 16], 1` and the like) use it.
        if op_kind(a) == 2 && op_kind(b) == 1
            sz = a[7]
            if sz == 0
                return enc_ambiguous(A, mn, lin, oa, ob)
            if !imm_fits(b, imm_field(sz))
                return enc_wide(A, mn, lin, oa, ob)
            imm = b[1]
            if sz == 1
                emit_rex(buf, 0, 0, mem_rexx(a), mem_rexb(a))
                bput(buf, 246)
                emit_mem_t(A, buf, 0, a, 1)
                bput(buf, imm & 255)
                return 0
            // The memory operand's width again: 0x66 and an imm16 for word,
            // REX.W for qword. (It used to write REX.W and four bytes every
            // time, so `test word ptr [rax], 1` was a qword test.)
            tw = 4
            if sz == 2
                tw = 2
            pfx16w(buf, sz)
            emit_rex(buf, w_of(sz), 0, mem_rexx(a), mem_rexb(a))
            bput(buf, 247)
            emit_mem_t(A, buf, 0, a, tw)
            bputn(buf, imm, tw)
            return 0
        return enc_form(A, mn, lin, oa, ob)

    // lea r64, m, and nothing else: a 32-bit destination or a register as the
    // source is refused (a register source used to be read as an empty memory
    // operand).
    if mn == "lea"
        d = lget(ops, 0)
        m = lget(ops, 1)
        if !is_r64(d) || !mem_of(m, 8)
            return enc_form(A, mn, lin, oa, ob)
        emit_rex(buf, 1, ext(d[1]), mem_rexx(m), mem_rexb(m))
        bput(buf, 141)
        emit_mem(A, buf, d[1], m)
        return 0

    // movzx and movsx into r32 or r64, from r8, m8 or m16. Any other source is
    // refused (`movzx rax, rbx` used to assemble as `movzx rax, bl`).
    if mn == "movzx" || mn == "movsx"
        d = lget(ops, 0)
        s = lget(ops, 1)
        if op_kind(d) != 0 || (d[2] != 4 && d[2] != 8)
            return enc_form(A, mn, lin, oa, ob)
        dr = d[1]
        w = reg_w(d)
        base2 = 182
        if mn == "movsx"
            base2 = 190
        if op_kind(s) == 0
            if s[2] != 1
                return enc_form(A, mn, lin, oa, ob)
            emit_rex_f(buf, w, ext(dr), 0, ext(s[1]), byte_force(s))
            bput(buf, 15)
            bput(buf, base2)
            bput(buf, modrm(3, dr, s[1] & 7))
            return 0
        if op_kind(s) != 2
            return enc_form(A, mn, lin, oa, ob)
        msz = s[7]
        if msz == 0
            return enc_ambiguous(A, mn, lin, oa, ob)
        if msz != 1 && msz != 2
            return enc_form(A, mn, lin, oa, ob)
        op2 = base2
        if msz == 2
            op2 = base2 + 1
        emit_rex(buf, w, ext(dr), mem_rexx(s), mem_rexb(s))
        bput(buf, 15)
        bput(buf, op2)
        emit_mem(A, buf, dr, s)
        return 0

    // no operands (max_ops holds each of these to none)
    if mn == "cpuid"
        bput(buf, 15)
        bput(buf, 162)
        return 0
    if mn == "syscall"
        if A[11] == 1
            // A Windows target: a raw `syscall` means nothing on Windows, so
            // this is a call rel32 to the w_syscall shim instead, the same
            // thing emit_syscall writes for the compiler's own runtime. It only
            // matters for hand-written assembly given to `word asm -win`, which
            // then needs a w_syscall of its own.
            bput(buf, 232)
            add_reloc(A, "w_syscall", blen(buf), 0)
            bputn(buf, 0, 4)
            return 0
        bput(buf, 15)
        bput(buf, 5)
        return 0
    if mn == "cdqe"
        bput(buf, 72)
        bput(buf, 152)
        return 0
    // ret, or `ret imm16` (C2 iw), which pops that many bytes more
    if mn == "ret"
        if n == 1
            v = lget(ops, 0)
            if op_kind(v) != 1
                return enc_form(A, mn, lin, oa, ob)
            if !imm_fits(v, 2)
                return enc_wide(A, mn, lin, oa, ob)
            bput(buf, 194)
            bputn(buf, v[1], 2)
            return 0
        bput(buf, 195)
        return 0
    if mn == "leave"
        bput(buf, 201)
        return 0
    if mn == "cld"
        bput(buf, 252)
        return 0
    if mn == "clc"
        bput(buf, 248)
        return 0
    if mn == "nop"
        bput(buf, 144)
        return 0
    if mn == "cqo"
        bput(buf, 72)
        bput(buf, 153)
        return 0
    if mn == "movsb"
        bput(buf, 164)
        return 0
    if mn == "stosb"
        bput(buf, 170)
        return 0
    if mn == "movsq"
        bput(buf, 72)
        bput(buf, 165)
        return 0
    if mn == "stosq"
        bput(buf, 72)
        bput(buf, 171)
        return 0

    // setcc r8/m8. A wider register is refused (`sete eax` used to assemble
    // as `sete al`).
    sc = mnr[2]
    if sc >= 0
        o = lget(ops, 0)
        if op_kind(o) == 0 && o[2] == 1
            emit_rex_f(buf, 0, 0, 0, ext(o[1]), byte_force(o))
            bput(buf, 15)
            bput(buf, sc)
            bput(buf, modrm(3, 0, o[1] & 7))
            return 0
        if !mem_of(o, 1)
            return enc_form(A, mn, lin, oa, ob)
        emit_rex(buf, 0, 0, mem_rexx(o), mem_rexb(o))
        bput(buf, 15)
        bput(buf, sc)
        emit_mem(A, buf, 0, o)
        return 0

    // inc/dec/not/neg/mul/div/idiv
    u = mnr[3]
    if u != 0
        o = lget(ops, 0)
        if (op_kind(o) == 0 && o[2] != 16) || (op_kind(o) == 2 && o[7] != 0)
            enc_unary(A, buf, u[0], u[1], o)
            return 0
        if op_kind(o) == 2
            return enc_ambiguous(A, mn, lin, oa, ob)
        return enc_form(A, mn, lin, oa, ob)

    // bswap r32/r64
    if mn == "bswap"
        r = lget(ops, 0)
        if op_kind(r) != 0 || (r[2] != 4 && r[2] != 8)
            return enc_form(A, mn, lin, oa, ob)
        emit_rex(buf, reg_w(r), 0, 0, ext(r[1]))
        bput(buf, 15)
        bput(buf, 200 + (r[1] & 7))
        return 0

    // rdrand r32/r64, 0F C7 /6: the hardware RNG, which seeds the arena's
    // random base on Windows
    if mn == "rdrand"
        r = lget(ops, 0)
        if op_kind(r) != 0 || (r[2] != 4 && r[2] != 8)
            return enc_form(A, mn, lin, oa, ob)
        emit_rex(buf, reg_w(r), 0, 0, ext(r[1]))
        bput(buf, 15)
        bput(buf, 199)
        bput(buf, modrm(3, 6, r[1] & 7))
        return 0

    // imul (1 / 2 / 3 operands)
    if mn == "imul"
        if n == 1
            o = lget(ops, 0)
            if (op_kind(o) == 0 && o[2] != 16) || (op_kind(o) == 2 && o[7] != 0)
                enc_unary(A, buf, 247, 5, o)
                return 0
            if op_kind(o) == 2
                return enc_ambiguous(A, mn, lin, oa, ob)
            return enc_form(A, mn, lin, oa, ob)
        d = lget(ops, 0)
        s = lget(ops, 1)
        if op_kind(d) != 0 || d[2] == 1 || d[2] == 16
            return enc_form(A, mn, lin, oa, ob)
        if op_kind(s) == 0
            if s[2] != d[2]
                return enc_sizes(A, d, s, mn, lin, oa, ob)
        else if !mem_of(s, d[2])
            if op_kind(s) == 2
                return enc_sizes(A, d, d, mn, lin, oa, ob)
            return enc_form(A, mn, lin, oa, ob)
        if n == 2
            if op_kind(s) == 0
                pfx16w(buf, d[2])
                emit_rex(buf, reg_w(d), ext(d[1]), 0, ext(s[1]))
                bput(buf, 15)
                bput(buf, 175)
                bput(buf, modrm(3, d[1], s[1] & 7))
                return 0
            pfx16w(buf, d[2])
            emit_rex(buf, reg_w(d), ext(d[1]), mem_rexx(s), mem_rexb(s))
            bput(buf, 15)
            bput(buf, 175)
            emit_mem(A, buf, d[1], s)
            return 0
        im = lget(ops, 2)
        if op_kind(im) != 1
            return enc_form(A, mn, lin, oa, ob)
        if !imm_fits(im, imm_field(d[2]))
            return enc_wide(A, mn, lin, oa, ob)
        imm = im[1]
        // The immediate follows the operand size, so a 16-bit imul takes an
        // imm16. Four bytes there would run into the next instruction.
        iw = 4
        if d[2] == 2
            iw = 2
        op = 105
        if sign8(imm)
            op = 107
            iw = 1
        pfx16w(buf, d[2])
        // The source can be memory. (`imul ax, word ptr [rbx], 300` used to
        // assemble as `imul ax, ax, 300`, with a register number read out of
        // the memory operand.)
        if op_kind(s) == 0
            emit_rex(buf, reg_w(d), ext(d[1]), 0, ext(s[1]))
            bput(buf, op)
            bput(buf, modrm(3, d[1], s[1] & 7))
        else
            emit_rex(buf, reg_w(d), ext(d[1]), mem_rexx(s), mem_rexb(s))
            bput(buf, op)
            emit_mem_t(A, buf, d[1], s, iw)
        if iw == 1
            bput(buf, imm & 255)
            return 0
        bputn(buf, imm, iw)
        return 0
    // shrd and shld r, r, imm8: the double-precision (funnel) shift, 0F AC/A4
    // /r ib. ModRM.reg is the source register and ModRM.r/m the destination.
    // gen_funnel emits shrd for the 32-bit funnel shift in SHA-512's
    // cross-half rotations. Registers only, with an immediate count: the cl
    // form isn't encoded.
    if mn == "shrd" || mn == "shld"
        d = lget(ops, 0)
        s = lget(ops, 1)
        im = lget(ops, 2)
        if op_kind(d) != 0 || op_kind(s) != 0 || op_kind(im) != 1 || (d[2] != 4 && d[2] != 8)
            return enc_form(A, mn, lin, oa, ob)
        if s[2] != d[2]
            return enc_sizes(A, d, s, mn, lin, oa, ob)
        if !imm_fits(im, 1)
            return enc_wide(A, mn, lin, oa, ob)
        op2 = 172
        if mn == "shld"
            op2 = 164
        emit_rex(buf, reg_w(d), ext(s[1]), 0, ext(d[1]))
        bput(buf, 15)
        bput(buf, op2)
        bput(buf, modrm(3, s[1], d[1] & 7))
        bput(buf, im[1] & 255)
        return 0
    err("wasm: unhandled: " . mn . " " . sub(lin, oa, ob))
    A[16] = 1
    return 0 - 1

// A directive the assembler can't carry out as written. Like an instruction
// it can't encode, it stops the output from being written. (An unknown
// directive used to be reported and then skipped, with exit 0.)
dir_refuse(A, why, s, a, b)
    err("wasm: " . why . ": " . sub(s, a, b))
    A[16] = 1
    return 0 - 1

// One quoted string, with the escapes \n \t \r \0 \\ \" and \'. Anything
// else is refused, and so is \0 followed by a digit, which `as` would read as
// octal. (`.ascii "a", "b"` used to come out as the six characters between
// the outer quotes, and `\x41` as `x41`.)
emit_ascii(A, buf, s, a, b, zero)
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    if b - a < 2 || s[a] != 34 || s[b - 1] != 34
        return dir_refuse(A, "a string directive takes one quoted string", s, a, b)
    // Checked before anything is written, so a refused line leaves no bytes.
    i = a + 1
    loop i < b - 1
        c = s[i]
        if c == 34
            return dir_refuse(A, "a string directive takes one quoted string", s, a, b)
        if c == 92
            if i + 1 >= b - 1
                return dir_refuse(A, "a string ends in a lone backslash", s, a, b)
            n = s[i + 1]
            if n != 110 && n != 116 && n != 114 && n != 48 && n != 92 && n != 34 && n != 39
                return dir_refuse(A, "unknown escape in a string", s, a, b)
            if n == 48 && i + 2 < b - 1 && is_digit(s[i + 2])
                return dir_refuse(A, "unknown escape in a string", s, a, b)
            i = i + 2
        else
            i = i + 1
    i = a + 1
    loop i < b - 1
        c = s[i]
        if c == 92
            n = s[i + 1]
            i = i + 2
            if n == 110
                bput(buf, 10)
            else if n == 116
                bput(buf, 9)
            else if n == 114
                bput(buf, 13)
            else if n == 48
                bput(buf, 0)
            else
                bput(buf, n)
        else
            bput(buf, c)
            i = i + 1
    if zero
        bput(buf, 0)

// The comma-separated values of a data directive, read in place. The literal
// pool is thousands of `.quad` lines, one value per character of every string
// literal in the program, and slicing each value out used to be by far the
// assembler's largest single cost. Each value has to be a number or an .equ
// name that fits the width, or the line is refused before any of it is
// written. That covers `.byte 300` and `.quad label` (there are no
// relocations in data).
emit_data(A, buf, s, a, b, sz)
    k = op_slot(A)
    pass = 0
    loop pass < 2
        start = a
        i = a
        loop i <= b
            if i == b || s[i] == 44
                va = skip_space(s, start, i)
                vb = back_space(s, va, i)
                v = find_equ_r(A, s, va, vb)
                if v == 0
                    if num_parse(s, va, vb, k) != 1
                        return dir_refuse(A, "a data value is a number", s, va, vb)
                    v = k
                if !imm_fits(v, sz)
                    return dir_refuse(A, "the value does not fit", s, va, vb)
                if pass == 1
                    if sz == 8
                        emit4le(buf, v[2])
                        emit4le(buf, v[3])
                    else
                        bputn(buf, v[1], sz)
                start = i + 1
            i = i + 1
        pass = pass + 1

align16(n)
    loop (n & 15) != 0
        n = n + 1
    return n

// .align or .balign in code pads with nops (0x90 on x86-64): a pair of zero
// bytes decodes as `add [rax], al`, which faults when a label is reached by
// falling through. GNU as pads .text with nops for the same reason. Anywhere
// else zero is right. `n` is a power of two (directive checks it).
do_align(A, n)
    if A[6] == 3
        loop (A[3] & (n - 1)) != 0
            A[3] = A[3] + 1
        return 0
    buf = cur_buf(A)
    // Padding inside .text gets executed, since a label aligned in a hot loop
    // is usually reached by falling through to it. On AArch64 it has to be
    // whole NOP words (0xd503201f), because a zero word is UDF and 0x90909090
    // is some other instruction.
    if A[6] == 0 && A[17] == 1
        loop (blen(buf) & 3) != 0
            bput(buf, 0)
        loop (blen(buf) & (n - 1)) != 0
            emit4le(buf, 3573751839)
        return 0
    fill = 0
    if A[6] == 0
        fill = 144
    loop (blen(buf) & (n - 1)) != 0
        bput(buf, fill)

// The word starting at a, as a copy. Only directive uses it, for the
// directive's name, which it compares against a dozen or so literals.
first_word_r(s, a, b)
    i = a
    loop i < b && !is_space(s[i])
        i = i + 1
    return sub(s, a, i)

// The directive's argument is s[aa..ab), again a range into the line. Only
// .global and .equ, which keep what they read, copy it out.
directive(A, s, a, b)
    name = first_word_r(s, a, b)
    aa = skip_space(s, a + len(name), b)
    ab = b
    if name == ".intel_syntax"
        if aa < ab && !range_eq(s, aa, ab, "noprefix")
            return dir_refuse(A, "only .intel_syntax noprefix is supported", s, a, b)
        return 0
    if name == ".global" || name == ".globl"
        if !is_label_r(s, aa, ab)
            return dir_refuse(A, ".global takes a label", s, a, b)
        if A[7] == 0
            A[7] = sub(s, aa, ab)
        return 0
    if name == ".text"
        A[6] = 0
        return 0
    // The four sections the linkers lay out. Any other name is refused (it
    // used to land in .rodata, where code can't run).
    if name == ".section"
        se = back_space(s, aa, first_word_comma_r(s, aa, ab))
        if range_eq(s, aa, se, ".text")
            A[6] = 0
        else if range_eq(s, aa, se, ".rodata")
            A[6] = 1
        else if range_eq(s, aa, se, ".data")
            A[6] = 2
        else if range_eq(s, aa, se, ".bss")
            A[6] = 3
        else
            return dir_refuse(A, "the sections are .text, .rodata, .data and .bss", s, a, b)
        return 0
    k = op_slot(A)
    if name == ".align" || name == ".balign"
        if num_parse(s, aa, ab, k) != 1 || k[1] < 1 || k[1] > 65536 || (k[1] & (k[1] - 1)) != 0
            return dir_refuse(A, "an alignment is a power of two up to 65536", s, a, b)
        do_align(A, k[1])
        return 0
    if name == ".equ" || name == ".set"
        ci = indexof_r(s, 44, aa, ab)
        if ci < 0
            return dir_refuse(A, ".equ takes a name and a number", s, a, b)
        ke = back_space(s, aa, ci)
        if !is_label_r(s, aa, ke)
            return dir_refuse(A, ".equ takes a name and a number", s, a, b)
        // [name, value, low 32 bits, high 32 bits], the same fields an
        // immediate operand has, so an .equ reads the same way.
        e = text(4)
        if num_parse(s, ci + 1, ab, e) != 1
            return dir_refuse(A, ".equ takes a name and a number", s, a, b)
        e[0] = sub(s, aa, ke)
        A[8] = ladd_grow(A[8], e)
        return 0
    if name == ".space" || name == ".zero"
        // One size, under 2^32. A fill value isn't supported and is refused
        // (it used to be skipped and the space zeroed anyway).
        if num_parse(s, aa, ab, k) != 1 || k[1] < 0 || k[3] != 0
            return dir_refuse(A, ".space takes one size", s, a, b)
        n = k[1]
        if A[6] == 3
            A[3] = A[3] + n
        else
            buf = cur_buf(A)
            i = 0
            loop i < n
                bput(buf, 0)
                i = i + 1
        return 0
    // Everything below writes bytes, and .bss has none, so they're refused
    // there (they used to go into .data at an offset nothing pointed at).
    w = 0
    if name == ".ascii" || name == ".asciz" || name == ".string"
        w = 9
    else if name == ".byte"
        w = 1
    else if name == ".short" || name == ".word"
        w = 2
    else if name == ".long"
        w = 4
    else if name == ".quad"
        w = 8
    if w > 0
        if A[6] == 3
            return dir_refuse(A, ".bss holds only .space and .align", s, a, b)
        if w == 9
            emit_ascii(A, cur_buf(A), s, aa, ab, name != ".ascii")
            return 0
        emit_data(A, cur_buf(A), s, aa, ab, w)
        return 0
    // metadata that writes no bytes
    if name == ".file" || name == ".type" || name == ".size"
        return 0
    return dir_refuse(A, "unhandled directive", s, a, b)

// The end of the first comma-separated field of s[a..b), as a bound.
first_word_comma_r(s, a, b)
    ci = indexof_r(s, 44, a, b)
    if ci < 0
        return b
    return ci

// The mnemonic starting at s[a], interned. Its text has to be a region,
// because encode compares it against literals, but a program has few distinct
// mnemonics (66 in word.w's x86-64 build). Each one maps to a record:
// [text, jcc, setcc, unary, shift, alu, min_ops, max_ops, sse]. The codes are
// worked out once per distinct mnemonic, so encode reads a field where it used
// to walk chains of compares on every line, and the pairs alu_code and
// unary_code answer are only built once. The lookup key is a copy of the line's
// mnemonic, and it goes back to the arena once the record is found: nothing
// else is allocated between mark() and reset(), and the record that's returned
// was allocated before the mark.
mnem_intern(A, s, a, b)
    i = a
    loop i < b && !is_space(s[i])
        i = i + 1
    tbl = A[15]
    // A missing key reads as none, and `none != 0` is true, so the miss test
    // is has() instead of a compare with 0. has() is also a spelling the
    // bootstrap seed can compile: the seed (bootstrap/codegen.py) refuses null
    // and none, and compiler/word.w uses neither.
    mk = mark()
    k = copy(s, a, i)
    if has(tbl, k)
        r = tbl[k]
        reset(mk)
        return r
    reset(mk)
    m = 0
    t = copy(s, a, i)
    m = text(9)
    m[0] = t
    m[1] = jcc_code(t)
    m[2] = setcc_code(t)
    m[3] = unary_code(t)
    m[4] = shift_code(t)
    m[5] = alu_code(t)
    m[6] = min_ops(m, A[17])
    m[7] = max_ops(m, A[17])
    m[8] = sse_mnem(t)
    tbl[t] = m
    return m

// 1 for a mnemonic encode_sse handles, and 0 for every other. encode asks the
// record's copy of this before it calls encode_sse, so an ordinary instruction
// doesn't pay for encode_sse's two dozen compares, which cost more than the
// frequency-ordered chain it goes to afterwards.
sse_mnem(t)
    if t == "addsd" || t == "subsd" || t == "mulsd" || t == "divsd" || t == "sqrtsd" || t == "ucomisd"
        return 1
    if t == "movsd" || t == "movapd" || t == "movq" || t == "cvtsi2sd" || t == "cvttsd2si"
        return 1
    if t == "pxor" || t == "pand" || t == "por" || t == "punpcklqdq" || t == "pshufb" || t == "pshufd"
        return 1
    if t == "movdqu" || t == "movdqa" || t == "aesenc" || t == "aesenclast" || t == "aeskeygenassist" || t == "pclmulqdq"
        return 1
    if t == "pslld" || t == "pslldq" || t == "psllq" || t == "psrld" || t == "psrldq" || t == "psrlq"
        return 1
    return 0

// min_ops: how many operands an instruction needs before its encoder may read
// them, for x86-64 (a64 = 0) or AArch64 (a64 = 1). encode and encode_a64 refuse
// a line with fewer, and the message quotes the line. (A missing operand used
// to fault inside the assembler, or on x86 reuse an operand left over from an
// earlier line.) An encoder that reads past the minimum checks the count
// itself (imul's three forms, the madd accumulator that mul leaves out,
// AArch64's optional shift). 0 means no minimum, which is also the answer for
// a mnemonic no encoder handles.
min_ops(m, a64)
    t = m[0]
    if a64 == 1
        return a64_min_ops(t)
    if m[5] != 0 || m[4] >= 0
        return 2
    if m[1] >= 0 || m[2] >= 0 || m[3] != 0
        return 1
    if t == "mov" || t == "movabs" || t == "lea" || t == "test" || t == "movzx" || t == "movsx"
        return 2
    if t == "shrd" || t == "shld" || t == "aeskeygenassist" || t == "pclmulqdq" || t == "pshufd"
        return 3
    if t == "call" || t == "jmp" || t == "push" || t == "pop" || t == "imul" || t == "bswap" || t == "rdrand"
        return 1
    // The SSE forms take two (encode only calls encode_sse with two or more).
    if max_ops(m, 0) == 2
        return 2
    return 0

// max_ops: the most operands an x86-64 instruction takes. encode refuses a
// line with more (an extra operand used to be dropped). It's 99 for AArch64,
// whose encoder counts for itself, and for a mnemonic no encoder handles,
// which encode refuses as unhandled.
max_ops(m, a64)
    t = m[0]
    if a64 == 1
        return 99
    if m[5] != 0 || m[4] >= 0
        return 2
    if m[1] >= 0 || m[2] >= 0 || m[3] != 0
        return 1
    if t == "mov" || t == "movabs" || t == "lea" || t == "test" || t == "movzx" || t == "movsx"
        return 2
    if t == "call" || t == "jmp" || t == "push" || t == "pop" || t == "bswap" || t == "rdrand" || t == "ret"
        return 1
    if t == "imul" || t == "shrd" || t == "shld" || t == "aeskeygenassist" || t == "pclmulqdq" || t == "pshufd"
        return 3
    if t == "cpuid" || t == "syscall" || t == "cdqe" || t == "leave" || t == "cld" || t == "clc" || t == "nop" || t == "cqo"
        return 0
    if t == "movsb" || t == "stosb" || t == "movsq" || t == "stosq"
        return 0
    if t == "addsd" || t == "subsd" || t == "mulsd" || t == "divsd" || t == "sqrtsd" || t == "ucomisd" || t == "movsd" || t == "movapd" || t == "cvtsi2sd" || t == "cvttsd2si" || t == "movq"
        return 2
    if t == "pxor" || t == "pand" || t == "por" || t == "punpcklqdq" || t == "aesenc" || t == "aesenclast" || t == "pshufb" || t == "movdqu" || t == "movdqa"
        return 2
    if t == "pslldq" || t == "psrldq" || t == "psllq" || t == "psrlq" || t == "pslld" || t == "psrld"
        return 2
    return 99

a64_min_ops(t)
    if t == "b" || t == "bl" || t == "br" || t == "blr"
        return 1
    if len(t) > 2 && t[0] == 98 && t[1] == 46
        return 1
    if t == "fcsel" || t == "csel" || t == "csinc" || t == "csinv" || t == "csneg" || t == "madd" || t == "msub" || t == "extr" || t == "ubfx" || t == "sbfx"
        return 4
    if t == "fadd" || t == "fsub" || t == "fmul" || t == "fdiv" || t == "fmaxnm" || t == "fminnm"
        return 3
    if t == "add" || t == "adds" || t == "sub" || t == "subs" || t == "and" || t == "orr" || t == "eor" || t == "ands" || t == "bic" || t == "orn"
        return 3
    if t == "lsl" || t == "lsr" || t == "asr" || t == "ror" || t == "mul" || t == "mneg" || t == "sdiv" || t == "udiv" || t == "umulh" || t == "smulh"
        return 3
    if t == "stp" || t == "ldp" || t == "tbz" || t == "tbnz" || t == "cinc" || t == "cinv" || t == "cneg"
        return 3
    if t == "cbz" || t == "cbnz" || t == "adr" || t == "adrp" || t == "movz" || t == "movk" || t == "movn" || t == "mov"
        return 2
    if t == "fmov" || t == "scvtf" || t == "ucvtf" || t == "fcvtzs" || t == "fcvtzu" || t == "fcmp" || t == "fneg" || t == "fabs" || t == "fsqrt" || t == "frinta" || t == "frintz"
        return 2
    if t == "cmp" || t == "cmn" || t == "tst" || t == "neg" || t == "mvn" || t == "cset" || t == "csetm"
        return 2
    if t == "ldr" || t == "str" || t == "ldrb" || t == "strb" || t == "ldrh" || t == "strh" || t == "ldurb" || t == "sturb" || t == "ldurh" || t == "sturh" || t == "ldur" || t == "stur"
        return 2
    if t == "sxtb" || t == "sxth" || t == "sxtw" || t == "uxtb" || t == "uxth" || t == "rbit" || t == "rev16" || t == "rev32" || t == "rev" || t == "clz" || t == "cls"
        return 2
    return 0

do_line(A, s, a, b)
    // Every operand this line makes comes from the pool, so setting the index
    // back to 0 frees them all.
    A[13] = 0
    a = skip_space(s, a, b)
    b = back_space(s, a, b)
    if b <= a
        return 0
    // strip leading label(s): name: ...
    loop true
        ci = indexof_r(s, 58, a, b)
        if ci < 0
            break
        if !is_label_r(s, a, ci)
            break
        def_label(A, sub(s, a, back_space(s, a, ci)))
        a = skip_space(s, ci + 1, b)
        if a >= b
            return 0
    if s[a] == 46
        directive(A, s, a, b)
        return 0
    // instruction: mnemonic + operands
    mn = mnem_intern(A, s, a, b)
    oa = skip_space(s, a + len(mn[0]), b)
    if mn[0] == "rep"
        // The rep prefix and the instruction after it, which has to be one of
        // the four string instructions: on anything else the prefix means
        // nothing, or something else, and `as` refuses it. AArch64 has no rep.
        mn2 = mnem_intern(A, s, oa, b)
        t = mn2[0]
        if A[17] == 1 || (t != "movsb" && t != "stosb" && t != "movsq" && t != "stosq")
            err("wasm: rep takes movsb, stosb, movsq or stosq: " . sub(s, a, b))
            A[16] = 1
            return 0
        bput(A[0], 243)
        encode(A, mn2, s, skip_space(s, oa + len(mn2[0]), b), b)
        return 0
    if A[17] == 1
        encode_a64(A, mn, s, oa, b)
        return 0
    encode(A, mn, s, oa, b)
    return 0

is_label_r(s, a, b)
    b = back_space(s, a, b)
    if b <= a
        return false
    i = a
    loop i < b
        c = s[i]
        ok = 0
        if c >= 97 && c <= 122
            ok = 1
        if c >= 65 && c <= 90
            ok = 1
        if is_digit(c)
            ok = 1
        if c == 95 || c == 46
            ok = 1
        if ok == 0
            return false
        i = i + 1
    return true

// Trim the line's bounds and hand them to do_line. The line is never copied
// out of src: this and do_line work in indices. Three copies per line used to
// be the assembler's largest source of garbage.
asm_line(A, src, a, b)
    loop a < b && is_space(src[a])
        a = a + 1
    loop b > a && is_space(src[b - 1])
        b = b - 1
    if b > a
        do_line(A, src, a, b)

// This loop runs once per character of the assembly, about 10 million times
// for word.w's x86-64 build, so what it does per character is the whole cost.
// It reads each character once and decides the three things the assembler
// needs to know about it: is it a line break, does it open or close a string,
// and does it start a comment. (Finding the comment used to be a second walk
// of the same bytes, inside the per-line function.)
assemble(A, src)
    A[6] = 0                 // each file starts in .text, as `as` assumes
    n = len(src)
    start = 0
    hash = 0 - 1            // where this line's comment starts, or -1
    q = 0                   // inside a string literal
    i = 0
    // Break on \n and \r, so a CRLF file gives a harmless empty line between
    // lines instead of a trailing \r that breaks directives.
    loop i < n
        c = src[i]
        if c == 10 || c == 13
            if hash < 0
                asm_line(A, src, start, i)
            else
                asm_line(A, src, start, hash)
            start = i + 1
            hash = 0 - 1
            q = 0
        else if c == 34
            q = 1 - q
        else if c == 35 && q == 0 && hash < 0 && A[17] == 0
            hash = i
        else if c == 47 && q == 0 && hash < 0 && A[17] == 1 && i + 1 < n
            // AArch64 writes an immediate as `#8`, so `#` can't also open a
            // comment. That's why GNU `as` uses `//` on this target and `#` on
            // x86-64, and the scan follows the same rule.
            if src[i + 1] == 47
                hash = i
        i = i + 1
    if hash < 0
        asm_line(A, src, start, n)
    else
        asm_line(A, src, start, hash)

sym_vaddr(A, name, base, tstart, rstart, dstart, bvaddr)
    e = find_label(A, name)
    if e == 0
        // Resolved to zero, the relocation would point at nothing and the
        // build would still write an executable. So it sets the same flag as
        // an instruction that couldn't be encoded, and no output is written.
        err("wasm: undefined symbol: " . name)
        A[16] = 1
        return 0
    sec = e[1]
    off = e[2]
    if sec == 0
        return base + tstart + off
    if sec == 1
        return base + rstart + off
    if sec == 2
        return base + dstart + off
    return bvaddr + off

// Emit one 56-byte ELF program header. p_paddr is the same as p_vaddr, and
// the rest vary per segment.
emit_phdr_t(b, ptype, flags, off, vaddr, filesz, memsz, align)
    bputn(b, ptype, 4)           // p_type
    bputn(b, flags, 4)           // p_flags (4=R, 5=R-X, 6=RW-)
    bputn(b, off, 8)             // p_offset
    bputn(b, vaddr, 8)           // p_vaddr
    bputn(b, vaddr, 8)           // p_paddr
    bputn(b, filesz, 8)          // p_filesz
    bputn(b, memsz, 8)           // p_memsz
    bputn(b, align, 8)           // p_align

// A loadable segment (every segment with contents is one): PT_LOAD (1),
// page-aligned.
emit_phdr(b, flags, off, vaddr, filesz, memsz)
    emit_phdr_t(b, 1, flags, off, vaddr, filesz, memsz, 4096)

// PT_GNU_STACK (0x6474e551) maps nothing (every field but p_flags and
// p_align is zero). It says the stack is readable and writable and isn't
// executable.
//
// A loader that finds no PT_GNU_STACK falls back to a default that depends on
// the target, and on some configurations that's an executable stack, so
// checksec and distribution hardening checks flag a missing header. word never
// puts code on the stack, so the header costs 56 bytes and settles it. It goes
// after the PT_LOADs: the ELF spec wants those in ascending p_vaddr order and
// doesn't say where the rest go, and GNU ld puts it there too.
emit_phdr_gnustack(b)
    emit_phdr_t(b, 1685382481, 6, 0, 0, 0, 0, 16)

// Resolve every relocation into the text bytes against a laid-out image, and
// answer the entry address. The arithmetic is the same whatever the container
// (an ELF at 0x400000, a Mach-O at 0x100000000), so both of those writers lay
// their segments out and then call this.
link_reloc(A, base, tstart, rstart, dstart, bvaddr)
    rels = A[5]
    ri = 0
    loop ri < lcount(rels)
        r = lget(rels, ri)
        target = sym_vaddr(A, r[0], base, tstart, rstart, dstart, bvaddr)
        site = base + tstart + r[1]
        k = r[3]
        if k == 0
            patch32(A[0], r[1], (target + r[2]) - (site + 4))
        else
            patch_a64(A, r[1], site, (target + r[2]) - site, k, r[4], r[0])
        ri = ri + 1
    return sym_vaddr(A, A[7], base, tstart, rstart, dstart, bvaddr)

link(A)
    base = 4194304
    // W^X: three page-aligned PT_LOAD segments (R-X header and text, R--
    // rodata, RW- data and bss), so no page is both writable and executable
    // (docs/SECURITY.md §4). A section's address is base + its file offset,
    // which is all sym_vaddr needs. A fourth program header, PT_GNU_STACK,
    // asks for a stack that isn't executable either (the kernel maps the stack
    // itself). All four headers fit in the first page, which tstart rounds up
    // to.
    nph = 4
    file_off = 64 + nph * 56
    tlen = blen(A[0])
    rlen = blen(A[1])
    dlen = blen(A[2])
    tstart = alignup(file_off, 4096)
    rstart = alignup(tstart + tlen, 4096)
    dstart = alignup(rstart + rlen, 4096)
    endfile = dstart + dlen
    bvaddr = base + align16(endfile)
    entry = link_reloc(A, base, tstart, rstart, dstart, bvaddr)

    out_buf = mkbuf(endfile + 64)
    // ELF header (64 bytes)
    bput(out_buf, 127)
    bput(out_buf, 69)
    bput(out_buf, 76)
    bput(out_buf, 70)
    bput(out_buf, 2)
    bput(out_buf, 1)
    bput(out_buf, 1)
    bput(out_buf, 0)
    bputn(out_buf, 0, 8)
    bputn(out_buf, 2, 2)
    mach = 62
    if A[17] == 1
        mach = 183
    bputn(out_buf, mach, 2)
    bputn(out_buf, 1, 4)
    bputn(out_buf, entry, 8)
    bputn(out_buf, 64, 8)
    bputn(out_buf, 0, 8)
    bputn(out_buf, 0, 4)
    bputn(out_buf, 64, 2)
    bputn(out_buf, 56, 2)
    bputn(out_buf, nph, 2)
    bputn(out_buf, 0, 2)
    bputn(out_buf, 0, 2)
    bputn(out_buf, 0, 2)
    // three loadable segments: R-X (header and text), R-- (rodata), RW- (data
    // and bss)
    emit_phdr(out_buf, 5, 0, base, tstart + tlen, tstart + tlen)
    emit_phdr(out_buf, 4, rstart, base + rstart, rlen, rlen)
    emit_phdr(out_buf, 6, dstart, base + dstart, dlen, (bvaddr + A[3]) - (base + dstart))
    // and the one that loads nothing and says the stack isn't executable
    emit_phdr_gnustack(out_buf)
    // pad to tstart, then text; pad to rstart, then rodata; pad to dstart, then data
    pad_to(out_buf, tstart)
    copy_bytes(out_buf, A[0], tlen)
    pad_to(out_buf, rstart)
    copy_bytes(out_buf, A[1], rlen)
    pad_to(out_buf, dstart)
    copy_bytes(out_buf, A[2], dlen)
    return out_buf

// ============================================================================
// Mach-O writer (macOS on ARM). The layout is transcribed from
// dev/toolchain/macho_ref.py, and test_macho.sh runs the same llvm-objdump
// checks on both images, the way the AArch64 encoder is checked against
// llvm-mc.
//
// dyld maps the image (LC_LOAD_DYLINKER, and LC_MAIN for the entry), but
// there's no LC_LOAD_DYLIB, so no libSystem or any other library is loaded.
// The segments are __PAGEZERO, then __TEXT (R-X), __RODATA (R--) and __DATA
// (RW-), the same W^X split the ELF has, and __LINKEDIT for the signature.
//
// The signature is required. The Apple Silicon kernel SIGKILLs any unsigned
// arm64 binary, before Gatekeeper is involved, so an image without one can't
// run at all. An ad-hoc signature is enough: a SuperBlob wrapping a
// CodeDirectory that holds a SHA-256 of every 4 KiB page of the file, with no
// certificate and no key. word computes it itself, which keeps "no libc, no
// outside library" true on a platform that requires signing.
//
// There are two page sizes, and mixing them up gives a file that parses and
// then dies: segments align to 16 KiB on arm64 macOS, and the signature always
// hashes 4 KiB pages.

// n bytes of val, most significant first. The load commands are
// little-endian like everything else, but the code-signing blobs are
// big-endian.
bputbe(b, val, n)
    k = n - 1
    loop k >= 0
        bput(b, (val >> (k * 8)) & 255)
        k = k - 1

mo_rotr(x, n)
    return ((x >> n) | (x << (32 - n))) & 4294967295

// The round constants of FIPS 180-4 4.2.2. The compiler needs its own
// SHA-256: the net library's sha256 module is compiled into the programs word
// builds, and this runs inside word itself.
mo_k()
    k = text(64)
    k[0] = 1116352408
    k[1] = 1899447441
    k[2] = 3049323471
    k[3] = 3921009573
    k[4] = 961987163
    k[5] = 1508970993
    k[6] = 2453635748
    k[7] = 2870763221
    k[8] = 3624381080
    k[9] = 310598401
    k[10] = 607225278
    k[11] = 1426881987
    k[12] = 1925078388
    k[13] = 2162078206
    k[14] = 2614888103
    k[15] = 3248222580
    k[16] = 3835390401
    k[17] = 4022224774
    k[18] = 264347078
    k[19] = 604807628
    k[20] = 770255983
    k[21] = 1249150122
    k[22] = 1555081692
    k[23] = 1996064986
    k[24] = 2554220882
    k[25] = 2821834349
    k[26] = 2952996808
    k[27] = 3210313671
    k[28] = 3336571891
    k[29] = 3584528711
    k[30] = 113926993
    k[31] = 338241895
    k[32] = 666307205
    k[33] = 773529912
    k[34] = 1294757372
    k[35] = 1396182291
    k[36] = 1695183700
    k[37] = 1986661051
    k[38] = 2177026350
    k[39] = 2456956037
    k[40] = 2730485921
    k[41] = 2820302411
    k[42] = 3259730800
    k[43] = 3345764771
    k[44] = 3516065817
    k[45] = 3600352804
    k[46] = 4094571909
    k[47] = 275423344
    k[48] = 430227734
    k[49] = 506948616
    k[50] = 659060556
    k[51] = 883997877
    k[52] = 958139571
    k[53] = 1322822218
    k[54] = 1537002063
    k[55] = 1747873779
    k[56] = 1955562222
    k[57] = 2024104815
    k[58] = 2227730452
    k[59] = 2361852424
