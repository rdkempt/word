    asmput("# rt_map_hash: rdi = key region -> rax = djb2 over its code points. The key is")
    asmput("# promoted first, so a byte-backed key (a slice of a file) hashes the same as")
    asmput("# the word-backed text it equals.")
    asmput("# A map key has to be text (SPEC 3.7). A key that isn't a region faults here,")
    asmput("# the one place get, set and has all go through, as `region expected` with")
    asmput("# the kind it got (SPEC 10.2). It used to reach rt_bytepromote first, which")
    asmput("# faulted with the ordering message.")
    asmput("# A region key holding an element that isn't a whole number (a region, a")
    asmput("# float, a map or a singleton) faults `not a character`, as out() does for")
    asmput("# one. Its hash would be an address, so an equal key built separately would")
    asmput("# never find it, and the map couldn't be printed.")
    asmput("rt_map_hash:")
    asmput("    # A word-backed region is its own promotion, and every literal and every")
    asmput("    # join result is one. Ask inline, and only a byte-backed key makes the call.")
    asmput("    test rdi, 7")
    asmput("    jnz .mh_notreg")
    asmput("    test qword ptr [rdi - 16], 1")
    asmput("    jnz .mh_promote")
    asmput("    mov r8, rdi")
    asmput("    jmp .mh_go")
    asmput(".mh_notreg:")
    asmput("    mov r10, rdi")
    asmput("    jmp rt_regfault")
    asmput(".mh_promote:")
    asmput("    call rt_bytepromote")
    asmput("    mov r8, rax")
    asmput(".mh_go:")
    asmput("    mov rcx, [r8]")
    asmput("    mov rax, 5381")
    asmput("    test rcx, rcx")
    asmput("    jz .mh_d")
    asmput("    mov rdx, rcx")
    // r11 keeps bit 0 only while every element has its integer tag bit set.
    asmput("    mov r11, 1")
    asmput("    # djb2 over the elements, kept in the full 64 bits. Cutting it down to")
    asmput("    # 31 bits happens once at the end (the shift below), not after every")
    asmput("    # character.")
    asmput("    #")
    asmput("    # The element is added as the tagged word, not the code point. Every key")
    asmput("    # that gets here is word-backed (a byte-backed one was promoted above),")
    asmput("    # so 2c+1 depends on c just as c does, and untagging would be wasted.")
    asmput("    # The walk runs backwards from the length, so it's `dec/jnz` instead of")
    asmput("    # `inc/cmp/jl`. The order the elements are folded in doesn't matter, as")
    asmput("    # long as it's the same every time.")
    asmput("    #")
    asmput("    # The element is loaded once into r9, for the hash and for the tag check")
    asmput("    # in r11.")
    asmput(".mh_l:")
    asmput("    mov r9, [r8 + rdx*8]")
    asmput("    and r11, r9")
    asmput("    mov r10, rax")
    asmput("    shl r10, 5")
    asmput("    add rax, r10")
    asmput("    add rax, r9")
    asmput("    dec rdx")
    asmput("    jnz .mh_l")
    asmput("    test r11, r11")
    asmput("    jz rt_char")
    asmput(".mh_d:")
    asmput("    # Then mix the bits. djb2 is h*33 + c, so its low bits barely change")
    asmput("    # between neighbouring keys, and the index uses only those bits")
    asmput("    # (`and rax, size-1`). Under linear probing that builds huge clusters:")
    asmput("    # 500k keys like \"k\" . i walked 29.6 million occupied slots to be")
    asmput("    # inserted and read back, thirty probes per operation on a table never")
    asmput("    # more than half full.")
    asmput("    #")
    asmput("    # One multiply by the odd 64-bit golden-ratio constant carries every")
    asmput("    # input bit into the high half of the product, and shifting that half")
    asmput("    # down leaves 31 well-mixed bits. That's three instructions once per")
    asmput("    # hash, and the same 500k keys walk 974k slots, 30x fewer. A program")
    asmput("    # can't see any of this: `keys` is insertion order from the pair region,")
    asmput("    # never hash order.")
    asmput("    movabs r10, 0x9E3779B97F4A7C15")
    asmput("    imul rax, r10")
    asmput("    shr rax, 33")
    asmput("    ret")
    asmput("")
    asmput("# rt_key_eq: rdi = a, rsi = b -> rax = 1 if the key regions are equal")
