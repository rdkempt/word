emit_fs_dir(cg)
    asmput("# fs.dir: rdi = path region -> rax = a byte region of the directory's entry")
    asmput("# names joined by newlines (. and .. included), or `none` if it can't be")
    asmput("# opened. getdents64 into dirbuf, each record's NUL-terminated d_name copied out.")
    asmput("# The names go straight into a byte-backed region that doubles whenever the")
    asmput("# next record might not fit, the way read's buffer grows, so a listing is")
    asmput("# never cut short. It used to be staged in the 1 MB filebuf and stopped at")
    asmput("# 1,040,000 bytes and dropped every later entry, with no error.")
    asmput("rt_dir:")
    asmput("    call rt_osync")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    push r15")
    asmput("    call rt_pathcstr")
    asmput("    test rax, rax")
    asmput("    jnz .ls_fail")
    asmput("    mov rax, 2")
    asmput("    lea rdi, [rip+pathbuf]")
    asmput("    mov rsi, 0x10000")
    asmput("    xor rdx, rdx")
    emit_syscall(cg)
    asmput("    cmp rax, 0")
    asmput("    jl .ls_fail")
    asmput("    mov r12, rax")
    asmput("    mov rdi, 4096")
    asmput("    call rt_balloc")
    asmput("    mov rbx, rax")
    asmput("    xor r13, r13")
