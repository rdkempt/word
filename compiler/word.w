// emit_kind: rt_kind, behind the `kind()` builtin. It answers with one of eight
// literals instead of a number, because `if kind(x) == "map"` is a line a
// beginner can read and `if kind(x) == 3` isn't. The literals live in the
// literal pool, so writing into the answer faults like writing into any
// literal.
//
// Emitted for the cases the fold can't take: `kind(x)` printed, joined, or
// compared against something that isn't a literal. A kind test against a
// literal never calls this (see gen_kind_test).
emit_kind(cg)
    asmput("")
    asmput("# rt_kind: rdi = any value -> rax = a literal naming its kind: \"number\"")
    asmput("# (an integer or a float), \"map\", \"array\", \"bytes\", \"text\", \"boolean\",")
    asmput("# \"null\" or \"none\". This is the out-of-line form: `kind(x) == \"name\"`")
    asmput("# against a literal is folded into the tag test it describes and never gets")
    asmput("# here. keys and has fault on a non-map instead of answering, so without this")
    asmput("# a generic walk over parsed JSON could only identify a numeric leaf.")
    asmput("#")
    asmput("# \"array\" is a region with the JSON-array mark (flags bit 1), which is what")
    asmput("# array(n), a parsed [..] and split() return. Apart from rendering as [..]")
    asmput("# it behaves like text, since in word an array and a string are the same")
    asmput("# thing (SPEC 3.4), but a JSON walker has to be able to tell an array from a")
    asmput("# string.")
    asmput("rt_kind:")
    asmput("    mov r10, rdi")
    asmput("    and r10, 7")
    asmput("    cmp r10, 4")
    asmput("    je .kind_map")
    asmput("    test rdi, 1")
    asmput("    jnz .kind_num")
    asmput("    cmp r10, 2")
    asmput("    je .kind_num")
    asmput("    cmp r10, 6")
    asmput("    je .kind_singleton")
    asmput("    mov r10, [rdi - 16]")
    asmput("    test r10, 2")
    asmput("    jnz .kind_list")
    // Byte-backed (flags bit 0) is its own answer. It used to be "text", which
    // made what fs.read returns look like decoded text, when its len() counts
    // bytes and its elements are bytes.
    asmput("    test r10, 1")
    asmput("    jnz .kind_bytes")
    asmput("    lea rax, [rip+kindlit_text]")
    asmput("    add rax, [rip+litfix]")
    asmput("    ret")
    asmput(".kind_bytes:")
    asmput("    lea rax, [rip+kindlit_bytes]")
    asmput("    add rax, [rip+litfix]")
    asmput("    ret")
    asmput(".kind_list:")
    asmput("    lea rax, [rip+kindlit_list]")
    asmput("    add rax, [rip+litfix]")
    asmput("    ret")
    asmput(".kind_num:")
    asmput("    lea rax, [rip+kindlit_num]")
    asmput("    add rax, [rip+litfix]")
    asmput("    ret")
    asmput(".kind_map:")
    asmput("    lea rax, [rip+kindlit_map]")
    asmput("    add rax, [rip+litfix]")
    asmput("    ret")
    // The four singletons share a tag and are told apart by the word itself.
    // null and none each answer their own name, and true and false both
    // answer "boolean", so asking whether a value is a yes or a no takes one
    // test.
    asmput(".kind_singleton:")
    asmput("    cmp rdi, 6")
    asmput("    je .kind_null")
    asmput("    cmp rdi, 30")
    asmput("    je .kind_none")
    asmput("    lea rax, [rip+kindlit_bool]")
    asmput("    add rax, [rip+litfix]")
    asmput("    ret")
    asmput(".kind_null:")
    asmput("    lea rax, [rip+kindlit_null]")
    asmput("    add rax, [rip+litfix]")
    asmput("    ret")
    asmput(".kind_none:")
    asmput("    lea rax, [rip+kindlit_none]")
    asmput("    add rax, [rip+litfix]")
    asmput("    ret")

// emit_txt: the `txt` module, char, decode, encode, split and pad (SPEC 12.4).
// Five functions and no new concepts: each takes words and returns a word.
// They came out of gaps that writing examples/ kept running into
// (examples/README.md), and they're in a module instead of the always-live set
// so that list doesn't grow.
emit_txt(cg)
    asmput("")
    asmput("# ----- txt: char / decode / encode / split / pad (import txt) -----")
    asmput("# rt_txchar: rdi = a whole number -> rax = a one-element region holding it as")
    asmput("# a code point, the inverse of s[i]. `s . 72` renders the number, so without")
    asmput("# char() a computed code point had no spelling, and the obvious line gave")
    asmput("# plausible garbage.")
    asmput("rt_txchar:")
    asmput("    # A region and a float are both wrong here, and rt_numfault would only")
    asmput("    # name the first, so this faults with what it needs, a whole number.")
    asmput("    test rdi, 1")
    asmput("    jz rt_txneedint")
    asmput("    push rdi")
    asmput("    mov rdi, 1")
    asmput("    call rt_ralloc")
    asmput("    pop rdi")
    asmput("    # Elements are stored tagged, the same as a literal's, so it stays tagged.")
    asmput("    mov [rax + 8], rdi")
    asmput("    ret")
    asmput("")
    asmput("# rt_utf8_len: rdi = code point -> rax = how many bytes it takes in UTF-8.")
    asmput("# Faults on a value that isn't a code point (negative, or past the last")
    asmput("# plane), because the alternative is writing a cut-down byte and calling it")
    asmput("# text. A surrogate (U+D800..U+DFFF) has no UTF-8 either, and faults as `not")
    asmput("# a character`, the way one in a path or in the data write() is handed does.")
    asmput("# Clobbers rax.")
    // The fault for a value outside 0..0x10FFFF is encode's own. It used to be
    // rt_txneedint's "expected a whole number", which is wrong for 1114112 and
    // -5: they're whole numbers, just not code points.
    asmput("rt_utf8_len:")
    asmput("    cmp rdi, 0")
    asmput("    jl rt_txcodept")
    asmput("    cmp rdi, 0x110000")
    asmput("    jge rt_txcodept")
    asmput("    mov rax, rdi")
    asmput("    shr rax, 11")
    asmput("    cmp rax, 27")
    asmput("    je rt_char")
    asmput("    mov rax, 1")
    asmput("    cmp rdi, 0x80")
    asmput("    jb .ul_done")
    asmput("    mov rax, 2")
    asmput("    cmp rdi, 0x800")
    asmput("    jb .ul_done")
    asmput("    mov rax, 3")
    asmput("    cmp rdi, 0x10000")
    asmput("    jb .ul_done")
    asmput("    mov rax, 4")
    asmput(".ul_done:")
    asmput("    ret")
    asmput("")
    asmput("# rt_txencode: rdi = region of code points -> rax = a new byte-backed region")
    asmput("# holding their UTF-8 bytes. It's the inverse of rt_txdecode, and how you ask")
    asmput("# how many bytes a text is: len() of the result counts bytes, which is what a")
    asmput("# Content-Length wants, where len() of the text counts code points (SPEC 3.4:")
    asmput("# len counts elements, and a text element is a code point).")
    asmput("#")
    asmput("# Two passes: measure, allocate exactly, encode. Encoding into a worst-case 4x")
    asmput("# buffer and shrinking would allocate four times the bytes of ASCII text, which")
    asmput("# is nearly all text, and the arena has no free.")
    asmput("#")
    asmput("# A byte-backed argument isn't handed back unchanged: its elements are values")
    asmput("# 0..255 read as code points, and one above 0x7F is two bytes, so encoding it")
    asmput("# is a real conversion. That's what makes encode(decode(b)) give back b for")
    asmput("# valid UTF-8.")
    asmput("rt_txencode:")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    push r15")
    asmput("    mov r12, rdi")
    asmput("    mov r13, [r12]")
    asmput("    xor r14, r14")
    asmput("    xor r15, r15")
    asmput("    test qword ptr [r12 - 16], 1")
    asmput("    jnz .txe_mlen_b")
    asmput(".txe_mlen:")
    asmput("    cmp r15, r13")
    asmput("    jge .txe_alloc")
    asmput("    mov rdi, [r12 + r15*8 + 8]")
    // A singleton's tag word shifts down to a small number that rt_utf8_len
    // takes for a code point, so an element that isn't an integer faults here.
    // The second pass reads the same elements.
    asmput("    test rdi, 1")
    asmput("    jz rt_txneedint")
    asmput("    sar rdi, 1")
    asmput("    call rt_utf8_len")
    asmput("    add r14, rax")
    asmput("    inc r15")
    asmput("    jmp .txe_mlen")
    asmput(".txe_mlen_b:")
    asmput("    cmp r15, r13")
    asmput("    jge .txe_alloc")
    asmput("    movzx edi, byte ptr [r12 + r15 + 8]")
    asmput("    call rt_utf8_len")
    asmput("    add r14, rax")
    asmput("    inc r15")
    asmput("    jmp .txe_mlen_b")
    asmput(".txe_alloc:")
    asmput("    mov rdi, r14")
    asmput("    call rt_balloc")
    asmput("    mov r14, rax")
    asmput("    lea rsi, [rax + 8]")
    asmput("    xor r15, r15")
    asmput("    test qword ptr [r12 - 16], 1")
    asmput("    jnz .txe_put_b")
    asmput(".txe_put:")
    asmput("    cmp r15, r13")
    asmput("    jge .txe_done")
    asmput("    mov rdi, [r12 + r15*8 + 8]")
    asmput("    sar rdi, 1")
    asmput("    call rt_utf8_enc")
    asmput("    mov rsi, rax")
    asmput("    inc r15")
    asmput("    jmp .txe_put")
    asmput(".txe_put_b:")
    asmput("    cmp r15, r13")
    asmput("    jge .txe_done")
    asmput("    movzx edi, byte ptr [r12 + r15 + 8]")
    asmput("    call rt_utf8_enc")
    asmput("    mov rsi, rax")
    asmput("    inc r15")
    asmput("    jmp .txe_put_b")
    asmput(".txe_done:")
    asmput("    mov rax, r14")
    asmput("    pop r15")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    ret")
    asmput("")
    asmput("# rt_txdecode: rdi = region -> rax = its bytes decoded as UTF-8 code points.")
    asmput("# fs.read doesn't decode (a file may be binary), which left a program no way")
    asmput("# to say the bytes are text, so joining a line out of a file garbled it one")
    asmput("# code point per byte. This goes through the runtime's one decoder,")
    asmput("# rt_utf8_decode, which in(), args(), env(), net.get and parse use too. A")
    asmput("# region that's already code points comes back unchanged, since it's already")
    asmput("# text.")
    asmput("rt_txdecode:")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    test qword ptr [rdi - 16], 1")
    asmput("    jz .txd_astext")
    asmput("    mov rsi, [rdi]")
    asmput("    add rdi, 8")
    asmput("    jmp rt_utf8_decode")
    asmput(".txd_astext:")
    asmput("    mov rax, rdi")
    asmput("    ret")
    asmput("")
    asmput("# rt_txsplit: rdi = s, rsi = sep -> rax = the pieces between occurrences of")
    asmput("# sep, as an array. n separators give n+1 pieces, so an empty piece is a real")
    asmput("# answer (\"a,,b\" is three). The result carries the JSON-array mark, so out()")
    asmput("# prints [\"a\",\"\",\"b\"] instead of rendering a region of pointers as")
    asmput("# characters. An empty separator has no answer, and faults.")
    asmput("# Elements compare as raw words, which is exact for code points. It's a text")
    asmput("# operation, not the deep structural compare find() does.")
    asmput("# Two passes: count, allocate exactly, then slice. rt_copy preserves rbx,")
    asmput("# r12, r13 and r14, so the walk state lives there and everything else is")
    asmput("# reloaded from the frame after each call.")
    asmput("rt_txsplit:")
    asmput("    # Both the text and the separator have to be regions. rt_promote2 reads")
    asmput("    # through each, so a number here would crash the process.")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    mov r10, rsi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    call rt_promote2")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    push r15")
    asmput("    sub rsp, 48")
    asmput("    mov [rsp], rdi")
    asmput("    mov [rsp + 8], rsi")
    asmput("    mov rax, [rdi]")
    asmput("    mov [rsp + 16], rax")
    asmput("    mov rax, [rsi]")
    asmput("    mov [rsp + 24], rax")
    asmput("    test rax, rax")
    asmput("    jz rt_splitsep")
    asmput("    xor r8, r8")
    asmput("    mov r9, 1")
    asmput(".txs_c1:")
    asmput("    mov r10, [rsp + 16]")
    asmput("    mov r11, [rsp + 24]")
    asmput("    sub r10, r11")
    asmput("    cmp r8, r10")
    asmput("    jg .txs_c1d")
    asmput("    xor rcx, rcx")
    asmput(".txs_c2:")
    asmput("    mov r11, [rsp + 24]")
    asmput("    cmp rcx, r11")
    asmput("    jge .txs_chit")
    asmput("    mov r11, [rsp]")
    asmput("    mov rdx, r8")
    asmput("    add rdx, rcx")
    asmput("    mov rdx, [r11 + rdx*8 + 8]")
    asmput("    mov r11, [rsp + 8]")
    asmput("    mov r11, [r11 + rcx*8 + 8]")
    asmput("    cmp rdx, r11")
    asmput("    jne .txs_cnext")
    asmput("    inc rcx")
    asmput("    jmp .txs_c2")
    asmput(".txs_chit:")
    asmput("    inc r9")
    asmput("    mov r11, [rsp + 24]")
    asmput("    add r8, r11")
    asmput("    jmp .txs_c1")
    asmput(".txs_cnext:")
    asmput("    inc r8")
    asmput("    jmp .txs_c1")
    asmput(".txs_c1d:")
    asmput("    mov rdi, r9")
    asmput("    call rt_ralloc")
    asmput("    mov [rsp + 32], rax")
    asmput("    mov r10, [rax - 16]")
    asmput("    or r10, 2")
    asmput("    mov [rax - 16], r10")
    asmput("    mov qword ptr [rsp + 40], 0")
    asmput("    xor r12, r12")
    asmput("    xor r13, r13")
    asmput(".txs_s1:")
    asmput("    mov r10, [rsp + 16]")
    asmput("    mov r11, [rsp + 24]")
    asmput("    sub r10, r11")
    asmput("    cmp r12, r10")
    asmput("    jg .txs_s1d")
    asmput("    xor rcx, rcx")
    asmput(".txs_s2:")
    asmput("    mov r11, [rsp + 24]")
    asmput("    cmp rcx, r11")
    asmput("    jge .txs_shit")
    asmput("    mov r11, [rsp]")
    asmput("    mov rdx, r12")
    asmput("    add rdx, rcx")
    asmput("    mov rdx, [r11 + rdx*8 + 8]")
    asmput("    mov r11, [rsp + 8]")
    asmput("    mov r11, [r11 + rcx*8 + 8]")
    asmput("    cmp rdx, r11")
    asmput("    jne .txs_snext")
    asmput("    inc rcx")
    asmput("    jmp .txs_s2")
    asmput(".txs_shit:")
    asmput("    mov rdi, [rsp]")
    asmput("    mov rsi, r13")
    asmput("    add rsi, rsi")
    asmput("    inc rsi")
    asmput("    mov rdx, r12")
    asmput("    sub rdx, r13")
    asmput("    add rdx, rdx")
    asmput("    inc rdx")
    asmput("    call rt_copy")
    asmput("    mov r10, [rsp + 32]")
    asmput("    mov r11, [rsp + 40]")
    asmput("    mov [r10 + r11*8 + 8], rax")
    asmput("    inc r11")
    asmput("    mov [rsp + 40], r11")
    asmput("    mov r11, [rsp + 24]")
    asmput("    add r12, r11")
    asmput("    mov r13, r12")
    asmput("    jmp .txs_s1")
    asmput(".txs_snext:")
    asmput("    inc r12")
    asmput("    jmp .txs_s1")
    asmput(".txs_s1d:")
    asmput("    mov rdi, [rsp]")
    asmput("    mov rsi, r13")
    asmput("    add rsi, rsi")
    asmput("    inc rsi")
    asmput("    mov rdx, [rsp + 16]")
    asmput("    sub rdx, r13")
    asmput("    add rdx, rdx")
    asmput("    inc rdx")
    asmput("    call rt_copy")
    asmput("    mov r10, [rsp + 32]")
    asmput("    mov r11, [rsp + 40]")
    asmput("    mov [r10 + r11*8 + 8], rax")
    asmput("    mov rax, r10")
    asmput("    add rsp, 48")
    asmput("    pop r15")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    asmput("# rt_txpad: rdi = s, rsi = width, rdx = fill code point -> rax = s in a field")
    asmput("# of |width|, padded with fill. A positive width right-aligns (pads on the")
    asmput("# left) and a negative one left-aligns, the printf convention. Text already at")
    asmput("# least that wide comes back unchanged, so pad never truncates.")
    asmput("rt_txpad:")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    test rsi, 1")
    asmput("    jz rt_txneedint")
    asmput("    test rdx, 1")
    asmput("    jz rt_txneedint")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    mov r13, rsi")
    asmput("    sar r13, 1")
    asmput("    # The width is a count, so it's untagged. The fill is an element, and")
    asmput("    # elements are stored tagged.")
    asmput("    mov r14, rdx")
    asmput("    call rt_bytepromote")
    asmput("    mov r12, rax")
    asmput("    mov rbx, 1")
    asmput("    mov rax, r13")
    asmput("    cmp rax, 0")
    asmput("    jge .txp_w")
    asmput("    xor r10, r10")
    asmput("    sub r10, rax")
    asmput("    mov rax, r10")
    asmput("    xor rbx, rbx")
    asmput(".txp_w:")
    asmput("    mov r13, rax")
    asmput("    mov rcx, [r12]")
    asmput("    cmp rcx, r13")
    asmput("    jge .txp_asis")
    asmput("    mov rdi, r13")
    asmput("    call rt_ralloc")
    asmput("    mov r8, rax")
    asmput("    mov rcx, [r12]")
    asmput("    mov r9, r13")
    asmput("    sub r9, rcx")
    asmput("    test rbx, rbx")
    asmput("    jz .txp_left")
    asmput("    xor r10, r10")
    asmput(".txp_f1:")
    asmput("    cmp r10, r9")
    asmput("    jge .txp_c1")
    asmput("    mov [r8 + r10*8 + 8], r14")
    asmput("    inc r10")
    asmput("    jmp .txp_f1")
    asmput(".txp_c1:")
    asmput("    xor r10, r10")
    asmput(".txp_c1l:")
    asmput("    cmp r10, rcx")
    asmput("    jge .txp_done")
    asmput("    mov r11, [r12 + r10*8 + 8]")
    asmput("    mov rdx, r10")
    asmput("    add rdx, r9")
    asmput("    mov [r8 + rdx*8 + 8], r11")
    asmput("    inc r10")
    asmput("    jmp .txp_c1l")
    asmput(".txp_left:")
    asmput("    xor r10, r10")
    asmput(".txp_c2l:")
    asmput("    cmp r10, rcx")
    asmput("    jge .txp_f2")
    asmput("    mov r11, [r12 + r10*8 + 8]")
    asmput("    mov [r8 + r10*8 + 8], r11")
    asmput("    inc r10")
    asmput("    jmp .txp_c2l")
    asmput(".txp_f2:")
    asmput("    mov r10, rcx")
    asmput(".txp_f2l:")
    asmput("    cmp r10, r13")
    asmput("    jge .txp_done")
    asmput("    mov [r8 + r10*8 + 8], r14")
    asmput("    inc r10")
    asmput("    jmp .txp_f2l")
    asmput(".txp_done:")
    asmput("    mov rax, r8")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput(".txp_asis:")
    asmput("    mov rax, r12")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")

// The sys runtime, one piece per verb family, each emitted only for a program
// that calls into it (SECURITY.md 7): the emit buffer, writex, exec and the
// sockets. A program that opens a socket has no execve in it, and one that
// runs a program has no socket code.
emit_sys(cg)
    if cg[19] == 1
        emit_emitbuf(cg)
    if cg[60] == 1
        emit_writex(cg)
    if cg[37] == 1
        emit_exec(cg)
    if cg[11] == 1
        emit_sockets(cg)
        emit_timeout(cg)

emit_emitbuf(cg)
    asmput("# ----- sys module: the emit buffer -----")
    asmput("# rt_asmput: rdi = region s -> append s's elements and a newline to the emit")
    asmput("# buffer, doubling it as needed. The emit buffer is a region whose [0] is")
    asmput("# its length, and asmput() sends every emitted assembly line through here.")
    asmput("#")
    asmput("# The buffer is byte-backed (rt_balloc). Assembly text is ASCII by")
    asmput("# construction (str_repr escapes every code point outside 32..126), so one")
    asmput("# byte per character costs 1x instead of 8x, and asmtake() hands the")
    asmput("# assembler the same shape read() gives it for a .s file on disk. A source")
    asmput("# element above 255 would store its low byte, as d[i] = v does on any")
    asmput("# byte-backed region. The source line can be either backing, so both are")
    asmput("# read. Anything but a region faults before the buffer is touched.")
    asmput("rt_asmput:")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    push r15")
    asmput("    mov rbx, rdi")
    asmput("    mov r13, [rbx]")
    asmput("    mov r12, [rip+emit_ptr]")
    asmput("    test r12, r12")
    asmput("    jnz .ap_have")
    asmput("    mov r14, 2097152")
    asmput("    mov rdi, r14")
    asmput("    call rt_balloc")
    asmput("    mov r12, rax")
    asmput("    mov qword ptr [r12], 0")
    asmput("    mov [rip+emit_ptr], r12")
    asmput("    mov [rip+emit_cap], r14")
    asmput(".ap_have:")
    asmput("    mov r14, [r12]")
    asmput("    mov rax, r14")
    asmput("    add rax, r13")
    asmput("    inc rax")
    asmput("    mov rcx, [rip+emit_cap]")
    asmput("    cmp rax, rcx")
    asmput("    jle .ap_fits")
    asmput("    shl rcx, 1")
    asmput("    cmp rcx, rax")
    asmput("    jge .ap_newcap")
    asmput("    mov rcx, rax")
    asmput(".ap_newcap:")
    asmput("    push rcx")
    asmput("    mov rdi, rcx")
    asmput("    call rt_balloc")
    asmput("    pop rcx")
    asmput("    mov r15, rax")
    asmput("    mov [r15], r14")
    asmput("    xor rdx, rdx")
    asmput(".ap_copy:")
    asmput("    cmp rdx, r14")
    asmput("    jge .ap_copied")
    asmput("    movzx rax, byte ptr [r12 + rdx + 8]")
    asmput("    mov [r15 + rdx + 8], al")
    asmput("    inc rdx")
    asmput("    jmp .ap_copy")
    asmput(".ap_copied:")
    asmput("    mov r12, r15")
    asmput("    mov [rip+emit_ptr], r12")
    asmput("    mov [rip+emit_cap], rcx")
    asmput(".ap_fits:")
    asmput("    xor rcx, rcx")
    asmput("    test qword ptr [rbx - 16], 1")
    asmput("    jnz .ap_bput")
    asmput(".ap_put:")
    asmput("    cmp rcx, r13")
    asmput("    jge .ap_putd")
    asmput("    mov rax, [rbx + rcx*8 + 8]")
    asmput("    sar rax, 1")
    asmput("    mov rdx, r14")
    asmput("    add rdx, rcx")
    asmput("    mov [r12 + rdx + 8], al")
    asmput("    inc rcx")
    asmput("    jmp .ap_put")
    asmput(".ap_bput:")
    asmput("    cmp rcx, r13")
    asmput("    jge .ap_putd")
    asmput("    movzx rax, byte ptr [rbx + rcx + 8]")
    asmput("    mov rdx, r14")
    asmput("    add rdx, rcx")
    asmput("    mov [r12 + rdx + 8], al")
    asmput("    inc rcx")
    asmput("    jmp .ap_bput")
    asmput(".ap_putd:")
    asmput("    mov rdx, r14")
    asmput("    add rdx, r13")
    asmput("    mov byte ptr [r12 + rdx + 8], 10")
    asmput("    add r14, r13")
    asmput("    inc r14")
    asmput("    mov [r12], r14")
    asmput("    pop r15")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    asmput("# rt_asmtake: -> rax = the emit buffer so far, and resets it so the next")
    asmput("# asmput starts a new buffer. With no buffer yet, returns an empty region.")
    asmput("rt_asmtake:")
    asmput("    mov rax, [rip+emit_ptr]")
    asmput("    test rax, rax")
    asmput("    jz .at_empty")
    asmput("    mov qword ptr [rip+emit_ptr], 0")
    asmput("    ret")
    asmput(".at_empty:")
    asmput("    xor rdi, rdi")
    asmput("    call rt_ralloc")
    asmput("    ret")
    asmput("")

emit_writex(cg)
    asmput("# ----- sys module: writing an executable -----")
    asmput("# rt_writex: rdi = path region, rsi = data region (one byte value per element)")
    asmput("# -> rax = the integer 1 or 0. Writes an executable (mode 0755), truncating, in")
    asmput("# filebuf-sized chunks, so the output size is unbounded (an ELF can be over")
    asmput("# 1 MB). Both arguments have to be regions, and that's checked before the")
    asmput("# file is opened, so a wrong kind faults without truncating anything.")
    asmput("rt_writex:")
    asmput("    call rt_osync")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    mov r10, rsi")
    asmput("    test r10b, 7")
