        // deadline when the peer kept the connection open.
        if cs[1] < 0
            err("net: a chunk size in the response is not a size")
            return 0 - 1
        return d
    if http_done(resp, used, f) == 0
        return 0
    return 1

// A new state for net_enough: the head search at the start of the response,
// and a chunk walk that starts (cs[0] < 0) once the head says the body is
// chunked.
net_walk()
    cs = text(2)
    cs[0] = 0 - 1
    st = text(2)
    st[0] = text(3)
    st[1] = cs
    return st

// The raw response an exchange read, as [bytes, how many of them are live]:
// the buffer keeps the spare capacity it grew with, and handing back the
// length saves a copy of the whole response.
net_got(resp, used)
    r = text(2)
    r[0] = resp
    r[1] = used
    return r

// Fetch over a plain HTTP connection: send the request, then read until http.w
// says the response is complete or the peer closes. Returns the raw response
// (net_got), or 0, or 1 when the total deadline `tend` passed first. `head` is
// 1 for a HEAD request, whose reply ends with its head.
net_http_exchange(fd, req, head, tend)
    if !net_send(fd, req, tend)
        return 0
    // One scratch buffer for the whole exchange, and an accumulator with spare
    // capacity, instead of a buffer per read and a fresh full-length copy of
    // the response on every read. That once made a fetch of a 77 KB body keep
    // about half a megabyte for the life of the program. 4 KB is one page,
    // which holds the headers and a small body in one read. A bigger buffer
    // would save reads on a large response and cost every fetch its size, and
    // the append below is linear, so more reads are cheap where more memory
    // isn't.
    buf = bytes(4096)
    resp = bytes(0)
    used = 0
    cap = net_max_body()
    st = net_walk()
    loop 1 == 1
        if !dns_await(fd, tend, net_idle_ms())
            return net_late(1)
        g = recv(fd, buf)
        // A timed-out read returns 0, the same as a peer that closed. The two
        // are told apart afterwards, in net_fetch, by whether the response the
        // peer framed has all arrived. The total deadline is the exception and
        // fails the fetch whatever arrived, or a close-delimited body cut off
        // by it would come back as if it were whole.
        if g == 0
            if now() >= tend
                return net_late(1)
            break
        resp = http_append(resp, used, buf, 0, g)
        used = used + g
        if used > cap
            err("net: the response is larger than this client will read")
            return 0
        d = net_enough(resp, used, head, st)
        if d < 0
            return 0
        if d == 1
            break
    if used == 0
        // The request went out and the peer hung up without sending a byte.
        // That isn't a framing failure, so it gets its own message, as it does
        // in net_tls_exchange.
        err("net: the peer closed without answering the request")
        return 0
    return net_got(resp, used)

// A key share for `group`: x25519 (29) or the two NIST curves (23 secp256r1,
// 24 secp384r1). Returns [private, public], or 0 for a group this client can't
// do.
net_keyshare(group)
    r = text(2)
    if group == 29
        d = net_random(32)
        r[0] = d
        r[1] = x25519_base(d)
        return r
    cid = 0
    nb = 0
    if group == 23
        cid = 1
        nb = 32
    else if group == 24
        cid = 2
        nb = 48
    else
        return 0
    // Rejection sampling: a scalar is only usable in 1..n-1, and ec_pubkey
    // checks that.
    tries = 0
    loop tries < 16
        d = net_random(nb)
        q = ec_pubkey(cid, d)
        if kind(q) != "number"
            r[0] = d
            r[1] = q
            return r
        tries = tries + 1
    return 0

// The TLS 1.3 handshake, client side, over `fd`. Returns
// [suite, c_ap_key, c_ap_iv, s_ap_key, s_ap_iv] on success, or 0.
//
// `insecure` skips certificate authentication only: the connection is still
// encrypted, but the peer isn't proven to be `host` (SPEC §12.2). `tend` is the
// fetch's total deadline, and the handshake is inside it, or a server that
// trickles its flight would hold the fetch before it had begun.
net_tls_handshake(fd, host, insecure, tend)
    group = 29
    ks = net_keyshare(group)
    if kind(ks) == "number"
        return 0
    priv = ks[0]
    // Kept, because the second ClientHello of a HelloRetryRequest exchange is
    // this one again: RFC 8446 section 4.1.2 lets it differ in the key share,
    // the cookie, early_data, pre_shared_key and padding, and nothing else. A
    // fresh random and session id make a new ClientHello, which a server that
    // checks answers with illegal_parameter. Microsoft's front end checks, and
    // bing.com, office.com, live.com, msn.com and microsoftonline.com all ask
    // for P-256 by retry.
    hello_random = net_random(32)
    session_id = net_random(32)
    ch = tls13_client_hello_g(hello_random, session_id, group, ks[1], host, 0)
    if !net_send(fd, net_plain_record(22, ch), tend)
        return 0
    // The ServerHello arrives as a plaintext handshake record.
    sh = 0
    loop 1 == 1
        rec = net_read_record(fd, tend)
        if kind(rec) == "number"
            return 0
        t = rec[0]
        // A ChangeCipherSpec is legacy middlebox compatibility: step over it.
        if t != 20
            if t != 22
                // An alert where the ServerHello should be, reported on stderr.
                // 39 of the thousand most popular domains answer this client
                // with a close_notify and no handshake at all. That's bot
                // management, not a protocol failure (a plain Go TLS 1.3
                // client gets the same from the same hosts, and openssl's
                // fuller ClientHello is let through), and the message says
                // which of the two happened.
                if t == 21 && len(rec) >= 7
                    if rec[6] == 0
                        err("net: " . host . " closed the connection without a handshake")
                    else
                        err("net: " . host . " refused the handshake, alert " . rec[6])
                return 0
            sh = copy(rec, 5, len(rec))
            break
    // A HelloRetryRequest wears the ServerHello format and says "not that
    // group". It's answered once, with a key share for the group it named and
    // its cookie echoed back, and a second retry ends the handshake (4.1.4). One
    // this client can't answer (tls13_hrr_check) ends it here, and the
    // ServerHello after it has to name the suite the retry named (4.1.4).
    prefix = ch
    hrr_suite = 0
    shb = tls13_server_hello_body(sh)
    if kind(shb) == "number"
        err("net: " . host . " sent a handshake this client could not accept")
        return 0
    if tls13_is_hrr(shb) == 1
        hr = tls13_parse_hrr(shb)
        if kind(hr) == "number" || tls13_hrr_check(hr, session_id, group) == 0
            err("net: " . host . " sent a HelloRetryRequest this client cannot answer")
            return 0
        hrr_suite = hr[2]
        group = hr[0]
        ks = net_keyshare(group)
        if kind(ks) == "number"
            return 0
        priv = ks[0]
        ch2 = tls13_client_hello_g(hello_random, session_id, group, ks[1], host, hr[1])
        // The transcript is the synthetic one of 4.4.1 from here on.
        prefix = tls13_hrr_transcript(ch, sh, ch2)
        if !net_send(fd, net_plain_record(22, ch2), tend)
            return 0
        sh = 0
        loop 1 == 1
            rec = net_read_record(fd, tend)
            if kind(rec) == "number"
                return 0
            if rec[0] != 20
                if rec[0] != 22
                    return 0
                sh = copy(rec, 5, len(rec))
                break
        shb = tls13_server_hello_body(sh)
        if kind(shb) == "number"
            err("net: " . host . " sent a handshake this client could not accept")
            return 0
        if tls13_is_hrr(shb) == 1
            return 0
    // RFC 8446 section 4.1.3: the ServerHello echoes the session id this client
    // sent, and a client that gets back anything else must abort. A retry's
    // echo is checked by tls13_hrr_check, and this is the ServerHello that
    // follows it, or the first one when there was no retry.
    if tls13_echoes_session(shb, session_id) == 0
        err("net: " . host . " sent a ServerHello that does not echo this client's session id")
        return 0
    dk = tls13_client_handshake_keys_g(prefix, group, priv, sh)
    if kind(dk) == "number"
        return 0
    if hrr_suite != 0 && dk[0] != hrr_suite
        err("net: " . host . " answered its HelloRetryRequest with a different cipher suite")
        return 0
    suite = net_suite(dk[0])
    if suite < 0
        return 0
    kl = net_keylen(suite)
    s_key = tls13_write_key(dk[2], kl)
    s_iv = tls13_write_iv(dk[2])
    // The rest of the server's flight is encrypted under the handshake keys.
    // Records are decrypted in order and their handshake content appended to
    // one growing buffer until the server's Finished has arrived, and at that
    // point the flight is accepted or refused, never read on.
    // tls13_flight_complete draws that line. Handing every record to
    // process_flight, whose 0 means "refused" as well as "not all here", once
    // kept the client reading on a flight it couldn't accept while the server
    // waited for an answer, until the idle deadline 30 s later.
    //
    // The buffer grows by doubling (http_append), so the copying is linear.
    // http_concat per record would leave a full-length copy each time in an
    // arena that never shrinks. `used` is the live length, since the buffer
    // keeps trailing capacity. The ceiling is net_max_flight, refused as soon
    // as it's passed, since without it the flight would be bounded only by the
    // total deadline, and SPEC 12.2 promises no peer can grow the buffer until
    // the arena can't.
    flight = bytes(0)
    used = 0
    seq = 0
    df = 0
    loop 1 == 1
        rec = net_read_record(fd, tend)
        if kind(rec) == "number"
            return 0
        if rec[0] != 20
            if rec[0] != 23
                return 0
            inner = tls13_open(suite, s_key, s_iv, seq, rec)
            if kind(inner) == "number"
                return 0
            seq = seq + 1
            ctype = inner[len(inner) - 1]
            if ctype != 22
                // Only handshake content belongs in the flight. An alert here
                // is a refusal to carry on.
                return 0
            flight = http_append(flight, used, inner, 0, len(inner) - 1)
            used = used + len(inner) - 1
            if used > net_max_flight()
                err("net: the server's handshake flight is larger than this client will read")
                return 0
            // http_append keeps trailing capacity, so the completeness check and
            // process_flight are handed a copy of just the live bytes. While the
            // flight is still short of its Finished, the reset reclaims that
            // copy (SPEC 12.5), so a server dribbling records under the ceiling
            // can't pile up a whole-flight copy per record. Once the Finished is
            // in, the loop breaks before the reset, so the copy and df survive.
            mk = mark()
            whole = copy(flight, 0, used)
            if tls13_flight_complete(whole) == 1
                df = tls13_client_process_flight(prefix, sh, whole, dk[3], dk[1], dk[2])
                if kind(df) == "number"
                    err("net: " . host . " sent a handshake this client could not accept")
                    return 0
                break
            reset(mk)
    // A truth test, not `insecure == 0`. `false == 0` is false, so `== 0` read
    // `get(url, false)` as a request to skip verification, and the spelling a
    // caller would reach for to say "verify this" turned verification off
    // (SPEC 12.2).
    if !insecure
        // The trust store is parsed for this check and dead after it (Linux's
        // 150-certificate bundle is about 1 MB of arena parsed), so the arena
        // is rewound over it (SPEC 12.5). The check answers a number, and df
        // and everything else still needed below were allocated before the
        // mark.
        mk = mark()
        roots = net_load_roots()
        // now() is in nanoseconds, and certificate validity is in seconds.
        t = net_idiv(now(), 1000000000)
        trusted = tls13_authenticate(df[3], roots, host, t, df[4], df[5])
        reset(mk)
        if trusted == 0
            // A refusal says why. A bare 0 can't be told from a network
            // failure, and the difference matters to whoever is reading.
            err("net: certificate not trusted for " . host)
            return 0
    // The client's Finished (behind an empty Certificate when the server asked
    // for one), sealed under the client handshake keys in one record, since
    // handshake messages may share one (RFC 8446 section 5.1).
    c_key = tls13_write_key(dk[1], kl)
    c_iv = tls13_write_iv(dk[1])
    fin = tls13_seal(suite, c_key, c_iv, 0, df[0], 22, 0)
    if !net_send(fd, fin, tend)
        return 0
    r = text(5)
    r[0] = suite
    r[1] = tls13_write_key(df[1], kl)
    r[2] = tls13_write_iv(df[1])
    r[3] = tls13_write_key(df[2], kl)
    r[4] = tls13_write_iv(df[2])
    return r

// Send `req` as application data and read the response back. Returns the raw
// response (net_got), or 0, or 1 when the total deadline `tend` passed first.
// The deadline is checked before every read, inside a record too
// (net_read_record reads through dns_recvn), since a record trickled a byte at
// a time would otherwise hold the fetch as long as the peer liked. `head` is 1
// for a HEAD request, as for net_http_exchange, and `host` is who the refusal
// below is named for.
net_tls_exchange(fd, host, ks, req, head, tend)
    rec = tls13_seal(ks[0], ks[1], ks[2], 0, req, 23, 0)
    if !net_send(fd, rec, tend)
        return 0
    resp = bytes(0)
    used = 0
    seq = 0
    cap = net_max_body()
    st = net_walk()
    loop 1 == 1
        r = net_read_record(fd, tend)
        if kind(r) == "number"
            // 1 is the deadline, which fails the fetch whatever arrived. 0 is a
            // peer that closed or stalled, which net_fetch judges by framing.
            if r == 1
                return 1
            break
        if r[0] != 20
            inner = tls13_open(ks[0], ks[3], ks[4], seq, r)
            if kind(inner) == "number"
                break
            seq = seq + 1
            ctype = inner[len(inner) - 1]
            // close_notify, or any other alert: the peer is done talking.
            //
            // Any other alert before a byte of the response is the server
            // refusing a handshake this client has already finished. TLS 1.3
            // never tells a client its Finished was accepted, so a server that
            // won't accept it answers here, after the request has gone. Above
            // all that's a server that wanted a client certificate and was sent
            // the empty one, whose answer is certificate_required (116). It's
            // named, the way a refusal before the ServerHello is, instead of
            // reading as a peer that closed without answering.
            if ctype == 21
                if used == 0 && len(inner) >= 3 && inner[1] != 0
                    err("net: " . host . " refused the handshake, alert " . inner[1])
                    return 0
                break
            if ctype == 23
                resp = http_append(resp, used, inner, 0, len(inner) - 1)
                used = used + len(inner) - 1
                if used > cap
                    err("net: the response is larger than this client will read")
                    return 0
                d = net_enough(resp, used, head, st)
                if d < 0
                    return 0
                if d == 1
                    break
    if used == 0
        // The handshake finished, the request went out, and the peer hung up
        // without a byte. That isn't a framing failure, so it gets its own
        // message: two of the thousand most popular domains answer this client
        // that way (justdial.com and businesswire.com, both behind bot
        // management that drops a request it doesn't like instead of refusing
        // it).
        err("net: the peer closed without answering the request")
        return 0
    return net_got(resp, used)

// The method verb for the code the compiler passes. It's a small integer
// instead of a string because the call site is generated: pushing a tagged
// number is one instruction, where a literal region would need the literal
// pool.
net_method(m)
    if m == 1
        return "POST"
    if m == 2
        return "PUT"
    if m == 3
        return "DELETE"
    if m == 4
        return "HEAD"
    return "GET"

// The whole of `net`: method code, url, optional body, optional insecure flag ->
// the response body as code points, or `none` on any failure.
//
// Every failure is the same answer (SPEC §12.2 and 3.8): the verb was asked for
// a body and has none to give, and a program can't tell a refused connection
// from a bad certificate, which keeps a network call's error handling to one
// branch. A response with any status, a 404 or a 500 included, is a body like
// any other. The reason for a failure, when there is one, goes to stderr. The
// helpers still answer the number 0 among themselves, since they're this
// library's internals, and `kind(x) == "number"` below checks their answers.
net_fetch(m, url, body, insecure)
    // The total deadline counts from here: resolving, connecting, the
    // handshake and the response all spend it, so a fetch is over by `tend`
    // whatever the peer does. (Resolving and connecting have bounds of their
    // own as well, well inside it.)
    tend = now() + net_total_ns()
    method = net_method(m)
    head = 0
    if m == 4
        head = 1
    u = http_parse_url(url)
    if kind(u) == "number"
        err("net: malformed URL")
        return none
    // The request bounds SPEC 12.2 gives: host 255, path 2048, and the whole
    // request 8 KiB. Going past one is a recoverable failure with a reason on
    // stderr, never a truncated request or a fault.
    if len(u[1]) > 255
        err("net: URL too long")
        return none
    if len(u[3]) > 2048
        err("net: URL too long")
        return none
    // A text body is sent as the UTF-8 it spells (the bytes encode() gives it,
    // and the bytes out() would write), and a byte body as the bytes it holds.
    // Keeping the low byte of each code point once sent a different body as
    // soon as it held anything past U+00FF.
    if kind(body) == "text" || kind(body) == "array"
        body = encode(body)
    // Built before a name is looked up or a socket opened, so a request that
    // can't be sent fails without touching the network.
    req = http_request(method, u, body)
    if kind(req) == "number"
        err("net: malformed URL")
        return none
    if len(req) > 8192
        err("net: URL too long")
        return none
    ip = dns_resolve(u[1])
    if kind(ip) == "number"
        err("net: cannot resolve " . u[1])
        return none
    fd = connect(ip, u[2])
    if fd == 0
        return none
    // Every read and write from here on is bounded, as dns.w's are: this is
    // the socket with an unknown peer on the other end.
    timeout(fd, net_idle_ms())
    resp = 0
    if u[0] == 1
        ks = net_tls_handshake(fd, u[1], insecure, tend)
        if kind(ks) == "number"
            close(fd)
            return none
        resp = net_tls_exchange(fd, u[1], ks, req, head, tend)
    else
        resp = net_http_exchange(fd, req, head, tend)
    close(fd)
    if kind(resp) == "number"
        return none
    n = resp[1]
    raw = resp[0]
    f = http_frame(raw, n, head)
    if f[2] == 5
        if http_final(raw, n) < 0
            err("net: the server switched protocols, which this client did not ask it to do")
        else
            err("net: the response's Content-Length is not a length")
        return none
    if f[2] == 0 || http_status(raw, f[0]) == 0
        return none
    // A response that declared where its body ends and then stopped short is a
    // truncation, and handing that back is worse than failing, since the caller
    // would parse half a document and couldn't tell. Only a close-delimited
    // response may end by ending, because for it the close is the framing. With
    // a read deadline in place, a peer that stalls looks like a peer that hung
    // up, so this is what tells them apart. A reply to HEAD, and a 204 or 304,
    // is complete at the end of its head whatever length it names.
    if http_done(raw, n, f) == 0 && f[2] != 4
        err("net: the response ended before its declared length")
        return none
    // raw is consumed here: a chunked body is decoded over it (http_dechunk).
    b = http_body(raw, n, head)
    if kind(b) == "number"
        return none
    // A fetched body is text as far as the caller is concerned: decoded once,
    // here, so the region a program indexes is code points (SPEC §12.2).
    return decode(b)
// <<< NETLIB END <<<

netlib_src(mod)
    // WORD_NETLIB_BLOBS: netlib_embed() writes the modules in above this line.
    return 0
