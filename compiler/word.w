        // which is what rename(2) does: it replaces an existing target. It answers
        // a BOOL, so nonzero becomes 0 and zero becomes -1 for the caller's `jl`
        // failure test. ANSI, like the CreateFileA the rest of the fs layer uses.
        asmput("# rename(old=r12, new=r13) -> 0 on success, -1 on failure. MoveFileExA")
        asmput("# with MOVEFILE_REPLACE_EXISTING (1), the semantics of rename(2).")
        asmput(".wsc_rename:")
