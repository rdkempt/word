        asmput("    mov rcx, [rip+win_pi]")
        asmput("    lea rdx, [rsp+80]")
        asmput("    mov dword ptr [rsp+80], 0")
        asmput("    call qword ptr [rip+GetExitCodeProcess]")
        asmput("    mov ecx, [rsp+80]")
        asmput("    call qword ptr [rip+ExitProcess]")
        // Either way the child didn't start: rebuild w_syscall's own frame (rbp
        // is still its base) and answer -1, so rt_exec returns and `word run` can
        // report it instead of the process ending with nothing said.
        asmput(".wex_toolong:")
        asmput(".wex_fail:")
        asmput("    mov rsp, rbp")
        asmput("    and rsp, -16")
        asmput("    sub rsp, 192")
        asmput("    mov rax, -1")
        asmput("    jmp .wsc_ret")
