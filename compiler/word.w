emit_exec(cg)
    asmput("# ----- sys module: exec -----")
    asmput("# rt_exec: rdi = path region, rsi = argument list -> execve(path, [path,")
    asmput("# args...]) with the environment inherited. It only returns on failure: on")
    asmput("# Linux the image is replaced, and on Windows w_syscall runs the program and")
    asmput("# exits with its status. The list is the compiler's internal one: element 0 is")
    asmput("# the count and elements 1..count are the arguments. The path and every")
    asmput("# argument have to be regions, and the count a whole number inside the list,")
    asmput("# or it faults before a byte is built. Text goes over as UTF-8 and bytes as")
    asmput("# they are, and a string holding a NUL can't be given to the OS, so exec fails.")
    asmput("# The C strings and the NULL-terminated argv come from the arena, sized from")
    asmput("# the arguments. Fixed ones (64 KB of text, 256 pointers) could be overrun.")
    asmput("rt_exec:")
    asmput("    call rt_osync")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    mov r10, rsi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    push r15")
    asmput("    mov r12, rdi")
    asmput("    # a byte-backed list is read as the values it holds")
    asmput("    mov rdi, rsi")
    asmput("    call rt_bytepromote")
    asmput("    mov r13, rax")
    asmput("    mov rcx, [r13]")
    asmput("    test rcx, rcx")
    asmput("    jnz .ex_haslen")
    asmput("    mov rax, r13")
    asmput("    jmp rt_boundsidx")
    asmput(".ex_haslen:")
