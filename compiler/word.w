    asmput("    mov rcx, 1000")
    asmput("    div rcx")
    asmput("    lea r12, [rip+tvbuf]")
    asmput("    mov [r12], rax")
    asmput("    imul rdx, rdx, 1000")
    asmput("    mov [r12+8], rdx")
    asmput("    mov rax, 54")
    asmput("    mov rdi, rbx")
    asmput("    mov rsi, 1")
    asmput("    mov rdx, 20")
    asmput("    lea r10, [rip+tvbuf]")
    asmput("    mov r8, 16")
    emit_syscall(cg)
    asmput("    mov rax, 54")
    asmput("    mov rdi, rbx")
    asmput("    mov rsi, 1")
    asmput("    mov rdx, 21")
    asmput("    lea r10, [rip+tvbuf]")
    asmput("    mov r8, 16")
    emit_syscall(cg)
    asmput("    mov rax, 3")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")

