// in the column order the round reads them, the S-box, and the round count.
aes_key(key)
    sb = aes_sbox()
    w = aes_expand(key, sb)
    n = (len(w) >> 2)
    rk = text(n)
    i = 0
    loop i < n
        rk[i] = (w[i * 4] << 24) | (w[i * 4 + 1] << 16) | (w[i * 4 + 2] << 8) | w[i * 4 + 3]
        i = i + 1
    ctx = text(3)
    ctx[0] = rk
    ctx[1] = sb
    ctx[2] = (len(key) >> 2) + 6
    return ctx

// xtime on all four bytes of a packed column at once: shift the low seven bits
// of each byte up, and fold the polynomial back in wherever the top bit was
// set. No table, no branch, no per-byte call.
aes_xtw(x)
    y = (x & 2139062143) << 1
    m = (x >> 7) & 16843009
    return y ^ (m * 27)

// The rounds themselves, on four column words. `dst` is a 4-element word region
// the caller owns and reuses, so a loop over blocks allocates nothing and the
// keystream never becomes bytes and back again, which is most of what the byte
// interface below costs.
//
// The state is four column words, s0..s3, with s_c = st[4c]<<24 | .. | st[4c+3]
// in FIPS 197's column-major order, row 0 in the high byte. ShiftRows isn't a
// separate step: row n of column c's input comes from column c+n, so it falls
// out of which column each of the four lookups reads.
//
// The column words are masked where they're made. An S-box byte and xtime's
// answer never pass 32 bits, but the compiler can't see that through a region
// or a call, and a rotation is one `rol` only when its operand is proved to fit
// (the rotate idiom). With the masks, u0..u3, v and t are raw 32-bit locals.
aes_rounds(ctx, dst, s0, s1, s2, s3)
    rk = ctx[0]
    sb = ctx[1]
    nr = ctx[2]
    s0 = s0 ^ rk[0]
    s1 = s1 ^ rk[1]
    s2 = s2 ^ rk[2]
    s3 = s3 ^ rk[3]
    r = 1
    loop r <= nr
        b = r * 4
        u0 = ((sb[(s0 >> 24) & 255] << 24) | (sb[(s1 >> 16) & 255] << 16) | (sb[(s2 >> 8) & 255] << 8) | sb[s3 & 255]) & 4294967295
        u1 = ((sb[(s1 >> 24) & 255] << 24) | (sb[(s2 >> 16) & 255] << 16) | (sb[(s3 >> 8) & 255] << 8) | sb[s0 & 255]) & 4294967295
        u2 = ((sb[(s2 >> 24) & 255] << 24) | (sb[(s3 >> 16) & 255] << 16) | (sb[(s0 >> 8) & 255] << 8) | sb[s1 & 255]) & 4294967295
        u3 = ((sb[(s3 >> 24) & 255] << 24) | (sb[(s0 >> 16) & 255] << 16) | (sb[(s1 >> 8) & 255] << 8) | sb[s2 & 255]) & 4294967295
        // Every round but the last mixes each column.
        if r < nr
            v = aes_xtw(u0) & 4294967295
            t = u0 ^ v
            u0 = v ^ (((t << 8) | (t >> 24)) & 4294967295) ^ (((u0 << 16) | (u0 >> 16)) & 4294967295) ^ (((u0 << 24) | (u0 >> 8)) & 4294967295)
            v = aes_xtw(u1) & 4294967295
            t = u1 ^ v
            u1 = v ^ (((t << 8) | (t >> 24)) & 4294967295) ^ (((u1 << 16) | (u1 >> 16)) & 4294967295) ^ (((u1 << 24) | (u1 >> 8)) & 4294967295)
            v = aes_xtw(u2) & 4294967295
            t = u2 ^ v
            u2 = v ^ (((t << 8) | (t >> 24)) & 4294967295) ^ (((u2 << 16) | (u2 >> 16)) & 4294967295) ^ (((u2 << 24) | (u2 >> 8)) & 4294967295)
            v = aes_xtw(u3) & 4294967295
            t = u3 ^ v
            u3 = v ^ (((t << 8) | (t >> 24)) & 4294967295) ^ (((u3 << 16) | (u3 >> 16)) & 4294967295) ^ (((u3 << 24) | (u3 >> 8)) & 4294967295)
        s0 = u0 ^ rk[b]
        s1 = u1 ^ rk[b + 1]
        s2 = u2 ^ rk[b + 2]
        s3 = u3 ^ rk[b + 3]
        r = r + 1
    dst[0] = s0
    dst[1] = s1
    dst[2] = s2
    dst[3] = s3
    return 0

// One block in place, for the two a message needs outside the keystream:
// GHASH's H and the tag mask. A loop over blocks should call aes_rounds with a
// `dst` it hoisted, and read the keystream out of the words.
aes_encrypt_block(st, ctx)
    d = text(4)
    aes_rounds(ctx, d, (st[0] << 24) | (st[1] << 16) | (st[2] << 8) | st[3], (st[4] << 24) | (st[5] << 16) | (st[6] << 8) | st[7], (st[8] << 24) | (st[9] << 16) | (st[10] << 8) | st[11], (st[12] << 24) | (st[13] << 16) | (st[14] << 8) | st[15])
    c = 0
    loop c < 4
        e = d[c]
        st[c * 4] = (e >> 24) & 255
        st[c * 4 + 1] = (e >> 16) & 255
        st[c * 4 + 2] = (e >> 8) & 255
        st[c * 4 + 3] = e & 255
        c = c + 1
    return 0
// >>> NETLIB MODULE gcm >>>
// gcm.w: AES-GCM (NIST SP 800-38D), in word. Needs aes.w.
//
// GCM is counter mode for confidentiality plus GHASH for authentication, and
// GHASH is multiplication in GF(2^128). x86-64 and AArch64 have carry-less
// multiply instructions for it (PCLMULQDQ, PMULL), and portable code does it
// the long way. A 128-bit value here is four 32-bit cells, most significant
// first, the order the wire uses.
//
// The multiply reads a 4-bit table: sixteen precomputed multiples of H, built
// once per message, and thirty-two nibble steps per block instead of 128
// shift-and-test rounds (gf_table and gf_mul_y below). That made the multiply
// about eight times faster. The bit-serial version it replaced is the oracle
// in dev/toolchain/crypto_w/gcm_kat.w, and the two are run against each other
// on random operands, since the four published vectors exercise one H and
// wouldn't catch a table that's wrong at one entry.
//
// The rest came from doing less work per block: aes.w's column-word round, an
// accumulator that stays in locals for the whole multiply, and a keystream
// that never becomes bytes. Per 256 KiB message that took the instruction count
// from 870.9M to 291.8M, of which AES was then 53%, GHASH 39% and the mode's own
// framing 8%. It was retiring about three instructions per cycle then, so
// running several counter blocks at once for parallelism wouldn't help, and
// the remaining wins are in doing less work. AES-128-GCM runs at about 28 MB/s
// on x86-64 Linux.
//
// Nothing is allocated per block, and gcm_encrypt and gcm_decrypt rewind the
// arena over their scratch (SPEC 12.5), so encrypting 8 MiB peaks at about
// 25 MB: the plaintext, the ciphertext being built and the answer.

// z ^= v, both 4-cell
gf_xor(z, v)
    z[0] = z[0] ^ v[0]
    z[1] = z[1] ^ v[1]
    z[2] = z[2] ^ v[2]
    z[3] = z[3] ^ v[3]
    return 0

// v >>= 1 across the whole 128 bits, and xor in the GCM reduction polynomial
// (0xe1 in the top byte) when the bit shifted out was set.
gf_shift(v)
    lsb = v[3] & 1
    v[3] = ((v[3] >> 1) | ((v[2] & 1) << 31)) & 4294967295
    v[2] = ((v[2] >> 1) | ((v[1] & 1) << 31)) & 4294967295
    v[1] = ((v[1] >> 1) | ((v[0] & 1) << 31)) & 4294967295
    v[0] = (v[0] >> 1) & 4294967295
    if lsb == 1
        v[0] = v[0] ^ 3774873600
    return 0

// A fresh 4-cell copy of v.
gf_copy(v)
    c = text(4)
    c[0] = v[0]
    c[1] = v[1]
    c[2] = v[2]
    c[3] = v[3]
    return c

// The tables gf_mul_y reads, built from H once per message.
//
// [0] is sixteen multiples of H: M[n] = n*H, with the nibble n sitting at the
// four most significant bit positions, which is where the bit-serial loop
// started. So M[8] is H itself, and each of M[4], M[2] and M[1] is one gf_shift
// below the last: the same halving the bit-serial multiply did 128 times, done
// three times here. Every other n is the xor of its set bits. They're flattened
// into one 64-word region.
//
// [1] is sixteen reduction words. Shifting the accumulator right by four bits
// drops four bits off the bottom, and each one that was set folds the GCM
// polynomial back in at the top. The total depends on those four bits alone, so
// it's a table. Each entry comes from running gf_shift over a value holding
// just that nibble instead of a transcribed constant, so the reduction is
// defined in one place.
gf_table(h)
    m = text(16)
    z = text(4)
    z[0] = 0
    z[1] = 0
    z[2] = 0
    z[3] = 0
    m[0] = z
    m[8] = gf_copy(h)
    m[4] = gf_copy(m[8])
    gf_shift(m[4])
    m[2] = gf_copy(m[4])
    gf_shift(m[2])
    m[1] = gf_copy(m[2])
    gf_shift(m[1])
    n = 3
    loop n < 16
        // n with its lowest set bit cleared, which is smaller than n and so is
        // already built. The bit itself is one of the four seeded above.
        low = n & (n - 1)
        if low != 0
            e = gf_copy(m[low])
            gf_xor(e, m[n - low])
            m[n] = e
        n = n + 1
    r = text(16)
    i = 0
    loop i < 16
        v = text(4)
        v[0] = 0
        v[1] = 0
        v[2] = 0
        v[3] = i
        j = 0
        loop j < 4
            gf_shift(v)
            j = j + 1
        r[i] = v[0]
        i = i + 1
    // Flatten the sixteen multiples into one 64-word region, M[n] at f[n*4+k].
    // The multiply reads four of these words per nibble, and as sixteen
    // separate regions each read would also cost a region load and an
    // indirection.
    f = text(64)
    n = 0
    loop n < 16
        e = m[n]
        f[n * 4] = e[0]
        f[n * 4 + 1] = e[1]
        f[n * 4 + 2] = e[2]
        f[n * 4 + 3] = e[3]
        n = n + 1
    t = text(2)
    t[0] = f
    t[1] = r
    return t

// y = y * H in GF(2^128), in place, where tbl is gf_table(H). The GCM
// convention: bit 0 of the product is the most significant bit of the first
// byte.
//
// Horner over the nibbles of y, last to first: shift the accumulator right four
// bits and xor in the multiple the next nibble selects. That's thirty-two table
// reads and thirty-two shifts, where the bit-serial form did 128 shift-and-test
// rounds and two divides a round to find its bit.
//
// The first shift runs on a zero accumulator, where it does nothing (r[0] is
// 0), which is cheaper than a flag to skip it.
//
// This isn't constant time, and no more so than what it replaced. The
// bit-serial version branched on a bit of the operand, and this one indexes a
// 512-byte table (eight cache lines) with a nibble of the operand and a
// 128-byte table (two lines) with a nibble of the running product: a cache
// channel in place of a branch channel. docs/SECURITY.md section 5 covers it.
// The table isn't a hardening.
//
// The accumulator stays in locals for the whole multiply. As a region, each of
// the thirty-two nibble steps touched it a dozen times, every time a
// bounds-checked access. The only region reads left in a step are the two table
// lookups, and `y` is read four times and written four times per block.
//
// The operand's words rotate through locals instead of being indexed: the outer
// loop wants y[3], y[2], y[1], y[0] in that order, and shifting the four
// locals down each time is three moves.
//
// Every write to z0..z3 is masked to 32 bits, though the table words already
// fit. That lets the compiler prove the accumulator fits and keep it in raw
// 32-bit locals, where each shift and xor is one instruction.
gf_mul_y(y, tbl)
    m = tbl[0]
    r = tbl[1]
    x0 = y[0]
    x1 = y[1]
    x2 = y[2]
    x3 = y[3]
    z0 = 0
    z1 = 0
    z2 = 0
    z3 = 0
    c = 0
    loop c < 4
        w = x3
        x3 = x2
        x2 = x1
        x1 = x0
        s = 0
        loop s < 32
            rem = z3 & 15
            z3 = ((z3 >> 4) | ((z2 & 15) << 28)) & 4294967295
            z2 = ((z2 >> 4) | ((z1 & 15) << 28)) & 4294967295
            z1 = ((z1 >> 4) | ((z0 & 15) << 28)) & 4294967295
            z0 = ((z0 >> 4) ^ r[rem]) & 4294967295
            b = ((w >> s) & 15) * 4
            z0 = (z0 ^ m[b]) & 4294967295
            z1 = (z1 ^ m[b + 1]) & 4294967295
            z2 = (z2 ^ m[b + 2]) & 4294967295
            z3 = (z3 ^ m[b + 3]) & 4294967295
            s = s + 4
        c = c + 1
    y[0] = z0
    y[1] = z1
    y[2] = z2
    y[3] = z3
    return 0

// Read 16 bytes at `off` as four 32-bit cells, most significant first.
gf_load(c, b, off)
    i = 0
    loop i < 4
        j = off + i * 4
        c[i] = ((b[j] << 24) | (b[j + 1] << 16) | (b[j + 2] << 8) | b[j + 3]) & 4294967295
        i = i + 1
    return 0

gf_store(b, off, c)
    i = 0
    loop i < 4
        v = c[i]
        b[off + i * 4] = (v >> 24) & 255
        b[off + i * 4 + 1] = (v >> 16) & 255
        b[off + i * 4 + 2] = (v >> 8) & 255
        b[off + i * 4 + 3] = v & 255
        i = i + 1
    return 0

// y = (y ^ block) * H for the trailing partial block of `data` at off,
// zero-padded to sixteen bytes as SP 800-38D says. Only one block of a message
// is ever short, so the padding and its bounds test live here instead of on
// every byte of ghash_bytes' loop.
ghash_tail(y, tbl, data, off, n)
    i = 0
    c = 0
    loop c < 4
        v = 0
        k = 0
        loop k < 4
            b = 0
            if off + i < n
                b = data[off + i]
            v = (v << 8) | b
            i = i + 1
            k = k + 1
        y[c] = y[c] ^ v
        c = c + 1
    gf_mul_y(y, tbl)
    return 0

// Fold every 16-byte block of `data` into the accumulator. The whole blocks are
// read four bytes at a time straight out of `data`, with no scratch block to
// allocate, fill and read back, and no per-byte end-of-data test.
ghash_bytes(y, tbl, data)
    n = len(data)
    off = 0
    full = n - n % 16
    loop off < full
        y[0] = y[0] ^ ((data[off] << 24) | (data[off + 1] << 16) | (data[off + 2] << 8) | data[off + 3])
        y[1] = y[1] ^ ((data[off + 4] << 24) | (data[off + 5] << 16) | (data[off + 6] << 8) | data[off + 7])
        y[2] = y[2] ^ ((data[off + 8] << 24) | (data[off + 9] << 16) | (data[off + 10] << 8) | data[off + 11])
        y[3] = y[3] ^ ((data[off + 12] << 24) | (data[off + 13] << 16) | (data[off + 14] << 8) | data[off + 15])
        gf_mul_y(y, tbl)
        off = off + 16
    if off < n
        ghash_tail(y, tbl, data, off, n)
    return 0

// Counter block n: the 12-byte IV, then a 32-bit big-endian counter. Twelve
// bytes is the only IV length TLS 1.3 uses.
gcm_ctr(iv, n)
    c = bytes(16)
    i = 0
    loop i < 12
        c[i] = iv[i]
        i = i + 1
    c[12] = (n >> 24) & 255
    c[13] = (n >> 16) & 255
    c[14] = (n >> 8) & 255
    c[15] = n & 255
    return c

// The keystream XOR, from counter block 2 onward (block 1 makes the tag mask).
//
// The keystream never becomes a byte region. The counter block is the 12-byte
// IV and a 4-byte big-endian counter, so three of its four column words are
// fixed for the whole message and the fourth is the counter itself, and there's
// nothing to build. aes_rounds writes the four keystream words into one region
// hoisted out of the loop, and the xor reads them with a shift. Building a
// bytes(16) counter block and reading the keystream back as bytes cost, per
// block, a mark and reset, an allocation and several dozen bounds-checked
// loads and stores, and each of those took the runtime's general path, since
// the compiler can't prove a region that came back from a call is byte-backed.
//
// The whole blocks run with no end-of-data test. Only the tail, the one partial
// block, needs it.
gcm_crypt(ctx, iv, data)
    n = len(data)
    outb = bytes(n)
    i0 = (iv[0] << 24) | (iv[1] << 16) | (iv[2] << 8) | iv[3]
    i1 = (iv[4] << 24) | (iv[5] << 16) | (iv[6] << 8) | iv[7]
    i2 = (iv[8] << 24) | (iv[9] << 16) | (iv[10] << 8) | iv[11]
    ks = text(4)
    ctr = 2
    off = 0
    full = n - n % 16
    loop off < full
        aes_rounds(ctx, ks, i0, i1, i2, ctr)
        c = 0
        loop c < 4
            k = ks[c]
            j = off + c * 4
            outb[j] = data[j] ^ ((k >> 24) & 255)
            outb[j + 1] = data[j + 1] ^ ((k >> 16) & 255)
            outb[j + 2] = data[j + 2] ^ ((k >> 8) & 255)
            outb[j + 3] = data[j + 3] ^ (k & 255)
            c = c + 1
        ctr = ctr + 1
        off = off + 16
    if off < n
        aes_rounds(ctx, ks, i0, i1, i2, ctr)
        i = 0
        loop off + i < n
            k = ks[(i >> 2)]
            outb[off + i] = data[off + i] ^ ((k >> (24 - i % 4 * 8)) & 255)
            i = i + 1
    return outb

// The tag over the AAD and the ciphertext, with the two bit lengths in the
// final block, which stops a ciphertext being read back with a different split
// between the two.
gcm_tag(ctx, iv, aad, ct)
    hb = bytes(16)
    aes_encrypt_block(hb, ctx)
    h = text(4)
    gf_load(h, hb, 0)
    // One table for the whole message: it depends only on H, and H depends only
    // on the key. Building it per block would cost more than the bit-serial
    // multiply it replaces.
    tbl = gf_table(h)
    y = text(4)
    y[0] = 0
    y[1] = 0
    y[2] = 0
    y[3] = 0
    ghash_bytes(y, tbl, aad)
    ghash_bytes(y, tbl, ct)
    lb = bytes(16)
    ab = len(aad) * 8
    cb = len(ct) * 8
    i = 0
    loop i < 8
        lb[7 - i] = (ab >> (i * 8)) & 255
        lb[15 - i] = (cb >> (i * 8)) & 255
