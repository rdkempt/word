    asmput("    test rax, rax")
    asmput("    js .sn_fail")
    asmput("    lea rax, [rax+rax+1]")
    asmput("    ret")
    asmput(".sn_fail:")
    asmput("    mov rax, 1")
    asmput("    ret")
    asmput("")
    asmput("# rt_recv: rdi = fd (tagged), rsi = a bytes buffer -> rax = tagged count (0 = EOF/error)")
    asmput("rt_recv:")
    asmput("    call rt_osync")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 1")
    asmput("    jz rt_intfault")
    asmput("    mov r10, rsi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    test qword ptr [rsi - 16], 1")
    asmput("    jz rt_bytesfault")
