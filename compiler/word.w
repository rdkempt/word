    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    mov r14, 1")
    asmput(".cn_check:")
    asmput("    mov r10, rdi")
    asmput("    test r10b, 7")
    asmput("    jnz rt_regfault")
    asmput("    test qword ptr [rdi - 16], 1")
    asmput("    jz rt_bytesfault")
    asmput("    mov r10, rsi")
    asmput("    test r10b, 1")
    asmput("    jz rt_intfault")
    asmput("    mov r13, rdi")
    asmput("    sar rsi, 1")
    asmput("    mov r12, rsi")
    asmput("    mov rax, [r13]")
    asmput("    cmp rax, 4")
    asmput("    jne .cn_fail")
    asmput("    cmp r12, 65535")
    asmput("    ja .cn_fail")
    asmput(".cn_make:")
    asmput("    mov rax, 41")
    asmput("    mov rdi, 2")
    asmput("    mov rsi, r14")
    asmput("    xor rdx, rdx")
    emit_syscall(cg)
    asmput("    test rax, rax")
    asmput("    js .cn_fail")
    asmput("    mov rbx, rax")
    asmput("    cmp r14, 1")
    asmput("    jne .cn_addr")
    emit_conn_deadline(cg, "conn_tv")
    asmput(".cn_addr:")
    asmput("    lea rdi, [rip+connaddr]")
    asmput("    mov byte ptr [rdi], 2")
    asmput("    mov byte ptr [rdi+1], 0")
    asmput("    mov rax, r12")
    asmput("    shr rax, 8")
    asmput("    mov [rdi+2], al")
    asmput("    mov rax, r12")
    asmput("    mov [rdi+3], al")
    asmput("    mov eax, [r13+8]")
    asmput("    mov [rdi+4], eax")
    asmput("    mov qword ptr [rdi+8], 0")
    asmput("    mov rax, 42")
    asmput("    mov rdi, rbx")
    asmput("    lea rsi, [rip+connaddr]")
    asmput("    mov rdx, 16")
    emit_syscall(cg)
    asmput("    test rax, rax")
    asmput("    js .cn_closefail")
