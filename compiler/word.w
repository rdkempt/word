    asmput("    add rsi, r15")
    asmput("    movzx rcx, byte ptr [rsi+16]")
    asmput("    movzx rax, byte ptr [rsi+17]")
    asmput("    shl rax, 8")
    asmput("    or rcx, rax")
    asmput("    test rcx, rcx")
