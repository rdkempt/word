emit_fs_write(cg)
    asmput("")
    asmput("# write/append: rdi = path, rsi = data, rdx = append flag -> true or false.")
    asmput("# A byte-backed region is written as the bytes it holds, and a word-backed one")
    asmput("# as the UTF-8 of its code points, the bytes out() writes for text. It used to")
    asmput("# keep the low byte of each element, so U+00E9 went out as one byte, anything")
    asmput("# past U+00FF was mangled, and a region of regions wrote pieces of pointers.")
    asmput("# Written in chunks of up to 1 MB, so the output size is unbounded.")
