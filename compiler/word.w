    // actually reaches. filebuf is shared by fs and sys.writex.
    if cg[17] == 1
        asmput("inbuf: .space 65536")
        asmput("inbuf_len: .space 8")
        asmput("inbuf_pos: .space 8")
        asmput("in_eof: .space 8")
        asmput("linebuf: .space 65536")
    if cg[20] == 1
        asmput("jb_ptr: .space 8")
        asmput("jb_len: .space 8")
        asmput("jp_src: .space 8")
        asmput("jp_pos: .space 8")
        asmput("jp_bad: .space 8")
        asmput("jp_depth: .space 8")
    if cg[18] == 1 || cg[60] == 1
        asmput("pathbuf: .space 4096")
    if cg[61] == 1
        asmput("pathbuf2: .space 4096")
    if cg[18] == 1
        asmput("statbuf: .space 144")
        asmput("dirbuf: .space 32768")
    if cg[18] == 1 || cg[60] == 1
        asmput("filebuf: .space 1048576")
    if cg[12] == 1
