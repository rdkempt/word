        asmput("declo: .space 8")
        asmput("dechi: .space 8")
    asmput("utf8buf: .space 8")
    // out() stages its text and its newline here, and the buffer is written when
    // it fills, before err(), before a fault message, at exit and before anything
    // that can block (rt_osync). outmark is how much of it finished out() calls
    // staged: a fault writes that much and drops the rest of the call that
    // faulted. outline is 1 when stdout is a terminal, and then each out() is
    // written as it ends. Anything that writes to out_fd directly must flush
    // first, or it cuts ahead of staged bytes. Zero-filled .bss, so it costs no
    // file size.
    asmput("outbuf: .space " . obuf_cap())
    asmput("outblen: .space 8")
    asmput("outmark: .space 8")
    asmput("outline: .space 8")
    // When a write of the buffer fails, the fault is reported at outfirst: the
    // line of the first out() or err() whose bytes are still in it, which can
    // be well before the statement that happened to flush. outquiet is 1 once a
    // fault is being reported, and then a write that fails drops what it had
    // instead of reporting itself over the fault that is already under way.
    asmput("outfirst: .space 8")
    asmput("outquiet: .space 8")
    asmput("cur_line: .space 8")
    // The stack-overflow guard, on every target (gen_data serves both
    // backends): stack_base is the stack pointer at entry, and stack_limit is
    // the address below which a prologue check jumps to rt_stack. rlim_buf
    // receives the soft RLIMIT_STACK: from getrlimit on x86-64 Linux, and
    // from prlimit64 on arm64, which m_syscall turns into Darwin's getrlimit
    // on macOS. Windows doesn't use it: its limit comes from the PE's stack
    // reserve. See rt_init.
    asmput("stack_base: .space 8")
    asmput("stack_limit: .space 8")
    asmput("rlim_buf: .space 16")
