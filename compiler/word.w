    asmput("    mov rdi, r12")
    asmput("    lea rsi, [rip+dirbuf]")
    asmput("    mov rdx, 32768")
    emit_syscall(cg)
    asmput("    cmp rax, 0")
    asmput("    jle .ls_done")
    asmput("    mov r14, rax")
    asmput("    xor r15, r15")
