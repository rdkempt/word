// key = 16 or 32 bytes, iv = 12 -> a region of ciphertext followed by the
// 16-byte tag, which is the layout a TLS record already has.
gcm_encrypt(key, iv, aad, pt)
    r = bytes(len(pt) + 16)
    mk = mark()
    ctx = aes_key(key)
    ct = gcm_crypt(ctx, iv, pt)
    tg = gcm_tag(ctx, iv, aad, ct)
    i = 0
    loop i < len(ct)
        r[i] = ct[i]
        i = i + 1
    i = 0
    loop i < 16
        r[len(ct) + i] = tg[i]
        i = i + 1
    reset(mk)
    return r

// ct_and_tag = ciphertext with its 16-byte tag appended -> the plaintext, or
// the number 0 when the tag doesn't verify. Failure is a number so
// `if p == 0` is exact (SPEC 3.3).
gcm_decrypt(key, iv, aad, ct_and_tag)
    n = len(ct_and_tag)
    if n < 16
        return 0
    cn = n - 16
    out = bytes(cn)
    mk = mark()
    ok = gcm_open(out, key, iv, aad, ct_and_tag)
    reset(mk)
    if ok == 0
        return 0
    return out

// Authenticate and decrypt into `out`, which the caller allocated before the
// mark so it survives the rewind. Returns 1 on a good tag and 0 on a bad one.
gcm_open(out, key, iv, aad, ct_and_tag)
    cn = len(out)
    ct = bytes(cn)
    i = 0
    loop i < cn
        ct[i] = ct_and_tag[i]
        i = i + 1
    ctx = aes_key(key)
    tg = gcm_tag(ctx, iv, aad, ct)
    // Compare every byte, every time. Stopping at the first difference would
    // tell an attacker how much of a forged tag was right.
    diff = 0
    i = 0
    loop i < 16
        diff = diff | (tg[i] ^ ct_and_tag[cn + i])
        i = i + 1
    if diff != 0
        return 0
    pt = gcm_crypt(ctx, iv, ct)
    i = 0
    loop i < cn
        out[i] = pt[i]
        i = i + 1
    return 1
// >>> NETLIB MODULE x25519 >>>
// x25519.w: X25519 (RFC 7748), in word.
//
// The key exchange this client's first ClientHello carries (RFC 8446 section
// 9.1 makes X25519 a should, next to P-256's must). Everything below happens
// in GF(2^255 - 19).
//
// A field element is ten cells in radix 2^25.5: limb i weighs 2^ceil(25.5 i),
// so the limbs alternate 26 and 25 bits. It's the representation of ref10 in
// SUPERCOP and of most portable C, and a product is 100 limb multiplies written
// out in full, with no loop and nothing allocated.
//
// It fits word's 63-bit integers because the limbs are signed and every carry
// rounds instead of flooring. A carried limb is at most 2^25 (even limbs) or
// about 2^24 (odd limbs) in magnitude, and the ladder only ever multiplies
// carried elements or the sum or difference of two, so a factor is at most
// 2^26 (2^25 for an odd limb). The widest sum a product forms is then
// 124.5 * 2^52, just under 2^59, with the 19 and 38 folded into the operands
// beforehand. That leaves three bits under word's 2^62, so no input reaches the
// overflow check. (Unsigned limbs, kept non-negative by adding 2p before every
// subtraction, would need one more bit than word has, which is why this used to
// be fifteen 17-bit limbs and 225 limb products per multiply.)
//
// Constant time as far as word can promise: no secret-dependent branch and no
// secret-dependent index. The conditional swap masks instead of branching, and
// the ladder runs all 255 bits every time. What word can't promise is that the
// arithmetic underneath is constant time, which is up to the target's
// multiplier. The overflow checks are branches too, on a bound no input
// reaches.

// ---- field arithmetic -------------------------------------------------------

// o = a + b, limb by limb, no carry.
fe_add(o, a, b)
    o[0] = a[0] + b[0]
    o[1] = a[1] + b[1]
    o[2] = a[2] + b[2]
    o[3] = a[3] + b[3]
    o[4] = a[4] + b[4]
    o[5] = a[5] + b[5]
    o[6] = a[6] + b[6]
    o[7] = a[7] + b[7]
    o[8] = a[8] + b[8]
    o[9] = a[9] + b[9]
    return 0

// o = a - b, limb by limb, no carry. Limbs are signed, so nothing is added first.
fe_sub(o, a, b)
    o[0] = a[0] - b[0]
    o[1] = a[1] - b[1]
    o[2] = a[2] - b[2]
    o[3] = a[3] - b[3]
    o[4] = a[4] - b[4]
    o[5] = a[5] - b[5]
    o[6] = a[6] - b[6]
    o[7] = a[7] - b[7]
    o[8] = a[8] - b[8]
    o[9] = a[9] - b[9]
    return 0

fe_zero(a)
    i = 0
    loop i < 10
        a[i] = 0
        i = i + 1
    return 0

fe_one(a)
    fe_zero(a)
    a[0] = 1
    return 0

fe_copy(d, s)
    i = 0
    loop i < 10
        d[i] = s[i]
        i = i + 1
    return 0

fe_new()
    return text(10)

// Write h0..h9 to o after the carry chain every product ends with. Each carry
// is rounded, so a limb ends in [-2^25, 2^25] (even) or [-2^24, 2^24] (odd),
// except limb 1, which takes the last carry and can end a few hundred past
// 2^24. The carry out of limb 9 re-enters limb 0 times 19.
fe_carry_out(o, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9)
    c = (h0 + 33554432) >> 26
    h1 = h1 + c
    h0 = h0 - (c << 26)
    c = (h4 + 33554432) >> 26
    h5 = h5 + c
    h4 = h4 - (c << 26)
    c = (h1 + 16777216) >> 25
    h2 = h2 + c
    h1 = h1 - (c << 25)
    c = (h5 + 16777216) >> 25
    h6 = h6 + c
    h5 = h5 - (c << 25)
    c = (h2 + 33554432) >> 26
    h3 = h3 + c
    h2 = h2 - (c << 26)
    c = (h6 + 33554432) >> 26
    h7 = h7 + c
    h6 = h6 - (c << 26)
    c = (h3 + 16777216) >> 25
    h4 = h4 + c
    h3 = h3 - (c << 25)
    c = (h7 + 16777216) >> 25
    h8 = h8 + c
    h7 = h7 - (c << 25)
    c = (h4 + 33554432) >> 26
    h5 = h5 + c
    h4 = h4 - (c << 26)
    c = (h8 + 33554432) >> 26
    h9 = h9 + c
    h8 = h8 - (c << 26)
    c = (h9 + 16777216) >> 25
    h0 = h0 + c * 19
    h9 = h9 - (c << 25)
    c = (h0 + 33554432) >> 26
    h1 = h1 + c
    h0 = h0 - (c << 26)
    o[0] = h0
    o[1] = h1
    o[2] = h2
    o[3] = h3
    o[4] = h4
    o[5] = h5
    o[6] = h6
    o[7] = h7
    o[8] = h8
    o[9] = h9
    return 0

// o = f * g (mod p). o may alias f or g: every limb is read before any is written.
//
// Each limb is read once, as `f[i] | 0`. The `| 0` is the kind test, paid once
// per limb: it faults on anything that isn't an integer, and it makes the local
// statically an integer, so the hundred products below carry no tag checks.
// They do carry the overflow check, which the bound in the header says never
// fires.
fe_mul(o, f, g)
    f0 = f[0] | 0
    f1 = f[1] | 0
    f2 = f[2] | 0
    f3 = f[3] | 0
    f4 = f[4] | 0
    f5 = f[5] | 0
    f6 = f[6] | 0
    f7 = f[7] | 0
    f8 = f[8] | 0
    f9 = f[9] | 0
    g0 = g[0] | 0
    g1 = g[1] | 0
    g2 = g[2] | 0
    g3 = g[3] | 0
    g4 = g[4] | 0
    g5 = g[5] | 0
    g6 = g[6] | 0
    g7 = g[7] | 0
    g8 = g[8] | 0
    g9 = g[9] | 0
    g1_19 = g1 * 19
    g2_19 = g2 * 19
    g3_19 = g3 * 19
    g4_19 = g4 * 19
    g5_19 = g5 * 19
    g6_19 = g6 * 19
    g7_19 = g7 * 19
    g8_19 = g8 * 19
    g9_19 = g9 * 19
    f1_2 = f1 + f1
    f3_2 = f3 + f3
    f5_2 = f5 + f5
    f7_2 = f7 + f7
    f9_2 = f9 + f9
    h0 = f0 * g0 + f1_2 * g9_19 + f2 * g8_19 + f3_2 * g7_19 + f4 * g6_19 + f5_2 * g5_19 + f6 * g4_19 + f7_2 * g3_19 + f8 * g2_19 + f9_2 * g1_19
    h1 = f0 * g1 + f1 * g0 + f2 * g9_19 + f3 * g8_19 + f4 * g7_19 + f5 * g6_19 + f6 * g5_19 + f7 * g4_19 + f8 * g3_19 + f9 * g2_19
    h2 = f0 * g2 + f1_2 * g1 + f2 * g0 + f3_2 * g9_19 + f4 * g8_19 + f5_2 * g7_19 + f6 * g6_19 + f7_2 * g5_19 + f8 * g4_19 + f9_2 * g3_19
    h3 = f0 * g3 + f1 * g2 + f2 * g1 + f3 * g0 + f4 * g9_19 + f5 * g8_19 + f6 * g7_19 + f7 * g6_19 + f8 * g5_19 + f9 * g4_19
    h4 = f0 * g4 + f1_2 * g3 + f2 * g2 + f3_2 * g1 + f4 * g0 + f5_2 * g9_19 + f6 * g8_19 + f7_2 * g7_19 + f8 * g6_19 + f9_2 * g5_19
    h5 = f0 * g5 + f1 * g4 + f2 * g3 + f3 * g2 + f4 * g1 + f5 * g0 + f6 * g9_19 + f7 * g8_19 + f8 * g7_19 + f9 * g6_19
    h6 = f0 * g6 + f1_2 * g5 + f2 * g4 + f3_2 * g3 + f4 * g2 + f5_2 * g1 + f6 * g0 + f7_2 * g9_19 + f8 * g8_19 + f9_2 * g7_19
    h7 = f0 * g7 + f1 * g6 + f2 * g5 + f3 * g4 + f4 * g3 + f5 * g2 + f6 * g1 + f7 * g0 + f8 * g9_19 + f9 * g8_19
    h8 = f0 * g8 + f1_2 * g7 + f2 * g6 + f3_2 * g5 + f4 * g4 + f5_2 * g3 + f6 * g2 + f7_2 * g1 + f8 * g0 + f9_2 * g9_19
    h9 = f0 * g9 + f1 * g8 + f2 * g7 + f3 * g6 + f4 * g5 + f5 * g4 + f6 * g3 + f7 * g2 + f8 * g1 + f9 * g0
    return fe_carry_out(o, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9)

// o = f^2 (mod p): the product above with every off-diagonal pair taken once
// and doubled, 55 products instead of 100.
fe_sqr(o, f)
    f0 = f[0] | 0
    f1 = f[1] | 0
    f2 = f[2] | 0
    f3 = f[3] | 0
    f4 = f[4] | 0
    f5 = f[5] | 0
    f6 = f[6] | 0
    f7 = f[7] | 0
    f8 = f[8] | 0
    f9 = f[9] | 0
    f0_2 = f0 + f0
    f1_2 = f1 + f1
    f2_2 = f2 + f2
    f3_2 = f3 + f3
    f4_2 = f4 + f4
    f5_2 = f5 + f5
    f6_2 = f6 + f6
    f7_2 = f7 + f7
    f5_38 = f5 * 38
    f6_19 = f6 * 19
    f7_38 = f7 * 38
    f8_19 = f8 * 19
    f9_38 = f9 * 38
    h0 = f0 * f0 + f1_2 * f9_38 + f2_2 * f8_19 + f3_2 * f7_38 + f4_2 * f6_19 + f5 * f5_38
    h1 = f0_2 * f1 + f2 * f9_38 + f3_2 * f8_19 + f4 * f7_38 + f5_2 * f6_19
    h2 = f0_2 * f2 + f1_2 * f1 + f3_2 * f9_38 + f4_2 * f8_19 + f5_2 * f7_38 + f6 * f6_19
    h3 = f0_2 * f3 + f1_2 * f2 + f4 * f9_38 + f5_2 * f8_19 + f6 * f7_38
    h4 = f0_2 * f4 + f1_2 * f3_2 + f2 * f2 + f5_2 * f9_38 + f6_2 * f8_19 + f7 * f7_38
    h5 = f0_2 * f5 + f1_2 * f4 + f2_2 * f3 + f6 * f9_38 + f7_2 * f8_19
    h6 = f0_2 * f6 + f1_2 * f5_2 + f2_2 * f4 + f3_2 * f3 + f7_2 * f9_38 + f8 * f8_19
    h7 = f0_2 * f7 + f1_2 * f6 + f2_2 * f5 + f3_2 * f4 + f8 * f9_38
    h8 = f0_2 * f8 + f1_2 * f7_2 + f2_2 * f6 + f3_2 * f5_2 + f4 * f4 + f9 * f9_38
    h9 = f0_2 * f9 + f1_2 * f8 + f2_2 * f7 + f3_2 * f6 + f4_2 * f5
    return fe_carry_out(o, h0, h1, h2, h3, h4, h5, h6, h7, h8, h9)

fe_sqr_n(o, a, n)
    fe_sqr(o, a)
    i = 1
    loop i < n
        fe_sqr(o, o)
        i = i + 1
    return 0

// o = f * 121665, the (A-2)/4 of Curve25519.
fe_mul121665(o, f)
    return fe_carry_out(o, (f[0] | 0) * 121665, (f[1] | 0) * 121665, (f[2] | 0) * 121665, (f[3] | 0) * 121665, (f[4] | 0) * 121665, (f[5] | 0) * 121665, (f[6] | 0) * 121665, (f[7] | 0) * 121665, (f[8] | 0) * 121665, (f[9] | 0) * 121665)

// Exchange a and b when sel is 1, and leave them when it's 0, without
// branching.
fe_cswap(a, b, sel)
    m = 0 - sel
    i = 0
    loop i < 10
        d = (a[i] ^ b[i]) & m
        a[i] = a[i] ^ d
        b[i] = b[i] ^ d
        i = i + 1
    return 0

// ---- encoding ---------------------------------------------------------------

// Bring h to the unique representative in [0, p) and write it as 32
// little-endian bytes. q is floor(h / p) for an h the carry chain has bounded
// (|limb| <= 2^26), found by pushing 19 * h9's rounding through the limbs.
// Adding 19q and dropping bit 255 subtracts qp exactly, without a branch.
fe_tobytes(a)
    h0 = a[0] | 0
    h1 = a[1] | 0
    h2 = a[2] | 0
    h3 = a[3] | 0
    h4 = a[4] | 0
    h5 = a[5] | 0
    h6 = a[6] | 0
    h7 = a[7] | 0
    h8 = a[8] | 0
    h9 = a[9] | 0
    q = (19 * h9 + 16777216) >> 25
    q = (h0 + q) >> 26
    q = (h1 + q) >> 25
    q = (h2 + q) >> 26
    q = (h3 + q) >> 25
    q = (h4 + q) >> 26
    q = (h5 + q) >> 25
    q = (h6 + q) >> 26
    q = (h7 + q) >> 25
    q = (h8 + q) >> 26
    q = (h9 + q) >> 25
    h0 = h0 + 19 * q
    c = h0 >> 26
    h1 = h1 + c
    h0 = h0 - (c << 26)
    c = h1 >> 25
    h2 = h2 + c
    h1 = h1 - (c << 25)
    c = h2 >> 26
    h3 = h3 + c
    h2 = h2 - (c << 26)
    c = h3 >> 25
    h4 = h4 + c
    h3 = h3 - (c << 25)
    c = h4 >> 26
    h5 = h5 + c
    h4 = h4 - (c << 26)
    c = h5 >> 25
    h6 = h6 + c
    h5 = h5 - (c << 25)
    c = h6 >> 26
    h7 = h7 + c
    h6 = h6 - (c << 26)
    c = h7 >> 25
    h8 = h8 + c
    h7 = h7 - (c << 25)
    c = h8 >> 26
    h9 = h9 + c
    h8 = h8 - (c << 26)
    c = h9 >> 25
    h9 = h9 - (c << 25)
    // Every limb is now in [0, 2^26) or [0, 2^25), the ten of them exactly
    // 255 bits, so they pack into the 32 bytes through a running accumulator.
    r = text(10)
    r[0] = h0
    r[1] = h1
    r[2] = h2
    r[3] = h3
    r[4] = h4
    r[5] = h5
    r[6] = h6
    r[7] = h7
    r[8] = h8
    r[9] = h9
    s = bytes(32)
    acc = 0
    nb = 0
    li = 0
    i = 0
    loop i < 32
        loop nb < 8 && li < 10
            acc = acc | (r[li] << nb)
            nb = nb + 26 - (li & 1)
            li = li + 1
        s[i] = acc & 255
        acc = acc >> 8
        nb = nb - 8
        i = i + 1
    return s

// Four little-endian bytes of b from index i, as one integer.
fe_load4(b, i)
    return b[i] | (b[i + 1] << 8) | (b[i + 2] << 16) | (b[i + 3] << 24)

// 32 little-endian bytes to ten limbs at the offsets fe_tobytes writes. Bit 255
// is ignored, as RFC 7748 (section 5) requires of a received u-coordinate: the
// top limb keeps 25 bits and the last byte's high bit isn't among them. Every
// limb comes out non-negative and inside its width, so the element needs no
// carry.
fe_frombytes(o, b)
    o[0] = fe_load4(b, 0) & 67108863
    o[1] = (fe_load4(b, 3) >> 2) & 33554431
    o[2] = (fe_load4(b, 6) >> 3) & 67108863
    o[3] = (fe_load4(b, 9) >> 5) & 33554431
    o[4] = (fe_load4(b, 12) >> 6) & 67108863
    o[5] = fe_load4(b, 16) & 33554431
    o[6] = (fe_load4(b, 19) >> 1) & 67108863
    o[7] = (fe_load4(b, 22) >> 3) & 33554431
    o[8] = (fe_load4(b, 25) >> 4) & 67108863
    o[9] = (fe_load4(b, 28) >> 6) & 33554431
    return 0

// ---- inversion --------------------------------------------------------------

// o = a^(p-2) = a^(2^255 - 21), by the usual addition chain: build 2^k - 1 for
// k = 5, 10, 20, 40, 50, 100, 200, 250 by squaring and multiplying a run onto
// itself, then five more squarings and one multiply by a^11.
fe_invert(o, a)
    z2 = fe_new()
    z9 = fe_new()
    z11 = fe_new()
    t = fe_new()
    u = fe_new()
    fe_sqr(z2, a)
    fe_sqr_n(t, z2, 2)
    fe_mul(z9, t, a)
    fe_mul(z11, z9, z2)
    fe_sqr(t, z11)
    fe_mul(u, t, z9)
    // u = a^(2^5 - 1)
    fe_sqr_n(t, u, 5)
    fe_mul(u, t, u)
    // u = a^(2^10 - 1)
    fe_sqr_n(t, u, 10)
    fe_mul(t, t, u)
    // t = a^(2^20 - 1)
    fe_sqr_n(z2, t, 20)
    fe_mul(t, z2, t)
    // t = a^(2^40 - 1)
    fe_sqr_n(z2, t, 10)
    fe_mul(u, z2, u)
    // u = a^(2^50 - 1)
    fe_sqr_n(t, u, 50)
    fe_mul(t, t, u)
    // t = a^(2^100 - 1)
    fe_sqr_n(z2, t, 100)
    fe_mul(t, z2, t)
    // t = a^(2^200 - 1)
    fe_sqr_n(z2, t, 50)
    fe_mul(u, z2, u)
    // u = a^(2^250 - 1)
    fe_sqr_n(t, u, 5)
    fe_mul(o, t, z11)
    return 0

// ---- the ladder -------------------------------------------------------------

// X25519(scalar, u): the Montgomery ladder of RFC 7748 section 5, one step per
// bit of the clamped scalar, high bit first. Every step does the same work on
// the same two points and the conditional swap decides which is which, so the
// scalar doesn't change the work done.
x25519(scalar, upoint)
    out = bytes(32)
    mk = mark()
    b = x25519_run(scalar, upoint)
    i = 0
    loop i < 32
        out[i] = b[i]
        i = i + 1
    reset(mk)
    return out

// The ladder itself. Its clamped scalar, its fifteen field elements, the
// inversion's five and the encoding's two regions are dead when it returns, so
// the wrapper above copies the answer out and rewinds the arena over all of
// them (SPEC 12.5). The field arithmetic allocates nothing.
x25519_run(scalar, upoint)
    k = bytes(32)
    i = 0
    loop i < 32
        k[i] = scalar[i]
        i = i + 1
    k[0] = k[0] & 248
    k[31] = k[31] & 127
    k[31] = k[31] | 64
    x1 = fe_new()
    fe_frombytes(x1, upoint)
    x2 = fe_new()
    fe_one(x2)
    z2 = fe_new()
    x3 = fe_new()
    fe_copy(x3, x1)
    z3 = fe_new()
    fe_one(z3)
    a = fe_new()
    aa = fe_new()
    b = fe_new()
    bb = fe_new()
    e = fe_new()
    c = fe_new()
    d = fe_new()
    da = fe_new()
    cb = fe_new()
    tt = fe_new()
    swap = 0
    t = 254
    loop t >= 0
        kt = (k[(t >> 3)] >> (t & 7)) & 1
        swap = swap ^ kt
        fe_cswap(x2, x3, swap)
        fe_cswap(z2, z3, swap)
        swap = kt
        fe_add(a, x2, z2)
        fe_sqr(aa, a)
        fe_sub(b, x2, z2)
        fe_sqr(bb, b)
        fe_sub(e, aa, bb)
        fe_add(c, x3, z3)
        fe_sub(d, x3, z3)
        fe_mul(da, d, a)
        fe_mul(cb, c, b)
        fe_add(tt, da, cb)
        fe_sqr(x3, tt)
        fe_sub(tt, da, cb)
        fe_sqr(tt, tt)
        fe_mul(z3, x1, tt)
        fe_mul(x2, aa, bb)
        fe_mul121665(tt, e)
        fe_add(tt, aa, tt)
        fe_mul(z2, e, tt)
        t = t - 1
    fe_cswap(x2, x3, swap)
    fe_cswap(z2, z3, swap)
    fe_invert(tt, z2)
    fe_mul(x2, x2, tt)
    return fe_tobytes(x2)

// X25519 against the standard base point u = 9: the public key for a private
// key, and the client's key_share for a TLS 1.3 handshake.
x25519_base(scalar)
    u = bytes(32)
    u[0] = 9
    return x25519(scalar, u)
// >>> NETLIB MODULE tls >>>
// tls.w: TLS 1.3 (RFC 8446), in word. Needs sha256.w and hmac.w throughout.
// The record layer needs the AEADs (chacha20.w, poly1305.w, aes.w, gcm.w), the
// key exchange needs x25519.w and ecdh.w, and certificate authentication needs
// x509.w, der.w, rsa.w and ecdsa.w.
//
// This is the protocol half of `net`: the key schedule (section 7.1), the
// record layer (section 5) and the handshake messages, with the two steps of
// the client's state machine. It takes and returns byte regions and never
// touches a socket, so a known-answer test can drive the whole layer from
// recorded bytes. net.w owns the socket.
//
// Suites: TLS_CHACHA20_POLY1305_SHA256 is offered first and AES-128-GCM second,
// and the order is a security decision first. word can't emit AES-NI or
// PCLMULQDQ from word source, so its AES-GCM is always the portable software
// one: a state byte indexes a 256-byte S-box, and nibbles of the GHASH operands
// index two more tables, on every CPU (docs/SECURITY.md section 5). ChaCha20 is
// adds, xors and rotates with no secret-indexed table at all, and it's the
// faster of the two here too. AES-128-GCM stays offered because a server may
// accept nothing else. Both suites hash with SHA-256, so the hash is SHA-256
// throughout and every secret is 32 bytes.
//
// A TLS 1.3 server picks from what the client offers and isn't bound by its
// order, so the order is only a preference.

// ---- the key schedule (RFC 8446 section 7.1) --------------------------------
//
//              0
//              |
//     PSK ->  HKDF-Extract = Early Secret
//              |
//              +---> Derive-Secret(., "derived", "")  -+
//                                                       |
//    (EC)DHE ------> HKDF-Extract = Handshake Secret <--+
//              |
//              +---> Derive-Secret(., "c hs traffic", CH..SH)
//              +---> Derive-Secret(., "s hs traffic", CH..SH)
//              |
//              +---> Derive-Secret(., "derived", "")  -+
//                                                       |
//    0 --------------> HKDF-Extract = Master Secret <---+
//              |
//              +---> Derive-Secret(., "c ap traffic", CH..serverFinished)
//              +---> Derive-Secret(., "s ap traffic", CH..serverFinished)
//
// The transcript hash is passed in, not computed here: the caller has the
// recorded handshake bytes and hands over their SHA-256, which keeps the whole
// schedule pure and testable.

// Derive-Secret(Secret, Label, thash) = HKDF-Expand-Label(Secret, Label, thash,
// Hash.length). thash is the 32-byte transcript hash (or the empty hash).
tls13_derive(secret, label, thash)
    return hkdf_expand_label(secret, label, thash, 32)

// SHA-256 of the empty transcript, the context for every "derived" step and for
// a secret taken over no messages.
tls13_empty_hash()
    return sha256(bytes(0))

// Early Secret = HKDF-Extract(salt=0, IKM=PSK). With no pre-shared key both are
// Hash.length zero bytes, so this is the fixed constant every 1-RTT handshake
// starts from (RFC 8448's 33ad0a1c...).
tls13_early_secret()
    return hkdf_extract(bytes(32), bytes(32))

// Handshake Secret = HKDF-Extract(salt=Derive-Secret(Early, "derived", H("")),
// IKM=ECDHE). `ecdhe` is the raw X25519 (or ECDHE) shared secret.
tls13_handshake_secret(ecdhe)
    // The result is allocated before the mark, so the rewind can't reclaim it
    // (SPEC 12.5).
    out = bytes(32)
    mk = mark()
    early = tls13_early_secret()
    derived = tls13_derive(early, "derived", tls13_empty_hash())
    hs = hkdf_extract(derived, ecdhe)
    i = 0
    loop i < 32
        out[i] = hs[i]
        i = i + 1
    reset(mk)
    return out

// Master Secret = HKDF-Extract(salt=Derive-Secret(HS, "derived", H("")), IKM=0).
tls13_master_secret(hs)
    out = bytes(32)
    mk = mark()
    derived = tls13_derive(hs, "derived", tls13_empty_hash())
    ms = hkdf_extract(derived, bytes(32))
    i = 0
    loop i < 32
        out[i] = ms[i]
        i = i + 1
    reset(mk)
    return out

// The client/server handshake traffic secrets over the ClientHello..ServerHello
// transcript hash.
tls13_c_hs_traffic(hs, thash)
    return tls13_derive(hs, "c hs traffic", thash)
tls13_s_hs_traffic(hs, thash)
    return tls13_derive(hs, "s hs traffic", thash)

// The client/server application traffic secrets over the
// ClientHello..server Finished transcript hash.
tls13_c_ap_traffic(ms, thash)
    return tls13_derive(ms, "c ap traffic", thash)
tls13_s_ap_traffic(ms, thash)
    return tls13_derive(ms, "s ap traffic", thash)

// The record-protection key and IV for a traffic secret (RFC 8446 section
// 7.3). keylen is 16 for AES-128-GCM and 32 for ChaCha20, and the IV is always
// 12 bytes.
tls13_write_key(secret, keylen)
    return hkdf_expand_label(secret, "key", bytes(0), keylen)
tls13_write_iv(secret)
    return hkdf_expand_label(secret, "iv", bytes(0), 12)

// The Finished MAC key for a handshake traffic secret (RFC 8446 section 4.4.4).
tls13_finished_key(secret)
    return hkdf_expand_label(secret, "finished", bytes(0), 32)

// ---- the record layer (RFC 8446 section 5) ----------------------------------
//
// A protected record on the wire is
//
//     opaque_type(23) legacy_version(03 03) length(uint16) encrypted_record
//
// where the five header bytes are also the AEAD additional_data, and
// encrypted_record = AEAD-Encrypt(write_key, nonce, header, TLSInnerPlaintext).
// TLSInnerPlaintext is content || real_content_type || zero-padding (5.2), and
// the per-record nonce is the write_iv XOR the sequence number, big-endian and
// right-aligned into the 12 bytes (5.3). Two suites: 0 is
// TLS_CHACHA20_POLY1305_SHA256 and 1 is TLS_AES_128_GCM_SHA256. Both AEADs take
// (key, nonce, aad, data) and return ciphertext||tag, so the record layer is
// the same code over either.

// The suite's AEAD, sealing: (key, 12-byte nonce, aad, plaintext) -> ct||tag.
tls13_aead_seal(suite, key, nonce, aad, pt)
    if suite == 0
        return chacha20_poly1305_encrypt(key, nonce, aad, pt)
    return gcm_encrypt(key, nonce, aad, pt)

// The suite's AEAD, opening: -> plaintext, or the number 0 on a bad tag.
tls13_aead_open(suite, key, nonce, aad, ct)
    if suite == 0
        return chacha20_poly1305_decrypt(key, nonce, aad, ct)
    return gcm_decrypt(key, nonce, aad, ct)

// The per-record nonce (5.3): the 64-bit sequence number, big-endian, XORed into
// the low 8 bytes of the 12-byte write_iv.
tls13_nonce(write_iv, seq)
    nonce = bytes(12)
    i = 0
    loop i < 12
        nonce[i] = write_iv[i]
        i = i + 1
    s = seq
    j = 0
    loop j < 8
        nonce[11 - j] = nonce[11 - j] ^ (s & 255)
        s = s >> 8
        j = j + 1
    return nonce

// The five-byte record header, which is also the AEAD additional_data (5.2).
// enc_len is the length of the encrypted_record: plaintext + content type +
// padding + the 16-byte tag.
tls13_aad(enc_len)
    a = bytes(5)
    a[0] = 23
    a[1] = 3
    a[2] = 3
    a[3] = (enc_len >> 8) & 255
    a[4] = enc_len & 255
    return a

// Seal one record: content of type ctype (a ContentType byte, such as 22
// handshake or 23 application_data) with `npad` trailing zero bytes -> the
// whole wire record, header included. seq is this record's sequence number.
tls13_seal(suite, key, write_iv, seq, content, ctype, npad)
    clen = len(content)
    ilen = clen + 1 + npad
    enc_len = ilen + 16
    // The record is allocated before the mark so the rewind can't reclaim it.
    rec = bytes(5 + enc_len)
    mk = mark()
    inner = bytes(ilen)
    i = 0
    loop i < clen
        inner[i] = content[i]
        i = i + 1
    inner[clen] = ctype
    // The padding bytes are already zero from bytes().
    aad = tls13_aad(enc_len)
    nonce = tls13_nonce(write_iv, seq)
    ct = tls13_aead_seal(suite, key, nonce, aad, inner)
    i = 0
    loop i < 5
        rec[i] = aad[i]
        i = i + 1
    i = 0
    loop i < enc_len
        rec[5 + i] = ct[i]
        i = i + 1
    reset(mk)
    return rec

// Open one wire record -> content || content_type (the last byte is the type),
// or the number 0 if the record is malformed or the tag doesn't verify. The
// caller reads the final byte as the ContentType and the rest as the content.
// The padding is scanned off as section 5.4 says. Everything this allocates
// stays in the arena, so a loop over records should run between mark() and
// reset().
tls13_open(suite, key, write_iv, seq, rec)
    rlen = len(rec)
    if rlen < 5 + 16
        return 0
    aad = bytes(5)
    i = 0
    loop i < 5
        aad[i] = rec[i]
        i = i + 1
    cn = rlen - 5
    ct = bytes(cn)
    i = 0
    loop i < cn
        ct[i] = rec[5 + i]
        i = i + 1
    nonce = tls13_nonce(write_iv, seq)
    inner = tls13_aead_open(suite, key, nonce, aad, ct)
    if inner == 0
        return 0
    // Scan from the end past the zero padding. The first non-zero byte is the
    // content type (5.4), and p ends as the length of content||content_type.
    p = len(inner)
    loop p > 0 && inner[p - 1] == 0
        p = p - 1
    if p == 0
        return 0
    r = bytes(p)
    i = 0
    loop i < p
        r[i] = inner[i]
        i = i + 1
    return r

// ---- the handshake message layer (RFC 8446 section 4) -----------------------
//
// A handshake message is a one-byte HandshakeType, a uint24 length, and that
// many body bytes (section 4). The transcript hash the key schedule takes is
// the SHA-256 of these messages concatenated in order, so the layer is still
// bytes in and bytes out: the ServerHello parse below turns the server's reply
// into the negotiated suite and its key share, the caller runs the key
// exchange and feeds tls13_handshake_secret and the _hs_traffic secrets, and a
// known-answer test drives the whole chain from RFC 8448's recorded ClientHello
// and ServerHello.

// a || b, a fresh region. Used to grow the handshake transcript and to assemble
// the pieces of a message body.
tls13_concat(a, b)
    la = len(a)
    lb = len(b)
    r = bytes(la + lb)
    i = 0
    loop i < la
        r[i] = a[i]
        i = i + 1
    i = 0
    loop i < lb
        r[la + i] = b[i]
        i = i + 1
    return r

// The HandshakeType of a message, or 0 (not a valid type) if it's too short.
tls13_hs_type(msg)
    if len(msg) < 4
        return 0
    return msg[0]

// The declared body length (uint24), or the number -1 if the message is too
// short to carry a header.
tls13_hs_len(msg)
    if len(msg) < 4
        return 0 - 1
    return msg[1] * 65536 + msg[2] * 256 + msg[3]

// The body of a handshake message (the bytes after the 4-byte header), or the
// number 0 if the declared length doesn't fit the region.
tls13_hs_body(msg)
    if len(msg) < 4
        return 0
    blen = msg[1] * 65536 + msg[2] * 256 + msg[3]
    if 4 + blen > len(msg)
        return 0
    b = bytes(blen)
    i = 0
    loop i < blen
        b[i] = msg[4 + i]
        i = i + 1
    return b

// Wrap a body in a handshake header: msg_type, uint24 length, body. The inverse
// of tls13_hs_body, for the messages a client sends.
tls13_hs_message(mtype, body)
    blen = len(body)
    m = bytes(4 + blen)
    m[0] = mtype
    m[1] = (blen >> 16) & 255
    m[2] = (blen >> 8) & 255
    m[3] = blen & 255
    i = 0
    loop i < blen
        m[4 + i] = body[i]
        i = i + 1
    return m

// The body of `msg` when it's a whole ServerHello message (type 2), or the
// number 0. The driver takes the ServerHello out of a single record and asks
// this before anything reads the body. Going straight to tls13_hs_body handed
// its 0 for a length that runs past the record to len() in tls13_is_hrr, and a
// 13-byte reply stopped the program with a fault.
tls13_server_hello_body(msg)
    if tls13_hs_type(msg) != 2
        return 0
    return tls13_hs_body(msg)

// Does the ServerHello body `body` echo `session_id` as its
// legacy_session_id_echo? RFC 8446 section 4.1.3 says a client that gets back
// anything other than the id it sent must abort the handshake. 1 when it does,
// 0 when it doesn't or the body is too short to say.
tls13_echoes_session(body, session_id)
    n = len(session_id)
    if len(body) < 35 + n || body[34] != n
        return 0
    i = 0
    loop i < n
        if body[35 + i] != session_id[i]
            return 0
        i = i + 1
    return 1

// Parse a ServerHello body (4.1.3) -> cells [cipher_suite, group, key_share], or
// the number 0 on anything malformed or not TLS 1.3. Every declared length is
// checked against what's left before it's trusted, so a truncated or lying
// record returns 0 instead of reading out of bounds. `group` and `key_share`
// come from the mandatory key_share extension. The raw share is handed back
// for the caller to run, so this layer doesn't depend on the key exchange.
tls13_parse_server_hello(body)
    blen = len(body)
    // legacy_version(2) + random(32) + one session-id length byte
    if blen < 35
        return 0
    off = 34
    sidlen = body[off]
    off = off + 1 + sidlen
    // cipher_suite(2) + legacy_compression(1) + extensions length(2)
    if off + 5 > blen
        return 0
    suite = body[off] * 256 + body[off + 1]
    off = off + 3
    extlen = body[off] * 256 + body[off + 1]
    off = off + 2
    if off + extlen > blen
        return 0
    ext_end = off + extlen
    group = 0
    ks = 0
    ver_ok = 0
    loop off + 4 <= ext_end
        et = body[off] * 256 + body[off + 1]
        el = body[off + 2] * 256 + body[off + 3]
        off = off + 4
        if off + el > ext_end
            return 0
        if et == 51
            // key_share: NamedGroup(2), key_exchange length(2), key_exchange
            if el >= 4
                group = body[off] * 256 + body[off + 1]
                klen = body[off + 2] * 256 + body[off + 3]
                if klen + 4 <= el
                    ks = bytes(klen)
                    j = 0
                    loop j < klen
                        ks[j] = body[off + 4 + j]
                        j = j + 1
        if et == 43
            // supported_versions in a ServerHello is the one selected version.
            if el == 2 && body[off] == 3 && body[off + 1] == 4
                ver_ok = 1
        off = off + el
    if ks == 0
        return 0
    if ver_ok == 0
        return 0
    r = text(3)
    r[0] = suite
    r[1] = group
    r[2] = ks
    return r

// ---- the server flight and Finished (RFC 8446 sections 4.3, 4.4.4) -----------
//
// After the ServerHello the server's messages arrive encrypted. The record layer
// hands back their plaintext, and one plaintext region may carry several
// handshake messages back to back. tls13_hs_split cuts that byte stream into
// the messages the state machine dispatches: EncryptedExtensions, a
// CertificateRequest if the server wants one, Certificate, CertificateVerify
// and Finished. The Finished's verify_data binds the whole transcript under the
// traffic secret's Finished key. The Certificate and CertificateVerify checks
// are in the next section.

// Split a flight of concatenated handshake messages -> cells where [0] is the
// count and [1..] are the message regions, or the number 0 if the bytes don't
// divide cleanly into whole messages (a truncated trailing message included).
tls13_hs_split(buf)
    blen = len(buf)
    n = 0
    off = 0
    loop off + 4 <= blen
        ml = buf[off + 1] * 65536 + buf[off + 2] * 256 + buf[off + 3]
        if off + 4 + ml > blen
            return 0
        off = off + 4 + ml
        n = n + 1
    if off != blen
        return 0
    r = text(n + 1)
    r[0] = n
    off = 0
    i = 0
    loop i < n
        ml = buf[off + 1] * 65536 + buf[off + 2] * 256 + buf[off + 3]
        m = bytes(4 + ml)
        j = 0
        loop j < 4 + ml
            m[j] = buf[off + j]
            j = j + 1
        r[i + 1] = m
        off = off + 4 + ml
        i = i + 1
    return r

// Has the whole server flight arrived? 1 once a whole Finished (20) is in it, 0
// while more is owed. The flight can span several records, so a message cut
// off at the end of one is still arriving. A Finished closes the flight: the
// server's keys change after it, so nothing later can belong to it, and
// anything that does follow is for tls13_client_process_flight to refuse, not a
// reason to wait for more.
//
// The driver asks this instead of reading tls13_client_process_flight's 0 as
// "not yet", since that 0 also means "refused". Treating a refused flight as
// unfinished reads on for bytes that never come: a CertificateRequest, and a
// certificate the decoder couldn't read, each used to hold a fetch for the
// whole idle deadline and then answer none with nothing said.
tls13_flight_complete(flight)
    n = len(flight)
    off = 0
    loop off + 4 <= n
        ml = flight[off + 1] * 65536 + flight[off + 2] * 256 + flight[off + 3]
        if off + 4 + ml > n
            return 0
        if flight[off] == 20
            return 1
        off = off + 4 + ml
    return 0

// The certificate_request_context of a CertificateRequest body (4.3.2), as a
// byte region, or the number 0 if the body is malformed: a context or an
// extension block that runs past its end, an extension cut short, or bytes left
// over. In a handshake the context shall be empty (it's for post-handshake
// authentication), and it's echoed without being judged, which is what section
// 4.4.2 asks of the reply. The extensions (signature_algorithms,
// certificate_authorities) describe the certificate the server would like, and
// this client has none, so they're bounded and then not read.
tls13_parse_cert_request(body)
    blen = len(body)
    if blen < 3
        return 0
    cl = body[0]
    off = 1 + cl
    if off + 2 > blen
        return 0
    xl = body[off] * 256 + body[off + 1]
    off = off + 2
    if off + xl != blen
        return 0
    loop off + 4 <= blen
        off = off + 4 + body[off + 2] * 256 + body[off + 3]
    if off != blen
        return 0
    return copy(body, 1, 1 + cl)

// The Certificate a client with nothing to present sends back (4.4.2): the
// request's context echoed, then a certificate_list of length zero. No
// CertificateVerify goes with it, since there's no key to sign with, so this is
// the client's whole answer to being asked who it is.
tls13_empty_certificate(ctx)
    cl = len(ctx)
    body = bytes(1 + cl + 3)
    body[0] = cl
    i = 0
    loop i < cl
        body[1 + i] = ctx[i]
        i = i + 1
    // The uint24 list length is already zero from bytes().
    return tls13_hs_message(11, body)

// The Finished verify_data (4.4.4): HMAC(finished_key, transcript_hash), where
// the Finished key comes from the sender's handshake traffic secret and thash is
// the transcript up to but not including this Finished.
tls13_verify_data(secret, thash)
    return hmac_sha256(tls13_finished_key(secret), thash)

// The Finished handshake message a client sends: verify_data wrapped in a header.
tls13_finished(secret, thash)
    return tls13_hs_message(20, tls13_verify_data(secret, thash))

// Verify a received Finished message against the expected transcript hash. The
// compare runs over every byte, every time, so a partly correct forgery leaks
// nothing through timing. -> 1 on a good MAC, 0 on a bad or malformed one.
tls13_check_finished(secret, thash, fin)
    body = tls13_hs_body(fin)
    if body == 0
        return 0
    vd = tls13_verify_data(secret, thash)
    if len(body) != len(vd)
        return 0
    diff = 0
    i = 0
    loop i < len(vd)
        diff = diff | (body[i] ^ vd[i])
        i = i + 1
    if diff != 0
        return 0
    return 1

// ---- the Certificate and CertificateVerify (RFC 8446 sections 4.4.2, 4.4.3) --
//
// The server proves it's who the certificate says by signing the whole
// handshake transcript so far with the certificate's private key. x509.w does
// the certificate itself (parsing the chain, checking it to a trust root,
// matching the host), and this section adds the two TLS 1.3 pieces: the
// Certificate list's wire format, and the framed content a CertificateVerify
// signs.

// Parse a Certificate message body (4.4.2) -> a cells list of parsed
// certificates (x509.w objects), leaf first, or the number 0 on a malformed
// message or a leaf that doesn't parse. Every declared length is bounded
// against what remains, so a truncated or lying message returns 0.
//
// A certificate after the leaf that doesn't parse is left out of the list. RFC
// 8446 section 4.4.2 asks a client to tolerate extraneous certificates, and the
// path search (x509_path) only follows certificates it can read, so one that
// doesn't parse could never have been a link. Failing the whole flight for one
// made a server that also sent, say, an Ed448 certificate unreachable even with
// get(url, true).
tls13_parse_certificate(body)
    blen = len(body)
    if blen < 4
        return 0
    ctxlen = body[0]
    off = 1 + ctxlen
    if off + 3 > blen
        return 0
    listlen = body[off] * 65536 + body[off + 1] * 256 + body[off + 2]
    off = off + 3
    lend = off + listlen
    if lend > blen
        return 0
    // First pass: count entries, bounding every length.
    cnt = 0
    p = off
    loop p < lend
        if p + 3 > lend
            return 0
        cl = body[p] * 65536 + body[p + 1] * 256 + body[p + 2]
        p = p + 3
        if p + cl > lend
            return 0
        p = p + cl
        if p + 2 > lend
            return 0
        el = body[p] * 256 + body[p + 1]
        p = p + 2
        if p + el > lend
            return 0
        p = p + el
        cnt = cnt + 1
    if cnt == 0
        return 0
    // Second pass: copy each cert_data and parse it. The leaf has to parse,
    // since its key is the one the CertificateVerify is checked against.
    r = text(cnt)
    k = 0
    p = off
    i = 0
    loop i < cnt
        cl = body[p] * 65536 + body[p + 1] * 256 + body[p + 2]
        p = p + 3
        d = bytes(cl)
        j = 0
        loop j < cl
            d[j] = body[p + j]
            j = j + 1
        p = p + cl
        el = body[p] * 256 + body[p + 1]
        p = p + 2 + el
        c = x509_parse(d)
        if c == 0
            if i == 0
                return 0
        else
            r[k] = c
            k = k + 1
        i = i + 1
    if k < cnt
        return copy(r, 0, k)
    return r

// The content a CertificateVerify signs (4.4.3): 64 octets of 0x20, a context
// string, a single 0 separator, then the transcript hash up to and including the
// Certificate. context is "TLS 1.3, server CertificateVerify" for a server's
// signature, "TLS 1.3, client CertificateVerify" for a client's.
tls13_cert_verify_content(context, thash)
    clen = len(context)
    tlen = len(thash)
    m = bytes(64 + clen + 1 + tlen)
    i = 0
    loop i < 64
        m[i] = 32
        i = i + 1
    i = 0
    loop i < clen
        m[64 + i] = context[i]
        i = i + 1
    // The separator at m[64 + clen] is already zero from bytes().
    i = 0
    loop i < tlen
        m[64 + clen + 1 + i] = thash[i]
        i = i + 1
    return m

// Verify a CertificateVerify message (4.4.3) against a leaf certificate (a
// parsed x509.w object) and the transcript hash. Dispatches on the
// SignatureScheme: ECDSA on the leaf's curve, or RSA-PSS through rsa.w.
// -> 1 good, 0 otherwise.
//
// RSASSA-PKCS1-v1_5 is refused here. RFC 8446 section 4.4.3 says an RSA
// signature in a handshake message must be PSS whatever signature_algorithms
// lists: the rsa_pkcs1_* schemes are offered only for signatures inside
// certificates (4.2.3), where x509_check_sig still takes them. OpenSSL,
// BoringSSL and Go all abort a handshake that uses one here, and this used to
// accept it.
tls13_check_cert_verify(leaf, cv, thash, context)
    body = tls13_hs_body(cv)
    if body == 0
        return 0
    if len(body) < 4
        return 0
    scheme = body[0] * 256 + body[1]
    siglen = body[2] * 256 + body[3]
    if 4 + siglen > len(body)
        return 0
    sig = bytes(siglen)
    i = 0
    loop i < siglen
        sig[i] = body[4 + i]
        i = i + 1
    content = tls13_cert_verify_content(context, thash)
    // ecdsa_secp256r1_sha256 / secp384r1_sha384 / secp521r1_sha512
    if scheme == 1027 || scheme == 1283 || scheme == 1539
        return tls13_ecdsa_cv(leaf, scheme, sig, content)
    if leaf[12] != 0
        return 0
    nn = leaf[13]
    ee = leaf[14]
    // rsa_pss_rsae_sha{256,384,512}
    if scheme == 2052
        return rsa_pss_verify(nn, ee, sig, content, 0)
    if scheme == 2053
        return rsa_pss_verify(nn, ee, sig, content, 1)
    if scheme == 2054
        return rsa_pss_verify(nn, ee, sig, content, 2)
    return 0

// The ECDSA half of the CertificateVerify check. It's separate because the RSA
// path reads the modulus and exponent straight off the leaf, and this has to
// take the signature apart: TLS carries an ECDSA signature as the DER SEQUENCE
// { INTEGER r, INTEGER s }, and ecdsa_verify wants the two scalars fixed-width
// for the curve.
//
// The scheme names the curve as well as the hash, and it has to agree with the
// key: a P-256 key with ecdsa_secp384r1_sha384 is refused instead of verified
// under whichever curve the code happened to reach for.
tls13_ecdsa_cv(leaf, scheme, sig, content)
    kt = leaf[12]
    // leaf[12]: 1 P-256, 2 P-384, 3 P-521
    nb = 0
    hid = 0
    if scheme == 1027
        if kt != 1
            return 0
        nb = 32
        hid = 0
    else if scheme == 1283
        if kt != 2
            return 0
        nb = 48
        hid = 1
    else if scheme == 1539
        if kt != 3
            return 0
        nb = 66
        hid = 2
    else
        return 0
    sq = der_expect(sig, 0, len(sig), 48)
    if sq == 0
        return 0
    ri = der_expect(sig, sq[1], der_end(sq), 2)
    if ri == 0
        return 0
    si = der_expect(sig, der_end(ri), der_end(sq), 2)
    if si == 0
        return 0
    if der_end(si) != der_end(sq)
        return 0
    r = x509_padn(der_uint(sig, ri), nb)
    t = x509_padn(der_uint(sig, si), nb)
    if r == 0 || t == 0
        return 0
    return ecdsa_verify(kt, leaf[13], rsa_hash(hid, content), r, t)

// Authenticate the server (4.4): the chain must be trusted for the host at time
// t, and the CertificateVerify must sign the transcript with the leaf's key.
// chain is the parsed Certificate list, roots the trust store, and thash the
// transcript up to and including the Certificate. -> 1 only if both hold.
tls13_authenticate(chain, roots, host, t, cv, thash)
    if len(chain) == 0
        return 0
    if x509_verify_chain(chain, roots, host, t) == 0
        return 0
    return tls13_check_cert_verify(chain[0], cv, thash, "TLS 1.3, server CertificateVerify")

// ---- the ClientHello and the client driver (RFC 8446 sections 4.1.2, 4.4) ----
//
// The send direction, and the state machine that ties the receive side
// together. It's two steps because the record keys change between them: after
// the ServerHello, the handshake traffic keys decrypt the rest of the flight,
// and tls13_client_process_flight runs once that flight has been decrypted and
// reassembled. Both steps take transcripts and return secrets and messages,
// with no socket, so a known-answer test drives a whole handshake from RFC
// 8448's recorded bytes.

// A two-byte big-endian length.
tls13_u16(x)
    b = bytes(2)
    b[0] = (x >> 8) & 255
    b[1] = x & 255
    return b

// One extension: type(2) length(2) data.
tls13_ext(t, data)
    return tls13_concat(tls13_concat(tls13_u16(t), tls13_u16(len(data))), data)

// The ECDHE shared secret for a NamedGroup: 29 x25519, 23 secp256r1,
// 24 secp384r1. 0 for a group this client can't do, which a well-behaved server
// never sends, since it only names a group the client offered.
tls13_ecdhe(group, priv, peer)
    if group == 29
        return x25519(priv, peer)
    if group == 23
        return ec_ecdh(1, priv, peer)
    if group == 24
        return ec_ecdh(2, priv, peer)
    return 0

// Is this ServerHello actually a HelloRetryRequest? RFC 8446 section 4.1.3
// gives a retry the ServerHello format and marks it with a fixed random, the
// SHA-256 of the string "HelloRetryRequest". There's no other flag, so this
// comparison is the whole test.
tls13_is_hrr(body)
    if len(body) < 34
        return 0
    magic = "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c"
    i = 0
    loop i < 32
        hi = magic[i * 2]
        lo = magic[i * 2 + 1]
        a = hi - 48
        if hi >= 97
            a = hi - 87
        b = lo - 48
        if lo >= 97
            b = lo - 87
        if body[2 + i] != a * 16 + b
            return 0
        i = i + 1
    return 1

// The [group, cookie, cipher_suite, legacy_session_id_echo] a HelloRetryRequest
// carries, or 0 when it isn't a TLS 1.3 retry at all. Its key_share carries
// only the selected_group, two bytes and no key_exchange, which is what tells
// it apart from an ordinary ServerHello key_share. cookie is 0 when absent.
// What 4.1.3 fixes about the message itself is checked here: legacy_version
// 0x0303, no compression, and supported_versions naming 0x0304. Whether this
// client can answer it is tls13_hrr_check's question.
tls13_parse_hrr(body)
    blen = len(body)
    if blen < 35
        return 0
    if body[0] != 3 || body[1] != 3
        return 0
    off = 34
    sidlen = body[off]
    if sidlen > 32
        return 0
    off = off + 1 + sidlen
    if off + 5 > blen
        return 0
    sid = copy(body, 35, 35 + sidlen)
    suite = body[off] * 256 + body[off + 1]
    if body[off + 2] != 0
        return 0
    off = off + 3
    extlen = body[off] * 256 + body[off + 1]
    off = off + 2
    if off + extlen > blen
        return 0
    ext_end = off + extlen
    group = 0
    cookie = 0
    ver_ok = 0
    loop off + 4 <= ext_end
        et = body[off] * 256 + body[off + 1]
        el = body[off + 2] * 256 + body[off + 3]
        off = off + 4
        if off + el > ext_end
            return 0
        if et == 51 && el == 2
            group = body[off] * 256 + body[off + 1]
        if et == 44 && el >= 2
            cl = body[off] * 256 + body[off + 1]
            if cl + 2 <= el
                cookie = bytes(cl)
                j = 0
                loop j < cl
                    cookie[j] = body[off + 2 + j]
                    j = j + 1
        if et == 43 && el == 2 && body[off] == 3 && body[off + 1] == 4
            ver_ok = 1
        off = off + el
    if group == 0 || ver_ok == 0
        return 0
    r = text(4)
    r[0] = group
    r[1] = cookie
    r[2] = suite
    r[3] = sid
    return r

// Can this client answer the HelloRetryRequest `hr` (tls13_parse_hrr's
// answer)? RFC 8446 sections 4.1.3, 4.1.4 and 4.2.8 say what a client must
// check before it sends a second ClientHello, and must abort over: the cipher
// suite is one the ClientHello offered, the session id is the one it sent, and
// the group is one it listed in supported_groups without already sending a
// share for it (`sent_group`). 1 when all of that holds, 0 when the handshake
// is over.
tls13_hrr_check(hr, session_id, sent_group)
    // TLS_CHACHA20_POLY1305_SHA256 and TLS_AES_128_GCM_SHA256, the two
    // tls13_client_hello_g offers. Both hash with SHA-256, the hash
    // tls13_hrr_transcript builds the retry's transcript with.
    s = hr[2]
    if s != 4867 && s != 4865
        return 0
    echo = hr[3]
    if len(echo) != len(session_id)
        return 0
    i = 0
    loop i < len(echo)
        if echo[i] != session_id[i]
            return 0
        i = i + 1
    // x25519, secp256r1 and secp384r1 are the supported_groups offered.
    g = hr[0]
    if g == sent_group
        return 0
    if g != 29 && g != 23 && g != 24
        return 0
    return 1

// The synthetic transcript a retry uses (RFC 8446 section 4.4.1): the first
// ClientHello is replaced by message_hash || 00 00 32 || Hash(ClientHello1), so
// a server that kept no state can still rebuild what was hashed.
tls13_hrr_transcript(ch1, hrr, ch2)
    synth = bytes(4)
    synth[0] = 254
    synth[3] = 32
    pre = tls13_concat(synth, sha256(ch1))
    return tls13_concat(tls13_concat(pre, hrr), ch2)

// A first-flight ClientHello (4.1.2) with an X25519 key_share and no cookie,
// offering TLS_CHACHA20_POLY1305_SHA256 and TLS_AES_128_GCM_SHA256. random and
// session_id are 32 bytes each, pubkey is the client's X25519 share, and host,
// if it isn't empty, becomes the SNI. The mandatory TLS 1.3 extensions are all
// there: server_name, supported_groups, signature_algorithms,
// supported_versions and key_share.
tls13_client_hello(random, session_id, pubkey, host)
    return tls13_client_hello_g(random, session_id, 29, pubkey, host, 0)

// The general form. `group` is the NamedGroup the key_share carries (29
// x25519, 23 secp256r1, 24 secp384r1), and `cookie` is the HelloRetryRequest
// cookie to echo, or 0. A retry differs from a first flight in just these two
// places (RFC 8446 section 4.1.2), so there's one encoder.
tls13_client_hello_g(random, session_id, group, pubkey, host, cookie)
    exts = bytes(0)
    if len(host) > 0
        // server_name: ServerNameList = u16(list) host_name(type 0, u16 len, name)
        namerec = tls13_concat(tls13_u16(len(host)), host)
        typed = bytes(1 + len(namerec))
        i = 0
        loop i < len(namerec)
            typed[1 + i] = namerec[i]
            i = i + 1
        snl = tls13_concat(tls13_u16(len(typed)), typed)
        exts = tls13_concat(exts, tls13_ext(0, snl))
    // supported_groups: x25519 (0x001d) first, the key_share's guess, then
    // secp256r1 and secp384r1. A server that wants one of the NIST curves
    // answers with a HelloRetryRequest naming it, and without them listed it
    // could only fail.
    sg = tls13_concat(tls13_u16(6), tls13_concat(tls13_concat(tls13_u16(29), tls13_u16(23)), tls13_u16(24)))
    exts = tls13_concat(exts, tls13_ext(10, sg))
    // signature_algorithms: ECDSA first, then rsa_pss, then rsa_pkcs1, each over
    // SHA-256, SHA-384 and SHA-512. A server holding an ECDSA certificate, as a
    // lot of the public web does, finds nothing it can sign with when ECDSA
    // isn't offered, and aborts the handshake before sending a certificate.
    // When this client offered RSA only, it couldn't reach those sites, and the
    // failure looked like a verification problem.
    //
    // ecdsa_secp256r1_sha256 0403, secp384r1_sha384 0503, secp521r1_sha512 0603
    // rsa_pss_rsae_*         0804 0805 0806
    // rsa_pkcs1_*            0401 0501 0601
    schemes = bytes(18)
    schemes[0] = 4
    schemes[1] = 3
    schemes[2] = 5
    schemes[3] = 3
    schemes[4] = 6
    schemes[5] = 3
    schemes[6] = 8
    schemes[7] = 4
    schemes[8] = 8
    schemes[9] = 5
    schemes[10] = 8
    schemes[11] = 6
    schemes[12] = 4
    schemes[13] = 1
    schemes[14] = 5
    schemes[15] = 1
    schemes[16] = 6
    schemes[17] = 1
    exts = tls13_concat(exts, tls13_ext(13, tls13_concat(tls13_u16(18), schemes)))
    // supported_versions: the list form a ClientHello uses, u8(len) 0x0304.
    sv = bytes(3)
    sv[0] = 2
    sv[1] = 3
    sv[2] = 4
    exts = tls13_concat(exts, tls13_ext(43, sv))
    // key_share: one KeyShareEntry, for `group`.
    entry = tls13_concat(tls13_concat(tls13_u16(group), tls13_u16(len(pubkey))), pubkey)
    exts = tls13_concat(exts, tls13_ext(51, tls13_concat(tls13_u16(len(entry)), entry)))
    // cookie (extension 44): echoed as it came, which is what lets a server
    // keep no state between the two flights.
    if kind(cookie) != "number"
        exts = tls13_concat(exts, tls13_ext(44, tls13_concat(tls13_u16(len(cookie)), cookie)))
    // The body. The cipher suites are 0x1303 (ChaCha20) then 0x1301.
    ver = bytes(2)
    ver[0] = 3
    ver[1] = 3
    sidlen = bytes(1)
    sidlen[0] = len(session_id)
    cs = bytes(4)
    cs[0] = 19
    cs[1] = 3
    cs[2] = 19
    cs[3] = 1
    comp = bytes(2)
    comp[0] = 1
    comp[1] = 0
    body = tls13_concat(ver, random)
    body = tls13_concat(body, tls13_concat(sidlen, session_id))
    body = tls13_concat(body, tls13_concat(tls13_u16(4), cs))
    body = tls13_concat(body, comp)
    body = tls13_concat(body, tls13_concat(tls13_u16(len(exts)), exts))
    return tls13_hs_message(1, body)

// Step one of the client state machine: from the ClientHello it sent, its X25519
// private key and the ServerHello, derive the handshake traffic secrets over
// the ClientHello..ServerHello transcript. -> cells [cipher_suite, c_hs_traffic,
// s_hs_traffic, handshake_secret], or 0 if the ServerHello is malformed or names
// a group other than x25519.
tls13_client_handshake_keys(client_hello, priv, server_hello)
    return tls13_client_handshake_keys_g(client_hello, 29, priv, server_hello)

// The general form: `transcript` is everything hashed before this ServerHello
// (the ClientHello, or the synthetic transcript of 4.4.1 after a retry), and
// `group` is the NamedGroup the key exchange is on. The ServerHello must have
// selected that group: a share for anything else answers a question the client
// didn't ask.
tls13_client_handshake_keys_g(transcript, group, priv, server_hello)
    client_hello = transcript
    shb = tls13_hs_body(server_hello)
    if shb == 0
        return 0
    psh = tls13_parse_server_hello(shb)
    if psh == 0
        return 0
    if psh[1] != group
        return 0
    ecdhe = tls13_ecdhe(group, priv, psh[2])
    if kind(ecdhe) == "number"
        return 0
    thash = sha256(tls13_concat(client_hello, server_hello))
    hs = tls13_handshake_secret(ecdhe)
    r = text(4)
    r[0] = psh[0]
    r[1] = tls13_c_hs_traffic(hs, thash)
    r[2] = tls13_s_hs_traffic(hs, thash)
    r[3] = hs
    return r

// Step two: process the decrypted server flight (EncryptedExtensions, an
// optional CertificateRequest, Certificate, CertificateVerify and Finished,
// back to back). This verifies the server Finished over the transcript.
// Certificate authentication is the caller's separate step, so the parsed
// chain, the CertificateVerify message and the transcript hash through the
// Certificate are handed back for it. -> cells [client_flight, c_ap_traffic,
// s_ap_traffic, chain, certificate_verify, th_through_certificate], or 0 if the
// flight is malformed or the server Finished doesn't verify. client_flight is
// everything the client sends back under its handshake keys: its Finished and,
// when the server asked, an empty Certificate ahead of it.
tls13_client_process_flight(client_hello, server_hello, flight, hs, c_hs, s_hs)
    sp = tls13_hs_split(flight)
    if sp == 0
        return 0
    // A CertificateRequest comes between the EncryptedExtensions and the
    // Certificate (4.3.2) or not at all, so a flight of five carries one as its
    // second message and the other four keep their order around it.
    k = 2
    if sp[0] == 5
        k = 3
    else if sp[0] != 4
        return 0
    ee = sp[1]
    cert = sp[k]
    cv = sp[k + 1]
    sfin = sp[k + 2]
    if tls13_hs_type(ee) != 8
        return 0
    if tls13_hs_type(cert) != 11
        return 0
    if tls13_hs_type(cv) != 15
        return 0
    if tls13_hs_type(sfin) != 20
        return 0
    // The server's parameters, what it put before its Certificate: the
    // EncryptedExtensions, and the CertificateRequest when there is one. Both
    // are in the transcript its CertificateVerify signs and its Finished MACs,
    // so leaving the request out makes a handshake whose server can't be
    // verified.
    params = ee
    ctx = 0
    if k == 3
        creq = sp[2]
        if tls13_hs_type(creq) != 13
            return 0
        ctx = tls13_parse_cert_request(tls13_hs_body(creq))
        if kind(ctx) == "number"
            return 0
        params = tls13_concat(ee, creq)
    base = tls13_concat(client_hello, server_hello)
    pre_cert = tls13_concat(tls13_concat(base, params), cert)
    th_cert = sha256(pre_cert)
    pre_cv = tls13_concat(pre_cert, cv)
    // The server Finished MACs the transcript up to and including the
    // CertificateVerify.
    if tls13_check_finished(s_hs, sha256(pre_cv), sfin) == 0
        return 0
    pre_sf = tls13_concat(pre_cv, sfin)
    th_after = sha256(pre_sf)
    chain = tls13_parse_certificate(tls13_hs_body(cert))
    if chain == 0
        return 0
    ms = tls13_master_secret(hs)
    // What the client sends back. Asked for a certificate, it has none to give,
    // and RFC 8446 section 4.4.2 says what it does then: a Certificate with an
    // empty list and no CertificateVerify, then its Finished, over a transcript
    // that now ends with that Certificate, so the Finished covers it too
    // (4.4.4). The application secrets don't move: 7.1 takes them at the
    // server's Finished, before anything the client says. What a server does
    // with an empty Certificate is its own choice (4.4.2.4): carry on without
    // client authentication, or refuse with certificate_required (116).
    if kind(ctx) == "number"
        reply = tls13_finished(c_hs, th_after)
    else
        ccert = tls13_empty_certificate(ctx)
        reply = tls13_concat(ccert, tls13_finished(c_hs, sha256(tls13_concat(pre_sf, ccert))))
    r = text(6)
    r[0] = reply
    r[1] = tls13_c_ap_traffic(ms, th_after)
    r[2] = tls13_s_ap_traffic(ms, th_after)
    r[3] = chain
    r[4] = cv
    r[5] = th_cert
    return r
// >>> NETLIB MODULE dns >>>
// dns.w: turning a host name into an IPv4 address, in word.
//
// This is the one piece of `net` that has to talk to something before TLS can
// start, and it's the smallest thing that answers the question: one A-record
// query, over UDP, and over TCP when the answer is truncated (the TC bit) or
// UDP gets no answer at all.
//
// RFC 7766 makes TCP support mandatory for resolvers, which says nothing about
// the networks in between. One build environment answered UDP/53 and blocked
// TCP/53 outright, so the first version, TCP only, couldn't resolve a name
// there while every other client could. The message is the same either way,
// with a two-byte length in front of it on TCP.
//
// Nothing here trusts the response. A name is attacker-influenced input and a
// resolver's answer is unauthenticated, so every length is checked against the
// buffer before it's read, and compression pointers are stepped over, never
// followed. What DNS can't do is make the answer trustworthy. Over https that's
// the certificate's job, and a wrong answer fails at the handshake. Over http
// nothing catches it.

// `a` followed by `b`, as a new byte region. dns.w has its own instead of
// calling tls13_concat, so it depends on nothing above the socket (dns_kat
// builds it on its own).
dns_concat(a, b)
    la = len(a)
    lb = len(b)
    r = bytes(la + lb)
    i = 0
    loop i < la
        r[i] = a[i]
        i = i + 1
    i = 0
    loop i < lb
        r[la + i] = b[i]
        i = i + 1
    return r

// A 16-bit big-endian value, as two bytes.
dns_u16(v)
    r = bytes(2)
    r[0] = (v >> 8) & 255
    r[1] = v & 255
    return r

// The two bytes at `off` read big-endian, or 0 past the end. Callers bound
// `off` themselves, and this is only the read.
dns_be16(b, off)
    if off + 2 > len(b)
        return 0
    return (b[off] << 8) | b[off + 1]

// `host` as a DNS QNAME: each dot-separated label prefixed by its length, then
// a zero byte. Returns 0 for a name no query could carry: an empty or
// oversized label (a trailing dot included), or a name that's empty or longer
// than 253 characters.
dns_encode_name(host)
    n = len(host)
    if n == 0 || n > 253
        return 0
    out = bytes(n + 2)
    w = 0
    start = 0
    i = 0
    loop i <= n
        if i == n || host[i] == 46
            ll = i - start
            // A label is 1..63 bytes. A zero-length one is the empty label that
            // ends the name, and the zero byte after the loop writes that one.
            if ll == 0 || ll > 63
                return 0
            out[w] = ll
            w = w + 1
            j = start
            loop j < i
                out[w] = host[j] & 255
                w = w + 1
                j = j + 1
            start = i + 1
        i = i + 1
    out[w] = 0
    w = w + 1
    return copy(out, 0, w)

// A complete A-record query for `host` with query id `id`: header, then one
// question. Recursion desired, one question, no other sections.
dns_query(host, id)
    qname = dns_encode_name(host)
    if kind(qname) == "number"
        return 0
    hdr = bytes(12)
    hdr[0] = (id >> 8) & 255
    hdr[1] = id & 255
    // 0x0100: a standard query, recursion desired.
    hdr[2] = 1
    hdr[3] = 0
    hdr[5] = 1
    q = dns_concat(hdr, qname)
    // QTYPE 1 (A), QCLASS 1 (IN)
    return dns_concat(q, dns_concat(dns_u16(1), dns_u16(1)))

// The offset just past the name starting at `off`. A name is a run of labels
// ending either in a zero byte or in a compression pointer, which is two bytes
// and always ends the name, so this never follows one, it only steps over it.
// Returns 0 if the name runs past the end of the buffer, or has a label byte
// that's neither a length of 63 or less nor a pointer.
dns_skip_name(b, off)
    n = len(b)
    p = off
    loop p < n
        l = b[p]
        if l == 0
            return p + 1
        if (l & 192) == 192
            if p + 2 > n
                return 0
            return p + 2
        if l > 63
            return 0
        p = p + 1 + l
    return 0

// The first A record in `resp`, as a four-byte region, or 0 if there's none.
// `resp` is the DNS message, with the length prefix already stripped when it
// came over TCP.
//
// The id is the caller's to check. The rest is checked here: the response bit,
// the RCODE, and every length against the buffer, through the questions and
// the answers. An answer of another type or class is skipped instead of
// refused, since a CNAME chain ahead of the A record is ordinary.
dns_parse_a(resp)
    n = len(resp)
    if n < 12
        return 0
    // QR must be set: this has to be a response, not a reflected query.
    if (resp[2] & 128) == 0
        return 0
    // RCODE 0 is the only one carrying an address.
    if (resp[3] & 15) != 0
        return 0
    qd = dns_be16(resp, 4)
    an = dns_be16(resp, 6)
    if an == 0
        return 0
    p = 12
    i = 0
    loop i < qd
        p = dns_skip_name(resp, p)
        if p == 0
            return 0
        // QTYPE + QCLASS
        p = p + 4
        if p > n
            return 0
        i = i + 1
    i = 0
    loop i < an
        p = dns_skip_name(resp, p)
        if p == 0
            return 0
        // TYPE(2) CLASS(2) TTL(4) RDLENGTH(2)
        if p + 10 > n
            return 0
        rtype = dns_be16(resp, p)
        rclass = dns_be16(resp, p + 2)
        rdlen = dns_be16(resp, p + 8)
        p = p + 10
        if p + rdlen > n
            return 0
        if rtype == 1 && rclass == 1 && rdlen == 4
            return copy(resp, p, p + 4)
        p = p + rdlen
        i = i + 1
    return 0

// `s` as a dotted quad, or 0 if it isn't one. A literal address needs no
// resolver, and without this shortcut https://127.0.0.1/ would send the
// characters "127.0.0.1" to a DNS server and fail on NXDOMAIN.
dns_dotted_quad(s)
    n = len(s)
    if n < 7 || n > 15
        return 0
    ip = bytes(4)
    part = 0
    digits = 0
    seen = 0
    i = 0
    loop i < n
        c = s[i]
        if c == 46
            if digits == 0 || seen > 2
                return 0
            ip[seen] = part
            seen = seen + 1
            part = 0
            digits = 0
        else
            if c < 48 || c > 57
                return 0
            part = part * 10 + (c - 48)
            if part > 255
                return 0
            digits = digits + 1
            if digits > 3
                return 0
        i = i + 1
    if digits == 0 || seen != 3
        return 0
    ip[3] = part
    return ip

// The resolver to ask: the one the host names. A compiled program resolves
// names the way the rest of the host does (internal and split-horizon zones, a
// loopback stub resolver), and 1.1.1.1 is only for a host that doesn't say.
//
// Where the OS keeps its resolvers behind an API, sys.nameservers() lists them
// and the first IPv4 address there is the one. That's Windows, where they're
// the adapters' and GetNetworkParams answers for them. Everywhere else it's the
// first `nameserver <dotted quad>` in /etc/resolv.conf. Either way 1.1.1.1
// stands when nothing usable is named: no file, no readable line, only an IPv6
// resolver, or an OS that lists none.
//
// Where the OS answers, the file isn't read at all, first or as a fallback. On
// Windows "/etc/resolv.conf" is \etc\resolv.conf at the root of the current
// drive, and any signed-in user may create C:\etc, so reading it would hand
// them the resolver of every program run from that drive, by anyone. That's
// why a list with nothing usable in it ends at 1.1.1.1 instead of at the file.
dns_server()
    os = nameservers()
    if kind(os) != "none"
        lines = split(decode(os), "\n")
        i = 0
        loop i < len(lines)
            cand = dns_dotted_quad(lines[i])
            if kind(cand) != "number"
                return cand
            i = i + 1
        return dns_default_server()
    conf = read("/etc/resolv.conf")
    if kind(conf) != "none"
        lines = split(decode(conf), "\n")
        i = 0
        loop i < len(lines)
            cand = dns_conf_line(lines[i])
            if kind(cand) != "number"
                return cand
            i = i + 1
    return dns_default_server()

// The address a resolv.conf line names, as four bytes, or 0 when it isn't a
// `nameserver` line with an IPv4 address on it. Read the way glibc reads it:
// the keyword starts the line and a space or a tab follows it, and the address
// is the next word, which ends at the first space or tab (or the CR of a CRLF
// file). Whatever comes after it, a comment included, is ignored. When the
// whole rest of the line had to be the address, a trailing space or comment
// sent word to 1.1.1.1 while every other program on the host asked the
// resolver the file named.
dns_conf_line(ln)
    // "nameserver" is ten characters. The keyword has to start the line:
    // resolv.conf(5) requires it, and glibc's parser never skips leading
    // whitespace either, so an indented line isn't a directive and isn't read
    // as one.
    if len(ln) < 12 || ln[0] != 110 || ln[1] != 97 || ln[2] != 109 || ln[3] != 101 || ln[4] != 115 || ln[5] != 101 || ln[6] != 114 || ln[7] != 118 || ln[8] != 101 || ln[9] != 114
        return 0
    if ln[10] != 32 && ln[10] != 9
        return 0
    j = 11
    loop j < len(ln) && (ln[j] == 32 || ln[j] == 9)
        j = j + 1
    e = j
    loop e < len(ln) && ln[e] != 32 && ln[e] != 9 && ln[e] != 13
        e = e + 1
    return dns_dotted_quad(copy(ln, j, e))

// 1.1.1.1: the resolver for a host that doesn't name one.
dns_default_server()
    d = bytes(4)
    d[0] = 1
    d[1] = 1
    d[2] = 1
    d[3] = 1
    return d

// Whether `host` is `localhost` or a name under it, in any case and with or
// without the dot that ends a fully qualified name. RFC 6761 section 6.3
// reserves them all for the loopback address and asks a resolver library to
// answer them itself instead of sending them to a DNS server, which may not
// answer the name with an address at all (sent out like any other name,
// localhost didn't resolve on Windows) and has no business being told what a
// program on this machine is connecting to.
//
// "localhost" is compared against the end of the name, so a name under it
// matches too. The character before it has to end a label, so `mylocalhost` is
// an ordinary name, and there has to be a label there, so `.localhost` isn't a
// name at all and fails where any malformed name does.
dns_is_localhost(host)
    n = len(host)
    if n > 0 && host[n - 1] == 46
        n = n - 1
    if n < 9
        return false
    w = "localhost"
    i = 0
    loop i < 9
        c = host[n - 9 + i]
        if c >= 65 && c <= 90
            c = c + 32
        if c != w[i]
            return false
        i = i + 1
    return n == 9 || (n > 10 && host[n - 10] == 46)

// `host` as a four-byte IPv4 address, or the number 0 if it can't be
// resolved. A dotted quad answers itself, and so does localhost.
dns_resolve(host)
    lit = dns_dotted_quad(host)
    if kind(lit) != "number"
        return lit
    if dns_is_localhost(host)
        lo = bytes(4)
        lo[0] = 127
        lo[1] = 0
        lo[2] = 0
        lo[3] = 1
        return lo
    id = random() & 65535
    msg = dns_query(host, id)
    if kind(msg) == "number"
        return 0
    srv = dns_server()
    resp = dns_ask_udp(srv, msg, id)
    // A truncated answer (TC) is the one case the protocol says to retry over
    // TCP. A resolver that can't be reached over UDP at all is the other.
    if kind(resp) == "number"
        resp = dns_ask_tcp(srv, 53, msg, id)
        if kind(resp) == "number"
            return 0
    return dns_parse_a(resp)

// One query over UDP. A datagram socket needs no handshake, so nothing here
// waits on an unreachable peer the way a TCP connect() does, and timeout()
// bounds the read, so a resolver that never answers costs three seconds. (The
// TCP retry that follows is bounded too: connect() gives up after ten seconds,
// and the answer has five more to arrive in.) Returns the response message, or
// 0 when there's none, its id is wrong or it was truncated.
dns_ask_udp(srv, msg, id)
    fd = udp(srv, 53)
    if fd == 0
        return 0
    timeout(fd, 3000)
    if send(fd, msg) != len(msg)
        close(fd)
        return 0
    buf = bytes(1500)
    g = recv(fd, buf)
    close(fd)
    if g < 12
        return 0
    body = copy(buf, 0, g)
    if dns_be16(body, 0) != id
        return 0
    // TC: the answer didn't fit in a datagram, so ask again over TCP.
    if (body[2] & 2) != 0
        return 0
    return body

// The same query over TCP, for an answer too big for a datagram or a resolver
// UDP couldn't reach. The message is preceded by its own 16-bit length in both
// directions, and an answer shorter than a header or longer than 4096 bytes is
// refused. `port` is 53 for a real lookup, and it's a parameter so a test can
// stand up a resolver without root.
//
// The answer gets dns_tcp_ms() in all, not per read. The socket gives a
// deadline per read, and a resolver that trickles a byte at a time never trips
// one: before the answer had a budget of its own, a trickled one held the
// lookup for as long as the resolver kept trickling.
dns_ask_tcp(srv, port, msg, id)
    fd = connect(srv, port)
    if fd == 0
        return 0
    timeout(fd, dns_tcp_ms())
    tend = now() + dns_tcp_ms() * 1000000
    framed = dns_concat(dns_u16(len(msg)), msg)
    if !dns_await(fd, tend, dns_tcp_ms()) || send(fd, framed) != len(framed)
        close(fd)
        return 0
    hdr = dns_recvn(fd, 2, tend, dns_tcp_ms())
    if kind(hdr) == "number"
        close(fd)
        return 0
    want = dns_be16(hdr, 0)
    if want < 12 || want > 4096
        close(fd)
        return 0
    body = dns_recvn(fd, want, tend, dns_tcp_ms())
    close(fd)
    if kind(body) == "number"
        return 0
    if dns_be16(body, 0) != id
        return 0
    return body

// How long a TCP answer may take, from the moment the connection is up: the
// query and the whole answer, in milliseconds.
dns_tcp_ms()
    return 5000

// Before a read or write that `tend` (a now() value) has to bound: false once
// `tend` has passed. Otherwise true, with the socket's own deadline (`idle`
// milliseconds, which the caller set) brought in to `tend` when `tend` comes
// first. The socket's deadline bounds one call, and this bounds a run of them,
// which is all a peer that trickles has to get past.
//
// What's left goes to whole milliseconds without `/`, which may answer a float
// and so would bring float support into every program that fetches. 2^20 ns is
// a little over a millisecond, so q is a little under the count and q + q/16 a
// little over it. The 20 ms is for a socket deadline firing up to a scheduler
// tick early: one that fired before `tend` would read as the peer hanging up.
// So the deadline this sets is late by at most 1.4% of what was left, plus
// 20 ms, and never early.
dns_await(fd, tend, idle)
    left = tend - now()
    if left <= 0
        return false
    q = (left >> 20) + 1
    ms = q + (q >> 4) + 20
    if ms < idle
        timeout(fd, ms)
    return true

// Exactly `n` bytes from `fd`, or the number 0 if the peer closed first, or 1
// if `tend` passed first. One recv is one read, and a short return is normal.
// That's how a peer trickles, and why `tend` is checked before every read
// instead of once per message. `idle` is the socket deadline the caller set
// (dns_await). A read that ends empty once `tend` has passed is the deadline,
// not the peer, since a timed-out read and a closed peer look the same.
dns_recvn(fd, n, tend, idle)
    out = bytes(n)
    got = 0
    loop got < n
        if !dns_await(fd, tend, idle)
            return 1
        buf = bytes(n - got)
        g = recv(fd, buf)
        if g == 0
            if now() >= tend
                return 1
            return 0
        i = 0
        loop i < g
            out[got + i] = buf[i]
            i = i + 1
        got = got + g
    return out
// >>> NETLIB MODULE http >>>
// http.w: HTTP/1.1 request building and response parsing, in word.
//
// The part of `net` above the socket and below the caller: it turns a URL into
// a request, and a response into a body. It does no I/O (the driver owns the
// socket and the TLS records), so every rule here can be tested against a
// fixture instead of a server.
//
// A response is attacker-controlled, so the parser stays simple: every length
// is bounded by the buffer, a header value is found by scanning the head line
// by line, and a chunk size that would run past the end ends the body. It
// doesn't judge the response: a 404's body comes back like any other.
//
// A URL is chosen by the program, and often by whoever the program took it
// from, so the request side is just as careful the other way: nothing in a URL
// reaches the request line or the Host header unless it's a character those
// can carry, and anything else is refused before a byte is sent.

// The lowercase of an ASCII letter, and any other byte unchanged.
http_lower(c)
    if c >= 65 && c <= 90
        return c + 32
    return c

// Does `lit` appear at `off` in `b`, compared case-insensitively? Header names
// are case-insensitive in HTTP, and a server is free to send `content-length`.
http_ieq_at(b, off, lit)
    n = len(lit)
    if off + n > len(b)
        return 0
    i = 0
    loop i < n
        if http_lower(b[off + i]) != http_lower(lit[i])
            return 0
        i = i + 1
    return 1

// The offset of the first `\r\n\r\n` in `b` at or after `s` and before `n`, or
// 0 - 1 if there's none yet. That's where a head stops and its body starts.
// `n` is how much of `b` is live, which isn't len(b) while a response is still
// being read into spare capacity.
http_header_end(b, s, n)
    i = s
    loop i + 4 <= n
        if b[i] == 13 && b[i + 1] == 10 && b[i + 2] == 13 && b[i + 3] == 10
            return i
        i = i + 1
    return 0 - 1

// The status code on the status line starting at `s`, or 0 if it isn't
// `HTTP/1.x NNN`.
http_status(b, s)
    if http_ieq_at(b, s, "HTTP/1.") == 0
        return 0
    if s + 12 > len(b)
        return 0
    // "HTTP/1.1 " is nine bytes, and the code is the three that follow.
    i = s + 9
    code = 0
    d = 0
    loop d < 3
        c = b[i + d]
        if c < 48 || c > 57
            return 0
        code = code * 10 + (c - 48)
        d = d + 1
    return code

// The first header line of the head that starts at `s` and ends at `hend` (the
// offset http_header_end gave): the offset just past the status line.
http_first_field(b, s, hend)
    p = s
    loop p + 1 < hend + 2 && (b[p] != 13 || b[p + 1] != 10)
        p = p + 1
    return p + 2

// The end of the header line starting at `p`: the offset of its CRLF. The last
// line's CRLF is the one at `hend`.
http_line_end(b, p, hend)
    e = p
    loop e + 1 < hend + 2 && (b[e] != 13 || b[e + 1] != 10)
        e = e + 1
    return e

// Is the line at `p` (ending at `e`) the header `name`? Its name, then a colon.
http_is_field(b, p, e, name)
    if http_ieq_at(b, p, name) == 0
        return 0
    if p + len(name) >= e
        return 0
    if b[p + len(name)] != 58
        return 0
    return 1

// `b[a..z)` with the whitespace around it removed, as [a, z].
http_trim(b, a, z)
    loop a < z && (b[a] == 32 || b[a] == 9)
        a = a + 1
    loop z > a && (b[z - 1] == 32 || b[z - 1] == 9)
        z = z - 1
    r = text(2)
    r[0] = a
    r[1] = z
    return r

// The value of header `name` in the head [s, hend), as a byte region without
// the whitespace around it (RFC 9110 section 5.5), or 0 if the head doesn't
// carry it. It scans line by line, so a header name inside an earlier value
// can't be taken for the header itself.
http_header(b, s, hend, name)
    p = http_first_field(b, s, hend)
    loop p < hend
        e = http_line_end(b, p, hend)
        if http_is_field(b, p, e, name) == 1
            t = http_trim(b, p + len(name) + 1, e)
            return copy(b, t[0], t[1])
        p = e + 2
    return 0

// A decimal byte region as a number, or 0 - 1 if it isn't one to eighteen
// digits. An absent or malformed Content-Length means an unknown length, so
// it can't come back as 0. Eighteen digits hold any length or port there is without the arithmetic
// overflowing. Before the limit, thirty nines from a server stopped the whole
// program with an integer overflow, where they're only a malformed response.
http_num(v)
    if kind(v) == "number"
        return 0 - 1
    n = len(v)
    if n == 0 || n > 18
        return 0 - 1
    r = 0
    i = 0
    loop i < n
        c = v[i]
        if c < 48 || c > 57
            return 0 - 1
        r = r * 10 + (c - 48)
        i = i + 1
    return r

// Content-Length, which a response has to state exactly: 0 - 1 when the head
// carries none, 0 - 2 when what it carries isn't a length (not all digits, too
// many digits to be a size, or two values that disagree), and otherwise the
// length. A list of equal values ("5, 5"), or the same header twice, is one
// length said twice (RFC 9110 section 8.6). RFC 9112 section 6.3 makes an
// invalid one an unrecoverable framing error, not a reason to read until the
// peer closes.
http_clen(b, s, hend)
    r = 0 - 1
    p = http_first_field(b, s, hend)
    loop p < hend
        e = http_line_end(b, p, hend)
        if http_is_field(b, p, e, "Content-Length") == 1
            v = p + 15
            loop v <= e
                t = v
                loop t < e && b[t] != 44
                    t = t + 1
                w = http_trim(b, v, t)
                x = http_num(copy(b, w[0], w[1]))
                if x < 0
                    return 0 - 2
                if r >= 0 && r != x
                    return 0 - 2
                r = x
                v = t + 1
        p = e + 2
    return r

// What the head says about Transfer-Encoding: 0 - 1 when it names no transfer
// coding, 1 when chunked is the last coding named, and 0 when it isn't. Only
// the last one decides the framing (RFC 9112 section 6.3): a response whose
// final coding is something other than chunked is read until the connection
// closes.
http_te(b, s, hend)
    r = 0 - 1
    p = http_first_field(b, s, hend)
    loop p < hend
        e = http_line_end(b, p, hend)
        if http_is_field(b, p, e, "Transfer-Encoding") == 1
            // The coding after the last comma on this line.
            a = p + 18
            k = a
            loop k < e
                if b[k] == 44
                    a = k + 1
                k = k + 1
            w = http_trim(b, a, e)
            r = 0
            if w[1] - w[0] == 7 && http_ieq_at(b, w[0], "chunked") == 1
                r = 1
        p = e + 2
    return r

// Where the final response starts. A server may send any number of 1xx interim
// responses first (100 Continue, 103 Early Hints), and RFC 9110 section 15.2
// requires a client to read past them: each is a head with no body, and the
// response the request asked for comes after. Returns that response's offset,
// 0 - 1 while an interim head is still arriving, and 0 - 2 for 101 Switching
// Protocols, which this client never asks for and so can't take as the answer.
http_final(b, n)
    s = 0
    loop 1 == 1
        code = http_status(b, s)
        if code < 100 || code > 199
            return s
        if code == 101
            return 0 - 2
        e = http_header_end(b, s, n)
        if e < 0
            return 0 - 1
        s = e + 4
    return s

// How the final response's body is framed, as [start, body, kind, length]:
// `start` is where its head begins and `body` where its body does, and `kind` is
//
//   0  the head hasn't all arrived
//   1  there's no body: a reply to HEAD, and any 1xx, 204 or 304 (RFC 9112 6.3)
//   2  Content-Length, which is `length`
//   3  chunked
//   4  whatever arrives before the connection closes
//   5  nothing usable: a 101, or a Content-Length that isn't a length
//
// `head` is 1 when the request was HEAD. A reply to HEAD carries the
// Content-Length a GET would have had and no body at all, so reading for that
// length would wait for bytes that are never sent.
http_frame(b, n, head)
    r = text(4)
    r[0] = 0
    r[1] = 0
    r[2] = 0
    r[3] = 0
    s = http_final(b, n)
    if s == 0 - 2
        r[2] = 5
        return r
    if s < 0
        return r
    e = http_header_end(b, s, n)
    if e < 0
        return r
    r[0] = s
    r[1] = e + 4
    code = http_status(b, s)
    if head == 1 || code == 204 || code == 304 || (code >= 100 && code <= 199)
        r[2] = 1
        return r
    te = http_te(b, s, e)
    if te >= 0
        r[2] = 4 - te
        return r
    cl = http_clen(b, s, e)
    if cl == 0 - 2
        r[2] = 5
        return r
    if cl >= 0
        r[2] = 2
        r[3] = cl
        return r
    r[2] = 4
    return r

// http_frame again, asked each time more of the response arrives, without
// searching bytes it has already searched. `st` carries it from one call to the
// next: st[0] is the frame once it's settled, st[1] where the head being looked
// for starts (past the interim heads already read) and st[2] how far the search
// for that head's end has got. The caller starts all three at 0. Once the final
// head has all arrived its frame can't change, so it's kept and handed back from
// then on. Searching a head from the start every time more of it arrived was
// quadratic in the head.
http_frame_more(b, n, head, st)
    if kind(st[0]) != "number"
        return st[0]
    s = st[1]
    loop 1 == 1
        code = http_status(b, s)
        if code == 101
            break
        from = st[2]
        if from < s
            from = s
        e = http_header_end(b, from, n)
        if e < 0
            // No blank line starts before n - 3, so the next search starts there.
            st[1] = s
            st[2] = n - 3
            return text(4)
        if code < 100 || code > 199
            break
        s = e + 4
        st[2] = s
    f = http_frame(b, n, head)
    st[0] = f
    return f

// Is the response framed by `f` complete, with `n` bytes of `b` live? 1 when it
// is, 0 while more is owed, and 0 - 1 when its head makes it unusable (kind
// 5), so the driver stops instead of waiting on a peer that has already sent
// something it can't use.
http_done(b, n, f)
    k = f[2]
    if k == 5
        return 0 - 1
    if k == 1
        return 1
    if k == 2
        if n - f[1] >= f[3]
            return 1
        return 0
    if k == 3
        return http_chunks_done(b, f[1], n)
    return 0

// The same question for a request method: `head` is 1 for HEAD.
http_complete(b, n, head)
    return http_done(b, n, http_frame(b, n, head))

// Is this response framed by the connection closing, instead of by a length?
// (1 as well while its head hasn't all arrived.) HTTP/1.1 has three framings,
// and only two of them say in advance where the body ends. The third ends when
// the peer hangs up, so there an early close is the end and can't be told
// apart from a truncation. The driver needs the difference: with a read
// deadline in place, a stalled peer looks like a peer that closed, and a
// response that declared its length and didn't reach it is a truncation, not a
// body to hand back.
http_close_delimited(b, n, head)
    k = http_frame(b, n, head)[2]
    if k == 0 || k == 4
        return 1
    return 0

// A hex byte region as a number, or 0 - 1. Chunk sizes are hex, and may carry a
// `;ext` suffix, which stops the scan without failing it.
http_hex(b, off, end)
    r = 0
    seen = 0
    i = off
    loop i < end
        c = b[i]
        if c >= 48 && c <= 57
            r = r * 16 + (c - 48)
        else if c >= 97 && c <= 102
            r = r * 16 + (c - 87)
        else if c >= 65 && c <= 70
            r = r * 16 + (c - 55)
        else if c == 59
            break
        else
            return 0 - 1
        seen = seen + 1
        // A chunk size longer than eight hex digits is past anything this reads.
        if seen > 8
            return 0 - 1
        i = i + 1
    if seen == 0
        return 0 - 1
    return r

// The chunked body in the first `n` bytes of `b`, starting at `off`, decoded
// in place and returned as one copy. Each chunk's data is moved down over the
// framing in front of it, so the decoded body ends up at b[off..w). The write
// cursor never passes the read cursor (a chunk's data always comes after its
// own size line), so nothing is overwritten before it's read, and the decoded
// body is never longer than the raw one. It stops at the zero-length chunk, at
// a size line that isn't hex, or at the first chunk that would run past `n`, so
// a truncated response yields the whole chunks that arrived instead of a fault.
//
// `b` is consumed: it isn't a response any more afterwards. Building the body
// with a concatenation per chunk left every intermediate copy in the arena, so
// the memory grew with the square of the body over the chunk size: a 16 MB
// body sent in 16 KB chunks, a quarter of the response ceiling, ran a 4 GiB
// address space out of memory.
http_dechunk(b, off, n)
    w = off
    p = off
    loop p < n
        // The size line ends at CRLF.
        e = p
        loop e + 1 < n && (b[e] != 13 || b[e + 1] != 10)
            e = e + 1
        if e + 1 >= n
            break
        sz = http_hex(b, p, e)
        if sz <= 0
            break
        s = e + 2
        if s + sz > n
            break
        i = 0
        loop i < sz
            b[w + i] = b[s + i]
            i = i + 1
        w = w + sz
        // Past the chunk and its trailing CRLF.
        p = s + sz + 2
    return copy(b, off, w)

// Append `src[from..to)` to `dst`, whose first `used` elements are live.
// Returns the buffer, which is a larger one when the old capacity ran out.
//
// `resp = http_concat(resp, chunk)` per read is quadratic: every read copies
// the whole response again and leaves the old copy in the arena. A
// 76,800-byte body read in 16 KB pieces allocated 16 + 32 + 48 + 64 + 77 =
// 237 KB to end up with 77, and that, not the handshake, was most of the
// roughly 200 KB a fetch used to keep. Doubling makes the copying linear, and
// all the buffers together come to at most twice the last one.
http_append(dst, used, src, from, to)
    g = to - from
    cap = len(dst)
    if used + g > cap
        nc = cap * 2
        if nc == 0
            nc = 1024
        loop nc < used + g
            nc = nc * 2
        r = bytes(nc)
        i = 0
        loop i < used
            r[i] = dst[i]
            i = i + 1
        dst = r
    i = 0
    loop i < g
        dst[used + i] = src[from + i]
        i = i + 1
    return dst

http_concat(a, b)
    la = len(a)
    lb = len(b)
    r = bytes(la + lb)
    i = 0
    loop i < la
        r[i] = a[i]
        i = i + 1
    i = 0
    loop i < lb
        r[la + i] = b[i]
        i = i + 1
    return r

// The body of the final response in the first `n` bytes of `b`, as bytes:
// nothing for a response that has none, dechunked when chunked, Content-Length
// bytes when that's the framing, and everything after the head otherwise. 0 if
// there's no usable head at all. A chunked body is decoded over `b` itself
// (http_dechunk), so `b` is consumed.
http_body(b, n, head)
    f = http_frame(b, n, head)
    k = f[2]
    if k == 0 || k == 5
        return 0
    if k == 1
        return bytes(0)
    start = f[1]
    if k == 3
        return http_dechunk(b, start, n)
    if k == 2
        e = start + f[3]
        if e > n
            e = n
        return copy(b, start, e)
    return copy(b, start, n)

// Has the zero-length chunk arrived? `n` is how much of `b` is live, which isn't
// len(b) while a response is still being read into spare capacity.
http_chunks_done(b, off, n)
    st = text(2)
    st[0] = off
    st[1] = off
    return http_chunks_more(b, n, st)

// The same question, asked again each time more of the body arrives, walking
// only what's new. `st` carries the walk from one call to the next: st[0] is
// where the chunk that hasn't all arrived yet starts, and st[1] how far the
// search for the end of its size line has got, or 0 - 1 once that line has
// turned out not to be a size at all (the body can then never be complete).
