// The two hidden frame slots a for-each needs: the subject region pointer (held
// once, since the subject may be a call) and the raw element index. They're
// named with a leading `@`, which no identifier can have, so they can't collide
// with a program's name, and keyed by the loop's line and column so nested and
// sequential for-each loops get slots of their own.
fe_hidden_p(s)
    return "@p" . s[4] . "_" . s[5]

fe_hidden_i(s)
    return "@i" . s[4] . "_" . s[5]

