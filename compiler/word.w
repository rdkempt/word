    asmput("    ret")
    asmput("")
    asmput("# rt_map_eq: rdi = a, rsi = b -> rax in {0,1}. Two maps are equal when they")
    asmput("# hold the same keys with equal values. Insertion order doesn't count, so")
    asmput("# {a:1,b:2} == {b:2,a:1}. Values compare with rt_eq, so nested maps and text")
    asmput("# compare by content. A map is never equal to a number or a region.")
    asmput("rt_map_eq:")
    asmput("    mov r10, rdi")
    asmput("    and r10, 7")
    asmput("    cmp r10, 4")
    asmput("    jne .mq_no0")
    asmput("    mov r10, rsi")
    asmput("    and r10, 7")
    asmput("    cmp r10, 4")
    asmput("    jne .mq_no0")
    asmput("    cmp rdi, rsi")
    asmput("    je .mq_yes0")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    push r14")
    asmput("    push r15")
    asmput("    mov rbx, rdi")
    asmput("    sub rbx, 4")
    asmput("    mov r12, rsi")
    asmput("    mov r13, [rbx + 8]")
    asmput("    mov r10, r12")
    asmput("    sub r10, 4")
    asmput("    cmp r13, [r10 + 8]")
    asmput("    jne .mq_no")
    asmput("    xor r14, r14")
    asmput(".mq_l:")
    asmput("    cmp r14, r13")
    asmput("    jge .mq_yes")
    asmput("    mov r10, [rbx + 16]")
    asmput("    mov r11, r14")
    asmput("    shl r11, 1")
    asmput("    mov r15, [r10 + r11*8 + 8]")
    asmput("    mov r10, [r10 + r11*8 + 16]")
    asmput("    push r10")
    asmput("    mov rdi, r12")
    asmput("    mov rsi, r15")
    asmput("    call rt_map_has")
    asmput("    cmp rax, 22")
    asmput("    jne .mq_popno")
    asmput("    mov rdi, r12")
    asmput("    mov rsi, r15")
    asmput("    call rt_map_get")
    asmput("    pop rdi")
    asmput("    mov rsi, rax")
    asmput("    call rt_eq")
    asmput("    test rax, rax")
    asmput("    jz .mq_no")
    asmput("    inc r14")
    asmput("    jmp .mq_l")
    asmput(".mq_popno:")
    asmput("    pop r10")
    asmput(".mq_no:")
    asmput("    xor rax, rax")
    asmput("    jmp .mq_ret")
    asmput(".mq_yes:")
    asmput("    mov rax, 1")
    asmput(".mq_ret:")
    asmput("    pop r15")
    asmput("    pop r14")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput(".mq_yes0:")
    asmput("    mov rax, 1")
    asmput("    ret")
    asmput(".mq_no0:")
    asmput("    xor rax, rax")
    asmput("    ret")
    asmput("")
    asmput("# rt_map_keys: rdi = map -> rax = a new region of the keys, in insertion")
    asmput("# order. It's a copy, so writing to it can't corrupt the map.")
    asmput("rt_map_keys:")
    asmput("    mov rax, rdi")
    asmput("    and rax, 7")
    asmput("    cmp rax, 4")
    asmput("    jne rt_notmapfault")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    mov rbx, rdi")
    asmput("    sub rbx, 4")
    asmput("    mov rdi, [rbx + 8]")
    asmput("    call rt_ralloc")
    asmput("    mov r12, rax")
    asmput("    xor r13, r13")
    asmput(".mk_l:")
    asmput("    cmp r13, [rbx + 8]")
    asmput("    jge .mk_d")
    asmput("    mov r10, [rbx + 16]")
    asmput("    mov r11, r13")
    asmput("    shl r11, 1")
    asmput("    mov rax, [r10 + r11*8 + 8]")
    asmput("    mov [r12 + r13*8 + 8], rax")
    asmput("    inc r13")
    asmput("    jmp .mk_l")
    asmput(".mk_d:")
    // The JSON-array mark (flags bit 1), as array() and txt.split set: keys are
    // an array of strings, so `out` and `.` render them as ["a","b"] instead of
    // reading the key pointers as code points and faulting on "not a character".
    asmput("    or qword ptr [r12 - 16], 2")
    asmput("    mov rax, r12")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")

    asmput("# ----- JSON text: one writer, shared by out(map) and json.stringify -----")
    asmput("# A growable code-point buffer. jb_len is the length in use. The region doubles.")
    asmput("rt_jb_reset:")
    asmput("    mov rax, [rip+jb_ptr]")
    asmput("    test rax, rax")
    asmput("    jnz .jbr_have")
    asmput("    push rdi")
    asmput("    mov rdi, 256")
    asmput("    call rt_ralloc")
    asmput("    pop rdi")
    asmput("    mov [rip+jb_ptr], rax")
    asmput(".jbr_have:")
    asmput("    mov qword ptr [rip+jb_len], 0")
    asmput("    ret")
    asmput("")
    asmput("# rt_jb_put: rdi = a raw code point, appended to the buffer")
    asmput("rt_jb_put:")
    asmput("    # This runs once per character of every string json.stringify writes,")
    asmput("    # and a quarter of jsonbench was spent here. The fast path saves no")
    asmput("    # registers, keeps the length it already loaded instead of reading it")
    asmput("    # again, and leaves growth out of line: eight instructions where there")
    asmput("    # were sixteen. Callers can still hold rbx and r12 across it, since the")
    asmput("    # grow path saves them.")
    asmput("    mov r10, [rip+jb_ptr]")
    asmput("    mov rax, [rip+jb_len]")
    asmput("    cmp rax, [r10]")
    asmput("    jge .jbp_grow")
    asmput(".jbp_store:")
    asmput("    lea r11, [rdi*2 + 1]")
    asmput("    mov [r10 + rax*8 + 8], r11")
    asmput("    inc rax")
    asmput("    mov [rip+jb_len], rax")
    asmput("    ret")
    asmput(".jbp_grow:")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push rsi")
    asmput("    push rdi")
    asmput("    mov rbx, r10")
    asmput("    mov rdi, [rbx]")
    asmput("    shl rdi, 1")
    asmput("    call rt_ralloc")
    asmput("    mov r12, rax")
    asmput("    cld")
    asmput("    lea rsi, [rbx + 8]")
    asmput("    lea rdi, [r12 + 8]")
    asmput("    mov rcx, [rip+jb_len]")
    asmput("    rep movsq")
    asmput("    mov [rip+jb_ptr], r12")
    asmput("    mov r10, r12")
    asmput("    pop rdi")
    asmput("    pop rsi")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    mov rax, [rip+jb_len]")
    asmput("    jmp .jbp_store")
    asmput("")
    asmput("# rt_jb_puts: rdi = region, appended verbatim (no quoting)")
    asmput("rt_jb_puts:")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    call rt_bytepromote")
    asmput("    mov rbx, rax")
    asmput("    xor r12, r12")
    asmput(".jbs_l:")
    asmput("    cmp r12, [rbx]")
    asmput("    jge .jbs_d")
    asmput("    mov rdi, [rbx + r12*8 + 8]")
    asmput("    sar rdi, 1")
    asmput("    call rt_jb_put")
    asmput("    inc r12")
    asmput("    jmp .jbs_l")
    asmput(".jbs_d:")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    asmput("# rt_jb_take -> rax = a new region of jb_len elements, what was written")
    asmput("rt_jb_take:")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    mov rbx, [rip+jb_ptr]")
    asmput("    mov rdi, [rip+jb_len]")
    asmput("    call rt_ralloc")
    asmput("    mov r12, rax")
    asmput("    # The whole buffer in one `rep movsq`, not an element-at-a-time loop over")
    asmput("    # a megabyte of JSON.")
    asmput("    cld")
    asmput("    lea rsi, [rbx + 8]")
    asmput("    lea rdi, [r12 + 8]")
    asmput("    mov rcx, [rip+jb_len]")
    asmput("    rep movsq")
    asmput("    mov rax, r12")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    asmput("# rt_jb_qstr: rdi = region, appended as a quoted, escaped JSON string")
    asmput("rt_jb_qstr:")
    asmput("    push rbx")
    asmput("    push r12")
    // A byte-backed string is written as the UTF-8 text its bytes spell, the
    // way out() prints it. Promoting it one code point per byte wrote "José"
    // read from a file as "JosÃ©".
    asmput("    mov rax, rdi")
    asmput("    test qword ptr [rdi - 16], 1")
    asmput("    jz .jq_text")
    asmput("    mov rsi, [rdi]")
    asmput("    add rdi, 8")
    asmput("    call rt_utf8_decode")
    asmput(".jq_text:")
    asmput("    mov rbx, rax")
    asmput("    mov rdi, 34")
    asmput("    call rt_jb_put")
    asmput("    xor r12, r12")
    asmput(".jq_l:")
    asmput("    cmp r12, [rbx]")
    asmput("    jge .jq_d")
    asmput("    mov rax, [rbx + r12*8 + 8]")
    // An element that isn't an integer isn't a character (see rt_out_region).
    asmput("    test al, 1")
    asmput("    jz rt_char")
    asmput("    sar rax, 1")
    asmput("    # The ordinary character comes first. The three control codes with their")
    asmput("    # own escapes used to be tested ahead of it, so every printable character")
    asmput("    # paid five compares to find out it was ordinary. They're behind the")
    asmput("    # `< 32` test now, which had to be there anyway.")
    asmput("    cmp rax, 34")
    asmput("    je .jq_esc")
    asmput("    cmp rax, 92")
    asmput("    je .jq_esc")
    // Unsigned, so a negative element can't pass for a control code. It used
    // to, and -5 was written as û.
    asmput("    cmp rax, 32")
    asmput("    jb .jq_ctl")
    asmput("    cmp rax, 0xD800")
    asmput("    jae .jq_hi")
    asmput(".jq_put:")
    asmput("    mov rdi, rax")
    asmput("    call rt_jb_put")
    asmput("    jmp .jq_n")
    // From 0xD800 up, and every negative read as unsigned: a surrogate or
    // anything past 0x10FFFF isn't a character, and faults the way out() does
    // for one. These used to be copied into the JSON raw.
    asmput(".jq_hi:")
    asmput("    cmp rax, 0xDFFF")
    asmput("    jbe rt_char")
    asmput("    cmp rax, 0x10FFFF")
    asmput("    ja rt_char")
    asmput("    jmp .jq_put")
    asmput(".jq_ctl:")
    asmput("    cmp rax, 10")
    asmput("    je .jq_nl")
    asmput("    cmp rax, 9")
    asmput("    je .jq_tab")
    asmput("    cmp rax, 13")
    asmput("    je .jq_cr")
    asmput("    jmp .jq_u")
    asmput(".jq_esc:")
    asmput("    push rax")
    asmput("    mov rdi, 92")
    asmput("    call rt_jb_put")
    asmput("    pop rdi")
    asmput("    call rt_jb_put")
    asmput("    jmp .jq_n")
    asmput(".jq_nl:")
    asmput("    mov rdi, 92")
    asmput("    call rt_jb_put")
    asmput("    mov rdi, 110")
    asmput("    call rt_jb_put")
    asmput("    jmp .jq_n")
    asmput(".jq_tab:")
    asmput("    mov rdi, 92")
    asmput("    call rt_jb_put")
    asmput("    mov rdi, 116")
    asmput("    call rt_jb_put")
    asmput("    jmp .jq_n")
    asmput(".jq_cr:")
    asmput("    mov rdi, 92")
    asmput("    call rt_jb_put")
    asmput("    mov rdi, 114")
    asmput("    call rt_jb_put")
    asmput("    jmp .jq_n")
    asmput("    # any other control character goes out as \\\\u00XX")
    asmput(".jq_u:")
    asmput("    push rax")
    asmput("    mov rdi, 92")
    asmput("    call rt_jb_put")
    asmput("    mov rdi, 117")
    asmput("    call rt_jb_put")
    asmput("    mov rdi, 48")
    asmput("    call rt_jb_put")
    asmput("    mov rdi, 48")
    asmput("    call rt_jb_put")
    asmput("    pop rax")
    asmput("    push rax")
    asmput("    shr rax, 4")
    asmput("    and rax, 15")
    asmput("    call rt_jb_hex")
    asmput("    pop rax")
    asmput("    and rax, 15")
    asmput("    call rt_jb_hex")
    asmput(".jq_n:")
    asmput("    inc r12")
    asmput("    jmp .jq_l")
    asmput(".jq_d:")
    asmput("    mov rdi, 34")
    asmput("    call rt_jb_put")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    asmput("# rt_jb_hex: rax = a nibble, appended as a lowercase hex digit")
    asmput("rt_jb_hex:")
    asmput("    cmp rax, 10")
    asmput("    jl .jh_dig")
    asmput("    add rax, 87")
    asmput("    mov rdi, rax")
    asmput("    call rt_jb_put")
    asmput("    ret")
    asmput(".jh_dig:")
    asmput("    add rax, 48")
    asmput("    mov rdi, rax")
    asmput("    call rt_jb_put")
    asmput("    ret")
    asmput("")
    asmput("# rt_json_write: rdi = any value, appended as JSON. A map is an object, a")
    asmput("# region with the array mark is an array, any other region is a string, an")
    asmput("# integer or float is a number, and true, false and null are JSON words.")
    asmput("rt_json_write:")
    // A map or an array is a level, and anything else is written where it
    // stands. That's the same count the parser keeps (1000 levels), so
    // whatever parse accepts can be written back out. A cycle is maps or
    // arrays all the way down, so it reaches the cap and faults.
    asmput("    mov rax, rdi")
    asmput("    and rax, 7")
    asmput("    cmp rax, 4")
    asmput("    je .jw_level")
    asmput("    test rax, rax")
    asmput("    jnz rt_json_write1")
    asmput("    mov rax, [rdi - 16]")
    asmput("    and rax, 2")
    asmput("    jz rt_json_write1")
    asmput(".jw_level:")
    asmput("    mov rcx, [rip+jp_depth]")
    asmput("    inc rcx")
    asmput("    mov [rip+jp_depth], rcx")
    asmput("    cmp rcx, 1000")
    asmput("    jg rt_jsondeep")
    asmput("    call rt_json_write1")
    asmput("    mov rcx, [rip+jp_depth]")
    asmput("    dec rcx")
    asmput("    mov [rip+jp_depth], rcx")
    asmput("    ret")
    asmput("rt_json_write1:")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    push r13")
    asmput("    mov rbx, rdi")
    asmput("    mov rax, rbx")
    asmput("    and rax, 1")
    asmput("    jnz .jw_int")
    asmput("    mov rax, rbx")
    asmput("    and rax, 7")
    if cg[14] == 1
        asmput("    cmp rax, 2")
        asmput("    je .jw_float")
    asmput("    cmp rax, 4")
    asmput("    je .jw_map")
    // A singleton writes as the JSON word it came from, unquoted, so the
    // round trip gives back the same value.
    asmput("    cmp rax, 6")
    asmput("    je .jw_sing")
    asmput("    mov rax, [rbx - 16]")
    asmput("    and rax, 2")
    asmput("    jnz .jw_list")
    asmput("    mov rdi, rbx")
    asmput("    call rt_jb_qstr")
    asmput("    jmp .jw_ret")
    // true, false and null are JSON words and write unquoted. `none` isn't a
    // JSON value (it's what a failed parse or number() answers), and writing
    // its name gave `{"a":none}`, which no parser will read back. Writing it
    // as JSON `null` would be worse: the language keeps null and none apart,
    // and a document mustn't claim a field was present and null when what
    // happened is that a conversion failed. So it faults (rt_jsonnone).
    asmput(".jw_sing:")
    asmput("    cmp rbx, 30")
    asmput("    je rt_jsonnone")
    asmput("    mov rdi, rbx")
    asmput("    call rt_sigtext")
    asmput("    mov rdi, rax")
    asmput("    call rt_jb_puts")
    asmput("    jmp .jw_ret")
    asmput(".jw_int:")
    asmput("    mov rdi, rbx")
    asmput("    call rt_num_to_region")
    asmput("    mov rdi, rax")
    asmput("    call rt_jb_puts")
    asmput("    jmp .jw_ret")
    if cg[14] == 1
        // JSON has no way to write an infinity or a NaN, and writing their
        // names gave `{"v":inf}`, which this parser rejects, so the document
        // couldn't survive its own round trip. Same rule as `none` above: it
        // faults instead of writing something no reader will take. A double
        // is non-finite exactly when its 11 exponent bits are all set.
        asmput(".jw_float:")
        asmput("    mov r10, rbx")
        asmput("    and r10, -8")
        asmput("    mov r10, [r10]")
        asmput("    movabs r11, 0x7ff0000000000000")
        asmput("    and r10, r11")
        asmput("    cmp r10, r11")
        asmput("    je rt_jsonfin")
        asmput("    mov rdi, rbx")
        asmput("    call rt_float_to_region")
        asmput("    mov rdi, rax")
        asmput("    call rt_jb_puts")
        asmput("    jmp .jw_ret")
    asmput(".jw_list:")
    asmput("    mov rdi, 91")
    asmput("    call rt_jb_put")
    asmput("    xor r12, r12")
    asmput(".jw_ll:")
    asmput("    cmp r12, [rbx]")
    asmput("    jge .jw_ld")
    asmput("    test r12, r12")
    asmput("    jz .jw_lns")
    asmput("    mov rdi, 44")
    asmput("    call rt_jb_put")
    asmput(".jw_lns:")
    asmput("    mov rdi, [rbx + r12*8 + 8]")
    asmput("    call rt_json_write")
    asmput("    inc r12")
    asmput("    jmp .jw_ll")
    asmput(".jw_ld:")
    asmput("    mov rdi, 93")
    asmput("    call rt_jb_put")
    asmput("    jmp .jw_ret")
    asmput(".jw_map:")
    asmput("    mov rdi, 123")
    asmput("    call rt_jb_put")
    asmput("    sub rbx, 4")
    asmput("    xor r12, r12")
    asmput(".jw_ml:")
    asmput("    cmp r12, [rbx + 8]")
    asmput("    jge .jw_md")
    asmput("    test r12, r12")
    asmput("    jz .jw_mns")
    asmput("    mov rdi, 44")
    asmput("    call rt_jb_put")
    asmput(".jw_mns:")
    asmput("    mov r13, [rbx + 16]")
    asmput("    mov rax, r12")
    asmput("    shl rax, 1")
    asmput("    mov rdi, [r13 + rax*8 + 8]")
    asmput("    call rt_jb_qstr")
    asmput("    mov rdi, 58")
    asmput("    call rt_jb_put")
    asmput("    mov r13, [rbx + 16]")
    asmput("    mov rax, r12")
    asmput("    shl rax, 1")
    asmput("    inc rax")
    asmput("    mov rdi, [r13 + rax*8 + 8]")
    asmput("    call rt_json_write")
    asmput("    inc r12")
    asmput("    jmp .jw_ml")
    asmput(".jw_md:")
    asmput("    mov rdi, 125")
    asmput("    call rt_jb_put")
    asmput(".jw_ret:")
    asmput("    pop r13")
    asmput("    pop r12")
    asmput("    pop rbx")
    asmput("    ret")
    asmput("")
    asmput("# rt_json_str: rdi = value -> rax = a region of JSON text")
    asmput("rt_json_str:")
    asmput("    push rdi")
    asmput("    call rt_jb_reset")
    asmput("    mov qword ptr [rip+jp_depth], 0")
    asmput("    pop rdi")
    asmput("    call rt_json_write")
    asmput("    call rt_jb_take")
    asmput("    ret")
    asmput("")

    asmput("# ----- JSON text -> values -----")
    asmput("# jp_src is the decoded source region, jp_pos the read cursor, jp_bad the")
    asmput("# latch. Any malformed input sets jp_bad and json.parse answers none.")
    asmput("rt_jp_ws:")
    asmput("    mov r8, [rip+jp_src]")
    asmput("    mov rcx, [rip+jp_pos]")
    asmput(".jws_l:")
    asmput("    cmp rcx, [r8]")
    asmput("    jge .jws_d")
    asmput("    mov rax, [r8 + rcx*8 + 8]")
    asmput("    sar rax, 1")
    asmput("    cmp rax, 32")
    asmput("    je .jws_s")
    asmput("    cmp rax, 9")
    asmput("    je .jws_s")
    asmput("    cmp rax, 10")
    asmput("    je .jws_s")
    asmput("    cmp rax, 13")
    asmput("    je .jws_s")
    asmput("    jmp .jws_d")
    asmput(".jws_s:")
    asmput("    inc rcx")
    asmput("    jmp .jws_l")
    asmput(".jws_d:")
    asmput("    mov [rip+jp_pos], rcx")
    asmput("    ret")
    asmput("")
    asmput("# rt_jp_at -> rax = the code point at the cursor, or -1 at the end")
    asmput("rt_jp_at:")
    asmput("    mov r8, [rip+jp_src]")
    asmput("    mov rcx, [rip+jp_pos]")
    asmput("    cmp rcx, [r8]")
    asmput("    jge .jat_end")
    asmput("    mov rax, [r8 + rcx*8 + 8]")
    asmput("    sar rax, 1")
    asmput("    ret")
    asmput(".jat_end:")
    asmput("    mov rax, -1")
    asmput("    ret")
    asmput("")
    asmput("# rt_jp_hex4 -> rax = the value of the four hex digits at the cursor, or -1.")
    asmput("# Advances the cursor over whatever it consumed either way.")
    asmput("rt_jp_hex4:")
    asmput("    push rbx")
    asmput("    push r12")
    asmput("    xor rbx, rbx")
    asmput("    xor r12, r12")
    asmput(".jh_l:")
    asmput("    cmp r12, 4")
    asmput("    jge .jh_d")
    asmput("    call rt_jp_at")
    asmput("    mov rcx, [rip+jp_pos]")
    asmput("    inc rcx")
    asmput("    mov [rip+jp_pos], rcx")
    asmput("    shl rbx, 4")
    asmput("    cmp rax, 48")
    asmput("    jl .jh_bad")
    asmput("    cmp rax, 57")
    asmput("    jg .jh_af")
    asmput("    sub rax, 48")
    asmput("    jmp .jh_add")
    asmput(".jh_af:")
    asmput("    or rax, 32")
    asmput("    cmp rax, 97")
    asmput("    jl .jh_bad")
    asmput("    cmp rax, 102")
    asmput("    jg .jh_bad")
