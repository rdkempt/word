            // pattern .wsc_o_dir builds and its UTF-16 copy (at most 4098
            // units), the FindFirstFileW handle, the WIN32_FIND_DATAW it fills
            // (592 bytes), the entry's name as UTF-8 (a name is at most 255
            // UTF-16 units, 765 bytes), whether that entry is still to be handed
            // out, and how many of . and .. are still owed to a drive root. One
            // search at a time is all rt_dir asks for: it opens a directory,
            // drains it and closes it inside one call.
            asmput("windir_pat: .space 8192")
            asmput("windir_wpat: .space 8448")
            asmput("windir_find: .space 8")
            asmput("windir_data: .space 1024")
            asmput("windir_name: .space 1024")
            asmput("windir_pend: .space 8")
            asmput("windir_dots: .space 8")
        // Windows-only process and environment bookkeeping: the env-pointer
        // array env() reads, and the CreateProcessA scratch (the command line,
        // STARTUPINFOA and PROCESS_INFORMATION).
        asmput("winenvp: .space 32768")
        // 32767 is CreateProcess's own ceiling for a command line.
        asmput("wincmd: .space 32768")
        // w_argptr's unescaped token. GetCommandLineA is at most 32767 UTF-16
        // units, which is under 98 KB as UTF-8, and a token is never longer.
        if cg[35] == 1
            asmput("winargbuf: .space 131072")
        asmput("win_si: .space 104")
        asmput("win_pi: .space 24")

gen_program(cg, prog)
    items = prog[1]
    tops = mklist(8192)
    i = 0
    loop i < lcount(items)
        it = lget(items, i)
        if it[0] == 3
            targets = it[1]
            t0 = lget(targets, 0)
            kind0 = t0[1]
            j = 0
            loop j < lcount(targets)
                tg = lget(targets, j)
                ent = text(2)
                ent[0] = tg[0]
                ent[1] = it
                if kind0 == "before"
                    cg[9] = ladd_grow(cg[9], ent)
                else
                    cg[10] = ladd_grow(cg[10], ent)
                j = j + 1
            hb = it[2]
            m = 0
            loop m < lcount(hb)
                prepass_literals(cg, lget(hb, m))
                m = m + 1
        else
            prepass_literals(cg, it)
            if it[0] != 2
                tops = ladd_grow(tops, it)
        i = i + 1
    infer_inlines(cg, items)
    inline_program(cg, items, tops)
    infer_param_kinds(cg, items, tops)
    infer_retention(cg, items)
    asmput(".intel_syntax noprefix")
    asmput(".global _start")
    asmput(".text")
    asmput("_start:")
    // Capture the true stack top before any call moves rsp: on Linux the entry
    // rsp is &argc, on Windows it is whatever the loader left, and either way it
    // is the highest address this thread's stack will hold. Both targets need it
    // for the stack-overflow guard.
    asmput("    mov [rip+stack_base], rsp")
    asmput("    call rt_init")
    emit_float_pool_init(cg)
    asmput("    call fn__toplevel")
    // What out() staged and has not yet written goes out before the exit.
    asmput("    push rax")
    asmput("    call rt_obuf_flush")
    asmput("    pop rax")
    asmput("    mov rdi, rax")
    asmput("    sar rdi, 1")
    asmput("    and rdi, 255")
    asmput("    mov rax, 60")
    emit_syscall(cg)
    emit_runtime(cg)
    p = 0
    loop p < lcount(items)
        it = lget(items, p)
        if it[0] == 2
            gen_function(cg, it[1], it[2], it[3])
        p = p + 1
    emptyparams = mklist(1)
    gen_function(cg, "_toplevel", emptyparams, tops)
    gen_data(cg)

// The size of out()'s staging buffer. A million short lines into a pipe are
// about a hundred writes instead of two million.
obuf_cap()
    return 65536

// How much of the arena stays on small pages: a program that allocates less
// than this never meets a huge one, so its startup and footprint don't change.
thp_skip()
    return 4194304

// Emit an OS trap: a raw `syscall` on Linux, or `call w_syscall` (the Windows
// shim that maps the Linux syscall number in rax onto Win32) when targeting
// Windows (cg[12] == 1).
emit_syscall(cg)
    if cg[12] == 1
        asmput("    call w_syscall")
    else
        asmput("    sys" . "call")

// rt_sigaction(sig, new, old, 8) on Linux x86-64, with the new action read
// from [rsp+newoff] and the old one written at [rsp+oldoff]. An offset of -1
// passes 0 instead. rt_writef uses it to ignore SIGPIPE and SIGXFSZ while it
// writes and to put them back after.
emit_sigaction(cg, sig, newoff, oldoff)
    asmput("    mov rax, 13")
    asmput("    mov rdi, " . sig)
    if newoff < 0
        asmput("    xor rsi, rsi")
    else if newoff == 0
        asmput("    mov rsi, rsp")
    else
        asmput("    lea rsi, [rsp+" . newoff . "]")
    if oldoff < 0
        asmput("    xor rdx, rdx")
    else
        asmput("    lea rdx, [rsp+" . oldoff . "]")
    asmput("    mov r10, 8")
    emit_syscall(cg)

// rt_cacerts: -> rax = a byte-backed region holding the OS trust store, as
// repeated [uint32 length, little-endian][DER certificate] records, or `none`
// where the OS doesn't hand out its anchors through an API.
//
// Only Windows does. Linux and macOS keep the trust store in a file, and the
// net library's net.w reads it there with fs.read and parses the PEM in word,
// which is where that belongs. This primitive is for the one platform whose
// store can only be reached through a DLL, so everywhere else it's `none`,
// and net.w reads that as "the store is a file".
//
// `none` and not an empty region, because the two have to mean different
// things. An empty region on Windows is an empty store, which authenticates
// nothing. If it read as "go and look for a file", a program on Windows would
// open /etc/ssl/certs/..., which there is \etc\ssl\certs\... at the root of
// the current drive, a directory any signed-in user can create, and trust
// whatever it found.
//
// It's a typed primitive returning bytes, not a general call into crypt32,
// for the same reason the sockets are six named verbs and not sys.syscall: a
// program that reads the trust store should do it in a way a reader can find.
emit_cacerts(cg)
    if cg[12] == 0
        asmput("# rt_cacerts: no OS trust-store API on this target. The anchors are a file,")
        asmput("# and net.w reads it, so this answers `none`.")
        asmput("rt_cacerts:")
        asmput("    mov rax, 30")
        asmput("    ret")
        asmput("")
        return 0
    asmput("# rt_cacerts: the Windows ROOT system certificate store, as")
    asmput("# [uint32 len][DER] records in one byte-backed region.")
    asmput("#")
    asmput("# Two passes over the store, because the size has to be known before the")
    asmput("# region is allocated and CertEnumCertificatesInStore is the only way to ask.")
    asmput("# The second pass checks every write against the end of the region instead")
    asmput("# of trusting the first pass's total: the store is shared state and could")
    asmput("# grow between them, and a length the first pass measured isn't a length the")
    asmput("# second pass may write. What was actually written becomes the region's")
    asmput("# length, so a store that grew mid-call is cut short instead of overflowing.")
    asmput("#")
    asmput("# CERT_CONTEXT is { DWORD encoding; BYTE *pbCertEncoded; DWORD cbCertEncoded;")
    asmput("# ... }, so the bytes are at [ctx+8] and their count at [ctx+16]. The store")
    asmput("# owns them, and CertEnumCertificatesInStore frees each context as it hands")
    asmput("# back the next, which is why each one is copied out right away.")
    asmput("rt_cacerts:")
    asmput("    push rbp")
    asmput("    mov rbp, rsp")
    asmput("    and rsp, -16")
    asmput("    sub rsp, 96")
    asmput("    mov [rsp+64], rbx")
    asmput("    mov [rsp+72], r12")
    asmput("    mov [rsp+80], r14")
    asmput("    mov [rsp+88], r15")
    asmput("    # CertOpenSystemStoreW(NULL, L\"ROOT\"), with the wide name built on the")
    asmput("    # stack instead of in .rodata, since it's eight bytes and one immediate.")
    asmput("    movabs rax, 0x0054004F004F0052")
    asmput("    mov [rsp+32], rax")
    asmput("    mov dword ptr [rsp+40], 0")
    asmput("    xor rcx, rcx")
    asmput("    lea rdx, [rsp+32]")
    asmput("    call qword ptr [rip+CertOpenSystemStoreW]")
    asmput("    mov rbx, rax")
    asmput("    test rbx, rbx")
    asmput("    jz .cac_empty")
    asmput("    # pass 1: 4 + cbCertEncoded for every certificate in the store")
    asmput("    xor r12, r12")
    asmput("    xor r14, r14")
    asmput(".cac_size:")
    asmput("    mov rcx, rbx")
    asmput("    mov rdx, r12")
    asmput("    call qword ptr [rip+CertEnumCertificatesInStore]")
    asmput("    test rax, rax")
    asmput("    jz .cac_sized")
    asmput("    mov r12, rax")
    asmput("    mov eax, [r12+16]")
    asmput("    add r14, rax")
    asmput("    add r14, 4")
    asmput("    jmp .cac_size")
    asmput(".cac_sized:")
    asmput("    mov rdi, r14")
    asmput("    call rt_balloc")
    asmput("    mov [rsp+48], rax")
    asmput("    mov r15, rax")
    asmput("    add r15, 8")
    asmput("    add r15, r14")
    asmput("    mov r14, rax")
    asmput("    add r14, 8")
    asmput("    # pass 2: copy, bounded by the region and not by the count above")
    asmput("    xor r12, r12")
    asmput(".cac_fill:")
    asmput("    mov rcx, rbx")
    asmput("    mov rdx, r12")
    asmput("    call qword ptr [rip+CertEnumCertificatesInStore]")
    asmput("    test rax, rax")
    asmput("    jz .cac_filled")
    asmput("    mov r12, rax")
    asmput("    mov ecx, [r12+16]")
    asmput("    mov rax, r14")
    asmput("    add rax, rcx")
    asmput("    add rax, 4")
    asmput("    cmp rax, r15")
    asmput("    ja .cac_fill")
    asmput("    mov dword ptr [r14], ecx")
    asmput("    add r14, 4")
    asmput("    mov rsi, [r12+8]")
    asmput("    mov rdi, r14")
    asmput("    rep movsb")
    asmput("    mov r14, rdi")
    asmput("    jmp .cac_fill")
    asmput(".cac_filled:")
    asmput("    mov rcx, rbx")
    asmput("    xor rdx, rdx")
    asmput("    call qword ptr [rip+CertCloseStore]")
    asmput("    # the length is what was written, not what was measured")
    asmput("    mov rax, [rsp+48]")
    asmput("    mov rcx, r14")
    asmput("    sub rcx, rax")
    asmput("    sub rcx, 8")
    asmput("    mov [rax], rcx")
    asmput("    jmp .cac_ret")
    asmput(".cac_empty:")
    asmput("    xor rdi, rdi")
    asmput("    call rt_balloc")
    asmput("    mov [rsp+48], rax")
    asmput(".cac_ret:")
    asmput("    mov rax, [rsp+48]")
    asmput("    mov rbx, [rsp+64]")
    asmput("    mov r12, [rsp+72]")
    asmput("    mov r14, [rsp+80]")
    asmput("    mov r15, [rsp+88]")
    asmput("    mov rsp, rbp")
    asmput("    pop rbp")
    asmput("    ret")
    asmput("")

// rt_nameservers: -> rax = a byte-backed region naming the DNS resolvers the OS
// lists, as ASCII dotted quads each ended by a line feed, or `none` where the
// OS names its resolver in a file.
//
// Only Windows keeps them behind an API. Linux and macOS name the resolver in
// /etc/resolv.conf, which net.w reads, so everywhere else this is `none`. It's
// `none` and not an empty region for the reason rt_cacerts gives: on Windows
// that path is \etc\resolv.conf at the root of the current drive, which any
// signed-in user can create, so an answer that sent net.w to the file there
// would let whoever made it choose where every lookup goes.
//
// The addresses are GetNetworkParams's: the IPv4 servers the host is
// configured with, in the order it gives them. They come back as text because
// that's how the OS hands them over, and turning text into an address is a
// parse, which belongs in word (dns_dotted_quad already does it and checks
// every octet), not here.
emit_nameservers(cg)
    if cg[12] == 0
        asmput("# rt_nameservers: no OS resolver API on this target. The resolver is")
        asmput("# /etc/resolv.conf, and net.w reads it, so this answers `none`.")
        asmput("rt_nameservers:")
        asmput("    mov rax, 30")
        asmput("    ret")
        asmput("")
        return 0
    asmput("# rt_nameservers: the IPv4 DNS servers Windows lists (iphlpapi")
    asmput("# GetNetworkParams), as dotted quads each ended by LF, in one byte-backed")
    asmput("# region. Empty when the OS lists none or won't say.")
    asmput("#")
    asmput("# FIXED_INFO is HostName[132], DomainName[132], CurrentDnsServer*, then")
    asmput("# DnsServerList: an IP_ADDR_STRING held inline at +272, { Next*;")
    asmput("# char IpAddress[16]; char IpMask[16]; DWORD Context }. The servers after")
    asmput("# the first are IP_ADDR_STRINGs the call lays out in the same buffer, so")
    asmput("# the size is the OS's to say: asked with a null buffer, it answers")
    asmput("# ERROR_BUFFER_OVERFLOW and writes the size it needs. The list can grow")
    asmput("# between the two calls, which gives the same answer again with a larger")
    asmput("# size, so there are three tries. A size too small to hold the inline")
    asmput("# entry, or past 64 KB, isn't one to allocate.")
    asmput("#")
    asmput("# Each address is copied up to its NUL and never past its 16 bytes. An")
    asmput("# empty one is skipped (the first entry is inline, so a host with no")
    asmput("# resolver answers one blank), and at most 64 are taken, so a Next chain")
    asmput("# that didn't end couldn't hold this forever. What the text says is")
    asmput("# net.w's to check: this copies, it doesn't parse.")
    asmput("rt_nameservers:")
    asmput("    push rbp")
    asmput("    mov rbp, rsp")
    asmput("    and rsp, -16")
    asmput("    sub rsp, 96")
    asmput("    mov [rsp+64], rbx")
    asmput("    mov [rsp+72], r12")
    asmput("    mov [rsp+80], r14")
    asmput("    mov [rsp+88], r15")
    asmput("    # [rsp+56]: the ULONG size the call reads and rewrites. rbx: the buffer,")
    asmput("    # null for the first call. r15: the tries left.")
    asmput("    mov dword ptr [rsp+56], 0")
    asmput("    xor rbx, rbx")
    asmput("    mov r15, 3")
    asmput(".ns_try:")
    asmput("    mov rcx, rbx")
    asmput("    lea rdx, [rsp+56]")
    asmput("    call qword ptr [rip+GetNetworkParams]")
    asmput("    test eax, eax")
    asmput("    jz .ns_have")
    asmput("    sub r15, 1")
    asmput("    jz .ns_empty")
    asmput("    mov eax, [rsp+56]")
    asmput("    cmp rax, 320")
    asmput("    jb .ns_empty")
    asmput("    cmp rax, 65536")
    asmput("    ja .ns_empty")
    asmput("    mov rdi, rax")
    asmput("    call rt_balloc")
    asmput("    lea rbx, [rax + 8]")
    asmput("    jmp .ns_try")
    asmput(".ns_have:")
    asmput("    test rbx, rbx")
    asmput("    jz .ns_empty")
    asmput("    # pass 1: how many entries, at most 64")
    asmput("    lea r12, [rbx + 272]")
    asmput("    xor r14, r14")
    asmput(".ns_count:")
    asmput("    add r14, 1")
    asmput("    cmp r14, 64")
    asmput("    jae .ns_counted")
    asmput("    mov r12, [r12]")
    asmput("    test r12, r12")
    asmput("    jnz .ns_count")
    asmput(".ns_counted:")
    asmput("    # 17 bytes an entry: sixteen characters at most, and the LF")
    asmput("    mov rdi, r14")
    asmput("    shl rdi, 4")
    asmput("    add rdi, r14")
    asmput("    call rt_balloc")
    asmput("    mov [rsp+48], rax")
    asmput("    lea r15, [rax + 8]")
    asmput("    # pass 2: copy, entry by entry, no more of them than pass 1 counted")
    asmput("    lea r12, [rbx + 272]")
    asmput(".ns_fill:")
    asmput("    xor rcx, rcx")
    asmput(".ns_char:")
    asmput("    movzx rax, byte ptr [r12 + rcx + 8]")
    asmput("    test rax, rax")
    asmput("    jz .ns_end")
    asmput("    mov [r15+rcx], al")
    asmput("    add rcx, 1")
    asmput("    cmp rcx, 16")
    asmput("    jb .ns_char")
    asmput(".ns_end:")
    asmput("    test rcx, rcx")
    asmput("    jz .ns_next")
    asmput("    add r15, rcx")
    asmput("    mov byte ptr [r15], 10")
    asmput("    add r15, 1")
    asmput(".ns_next:")
    asmput("    sub r14, 1")
    asmput("    jz .ns_filled")
    asmput("    mov r12, [r12]")
    asmput("    test r12, r12")
    asmput("    jnz .ns_fill")
    asmput(".ns_filled:")
    asmput("    # the length is what was written, not what was allocated")
    asmput("    mov rax, [rsp+48]")
    asmput("    mov rcx, r15")
    asmput("    sub rcx, rax")
    asmput("    sub rcx, 8")
    asmput("    mov [rax], rcx")
    asmput("    jmp .ns_ret")
    asmput(".ns_empty:")
    asmput("    xor rdi, rdi")
    asmput("    call rt_balloc")
    asmput("    mov [rsp+48], rax")
    asmput(".ns_ret:")
    asmput("    mov rax, [rsp+48]")
    asmput("    mov rbx, [rsp+64]")
    asmput("    mov r12, [rsp+72]")
    asmput("    mov r14, [rsp+80]")
    asmput("    mov r15, [rsp+88]")
    asmput("    mov rsp, rbp")
    asmput("    pop rbp")
    asmput("    ret")
    asmput("")

// rt_image: -> rax = the path of the running executable as the OS reports it,
// a byte-backed region of UTF-8, or `none` where it isn't asked for that way.
//
// `word version` fingerprints the binary it's running as, and argv[0] can't
// say which file that is: it's whatever the caller typed, so a word.exe found
// through PATH, run from a folder holding another word.exe, read that other
// file and judged it. Windows answers from the loaded image
// (GetModuleFileNameW). Linux keeps the running image at the file
// /proc/self/exe, which the compiler reads, so there this is `none`, the same
// split as rt_cacerts and rt_nameservers. It's `none` on Windows too when the
// call fails.
emit_image(cg)
    if cg[12] == 0
        asmput("# rt_image: none here, where the running image is the file /proc/self/exe.")
        asmput("rt_image:")
        asmput("    mov rax, 30")
        asmput("    ret")
        asmput("")
        return 0
    asmput("# rt_image: GetModuleFileNameW(NULL) into a 32768-unit buffer, the longest")
    asmput("# path Windows has, so the answer is never cut short. Then it's converted to")
    asmput("# UTF-8, measured first and written into a region of exactly that size.")
    asmput("rt_image:")
    asmput("    push rbp")
    asmput("    mov rbp, rsp")
    asmput("    and rsp, -16")
    asmput("    sub rsp, 96")
    asmput("    mov [rsp+64], rbx")
    asmput("    mov [rsp+72], r12")
    asmput("    mov [rsp+80], r13")
    asmput("    mov rdi, 65536")
    asmput("    call rt_balloc")
    asmput("    lea rbx, [rax + 8]")
    asmput("    xor rcx, rcx")
    asmput("    mov rdx, rbx")
    asmput("    mov r8, 32768")
    asmput("    call qword ptr [rip+GetModuleFileNameW]")
    asmput("    test eax, eax")
    asmput("    jz .img_none")
    asmput("    cmp eax, 32768")
    asmput("    jae .img_none")
    asmput("    mov ecx, eax")
    asmput("    mov r12, rcx")
    asmput("    # WideCharToMultiByte(CP_UTF8, 0, path, units, 0, 0, 0, 0): the size")
    asmput("    mov rcx, 65001")
    asmput("    xor rdx, rdx")
    asmput("    mov r8, rbx")
    asmput("    mov r9, r12")
    asmput("    mov qword ptr [rsp+32], 0")
    asmput("    mov qword ptr [rsp+40], 0")
    asmput("    mov qword ptr [rsp+48], 0")
    asmput("    mov qword ptr [rsp+56], 0")
    asmput("    call qword ptr [rip+WideCharToMultiByte]")
    asmput("    test eax, eax")
    asmput("    jz .img_none")
    asmput("    mov ecx, eax")
