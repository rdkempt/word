// RFC 7748 section 5.2 (the two scalar-multiplication vectors), section 6.1
// (the Diffie-Hellman exchange: both public keys and the shared secret) and the
// first two rounds of the section 5.2 iterated test. Also the all-zero
// u-coordinate, which is a low-order point and must produce an all-zero output,
// the check a TLS client is required to make before using the result.
hex_of(b)
    d = "0123456789abcdef"
    s = bytes(len(b) * 2)
    i = 0
    loop i < len(b)
        s[i * 2] = d[(b[i] >> 4) & 15]
        s[i * 2 + 1] = d[b[i] & 15]
        i = i + 1
    return s
nib(c)
    if c >= 48 && c <= 57
