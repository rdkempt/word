// FIPS 180-4 gives SHA-512 and SHA-384 for "abc" and for the two longer ASCII
// messages. The rest are byte counts on each side of the padding boundary: 111
// bytes is the last that pads inside one block, 112 the first that needs a
// second, and 127 and 128 ask the same question at the block edge. All the
// expected digests are Python hashlib's, which shares nothing with this code.
hex_of(b)
    d = "0123456789abcdef"
    s = bytes(len(b) * 2)
    i = 0
    loop i < len(b)
        s[i * 2] = d[(b[i] >> 4) & 15]
        s[i * 2 + 1] = d[b[i] & 15]
        i = i + 1
    return s
nib(c)
    if c >= 48 && c <= 57
        return c - 48
    return c - 87
un_hex(s)
    b = bytes((len(s) >> 1))
    i = 0
    loop i < len(b)
        b[i] = nib(s[i * 2]) * 16 + nib(s[i * 2 + 1])
        i = i + 1
    return b
check(what, got, want)
    if hex_of(got) == want
        return 1
    err("  FAIL: " . what)
    err("    want " . want)
    err("    got  " . hex_of(got))
    return 0
