// RSA verification against signatures openssl produced. Two keys (2048 and
// 3072 bits), three digests, and both padding schemes: rsa_pkcs1_sha256 is what
// certificates are still commonly signed with, and rsa_pss_rsae_sha256 is what
// TLS 1.3 requires for CertificateVerify. Then the same twelve signatures with
// one bit flipped, and each signature checked against a message it didn't
// sign, so a verifier that always says yes fails.
nib(c)
    if c >= 48 && c <= 57
        return c - 48
    return c - 87
un_hex(s)
    b = bytes((len(s) >> 1))
    i = 0
    loop i < len(b)
        b[i] = nib(s[i * 2]) * 16 + nib(s[i * 2 + 1])
        i = i + 1
    return b
yes(what, ok)
    if ok != 0
        return 1
    err("  FAIL: " . what . " should have verified")
    return 0
no(what, ok)
    if ok == 0
        return 1
    err("  FAIL: " . what . " should have been rejected")
    return 0
n = 0
e = un_hex("010001")
msg = un_hex("54686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f67")
other = un_hex("54686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f6721")
n2048 = un_hex("")
s = un_hex("")
n = n + yes("v15 2048 sha256", rsa_pkcs1_verify(n2048, e, s, msg, 0))
n = n + no("v15 2048 sha256 wrong message", rsa_pkcs1_verify(n2048, e, s, other, 0))
n = n + no("v15 2048 sha256 flipped bit", rsa_pkcs1_verify(n2048, e, un_hex(""), msg, 0))
s = un_hex("")
n = n + yes("pss 2048 sha256", rsa_pss_verify(n2048, e, s, msg, 0))
n = n + no("pss 2048 sha256 wrong message", rsa_pss_verify(n2048, e, s, other, 0))
n = n + no("pss 2048 sha256 flipped bit", rsa_pss_verify(n2048, e, un_hex(""), msg, 0))
s = un_hex("")
n = n + yes("v15 2048 sha384", rsa_pkcs1_verify(n2048, e, s, msg, 1))
n = n + no("v15 2048 sha384 wrong message", rsa_pkcs1_verify(n2048, e, s, other, 1))
n = n + no("v15 2048 sha384 flipped bit", rsa_pkcs1_verify(n2048, e, un_hex(""), msg, 1))
s = un_hex("")
n = n + yes("pss 2048 sha384", rsa_pss_verify(n2048, e, s, msg, 1))
n = n + no("pss 2048 sha384 wrong message", rsa_pss_verify(n2048, e, s, other, 1))
n = n + no("pss 2048 sha384 flipped bit", rsa_pss_verify(n2048, e, un_hex(""), msg, 1))
s = un_hex("")
n = n + yes("v15 2048 sha512", rsa_pkcs1_verify(n2048, e, s, msg, 2))
n = n + no("v15 2048 sha512 wrong message", rsa_pkcs1_verify(n2048, e, s, other, 2))
n = n + no("v15 2048 sha512 flipped bit", rsa_pkcs1_verify(n2048, e, un_hex(""), msg, 2))
s = un_hex("")
n = n + yes("pss 2048 sha512", rsa_pss_verify(n2048, e, s, msg, 2))
n = n + no("pss 2048 sha512 wrong message", rsa_pss_verify(n2048, e, s, other, 2))
n = n + no("pss 2048 sha512 flipped bit", rsa_pss_verify(n2048, e, un_hex(""), msg, 2))
n3072 = un_hex("")
s = un_hex("")
n = n + yes("v15 3072 sha256", rsa_pkcs1_verify(n3072, e, s, msg, 0))
n = n + no("v15 3072 sha256 wrong message", rsa_pkcs1_verify(n3072, e, s, other, 0))
n = n + no("v15 3072 sha256 flipped bit", rsa_pkcs1_verify(n3072, e, un_hex(""), msg, 0))
s = un_hex("")
n = n + yes("pss 3072 sha256", rsa_pss_verify(n3072, e, s, msg, 0))
n = n + no("pss 3072 sha256 wrong message", rsa_pss_verify(n3072, e, s, other, 0))
n = n + no("pss 3072 sha256 flipped bit", rsa_pss_verify(n3072, e, un_hex(""), msg, 0))
s = un_hex("")
n = n + yes("v15 3072 sha384", rsa_pkcs1_verify(n3072, e, s, msg, 1))
n = n + no("v15 3072 sha384 wrong message", rsa_pkcs1_verify(n3072, e, s, other, 1))
n = n + no("v15 3072 sha384 flipped bit", rsa_pkcs1_verify(n3072, e, un_hex(""), msg, 1))
s = un_hex("")
n = n + yes("pss 3072 sha384", rsa_pss_verify(n3072, e, s, msg, 1))
n = n + no("pss 3072 sha384 wrong message", rsa_pss_verify(n3072, e, s, other, 1))
n = n + no("pss 3072 sha384 flipped bit", rsa_pss_verify(n3072, e, un_hex(""), msg, 1))
s = un_hex("")
n = n + yes("v15 3072 sha512", rsa_pkcs1_verify(n3072, e, s, msg, 2))
n = n + no("v15 3072 sha512 wrong message", rsa_pkcs1_verify(n3072, e, s, other, 2))
n = n + no("v15 3072 sha512 flipped bit", rsa_pkcs1_verify(n3072, e, un_hex(""), msg, 2))
s = un_hex("")
n = n + yes("pss 3072 sha512", rsa_pss_verify(n3072, e, s, msg, 2))
n = n + no("pss 3072 sha512 wrong message", rsa_pss_verify(n3072, e, s, other, 2))
n = n + no("pss 3072 sha512 flipped bit", rsa_pss_verify(n3072, e, un_hex(""), msg, 2))
out("rsa (word): " . n . " of 36 checks pass")
if n == 36
    return 0
return 1
