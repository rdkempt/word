// bn_modexp against two oracles. The two RSA cases are real: openssl generated
// the key and signed "The quick brown fox jumps over the lazy dog" with
// RSASSA-PKCS1-v1_5 and SHA-256, and raising the signature to the public
// exponent has to reproduce the EMSA-PKCS1-v1_5 encoding byte for byte, which
// is what verifying an RSA certificate does. The four smaller cases are random
// moduli and 64-bit exponents checked against Python's pow(), which shares
// nothing with this code. The sizes straddle the 30-bit limb boundary, so a
// partly filled top limb is covered.
hex_of(b)
    d = "0123456789abcdef"
    s = bytes(len(b) * 2)
    i = 0
    loop i < len(b)
        s[i * 2] = d[(b[i] >> 4) & 15]
        s[i * 2 + 1] = d[b[i] & 15]
        i = i + 1
    return s
nib(c)
    if c >= 48 && c <= 57
        return c - 48
    return c - 87
un_hex(s)
    b = bytes((len(s) >> 1))
    i = 0
    loop i < len(b)
        b[i] = nib(s[i * 2]) * 16 + nib(s[i * 2 + 1])
        i = i + 1
    return b
modexp_hex(ah, eh, mh, nbytes)
    n = bn_limbs_for(nbytes)
    a = bn_from_bytes(un_hex(ah), n)
    m = bn_from_bytes(un_hex(mh), n)
    return bn_to_bytes(bn_modexp(a, un_hex(eh), m), nbytes)
check(what, ah, eh, mh, nbytes, want)
    got = modexp_hex(ah, eh, mh, nbytes)
    if hex_of(got) == want
        return 1
    err("  FAIL: " . what)
    err("    want " . want)
    err("    got  " . hex_of(got))
    return 0
n = 0
n = n + check("modexp 256-bit", "01d350b31a1e72463d0bc3907cb14d7e5f6404f85035246d0cde122cda6f2a8d", "8ae8557e48cdde27", "f5884f75ae9ce2e2ab14b9831abcf4f27695dde93a32bfe1fb85a1a50e2203e3", 32, "0f34c760795544a13cea26ac4268884e8f2c23623ded86a7d323fe1c08b090d4")
n = n + check("modexp 521-bit", "00396c8d502106b1e509580e3bf2a1512e7a80abafc2339b4ac80de76c1d3255fa89d222dd26553a71cfd162b18a46f8fa23c1d72e9b12f6f295a452f4cdc9555f1f", "e612a475f12cb37f", "010981f85dcec85276b752c6b86285a9d776a973ebae8e0f60a39d2bd165f2dacea87d2af821354ff3c307772d87e5b31c56d5f72eecca035b595147cf6be4559411", 66, "001899a35fbabb7ef0806152bdba09cc06be471a7384542917d35bf2d5da13b3d7f706d440c2661881192977b98c876ccc9e520b3be405d51f00a7acaf338d69b758")
n = n + check("modexp 1024-bit", "14fc2e446dc213c8c76d1cd372be58f2634a238e9f2dd26b4e92fb353b74d44281faa298bd1f8a8d7035219dca4ff8158bd64ac50f59146a1acd8ab41373f6daa257a32daee8355d2882e60662969e11f212f9a233cb16224629ed5f299eb187c3c399b9aa182de5e48caf26f977d7f826b6c095d36bc40080a94eb9a455170f", "3e26f11509809909", "dce47cf3667cb22f701aafc221a7ad707e4464d740ae9f56aa2dc911e07d5debdd15a31bd644ace32ac1554f60a9db9abd83d7463c54f360de5bfcc62e534caa90a518a40d43e1b7d80624e6beadc29c11c1fab65856e567dd8788b74dd382e23a79e979d897942c22524b7352bdfe1da4887bee3f13e6b44a233c03ef7e7195", 128, "697834adb811e1f614a7f4f7cc15ad9994acc0ef0ac920ec89bf4f7172b1ee8185bfc3c1b05ad33caa06d27c9ea92306b33210807e70cbff2657209ee7fe3e5ed97f6298694c75822d82811a96f035304bb184edf412994ff5b933a6ed83cea8180f58886af6508a5a71f77cf4f1b6a911b05aa5b29f0a5ce22e3c6aff35acdc")
n = n + check("modexp 2048-bit", "", "d8cf27aa0a06b45f", "", 256, "")
